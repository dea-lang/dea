/**
 * Assign through each branch of the emitter's conditional pointer expression.
 *
 * @return Zero if each write changes only the selected integer.
 */
int main(void) {
    int left = 1, right = 2;
    int *a = &left, *b = &right;
    int take_a = 1;
    @LVALUE@ = 11;
    if (left != 11 || right != 2) return 1;
    take_a = 0;
    @LVALUE@ = 22;
    return left == 11 && right == 22 ? 0 : 2;
}
