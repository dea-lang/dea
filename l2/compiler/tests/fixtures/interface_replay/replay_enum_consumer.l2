module replay_enum_consumer;

import replay_enum_provider as colors;
import Shade, Red, Rgb from replay_enum_provider;

func main() -> int {
    let shade: Shade = colors::Rgb(red: 1, green: 2, blue: 3);
    if (is(shade, Red)) {
        return 0;
    }
    let copied: Shade = Rgb(red: 4, green: 5, blue: 6);
    return ord(copied);
}
