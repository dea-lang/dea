module iface_implicit;

/**
 * A 2D point.
 */
struct Point {
    x: int;
    y: int;
}

/**
 * Compute area.
 */
func area(p: Point) -> int {
    return p.x * p.y;
}

/**
 * Private helper excluded by implicit-default export rules.
 */
func _helper() -> int {
    return 0;
}
