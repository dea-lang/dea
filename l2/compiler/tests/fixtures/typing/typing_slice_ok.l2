module typing_slice_ok;

func sum(s: int[]) -> int {
    let total: int = 0;
    let n: int = len(s);
    if (n > 0) {
        total = s[0];
    }
    return total;
}

func string_length(s: string) -> int {
    return len(s);
}

func main() -> int {
    let a: int[3] = [1, 2, 3];
    let whole: int[] = a;
    let all = slice(a);
    let part = slice(a, 1);
    let mid = slice(a, 1, 1);
    let from_slice = slice(whole, 0, 2);
    let n: int = len(whole);
    let qn: int = dea::len(a);
    let sn: int = len("hello");
    let qsn: int = dea::len("world");
    let qs = dea::slice(a, 0);
    whole[0] = 9;
    whole = a;
    let r: int = sum(a);
    let r2: int = sum(whole);
    return whole[0] + part[0] + len(mid) + n + qn + sn + qsn + string_length("!") + r + r2;
}
