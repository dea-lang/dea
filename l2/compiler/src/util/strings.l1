module util.strings;

import sys.rt;
import std.string;
import std.text;
import std.vector;

/**
 * Clone a vector of strings.
 *
 * @param src Source vector to copy.
 * @return New vector containing the same strings in the same order.
 */
func us_sv_clone(src: StringVector*) -> StringVector* {
    let out = sv_create(sv_size(src));
    for (let i = 0; i < sv_size(src); i = i + 1) {
        sv_push(out, sv_get(src, i));
    }
    return out;
}

/**
 * Split a string on one separator byte.
 *
 * @param s String to split.
 * @param sep Separator byte.
 * @param keep_empty Whether empty fields should be preserved.
 * @return Vector of split parts.
 */
func us_split_char(s: string, sep: byte, keep_empty: bool) -> StringVector* {
    let sep_s = byte_to_s(sep);
    if (keep_empty) {
        return split_s(s, sep_s);
    }

    with (let parts = split_s(s, sep_s) => sv_free(parts)) {
        let out = sv_create(sv_size(parts));
        for (let i = 0; i < sv_size(parts); i = i + 1) {
            let part = sv_get(parts, i);
            if (!is_empty_s(part)) {
                sv_push(out, part);
            }
        }
        return out;
    }
}

/**
 * Split a string on either of two separator bytes, dropping empty fields.
 *
 * @param s String to split.
 * @param sep1 First separator byte.
 * @param sep2 Second separator byte.
 * @return Vector of non-empty split parts.
 */
func us_split_chars2_non_empty(s: string, sep1: byte, sep2: byte) -> StringVector* {
    let out = sv_create(4);
    let n = len_s(s);
    let start = 0;

    for (let i = 0; i < n; i = i + 1) {
        let c = char_at_s(s, i);
        if (c == sep1 || c == sep2) {
            if (i > start) {
                sv_push(out, slice_s(s, start, i));
            }
            start = i + 1;
        }
    }

    if (start < n) {
        sv_push(out, slice_s(s, start, n));
    }

    return out;
}

/**
 * Split a string on space characters, dropping empty fields.
 *
 * @param s String to split.
 * @return Vector of non-empty split parts.
 * @see std.string::is_space for the definition of space characters.
 */
func us_split_is_space_non_empty(s: string) -> StringVector* {
    let out = sv_create(4);
    let n = len_s(s);
    let start = 0;

    for (let i = 0; i < n; i = i + 1) {
        let c = char_at_s(s, i);
        if (is_space(c)) {
            if (i > start) {
                sv_push(out, slice_s(s, start, i));
            }
            start = i + 1;
        }
    }

    if (start < n) {
        sv_push(out, slice_s(s, start, n));
    }

    return out;
}

/**
 * Strip a leading UTF-8 BOM from a string when present.
 *
 * @param s String to normalize.
 * @return `s` without a leading BOM.
 */
func us_strip_utf8_bom(s: string) -> string {
    if (len_s(s) >= 3 &&
        char_at_s(s, 0) == (239 as byte) &&
        char_at_s(s, 1) == (187 as byte) &&
        char_at_s(s, 2) == (191 as byte)) {
        return slice_s(s, 3, len_s(s));
    }
    return s;
}

/**
 * Return whether a byte is a UTF-8 continuation byte.
 *
 * @param c Byte to inspect.
 * @return `true` for bytes in the `0x80..0xBF` range.
 */
func us_is_utf8_continuation(c: byte) -> bool {
    let v = c as int;
    return v >= 128 && v <= 191;
}

/**
 * Validate that a string contains only well-formed UTF-8 byte sequences.
 *
 * The validator rejects overlong forms, surrogate code points, truncated
 * sequences, and byte sequences above `U+10FFFF`.
 *
 * @param s String to validate.
 * @return `true` when `s` is well-formed UTF-8.
 */
func us_is_valid_utf8(s: string) -> bool {
    let i = 0;
    let n = len_s(s);
    while (i < n) {
        let b0 = char_at_s(s, i) as int;
        if (b0 <= 127) {
            i = i + 1;
        } else if (b0 >= 194 && b0 <= 223) {
            if (i + 1 >= n || !us_is_utf8_continuation(char_at_s(s, i + 1))) return false;
            i = i + 2;
        } else if (b0 == 224) {
            if (i + 2 >= n) return false;
            let b1 = char_at_s(s, i + 1) as int;
            if (b1 < 160 || b1 > 191 || !us_is_utf8_continuation(char_at_s(s, i + 2))) return false;
            i = i + 3;
        } else if (b0 >= 225 && b0 <= 236) {
            if (i + 2 >= n ||
                !us_is_utf8_continuation(char_at_s(s, i + 1)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 2))) return false;
            i = i + 3;
        } else if (b0 == 237) {
            if (i + 2 >= n) return false;
            let b1b = char_at_s(s, i + 1) as int;
            if (b1b < 128 || b1b > 159 || !us_is_utf8_continuation(char_at_s(s, i + 2))) return false;
            i = i + 3;
        } else if (b0 >= 238 && b0 <= 239) {
            if (i + 2 >= n ||
                !us_is_utf8_continuation(char_at_s(s, i + 1)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 2))) return false;
            i = i + 3;
        } else if (b0 == 240) {
            if (i + 3 >= n) return false;
            let b1c = char_at_s(s, i + 1) as int;
            if (b1c < 144 || b1c > 191 ||
                !us_is_utf8_continuation(char_at_s(s, i + 2)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 3))) return false;
            i = i + 4;
        } else if (b0 >= 241 && b0 <= 243) {
            if (i + 3 >= n ||
                !us_is_utf8_continuation(char_at_s(s, i + 1)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 2)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 3))) return false;
            i = i + 4;
        } else if (b0 == 244) {
            if (i + 3 >= n) return false;
            let b1d = char_at_s(s, i + 1) as int;
            if (b1d < 128 || b1d > 143 ||
                !us_is_utf8_continuation(char_at_s(s, i + 2)) ||
                !us_is_utf8_continuation(char_at_s(s, i + 3))) return false;
            i = i + 4;
        } else {
            return false;
        }
    }
    return true;
}
