/**
 * Check one expression-phase type for imported opaque layout use.
 *
 * Loop liveness convergence rechecks expressions under diagnostic-suppression
 * modes, and loop conditions may also be inferred twice normally. Suppressed
 * passes retain the type for flow analysis; ordinary rechecks retain the prior
 * failure result without duplicating its source diagnostic.
 *
 * @param self Expression checker state.
 * @param ty Type position to validate.
 * @param filename Source filename to report.
 * @param span Source span to report.
 * @return `true` when checking may continue with the type.
 */
func etc_check_imported_opaque_layout_type(self: ExpressionTypeChecker*, ty: Type*, filename: string,
                                           span: Span) -> bool {
    if (self.suppress_diagnostics || self.liveness_diagnostics_only) {
        return true;
    }
    for (let i = 0; i < diag_count(self.result.diags); i = i + 1) {
        let existing = diag_get(self.result.diags, i);
        if (existing.code == "RES-0038" && existing.filename == filename &&
            existing.line == span.start_line && existing.column == span.start_column &&
            existing.line_end == span.end_line && existing.column_end == span.end_column) {
            return false;
        }
    }
    return sig_check_imported_opaque_layout_type(
        self.result.names as NameResolution*, self.current_module, ty, true,
        self.result.diags, filename, span);
}

/**
 * Format the full display form for one nested symbol path expression.
 *
 * @param expr Variable-reference expression carrying module and qualifier segments.
 * @return Full nested path such as `color::Color::Red`.
 */
func etc_nested_symbol_path_full(expr: ExprNode*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        if (expr.module_path != null) {
            let mp = expr.module_path as StringVector*;
            for (let i = 0; i < sv_size(mp); i = i + 1) {
                if (i > 0) {
                    sb_append(sb, ".");
                }
                sb_append(sb, sv_get(mp, i));
            }
            if (sv_size(mp) > 0) {
                sb_append(sb, "::");
            }
        }
        if (expr.name_qualifier != null) {
            let nq = expr.name_qualifier as StringVector*;
            for (let i = 0; i < sv_size(nq); i = i + 1) {
                sb_append(sb, sv_get(nq, i));
                sb_append(sb, "::");
            }
        }
        sb_append(sb, expr.text_value);
        return sb_to_string(sb);
    }
}

/**
 * Format the direct symbol suggestion for one nested symbol path expression.
 *
 * @param expr Variable-reference expression carrying module and qualifier segments.
 * @return Simplified path such as `color::Red`.
 */
func etc_nested_symbol_path_simple(expr: ExprNode*) -> string {
    if (expr.module_path == null) {
        return expr.text_value;
    }
    return tr_module_from_path(expr.module_path as StringVector*) + "::" + expr.text_value;
}

/**
 * Build the `TYP-0158` message for one nested symbol path expression.
 *
 * @param expr Variable-reference expression carrying module and qualifier segments.
 * @return Diagnostic text matching the shared nested-path wording.
 */
func etc_nested_symbol_path_message(expr: ExprNode*) -> string {
    let full = etc_nested_symbol_path_full(expr);
    let simple = etc_nested_symbol_path_simple(expr);
    return "nested symbol path '" + full + "': paths must have the form 'module::symbol' (did you mean '" + simple + "'?)";
}

/**
 * Return whether the current cleanup-block guard stack marks the visible local as maybe uninitialized.
 *
 * @param self Expression checker state.
 * @param name Variable name to inspect.
 * @return `true` when the visible local binding matches a guarded header declaration.
 */
func etc_is_guarded_cleanup_header_local(self: ExpressionTypeChecker*, name: string) -> bool {
    if (self.cleanup_header_guard_stack == null || self.current_scope == null) {
        return false;
    }
    let local = etc_lookup_visible_local_symbol(self, name);
    if (local == null) {
        return false;
    }
    let symbol = local as LocalSymbol*;
    if (ord(symbol.kind) != ord(LK_LOCAL)) {
        return false;
    }
    let guards = self.cleanup_header_guard_stack;
    while (guards != null) {
        let guard_node = guards as CleanupHeaderGuard*;
        if (iset_has(guard_node.guarded_decl_ids, symbol.decl_id)) {
            return true;
        }
        guards = guard_node.parent;
    }
    return false;
}

/**
 * Return whether an expression contains postfix `?`.
 *
 * @param arena Expression arena to inspect.
 * @param expr_id Expression id to walk.
 * @return `true` when the expression tree contains `EX_TRY`.
 */
func etc_expr_contains_try(arena: ExprArena*, expr_id: ExprId) -> bool {
    if (expr_id < 0) {
        return false;
    }
    let expr = expr_arena_get(arena, expr_id);
    if (ord(expr.kind) == ord(EX_TRY)) {
        return true;
    }
    if (etc_expr_contains_try(arena, expr.expr_a)) return true;
    if (etc_expr_contains_try(arena, expr.expr_b)) return true;
    if (etc_expr_contains_try(arena, expr.expr_c)) return true;
    if (expr.ids != null) {
        let ids = expr.ids as VectorBase*;
        for (let i = 0; i < vec_size(ids); i = i + 1) {
            if (etc_expr_contains_try(arena, id_vec_get(ids, i))) {
                return true;
            }
        }
    }
    return false;
}

/**
 * Return whether a statement contains postfix `?`.
 *
 * @param unit Driver unit owning the statement.
 * @param stmt_id Statement id to inspect.
 * @return `true` when the statement contains `EX_TRY`.
 */
func etc_stmt_contains_try(unit: DriverUnit*, stmt_id: StmtId) -> bool {
    if (stmt_id < 0) {
        return false;
    }
    let stmt = stmt_arena_get(unit.parse_result.stmt_arena, stmt_id);
    match (stmt.kind) {
        ST_BLOCK => {
            if (stmt.ids != null) {
                let ids = stmt.ids as VectorBase*;
                for (let i = 0; i < vec_size(ids); i = i + 1) {
                    if (etc_stmt_contains_try(unit, id_vec_get(ids, i))) {
                        return true;
                    }
                }
            }
            return false;
        }
        ST_LET => { return etc_expr_contains_try(unit.parse_result.expr_arena, stmt.expr_a); }
        ST_ASSIGN => {
            return etc_expr_contains_try(unit.parse_result.expr_arena, stmt.expr_a) ||
                etc_expr_contains_try(unit.parse_result.expr_arena, stmt.expr_b);
        }
        ST_EXPR => { return etc_expr_contains_try(unit.parse_result.expr_arena, stmt.expr_a); }
        ST_RETURN => { return etc_expr_contains_try(unit.parse_result.expr_arena, stmt.expr_a); }
        _ => { return false; }
    }
}

/**
 * Resolve the exact local symbol visible at the current statement position.
 *
 * @param self Expression checker state.
 * @param name Local name to look up.
 * @return Visible local symbol, or `null` if no local is visible.
 */
func etc_lookup_visible_local_symbol(self: ExpressionTypeChecker*, name: string) -> LocalSymbol*? {
    if (self.decl_scopes == null || self.decl_scope_defs == null) {
        return null;
    }
    let maps = self.decl_scopes as VectorBase*;
    let defs = self.decl_scope_defs as VectorBase*;
    for (let scope_index = vec_size(maps) - 1; scope_index >= 0; scope_index = scope_index - 1) {
        let current = ptr_vec_get(defs, scope_index) as Scope*;
        let visible = ptr_vec_get(maps, scope_index) as StringIntMap*;
        if (sim_has(visible, name)) {
            let local = spm_get(current.symbols, name);
            if (local != null) {
                return local as LocalSymbol*;
            }
        }
    }
    return null;
}

/** Resolve the type represented by one exact local symbol. */
func etc_local_symbol_type(self: ExpressionTypeChecker*, l: LocalSymbol*) -> Type*? {
    match (l.kind) {
        LK_PARAM => {
            let p = l.decl_ptr as Param*;
            with (let seen = ss_create() => ss_free(seen)) {
                return tr_resolve_type_ref(self.result.signatures as SignatureTables*, self.result.names as NameResolution*,
                    self.result.driver_state, self.current_env as ModuleEnv*, p.type_ref, self.result.diags, seen);
            }
        }
        LK_LOCAL => {
            let s = l.decl_ptr as StmtNode*;
            if (s.type_ref != null) {
                with (let seen2 = ss_create() => ss_free(seen2)) {
                    return tr_resolve_type_ref(self.result.signatures as SignatureTables*, self.result.names as NameResolution*,
                        self.result.driver_state, self.current_env as ModuleEnv*, s.type_ref as TypeRef*,
                        self.result.diags, seen2);
                }
            }
            let key = etc_key(self.current_module, s.expr_a);
            let val_ty = spm_get(self.result.expr_types, key);
            if (val_ty != null) {
                return type_clone(val_ty as Type*);
            }
        }
        LK_PATTERN_VAR => {
            return etc_get_pattern_var_type(self, l.decl_id, l.binding_slot);
        }
    }
    return null;
}

/** Resolve the type of a local binding visible at the current statement position. */
func etc_lookup_local(self: ExpressionTypeChecker*, name: string) -> Type*? {
    let local = etc_lookup_visible_local_symbol(self, name);
    if (local == null) {
        return null;
    }
    return etc_local_symbol_type(self, local as LocalSymbol*);
}

/**
 * Resolve a visible symbol from the current expression-checking environment.
 *
 * @param self Expression checker state.
 * @param name Unqualified symbol name.
 * @param module_path Optional parsed module path for cross-module lookups.
 * @param name_qualifier Optional enum-variant qualifier.
 * @return Resolved symbol, or `null` if lookup fails.
 */
func etc_lookup_symbol(self: ExpressionTypeChecker*, name: string, module_path: StringVector*?,
                        name_qualifier: StringVector*?) -> Symbol*? {
    return tr_symbol_lookup(self.result.names as NameResolution*, self.current_env as ModuleEnv*, name, module_path,
        name_qualifier);
}

/**
 * Check whether a type is `void`.
 *
 * @param ty Type to inspect.
 * @return `true` if `ty` is `void`.
 */
func etc_is_void(ty: Type*?) -> bool {
    if (ty == null) return false;
    return type_is_builtin(ty as Type*, "void");
}

/**
 * Report whether postfix pointer indexing is allowed in the current function context.
 *
 * @param self Expression checker state.
 * @return `true` when the current expression is inside an `unsafe func` body.
 */
func etc_in_unsafe_func(self: ExpressionTypeChecker*) -> bool {
    return self.current_func != null && (self.current_func as FunctionEnv*).func_decl.is_unsafe;
}

/**
 * Resolve a visible symbol as a type usable by `sizeof`.
 *
 * @param self Expression checker state.
 * @param sym Symbol to interpret as a type.
 * @return Resolved type, or `null` when the symbol is not a type name.
 */
func etc_symbol_as_type(self: ExpressionTypeChecker*, sym: Symbol*) -> Type*? {
    match (sym.kind) {
        SYM_STRUCT => { return type_new_struct(sym.module_name, sym.name); }
        SYM_ENUM => { return type_new_enum(sym.module_name, sym.name); }
        SYM_TYPE_ALIAS => {
            if (sym.resolved_type != null) {
                return type_clone(sym.resolved_type as Type*);
            }
            with (let seen = ss_create() => ss_free(seen)) {
                return tr_resolve_alias(self.result.signatures as SignatureTables*, self.result.names as NameResolution*,
                    self.result.driver_state, self.current_env as ModuleEnv*, sym, self.result.diags, seen);
            }
        }
        _ => { return null; }
    }
}

/**
 * Return whether a nominal type is opaque from the current module.
 *
 * @param self Expression checker state.
 * @param ty Nominal type to inspect.
 * @return `true` when `ty` is exported opaquely by another module.
 */
func etc_is_imported_opaque_nominal(self: ExpressionTypeChecker*, ty: Type*) -> bool {
    if (ord(ty.kind) != ord(TY_STRUCT) && ord(ty.kind) != ord(TY_ENUM)) {
        return false;
    }
    if (ty.module_name == self.current_module) {
        return false;
    }
    let provider = nr_env_find(self.result.names as NameResolution*, ty.module_name);
    if (provider == null) {
        return false;
    }
    return ss_has((provider as ModuleEnv*).opaque_exports, ty.name);
}

/**
 * Emit the shared opaque-layout diagnostic for expression-level layout use.
 *
 * @param self Expression checker state.
 * @param ty Opaque nominal type.
 * @param span Source span to report.
 */
func etc_diag_opaque_layout_use(self: ExpressionTypeChecker*, ty: Type*, span: Span) {
    etc_diag_error(
        self,
        "RES-0038",
        "opaque type '" + ty.module_name + "::" + ty.name + "' is used where transparent layout is required",
        (self.current_unit as DriverUnit*).path,
        span
    );
}

/**
 * Emit the most specific diagnostic for a failed type-reference resolution.
 *
 * Special cases preserve shared diagnostic codes for nullable `void`, ambiguous
 * names, unresolved aliases, and value symbols used as types. Other failures use
 * `fallback_code` so callers can keep context-specific unknown-type codes.
 *
 * @param self Expression checker state.
 * @param tref Type reference that failed to resolve.
 * @param fallback_code Diagnostic code for generic unknown-type failures.
 * @param span Source span to report for diagnostics.
 */
func etc_diag_type_ref_failure(self: ExpressionTypeChecker*, tref: TypeRef*, fallback_code: string, span: Span) {
    let unit = self.current_unit as DriverUnit*;
    let invalid_array_suffix = false;
    if (tref.suffixes != null) {
        let suffixes_for_array = tref.suffixes as VectorBase*;
        for (let i = 0; i < vec_size(suffixes_for_array); i = i + 1) {
            let suffix_for_array = ptr_vec_get(suffixes_for_array, i) as TypeSuffix*;
            if (ord(suffix_for_array.kind) == ord(TS_ARRAY) && suffix_for_array.array_len <= 0) {
                invalid_array_suffix = true;
            }
        }
    }
    if (invalid_array_suffix && tref.module_path == null && type_is_builtin_name(tref.name)) {
        return;
    }

    let nullable_void = tref.is_nullable && tref.pointer_depth == 0;
    if (tref.suffixes != null) {
        let suffixes = tref.suffixes as VectorBase*;
        nullable_void = vec_size(suffixes) > 0 &&
            ord((ptr_vec_get(suffixes, 0) as TypeSuffix*).kind) == ord(TS_NULLABLE);
    }
    if (nullable_void && tref.module_path == null && tref.name == "void") {
        etc_diag_error(self, "TYP-0278", "type 'void' cannot be nullable", unit.path, span);
        return;
    }
    if (tref.module_path == null && nr_module_env_is_ambiguous(self.current_env as ModuleEnv*, tref.name)) {
        etc_diag_error(self, "TYP-0279", "ambiguous type name '" + tref.name + "'", unit.path, span);
        return;
    }
    let sym = etc_lookup_symbol(self, tref.name, tref.module_path, null);
    if (sym != null) {
        let s = sym as Symbol*;
        if (invalid_array_suffix &&
            (ord(s.kind) == ord(SYM_TYPE_ALIAS) || ord(s.kind) == ord(SYM_STRUCT) || ord(s.kind) == ord(SYM_ENUM))) {
            return;
        }
        if (ord(s.kind) == ord(SYM_TYPE_ALIAS)) {
            etc_diag_error(self, "TYP-0270", "type alias '" + tref.name + "' does not have a resolved type",
                unit.path, span);
        } else if (ord(s.kind) != ord(SYM_STRUCT) && ord(s.kind) != ord(SYM_ENUM)) {
            etc_diag_error(self, "TYP-0271", "symbol '" + tref.name + "' is not a type", unit.path, span);
        } else {
            etc_diag_error(self, fallback_code, "unknown type '" + tref.name + "'", unit.path, span);
        }
    } else {
        etc_diag_error(self, fallback_code, "unknown type '" + tref.name + "'", unit.path, span);
    }
}

/**
 * Try to resolve one identifier expression as a type name for intrinsics.
 *
 * @param self Expression checker state.
 * @param expr Identifier expression to interpret as a type.
 * @return Resolved type, an `int` recovery type after a qualified-lookup diagnostic,
 *         or `null` when the identifier should be treated as a value expression.
 */
func etc_try_resolve_type_name(self: ExpressionTypeChecker*, expr: ExprNode*) -> Type*? {
    if (expr.module_path == null) {
        let builtin = type_builtin_from_name(expr.text_value);
        if (builtin != null) {
            return builtin;
        }

        if (nr_module_env_is_ambiguous(self.current_env as ModuleEnv*, expr.text_value)) {
            etc_diag_error(self, "TYP-0303",
                "ambiguous identifier '" + expr.text_value + "'; use a module-qualified name",
                (self.current_unit as DriverUnit*).path, expr.span);
            return null;
        }

        let sym = etc_lookup_symbol(self, expr.text_value, null, null);
        if (sym == null) {
            return null;
        }
        return etc_symbol_as_type(self, sym as Symbol*);
    }

    let target_module = tr_module_from_path(expr.module_path as StringVector*);
    let sym2 = etc_lookup_symbol(self, expr.text_value, expr.module_path, null);
    if (sym2 != null) {
        return etc_symbol_as_type(self, sym2 as Symbol*);
    }

    let current_env = self.current_env as ModuleEnv*;
    let lookup_target = tr_symbol_lookup_target(self.result.names as NameResolution*, current_env, target_module);
    if (ord(lookup_target.kind) == ord(SLT_LOCAL) || ord(lookup_target.kind) == ord(SLT_EXPORTS)) {
        etc_diag_error(self, "TYP-0159",
            "unknown identifier '" + target_module + "::" + expr.text_value + "'",
            (self.current_unit as DriverUnit*).path, expr.span);
        return type_builtin_int();
    }

    if (ord(lookup_target.kind) == ord(SLT_UNKNOWN_MODULE)) {
        etc_diag_error(self, "TYP-0300",
            "unknown type '" + target_module + "::" + expr.text_value + "' (unknown module '" + target_module + "')",
            (self.current_unit as DriverUnit*).path, expr.span);
        return type_builtin_int();
    }

    etc_diag_error(self, "TYP-0301",
        "unknown type '" + target_module + "::" + expr.text_value + "' (module '" + target_module + "' not imported)",
        (self.current_unit as DriverUnit*).path, expr.span);
    return type_builtin_int();
}

/**
 * Try to resolve a `sizeof` argument expression as an array type expression.
 *
 * Identifier array type expressions are syntactically ambiguous with value
 * indexing, so the parser leaves them as index expressions. `sizeof` can
 * disambiguate semantically: a type-name base plus literal indexes is a type.
 *
 * @param self Expression checker state.
 * @param expr_id Expression to interpret.
 * @return Resolved type, or `null` when the expression should remain a value.
 */
func etc_try_resolve_sizeof_type_expr(self: ExpressionTypeChecker*, expr_id: ExprId) -> Type*? {
    let unit = self.current_unit as DriverUnit*;
    let expr = expr_arena_get(unit.parse_result.expr_arena, expr_id);

    if (ord(expr.kind) == ord(EX_TYPE) && expr.type_ref != null) {
        with (let seen = ss_create() => ss_free(seen)) {
            return tr_resolve_type_ref(self.result.signatures as SignatureTables*,
                self.result.names as NameResolution*, self.result.driver_state, self.current_env as ModuleEnv*,
                expr.type_ref as TypeRef*, self.result.diags, seen);
        }
    }

    if (ord(expr.kind) == ord(EX_VAR_REF)) {
        return etc_try_resolve_type_name(self, expr);
    }

    if (ord(expr.kind) == ord(EX_PAREN)) {
        return etc_try_resolve_sizeof_type_expr(self, expr.expr_a);
    }

    if (ord(expr.kind) == ord(EX_INDEX)) {
        let base_ty = etc_try_resolve_sizeof_type_expr(self, expr.expr_a);
        if (base_ty == null) {
            return null;
        }
        let len_node = expr_arena_get(unit.parse_result.expr_arena, expr.expr_b);
        let value: ConstValue*? = null;
        let names_resolved_const = false;
        let const_eval_failed = false;
        with (let ctx = tr_const_eval_context_create(self.result.driver_state,
              self.result.signatures as SignatureTables*, self.result.names as NameResolution*, self.result.diags) =>
              tr_const_eval_context_free(ctx)) {
            value = tr_const_eval_expr(ctx, self.current_env as ModuleEnv*, expr.expr_b);
            if (value == null) {
                const_eval_failed = tr_const_eval_failed(ctx);
                if (!const_eval_failed) {
                    names_resolved_const = tr_expr_names_resolved_const(ctx, self.current_env as ModuleEnv*, expr.expr_b);
                }
            }
        }
        if (value == null) {
            if (const_eval_failed) {
                return type_append_array_dimension(base_ty as Type*, 1);
            }
            if (names_resolved_const) {
                etc_diag_error(self, "TYP-0816", "array length constant is not an int", unit.path, len_node.span);
            } else {
                etc_diag_error(self, "TYP-0815", "array length expression is not a compile-time constant",
                    unit.path, len_node.span);
            }
            return type_append_array_dimension(base_ty as Type*, 1);
        }
        let const_value = value as ConstValue*;
        if (ord(const_value.kind) != ord(CV_INT)) {
            tr_const_value_free(const_value);
            etc_diag_error(self, "TYP-0816", "array length constant is not an int", unit.path, len_node.span);
            return type_append_array_dimension(base_ty as Type*, 1);
        }
        let resolved_len = const_value.int_value;
        tr_const_value_free(const_value);
        if (resolved_len <= 0) {
            etc_diag_error(self, "TYP-0817", "array length constant is not positive", unit.path, len_node.span);
            return type_append_array_dimension(base_ty as Type*, 1);
        }
        return type_append_array_dimension(base_ty as Type*, resolved_len);
    }

    return null;
}

/**
 * Try to resolve one expression as an enum variant symbol for `is`.
 *
 * @param self Expression checker state.
 * @param expr Expression to interpret as a variant reference.
 * @return Resolved enum variant symbol, or `null`.
 */
func etc_try_resolve_enum_variant_symbol(self: ExpressionTypeChecker*, expr: ExprNode*) -> Symbol*? {
    if (ord(expr.kind) != ord(EX_VAR_REF)) {
        return null;
    }
    let sym = etc_lookup_symbol(self, expr.text_value, expr.module_path, expr.name_qualifier);
    if (sym == null || ord((sym as Symbol*).kind) != ord(SYM_ENUM_VARIANT)) {
        return null;
    }
    return sym as Symbol*;
}

/**
 * Report whether an expression node is an unqualified local reference.
 *
 * @param self Expression checker state.
 * @param expr Expression node to inspect.
 * @return `true` when the expression names a local without qualification.
 */
func etc_expr_is_unqualified_local_ref(self: ExpressionTypeChecker*, expr: ExprNode*) -> bool {
    if (ord(expr.kind) == ord(EX_VAR_REF) && expr.module_path == null && expr.name_qualifier == null) {
        let local_ty = etc_lookup_local(self, expr.text_value);
        if (local_ty != null) {
            type_free(local_ty as Type*);
            return true;
        }
    }
    return false;
}

/**
 * Report whether an expression contains an unqualified local reference.
 *
 * This whole-tree helper is used by constant integer narrowing, where every
 * operand must be compile-time known before folding is allowed.
 *
 * @param self Expression checker state.
 * @param expr_id Expression to inspect.
 * @return `true` when any unqualified variable reference names a local.
 */
func etc_expr_contains_unqualified_local_ref(self: ExpressionTypeChecker*, expr_id: ExprId) -> bool {
    if (expr_id < 0 || self.current_unit == null) {
        return false;
    }
    let expr = expr_arena_get((self.current_unit as DriverUnit*).parse_result.expr_arena, expr_id);
    if (etc_expr_is_unqualified_local_ref(self, expr)) {
        return true;
    }
    if (expr.expr_a >= 0 && etc_expr_contains_unqualified_local_ref(self, expr.expr_a)) {
        return true;
    }
    if (expr.expr_b >= 0 && etc_expr_contains_unqualified_local_ref(self, expr.expr_b)) {
        return true;
    }
    if (expr.expr_c >= 0 && etc_expr_contains_unqualified_local_ref(self, expr.expr_c)) {
        return true;
    }
    if (expr.ids != null) {
        let ids = expr.ids as VectorBase*;
        for (let i = 0; i < vec_size(ids); i = i + 1) {
            if (etc_expr_contains_unqualified_local_ref(self, id_vec_get(ids, i))) {
                return true;
            }
        }
    }
    return false;
}

func etc_get_call_param_names(self: ExpressionTypeChecker*, callee: ExprNode*) -> StringVector*? {
    if (ord(callee.kind) == ord(EX_VAR_REF)) {
        let sym = etc_lookup_symbol(self, callee.text_value, callee.module_path, callee.name_qualifier);
        if (sym != null && ord((sym as Symbol*).kind) == ord(SYM_FUNC)) {
            let decl_ptr = (sym as Symbol*).decl_ptr;
            if (decl_ptr != null) {
                let func_decl = decl_ptr as FuncDecl*;
                let params = func_decl.params;
                let count = vec_size(params);
                let names = sv_create(count);
                for (let i_cp = 0; i_cp < count; i_cp = i_cp + 1) {
                    sv_push(names, (ptr_vec_get(params, i_cp) as Param*).name);
                }
                return names;
            }
            return driver_clone_interface_func_param_names(self.result.driver_state, (sym as Symbol*).module_name,
                (sym as Symbol*).name);
        }
    }
    return null;
}

func etc_get_struct_field_names(self: ExpressionTypeChecker*, base: Type*) -> StringVector*? {
    let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, base.module_name, base.name);
    if (info != null) {
        let fields = (info as StructInfo*).fields;
        let count = vec_size(fields);
        let names = sv_create(count);
        for (let i_sf = 0; i_sf < count; i_sf = i_sf + 1) {
            sv_push(names, (ptr_vec_get(fields, i_sf) as StructFieldInfo*).name);
        }
        return names;
    }
    return null;
}

func etc_get_enum_variant_field_names_for_symbol(self: ExpressionTypeChecker*, sym: Symbol*) -> StringVector*? {
    if (ord(sym.kind) != ord(SYM_ENUM_VARIANT)) {
        return null;
    }
    if (sym.decl_ptr != null) {
        let variant_decl = sym.decl_ptr as EnumVariant*;
        let fields = variant_decl.fields;
        let count = vec_size(fields);
        let names = sv_create(count);
        for (let i_ev = 0; i_ev < count; i_ev = i_ev + 1) {
            sv_push(names, (ptr_vec_get(fields, i_ev) as FieldDecl*).name);
        }
        return names;
    }

    let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, sym.module_name, sym.owner_name);
    if (enum_info == null) {
        return null;
    }
    let info = enum_info as EnumInfo*;
    for (let i = 0; i < vec_size(info.variants); i = i + 1) {
        let variant_info = ptr_vec_get(info.variants, i) as EnumVariantInfo*;
        if (variant_info.name == sym.name) {
            let names2 = sv_create(sv_size(variant_info.field_names));
            for (let j = 0; j < sv_size(variant_info.field_names); j = j + 1) {
                sv_push(names2, sv_get(variant_info.field_names, j));
            }
            return names2;
        }
    }
    return null;
}

func etc_get_enum_variant_field_names(self: ExpressionTypeChecker*, target_ref: TypeRef*) -> StringVector*? {
    let sym = etc_lookup_symbol(self, target_ref.name, target_ref.module_path, target_ref.name_qualifier);
    if (sym != null) {
        return etc_get_enum_variant_field_names_for_symbol(self, sym as Symbol*);
    }
    return null;
}

func etc_resolve_named_args(self: ExpressionTypeChecker*, span: Span, expected_names: StringVector*, given_labels: StringVector*, given_args: VectorBase*) -> VectorBase*? {
    let count = vec_size(expected_names);
    if (vec_size(given_labels) != vec_size(given_args)) {
        etc_diag_error(self, "TYP-0761", "internal error: named argument label count mismatch",
            (self.current_unit as DriverUnit*).path, span);
        return null;
    }

    let result = id_vec_create(count);
    let errors = false;

    for (let i_r1 = 0; i_r1 < count; i_r1 = i_r1 + 1) {
        let expected_label = sv_get(expected_names, i_r1);
        let found_id = invalid_expr_id();
        let found_count = 0;

        for (let i_r2 = 0; i_r2 < vec_size(given_labels); i_r2 = i_r2 + 1) {
            if (sv_get(given_labels, i_r2) == expected_label) {
                found_id = id_vec_get(given_args, i_r2);
                found_count = found_count + 1;
            }
        }

        if (found_count == 0) {
            etc_diag_error(self, "TYP-0764", "missing required named argument '" + expected_label + "'",
                (self.current_unit as DriverUnit*).path, span);
            errors = true;
        } else if (found_count > 1) {
            etc_diag_error(self, "TYP-0763", "duplicate named argument '" + expected_label + "'",
                (self.current_unit as DriverUnit*).path, span);
            errors = true;
        }

        id_vec_push(result, found_id);
    }

    for (let i_r3 = 0; i_r3 < vec_size(given_labels); i_r3 = i_r3 + 1) {
        let given_label = sv_get(given_labels, i_r3);
        let is_known = false;
        for (let i_r4 = 0; i_r4 < count; i_r4 = i_r4 + 1) {
            if (sv_get(expected_names, i_r4) == given_label) {
                is_known = true;
                break;
            }
        }
        if (!is_known) {
            etc_diag_error(self, "TYP-0762", "unknown named argument '" + given_label + "'",
                (self.current_unit as DriverUnit*).path, span);
            errors = true;
        }
    }

    if (errors) {
        id_vec_free(result);
        return null;
    }
    return result;
}

/**
 * Return the inner expression after removing any parenthesized wrappers.
 *
 * @param self Expression checker state.
 * @param expr_id Expression id to unwrap.
 * @return The first non-parenthesized expression id.
 */
func etc_unwrap_paren_expr_id(self: ExpressionTypeChecker*, expr_id: ExprId) -> ExprId {
    let unit = self.current_unit as DriverUnit*;
    let current = expr_id;
    let done = false;
    while (!done) {
        let expr = expr_arena_get(unit.parse_result.expr_arena, current);
        if (ord(expr.kind) == ord(EX_PAREN)) {
            current = expr.expr_a;
        } else {
            done = true;
        }
    }
    return current;
}
