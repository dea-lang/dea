module module_interface;

import std.vector;
import util.diag;
import types;

/**
 * Represents one object-backed direct module import recorded in a `.l1m`.
 *
 * Entries retain canonical first-occurrence source order. The fingerprint is
 * the expected public-interface fingerprint of the imported provider.
 */
struct InterfaceModuleImport {
    provider_module: string;
    provider_fingerprint: string;
}

/**
 * Represents one per-used-symbol dependency entry recorded in a `.l1m` file.
 *
 * The same shape is reused by both the `require` (surface-tier) group and the
 * `link` (implementation-tier) group; the two are kept as separate vectors on
 * `ModuleInterface` to preserve the dependency tier.
 *
 * `provider_fingerprint` carries the provider module's canonical whole-module
 * fingerprint, repeated for each used symbol.
 */
struct InterfaceDepEntry {
    provider_module: string;
    symbol_name: string;
    provider_fingerprint: string;
}

/**
 * Represents an exported function entry in a module interface.
 */
struct InterfaceFuncEntry {
    name: string;
    param_names: StringVector*;    // parallel to ty.params
    ty: Type*;                     // TY_FUNC, owned
    is_extern: bool;
}

/**
 * Represents an exported let or const entry in a module interface.
 */
struct InterfaceLetEntry {
    name: string;
    ty: Type*;                     // owned
    is_const: bool;
    literal: string;               // canonical literal text; empty for non-const let
}

/**
 * Represents an exported type alias entry in a module interface.
 */
struct InterfaceAliasEntry {
    name: string;
    ty: Type*;                     // aliased type, owned clone
}

/**
 * Represents the in-memory public surface of one module.
 */
struct ModuleInterface {
    module_name: string;
    fingerprint: string;
    has_entry: bool;
    module_imports: VectorBase*;   // InterfaceModuleImport* (ordered, unique providers)
    require_entries: VectorBase*;  // InterfaceDepEntry* (surface-tier, per used symbol)
    link_entries: VectorBase*;     // InterfaceDepEntry* (implementation-tier, per used symbol)
    struct_infos: VectorBase*;     // StructInfo* (cloned, owned)
    enum_infos: VectorBase*;       // EnumInfo* (cloned, owned)
    alias_entries: VectorBase*;    // InterfaceAliasEntry*
    func_entries: VectorBase*;     // InterfaceFuncEntry*
    let_entries: VectorBase*;      // InterfaceLetEntry*
}

/**
 * Wraps the result of parsing a module interface file.
 */
struct InterfaceParseResult {
    interface: ModuleInterface*?;
    diags: DiagCollector*;         // always owned
}
