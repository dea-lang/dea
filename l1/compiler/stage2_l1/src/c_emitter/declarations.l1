import c_emitter.types;

/**
 * Emit a section comment.
 *
 * @param self Emitter to update.
 * @param text Comment text.
 */
func cem_emit_section_comment(self: CEmitter*, text: string) {
    ccb_emit(self.out, "/* " + text + " */");
}

/**
 * Emit a module comment.
 *
 * @param self Emitter to update.
 * @param module_name Module name to report.
 */
func cem_emit_module_comment(self: CEmitter*, module_name: string) {
    ccb_emit(self.out, "/* Module: " + module_name + " */");
}

/**
 * Emit a decorative module separator.
 *
 * @param self Emitter to update.
 * @param module_name Module name to report.
 */
func cem_emit_module_separator(self: CEmitter*, module_name: string) {
    ccb_emit(self.out, "/* -------------------------------- */");
    cem_emit_module_comment(self, module_name);
    ccb_emit(self.out, "/* -------------------------------- */");
}

/**
 * Emit an unreachable-code comment.
 *
 * @param self Emitter to update.
 */
func cem_emit_unreachable_comment(self: CEmitter*) {
    ccb_emit(self.out, "/* unreachable code here */");
}

/**
 * Emit an unreachable runtime marker.
 *
 * @param self Emitter to update.
 * @param reason Marker reason string.
 */
func cem_emit_unreachable_marker(self: CEmitter*, reason: string) {
    let c_reason = se_encode_c_string_bytes(reason);
    ccb_emit(self.out, "DEA_UNREACHABLE(\"" + c_reason + "\"" + ");");
}

/**
 * Emit compile-time guards for the L1 floating-point backend contract.
 *
 * @param self Emitter to update.
 */
func cem_emit_float_contract_guard(self: CEmitter*) {
    if (self.analysis == null || !analysis_uses_floating_point(self.analysis as AnalysisResult*)) {
        return;
    }

    ccb_emit(self.out, "/* L1 floating-point backend contract */");
    ccb_emit(self.out, "#include <float.h>");
    ccb_emit(self.out, "#include <math.h>");
    ccb_emit(self.out, "#if !defined(INFINITY) || !defined(NAN)");
    ccb_emit(self.out, "#error \"L1 float programs require host C infinities and NaNs\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if FLT_RADIX != 2");
    ccb_emit(self.out, "#error \"L1 float programs require binary-radix C floating-point\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if FLT_MANT_DIG != 24 || FLT_MAX_EXP != 128");
    ccb_emit(self.out, "#error \"L1 float programs require IEEE-style binary32 C float semantics\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if DBL_MANT_DIG != 53 || DBL_MAX_EXP != 1024");
    ccb_emit(self.out, "#error \"L1 float programs require IEEE-style binary64 C double semantics\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if defined(__FAST_MATH__)");
    ccb_emit(self.out, "#error \"L1 float programs reject fast-math / Ofast C compilation modes\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if defined(__FINITE_MATH_ONLY__) && __FINITE_MATH_ONLY__ != 0 && !defined(__TINYC__)");
    ccb_emit(self.out, "#error \"L1 float programs reject finite-math-only C compilation modes\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "#if defined(_M_FP_FAST)");
    ccb_emit(self.out, "#error \"L1 float programs reject MSVC /fp:fast mode\"");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "");
}

/**
 * Emit the fixed header boilerplate for one C translation unit.
 *
 * @param self Emitter to update.
 * @param opts Codegen options to honor.
 */
func cem_emit_header(self: CEmitter*, opts: CodegenOptions*) {
    self.trace_arc = opts.trace_arc;
    self.trace_memory = opts.trace_memory;

    ccb_emit(self.out, "/* Generated by l1c, the Dea/L1 compiler. Do not edit. */");
    ccb_emit(self.out, "");
    ccb_emit(self.out, "#include <stdint.h>");
    ccb_emit(self.out, "#include <stdbool.h>");
    ccb_emit(self.out, "#include <stddef.h>");
    ccb_emit(self.out, "");
    cem_emit_float_contract_guard(self);
    ccb_emit(self.out, "/* L1 runtime header */");
    if (self.analysis != null && analysis_uses_sys_real(self.analysis as AnalysisResult*)) {
        ccb_emit(self.out, "#define DEA_USE_SYS_REAL 1");
    }
    if (opts.rt_unchecked) {
        ccb_emit(self.out, "#define DEA_RT_UNCHECKED 1");
    }
    if (opts.rt_check_basic) {
        ccb_emit(self.out, "#define DEA_RT_CHECK_BASIC 1");
    }
    ccb_emit(self.out, "#include \"dea_rt.h\"");
    ccb_emit(self.out, "");
}

/**
 * Return the source filename for a loaded module.
 *
 * @param self Emitter to inspect.
 * @param module_name Loaded module name.
 * @return Source filename when available.
 */
func cem_module_filename(self: CEmitter*, module_name: string) -> string {
    let unit = driver_find_unit(cem_analysis(self).driver_state, module_name);
    if (unit == null) {
        return module_name + ".l1";
    }
    /* Normalize backslashes to forward slashes so that #line directives are
       deterministic regardless of how the path was provided. */
    return replace_s((unit as DriverUnit*).path, "\\", "/");
}

/**
 * Emit a `#line` directive when enabled.
 *
 * @param self Emitter to update.
 * @param line One-based source line.
 * @param current_module Current source module.
 * @param opts Codegen options controlling line directives.
 */
func cem_emit_line_directive(self: CEmitter*, line: int, current_module: string, opts: CodegenOptions*) {
    if (!opts.emit_line_directives || line <= 0) {
        self.active_line_directive = "";
        return;
    }
    self.active_line_directive = "#line " + int_to_string(line) + " \"" +
        se_encode_c_string_bytes(cem_module_filename(self, current_module)) + "\"";
    ccb_emit(self.out, self.active_line_directive);
}

/**
 * Re-emit the current source line directive after generated helper lines.
 *
 * @param self Emitter to update.
 */
func cem_restore_active_line_directive(self: CEmitter*) {
    if (!is_empty_s(self.active_line_directive)) {
        ccb_emit(self.out, self.active_line_directive);
    }
}

/**
 * Emit forward declarations for all structs and enums in compilation order.
 *
 * @param self Emitter to update.
 */
func cem_emit_forward_decls(self: CEmitter*) {
    let state = cem_analysis(self).driver_state;
    ccb_emit(self.out, "/* Forward declarations */");

    for (let i = 0; i < vec_size(state.units); i = i + 1) {
        let unit = ptr_vec_get(state.units, i) as DriverUnit*;
        let root_opt = unit.parse_result.root_module;
        if (root_opt == null) {
            continue;
        }

        let root = root_opt as Module*;
        for (let j = 0; j < vec_size(root.decls); j = j + 1) {
            let decl = ptr_vec_get(root.decls, j) as TopLevelDecl*;
            if (ord(decl.kind) == ord(TD_STRUCT)) {
                let sd = decl.data as StructDecl*;
                if (!cem_module_target_includes_type(self, root.name, sd.name)) {
                    continue;
                }
                ccb_emit(self.out, "struct " + cem_mangle_struct_name(root.name, sd.name) + ";");
            } else if (ord(decl.kind) == ord(TD_ENUM)) {
                let ed = decl.data as EnumDecl*;
                if (!cem_module_target_includes_type(self, root.name, ed.name)) {
                    continue;
                }
                ccb_emit(self.out, "struct " + cem_mangle_enum_name(root.name, ed.name) + ";");
            }
        }
    }

    for (let iface_i = 0; iface_i < driver_interface_count(state); iface_i = iface_i + 1) {
        let mi = driver_interface_get(state, iface_i);
        for (let struct_i = 0; struct_i < vec_size(mi.struct_infos); struct_i = struct_i + 1) {
            let info = ptr_vec_get(mi.struct_infos, struct_i) as StructInfo*;
            if (!cem_module_target_includes_type(self, info.module_name, info.name)) {
                continue;
            }
            ccb_emit(self.out, "struct " + cem_mangle_struct_name(info.module_name, info.name) + ";");
        }
        for (let enum_i = 0; enum_i < vec_size(mi.enum_infos); enum_i = enum_i + 1) {
            let info2 = ptr_vec_get(mi.enum_infos, enum_i) as EnumInfo*;
            if (!cem_module_target_includes_type(self, info2.module_name, info2.name)) {
                continue;
            }
            ccb_emit(self.out, "struct " + cem_mangle_enum_name(info2.module_name, info2.name) + ";");
        }
    }

    ccb_emit(self.out, "");
}

/**
 * Look up enum payload metadata by variant name.
 *
 * @param enum_info Enum metadata to inspect.
 * @param variant_name Variant name to search for.
 * @return Matching variant metadata, or `null` if missing.
 */
func cem_find_enum_variant_info(enum_info: EnumInfo*, variant_name: string) -> EnumVariantInfo*? {
    for (let i = 0; i < vec_size(enum_info.variants); i = i + 1) {
        let info = ptr_vec_get(enum_info.variants, i) as EnumVariantInfo*;
        if (info.name == variant_name) {
            return info;
        }
    }
    return null;
}

/**
 * Emit a complete C struct definition from resolved metadata.
 *
 * @param self Emitter to update.
 * @param struct_info Resolved struct metadata.
 */
func cem_emit_struct_info(self: CEmitter*, struct_info: StructInfo*) {
    let c_name = cem_mangle_struct_name(struct_info.module_name, struct_info.name);
    let guard = "DEA_DEFINED_" + c_name;
    ccb_emit(self.out, "#ifndef " + guard);
    ccb_emit(self.out, "#define " + guard);
    ccb_emit(self.out, "struct " + c_name + " {");
    ccb_indent(self.out);

    for (let i = 0; i < vec_size(struct_info.fields); i = i + 1) {
        let field_info = ptr_vec_get(struct_info.fields, i) as StructFieldInfo*;
        ccb_emit(self.out, cem_emit_type(field_info.field_type) + " " + field_info.name + ";");
    }

    if (vec_size(struct_info.fields) == 0) {
        ccb_emit(self.out, "char __dummy__;");
    }

    ccb_dedent(self.out);
    ccb_emit(self.out, "};");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "");
}

/**
 * Emit an enum as a C tagged-union struct from resolved metadata.
 *
 * @param self Emitter to update.
 * @param enum_info Resolved enum metadata.
 */
func cem_emit_enum_info(self: CEmitter*, enum_info: EnumInfo*) {
    let c_name = cem_mangle_enum_name(enum_info.module_name, enum_info.name);
    let guard = "DEA_DEFINED_" + c_name;
    let tag_enum_name = c_name + "_tag";

    ccb_emit(self.out, "#ifndef " + guard);
    ccb_emit(self.out, "#define " + guard);
    ccb_emit(self.out, "enum " + tag_enum_name + " {");
    ccb_indent(self.out);

    for (let i = 0; i < vec_size(enum_info.variants); i = i + 1) {
        let variant = ptr_vec_get(enum_info.variants, i) as EnumVariantInfo*;
        ccb_emit(self.out, c_name + "_" + variant.name + ",");
    }

    ccb_dedent(self.out);
    ccb_emit(self.out, "};");
    ccb_emit(self.out, "");
    ccb_emit(self.out, "struct " + c_name + " {");
    ccb_indent(self.out);
    ccb_emit(self.out, "enum " + tag_enum_name + " tag;");
    ccb_emit(self.out, "union {");
    ccb_indent(self.out);

    for (let variant_i = 0; variant_i < vec_size(enum_info.variants); variant_i = variant_i + 1) {
        let variant_info = ptr_vec_get(enum_info.variants, variant_i) as EnumVariantInfo*;
        if (vec_size(variant_info.field_types) == 0) {
            ccb_emit(self.out, "struct { char __dummy__; } " + variant_info.name + ";");
            continue;
        }

        with (let sb = sb_create() => sb_free(sb)) {
            sb_append(sb, "struct { ");
            for (let j = 0; j < vec_size(variant_info.field_types); j = j + 1) {
                if (j > 0) {
                    sb_append(sb, "; ");
                }
                let field_type = ptr_vec_get(variant_info.field_types, j) as Type*;
                sb_append(sb, cem_emit_type(field_type));
                sb_append(sb, " ");
                sb_append(sb, sv_get(variant_info.field_names, j));
            }
            sb_append(sb, "; } ");
            sb_append(sb, variant_info.name);
            sb_append(sb, ";");
            ccb_emit(self.out, sb_to_string(sb));
        }
    }

    ccb_dedent(self.out);
    ccb_emit(self.out, "} data;");
    ccb_dedent(self.out);
    ccb_emit(self.out, "};");
    ccb_emit(self.out, "#endif");
    ccb_emit(self.out, "");
}

/**
 * Emit one top-level binding declaration as a static C variable.
 *
 * @param self Emitter to update.
 * @param module_name Name of the defining module.
 * @param decl Binding declaration node.
 * @param let_type Resolved binding type.
 * @param c_init C initializer expression.
 * @param is_exported Whether the symbol is exported.
 */
func cem_emit_let_declaration(self: CEmitter*, module_name: string, decl: LetDecl*, let_type: Type*, c_init: string, is_exported: bool) {
    let c_type = cem_emit_type(let_type);
    let c_name = cem_mangle_let_name(module_name, decl.name);
    let static_prefix = "static ";
    if (is_exported) {
        static_prefix = "";
    }
    if (decl.is_const) {
        ccb_emit(self.out, static_prefix + "const " + c_type + " " + c_name + " = " + c_init + ";");
    } else {
        ccb_emit(self.out, static_prefix + c_type + " " + c_name + " = " + c_init + ";");
    }
}

/**
 * Emit one zero/default-initialized top-level `let` declaration.
 *
 * @param self Emitter to update.
 * @param module_name Name of the defining module.
 * @param decl Binding declaration node.
 * @param let_type Resolved binding type.
 * @param is_exported Whether the symbol is exported.
 */
func cem_emit_zero_initialized_let_declaration(self: CEmitter*, module_name: string, decl: LetDecl*, let_type: Type*, is_exported: bool) {
    let c_type = cem_emit_type(let_type);
    let c_name = cem_mangle_let_name(module_name, decl.name);
    let c_init = cem_emit_zero_initializer(let_type);
    let static_prefix = "static ";
    if (is_exported) {
        static_prefix = "";
    }
    ccb_emit(self.out, static_prefix + c_type + " " + c_name + " = " + c_init + ";");
}

/**
 * Build a function parameter list.
 *
 * @param decl Function declaration node.
 * @param func_type Resolved function type.
 * @return Parameter-list text without surrounding parentheses.
 */
func cem_function_params(decl: FuncDecl*, func_type: Type*) -> string {
    let params = func_type.params as VectorBase*;
    with (let param_names = sv_create(vec_size(params)) => sv_free(param_names)) {
        for (let i = 0; i < vec_size(decl.params); i = i + 1) {
            let param_decl = ptr_vec_get(decl.params, i) as Param*;
            sv_push(param_names, param_decl.name);
        }
        return cem_function_params_from_names(param_names, func_type);
    }
}

/**
 * Build a function parameter list from interface parameter names.
 *
 * @param param_names Parameter names aligned with `func_type.params`.
 * @param func_type Resolved function type.
 * @return Parameter-list text without surrounding parentheses.
 */
func cem_function_params_from_names(param_names: StringVector*, func_type: Type*) -> string {
    let params = func_type.params as VectorBase*;
    if (sv_size(param_names) != vec_size(params)) {
        cem_ice("[ICE-1272] parameter name count mismatch for function type");
    }
    if (vec_size(params) == 0) {
        return "void";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < vec_size(params); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            let param_type = ptr_vec_get(params, i) as Type*;
            sb_append(sb, cem_emit_type(param_type));
            sb_append(sb, " ");
            sb_append(sb, cem_mangle_identifier(sv_get(param_names, i)));
        }
        return sb_to_string(sb);
    }
}

/**
 * Emit a function declaration.
 *
 * @param self Emitter to update.
 * @param module_name Name of the defining module.
 * @param decl Function declaration node.
 * @param func_type Resolved function type.
 * @param is_exported Whether the function is exported.
 */
func cem_emit_function_declaration(self: CEmitter*, module_name: string, decl: FuncDecl*, func_type: Type*, is_exported: bool) {
    let c_name = "";
    if (decl.is_extern) {
        c_name = "(" + decl.name + ")";
    } else {
        c_name = cem_mangle_function_name(module_name, decl.name, func_type);
    }

    let c_return_type = cem_emit_type(func_type.result as Type*);
    let params_str = cem_function_params(decl, func_type);
    let static_prefix = "static ";
    if (is_exported || decl.is_extern) {
        static_prefix = "";
    }
    ccb_emit(self.out, static_prefix + c_return_type + " " + c_name + "(" + params_str + ");");
}

/**
 * Emit a non-static imported L1 ABI function prototype from interface metadata.
 *
 * @param self Emitter to update.
 * @param module_name Provider module name.
 * @param entry Interface function entry.
 */
func cem_emit_interface_function_declaration(self: CEmitter*, module_name: string, entry: InterfaceFuncEntry*) {
    let c_name = "(" + entry.name + ")";
    if (!entry.is_extern) {
        c_name = cem_mangle_function_name(module_name, entry.name, entry.ty);
    }
    let c_return_type = cem_emit_type(entry.ty.result as Type*);
    let params_str = cem_function_params_from_names(entry.param_names, entry.ty);
    ccb_emit(self.out, c_return_type + " " + c_name + "(" + params_str + ");");
}

/**
 * Emit an external declaration for an imported top-level `let` or `const`.
 *
 * @param self Emitter to update.
 * @param module_name Provider module name.
 * @param binding_name Provider-owned binding name.
 * @param binding_type Resolved binding type.
 * @param is_const Whether the binding is a `const`.
 */
func cem_emit_external_let_declaration(
    self: CEmitter*,
    module_name: string,
    binding_name: string,
    binding_type: Type*,
    is_const: bool
) {
    let c_type = cem_emit_type(binding_type);
    let c_name = cem_mangle_let_name(module_name, binding_name);
    if (is_const) {
        ccb_emit(self.out, "extern const " + c_type + " " + c_name + ";");
    } else {
        ccb_emit(self.out, "extern " + c_type + " " + c_name + ";");
    }
}

/**
 * Emit an external binding declaration from interface metadata.
 *
 * @param self Emitter to update.
 * @param module_name Provider module name.
 * @param entry Interface let/const entry.
 */
func cem_emit_interface_let_declaration(self: CEmitter*, module_name: string, entry: InterfaceLetEntry*) {
    cem_emit_external_let_declaration(self, module_name, entry.name, entry.ty, entry.is_const);
}

/**
 * Emit a function definition header.
 *
 * @param self Emitter to update.
 * @param module_name Name of the defining module.
 * @param decl Function declaration node.
 * @param func_type Resolved function type.
 * @param is_exported Whether the function is exported.
 */
func cem_emit_function_definition_header(self: CEmitter*, module_name: string, decl: FuncDecl*, func_type: Type*, is_exported: bool) {
    let c_name = cem_mangle_function_name(module_name, decl.name, func_type);
    let c_return_type = cem_emit_type(func_type.result as Type*);
    let params_str = cem_function_params(decl, func_type);
    let static_prefix = "static ";
    if (is_exported) {
        static_prefix = "";
    }
    ccb_emit(self.out, static_prefix + c_return_type + " " + c_name + "(" + params_str + ")");
    ccb_emit(self.out, "{");
    ccb_indent(self.out);
}

/**
 * Emit an externally linked `void name(void)` function header.
 *
 * @param self Emitter to update.
 * @param c_name External function name.
 */
func cem_emit_external_void_function_header(self: CEmitter*, c_name: string) {
    ccb_emit(self.out, "void " + c_name + "(void" + ")");
    ccb_emit(self.out, "{");
    ccb_indent(self.out);
}

/**
 * Emit a function definition footer.
 *
 * @param self Emitter to update.
 */
func cem_emit_function_definition_footer(self: CEmitter*) {
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
    ccb_emit(self.out, "");
}

/**
 * Emit the compiler-generated entry bridge for one source module.
 *
 * The bridge normalizes every accepted source `main` result to C `int` but
 * deliberately performs no process argument or module lifecycle work.
 *
 * @param self Emitter to update.
 * @param module_name Defining source module.
 * @param func_type Resolved source `main` type.
 */
func cem_emit_module_entry_bridge(self: CEmitter*, module_name: string, func_type: Type*) {
    let mangled_entry = cem_mangle_module_entry_name(module_name);
    let mangled_main = cem_mangle_function_name(module_name, "main", func_type);
    let result_type = func_type.result as Type*;

    ccb_emit(self.out, "int " + mangled_entry + "(void" + ")");
    ccb_emit(self.out, "{");
    ccb_indent(self.out);
    if (type_is_builtin(result_type, "int")) {
        ccb_emit(self.out, "int dea_exit_code = (int) " + mangled_main + "(" + ");");
    } else if (type_is_builtin(result_type, "bool")) {
        ccb_emit(self.out, cem_emit_type(result_type) + " result = " + mangled_main + "(" + ");");
        ccb_emit(self.out, "int dea_exit_code = result ? 0 : 1;");
    } else {
        ccb_emit(self.out, mangled_main + "(" + ");");
        ccb_emit(self.out, "int dea_exit_code = 0;");
    }
    ccb_emit(self.out, "return dea_exit_code;");
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
    ccb_emit(self.out, "");
}
