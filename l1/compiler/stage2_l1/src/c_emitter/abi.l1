module c_emitter.abi;

import std.string;
import std.text;
import std.vector;
import module_lifecycle;
import types;
import c_emitter.state;

/**
 * Build an all-uppercase ASCII variant of an identifier-like string.
 *
 * @param text Input text.
 * @return Uppercased ASCII text.
 */
func cem_upper_ascii(text: string) -> string {
    with (let cb = cb_create() => cb_free(cb)) {
        for (let i = 0; i < len_s(text); i = i + 1) {
            let c = char_at_s(text, i);
            if (c >= 'a' && c <= 'z') {
                cb_append(cb, (c - 'a' + 'A') as byte);
            } else {
                cb_append(cb, c);
            }
        }
        return cb_to_string(cb);
    }
}

/**
 * Return whether a name starts with any reserved generated/runtime prefix.
 *
 * @param name Identifier text to inspect.
 * @return `true` when the prefix is reserved by the backend/runtime.
 */
func cem_has_reserved_prefix(name: string) -> bool {
    return starts_with_s(name, "l0_") || starts_with_s(name, "_l0_") ||
           starts_with_s(name, "rt_") || starts_with_s(name, "_rt_") ||
           starts_with_s(name, "L0_") || starts_with_s(name, "_L0_") ||
           starts_with_s(name, "dea_") || starts_with_s(name, "_dea_") ||
           starts_with_s(name, "DEA_") || starts_with_s(name, "_DEA_");
}

/**
 * Mangle a declared source leaf name when it collides with reserved prefixes.
 *
 * @param name Declared source name.
 * @return Original or suffixed leaf name.
 */
func cem_mangle_source_leaf_name(name: string) -> string {
    if (cem_has_reserved_prefix(name) || starts_with_s(name, "_") || ends_with_s(name, "__v")) {
        return name + "__v";
    }
    return name;
}

/**
 * Return whether a name conflicts with a C keyword or restricted identifier.
 *
 * @param name Identifier text to inspect.
 * @return `true` if the name must be mangled.
 */
func cem_is_c_keyword(name: string) -> bool {
    return name == "auto" || name == "break" || name == "case" || name == "char" ||
           name == "const" || name == "continue" || name == "default" || name == "do" ||
           name == "double" || name == "else" || name == "enum" || name == "extern" ||
           name == "float" || name == "for" || name == "goto" || name == "if" ||
           name == "inline" || name == "int" || name == "long" || name == "register" ||
           name == "restrict" || name == "return" || name == "short" || name == "signed" ||
           name == "sizeof" || name == "static" || name == "struct" || name == "switch" ||
           name == "typedef" || name == "union" || name == "unsigned" || name == "void" ||
           name == "volatile" || name == "while" || name == "alignas" || name == "alignof" ||
           name == "atomic" || name == "bool" || name == "complex" || name == "imaginary" ||
           name == "NULL" || name == "null" || name == "true" || name == "false" ||
           name == "asm" || name == "offsetof" || name == "typeof";
}

/**
 * Canonical mangler for the LBI tagged-section ABI.
 *
 * Emits `__deaM<seg_len><seg>...<sigil><component_len><component>`,
 * where the `M` section length-prefixes each dotted module-path segment and
 * the final section identifies the symbol category. The full normative spec
 * lives in `l1/docs/specs/compiler/abi.md`.
 *
 * @param module_name Module name in dotted source form (for example `std.integer`).
 * @param sigil One-character LBI section sigil.
 * @param component Section component.
 * @return Mangled LBI name.
 */
func cem_mangle_lbi_section(module_name: string, sigil: string, component: string) -> string {
    if (len_s(sigil) != 1) {
        cem_ice("[ICE-1371] invalid LBI sigil '" + sigil + "'");
    }
    with (let cb = cb_create() => cb_free(cb)) {
        cb_append_s(cb, "__dea");
        cb_append_s(cb, "M");
        let seg_start = 0;
        let mod_len = len_s(module_name);
        for (let i = 0; i <= mod_len; i = i + 1) {
            let at_end = (i == mod_len);
            let at_dot = !at_end && char_at_s(module_name, i) == '.';
            if (at_end || at_dot) {
                let seg_len = i - seg_start;
                if (seg_len == 0) {
                    cem_ice("[ICE-1370] empty module-path segment in '" + module_name + "'");
                }
                cb_append_s(cb, int_to_string(seg_len));
                cb_append_slice(cb, module_name, seg_start, seg_len);
                seg_start = i + 1;
            }
        }
        cb_append_s(cb, sigil);
        cb_append_s(cb, int_to_string(len_s(component)));
        cb_append_s(cb, component);
        return cb_to_string(cb);
    }
}

/**
 * Encode a type as an ABI type component.
 *
 * @param ty Type to encode.
 * @param cb Destination character buffer.
 */
func cem_mangle_type_component_to_cb(ty: Type*, cb: CharBuffer*) {
    let kind = ord(ty.kind);
    if (kind == ord(TY_BUILTIN)) {
        if (ty.name == "tiny")   { cb_append_s(cb, "a"); return; }
        if (ty.name == "byte")   { cb_append_s(cb, "h"); return; }
        if (ty.name == "short")  { cb_append_s(cb, "s"); return; }
        if (ty.name == "ushort") { cb_append_s(cb, "t"); return; }
        if (ty.name == "int")    { cb_append_s(cb, "i"); return; }
        if (ty.name == "uint")   { cb_append_s(cb, "j"); return; }
        if (ty.name == "long")   { cb_append_s(cb, "l"); return; }
        if (ty.name == "ulong")  { cb_append_s(cb, "m"); return; }
        if (ty.name == "float")  { cb_append_s(cb, "f"); return; }
        if (ty.name == "double") { cb_append_s(cb, "d"); return; }
        if (ty.name == "bool")   { cb_append_s(cb, "z"); return; }
        if (ty.name == "string") { cb_append_s(cb, "c"); return; }
        if (ty.name == "void")   { cb_append_s(cb, "v"); return; }
        // Fallback for non-canonical builtins
        cb_append_s(cb, "B");
        cb_append_s(cb, int_to_string(len_s(ty.name)));
        cb_append_s(cb, ty.name);
        return;
    }
    if (kind == ord(TY_STRUCT)) {
        cb_append_s(cb, "M");
        cb_append_s(cb, cem_mangle_module_path_components(ty.module_name));
        cb_append_s(cb, "S");
        cb_append_s(cb, int_to_string(len_s(ty.name)));
        cb_append_s(cb, ty.name);
        return;
    }
    if (kind == ord(TY_ENUM)) {
        cb_append_s(cb, "M");
        cb_append_s(cb, cem_mangle_module_path_components(ty.module_name));
        cb_append_s(cb, "E");
        cb_append_s(cb, int_to_string(len_s(ty.name)));
        cb_append_s(cb, ty.name);
        return;
    }
    if (kind == ord(TY_POINTER)) {
        cb_append_s(cb, "P");
        cem_mangle_type_component_to_cb(ty.inner as Type*, cb);
        return;
    }
    if (kind == ord(TY_NULLABLE)) {
        cb_append_s(cb, "Q");
        cem_mangle_type_component_to_cb(ty.inner as Type*, cb);
        return;
    }
    if (kind == ord(TY_ARRAY)) {
        cb_append_s(cb, "A");
        cb_append_s(cb, int_to_string(ty.array_len));
        cb_append_s(cb, "_");
        cem_mangle_type_component_to_cb(ty.inner as Type*, cb);
        return;
    }
    if (kind == ord(TY_SLICE)) {
        cb_append_s(cb, "W");
        cem_mangle_type_component_to_cb(ty.inner as Type*, cb);
        return;
    }
    if (kind == ord(TY_FUNC)) {
        if (ty.is_unsafe) {
            cb_append_s(cb, "X");
        }
        cb_append_s(cb, "F");
        let params = ty.params as VectorBase*;
        cb_append_s(cb, int_to_string(vec_size(params)));
        for (let i = 0; i < vec_size(params); i = i + 1) {
            let param = *(vec_get(params, i) as Type**);
            if (ty.is_variadic && i == vec_size(params) - 1 && ord(param.kind) == ord(TY_SLICE)) {
                cb_append_s(cb, "V");
                cem_mangle_type_component_to_cb(param.inner as Type*, cb);
            } else {
                cem_mangle_type_component_to_cb(param, cb);
            }
        }
        cem_mangle_type_component_to_cb(ty.result as Type*, cb);
        return;
    }
}

/**
 * Encode a type as an ABI type component string.
 *
 * @param ty Type to encode.
 * @return Mangled type component.
 */
func cem_mangle_type_component(ty: Type*) -> string {
    with (let cb = cb_create() => cb_free(cb)) {
        cem_mangle_type_component_to_cb(ty, cb);
        return cb_to_string(cb);
    }
}

/**
 * Mangler for value-like LBI symbols (functions, let/const bindings).
 *
 * @param module_name Module name in dotted source form.
 * @param value_name Symbol name.
 * @param ty Optional type for functions (to append the type component).
 * @return Mangled LBI name with 'N' sigil.
 */
func cem_mangle_lbi_value(module_name: string, value_name: string, ty: Type*?) -> string {
    with (let cb = cb_create() => cb_free(cb)) {
        cb_append_s(cb, "__deaM");
        cb_append_s(cb, cem_mangle_module_path_components(module_name));
        cb_append_s(cb, "N");
        cb_append_s(cb, int_to_string(len_s(value_name)));
        cb_append_s(cb, value_name);
        if (ty != null) {
            cem_mangle_type_component_to_cb(ty as Type*, cb);
        }
        return cb_to_string(cb);
    }
}

/**
 * Mangler for struct types.
 *
 * @param module_name Module name.
 * @param struct_name Struct name.
 * @return Mangled LBI name with 'S' sigil.
 */
func cem_mangle_lbi_struct(module_name: string, struct_name: string) -> string {
    return cem_mangle_lbi_section(module_name, "S", struct_name);
}

/**
 * Mangler for enum types.
 *
 * @param module_name Module name.
 * @param enum_name Enum name.
 * @return Mangled LBI name with 'E' sigil.
 */
func cem_mangle_lbi_enum(module_name: string, enum_name: string) -> string {
    return cem_mangle_lbi_section(module_name, "E", enum_name);
}

/**
 * Encode a module path as length-prefixed ABI components.
 *
 * @param module_name Dotted module name.
 * @return Encoded module path without the leading `M`.
 */
func cem_mangle_module_path_components(module_name: string) -> string {
    with (let cb = cb_create() => cb_free(cb)) {
        let seg_start = 0;
        let mod_len = len_s(module_name);
        for (let i = 0; i <= mod_len; i = i + 1) {
            let at_end = (i == mod_len);
            let at_dot = !at_end && char_at_s(module_name, i) == '.';
            if (at_end || at_dot) {
                let seg_len = i - seg_start;
                cb_append_s(cb, int_to_string(seg_len));
                cb_append_slice(cb, module_name, seg_start, seg_len);
                seg_start = i + 1;
            }
        }
        return cb_to_string(cb);
    }
}

/**
 * Mangle a struct name.
 *
 * @param module_name Defining module name.
 * @param struct_name Struct name.
 * @return Mangled C struct name.
 */
func cem_mangle_struct_name(module_name: string, struct_name: string) -> string {
    return cem_mangle_lbi_struct(module_name, struct_name);
}

/**
 * Mangle an enum name.
 *
 * @param module_name Defining module name.
 * @param enum_name Enum name.
 * @return Mangled C enum name.
 */
func cem_mangle_enum_name(module_name: string, enum_name: string) -> string {
    return cem_mangle_lbi_enum(module_name, enum_name);
}

/**
 * Mangle a function name.
 *
 * @param module_name Defining module name.
 * @param func_name Function name.
 * @param func_type Function type to encode.
 * @return Mangled C function name.
 */
func cem_mangle_function_name(module_name: string, func_name: string, func_type: Type*) -> string {
    return cem_mangle_lbi_value(module_name, func_name, func_type);
}

/**
 * Mangle a top-level let name.
 *
 * @param module_name Defining module name.
 * @param let_name Let name.
 * @return Mangled C identifier.
 */
func cem_mangle_let_name(module_name: string, let_name: string) -> string {
    return cem_mangle_lbi_value(module_name, let_name, null);
}

/**
 * Mangle one module-initializer function name.
 *
 * @param module_name Defining module name.
 * @return Reserved LBI identifier.
 */
func cem_mangle_module_init_name(module_name: string) -> string {
    return ml_init_symbol_name(module_name);
}

/**
 * Mangle one module-finalizer function name.
 *
 * @param module_name Defining module name.
 * @return Reserved LBI identifier.
 */
func cem_mangle_module_fini_name(module_name: string) -> string {
    return ml_fini_symbol_name(module_name);
}

/**
 * Mangle one module-entry bridge name.
 *
 * @param module_name Defining module name.
 * @return Reserved LBI identifier.
 */
func cem_mangle_module_entry_name(module_name: string) -> string {
    return ml_entry_symbol_name(module_name);
}

/**
 * Mangle a local identifier when needed.
 *
 * @param name Identifier to inspect.
 * @return Original or suffixed identifier.
 */
func cem_mangle_identifier(name: string) -> string {
    if (cem_is_c_keyword(name) || ends_with_s(name, "__v") || cem_has_reserved_prefix(name) || starts_with_s(name, "_")) {
        return name + "__v";
    }
    return name;
}
