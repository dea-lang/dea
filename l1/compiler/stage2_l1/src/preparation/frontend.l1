module preparation.frontend;

import sys.rt;
import std.fs;
import std.hashset;
import std.io;
import std.path;
import std.string;
import std.text;
import std.vector;
import analysis;
import backend;
import build_driver;
import cli_args.model;
import codegen_options;
import compiler_filesystem;
import driver.state;
import module_graph;
import module_graph.order;
import sem_context;
import source_paths;
import util.diag;
import util.log;

extern func l1c_prep_write(context: void*, relative: byte*, length: int, data: byte*, size: int) -> int;
extern func l1c_prep_copy_interfaces(context: void*) -> int;
extern func l1c_prep_compile(context: void*, module_name: byte*, length: int) -> int;
extern func l1c_prep_runtime(context: void*) -> int;

/** Copy frontend diagnostics while keeping ownership in the analysis result. */
func pr_copy_diags(dst: DiagCollector*, src: DiagCollector*) {
    for (let i = 0; i < diag_count(src); i = i + 1) { diag_copy(dst, diag_get(src, i)); }
}

/** Write generated bytes only to a manifest-declared output role. */
func pr_write(context: void*, relative: string, data: string) -> bool {
    return l1c_prep_write(context, rt_string_bytes_ptr(relative), len_s(relative),
        rt_string_bytes_ptr(data), len_s(data)) == 1;
}

/** Generate canonical bundled C from source and the selected semantic interfaces. */
func pr_generate_module(name: string, search: SourceSearchPaths*, interfaces: StringVector*,
    opts: CliOptions*, cfg: LogConfig*, diags: DiagCollector*) -> string? {
    with (
        let unit = analysis_analyze_entry_with_resolution(search, name, interfaces,
            MRP_REQUIRE_INTERFACE, null, cfg) => analysis_result_free(unit),
        let codegen = cg_options_from_cli(opts) => cg_options_free(codegen),
        let c_options = bd_collect_c_option_words(opts) => sv_free(c_options)
    ) {
        pr_copy_diags(diags, unit.diags);
        if (analysis_has_errors(unit)) {
            cli_emit_error(diags, "L1C-2158", "invalid bundled source or semantic preparation inputs; rerun make build-stage1 or repair installation");
            return null;
        }
        if (!bd_validate_float_c_options(unit, c_options, diags)) { return null; }
        let c_text = backend_generate_module(unit, name, codegen, cfg);
        if (analysis_has_errors(unit)) { pr_copy_diags(diags, unit.diags); return null; }
        return c_text;
    }
}

/** Compile a bundled module without independently emitting its semantic interface. */
func pr_frontend_module(context: void*, name: string, search: SourceSearchPaths*,
    interfaces: StringVector*, opts: CliOptions*, cfg: LogConfig*, diags: DiagCollector*) -> bool {
    let c_text = pr_generate_module(name, search, interfaces, opts, cfg, diags);
    if (c_text == null) { return false; }
    let module_stem = sp_module_relstem(name) as string;
    if (!pr_write(context, "generated/" + module_stem + ".c", c_text as string)) { return false; }
    return l1c_prep_compile(context, rt_string_bytes_ptr(name), len_s(name)) == 1;
}

/** Validate every selected interface and copy the complete bundled dependency order. */
func pr_frontend_workspace_order(semantic_root: string, home: string, module_names: string,
    workspace: CompilerWorkspace*, cfg: LogConfig*, diags: DiagCollector*) -> StringVector*? {
    with (
        let names = split_s(module_names, "\n") => sv_free(names),
        let modules = ss_create() => ss_free(modules),
        let project_roots = sv_create(1) => sv_free(project_roots),
        let sys_roots = sv_create(1) => sv_free(sys_roots),
        let interfaces = sv_create(1) => sv_free(interfaces),
        let source = sb_create() => sb_free(source)
    ) {
        sb_append(source, "module _dea_preparation;\n");
        for (let i = 0; i < sv_size(names); i = i + 1) {
            let name = sv_get(names, i);
            if (len_s(name) > 0) {
                ss_add(modules, name);
                sb_append(source, "import " + name + ";\n");
            }
        }
        let umbrella = cfs_workspace_child(workspace, "_dea_preparation.l1");
        if (write_file(umbrella, sb_to_string(source)) == null) {
            cli_emit_error(diags, "L1C-2155", "cannot write preparation source workspace");
            return null;
        }
        sv_push(project_roots, workspace.root);
        sv_push(sys_roots, join(home, "shared/l1/stdlib"));
        sv_push(interfaces, semantic_root);
        with (
            let search = sp_build_from_roots(project_roots, sys_roots) => sp_free(search),
            let graph_result = analysis_analyze_entry_with_resolution(search, "_dea_preparation", interfaces,
                MRP_REQUIRE_INTERFACE, null, cfg) => analysis_result_free(graph_result)
        ) {
            pr_copy_diags(diags, graph_result.diags);
            if (analysis_has_errors(graph_result)) {
                cli_emit_error(diags, "L1C-2158", "invalid bundled semantic preparation inputs; rerun make build-stage1 or repair installation");
                return null;
            }
            let ordered_opt = mg_dependency_order(driver_graph(graph_result.driver_state), "_dea_preparation", diags);
            if (ordered_opt == null) { return null; }
            with (let ordered = ordered_opt as VectorBase* => vec_free(ordered)) {
                let names_in_order = sv_create(ss_size(modules));
                for (let i = 0; i < vec_size(ordered); i = i + 1) {
                    let node = (*(vec_get(ordered, i) as void**)) as ModuleGraphNode*;
                    if (ss_has(modules, node.module_name)) { sv_push(names_in_order, node.module_name); }
                }
                return names_in_order;
            }
        }
    }
}

/** Return owned module names after releasing the validation graph and temporary workspace. */
func pr_frontend_order(semantic_root: string, home: string, module_names: string,
    cfg: LogConfig*, diags: DiagCollector*) -> StringVector*? {
    let workspace_opt = cfs_workspace_create("prepare", diags);
    if (workspace_opt == null) { return null; }
    with (let workspace = workspace_opt as CompilerWorkspace* => cfs_workspace_free(workspace)) {
        let ordered = pr_frontend_workspace_order(semantic_root, home, module_names, workspace, cfg, diags);
        if (!cfs_workspace_cleanup(workspace, diags)) {
            if (ordered != null) { sv_free(ordered as StringVector*); }
            return null;
        }
        return ordered;
    }
}

/** Generate complete profiles without re-emitting their authoritative semantic interfaces. */
func pr_frontend_prepare(context: void*, semantic_root: string, home: string, ordered: StringVector*,
    opts: CliOptions*, cfg: LogConfig*, diags: DiagCollector*) -> bool {
    if (l1c_prep_copy_interfaces(context) != 1) { return false; }
    with (let search = sp_create() => sp_free(search),
          let interfaces = sv_create(1) => sv_free(interfaces)) {
        sp_add_system_root(search, join(home, "shared/l1/stdlib"));
        sv_push(interfaces, semantic_root);
        for (let i = 0; i < sv_size(ordered); i = i + 1) {
            let name = sv_get(ordered, i);
            if (opts.verbosity >= 1) { err_printl_s("Preparing module " + name); }
            if (!pr_frontend_module(context, name, search, interfaces, opts, cfg, diags)) { return false; }
        }
    }
    return l1c_prep_runtime(context) == 1;
}
