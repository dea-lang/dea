module map_test;

import std.io;
import std.string;
import std.linear_map;
import std.text;

/**
 * Helper function to print a labeled boolean value.
 *
 * @param label The label to print.
 * @param val The value to process.
 */
func print_bool(label: string, val: bool) {
    if (val) {
        printl_ss(label, "true");
    } else {
        printl_ss(label, "false");
    }
}

/**
 * Tests test_sslm.
 */
func test_sslm() {
    printl_s("=== StringStringLinearMap Test ===");

    // Create map
    printl_s("Creating map with initial capacity 4...");
    let m = sslm_create(4);
    printl_si("Length:", sslm_len(m));

    // Test set and get
    printl_s("\nAdding entries...");
    sslm_set(m, "foo", "bar");
    sslm_set(m, "hello", "world");
    sslm_set(m, "key1", "value1");
    printl_si("Length:", sslm_len(m));

    // Test get
    printl_s("\nTesting get...");
    let v1 = sslm_get(m, "foo");
    if (v1 != null) {
        printl_ss("  foo =>", v1 as string);
    } else {
        printl_s("  foo => NOT FOUND");
    }

    let v2 = sslm_get(m, "hello");
    if (v2 != null) {
        printl_ss("  hello =>", v2 as string);
    } else {
        printl_s("  hello => NOT FOUND");
    }

    let v3 = sslm_get(m, "nonexistent");
    if (v3 != null) {
        printl_ss("  nonexistent =>", v3 as string);
    } else {
        printl_s("  nonexistent => NOT FOUND (expected)");
    }

    // Test contains
    printl_s("\nTesting contains...");
    print_bool("  contains 'foo': ", sslm_contains(m, "foo"));
    print_bool("  contains 'missing': ", sslm_contains(m, "missing"));

    // Test update existing key
    printl_s("\nUpdating 'foo' to 'baz'...");
    sslm_set(m, "foo", "baz");
    let v4 = sslm_get(m, "foo");
    if (v4 != null) {
        printl_ss("  foo =>", v4 as string);
    }
    printl_si("Length (should still be 3):", sslm_len(m));

    // Test iteration
    printl_s("\nIterating over map...");
    for (let final_i = 0; final_i < sslm_len(m); final_i = final_i + 1) {
        let k = sslm_key_at(m, final_i);
        let v = sslm_value_at(m, final_i);
        printl_s("  " + k + " => " + v);
    }

    // Test remove
    printl_s("\nRemoving 'hello'...");
    let removed = sslm_remove(m, "hello");
    print_bool("  Removed: ", removed);
    printl_si("Length:", sslm_len(m));

    printl_s("\nTrying to remove 'hello' again...");
    let removed2 = sslm_remove(m, "hello");
    print_bool("  Removed: ", removed2);

    // Final iteration
    printl_s("\nFinal map contents:");
    for (let i = 0; i < sslm_len(m); i = i + 1) {
        let k = sslm_key_at(m, i);
        let v = sslm_value_at(m, i);
        printl_s("  " + k + " => " + v);
    }

    // Free
    printl_s("\nFreeing map...");
    sslm_free(m);
    printl_s("Done!");
}

/**
 * Tests test_islm.
 */
func test_islm() {
    printl_s("\n=== IntStringLinearMap Test ===");

    // Create map
    printl_s("Creating map with initial capacity 4...");
    let m = islm_create(4);
    printl_si("Length:", islm_len(m));

    // Test set
    printl_s("\nAdding entries...");
    islm_set(m, 1, "one");
    islm_set(m, 2, "two");
    islm_set(m, 42, "forty-two");
    printl_si("Length:", islm_len(m));

    // Test get
    printl_s("\nTesting get...");
    let v1 = islm_get(m, 1);
    if (v1 != null) {
        printl_ss("  1 =>", v1 as string);
    } else {
        printl_s("  1 => NOT FOUND");
    }

    let v2 = islm_get(m, 42);
    if (v2 != null) {
        printl_ss("  42 =>", v2 as string);
    } else {
        printl_s("  42 => NOT FOUND");
    }

    let v3 = islm_get(m, 999);
    if (v3 != null) {
        printl_ss("  999 =>", v3 as string);
    } else {
        printl_s("  999 => NOT FOUND (expected)");
    }

    // Test contains
    printl_s("\nTesting contains...");
    print_bool("  contains 1: ", islm_contains(m, 1));
    print_bool("  contains 999: ", islm_contains(m, 999));

    // Test update existing key
    printl_s("\nUpdating key 1 to 'ONE'...");
    islm_set(m, 1, "ONE");
    let v4 = islm_get(m, 1);
    if (v4 != null) {
        printl_ss("  1 =>", v4 as string);
    }
    printl_si("Length (should still be 3):", islm_len(m));

    // Test iteration
    printl_s("\nIterating over map...");
    for (let final_i = 0; final_i < islm_len(m); final_i = final_i + 1) {
        let k = islm_key_at(m, final_i);
        let val = islm_value_at(m, final_i);
        printl_si("  key:", k);
        printl_ss("    value:", val);
    }

    // Test remove
    printl_s("\nRemoving key 2...");
    let removed = islm_remove(m, 2);
    print_bool("  Removed: ", removed);
    printl_si("Length:", islm_len(m));

    printl_s("\nTrying to remove key 2 again...");
    let removed2 = islm_remove(m, 2);
    print_bool("  Removed: ", removed2);

    // Final iteration
    printl_s("\nFinal map contents:");
    for (let i = 0; i < islm_len(m); i = i + 1) {
        let k = islm_key_at(m, i);
        let val = islm_value_at(m, i);
        printl_si("  key:", k);
        printl_ss("    value:", val);
    }

    // Free
    printl_s("\nFreeing map...");
    islm_free(m);
    printl_s("Done!");
}

/**
 * Tests test_empty_sslm.
 */
func test_empty_sslm() {
    printl_s("\n=== Empty StringStringLinearMap Test ===");

    let m = sslm_create(4);
    printl_si("Empty map length:", sslm_len(m));

    // Test get on empty map
    printl_s("Testing get on empty map...");
    let v = sslm_get(m, "nonexistent");
    if (v != null) {
        printl_s("  ERROR: get returned non-null on empty map!");
    } else {
        printl_s("  get('nonexistent') => null (expected)");
    }

    // Test contains on empty map
    printl_s("Testing contains on empty map...");
    print_bool("  contains('key'): ", sslm_contains(m, "key"));

    // Test remove on empty map
    printl_s("Testing remove on empty map...");
    let removed = sslm_remove(m, "key");
    print_bool("  remove('key'): ", removed);

    // Test iteration on empty map
    printl_s("Testing iteration on empty map...");
    printl_s("  (iterating over 0 elements)");
    for (let i = 0; i < sslm_len(m); i = i + 1) {
        printl_s("  ERROR: should not iterate on empty map!");
    }
    printl_s("  (iteration complete)");

    sslm_free(m);
    printl_s("Empty map test passed!");
}

/**
 * Tests test_sslm_growth.
 */
func test_sslm_growth() {
    printl_s("\n=== StringStringLinearMap Growth Test ===");

    // Start with small capacity
    let m = sslm_create(2);
    printl_s("Created map with initial capacity 2");

    // Add entries to trigger growth using explicit keys
    printl_s("Adding entries to trigger multiple resizes...");
    sslm_set(m, "key0", "value0");
    sslm_set(m, "key1", "value1");
    sslm_set(m, "key2", "value2");
    sslm_set(m, "key3", "value3");
    sslm_set(m, "key4", "value4");
    sslm_set(m, "key5", "value5");
    sslm_set(m, "key6", "value6");
    sslm_set(m, "key7", "value7");
    sslm_set(m, "key8", "value8");
    sslm_set(m, "key9", "value9");

    printl_si("Length after 10 entries:", sslm_len(m));

    // Verify some values
    printl_s("Verifying values...");
    let v0 = sslm_get(m, "key0");
    if (v0 != null) {
        printl_ss("  key0 =>", v0 as string);
    } else {
        printl_s("  ERROR: key0 not found!");
    }

    let v5 = sslm_get(m, "key5");
    if (v5 != null) {
        printl_ss("  key5 =>", v5 as string);
    } else {
        printl_s("  ERROR: key5 not found!");
    }

    let v9 = sslm_get(m, "key9");
    if (v9 != null) {
        printl_ss("  key9 =>", v9 as string);
    } else {
        printl_s("  ERROR: key9 not found!");
    }

    // Verify contains
    print_bool("  contains 'key0': ", sslm_contains(m, "key0"));
    print_bool("  contains 'key9': ", sslm_contains(m, "key9"));
    print_bool("  contains 'key99': ", sslm_contains(m, "key99"));

    sslm_free(m);
    printl_s("Growth test passed!");
}

/**
 * Tests test_empty_islm.
 */
func test_empty_islm() {
    printl_s("\n=== Empty IntStringLinearMap Test ===");

    let m = islm_create(4);
    printl_si("Empty map length:", islm_len(m));

    // Test get on empty map
    printl_s("Testing get on empty map...");
    let v = islm_get(m, 42);
    if (v != null) {
        printl_s("  ERROR: get returned non-null on empty map!");
    } else {
        printl_s("  get(42) => null (expected)");
    }

    // Test contains on empty map
    printl_s("Testing contains on empty map...");
    print_bool("  contains(42): ", islm_contains(m, 42));

    // Test remove on empty map
    printl_s("Testing remove on empty map...");
    let removed = islm_remove(m, 42);
    print_bool("  remove(42): ", removed);

    // Test iteration on empty map
    printl_s("Testing iteration on empty map...");
    for (let i = 0; i < islm_len(m); i = i + 1) {
        printl_s("  ERROR: should not iterate on empty map!");
    }
    printl_s("  (iteration complete)");

    islm_free(m);
    printl_s("Empty map test passed!");
}

/**
 * Tests test_islm_growth.
 */
func test_islm_growth() {
    printl_s("\n=== IntStringLinearMap Growth Test ===");

    // Start with small capacity
    let m = islm_create(2);
    printl_s("Created map with initial capacity 2");

    // Add entries to trigger growth using explicit values
    printl_s("Adding entries to trigger multiple resizes...");
    islm_set(m, 0, "value0");
    islm_set(m, 1, "value1");
    islm_set(m, 2, "value2");
    islm_set(m, 3, "value3");
    islm_set(m, 4, "value4");
    islm_set(m, 5, "value5");
    islm_set(m, 6, "value6");
    islm_set(m, 7, "value7");
    islm_set(m, 8, "value8");
    islm_set(m, 9, "value9");

    printl_si("Length after 10 entries:", islm_len(m));

    // Verify some values
    printl_s("Verifying values...");
    let v0 = islm_get(m, 0);
    if (v0 != null) {
        printl_ss("  0 =>", v0 as string);
    } else {
        printl_s("  ERROR: key 0 not found!");
    }

    let v5 = islm_get(m, 5);
    if (v5 != null) {
        printl_ss("  5 =>", v5 as string);
    } else {
        printl_s("  ERROR: key 5 not found!");
    }

    let v9 = islm_get(m, 9);
    if (v9 != null) {
        printl_ss("  9 =>", v9 as string);
    } else {
        printl_s("  ERROR: key 9 not found!");
    }

    // Verify contains
    print_bool("  contains 0: ", islm_contains(m, 0));
    print_bool("  contains 9: ", islm_contains(m, 9));
    print_bool("  contains 99: ", islm_contains(m, 99));

    islm_free(m);
    printl_s("Growth test passed!");
}

/**
 * Main entry point for the module.
 */
func main() {
    test_sslm();
    test_islm();
    test_empty_sslm();
    test_sslm_growth();
    test_empty_islm();
    test_islm_growth();

    printl_s("\n======================================");
    printl_s("    All Map tests passed!");
    printl_s("======================================");
}
