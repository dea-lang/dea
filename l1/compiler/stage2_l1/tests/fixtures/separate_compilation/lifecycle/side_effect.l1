module lifecycle.side_effect;

extern func rt_string_concat(a: string, b: string) -> string;
extern func lifecycle_record(tag: int) -> int;

let side_effect_state: string = rt_string_concat("side", "-effect-state");
let side_effect_step: int = lifecycle_record(3);
