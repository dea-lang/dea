module opaque_pointer_ok;

export opaque { Handle }, make_handle, identity;

struct Handle {
    value: int;
}

func make_handle(value: int) -> Handle* {
    return new Handle(value);
}

func identity(handle: Handle*) -> Handle* {
    return handle;
}
