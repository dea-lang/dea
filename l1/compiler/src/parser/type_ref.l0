module parser.type_ref;

import std.vector;
import tokens;
import ast;
import parser.cursor;
import parser.state;
import parser.token_value;

/* ---------------------------------
   Type parsing
   --------------------------------- */

/**
 * Free an optional vector of parsed type references.
 *
 * @param items Optional vector of `TypeRef*` values.
 */
func type_ref_vec_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let refs = items as VectorBase*;
    for (let i = 0; i < vec_size(refs); i = i + 1) {
        type_ref_free(ptr_vec_get(refs, i) as TypeRef*);
    }
    vec_free(refs);
}

/**
 * Free an optional vector of parsed type suffixes.
 *
 * @param items Optional vector of `TypeSuffix*` values.
 */
func type_suffix_vec_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let suffixes = items as VectorBase*;
    for (let i = 0; i < vec_size(suffixes); i = i + 1) {
        let suffix = ptr_vec_get(suffixes, i) as TypeSuffix*;
        drop suffix;
    }
    vec_free(suffixes);
}

/**
 * Parse the narrow constant-expression subset accepted inside array type suffixes.
 *
 * @param self Parser state to advance.
 * @return Parsed literal or const-reference expression, or `null` on syntax error.
 */
func ps_parse_const_int_expr(self: ParserState*) -> ExprId? {
    let start = ps_span_start(self);
    let tok = ps_peek(self);

    if (ps_match_int(self)) {
        let node = expr_node_create(EX_INT, ps_extend_span(self, start));
        node.int_value = token_int_value(tok) as int;
        node.text_value = token_int_text(tok) as string;
        return expr_arena_add(self.expr_arena, node);
    }

    if (ps_check_ident(self)) {
        let qualified = ps_try_parse_qualified_name(self);
        if (qualified != null) {
            let q = qualified as QualifiedNameResult*;
            let node = expr_node_create(EX_VAR_REF, ps_extend_span(self, start));
            node.text_value = token_ident_text(q.name_tok) as string;
            node.module_path = q.module_path;
            node.name_qualifier = q.name_qualifier;
            drop q;
            return expr_arena_add(self.expr_arena, node);
        }

        let name_tok = ps_advance(self);
        let node2 = expr_node_create(EX_VAR_REF, ps_extend_span(self, start));
        node2.text_value = token_ident_text(name_tok) as string;
        return expr_arena_add(self.expr_arena, node2);
    }

    ps_emit_error(self, "PAR-0620", "expected constant integer expression in array type", tok);
    return null;
}

/**
 * Parse the non-suffixed base of a type reference.
 *
 * @param self Parser state to advance.
 * @param start Starting span for the full type.
 * @return Parsed type reference, or `null` on parse error.
 */
func ps_parse_type_atom(self: ParserState*, start: Span) -> TypeRef*? {
    let is_unsafe = false;
    if (ps_match(self, ord(TT_UNSAFE))) {
        if (!ps_check(self, ord(TT_FUNC))) {
            ps_emit_error(self, "PAR-0601", "expected 'func' after 'unsafe' in function type", ps_peek(self));
            return null;
        }
        is_unsafe = true;
    }

    if (ps_match(self, ord(TT_FUNC))) {
        ps_expect(self, ord(TT_LPAREN), "PAR-0402", "expected '(' after 'func' in function type")?;
        with (let params: VectorBase*? = ptr_vec_create(4) => type_ref_vec_free(params),
              let result: TypeRef*? = null => type_ref_free(result)) {
            if (!ps_check(self, ord(TT_RPAREN))) {
                while (true) {
                    let param_type = ps_parse_type(self)?;
                    if (ps_match(self, ord(TT_ELLIPSIS))) {
                        ps_mark_type_ref_variadic(param_type);
                        if (!ps_check(self, ord(TT_RPAREN))) {
                            ps_emit_error(self, "PAR-0520",
                                "variadic parameter must be the final function type parameter", ps_peek(self));
                            type_ref_free(param_type);
                            return null;
                        }
                    }
                    ptr_vec_push(params as VectorBase*, param_type as void*);
                    if (!ps_match(self, ord(TT_COMMA))) {
                        break;
                    }
                }
            }
            ps_expect(self, ord(TT_RPAREN), "PAR-0403", "expected ')' after function type parameters")?;
            ps_expect(self, ord(TT_ARROW_FUNC), "PAR-0404", "expected '->' in function type")?;
            result = ps_parse_type(self)?;

            let tref = new TypeRef("func", 0, false, is_unsafe, null, null, params as VectorBase*, result as TypeRef*,
                null, ps_extend_span(self, start));
            params = null;
            result = null;
            return tref;
        }
    }

    if (ps_match(self, ord(TT_LPAREN))) {
        let inner = ps_parse_type(self)?;
        ps_expect(self, ord(TT_RPAREN), "PAR-0405", "expected ')' after parenthesized type")?;
        return inner;
    }

    let atom_start = ps_span_start(self);

    let module_path: StringVector*? = null;
    let name_qualifier: StringVector*? = null;
    let name_tok = Token(TT_EOF, 0, 0, 0);

    let qualified = ps_try_parse_qualified_name(self);
    if (qualified != null) {
        let q = qualified as QualifiedNameResult*;
        module_path = q.module_path;
        name_qualifier = q.name_qualifier;
        name_tok = q.name_tok;
        drop q;
    } else {
        name_tok = ps_expect_ident(self, "PAR-0400", "expected type name")?;
    }

    let type_name = token_ident_text(name_tok) as string;
    if (is_unsafe) {
        ps_emit_error(self, "PAR-0601", "expected 'func' after 'unsafe' in function type", ps_last(self));
        return null;
    }
    return new TypeRef(type_name, 0, false, false, module_path, name_qualifier, null, null, null, ps_extend_span(self, atom_start));
}

/**
 * Append the parameter-only variadic suffix to a parsed type reference.
 *
 * @param tref Type reference to mark.
 */
func ps_mark_type_ref_variadic(tref: TypeRef*) {
    if (tref.suffixes == null) {
        tref.suffixes = ptr_vec_create(1);
    }
    ptr_vec_push(tref.suffixes as VectorBase*,
        new TypeSuffix(TS_VARIADIC, 0, invalid_expr_id(), tref.span) as void*);
}

/**
 * Parse a type reference.
 *
 * @param self Parser state to advance.
 * @return Parsed type reference, or `null` on parse error.
 */
func ps_parse_type(self: ParserState*) -> TypeRef*? {
    let start = ps_span_start(self);
    let result = ps_parse_type_atom(self, start)?;

    with (let suffixes: VectorBase*? = ptr_vec_create(4) => type_suffix_vec_free(suffixes)) {
        while (true) {
            if (ps_match(self, ord(TT_STAR))) {
                let suffix = new TypeSuffix(TS_POINTER, 0, invalid_expr_id(), ps_extend_span(self, start));
                ptr_vec_push(suffixes as VectorBase*, suffix as void*);
                result.pointer_depth = result.pointer_depth + 1;
                continue;
            }
            if (ps_match(self, ord(TT_QUESTION))) {
                let suffix2 = new TypeSuffix(TS_NULLABLE, 0, invalid_expr_id(), ps_extend_span(self, start));
                ptr_vec_push(suffixes as VectorBase*, suffix2 as void*);
                result.is_nullable = true;
                continue;
            }
            if (ps_match(self, ord(TT_LBRACKET))) {
                if (ps_match(self, ord(TT_RBRACKET))) {
                    let slice_suffix = new TypeSuffix(TS_SLICE, 0, invalid_expr_id(), ps_extend_span(self, start));
                    ptr_vec_push(suffixes as VectorBase*, slice_suffix as void*);
                    continue;
                }
                let len_tok = ps_peek(self);
                if (ps_match(self, ord(TT_UNDERSCORE))) {
                    ps_emit_error(self, "PAR-0624",
                        "inferred-length array type '[_]' is reserved for future use", len_tok);
                    ps_match(self, ord(TT_RBRACKET));
                    type_ref_free(result);
                    return null;
                }
                let len_expr = ps_parse_const_int_expr(self);
                if (len_expr == null) {
                    type_ref_free(result);
                    return null;
                }
                ps_expect(self, ord(TT_RBRACKET), "PAR-0621", "expected ']' after array length")?;
                let length = 0;
                let len_node = expr_arena_get(self.expr_arena, len_expr as ExprId);
                if (ord(len_node.kind) == ord(EX_INT)) {
                    length = len_node.int_value;
                }
                let suffix3 = new TypeSuffix(TS_ARRAY, length, len_expr as ExprId, ps_extend_span(self, start));
                ptr_vec_push(suffixes as VectorBase*, suffix3 as void*);
                continue;
            }
            break;
        }
        if (vec_size(suffixes as VectorBase*) > 0) {
            result.suffixes = suffixes as VectorBase*;
            suffixes = null;
        } else {
            vec_free(suffixes as VectorBase*);
            suffixes = null;
        }
    }

    result.span = ps_extend_span(self, start);
    return result;
}
