module parser.interface.header;

import util.diag;
import ast;
import module_interface;
import parser.cursor;
import parser.state;
import parser.token_value;
import tokens;

/**
 * Parsed header data for one `.l1m` file.
 */
struct InterfaceHeader {
    module_name: string;
    fingerprint: string;
}

/**
 * Free shared parser resources owned by an interface parser state.
 *
 * @param self Parser state to destroy.
 * @param free_diags Whether to free the diagnostic collector.
 */
func pi_destroy_state(self: ParserState*, free_diags: bool) {
    tv_free(self.tokens);
    expr_arena_free(self.expr_arena);
    stmt_arena_free(self.stmt_arena);
    pattern_arena_free(self.pattern_arena);
    if (free_diags) {
        diag_free(self.diags);
    }
    ps_destroy(self);
}

/**
 * Convert an internal parser result into an interface parse result.
 *
 * Used for lexer failures so the interface parser can reuse the shared
 * parser's diagnostic plumbing without keeping AST arenas around.
 *
 * @param self Internal parse result to consume.
 * @return Interface parse result owning the diagnostics.
 */
func pi_result_from_impl(self: ImplParseResult*) -> InterfaceParseResult* {
    if (self.root_module != null) {
        module_free(self.root_module as Module*);
    }
    let result = new InterfaceParseResult(null, self.diags);
    expr_arena_free(self.expr_arena);
    stmt_arena_free(self.stmt_arena);
    pattern_arena_free(self.pattern_arena);
    drop self;
    return result;
}

/**
 * Check whether the current token is an identifier with the given text.
 *
 * @param self Parser state to inspect.
 * @param text Expected identifier text.
 * @return `true` when the lookahead matches `text`.
 */
func pi_check_ident_text(self: ParserState*, text: string) -> bool {
    if (!ps_check_ident(self)) {
        return false;
    }
    return (token_ident_text(ps_peek(self)) as string) == text;
}

/**
 * Expect and consume a string-literal token.
 *
 * @param self Parser state to inspect.
 * @param code Diagnostic code on mismatch.
 * @param msg Diagnostic message prefix.
 * @return Consumed string token, or `null` after emitting an error.
 */
func pi_expect_string(self: ParserState*, code: string, msg: string) -> Token? {
    if (!ps_check_string(self)) {
        let got = token_to_string(ps_peek(self));
        ps_emit_error(self, code, msg + ", got " + got + " instead", ps_peek(self));
        return null;
    }
    return ps_advance(self);
}

/**
 * Parse one `require` or `link` dependency line:
 * `<keyword> <module>::<symbol> == "<provider-fingerprint>";`.
 *
 * @param self Parser state.
 * @return Constructed dependency entry, or `null` on parse failure.
 */
func pi_parse_dep_line(self: ParserState*) -> InterfaceDepEntry*? {
    ps_advance(self); // consume `require` or `link`

    let first_tok = ps_expect_ident(self, "PAR-0572", "Expected provider module name in dependency line")?;
    let first = token_ident_text(first_tok) as string;
    let module_name = parse_dotted_name_rest(self, first)?;

    ps_expect(self, ord(TT_DOUBLE_COLON), "PAR-0572", "Expected '::' between provider module and symbol in dependency line")?;

    let sym_tok = ps_expect_ident(self, "PAR-0572", "Expected provider symbol name in dependency line")?;
    let symbol_name = token_ident_text(sym_tok) as string;

    ps_expect(self, ord(TT_EQEQ), "PAR-0574", "Expected '==' after dependency symbol in interface file")?;
    let fingerprint_tok = pi_expect_string(self, "PAR-0575",
        "Expected provider fingerprint string literal after '==' in interface dependency")?;
    ps_expect(self, ord(TT_SEMI), "PAR-0576", "Expected ';' after dependency fingerprint in interface file")?;

    return new InterfaceDepEntry(module_name, symbol_name,
        token_string_text(fingerprint_tok) as string);
}

/**
 * Parse the exact `entry;` operational marker.
 *
 * @param self Parser state.
 * @return `true` when the complete marker was consumed.
 */
func pi_parse_entry_line(self: ParserState*) -> bool {
    ps_advance(self); // consume identifier `entry`
    return ps_expect(self, ord(TT_SEMI), "PAR-0572",
        "Expected ';' after entry marker in interface file") != null;
}

/**
 * Parse one ordered lifecycle import line:
 * `import module <provider> == "<provider-fingerprint>";`.
 *
 * @param self Parser state.
 * @return Constructed import entry, or `null` on parse failure.
 */
func pi_parse_module_import_line(self: ParserState*) -> InterfaceModuleImport*? {
    ps_advance(self); // consume `import`
    ps_expect(self, ord(TT_MODULE), "PAR-0572",
        "Expected 'module' after 'import' in interface file")?;

    let first_tok = ps_expect_ident(self, "PAR-0572",
        "Expected provider module name after 'import module'")?;
    let first = token_ident_text(first_tok) as string;
    let provider_module = parse_dotted_name_rest(self, first)?;

    ps_expect(self, ord(TT_EQEQ), "PAR-0574",
        "Expected '==' after interface dependency provider")?;
    let fingerprint_tok = pi_expect_string(self, "PAR-0575",
        "Expected provider fingerprint string literal after '==' in interface dependency")?;
    ps_expect(self, ord(TT_SEMI), "PAR-0576",
        "Expected ';' after dependency fingerprint in interface file")?;

    return new InterfaceModuleImport(
        provider_module,
        token_string_text(fingerprint_tok) as string
    );
}

/**
 * Emit a strict operational-region diagnostic.
 *
 * @param self Parser state.
 * @param code `PAR-0578` for duplicates or `PAR-0579` for region regression.
 * @param message Diagnostic message.
 * @param tok Token whose span should be highlighted.
 */
func pi_operational_error(self: ParserState*, code: string, message: string, tok: Token) {
    ps_emit_error(self, code, message, tok);
}

/**
 * Parse the module interface header.
 *
 * Expects: `module interface <name>;` followed by `fingerprint "...";`
 *
 * @param self Parser state.
 * @return Parsed header, or `null` on failure.
 */
func pi_parse_header(self: ParserState*) -> InterfaceHeader*? {
    ps_expect(self, ord(TT_MODULE), "PAR-0560", "Expected 'module' keyword at start of interface file")?;

    if (!pi_check_ident_text(self, "interface")) {
        ps_emit_error(self, "PAR-0561", "Expected 'interface' keyword in module interface declaration", ps_peek(self));
        return null;
    }
    ps_advance(self);

    let name_tok = ps_expect_ident(self, "PAR-0562", "Expected module name in interface file header")?;
    let first = token_ident_text(name_tok) as string;
    let module_name = parse_dotted_name_rest(self, first)?;

    ps_expect(self, ord(TT_SEMI), "PAR-0563", "Expected ';' after module interface declaration")?;

    if (!pi_check_ident_text(self, "fingerprint")) {
        ps_emit_error(self, "PAR-0564", "Expected 'fingerprint' declaration after module interface header", ps_peek(self));
        return null;
    }
    ps_advance(self);

    let fp_tok = pi_expect_string(self, "PAR-0565", "Expected string literal after 'fingerprint'")?;
    ps_expect(self, ord(TT_SEMI), "PAR-0566", "Expected ';' after fingerprint declaration")?;

    return new InterfaceHeader(module_name, token_string_text(fp_tok) as string);
}

/**
 * Advance past tokens until a probable recovery point.
 *
 * @param self Parser state.
 * @return `true` for chaining in error paths.
 */
func pi_sync_to_semi_or_rbrace(self: ParserState*) -> bool {
    while (!ps_check(self, ord(TT_SEMI)) && !ps_check(self, ord(TT_RBRACE)) &&
           !ps_check(self, ord(TT_EOF))) {
        ps_advance(self);
    }
    if (ps_check(self, ord(TT_SEMI))) {
        ps_advance(self);
    }
    return true;
}
