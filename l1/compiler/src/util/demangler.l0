module util.demangler;

import std.string;
import std.text;

struct Cursor {
    pos: int;
}

/**
 * Demangle a Unified LBI name into a human-readable representation.
 *
 * @param mangled Mangled LBI name (e.g., "__deaM4mainN3sumF2iii").
 * @return Human-readable string or null if not a valid LBI name.
 */
func demangle_lbi(mangled: string) -> string? {
    if (!starts_with_s(mangled, "__deaM")) {
        return null;
    }

    with (let c = new Cursor(6) => drop c,
          let out = cb_create() => cb_free(out)) {
        // Parse module section
        if (!demangle_module_section(mangled, c, out)) {
            return null;
        }

        cb_append_s(out, "::");

        if (c.pos >= len_s(mangled)) {
            return null;
        }

        let sigil = char_at_s(mangled, c.pos);
        c.pos = c.pos + 1;

        case (sigil) {
            'N' => {
                // Value/Function
                if (!demangle_name_with_length(mangled, c, out)) { return null; }
                if (c.pos < len_s(mangled) && char_at_s(mangled, c.pos) == 'F') {
                    // Function signature
                    if (!demangle_function_signature(mangled, c, out)) { return null; }
                }
            }
            'S' => {
                // Struct
                if (!demangle_name_with_length(mangled, c, out)) { return null; }
            }
            'E' => {
                // Enum
                if (!demangle_name_with_length(mangled, c, out)) { return null; }
            }
            'I' => {
                // Lifecycle
                cb_append_s(out, "@");
                if (!demangle_name_with_length(mangled, c, out)) { return null; }
            }
        }
        if (sigil != 'N' && sigil != 'S' && sigil != 'E' && sigil != 'I') {
            return null;
        }

        if (c.pos != len_s(mangled)) {
            // Check for enum variant tag suffix
            if (char_at_s(mangled, c.pos) == '_') {
                cb_append_s(out, ".");
                cb_append_s(out, slice_s(mangled, c.pos + 1, len_s(mangled)));
                c.pos = len_s(mangled);
            } else {
                // Garbage at the end
                return null;
            }
        }

        return cb_to_string(out);
    }
}

/**
 * Append one or more length-prefixed module components separated by dots.
 *
 * Begin at the cursor's current position and stop before the first non-digit
 * after the parsed components. This does not consume a module marker or check
 * the following symbol section. On failure, consumed input and any appended
 * components or separator remain; neither cursor nor output is rolled back.
 *
 * @param mangled LBI text containing the module section.
 * @param c Borrowed mutable cursor positioned within the string or at its end.
 * @param out Borrowed character buffer receiving the formatted module path.
 * @return `true` if at least one component is parsed and every started component completes, or
 *     `false` if no component starts here or a length-prefixed name is incomplete.
 */
func demangle_module_section(mangled: string, c: Cursor*, out: CharBuffer*) -> bool {
    let first = true;
    while (c.pos < len_s(mangled) && is_digit(char_at_s(mangled, c.pos))) {
        if (!first) {
            cb_append_s(out, ".");
        }
        if (!demangle_name_with_length(mangled, c, out)) {
            return false;
        }
        first = false;
    }
    return !first;
}

/**
 * Append a nonempty name encoded by a decimal length and that many bytes.
 *
 * Consume the decimal prefix before checking that its positive length fits the
 * remaining string. Failure leaves the cursor after any prefix digits and
 * leaves the output unchanged. The payload's characters are not validated as an
 * identifier. Prefix accumulation and cursor arithmetic must fit `int`.
 *
 * @param mangled LBI text containing the length-prefixed name.
 * @param c Borrowed mutable cursor positioned within the string or at its end.
 * @param out Borrowed character buffer receiving the name bytes on success.
 * @return `true` after consuming and appending the complete name, or `false`
 *     for a missing, zero, or out-of-bounds length.
 */
func demangle_name_with_length(mangled: string, c: Cursor*, out: CharBuffer*) -> bool {
    let len = parse_int_prefix(mangled, c);
    if (len <= 0 || c.pos + len > len_s(mangled)) {
        return false;
    }
    cb_append_s(out, slice_s(mangled, c.pos, c.pos + len));
    c.pos = c.pos + len;
    return true;
}

/**
 * Append the parameter and return types encoded by an LBI function component.
 *
 * Consume `F`, a decimal arity, that many type components, and one return type,
 * formatting them as `(parameters) -> result`. An absent arity prefix is treated
 * as zero, so success is not proof of a canonical encoding or complete input
 * consumption. Counts must fit `int`. After parsing begins, failure retains any
 * cursor advances and partial output; the caller owns both mutable objects.
 *
 * @param mangled LBI text containing the function type.
 * @param c Borrowed mutable cursor positioned at `F`, or another position to reject.
 * @param out Borrowed character buffer receiving the formatted signature.
 * @return `true` if the declared parameters and return component are parsed,
 *     or `false` for a missing `F` or an incomplete or unrecognized type component.
 */
func demangle_function_signature(mangled: string, c: Cursor*, out: CharBuffer*) -> bool {
    if (c.pos >= len_s(mangled) || char_at_s(mangled, c.pos) != 'F') {
        return false;
    }
    c.pos = c.pos + 1;

    let arity = parse_int_prefix(mangled, c);
    cb_append_s(out, "(");
    for (let i = 0; i < arity; i = i + 1) {
        if (i > 0) {
            cb_append_s(out, ", ");
        }
        if (!demangle_type_component(mangled, c, out)) {
            return false;
        }
    }
    cb_append_s(out, ") -> ");
    if (!demangle_type_component(mangled, c, out)) {
        return false;
    }
    return true;
}

/**
 * Append the human-readable form of one encoded LBI type component.
 *
 * Handle builtin, pointer, nullable, variadic, array, nominal, function, unsafe,
 * and length-named builtin forms recursively. Consume only this component and
 * retain cursor advances and partial output on failure. This is a formatting
 * parser, not complete LBI validation: array lengths may be zero or lack digits,
 * and a nominal type's kind byte is consumed without checking its value. Numeric
 * prefixes must fit `int`; the caller retains ownership of cursor and output.
 *
 * @param mangled LBI text containing the type component.
 * @param c Borrowed mutable cursor positioned within the string or at its end.
 * @param out Borrowed character buffer receiving the formatted type.
 * @return `true` if one supported component is parsed, or `false` for exhausted
 *     input, an unknown type marker, or an incomplete required subcomponent.
 */
func demangle_type_component(mangled: string, c: Cursor*, out: CharBuffer*) -> bool {
    if (c.pos >= len_s(mangled)) {
        return false;
    }
    let sigil = char_at_s(mangled, c.pos);
    c.pos = c.pos + 1;

    case (sigil) {
        'a' => { cb_append_s(out, "tiny"); return true; }
        'h' => { cb_append_s(out, "byte"); return true; }
        's' => { cb_append_s(out, "short"); return true; }
        't' => { cb_append_s(out, "ushort"); return true; }
        'i' => { cb_append_s(out, "int"); return true; }
        'j' => { cb_append_s(out, "uint"); return true; }
        'l' => { cb_append_s(out, "long"); return true; }
        'm' => { cb_append_s(out, "ulong"); return true; }
        'f' => { cb_append_s(out, "float"); return true; }
        'd' => { cb_append_s(out, "double"); return true; }
        'z' => { cb_append_s(out, "bool"); return true; }
        'c' => { cb_append_s(out, "string"); return true; }
        'v' => { cb_append_s(out, "void"); return true; }
        'P' => {
            if (!demangle_type_component(mangled, c, out)) { return false; }
            cb_append_s(out, "*");
            return true;
        }
        'Q' => {
            if (!demangle_type_component(mangled, c, out)) { return false; }
            cb_append_s(out, "?");
            return true;
        }
        'V' => {
            if (!demangle_type_component(mangled, c, out)) { return false; }
            cb_append_s(out, "...");
            return true;
        }
        'A' => {
            let dim = parse_int_prefix(mangled, c);
            if (c.pos >= len_s(mangled) || char_at_s(mangled, c.pos) != '_') { return false; }
            c.pos = c.pos + 1;
            if (!demangle_type_component(mangled, c, out)) { return false; }
            cb_append_s(out, "[");
            cb_append_s(out, int_to_string(dim));
            cb_append_s(out, "]");
            return true;
        }
        'M' => {
            if (!demangle_module_section(mangled, c, out)) { return false; }
            if (c.pos >= len_s(mangled)) { return false; }
            let inner_sigil = char_at_s(mangled, c.pos);
            c.pos = c.pos + 1;
            cb_append_s(out, ".");
            if (!demangle_name_with_length(mangled, c, out)) { return false; }
            return true;
        }
        'F' => {
            c.pos = c.pos - 1; // Backtrack
            return demangle_function_signature(mangled, c, out);
        }
        'X' => {
            cb_append_s(out, "unsafe ");
            return demangle_type_component(mangled, c, out);
        }
        'B' => {
            return demangle_name_with_length(mangled, c, out);
        }
    }

    return false;
}

/**
 * Consume consecutive ASCII decimal digits and return their integer value.
 *
 * Stop at the first non-digit or the string's end, leaving that character
 * unconsumed. No sign or delimiter is parsed. An absent digit prefix returns
 * zero without advancing. Accumulation has no explicit overflow check, so the
 * caller must supply a prefix whose value fits `int`.
 *
 * @param s String containing the decimal prefix.
 * @param c Borrowed mutable cursor positioned within the string or at its end.
 * @return Parsed nonnegative value, or zero when no digits are present.
 */
func parse_int_prefix(s: string, c: Cursor*) -> int {
    let result = 0;
    while (c.pos < len_s(s) && is_digit(char_at_s(s, c.pos))) {
        result = result * 10 + ((char_at_s(s, c.pos) as int) - ('0' as int));
        c.pos = c.pos + 1;
    }
    return result;
}
