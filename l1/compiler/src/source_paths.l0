module source_paths;

import sys.rt;

import std.fs;
import std.path;
import std.string;
import std.system;
import std.text;
import std.vector;
import util.diag;

import util.strings;
import compiler_filesystem;

/**
 * Represents the SourceSearchPaths structure.
 */
struct SourceSearchPaths {
    system_roots: StringVector*;
    project_roots: StringVector*;
    explicit_entry_name: string;
    explicit_entry_path: string;
    managed_source_root: string?;
    managed_interfaces: string?;
    profile_modules: string?; /* Exact validated inventory; independent of installed sources. */
}

/**
 * Create an empty source search-path collection.
 *
 * @return New search-path set with separate system and project root vectors.
 */
func sp_create() -> SourceSearchPaths* {
    return new SourceSearchPaths(sv_create(2), sv_create(2), "", "", null, null, null);
}

/**
 * Free a source search-path collection.
 *
 * @param self Search paths to free.
 */
func sp_free(self: SourceSearchPaths*) {
    sv_free(self.system_roots);
    sv_free(self.project_roots);
    drop self;
}

/**
 * Append a system root directory.
 *
 * @param self Search paths to update.
 * @param root Root directory to search before project roots.
 */
func sp_add_system_root(self: SourceSearchPaths*, root: string) {
    sv_push(self.system_roots, root);
}

/**
 * Append a project root directory.
 *
 * @param self Search paths to update.
 * @param root Project root directory to search.
 */
func sp_add_project_root(self: SourceSearchPaths*, root: string) {
    sv_push(self.project_roots, root);
}

/**
 * Return the number of configured system roots.
 *
 * @param self Search paths to inspect.
 * @return Number of system root directories.
 */
func sp_system_root_count(self: SourceSearchPaths*) -> int {
    return sv_size(self.system_roots);
}

/**
 * Return the number of configured project roots.
 *
 * @param self Search paths to inspect.
 * @return Number of project root directories.
 */
func sp_project_root_count(self: SourceSearchPaths*) -> int {
    return sv_size(self.project_roots);
}

/**
 * Return a system root by index.
 *
 * @param self Search paths to inspect.
 * @param index Zero-based system-root index.
 * @return System root at `index`.
 */
func sp_system_root_get(self: SourceSearchPaths*, index: int) -> string {
    return sv_get(self.system_roots, index);
}

/**
 * Return a project root by index.
 *
 * @param self Search paths to inspect.
 * @param index Zero-based project-root index.
 * @return Project root at `index`.
 */
func sp_project_root_get(self: SourceSearchPaths*, index: int) -> string {
    return sv_get(self.project_roots, index);
}

/**
 * Format one root list using the L1 verbose display contract.
 *
 * @param roots Root vector to format.
 * @return Comma-joined quoted roots, or `<none>` when empty.
 */
func sp_format_root_list(roots: StringVector*) -> string {
    if (sv_size(roots) == 0) {
        return "<none>";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(roots); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ",");
            }
            sb_append(sb, "'");
            sb_append(sb, sv_get(roots, i));
            sb_append(sb, "'");
        }
        return sb_to_string(sb);
    }
}

/**
 * Convert a dotted module name to an unchecked relative path stem.
 *
 * @param module_name Dotted module name such as `foo.bar`.
 * @return Relative path stem such as `foo/bar`.
 */
func _sp_module_relstem_unchecked(module_name: string) -> string {
    with (let cb = cb_create() => cb_free(cb)) {
        for (let i = 0; i < len_s(module_name); i = i + 1) {
            let c = char_at_s(module_name, i);
            if (c == '.') {
                cb_append(cb, '/');
            } else {
                cb_append(cb, c);
            }
        }
        return cb_to_string(cb);
    }
}

/**
 * Return the first existing path below an ordered root list.
 *
 * Existence, rather than file kind or readability, selects the authoritative
 * candidate. Callers validate the selected path according to its artifact
 * contract.
 *
 * @param roots Ordered roots to inspect.
 * @param rel Validated relative artifact path.
 * @return First existing candidate, or `null` when none exists.
 */
func _sp_resolve_roots(roots: StringVector*, rel: string) -> string? {
    for (let i = 0; i < sv_size(roots); i = i + 1) {
        let candidate = join(sv_get(roots, i), rel);
        if (exists(candidate)) {
            return candidate;
        }
    }
    return null;
}

/**
 * Select the bound entry file or resolve another module through ordered source roots.
 *
 * @param self Search paths to inspect.
 * @param module_name Dotted module name to resolve.
 * @return First matching source path, or `null` if the module is not found.
 */
func sp_resolve(self: SourceSearchPaths*, module_name: string) -> string? {
    if (self.explicit_entry_name == module_name && self.explicit_entry_path != "") {
        if (cfs_path_kind_follow(self.explicit_entry_path) == CFS_PATH_ABSENT) {
            return null;
        }
        return self.explicit_entry_path;
    }
    let rel_opt = sp_module_source_relpath(module_name);
    if (rel_opt == null) {
        return null;
    }
    let rel = rel_opt as string;

    let system_match = _sp_resolve_roots(self.system_roots, rel);
    if (system_match != null) {
        return system_match;
    }

    return _sp_resolve_roots(self.project_roots, rel);
}

/**
 * Describe the explicit file or module search that failed.
 *
 * @param self Source paths for this invocation.
 * @param module_name Requested canonical name.
 * @return Diagnostic detail for a missing source.
 */
func sp_missing_source_message(self: SourceSearchPaths*, module_name: string) -> string {
    if (self.explicit_entry_name == module_name && self.explicit_entry_path != "") {
        return "source file not found: " + self.explicit_entry_path;
    }
    return "Module '" + module_name + "' not found in system_roots or project_roots";
}

/**
 * Check whether a module-name component is a valid identifier.
 *
 * @param component Module-name component to validate.
 * @return `true` if the component matches identifier rules.
 */
func sp_is_valid_ident_component(component: string) -> bool {
    let n = len_s(component);
    if (n == 0) {
        return false;
    }

    let first = char_at_s(component, 0);
    if (!(is_alpha(first) || first == '_')) {
        return false;
    }

    for (let i = 1; i < n; i = i + 1) {
        let c = char_at_s(component, i);
        if (!(is_alnum(c) || c == '_')) {
            return false;
        }
    }

    return true;
}

/**
 * Check whether a dotted module name is valid.
 *
 * @param module_name Module name to validate.
 * @return `true` if every component is a valid identifier.
 */
func sp_is_valid_module_name(module_name: string) -> bool {
    if (is_empty_s(module_name)) {
        return false;
    }

    with (let parts = us_split_char(module_name, '.', true) => sv_free(parts)) {
        for (let i = 0; i < sv_size(parts); i = i + 1) {
            if (!sp_is_valid_ident_component(sv_get(parts, i))) {
                return false;
            }
        }
    }

    return true;
}

/**
 * Convert a validated dotted module name to its relative artifact stem.
 *
 * @param module_name Canonical dotted module name such as `foo.bar`.
 * @return Relative stem such as `foo/bar`, or `null` when invalid.
 */
func sp_module_relstem(module_name: string) -> string? {
    if (!sp_is_valid_module_name(module_name)) {
        return null;
    }
    return _sp_module_relstem_unchecked(module_name);
}

/**
 * Convert a validated dotted module name to its relative source path.
 *
 * @param module_name Canonical dotted module name such as `foo.bar`.
 * @return Relative `.l1` path such as `foo/bar.l1`, or `null` when invalid.
 */
func sp_module_source_relpath(module_name: string) -> string? {
    let relstem = sp_module_relstem(module_name);
    if (relstem == null) {
        return null;
    }
    return relstem as string + ".l1";
}

/**
 * Convert a validated dotted module name to its relative interface path.
 *
 * @param module_name Canonical dotted module name such as `foo.bar`.
 * @return Relative `.l1m` path such as `foo/bar.l1m`, or `null` when invalid.
 */
func sp_module_interface_relpath(module_name: string) -> string? {
    let relstem = sp_module_relstem(module_name);
    if (relstem == null) {
        return null;
    }
    return relstem as string + ".l1m";
}

/**
 * Resolve an interface module name against ordered interface roots.
 *
 * The first present candidate, including a dangling link or inaccessible path,
 * is authoritative; interface loading reports usability diagnostics for that selected
 * path instead of falling through to later roots.
 *
 * @param interface_roots Ordered interface roots to inspect.
 * @param module_name Canonical dotted module name to resolve.
 * @return First existing interface path, or `null` when none exists.
 */
func sp_resolve_interface(interface_roots: StringVector*, module_name: string) -> string? {
    let rel_opt = sp_module_interface_relpath(module_name);
    if (rel_opt == null) {
        return null;
    }
    for (let i = 0; i < sv_size(interface_roots); i = i + 1) {
        let candidate = join(sv_get(interface_roots, i), rel_opt as string);
        if (cfs_path_kind(candidate) != CFS_PATH_ABSENT) { return candidate; }
    }
    return null;
}

/** Select managed semantics only at the bundled system-root position, never a project position. */
func sp_managed_eligible(self: SourceSearchPaths*, module_name: string) -> bool {
    if (self.profile_modules != null) {
        return contains_s("\n" + (self.profile_modules as string) + "\n", "\n" + module_name + "\n");
    }
    if (self.managed_source_root == null ||
        (!starts_with_s(module_name, "std.") && !starts_with_s(module_name, "sys."))) { return false; }
    let relative = sp_module_source_relpath(module_name);
    if (relative == null) { return false; }
    for (let i = 0; i < sv_size(self.system_roots); i = i + 1) {
        let root = sv_get(self.system_roots, i);
        if (cfs_same_file(root, self.managed_source_root as string) == 1) {
            let known = cfs_path_kind(join(root, relative as string)) != CFS_PATH_ABSENT;
            if (self.managed_interfaces != null) {
                known = known || cfs_path_kind(join(self.managed_interfaces as string,
                    sp_module_interface_relpath(module_name) as string)) != CFS_PATH_ABSENT;
            }
            return known;
        }
        if (exists(join(root, relative as string))) { return false; }
    }
    return false;
}

/**
 * Ensure a default project root exists.
 *
 * @param project_roots Project-root vector to update.
 */
func sp_apply_default_project_roots(project_roots: StringVector*) {
    if (sv_size(project_roots) == 0) {
        sv_push(project_roots, ".");
    }
}

/**
 * Append system roots from a split environment-style path string.
 *
 * @param sys_roots System-root vector to update.
 * @param env_value Colon- or semicolon-separated root list.
 */
func sp_append_env_sys_roots(sys_roots: StringVector*, env_value: string) {
    with (let roots = us_split_chars2_non_empty(env_value, ':', ';') => sv_free(roots)) {
        for (let i = 0; i < sv_size(roots); i = i + 1) {
            sv_push(sys_roots, sv_get(roots, i));
        }
    }
}

/**
 * Populate default system roots from effective environment values when needed.
 *
 * @param sys_roots System-root vector to update.
 * @param l0_system Effective `L1_SYSTEM` value, if any.
 * @param l0_home Effective `L1_HOME` value, if any.
 */
func sp_apply_default_sys_roots_env(sys_roots: StringVector*, l0_system: string?, l0_home: string?) {
    if (sv_size(sys_roots) > 0) {
        return;
    }

    if (l0_system != null && !is_empty_s(l0_system as string)) {
        sp_append_env_sys_roots(sys_roots, l0_system as string);
        return;
    }

    if (l0_home != null && !is_empty_s(l0_home as string)) {
        sv_push(sys_roots, join(l0_home as string, "shared/l1/stdlib"));
    }
}

/**
 * Populate default system roots from `L1_SYSTEM` when needed.
 *
 * @param sys_roots System-root vector to update.
 */
func sp_apply_default_sys_roots(sys_roots: StringVector*) {
    sp_apply_default_sys_roots_env(sys_roots, env_get("L1_SYSTEM"), env_get("L1_HOME"));
}

/**
 * Build a search-path collection from explicit root vectors.
 *
 * @param project_roots Project roots to copy.
 * @param sys_roots System roots to copy.
 * @return New search-path collection containing both root sets.
 */
func sp_build_from_roots(project_roots: StringVector*, sys_roots: StringVector*) -> SourceSearchPaths* {
    let sp = sp_create();

    for (let i = 0; i < sv_size(sys_roots); i = i + 1) {
        sp_add_system_root(sp, sv_get(sys_roots, i));
    }

    for (let project_i = 0; project_i < sv_size(project_roots); project_i = project_i + 1) {
        sp_add_project_root(sp, sv_get(project_roots, project_i));
    }

    return sp;
}

/**
 * Bind a CLI path operand to its module and add its parent to the project roots.
 *
 * @param self Search paths for the new invocation.
 * @param target Original CLI operand.
 * @param diags Collector for invalid names or unresolvable paths.
 * @return Canonical entry name, or `null` on failure.
 */
func sp_normalize_entry_target(self: SourceSearchPaths*, target: string, diags: DiagCollector*) -> string? {
    let explicit_file = has_parent(target);
    let name = target;
    if (has_extension(target, ".l1")) {
        name = stem(target);
    } else if (explicit_file) {
        name = basename(target);
    }
    if (!sp_is_valid_module_name(name)) {
        diag_error(diags, "l1c", "L1C-0011",
            "invalid entry module name '" + name + "': module components must be valid identifiers",
            "", 0, 0, 0, 0);
        return null;
    }
    if (explicit_file) {
        let path = cfs_absolute_path(target);
        if (path == null) {
            diag_error(diags, "Driver", "DRV-0010", "cannot resolve explicit source path: " + target,
                target, 0, 0, 0, 0);
            return null;
        }
        self.explicit_entry_name = name;
        self.explicit_entry_path = path as string;

        /* Keep the separator even when a POSIX directory name ends in a literal backslash. */
        let absolute = self.explicit_entry_path;
        sp_add_project_root(self, slice_s(absolute, 0, find_last_s(absolute, basename(absolute))));
    }
    return name;
}
