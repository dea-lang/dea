module mixed_fallback_enum_entry;

import mixed.facade as facade;
import Color from mixed.source_enum;

/**
 * Exercise an interface result type owned by a source-fallback module.
 *
 * @return The enum ordinal returned through the interface.
 */
func main() -> int {
    let value: Color = facade::make_color();
    return ord(value);
}
