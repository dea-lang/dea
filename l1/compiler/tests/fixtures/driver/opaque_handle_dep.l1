module opaque_handle_dep;

export opaque { Handle }, make_handle, same_handle;

struct Handle {
    value: int;
}

func make_handle(value: int) -> Handle* {
    return new Handle(value);
}

func same_handle(left: Handle*, right: Handle*) -> bool {
    return left == right;
}
