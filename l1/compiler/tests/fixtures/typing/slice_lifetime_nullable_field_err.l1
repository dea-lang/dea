module slice_lifetime_nullable_field_err;

struct Holder { data: int[1]; }
func main() -> int { let holder: Holder? = Holder([2]); let a: int[1] = [1]; let view: int[] = a; { view = slice((holder as Holder).data); } return view[0]; }
