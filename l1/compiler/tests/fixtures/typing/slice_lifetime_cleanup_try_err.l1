module slice_lifetime_cleanup_try_err;

func maybe() -> int? { return null; }
func example() -> int? {
    let a: int[1] = [1]; let view: int[] = a;
    with (let b: int[1] = [2]) { let n = maybe()?; return n; } cleanup { view = b; }
}
func main() -> int { return 0; }
