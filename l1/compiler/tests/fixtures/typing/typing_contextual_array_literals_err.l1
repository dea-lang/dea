module typing_contextual_array_literals_err;

func sum3(values: int[3]) -> int {
    return values[0] + values[1] + values[2];
}

func sum_slice(values: int[]) -> int {
    return values[0];
}

func overlong_call() -> int {
    return sum3([1, 2, 3, 4]);
}

func element_mismatch_call() -> int {
    return sum3(["x", 2, 3]);
}

func standalone_literal() {
    let values = [1, 2, 3];
}

func slice_literal_call() -> int {
    return sum_slice([1, 2, 3]);
}

func parenthesized_slice_literal_call() -> int {
    return sum_slice((([1, 2, 3])));
}
