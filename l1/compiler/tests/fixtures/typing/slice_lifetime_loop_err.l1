module slice_lifetime_loop_err;

func choose(flag: bool) -> int {
    let a: int[1] = [1]; let view: int[] = a;
    { let b: int[1] = [2]; let first: int[] = a; let second: int[] = a;
      while (flag) { view = first; first = second; second = b; continue; }
    }
    return view[0];
}
func main() -> int { return choose(false); }
