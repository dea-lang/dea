module typing_index_ok;

struct Cell {
    value: string;
}

unsafe func read_value(p: int*, i: int) -> int {
    return p[i];
}

unsafe func write_value(p: int*, i: int, value: int) {
    p[i] = value;
}

unsafe func write_cell(p: Cell*, value: Cell) {
    p[0] = value;
}
