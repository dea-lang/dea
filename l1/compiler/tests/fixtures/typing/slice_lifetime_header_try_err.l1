module slice_lifetime_header_try_err;

func maybe() -> int? { return null; }
func example() -> int? {
    let a: int[1] = [1]; let view: int[] = a;
    with (let b: int[1] = [2] => view = b, let n = maybe()? => null) { return n; }
}
func main() -> int { return 0; }
