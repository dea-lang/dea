module range_action_allocations;

import std.bytes as bytes;
import std.file as file;
import std.os;
import std.assert;
import std.io;
import range_action_provider as provider;
import path_arguments;

/**
 * Verify an entire successful read without constructing a message dynamically.
 *
 * @param result Read result to inspect.
 * @param expected Required count.
 */
func require_read(result: ReadResult, expected: int) {
    match (result) {
        Read(count) => { assert(count == expected, "allocation probe read count"); }
        _ => { assert(false, "allocation probe read failed"); }
    }
}

/**
 * Verify an entire successful write without constructing a message dynamically.
 *
 * @param result Write result to inspect.
 * @param expected Required count.
 */
func require_write(result: WriteResult, expected: int) {
    match (result) {
        Written(count) => { assert(count == expected, "allocation probe write count"); }
        _ => { assert(false, "allocation probe write failed"); }
    }
}

/**
 * Seek using an aggregate result without allocating transport state.
 *
 * @param handle Borrowed live file.
 */
func rewind(handle: file::File*) {
    match (file::seek(handle, 0 as long, file::FromStart)) {
        FileOffsetValue(value) => { assert(value == 0 as long, "allocation probe seek"); }
        _ => { assert(false, "allocation probe seek failed"); }
    }
}

/**
 * Require one successful file-result cleanup.
 *
 * @param result Saved close outcome.
 */
func require_close(result: file::CloseResult) {
    match (result) { Closed => {} _ => { assert(false, "allocation probe close"); } }
}

/**
 * Borrow a file while the containing result retains its cleanup obligation.
 *
 * @param result Owned open result.
 * @return Borrowed live file.
 */
func borrow(result: file::OpenFileResult) -> file::File* {
    match (result) {
        OpenedFile(handle) => { return handle; }
        _ => {
            assert(false, "allocation probe open");
            let absent: file::File*? = null;
            return absent as file::File*;
        }
    }
}

/**
 * Delimit first and repeated dispatch and file transfers after explicit setup.
 */
func main() {
    let path = fixture_path_arg(1);
    with (
        let buffer = bytes::from_string("abcd") => bytes::free(buffer),
        let opened = file::open(path, file::OpenOptions(file::ReadWrite, file::CreateOrTruncate, false))
            => require_close(file::free_open_file_result(opened))
    ) {
        let handle = borrow(opened);
        let context = bytes::ByteBufferRangeActionContext(null, -4294967303 as long);
        let positive_control = bytes::to_string(buffer);
        assert(positive_control == "abcd", "trace allocation positive control");
        err_printl_s("RANGE_ALLOC_BEGIN");
        for (let i = 0; i < 128; i = i + 1) {
            match (bytes::with_raw_range(buffer, 1, 2, bytes::ByteBufferRangeActionContext(null, context.argument), provider::sum)) {
                RangeActionApplied(count, value) => {
                    assert(count == 2 && value != null, "generic allocation success");
                }
                _ => { assert(false, "generic allocation outcome"); }
            }
            match (bytes::with_raw_range(buffer, 2, 1, bytes::ByteBufferRangeActionContext(null, context.argument), provider::diagnostic)) {
                RangeActionFailed(count, error) => {
                    assert(count == 1 && error.value == context.argument, "generic partial failure transport");
                }
                _ => { assert(false, "generic failure outcome"); }
            }
        }
        err_printl_s("RANGE_ALLOC_END");
        err_printl_s("FILE_ALLOC_BEGIN");
        for (let i = 0; i < 128; i = i + 1) {
            rewind(handle);
            require_write(file::write_some(handle, buffer, 0, 4), 4);
            rewind(handle);
            require_read(file::read_some(handle, buffer, 0, 4), 4);
            require_write(file::write_at(handle, buffer, 1, 3, 1 as long), 3);
            require_read(file::read_at(handle, buffer, 1, 3, 1 as long), 3);
            require_write(file::write_some(handle, buffer, 4, 0), 0);
            require_read(file::read_some(handle, buffer, 4, 0), 0);
            require_write(file::write_at(handle, buffer, 4, 0, 0 as long), 0);
            require_read(file::read_at(handle, buffer, 4, 0, 0 as long), 0);
        }
        err_printl_s("FILE_ALLOC_END");
        assert(bytes::to_string(buffer) == positive_control, "file probe preserves bytes");
    }
    printl_s("range_action_allocations: PASS");
}
