/**
 * Represents one Stage 1 backend generation session.
 */
struct Backend {
    result: AnalysisResult*;
    opts: CodegenOptions*;
    cfg: LogConfig*;
    emitter: CEmitter*;
    output_kind: CodegenOutputKind;
    target_module: string?;
    required_type_keys: StringSet*?;
    current_module: string?;
    current_unit: DriverUnit*?;
    current_env: ModuleEnv*?;
    current_func_result: Type*?;
    current_scope: ScopeContext*?;
    scope_stack: VectorBase*;          // ScopeContext* (for final cleanup)
    current_loop_labels: LoopLabels*?;
    current_loop_cleanup_scopes: LoopCleanupScopes*?;
    scope_counter: int;
    label_counter: int;
    next_stmt_unreachable: bool;
}

/**
 * Represents one active loop label pair.
 */
struct LoopLabels {
    parent: LoopLabels*?;
    break_label: string;
    continue_label: string;
}

/**
 * Represents the cleanup targets for one active loop.
 */
struct LoopCleanupScopes {
    parent: LoopCleanupScopes*?;
    continue_scope: ScopeContext*;
    break_scope: ScopeContext*;
    continue_scope_id: int;
    break_scope_id: int;
}

/**
 * Abort on an internal backend error.
 *
 * @param message ICE message to report.
 */
func be_ice(message: string) {
    assert(false, message);
}

/**
 * Abort on an internal backend error from a string-returning helper.
 *
 * @param message ICE message to report.
 * @return Dummy return used only to satisfy control-flow typing.
 */
func be_ice_string(message: string) -> string {
    assert(false, message);
    return "";
}

/**
 * Create a backend state for one supported output boundary.
 *
 * @param result Borrowed semantic analysis result.
 * @param opts Borrowed codegen options.
 * @param cfg Borrowed log configuration.
 * @param output_kind Output boundary to generate.
 * @param target_module Canonical module name for module output, otherwise `null`.
 * @return New backend state.
 */
func be_create_for_output(
    result: AnalysisResult*,
    opts: CodegenOptions*,
    cfg: LogConfig*,
    output_kind: CodegenOutputKind,
    target_module: string?
) -> Backend* {
    if ((ord(output_kind) == ord(CGK_MODULE)) != (target_module != null)) {
        be_ice("[ICE-9304] module output kind and target must be selected together");
    }
    let emitter = cem_create();
    cem_set_analysis(emitter, result);
    if (target_module != null) {
        cem_set_module_target(emitter, target_module as string);
    }
    return new Backend(result, opts, cfg, emitter, output_kind, target_module, null, null, null, null, null, null,
        ptr_vec_create(8), null, null, 0, 0, false);
}

/**
 * Create a backend state for legacy whole-program generation.
 *
 * @param result Borrowed semantic analysis result.
 * @param opts Borrowed codegen options.
 * @param cfg Borrowed log configuration.
 * @return New backend state.
 */
func be_create(result: AnalysisResult*, opts: CodegenOptions*, cfg: LogConfig*) -> Backend* {
    return be_create_for_output(result, opts, cfg, CGK_WHOLE_PROGRAM, null);
}

/**
 * Create a backend state for one source-backed module.
 *
 * @param result Borrowed semantic analysis result.
 * @param target_module Canonical target module name.
 * @param opts Borrowed codegen options.
 * @param cfg Borrowed log configuration.
 * @return New backend state.
 */
func be_create_module(
    result: AnalysisResult*,
    target_module: string,
    opts: CodegenOptions*,
    cfg: LogConfig*
) -> Backend* {
    return be_create_for_output(result, opts, cfg, CGK_MODULE, target_module);
}

/**
 * Free a backend state.
 *
 * @param self Backend state to free.
 */
func be_free(self: Backend*) {
    for (let i = 0; i < vec_size(self.scope_stack); i = i + 1) {
        sc_free(ptr_vec_get(self.scope_stack, i) as ScopeContext*);
    }
    let labels = self.current_loop_labels;
    while (labels != null) {
        let cur = labels as LoopLabels*;
        labels = cur.parent;
        drop cur;
    }
    let cleanup_scopes = self.current_loop_cleanup_scopes;
    while (cleanup_scopes != null) {
        let cur2 = cleanup_scopes as LoopCleanupScopes*;
        cleanup_scopes = cur2.parent;
        drop cur2;
    }
    vec_free(self.scope_stack);
    if (self.required_type_keys != null) {
        ss_free(self.required_type_keys as StringSet*);
    }
    cem_free(self.emitter);
    drop self;
}

/**
 * Build a stable key for one user-defined type.
 *
 * @param module_name Defining module name.
 * @param type_name Struct or enum name.
 * @return Key in `module::type` form.
 */
func be_type_key(module_name: string, type_name: string) -> string {
    return module_name + "::" + type_name;
}

/**
 * Return the module portion of a type key.
 *
 * @param key Type key in `module::type` form.
 * @return Module-name portion of the key.
 */
func be_type_key_module(key: string) -> string {
    let n = len_s(key);
    for (let i = 0; i < n - 1; i = i + 1) {
        if (char_at_s(key, i) == ':' && char_at_s(key, i + 1) == ':') {
            return slice_s(key, 0, i);
        }
    }
    return "";
}

/**
 * Return the type-name portion of a type key.
 *
 * @param key Type key in `module::type` form.
 * @return Type-name portion of the key.
 */
func be_type_key_name(key: string) -> string {
    let n = len_s(key);
    for (let i = 0; i < n - 1; i = i + 1) {
        if (char_at_s(key, i) == ':' && char_at_s(key, i + 1) == ':') {
            return slice_s(key, i + 2, n);
        }
    }
    return "";
}

/**
 * Push a type key unless it is already present.
 *
 * @param values Vector to update.
 * @param seen Set of already-pushed type keys.
 * @param key Type key.
 */
func be_push_type_key(values: StringVector*, seen: StringSet*, key: string) {
    if (!ss_has(seen, key)) {
        ss_add(seen, key);
        sv_push(values, key);
    }
}

/**
 * Return the current module environment.
 *
 * @param self Backend state to inspect.
 * @return Borrowed module environment.
 */
func be_current_env(self: Backend*) -> ModuleEnv* {
    if (self.current_env == null) {
        be_ice("[ICE-9301] backend requires current module environment");
    }
    return self.current_env as ModuleEnv*;
}

/**
 * Return the current unit.
 *
 * @param self Backend state to inspect.
 * @return Borrowed driver unit.
 */
func be_current_unit(self: Backend*) -> DriverUnit* {
    if (self.current_unit == null) {
        be_ice("[ICE-9302] backend requires current driver unit");
    }
    return self.current_unit as DriverUnit*;
}

/**
 * Return the current expression arena.
 *
 * @param self Backend state to inspect.
 * @return Borrowed expression arena.
 */
func be_current_expr_arena(self: Backend*) -> ExprArena* {
    return be_current_unit(self).parse_result.expr_arena;
}

/**
 * Return the current statement arena.
 *
 * @param self Backend state to inspect.
 * @return Borrowed statement arena.
 */
func be_current_stmt_arena(self: Backend*) -> StmtArena* {
    return be_current_unit(self).parse_result.stmt_arena;
}

/**
 * Return a loaded driver unit by module name.
 *
 * @param self Backend state to inspect.
 * @param module_name Module to look up.
 * @return Matching loaded unit, or `null` if absent.
 */
func be_find_unit(self: Backend*, module_name: string) -> DriverUnit*? {
    return driver_find_unit(self.result.driver_state, module_name);
}

/**
 * Return whether this pass emits one module rather than a whole program.
 *
 * @param self Backend state to inspect.
 * @return `true` for module output.
 */
func be_is_module_output(self: Backend*) -> bool {
    return ord(self.output_kind) == ord(CGK_MODULE);
}

/**
 * Return the selected source-backed target module.
 *
 * @param self Backend state to inspect.
 * @return Borrowed parsed target module.
 */
func be_target_root(self: Backend*) -> Module* {
    if (!be_is_module_output(self) || self.target_module == null) {
        be_ice("[ICE-9305] module target requested outside module output");
    }
    let target_name = self.target_module as string;
    let unit = be_find_unit(self, target_name);
    if (unit == null || (unit as DriverUnit*).parse_result.root_module == null) {
        be_ice("[ICE-9306] module output target is not source-backed: " + target_name);
    }
    return (unit as DriverUnit*).parse_result.root_module as Module*;
}

/**
 * Return whether definitions for one source module belong in this output.
 *
 * @param self Backend state to inspect.
 * @param module_name Source module name.
 * @return `true` for every module in legacy output or only the selected module in module output.
 */
func be_emits_module_definitions(self: Backend*, module_name: string) -> bool {
    if (!be_is_module_output(self)) {
        return true;
    }
    return self.target_module != null && (self.target_module as string) == module_name;
}

/**
 * Return whether module output consumes one provider-owned value symbol.
 *
 * @param self Backend state to inspect.
 * @param provider_module Provider module name.
 * @param symbol_name Provider-owned symbol name.
 * @return `true` when name resolution recorded the cross-module use.
 */
func be_target_consumes_symbol(self: Backend*, provider_module: string, symbol_name: string) -> bool {
    if (!be_is_module_output(self) || self.target_module == null || self.result.names == null) {
        return false;
    }
    let names = self.result.names as NameResolution*;
    for (let i = 0; i < nr_resolved_symbol_count(names); i = i + 1) {
        let resolved = nr_resolved_symbol_get(names, i);
        if (resolved.consumer_module == (self.target_module as string) &&
            resolved.provider_module == provider_module && resolved.symbol_name == symbol_name) {
            return true;
        }
    }
    return false;
}

/**
 * Return whether one signature-table entry belongs to module output.
 *
 * @param self Backend state to inspect.
 * @param key Signature key in `module::symbol` form.
 * @return `true` for target-owned, prelude, or consumed provider entries.
 */
func be_target_includes_value_key(self: Backend*, key: string) -> bool {
    if (!be_is_module_output(self) || self.target_module == null) {
        return true;
    }
    let target = self.target_module as string;
    if (starts_with_s(key, target + "::") || starts_with_s(key, "dea::")) {
        return true;
    }
    if (self.result.names == null) {
        return false;
    }
    let names = self.result.names as NameResolution*;
    for (let i = 0; i < nr_resolved_symbol_count(names); i = i + 1) {
        let resolved = nr_resolved_symbol_get(names, i);
        if (resolved.consumer_module == target &&
            key == resolved.provider_module + "::" + resolved.symbol_name) {
            return true;
        }
    }
    return false;
}

/**
 * Return a module environment by name.
 *
 * @param self Backend state to inspect.
 * @param module_name Module to look up.
 * @return Matching module environment, or `null` if absent.
 */
func be_find_env(self: Backend*, module_name: string) -> ModuleEnv*? {
    if (self.result.names == null) {
        return null;
    }
    return nr_env_find(self.result.names as NameResolution*, module_name);
}

/**
 * Resolve one parsed type reference in the current module environment.
 *
 * @param self Backend state to inspect.
 * @param tref Parsed type reference.
 * @return Resolved type, or `null` if resolution fails.
 */
func be_resolve_type_ref(self: Backend*, tref: TypeRef*) -> Type*? {
    if (self.result.signatures == null || self.result.names == null) {
        return null;
    }
    with (let seen = ss_create() => ss_free(seen)) {
        return tr_resolve_type_ref(
            self.result.signatures as SignatureTables*,
            self.result.names as NameResolution*,
            self.result.driver_state,
            be_current_env(self),
            tref,
            self.result.diags,
            seen
        );
    }
}

/**
 * Look up a visible symbol from the current module.
 *
 * @param self Backend state to inspect.
 * @param name Symbol name.
 * @param module_path Optional explicit module path.
 * @param name_qualifier Optional enum-name qualifier.
 * @return Matching symbol, or `null` if absent.
 */
func be_lookup_symbol(self: Backend*, name: string, module_path: StringVector*?, name_qualifier: StringVector*?) -> Symbol*? {
    if (self.result.names == null) {
        return null;
    }
    return tr_symbol_lookup(self.result.names as NameResolution*, be_current_env(self), name, module_path, name_qualifier);
}

/**
 * Return a C callable name for a resolved function symbol.
 *
 * Interface-backed functions use their replayed ABI metadata when present.
 *
 * @param self Backend state to inspect.
 * @param sym Function symbol.
 * @param func_ty Resolved function type.
 * @return C function name.
 */
func be_function_c_name(self: Backend*, sym: Symbol*, func_ty: Type*) -> string {
    if (sym.decl_ptr != null) {
        let decl = sym.decl_ptr as FuncDecl*;
        if (decl.is_extern) {
            return sym.name;
        }
    } else {
        let entry = driver_find_interface_func(self.result.driver_state, sym.module_name, sym.name);
        if (entry != null && (entry as InterfaceFuncEntry*).is_extern) {
            return sym.name;
        }
    }
    return cem_mangle_function_name(sym.module_name, sym.name, func_ty);
}

/**
 * Clone function parameter names for source-backed or interface-backed functions.
 *
 * @param self Backend state to inspect.
 * @param sym Function symbol.
 * @return Cloned parameter names, or `null`.
 */
func be_clone_function_param_names(self: Backend*, sym: Symbol*) -> StringVector*? {
    if (sym.decl_ptr != null) {
        let decl = sym.decl_ptr as FuncDecl*;
        let names = sv_create(vec_size(decl.params));
        for (let i = 0; i < vec_size(decl.params); i = i + 1) {
            sv_push(names, (ptr_vec_get(decl.params, i) as Param*).name);
        }
        return names;
    }
    return driver_clone_interface_func_param_names(self.result.driver_state, sym.module_name, sym.name);
}

/**
 * Check whether a top-level symbol is exported by its module.
 *
 * @param self Backend state.
 * @param module_name Module name.
 * @param symbol_name Symbol name.
 * @return `true` if the symbol is exported.
 */
func be_is_symbol_exported(self: Backend*, module_name: string, symbol_name: string) -> bool {
    let env = nr_env_find(self.result.names as NameResolution*, module_name);
    if (env == null) {
        return true;
    }
    return spm_get((env as ModuleEnv*).exports, symbol_name) != null;
}

/**
 * Return the inferred type of an expression.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to query.
 * @return Cloned inferred type, or `null` if missing.
 */
func be_expr_type(self: Backend*, expr_id: ExprId) -> Type*? {
    if (self.current_module == null) {
        return null;
    }
    return analysis_get_expr_type(self.result, self.current_module as string, expr_id);
}

/**
 * Return the inner expression after removing any parenthesized wrappers.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to unwrap.
 * @return The first non-parenthesized expression id.
 */
func be_unwrap_paren_expr_id(self: Backend*, expr_id: ExprId) -> ExprId {
    let current = expr_id;
    let done = false;
    while (!done) {
        let expr = expr_arena_get(be_current_expr_arena(self), current);
        if (ord(expr.kind) == ord(EX_PAREN)) {
            current = expr.expr_a;
        } else {
            done = true;
        }
    }
    return current;
}

func be_bigint_expr_text(self: Backend*, expr_id: ExprId) -> string? {
    if (expr_id < 0) {
        return null;
    }
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_BIGINT)) {
        return expr.text_value;
    }
    if (ord(expr.kind) == ord(EX_PAREN)) {
        return be_bigint_expr_text(self, expr.expr_a);
    }
    if (ord(expr.kind) == ord(EX_UNARY) && expr.text_value == "-") {
        let text = be_bigint_expr_text(self, expr.expr_a)?;
        if (len_s(text) > 0 && char_at_s(text, 0) == '-') {
            return slice_s(text, 1, len_s(text));
        }
        with (let sb = sb_create() => sb_free(sb)) {
            sb_append(sb, "-");
            sb_append(sb, text);
            return sb_to_string(sb);
        }
    }
    return null;
}

func be_bigint_expr_base(self: Backend*, expr_id: ExprId) -> int? {
    if (expr_id < 0) {
        return null;
    }
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_BIGINT)) {
        return expr.base_value;
    }
    if (ord(expr.kind) == ord(EX_PAREN) || (ord(expr.kind) == ord(EX_UNARY) && expr.text_value == "-")) {
        return be_bigint_expr_base(self, expr.expr_a);
    }
    return null;
}

func be_emit_typed_bigint_expr(self: Backend*, expr_id: ExprId, fallback_ty: Type*?) -> string? {
    let text = be_bigint_expr_text(self, expr_id);
    let base = be_bigint_expr_base(self, expr_id);
    if (text == null || base == null) {
        return null;
    }
    with (let expr_ty = be_expr_type(self, expr_id) => type_free_opt(expr_ty)) {
        let ty = fallback_ty;
        if (expr_ty != null) {
            ty = expr_ty as Type*;
        }
        if (ty == null) {
            return cem_emit_bigint_literal(text as string, base as int);
        }
        return cem_emit_typed_bigint_literal(text as string, base as int, ty as Type*);
    }
}

/**
 * Free a temporary vector of optional owned `Type*` values.
 *
 * @param items Vector to free. Null entries are ignored.
 */
func be_type_ptr_vec_temp_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let vec = items as VectorBase*;
    for (let i = 0; i < vec_size(vec); i = i + 1) {
        let item = ptr_vec_get(vec, i);
        if (item != null) {
            type_free(item as Type*);
        }
    }
    vec_free(vec);
}

/**
 * Free a temporary map of owned `Type*` values.
 *
 * @param items Map to free.
 */
func be_type_ptr_map_temp_free(items: StringPtrMap*?) {
    if (items == null) {
        return;
    }
    let map = items as StringPtrMap*;
    for (let i = 0; i < spm_capacity(map); i = i + 1) {
        if (spm_slot_occupied(map, i)) {
            type_free(spm_slot_value(map, i) as Type*);
        }
    }
    spm_free(map);
}

/**
 * Resolve the type of one local `let` declaration.
 *
 * @param self Backend state to inspect.
 * @param stmt Parsed `let` statement.
 * @return Resolved type.
 */
func be_resolve_let_type(self: Backend*, stmt: StmtNode*) -> Type* {
    let var_ty: Type*? = null;
    if (stmt.type_ref != null) {
        var_ty = be_resolve_type_ref(self, stmt.type_ref as TypeRef*);
    }
    if (var_ty == null) {
        var_ty = be_expr_type(self, stmt.expr_a);
    }
    if (var_ty == null) {
        be_ice("[ICE-1170] missing inferred type for let initializer '" + stmt.name + "'");
    }
    return var_ty as Type*;
}

/**
 * Predeclare a nullable cleanup-block header let to its null literal.
 *
 * @param self Backend state to update.
 * @param stmt Parsed `let` statement from a `with` header.
 * @return Resolved nullable type when predeclared, otherwise `null`.
 */
func be_emit_with_cleanup_header_let_predecl(self: Backend*, stmt: StmtNode*) -> Type*? {
    let var_ty = be_resolve_let_type(self, stmt);
    if (ord(var_ty.kind) != ord(TY_NULLABLE)) {
        type_free(var_ty);
        return null;
    }

    let c_var_name = cem_mangle_identifier(stmt.name);
    let c_type = cem_emit_type(var_ty);
    let c_zero = cem_emit_null_literal(var_ty, true);
    cem_emit_let_decl(self.emitter, c_type, c_var_name, c_zero);

    if (self.current_scope != null) {
        sc_add_owned(self.current_scope as ScopeContext*, c_var_name, var_ty);
    }

    return var_ty;
}

/**
 * Emit the initializer assignment for a predeclared cleanup-block header let.
 *
 * @param self Backend state to update.
 * @param stmt Parsed `let` statement from a `with` header.
 * @param var_ty Resolved type of the predeclared variable.
 */
func be_emit_with_cleanup_header_let_assign(self: Backend*, stmt: StmtNode*, var_ty: Type*) {
    let c_var_name = cem_mangle_identifier(stmt.name);
    let c_value = be_emit_owned_expr_with_expected_type(self, stmt.expr_a, var_ty);
    cem_emit_assignment(self.emitter, c_var_name, c_value);
}

/**
 * Return a fresh backend label name.
 *
 * @param self Backend state to update.
 * @param prefix Label prefix.
 * @return Unique label string.
 */
func be_fresh_label(self: Backend*, prefix: string) -> string {
    self.label_counter = self.label_counter + 1;
    return "__" + prefix + "_" + int_to_string(self.label_counter);
}

/**
 * Push one lexical scope and make it current.
 *
 * @param self Backend state to update.
 * @return New current scope.
 */
func be_push_scope(self: Backend*) -> ScopeContext* {
    let scope = sc_create(self.current_scope);
    self.scope_counter = self.scope_counter + 1;
    scope.scope_id = self.scope_counter;
    ptr_vec_push(self.scope_stack, scope as void*);
    self.current_scope = scope;
    return scope;
}

/**
 * Pop the current lexical scope.
 *
 * @param self Backend state to update.
 */
func be_pop_scope(self: Backend*) {
    if (self.current_scope == null) {
        be_ice("[ICE-1330] scope underflow");
    }
    self.current_scope = (self.current_scope as ScopeContext*).parent;
}

/**
 * Push one active loop-label frame.
 *
 * @param self Backend state to update.
 * @param break_label Break target label.
 * @param continue_label Continue target label.
 */
func be_push_loop_labels(self: Backend*, break_label: string, continue_label: string) {
    self.current_loop_labels = new LoopLabels(self.current_loop_labels, break_label, continue_label);
}

/**
 * Pop one active loop-label frame.
 *
 * @param self Backend state to update.
 */
func be_pop_loop_labels(self: Backend*) {
    if (self.current_loop_labels == null) {
        be_ice("[ICE-1020] break/continue outside of loop");
    }
    let top = self.current_loop_labels as LoopLabels*;
    self.current_loop_labels = top.parent;
    drop top;
}

/**
 * Push one active loop-cleanup frame.
 *
 * @param self Backend state to update.
 * @param continue_scope Scope to clean for `continue`.
 * @param break_scope Scope to clean for `break`.
 */
func be_push_loop_cleanup_scopes(self: Backend*, continue_scope: ScopeContext*, break_scope: ScopeContext*) {
    self.current_loop_cleanup_scopes = new LoopCleanupScopes(self.current_loop_cleanup_scopes, continue_scope, break_scope,
        continue_scope.scope_id, break_scope.scope_id);
}

/**
 * Pop one active loop-cleanup frame.
 *
 * @param self Backend state to update.
 */
func be_pop_loop_cleanup_scopes(self: Backend*) {
    if (self.current_loop_cleanup_scopes == null) {
        be_ice("[ICE-1020] break/continue outside of loop");
    }
    let top = self.current_loop_cleanup_scopes as LoopCleanupScopes*;
    self.current_loop_cleanup_scopes = top.parent;
    drop top;
}

/**
 * Return the type of a declared local binding when present.
 *
 * @param self Backend state to inspect.
 * @param var_name Source-level variable name.
 * @return Borrowed declared type, or `null` if absent.
 */
func be_lookup_local_var_type(self: Backend*, var_name: string) -> Type*? {
    return sc_lookup_declared_type(self.current_scope, cem_mangle_identifier(var_name));
}

/**
 * Return the mangled name when a local variable is currently tracked as owned.
 *
 * @param self Backend state to inspect.
 * @param expr_id Variable-reference expression id.
 * @return Mangled local name, or `null` when not owned by the current scope chain.
 */
func be_lookup_owned_local_name(self: Backend*, expr_id: ExprId) -> string? {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) != ord(EX_VAR_REF)) {
        return null;
    }

    let resolution = analysis_get_var_ref_resolution(self.result, self.current_module as string, expr_id);
    if (resolution == null || (resolution as int) != ord(VAR_RES_LOCAL)) {
        return null;
    }

    let mangled_name = cem_mangle_identifier(expr.text_value);
    let scope = self.current_scope;
    while (scope != null) {
        let cur = scope as ScopeContext*;
        for (let i = 0; i < vec_size(cur.owned_vars); i = i + 1) {
            let item = ptr_vec_get(cur.owned_vars, i) as ScopeVar*;
            if (item.name == mangled_name) {
                return mangled_name;
            }
        }
        scope = cur.parent;
    }
    return null;
}

/**
 * Report whether an expression refers to an existing place.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to classify.
 * @return `true` for local/module places, dereferences, indexes, and fields.
 */
func be_is_place_expr(self: Backend*, expr_id: ExprId) -> bool {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_VAR_REF) || ord(expr.kind) == ord(EX_INDEX) || ord(expr.kind) == ord(EX_FIELD)) {
        return true;
    }
    if (ord(expr.kind) == ord(EX_UNARY) && expr.text_value == "*") {
        return true;
    }
    if (ord(expr.kind) == ord(EX_PAREN)) {
        return be_is_place_expr(self, expr.expr_a);
    }
    return false;
}

/**
 * Report whether an expression may have side effects when evaluated.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to classify.
 * @return `true` when the expression should be cached before reuse.
 */
func be_has_side_effects(self: Backend*, expr_id: ExprId) -> bool {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    match (expr.kind) {
        EX_INT => { return false; }
        EX_BIGINT => { return false; }
        EX_FLOAT => { return false; }
        EX_DOUBLE => { return false; }
        EX_BYTE => { return false; }
        EX_STRING => { return false; }
        EX_BOOL => { return false; }
        EX_NULL => { return false; }
        EX_VAR_REF => { return false; }
        EX_CALL => { return true; }
        EX_NEW => { return true; }
        EX_UNARY => { return be_has_side_effects(self, expr.expr_a); }
        EX_BINARY => { return be_has_side_effects(self, expr.expr_a) || be_has_side_effects(self, expr.expr_b); }
        EX_CAST => { return be_has_side_effects(self, expr.expr_a); }
        EX_PAREN => { return be_has_side_effects(self, expr.expr_a); }
        EX_FIELD => { return be_has_side_effects(self, expr.expr_a); }
        EX_INDEX => { return be_has_side_effects(self, expr.expr_a) || be_has_side_effects(self, expr.expr_b); }
        EX_TRY => { return be_has_side_effects(self, expr.expr_a); }
        EX_TYPE => { return false; }
        EX_ARRAY_LITERAL => { return false; }
        EX_ARRAY_CONSTRUCTOR => { return true; }
    }
}

/**
 * Return the represented pointer type for pointer-shaped values.
 *
 * @param ty Type to inspect.
 * @return Pointer type, or `null` when not pointer-shaped.
 */
func be_pointer_type_or_null(ty: Type*?) -> Type*? {
    if (ty == null) {
        return null;
    }
    let actual = ty as Type*;
    if (ord(actual.kind) == ord(TY_POINTER)) {
        return actual;
    }
    if (ord(actual.kind) == ord(TY_NULLABLE) && actual.inner != null &&
            ord((actual.inner as Type*).kind) == ord(TY_POINTER)) {
        return actual.inner as Type*;
    }
    return null;
}

/**
 * Return a C sizeof expression for the runtime access extent.
 *
 * @param ty Type whose value extent is required.
 * @return C expression string.
 */
func be_sizeof_expr_for_type(ty: Type*) -> string {
    if (type_is_builtin(ty, "void")) {
        return "1";
    }
    return "sizeof(" + cem_emit_type(ty) + ")";
}

/**
 * Return a C alignment expression for the runtime access target.
 *
 * @param ty Type whose alignment is required.
 * @return C expression string.
 */
func be_alignof_expr_for_type(ty: Type*) -> string {
    if (type_is_builtin(ty, "void")) {
        return "1";
    }
    return "_RT_ALIGNOF(" + cem_emit_type(ty) + ")";
}

/**
 * Emit a pointer expression checked for one pointee-sized access.
 *
 * @param self Backend state to inspect.
 * @param c_ptr_expr Pointer expression.
 * @param ptr_ty L1 pointer-shaped type.
 * @param access_mode Runtime access mode expression.
 * @return Checked pointer expression.
 */
func be_emit_checked_pointer_expr(self: Backend*, c_ptr_expr: string, ptr_ty: Type*, access_mode: string) -> string {
    let represented_ptr = be_pointer_type_or_null(ptr_ty);
    if (represented_ptr == null) {
        return be_ice_string("[ICE-1245] expected pointer type, got '" + type_format(ptr_ty) + "'");
    }

    let ptr = represented_ptr as Type*;
    return cem_emit_checked_ptr_access(
        self.emitter,
        c_ptr_expr,
        cem_emit_type(ptr),
        be_sizeof_expr_for_type(ptr.inner as Type*),
        be_alignof_expr_for_type(ptr.inner as Type*),
        access_mode
    );
}

/**
 * Report whether an expression is a cast from a place.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to classify.
 * @return `true` when the expression is a cast whose source is a place expression.
 */
func be_is_unwrap_cast_from_place(self: Backend*, expr_id: ExprId) -> bool {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) != ord(EX_CAST)) {
        return false;
    }
    return be_is_place_expr(self, expr.expr_a);
}

/**
 * Report whether a non-place ARC rvalue needs temporary materialization.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to classify.
 * @return `true` when the expression should be hoisted into a cleanup temp.
 */
func be_needs_arc_temp(self: Backend*, expr_id: ExprId) -> bool {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    return ord(expr.kind) != ord(EX_STRING);
}

/**
 * Report whether an expression should be materialized into a scope-owned temp.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to classify.
 * @param expr_type Inferred type of the expression.
 * @return `true` when the expression carries ARC data and is not already a place.
 */
func be_should_materialize_arc_temp(self: Backend*, expr_id: ExprId, expr_type: Type*) -> bool {
    return analysis_has_arc_data(self.result, expr_type) &&
           !be_is_place_expr(self, expr_id) &&
           !be_is_unwrap_cast_from_place(self, expr_id) &&
           be_needs_arc_temp(self, expr_id);
}

/**
 * Materialize one ARC rvalue into a scope-owned temporary.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered expression to store.
 * @param expr_type Type of the stored expression.
 * @return Temporary variable name.
 */
func be_materialize_arc_temp(self: Backend*, c_expr: string, expr_type: Type*) -> string {
    if (self.current_scope == null) {
        be_ice("[ICE-1311] ARC temp materialization requires an active scope");
    }
    let temp = cem_fresh_tmp(self.emitter, "arc");
    cem_emit_temp_decl(self.emitter, cem_emit_type(expr_type), temp, c_expr);
    sc_add_owned(self.current_scope as ScopeContext*, temp, expr_type);
    return temp;
}

/**
 * Materialize one array source used as slice backing storage.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered array expression to store.
 * @param expr_id Source expression id.
 * @param array_ty Type of the stored array.
 * @param prefix Temporary-name prefix.
 * @return Temporary variable name.
 */
func be_materialize_slice_array_temp(
    self: Backend*,
    c_expr: string,
    expr_id: ExprId,
    array_ty: Type*,
    prefix: string
) -> string {
    let temp = cem_fresh_tmp(self.emitter, prefix);
    cem_emit_temp_decl(self.emitter, cem_emit_type(array_ty), temp, c_expr);
    if (analysis_has_arc_data(self.result, array_ty)) {
        if (self.current_scope == null) {
            be_ice("[ICE-1312] slice backing array cleanup requires an active scope");
        }
        if (be_is_place_expr(self, expr_id) || be_is_unwrap_cast_from_place(self, expr_id)) {
            be_emit_retain_for_copied_value(self, temp, array_ty);
        }
        sc_add_owned(self.current_scope as ScopeContext*, temp, array_ty);
    }
    return temp;
}

/**
 * Finalize a lowered call argument using its post-conversion type.
 *
 * @param self Backend state to update.
 * @param arg_id Source argument expression id.
 * @param c_arg Lowered argument expression.
 * @param lowered_ty Type of `c_arg` after contextual conversion.
 * @param is_out_of_order Whether the argument must be stabilized for reordering.
 * @return Lowered argument expression or a materialized temporary.
 */
func be_finalize_lowered_call_arg(
    self: Backend*,
    arg_id: ExprId,
    c_arg: string,
    lowered_ty: Type*,
    is_out_of_order: bool
) -> string {
    let result = c_arg;
    if (be_should_materialize_arc_temp(self, arg_id, lowered_ty)) {
        result = be_materialize_arc_temp(self, result, lowered_ty);
    }
    if (is_out_of_order) {
        let arg_tmp = cem_fresh_tmp(self.emitter, "arg");
        cem_emit_temp_decl(self.emitter, cem_emit_type(lowered_ty), arg_tmp, result);
        result = arg_tmp;
    }
    return result;
}

/**
 * Stabilize one reordered constructor argument using its post-conversion type.
 *
 * @param self Backend state to update.
 * @param c_arg Lowered argument expression.
 * @param lowered_ty Type of `c_arg` after contextual conversion.
 * @param is_out_of_order Whether the argument must be stabilized for reordering.
 * @return Lowered argument expression or a materialized temporary.
 */
func be_finalize_lowered_constructor_arg(
    self: Backend*,
    c_arg: string,
    lowered_ty: Type*,
    is_out_of_order: bool
) -> string {
    let result = c_arg;
    if (is_out_of_order) {
        let arg_tmp = cem_fresh_tmp(self.emitter, "arg");
        cem_emit_temp_decl(self.emitter, cem_emit_type(lowered_ty), arg_tmp, result);
        result = arg_tmp;
    }
    return result;
}

/**
 * Report whether any scope in the current chain has pending cleanup work.
 *
 * @param self Backend state to inspect.
 * @return `true` when owned values or `with` cleanup are present.
 */
func be_scope_chain_has_cleanup(self: Backend*) -> bool {
    let scope = self.current_scope;
    while (scope != null) {
        let cur = scope as ScopeContext*;
        if (((cur.with_cleanup_block >= 0) || sc_has_inline_cleanup(cur)) && !cur.with_cleanup_in_progress) {
            return true;
        }
        for (let i = 0; i < vec_size(cur.owned_vars); i = i + 1) {
            let item = ptr_vec_get(cur.owned_vars, i) as ScopeVar*;
            if (analysis_has_arc_data(self.result, item.var_type)) {
                return true;
            }
        }
        scope = cur.parent;
    }
    return false;
}

/**
 * Emit retain operations for one copied owned value.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered expression containing the copied value.
 * @param ty Type of the copied value.
 */
func be_emit_retain_for_copied_value(self: Backend*, c_expr: string, ty: Type*) {
    if (analysis_is_arc_type(ty)) {
        cem_emit_string_retain(self.emitter, c_expr);
        return;
    }

    if (ord(ty.kind) == ord(TY_NULLABLE)) {
        if (cem_is_niche_nullable(ty) || !analysis_has_arc_data(self.result, ty.inner as Type*)) {
            return;
        }
        cem_emit_if_header(self.emitter, cem_emit_optional_has_value(c_expr));
        cem_emit_block_start(self.emitter);
        be_emit_retain_for_copied_value(self, cem_emit_optional_value(c_expr), ty.inner as Type*);
        cem_emit_block_end(self.emitter);
        return;
    }

    if (ord(ty.kind) == ord(TY_ARRAY)) {
        if (!analysis_has_arc_data(self.result, ty.inner as Type*)) {
            return;
        }
        let idx = cem_fresh_tmp(self.emitter, "arr_i");
        ccb_emit(self.emitter.out, "for (dea_int " + idx + " = 0; " + idx + " < " +
            int_to_string(ty.array_len) + "; " + idx + " = " + idx + " + 1) {");
        ccb_indent(self.emitter.out);
        let inner = ty.inner as Type*;
        if (ord(inner.kind) == ord(TY_ARRAY)) {
            be_emit_retain_for_copied_raw_array(self, "(" + c_expr + ").data[" + idx + "]", inner);
        } else {
            be_emit_retain_for_copied_value(self, "(" + c_expr + ").data[" + idx + "]", inner);
        }
        ccb_dedent(self.emitter.out);
        ccb_emit(self.emitter.out, "}");
        return;
    }

    if (ord(ty.kind) == ord(TY_STRUCT)) {
        let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, ty.module_name, ty.name);
        if (info == null) {
            return;
        }
        for (let i = 0; i < vec_size((info as StructInfo*).fields); i = i + 1) {
            let field = ptr_vec_get((info as StructInfo*).fields, i) as StructFieldInfo*;
            be_emit_retain_for_copied_value(self, cem_emit_field_access(c_expr, field.name, false), field.field_type);
        }
        return;
    }

    if (ord(ty.kind) == ord(TY_ENUM)) {
        let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, ty.module_name, ty.name);
        if (enum_info == null) {
            return;
        }

        cem_emit_switch_start(self.emitter, cem_emit_enum_tag_access(c_expr));
        let variants = (enum_info as EnumInfo*).variants;
        for (let i = 0; i < vec_size(variants); i = i + 1) {
            let info2 = ptr_vec_get(variants, i) as EnumVariantInfo*;
            cem_emit_case_label(self.emitter, cem_emit_enum_tag(ty, info2.name));
            cem_emit_block_start(self.emitter);
            for (let j = 0; j < vec_size(info2.field_types); j = j + 1) {
                let field_ty = ptr_vec_get(info2.field_types, j) as Type*;
                be_emit_retain_for_copied_value(self,
                    cem_emit_enum_payload_field_access(c_expr, info2.name,
                        sv_get(info2.field_names, j)),
                    field_ty);
            }
            cem_emit_exit_switch(self.emitter);
            cem_emit_block_end(self.emitter);
        }
        cem_emit_unreachable_marker(self.emitter, "retain");
        cem_emit_switch_end(self.emitter);
    }
}

/**
 * Emit retain operations for copied values in raw C array storage.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered raw C array expression.
 * @param ty Array type represented by `c_expr`.
 */
func be_emit_retain_for_copied_raw_array(self: Backend*, c_expr: string, ty: Type*) {
    if (ord(ty.kind) != ord(TY_ARRAY)) {
        be_emit_retain_for_copied_value(self, c_expr, ty);
        return;
    }
    if (!analysis_has_arc_data(self.result, ty.inner as Type*)) {
        return;
    }
    let idx = cem_fresh_tmp(self.emitter, "arr_i");
    ccb_emit(self.emitter.out, "for (dea_int " + idx + " = 0; " + idx + " < " +
        int_to_string(ty.array_len) + "; " + idx + " = " + idx + " + 1) {");
    ccb_indent(self.emitter.out);
    let inner = ty.inner as Type*;
    if (ord(inner.kind) == ord(TY_ARRAY)) {
        be_emit_retain_for_copied_raw_array(self, c_expr + "[" + idx + "]", inner);
    } else {
        be_emit_retain_for_copied_value(self, c_expr + "[" + idx + "]", inner);
    }
    ccb_dedent(self.emitter.out);
    ccb_emit(self.emitter.out, "}");
}

/**
 * Materialize one copied value into a temp and retain any owned fields.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered source expression.
 * @param ty Type of the copied value.
 * @return Lowered expression or new temp name when retain logic is needed.
 */
func be_emit_copy_expr_with_retains(self: Backend*, c_expr: string, ty: Type*) -> string {
    if (!analysis_has_arc_data(self.result, ty)) {
        return c_expr;
    }

    let temp = cem_fresh_tmp(self.emitter, "copy");
    cem_emit_temp_decl(self.emitter, cem_emit_type(ty), temp, c_expr);
    be_emit_retain_for_copied_value(self, temp, ty);
    return temp;
}

/**
 * Emit an index lvalue, including a bounds check for fixed-size arrays.
 *
 * @param self Backend state to update.
 * @param base Lowered base expression.
 * @param index Lowered index expression.
 * @param base_ty Type of the base expression.
 * @return Lowered lvalue.
 */
func be_emit_checked_index_lvalue(self: Backend*, base: string, index: string, base_ty: Type*, raw_array_base: bool, access_mode: string) -> string {
    if (ord(base_ty.kind) == ord(TY_ARRAY)) {
        ccb_emit(self.emitter.out, "if ((" + index + ") < 0 || (" + index + ") >= " +
            int_to_string(base_ty.array_len) + ") {");
        ccb_indent(self.emitter.out);
        ccb_emit(self.emitter.out, "_rt_panic_oob(" + index + ", " + int_to_string(base_ty.array_len) + ");");
        ccb_dedent(self.emitter.out);
        ccb_emit(self.emitter.out, "}");
        if (raw_array_base) {
            return "(" + base + ")[" + index + "]";
        }
        return "(" + base + ").data[" + index + "]";
    }
    if (ord(base_ty.kind) == ord(TY_SLICE)) {
        let len_expr = "(" + base + ").len";
        ccb_emit(self.emitter.out, "if ((" + index + ") < 0 || (" + index + ") >= " + len_expr + ") {");
        ccb_indent(self.emitter.out);
        ccb_emit(self.emitter.out, "_rt_panic_oob(" + index + ", " + len_expr + ");");
        ccb_dedent(self.emitter.out);
        ccb_emit(self.emitter.out, "}");
        let elem_ty = base_ty.inner as Type*;
        let c_ptr_ty = cem_emit_pointer_type(elem_ty);
        let checked = cem_emit_checked_ptr_index_access(
            self.emitter,
            "(" + base + ").data",
            index,
            c_ptr_ty,
            be_sizeof_expr_for_type(elem_ty),
            be_alignof_expr_for_type(elem_ty),
            access_mode,
            true
        );
        return cem_emit_deref_lvalue(checked);
    }
    if (ord(base_ty.kind) == ord(TY_POINTER)) {
        let c_ptr_ty = cem_emit_type(base_ty);
        let checked = cem_emit_checked_ptr_index_access(
            self.emitter,
            base,
            index,
            c_ptr_ty,
            be_sizeof_expr_for_type(base_ty.inner as Type*),
            be_alignof_expr_for_type(base_ty.inner as Type*),
            access_mode,
            false
        );
        return cem_emit_deref_lvalue(checked);
    }
    return cem_emit_index_lvalue(base, index);
}

/**
 * Return whether a type behaves like an integer.
 *
 * @param ty Type to inspect.
 * @return `true` for implemented integer builtins.
 */
func be_is_int_assignable(ty: Type*?) -> bool {
    if (ty == null) {
        return false;
    }
    return type_is_builtin(ty as Type*, "tiny") || type_is_builtin(ty as Type*, "byte") ||
           type_is_builtin(ty as Type*, "short") || type_is_builtin(ty as Type*, "ushort") ||
           type_is_builtin(ty as Type*, "int") || type_is_builtin(ty as Type*, "uint") ||
           type_is_builtin(ty as Type*, "long") || type_is_builtin(ty as Type*, "ulong");
}

func be_is_signed_int(ty: Type*) -> bool {
    return type_is_builtin(ty, "tiny") || type_is_builtin(ty, "short") ||
           type_is_builtin(ty, "int") || type_is_builtin(ty, "long");
}

func be_is_legacy_checked_cast_source(ty: Type*) -> bool {
    return type_is_builtin(ty, "tiny") || type_is_builtin(ty, "byte") ||
           type_is_builtin(ty, "short") || type_is_builtin(ty, "ushort") ||
           type_is_builtin(ty, "int");
}

/**
 * Return the byte width of an integer builtin.
 *
 * @param ty Type to inspect.
 * @return Byte width for supported integer types.
 */
func be_int_type_size(ty: Type*) -> int {
    if (type_is_builtin(ty, "tiny")) {
        return 1;
    }
    if (type_is_builtin(ty, "byte")) {
        return 1;
    }
    if (type_is_builtin(ty, "short")) {
        return 2;
    }
    if (type_is_builtin(ty, "ushort")) {
        return 2;
    }
    if (type_is_builtin(ty, "int")) {
        return 4;
    }
    if (type_is_builtin(ty, "uint")) {
        return 4;
    }
    if (type_is_builtin(ty, "long")) {
        return 8;
    }
    if (type_is_builtin(ty, "ulong")) {
        return 8;
    }
    return 0;
}

/**
 * Return the minimum representable value for an integer builtin.
 *
 * @param ty Type to inspect.
 * @return Minimum value for supported integer types.
 */
func be_int_type_min(ty: Type*) -> int {
    if (type_is_builtin(ty, "tiny")) return -128;
    if (type_is_builtin(ty, "byte")) return 0;
    if (type_is_builtin(ty, "short")) return -32768;
    if (type_is_builtin(ty, "ushort")) return 0;
    return -2147483648;
}

/**
 * Return the maximum representable value for an integer builtin.
 *
 * @param ty Type to inspect.
 * @return Maximum value for supported integer types.
 */
func be_int_type_max(ty: Type*) -> int {
    if (type_is_builtin(ty, "tiny")) return 127;
    if (type_is_builtin(ty, "byte")) return 255;
    if (type_is_builtin(ty, "short")) return 32767;
    if (type_is_builtin(ty, "ushort")) return 65535;
    return 2147483647;
}

/**
 * Check whether every source value fits in a destination integer type.
 *
 * @param dst Destination type.
 * @param src Source type.
 * @return `true` when no runtime check is needed.
 */
func be_int_range_contains(dst: Type*, src: Type*) -> bool {
    let dst_size = be_int_type_size(dst);
    let src_size = be_int_type_size(src);
    let dst_signed = be_is_signed_int(dst);
    let src_signed = be_is_signed_int(src);
    if (dst_size == 0 || src_size == 0) {
        return false;
    }
    if (dst_signed == src_signed) {
        return dst_size >= src_size;
    }
    if (dst_signed && !src_signed) {
        return dst_size > src_size;
    }
    return false;
}

/**
 * Check whether an implicit integer widening is supported.
 *
 * @param dst Destination type.
 * @param src Source type.
 * @return `true` if `src` can widen into `dst`.
 */
func be_can_widen_int(dst: Type*, src: Type*) -> bool {
    if (type_is_builtin(dst, "short") && type_is_builtin(src, "tiny")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "tiny")) return true;
    if (type_is_builtin(dst, "int") && type_is_builtin(src, "tiny")) return true;
    if (type_is_builtin(dst, "short") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "ushort") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "int") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "uint") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "ulong") && type_is_builtin(src, "byte")) return true;
    if (type_is_builtin(dst, "int") && type_is_builtin(src, "short")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "short")) return true;
    if (type_is_builtin(dst, "int") && type_is_builtin(src, "ushort")) return true;
    if (type_is_builtin(dst, "uint") && type_is_builtin(src, "ushort")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "ushort")) return true;
    if (type_is_builtin(dst, "ulong") && type_is_builtin(src, "ushort")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "int")) return true;
    if (type_is_builtin(dst, "long") && type_is_builtin(src, "uint")) return true;
    if (type_is_builtin(dst, "ulong") && type_is_builtin(src, "uint")) return true;
    return false;
}

func be_common_int_type(left: Type*, right: Type*) -> Type*? {
    if (!be_is_int_assignable(left) || !be_is_int_assignable(right)) {
        return null;
    }
    if ((type_is_builtin(left, "tiny") || type_is_builtin(left, "byte") || type_is_builtin(left, "short") ||
         type_is_builtin(left, "ushort") || type_is_builtin(left, "int")) &&
        (type_is_builtin(right, "tiny") || type_is_builtin(right, "byte") || type_is_builtin(right, "short") ||
         type_is_builtin(right, "ushort") || type_is_builtin(right, "int"))) {
        return type_builtin_int();
    }
    if ((type_is_builtin(left, "byte") || type_is_builtin(left, "ushort") || type_is_builtin(left, "uint")) &&
        (type_is_builtin(right, "byte") || type_is_builtin(right, "ushort") || type_is_builtin(right, "uint"))) {
        return type_builtin_uint();
    }
    if ((type_is_builtin(left, "tiny") || type_is_builtin(left, "byte") || type_is_builtin(left, "short") ||
         type_is_builtin(left, "ushort") || type_is_builtin(left, "int") || type_is_builtin(left, "uint") ||
         type_is_builtin(left, "long")) &&
        (type_is_builtin(right, "tiny") || type_is_builtin(right, "byte") || type_is_builtin(right, "short") ||
         type_is_builtin(right, "ushort") || type_is_builtin(right, "int") || type_is_builtin(right, "uint") ||
         type_is_builtin(right, "long"))) {
        return type_builtin_long();
    }
    if ((type_is_builtin(left, "byte") || type_is_builtin(left, "ushort") || type_is_builtin(left, "uint") ||
         type_is_builtin(left, "ulong")) &&
        (type_is_builtin(right, "byte") || type_is_builtin(right, "ushort") || type_is_builtin(right, "uint") ||
         type_is_builtin(right, "ulong"))) {
        return type_builtin_ulong();
    }
    return null;
}

/**
 * Convert a lowered expression to an expected type when required.
 *
 * @param c_expr Lowered source expression.
 * @param natural_ty Natural source type.
 * @param expected Expected destination type.
 * @return Lowered expression converted as needed.
 */
func be_convert_expr_with_expected_type(c_expr: string, natural_ty: Type*?, expected: Type*) -> string {
    if (natural_ty == null) {
        return c_expr;
    }

    let natural = natural_ty as Type*;
    if (type_equals(natural, expected)) {
        return c_expr;
    }

    if (ord(expected.kind) == ord(TY_NULLABLE)) {
        let inner = expected.inner as Type*;
        let payload = be_convert_expr_with_expected_type(c_expr, natural, inner);
        if (be_is_int_assignable(inner) && be_is_int_assignable(natural) && !type_equals(inner, natural) &&
            !be_can_widen_int(inner, natural)) {
            payload = cem_emit_cast(cem_emit_type(inner), c_expr);
        }
        return cem_emit_some_value_for_nullable(expected, payload);
    }

    if (be_can_widen_int(expected, natural)) {
        return cem_emit_widen_int(c_expr, natural, expected);
    }

    return c_expr;
}

/**
 * Convert a lowered place expression to an expected owned destination type.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered source expression.
 * @param natural Natural source type.
 * @param expected Expected destination type.
 * @param place_like Whether `c_expr` references existing storage.
 * @return Converted C expression, retaining copied owned data when needed.
 */
func be_convert_owned_c_expr_with_expected_type(self: Backend*, c_expr: string, natural: Type*, expected: Type*,
                                                place_like: bool) -> string {
    if (type_equals(natural, expected)) {
        if (place_like) {
            return be_emit_copy_expr_with_retains(self, c_expr, expected);
        }
        return c_expr;
    }

    if (ord(expected.kind) == ord(TY_NULLABLE)) {
        let inner = expected.inner as Type*;
        let payload = be_convert_owned_c_expr_with_expected_type(self, c_expr, natural, inner, place_like);
        if (be_is_int_assignable(inner) && be_is_int_assignable(natural) && !type_equals(inner, natural) &&
            !be_can_widen_int(inner, natural)) {
            payload = cem_emit_cast(cem_emit_type(inner), c_expr);
        }
        return cem_emit_some_value_for_nullable(expected, payload);
    }

    return be_convert_expr_with_expected_type(c_expr, natural, expected);
}

/**
 * Emit a direct function call, redirecting trace-wrapped runtime APIs to their
 * caller-location-preserving implementation entry points when trace mode is on.
 *
 * @param self Backend state to inspect.
 * @param c_func_name Lowered C function name.
 * @param c_args Comma-separated lowered arguments.
 * @return Function-call expression.
 */
func be_emit_direct_function_call(self: Backend*, c_func_name: string, c_args: string) -> string {
    if (self.opts.trace_memory && c_func_name == "rt_string_concat") {
        return "_rt_string_concat_impl(" + c_args + ", __FILE__, __LINE__)";
    }
    if (self.opts.trace_arc && c_func_name == "rt_string_retain") {
        return "_rt_string_retain_impl(" + c_args + ", __FILE__, __LINE__)";
    }
    if (self.opts.trace_arc && c_func_name == "rt_string_release") {
        return "_rt_string_release_impl(" + c_args + ", __FILE__, __LINE__)";
    }
    return cem_emit_function_call(c_func_name, c_args);
}

/**
 * Emit a fixed-size array literal for a contextual array type.
 *
 * @param self Backend state to update.
 * @param expr_id Array literal expression.
 * @param expected Contextual array type.
 * @return Compound literal expression.
 */
func be_emit_array_literal_value(self: Backend*, expr_id: ExprId, expected: Type*) -> string {
    return "((" + cem_emit_type(expected) + "){.data = " +
        be_emit_array_literal_data_initializer(self, expr_id, expected) + "})";
}

/**
 * Emit a fixed-size array literal as a file-scope C initializer.
 *
 * @param self Backend state to update.
 * @param expr_id Array literal expression.
 * @param expected Contextual array type.
 * @return Brace initializer suitable for static storage duration.
 */
func be_emit_array_literal_static_initializer(self: Backend*, expr_id: ExprId, expected: Type*) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "{.data = {");
        let ids = expr.ids as VectorBase*;
        if (vec_size(ids) == 0) {
            sb_append(sb, "0");
        }
        for (let i = 0; i < vec_size(ids); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, be_emit_let_initializer(self, id_vec_get(ids, i), expected.inner as Type*));
        }
        sb_append(sb, "}}");
        return sb_to_string(sb);
    }
}

/**
 * Emit the C brace initializer for an array literal's data field.
 *
 * @param self Backend state to update.
 * @param expr_id Array literal expression.
 * @param expected Contextual array type.
 * @return Brace initializer for the array data.
 */
func be_emit_array_literal_data_initializer(self: Backend*, expr_id: ExprId, expected: Type*) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "{");
        let ids = expr.ids as VectorBase*;
        if (vec_size(ids) == 0) {
            sb_append(sb, "0");
        }
        for (let i = 0; i < vec_size(ids); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            let elem_id = id_vec_get(ids, i);
            let elem_literal_id = be_unwrap_paren_expr_id(self, elem_id);
            let elem_expr = expr_arena_get(be_current_expr_arena(self), elem_literal_id);
            let elem_ty = expected.inner as Type*;
            if (ord(elem_ty.kind) == ord(TY_ARRAY) && ord(elem_expr.kind) == ord(EX_ARRAY_LITERAL)) {
                sb_append(sb, be_emit_array_literal_data_initializer(self, elem_literal_id, elem_ty));
            } else {
                sb_append(sb, be_emit_owned_expr_with_expected_type(self, elem_id, elem_ty));
            }
        }
        sb_append(sb, "}");
        return sb_to_string(sb);
    }
}

/**
 * Copy one array value into raw C array storage, retaining managed leaves.
 *
 * @param self Backend state to update.
 * @param target_raw Lowered C array storage expression.
 * @param source_raw Lowered C array storage expression.
 * @param array_ty Array type represented by the raw storage expressions.
 */
func be_emit_array_copy_to_raw_storage(self: Backend*, target_raw: string, source_raw: string, array_ty: Type*) {
    if (ord(array_ty.kind) != ord(TY_ARRAY)) {
        cem_emit_assignment(self.emitter, target_raw, source_raw);
        be_emit_retain_for_copied_value(self, target_raw, array_ty);
        return;
    }

    let idx = cem_fresh_tmp(self.emitter, "arr_i");
    ccb_emit(self.emitter.out, "for (dea_int " + idx + " = 0; " + idx + " < " +
        int_to_string(array_ty.array_len) + "; " + idx + " = " + idx + " + 1) {");
    ccb_indent(self.emitter.out);
    let inner = array_ty.inner as Type*;
    if (ord(inner.kind) == ord(TY_ARRAY)) {
        be_emit_array_copy_to_raw_storage(self, target_raw + "[" + idx + "]", source_raw + "[" + idx + "]", inner);
    } else {
        cem_emit_assignment(self.emitter, target_raw + "[" + idx + "]", source_raw + "[" + idx + "]");
        be_emit_retain_for_copied_value(self, target_raw + "[" + idx + "]", inner);
    }
    ccb_dedent(self.emitter.out);
    ccb_emit(self.emitter.out, "}");
}

/**
 * Emit a scalar-fill array constructor into a temporary.
 *
 * @param self Backend state to update.
 * @param value_expr Fill value expression id.
 * @param expected Target array type.
 * @return Temporary array value.
 */
func be_emit_array_fill_value(self: Backend*, value_expr: ExprId, expected: Type*) -> string {
    let tmp = cem_fresh_tmp(self.emitter, "arr");
    cem_emit_temp_decl(self.emitter, cem_emit_type(expected), tmp, "((" + cem_emit_type(expected) + "){0})");
    let value_tmp = cem_fresh_tmp(self.emitter, "fill");
    cem_emit_temp_decl(self.emitter, cem_emit_type(expected.inner as Type*), value_tmp,
        be_emit_owned_expr_with_expected_type(self, value_expr, expected.inner as Type*));
    let idx = cem_fresh_tmp(self.emitter, "arr_i");
    ccb_emit(self.emitter.out, "for (dea_int " + idx + " = 0; " + idx + " < " +
        int_to_string(expected.array_len) + "; " + idx + " = " + idx + " + 1) {");
    ccb_indent(self.emitter.out);
    let inner = expected.inner as Type*;
    if (ord(inner.kind) == ord(TY_ARRAY)) {
        be_emit_array_copy_to_raw_storage(self, tmp + ".data[" + idx + "]", value_tmp + ".data", inner);
    } else {
        cem_emit_assignment(self.emitter, tmp + ".data[" + idx + "]", value_tmp);
        be_emit_retain_for_copied_value(self, tmp + ".data[" + idx + "]", inner);
    }
    ccb_dedent(self.emitter.out);
    ccb_emit(self.emitter.out, "}");
    cem_emit_value_cleanup(self.emitter, value_tmp, expected.inner as Type*);
    return tmp;
}

/**
 * Emit a fixed-array value as a non-owning slice descriptor for a slice target.
 *
 * Arrays always have a positive compile-time length, so the descriptor length is
 * the array length and the data pointer is the array's storage.
 *
 * @param self Backend state to update.
 * @param expr_id Source array expression.
 * @param array_ty Resolved array type of the source.
 * @param slice_ty Resolved slice target type.
 * @return Lowered slice descriptor expression.
 */
func be_emit_array_to_slice(self: Backend*, expr_id: ExprId, array_ty: Type*, slice_ty: Type*) -> string {
    let arr_c = be_emit_expr(self, expr_id);
    if (be_has_side_effects(self, expr_id)) {
        arr_c = be_materialize_slice_array_temp(self, arr_c, expr_id, array_ty, "slice_arr");
    }
    return "((" + cem_emit_type(slice_ty) + "){ .len = ((dea_int)" + int_to_string(array_ty.array_len) +
        "), .data = (" + arr_c + ").data })";
}

/**
 * Report whether an array-to-slice conversion applies for a slice target.
 *
 * @param self Backend state to inspect.
 * @param expr_id Source expression.
 * @param expected Expected destination type.
 * @return `true` when `expected` is a slice and the source is an array.
 */
func be_needs_array_to_slice(self: Backend*, expr_id: ExprId, expected: Type*) -> bool {
    if (ord(expected.kind) != ord(TY_SLICE)) {
        return false;
    }
    with (let natural_ty = be_expr_type(self, expr_id) => type_free_opt(natural_ty)) {
        return natural_ty != null && ord((natural_ty as Type*).kind) == ord(TY_ARRAY);
    }
}

/**
 * Emit one expression with implicit conversion to an expected type.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to lower.
 * @param expected Expected destination type.
 * @return Lowered expression string.
 */
func be_emit_expr_with_expected_type(self: Backend*, expr_id: ExprId, expected: Type*) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_NULL)) {
        return cem_emit_null_literal(expected, false);
    }
    let literal_id = be_unwrap_paren_expr_id(self, expr_id);
    let literal_expr = expr_arena_get(be_current_expr_arena(self), literal_id);
    if (ord(literal_expr.kind) == ord(EX_ARRAY_LITERAL) && ord(expected.kind) == ord(TY_ARRAY)) {
        return be_emit_array_literal_value(self, literal_id, expected);
    }
    if (be_needs_array_to_slice(self, expr_id, expected)) {
        with (let array_ty = be_expr_type(self, expr_id) => type_free_opt(array_ty)) {
            return be_emit_array_to_slice(self, expr_id, array_ty as Type*, expected);
        }
    }

    with (let natural_ty = be_expr_type(self, expr_id) => type_free_opt(natural_ty)) {
        let c_expr = be_emit_expr(self, expr_id);
        return be_convert_expr_with_expected_type(c_expr, natural_ty, expected);
    }
}

/**
 * Emit one expression for a context that creates a new owner.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression to lower.
 * @param expected Expected destination type.
 * @return Lowered expression string, with retain-on-copy when required.
 */
func be_emit_owned_expr_with_expected_type(self: Backend*, expr_id: ExprId, expected: Type*) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_NULL)) {
        return be_emit_expr_with_expected_type(self, expr_id, expected);
    }
    let literal_id = be_unwrap_paren_expr_id(self, expr_id);
    let literal_expr = expr_arena_get(be_current_expr_arena(self), literal_id);
    if (ord(literal_expr.kind) == ord(EX_ARRAY_LITERAL) && ord(expected.kind) == ord(TY_ARRAY)) {
        return be_emit_array_literal_value(self, literal_id, expected);
    }
    if (be_needs_array_to_slice(self, expr_id, expected)) {
        with (let array_ty = be_expr_type(self, expr_id) => type_free_opt(array_ty)) {
            return be_emit_array_to_slice(self, expr_id, array_ty as Type*, expected);
        }
    }

    with (let natural_ty = be_expr_type(self, expr_id) => type_free_opt(natural_ty)) {
        let c_expr = be_emit_expr(self, expr_id);
        let place_like = be_is_place_expr(self, expr_id) || be_is_unwrap_cast_from_place(self, expr_id);
        if (natural_ty == null) {
            return be_convert_expr_with_expected_type(c_expr, natural_ty, expected);
        }
        return be_convert_owned_c_expr_with_expected_type(self, c_expr, natural_ty as Type*, expected, place_like);
    }
}

/**
 * Free an optional cloned type.
 *
 * @param ty Optional type to free.
 */
func type_free_opt(ty: Type*?) {
    if (ty != null) {
        type_free(ty as Type*);
    }
}

/**
 * Collect visible nominal types referenced by one semantic type.
 *
 * Non-target private source types are deliberately excluded: they are not
 * part of the consumer's ABI surface and must not leak into module output.
 *
 * @param self Backend state to inspect.
 * @param ty Semantic type to traverse.
 * @param out Required nominal-type keys to update.
 */
func be_collect_referenced_type_keys(self: Backend*, ty: Type*, out: StringSet*) {
    if (ord(ty.kind) == ord(TY_STRUCT) || ord(ty.kind) == ord(TY_ENUM)) {
        if (self.target_module == null || ty.module_name == (self.target_module as string) ||
            be_is_symbol_exported(self, ty.module_name, ty.name)) {
            ss_add(out, be_type_key(ty.module_name, ty.name));
        }
        return;
    }
    if (ord(ty.kind) == ord(TY_POINTER) || ord(ty.kind) == ord(TY_NULLABLE) ||
        ord(ty.kind) == ord(TY_ARRAY) || ord(ty.kind) == ord(TY_SLICE)) {
        be_collect_referenced_type_keys(self, ty.inner as Type*, out);
        return;
    }
    if (ord(ty.kind) != ord(TY_FUNC)) {
        return;
    }
    let params = ty.params as VectorBase*;
    for (let i = 0; i < vec_size(params); i = i + 1) {
        be_collect_referenced_type_keys(self, ptr_vec_get(params, i) as Type*, out);
    }
    be_collect_referenced_type_keys(self, ty.result as Type*, out);
}

/**
 * Resolve one target-owned parsed type reference into required nominal keys.
 *
 * @param self Backend state to inspect.
 * @param module_name Module owning the parsed reference.
 * @param tref Parsed type reference, or `null`.
 * @param out Required nominal-type keys to update.
 */
func be_collect_type_ref_keys(self: Backend*, module_name: string, tref: TypeRef*?, out: StringSet*) {
    if (tref == null || self.result.signatures == null || self.result.names == null) {
        return;
    }
    let env = nr_env_find(self.result.names as NameResolution*, module_name);
    if (env == null) {
        return;
    }
    with (let seen = ss_create() => ss_free(seen),
          let ty: Type*? = tr_resolve_type_ref(
              self.result.signatures as SignatureTables*,
              self.result.names as NameResolution*,
              self.result.driver_state,
              env as ModuleEnv*,
              tref as TypeRef*,
              self.result.diags,
              seen
          ) => type_free_opt(ty)) {
        if (ty != null) {
            be_collect_referenced_type_keys(self, ty as Type*, out);
        }
    }
}

/**
 * Collect nominal references from target-owned parsed annotations.
 *
 * @param self Backend state to inspect.
 * @param root Selected source module.
 * @param out Required nominal-type keys to update.
 */
func be_collect_target_ast_type_keys(self: Backend*, root: Module*, out: StringSet*) {
    for (let decl_i = 0; decl_i < vec_size(root.decls); decl_i = decl_i + 1) {
        let top = ptr_vec_get(root.decls, decl_i) as TopLevelDecl*;
        match (top.kind) {
            TD_FUNC => {
                let fd = top.data as FuncDecl*;
                for (let p = 0; p < vec_size(fd.params); p = p + 1) {
                    be_collect_type_ref_keys(self, root.name, (ptr_vec_get(fd.params, p) as Param*).type_ref, out);
                }
                be_collect_type_ref_keys(self, root.name, fd.return_type, out);
            }
            TD_STRUCT => {
                let sd = top.data as StructDecl*;
                for (let f = 0; f < vec_size(sd.fields); f = f + 1) {
                    be_collect_type_ref_keys(self, root.name,
                        (ptr_vec_get(sd.fields, f) as FieldDecl*).type_ref, out);
                }
            }
            TD_ENUM => {
                let ed = top.data as EnumDecl*;
                for (let v = 0; v < vec_size(ed.variants); v = v + 1) {
                    let variant = ptr_vec_get(ed.variants, v) as EnumVariant*;
                    for (let ef = 0; ef < vec_size(variant.fields); ef = ef + 1) {
                        be_collect_type_ref_keys(self, root.name,
                            (ptr_vec_get(variant.fields, ef) as FieldDecl*).type_ref, out);
                    }
                }
            }
            TD_TYPE_ALIAS => {
                be_collect_type_ref_keys(self, root.name, (top.data as TypeAliasDecl*).target, out);
            }
            TD_LET => {
                be_collect_type_ref_keys(self, root.name, (top.data as LetDecl*).type_ref, out);
            }
        }
    }

    let unit = be_find_unit(self, root.name);
    if (unit == null) {
        return;
    }
    let stmts = (unit as DriverUnit*).parse_result.stmt_arena.nodes;
    for (let stmt_i = 0; stmt_i < vec_size(stmts); stmt_i = stmt_i + 1) {
        be_collect_type_ref_keys(self, root.name, (ptr_vec_get(stmts, stmt_i) as StmtNode*).type_ref, out);
    }
    let exprs = (unit as DriverUnit*).parse_result.expr_arena.nodes;
    for (let expr_i = 0; expr_i < vec_size(exprs); expr_i = expr_i + 1) {
        be_collect_type_ref_keys(self, root.name, (ptr_vec_get(exprs, expr_i) as ExprNode*).type_ref, out);
    }
}

/**
 * Compute the nominal type surface required by one module translation unit.
 *
 * The set includes all target-owned nominal definitions, visible nominal
 * references from target code and consumed value signatures, and the
 * transitive field/payload closure of selected transparent layouts.
 *
 * @param self Backend state to inspect.
 * @param root Selected source module.
 * @return New owned set of required `module::type` keys.
 */
func be_collect_required_type_keys(self: Backend*, root: Module*) -> StringSet* {
    let required = ss_create();
    if (self.result.signatures == null) {
        return required;
    }
    let tables = self.result.signatures as SignatureTables*;

    for (let struct_i = 0; struct_i < spm_capacity(tables.struct_infos); struct_i = struct_i + 1) {
        if (spm_slot_occupied(tables.struct_infos, struct_i)) {
            let info = spm_slot_value(tables.struct_infos, struct_i) as StructInfo*;
            if (info.module_name == root.name) {
                ss_add(required, info.key);
            }
        }
    }
    for (let enum_i = 0; enum_i < spm_capacity(tables.enum_infos); enum_i = enum_i + 1) {
        if (spm_slot_occupied(tables.enum_infos, enum_i)) {
            let info2 = spm_slot_value(tables.enum_infos, enum_i) as EnumInfo*;
            if (info2.module_name == root.name) {
                ss_add(required, info2.key);
            }
        }
    }

    for (let func_i = 0; func_i < spm_capacity(tables.func_types); func_i = func_i + 1) {
        if (spm_slot_occupied(tables.func_types, func_i) &&
            be_target_includes_value_key(self, spm_slot_key(tables.func_types, func_i))) {
            be_collect_referenced_type_keys(self, spm_slot_value(tables.func_types, func_i) as Type*, required);
        }
    }
    for (let let_i = 0; let_i < spm_capacity(tables.let_types); let_i = let_i + 1) {
        if (spm_slot_occupied(tables.let_types, let_i) &&
            be_target_includes_value_key(self, spm_slot_key(tables.let_types, let_i))) {
            be_collect_referenced_type_keys(self, spm_slot_value(tables.let_types, let_i) as Type*, required);
        }
    }
    for (let expr_i = 0; expr_i < spm_capacity(self.result.expr_types); expr_i = expr_i + 1) {
        if (spm_slot_occupied(self.result.expr_types, expr_i) &&
            starts_with_s(spm_slot_key(self.result.expr_types, expr_i), root.name + "::")) {
            be_collect_referenced_type_keys(self, spm_slot_value(self.result.expr_types, expr_i) as Type*, required);
        }
    }
    for (let intrinsic_i = 0; intrinsic_i < spm_capacity(self.result.intrinsic_targets); intrinsic_i = intrinsic_i + 1) {
        if (spm_slot_occupied(self.result.intrinsic_targets, intrinsic_i) &&
            starts_with_s(spm_slot_key(self.result.intrinsic_targets, intrinsic_i), root.name + "::")) {
            be_collect_referenced_type_keys(
                self,
                spm_slot_value(self.result.intrinsic_targets, intrinsic_i) as Type*,
                required
            );
        }
    }
    be_collect_target_ast_type_keys(self, root, required);

    let previous_size = -1;
    while (previous_size != ss_size(required)) {
        previous_size = ss_size(required);
        for (let struct_i2 = 0; struct_i2 < spm_capacity(tables.struct_infos); struct_i2 = struct_i2 + 1) {
            if (!spm_slot_occupied(tables.struct_infos, struct_i2)) {
                continue;
            }
            let info3 = spm_slot_value(tables.struct_infos, struct_i2) as StructInfo*;
            if (!ss_has(required, info3.key) || (info3.module_name != root.name && info3.is_opaque)) {
                continue;
            }
            for (let field_i = 0; field_i < vec_size(info3.fields); field_i = field_i + 1) {
                be_collect_referenced_type_keys(
                    self,
                    (ptr_vec_get(info3.fields, field_i) as StructFieldInfo*).field_type,
                    required
                );
            }
        }
        for (let enum_i2 = 0; enum_i2 < spm_capacity(tables.enum_infos); enum_i2 = enum_i2 + 1) {
            if (!spm_slot_occupied(tables.enum_infos, enum_i2)) {
                continue;
            }
            let info4 = spm_slot_value(tables.enum_infos, enum_i2) as EnumInfo*;
            if (!ss_has(required, info4.key) || (info4.module_name != root.name && info4.is_opaque)) {
                continue;
            }
            for (let variant_i = 0; variant_i < vec_size(info4.variants); variant_i = variant_i + 1) {
                let variant = ptr_vec_get(info4.variants, variant_i) as EnumVariantInfo*;
                for (let field_i2 = 0; field_i2 < vec_size(variant.field_types); field_i2 = field_i2 + 1) {
                    be_collect_referenced_type_keys(
                        self,
                        ptr_vec_get(variant.field_types, field_i2) as Type*,
                        required
                    );
                }
            }
        }
    }
    return required;
}

/**
 * Return whether one nominal type belongs to the selected module surface.
 *
 * @param self Backend state to inspect.
 * @param module_name Defining module name.
 * @param type_name Nominal type name.
 * @return `true` for whole-program output or a required module-output type.
 */
func be_requires_type(self: Backend*, module_name: string, type_name: string) -> bool {
    return !be_is_module_output(self) ||
        (self.required_type_keys != null &&
         ss_has(self.required_type_keys as StringSet*, be_type_key(module_name, type_name)));
}

/**
 * Add value-type dependencies for one field type.
 *
 * @param ty Type to inspect.
 * @param deps Dependency set to update.
 */
func be_collect_value_type_dependencies(ty: Type*, deps: StringSet*) {
    if (ord(ty.kind) == ord(TY_POINTER)) {
        return;
    }
    if (ord(ty.kind) == ord(TY_ARRAY)) {
        be_collect_value_type_dependencies(ty.inner as Type*, deps);
        return;
    }
    if (ord(ty.kind) == ord(TY_NULLABLE)) {
        let inner = ty.inner as Type*;
        if (ord(inner.kind) == ord(TY_POINTER)) {
            return;
        }
        be_collect_value_type_dependencies(inner, deps);
        return;
    }
    if (ord(ty.kind) == ord(TY_STRUCT) || ord(ty.kind) == ord(TY_ENUM)) {
        ss_add(deps, be_type_key(ty.module_name, ty.name));
        return;
    }
}

/**
 * Collect the value-type dependencies for one user-defined type.
 *
 * @param self Backend state to inspect.
 * @param type_key Type key to inspect.
 * @param deps Destination set to populate.
 * @return `true` when the type metadata was found.
 */
func be_collect_type_dependencies(self: Backend*, type_key: string, deps: StringSet*) -> bool {
    if (self.result.signatures == null) {
        return true;
    }

    let module_name = be_type_key_module(type_key);
    let type_name = be_type_key_name(type_key);
    if (is_empty_s(module_name) || is_empty_s(type_name)) {
        return false;
    }

    let struct_info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, module_name, type_name);
    if (struct_info != null) {
        let info = struct_info as StructInfo*;
        for (let i = 0; i < vec_size(info.fields); i = i + 1) {
            let field = ptr_vec_get(info.fields, i) as StructFieldInfo*;
            be_collect_value_type_dependencies(field.field_type, deps);
        }
        return true;
    }

    let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, module_name, type_name);
    if (enum_info == null) {
        return false;
    }

    let info2 = enum_info as EnumInfo*;
    for (let i = 0; i < vec_size(info2.variants); i = i + 1) {
        let variant = ptr_vec_get(info2.variants, i) as EnumVariantInfo*;
        for (let j = 0; j < vec_size(variant.field_types); j = j + 1) {
            be_collect_value_type_dependencies(ptr_vec_get(variant.field_types, j) as Type*, deps);
        }
    }
    return true;
}

/**
 * Free a vector of dependency sets.
 *
 * @param sets Optional vector holding `StringSet*` entries.
 */
func be_dependency_sets_free(sets: VectorBase*?) {
    if (sets == null) {
        return;
    }

    let dep_sets = sets as VectorBase*;
    for (let i = 0; i < vec_size(dep_sets); i = i + 1) {
        ss_free(ptr_vec_get(dep_sets, i) as StringSet*);
    }
    vec_free(dep_sets);
}

/**
 * Return whether an ordered type-key vector contains one key.
 *
 * @param keys Type-key vector to inspect.
 * @param key Type key to find.
 * @return `true` when `key` is present.
 */
func be_type_keys_contains(keys: StringVector*, key: string) -> bool {
    for (let i = 0; i < sv_size(keys); i = i + 1) {
        if (sv_get(keys, i) == key) {
            return true;
        }
    }
    return false;
}

/**
 * Collect all user-defined types in stable source order.
 *
 * @param self Backend state to inspect.
 * @return Ordered vector of type keys.
 */
func be_collect_type_keys(self: Backend*) -> StringVector* {
    let out = sv_create(8);

    with (let seen = ss_create() => ss_free(seen)) {
        for (let enum_unit_i = 0; enum_unit_i < driver_unit_count(self.result.driver_state); enum_unit_i = enum_unit_i + 1) {
            let unit = driver_unit_get(self.result.driver_state, enum_unit_i);
            if (unit.parse_result.root_module == null) {
                continue;
            }

            let root = unit.parse_result.root_module as Module*;
            for (let j = 0; j < vec_size(root.decls); j = j + 1) {
                let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
                if (ord(top.kind) == ord(TD_STRUCT)) {
                    let decl = top.data as StructDecl*;
                    let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, root.name, decl.name);
                    if (!be_requires_type(self, root.name, decl.name) ||
                        (be_is_module_output(self) && !be_emits_module_definitions(self, root.name) &&
                         (!be_is_symbol_exported(self, root.name, decl.name) ||
                          (info != null && (info as StructInfo*).is_opaque)))) {
                        continue;
                    }
                    be_push_type_key(out, seen, be_type_key(root.name, decl.name));
                }
            }
        }

        for (let iface_struct_i = 0; iface_struct_i < driver_interface_count(self.result.driver_state); iface_struct_i = iface_struct_i + 1) {
            let mi = driver_interface_get(self.result.driver_state, iface_struct_i);
            for (let j2 = 0; j2 < vec_size(mi.struct_infos); j2 = j2 + 1) {
                let info = ptr_vec_get(mi.struct_infos, j2) as StructInfo*;
                if (be_requires_type(self, info.module_name, info.name) && !info.is_opaque) {
                    be_push_type_key(out, seen, be_type_key(info.module_name, info.name));
                }
            }
        }

        for (let i = 0; i < driver_unit_count(self.result.driver_state); i = i + 1) {
            let unit = driver_unit_get(self.result.driver_state, i);
            if (unit.parse_result.root_module == null) {
                continue;
            }

            let root = unit.parse_result.root_module as Module*;
            for (let j = 0; j < vec_size(root.decls); j = j + 1) {
                let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
                if (ord(top.kind) == ord(TD_ENUM)) {
                    let decl2 = top.data as EnumDecl*;
                    let info3 = sig_lookup_enum_info(self.result.signatures as SignatureTables*, root.name, decl2.name);
                    if (!be_requires_type(self, root.name, decl2.name) ||
                        (be_is_module_output(self) && !be_emits_module_definitions(self, root.name) &&
                         (!be_is_symbol_exported(self, root.name, decl2.name) ||
                          (info3 != null && (info3 as EnumInfo*).is_opaque)))) {
                        continue;
                    }
                    be_push_type_key(out, seen, be_type_key(root.name, decl2.name));
                }
            }
        }

        for (let iface_enum_i = 0; iface_enum_i < driver_interface_count(self.result.driver_state); iface_enum_i = iface_enum_i + 1) {
            let mi2 = driver_interface_get(self.result.driver_state, iface_enum_i);
            for (let j3 = 0; j3 < vec_size(mi2.enum_infos); j3 = j3 + 1) {
                let info2 = ptr_vec_get(mi2.enum_infos, j3) as EnumInfo*;
                if (be_requires_type(self, info2.module_name, info2.name) && !info2.is_opaque) {
                    be_push_type_key(out, seen, be_type_key(info2.module_name, info2.name));
                }
            }
        }
    }
    return out;
}

/**
 * Emit user-defined types in dependency order.
 *
 * @param self Backend state to update.
 */
func be_emit_type_definitions(self: Backend*) {
    if (self.result.signatures == null) {
        return;
    }

    with (let keys = be_collect_type_keys(self) => sv_free(keys),
          let ordered = sv_create(sv_size(keys)) => sv_free(ordered),
          let queue = sv_create(sv_size(keys)) => sv_free(queue),
          let dep_sets: VectorBase*? = ptr_vec_create(sv_size(keys)) => be_dependency_sets_free(dep_sets),
          let in_degrees: VectorBase*? = id_vec_create(sv_size(keys)) => id_vec_free(in_degrees)) {
        cem_emit_section_comment(self.emitter, "Type definitions (dependency-ordered)");

        for (let i = 0; i < sv_size(keys); i = i + 1) {
            let key = sv_get(keys, i);
            let deps = ss_create();
            if (!be_collect_type_dependencies(self, key, deps)) {
                be_ice("[ICE-1341] missing dependency metadata for type key " + key);
            }
            ptr_vec_push(dep_sets as VectorBase*, deps as void*);

            let in_degree = 0;
            for (let j = 0; j < ss_capacity(deps); j = j + 1) {
                if (ss_slot_occupied(deps, j) && be_type_keys_contains(keys, ss_slot_key(deps, j))) {
                    in_degree = in_degree + 1;
                }
            }
            id_vec_push(in_degrees as VectorBase*, in_degree);
            if (in_degree == 0) {
                sv_push(queue, key);
            }
        }

        let queue_index = 0;
        while (queue_index < sv_size(queue)) {
            let emitted_key = sv_get(queue, queue_index);
            queue_index = queue_index + 1;
            sv_push(ordered, emitted_key);

            for (let i = 0; i < sv_size(keys); i = i + 1) {
                let degree_ptr = vec_get(in_degrees as VectorBase*, i) as int*;
                if (*degree_ptr <= 0) {
                    continue;
                }
                let deps2 = ptr_vec_get(dep_sets as VectorBase*, i) as StringSet*;
                if (!ss_has(deps2, emitted_key)) {
                    continue;
                }
                *degree_ptr = *degree_ptr - 1;
                if (*degree_ptr == 0) {
                    sv_push(queue, sv_get(keys, i));
                }
            }
        }

        if (sv_size(ordered) != sv_size(keys)) {
            be_ice("[ICE-1340] value-type cycle detected in type definitions");
        }

        for (let ordered_i = 0; ordered_i < sv_size(ordered); ordered_i = ordered_i + 1) {
            let key = sv_get(ordered, ordered_i);
            let module_name = be_type_key_module(key);
            let type_name = be_type_key_name(key);

            let struct_info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, module_name, type_name);
            if (struct_info != null) {
                self.current_module = module_name;
                cem_emit_struct_info(self.emitter, struct_info as StructInfo*);
                with (let emitted_ty = type_new_struct(module_name, type_name) => type_free(emitted_ty)) {
                    cem_emit_optional_wrapper_for_defined_type(self.emitter, emitted_ty);
                    cem_emit_array_wrappers_for_defined_type(self.emitter, emitted_ty);
                }
            } else {
                let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, module_name, type_name);
                if (enum_info == null) {
                    be_ice("[ICE-1050] missing EnumInfo for " + module_name + "." + type_name);
                }
                self.current_module = module_name;
                cem_emit_enum_info(self.emitter, enum_info as EnumInfo*);
                with (let emitted_ty2 = type_new_enum(module_name, type_name) => type_free(emitted_ty2)) {
                    cem_emit_optional_wrapper_for_defined_type(self.emitter, emitted_ty2);
                    cem_emit_array_wrappers_for_defined_type(self.emitter, emitted_ty2);
                }
            }
        }
    }
}

/**
 * Emit a `#line` directive for a declaration or statement when enabled.
 *
 * @param self Backend state to update.
 * @param span Source span to report.
 */
func be_emit_line_directive(self: Backend*, span: Span) {
    if (self.current_module == null) {
        return;
    }
    cem_emit_line_directive(self.emitter, span.start_line, self.current_module as string, self.opts);
}

/**
 * Try to emit a bare zero-field enum variant as a static initializer.
 *
 * @param self Backend state to inspect.
 * @param expr_id Var-ref expression id.
 * @param expected_type Resolved binding type.
 * @return Static enum initializer, or `null` when the expression is not eligible.
 */
func be_try_emit_bare_variant_static_initializer(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string? {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) != ord(EX_VAR_REF)) {
        return null;
    }
    if (ord(expected_type.kind) != ord(TY_ENUM)) {
        return null;
    }

    let sym = be_lookup_symbol(self, expr.text_value, expr.module_path, expr.name_qualifier);
    if (sym == null || ord((sym as Symbol*).kind) != ord(SYM_ENUM_VARIANT)) {
        return null;
    }

    let target = sym as Symbol*;
    if (target.module_name != expected_type.module_name || target.owner_name != expected_type.name) {
        return null;
    }

    let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, expected_type.module_name, expected_type.name);
    if (enum_info == null) {
        return be_ice_string("[ICE-1050] missing EnumInfo for bare variant static initializer");
    }

    let variant_info = cem_find_enum_variant_info(enum_info as EnumInfo*, target.name);
    if (variant_info == null) {
        return be_ice_string("[ICE-1051] missing VariantInfo for bare variant static initializer");
    }
    if (vec_size((variant_info as EnumVariantInfo*).field_types) != 0) {
        return null;
    }

    with (let payload_inits = sv_create(0) => sv_free(payload_inits)) {
        return cem_emit_variant_static_initializer_for_type(expected_type, target.name, payload_inits);
    }
}

/**
 * Evaluate one scalar constant expression in the current module.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to evaluate.
 * @return Owned evaluated value, or `null` when evaluation is unsupported.
 */
func be_eval_const_value(self: Backend*, expr_id: ExprId) -> ConstValue*? {
    if (self.current_env == null || self.result.signatures == null || self.result.names == null) {
        return null;
    }

    let value: ConstValue*? = null;
    with (let ctx = tr_const_eval_context_create(self.result.driver_state,
          self.result.signatures as SignatureTables*, self.result.names as NameResolution*, self.result.diags) =>
          tr_const_eval_context_free(ctx)) {
        value = tr_const_eval_expr(ctx, self.current_env as ModuleEnv*, expr_id);
    }
    return value;
}

/**
 * Emit a numeric-family scalar constant as a C literal.
 *
 * @param value Evaluated constant value.
 * @param expected_type Resolved binding type, used for bigint typing.
 * @return C literal text, or `null` for non-numeric kinds (`bool`, `string`, `null`).
 */
func be_emit_const_scalar_numeric(value: ConstValue*, expected_type: Type*) -> string? {
    match (value.kind) {
        CV_INT => { return cem_emit_int_literal(value.int_value); }
        CV_OTHER_INT => { return cem_emit_int_literal(value.int_value); }
        CV_BIGINT => { return cem_emit_typed_bigint_literal(value.text_value, value.base_value, expected_type); }
        CV_BYTE => { return cem_emit_byte_literal(value.int_value as byte); }
        CV_FLOAT => { return cem_emit_real_literal(value.text_value); }
        CV_DOUBLE => { return cem_emit_real_literal(value.text_value); }
        _ => { return null; }
    }
}

/**
 * Try to evaluate and emit a scalar constant as a static initializer.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to evaluate.
 * @param expected_type Resolved binding type.
 * @return Static scalar initializer, or `null` when evaluation is unsupported.
 */
func be_try_emit_evaluated_const_initializer(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string? {
    let value = be_eval_const_value(self, expr_id);
    if (value == null) {
        return null;
    }

    let evaluated = value as ConstValue*;
    let result = be_emit_const_scalar_numeric(evaluated, expected_type);
    if (result == null) {
        match (evaluated.kind) {
            CV_BOOL => { result = cem_emit_const_bool_literal(evaluated.bool_value); }
            CV_STRING => { result = cem_emit_const_string_literal(evaluated.text_value); }
            CV_NULL => { result = cem_emit_null_literal(expected_type, true); }
            _ => {}
        }
    }
    tr_const_value_free(evaluated);
    return result;
}

/**
 * Try to emit a constant initializer for a top-level `let`.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to lower.
 * @param expected_type Resolved `let` type.
 * @return Constant initializer expression, or `null` when runtime init is required.
 */
func be_try_emit_let_initializer(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string? {
    let bigint_init = be_emit_typed_bigint_expr(self, expr_id, expected_type);
    if (bigint_init != null) {
        return bigint_init;
    }
    let literal_id = be_unwrap_paren_expr_id(self, expr_id);
    let literal_expr = expr_arena_get(be_current_expr_arena(self), literal_id);
    if (ord(literal_expr.kind) == ord(EX_ARRAY_LITERAL) && ord(expected_type.kind) == ord(TY_ARRAY)) {
        return be_emit_array_literal_static_initializer(self, literal_id, expected_type);
    }
    let evaluated = be_try_emit_evaluated_const_initializer(self, literal_id, expected_type);
    if (evaluated != null) {
        return evaluated as string;
    }
    let expr = literal_expr;
    match (expr.kind) {
        EX_INT => { return cem_emit_int_literal(expr.int_value); }
        EX_BIGINT => { return cem_emit_typed_bigint_literal(expr.text_value, expr.base_value, expected_type); }
        EX_FLOAT => { return cem_emit_real_literal(expr.text_value); }
        EX_DOUBLE => { return cem_emit_real_literal(expr.text_value); }
        EX_BYTE => { return cem_emit_byte_literal(expr.int_value as byte); }
        EX_BOOL => { return cem_emit_const_bool_literal(expr.bool_value); }
        EX_STRING => { return cem_emit_const_string_literal(expr.text_value); }
        EX_NULL => { return cem_emit_null_literal(expected_type, true); }
        EX_VAR_REF => {
            let variant_init = be_try_emit_bare_variant_static_initializer(self, literal_id, expected_type);
            if (variant_init != null) {
                return variant_init;
            }
            return null;
        }
        EX_ARRAY_LITERAL => {
            if (ord(expected_type.kind) == ord(TY_ARRAY)) {
                return be_emit_array_literal_static_initializer(self, literal_id, expected_type);
            }
            return null;
        }
        EX_CALL => { return be_try_emit_const_constructor(self, literal_id, expected_type); }
        EX_CAST => { return be_try_emit_evaluated_const_initializer(self, literal_id, expected_type); }
        _ => {
            return null;
        }
    }
}

/**
 * Emit a constant initializer for a top-level `let`.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to lower.
 * @param expected_type Resolved `let` type.
 * @return Constant initializer expression.
 */
func be_emit_let_initializer(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string {
    let c_init = be_try_emit_let_initializer(self, expr_id, expected_type);
    if (c_init == null) {
        return be_ice_string("[ICE-1181] unsupported top-level let initializer");
    }
    return c_init as string;
}

/**
 * Try to emit a constant constructor initializer for a top-level `let`.
 *
 * @param self Backend state to inspect.
 * @param expr_id Call expression id.
 * @param expected_type Expected constructed type.
 * @return Constant initializer expression, or `null` when runtime init is required.
 */
func be_try_emit_const_constructor(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string? {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) != ord(EX_CALL)) {
        return null;
    }
    let call = expr;
    let callee = expr_arena_get(be_current_expr_arena(self), call.expr_a);
    if (ord(callee.kind) != ord(EX_VAR_REF)) {
        return null;
    }

    let sym = be_lookup_symbol(self, callee.text_value, callee.module_path, callee.name_qualifier);
    if (sym == null) {
        return be_ice_string("[ICE-1031] unknown constant constructor name");
    }

    if (ord(expected_type.kind) == ord(TY_STRUCT) &&
        (ord((sym as Symbol*).kind) == ord(SYM_STRUCT) || ord((sym as Symbol*).kind) == ord(SYM_TYPE_ALIAS))) {
        let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, expected_type.module_name, expected_type.name);
        if (info == null) {
            return be_ice_string("[ICE-1040] missing StructInfo for constant constructor");
        }
        with (let field_inits = sv_create(8) => sv_free(field_inits)) {
            let struct_info = info as StructInfo*;
            for (let i = 0; i < vec_size(struct_info.fields); i = i + 1) {
                let field = ptr_vec_get(struct_info.fields, i) as StructFieldInfo*;
                sv_push(field_inits, field.name);
                let field_init = be_try_emit_let_initializer(self, id_vec_get(call.ids as VectorBase*, i), field.field_type)?;
                sv_push(field_inits, field_init);
            }
            return cem_emit_struct_static_initializer_for_type(expected_type, field_inits);
        }
    }

    if (ord((sym as Symbol*).kind) == ord(SYM_ENUM_VARIANT)) {
        if (ord(expected_type.kind) != ord(TY_ENUM)) {
            return be_ice_string("[ICE-1033] enum variant constructor expected enum type");
        }
        let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, expected_type.module_name, expected_type.name);
        if (enum_info == null) {
            return be_ice_string("[ICE-1050] missing EnumInfo for constant constructor");
        }
        let variant_name = (sym as Symbol*).name;
        let variant_info = cem_find_enum_variant_info(enum_info as EnumInfo*, variant_name);
        if (variant_info == null) {
            return be_ice_string("[ICE-1051] missing VariantInfo for constant constructor");
        }
        with (let payload_inits = sv_create(8) => sv_free(payload_inits)) {
            let info2 = variant_info as EnumVariantInfo*;
            for (let i = 0; i < vec_size(info2.field_types); i = i + 1) {
                sv_push(payload_inits, sv_get(info2.field_names, i));
                let payload_init = be_try_emit_let_initializer(self, id_vec_get(call.ids as VectorBase*, i),
                    ptr_vec_get(info2.field_types, i) as Type*)?;
                sv_push(payload_inits, payload_init);
            }
            return cem_emit_variant_static_initializer_for_type(expected_type, variant_name, payload_inits);
        }
    }

    return null;
}

/**
 * Emit a constant constructor initializer for a top-level `let`.
 *
 * @param self Backend state to inspect.
 * @param expr_id Call expression id.
 * @param expected_type Expected constructed type.
 * @return Constant initializer expression.
 */
func be_emit_const_constructor(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string {
    let c_init = be_try_emit_const_constructor(self, expr_id, expected_type);
    if (c_init == null) {
        return be_ice_string("[ICE-1034] call expression is not a supported constant constructor");
    }
    return c_init as string;
}

/**
 * Emit all top-level `let` declarations.
 *
 * @param self Backend state to update.
 */
func be_emit_let_declarations(self: Backend*) {
    if (self.result.signatures == null) {
        return;
    }

    let any_bindings = false;
    for (let unit_i = 0; unit_i < driver_unit_count(self.result.driver_state); unit_i = unit_i + 1) {
        let unit = driver_unit_get(self.result.driver_state, unit_i);
        if (unit.parse_result.root_module == null) {
            continue;
        }
        let root = unit.parse_result.root_module as Module*;
        for (let j = 0; j < vec_size(root.decls); j = j + 1) {
            let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
            if (ord(top.kind) == ord(TD_LET) &&
                (be_emits_module_definitions(self, root.name) ||
                 be_target_consumes_symbol(self, root.name, (top.data as LetDecl*).name))) {
                any_bindings = true;
                break;
            }
        }
    }
    for (let iface_i = 0; iface_i < driver_interface_count(self.result.driver_state); iface_i = iface_i + 1) {
        let mi = driver_interface_get(self.result.driver_state, iface_i);
        for (let let_i = 0; let_i < vec_size(mi.let_entries); let_i = let_i + 1) {
            let entry = ptr_vec_get(mi.let_entries, let_i) as InterfaceLetEntry*;
            if (!be_is_module_output(self) || be_target_consumes_symbol(self, mi.module_name, entry.name)) {
                any_bindings = true;
                break;
            }
        }
        if (any_bindings) {
            break;
        }
    }
    if (!any_bindings) {
        return;
    }

    cem_emit_section_comment(self.emitter, "Top-level bindings");
    for (let i = 0; i < driver_unit_count(self.result.driver_state); i = i + 1) {
        let unit = driver_unit_get(self.result.driver_state, i);
        if (unit.parse_result.root_module == null) {
            continue;
        }

        let root = unit.parse_result.root_module as Module*;
        let emit_definitions = be_emits_module_definitions(self, root.name);
        if (emit_definitions) {
            self.current_module = root.name;
            self.current_unit = unit;
            self.current_env = be_find_env(self, root.name);
        }

        let module_has_bindings = false;
        for (let j = 0; j < vec_size(root.decls); j = j + 1) {
            let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
            if (ord(top.kind) != ord(TD_LET)) {
                continue;
            }

            let decl = top.data as LetDecl*;
            if (!emit_definitions && !be_target_consumes_symbol(self, root.name, decl.name)) {
                continue;
            }
            if (!module_has_bindings) {
                cem_emit_module_comment(self.emitter, root.name);
                module_has_bindings = true;
            }

            let let_type = sig_lookup_let_type(self.result.signatures as SignatureTables*, root.name, decl.name);
            if (let_type == null) {
                be_ice("[ICE-1151] missing Let type for " + root.name + "." + decl.name);
            }
            if (!emit_definitions) {
                cem_emit_external_let_declaration(self.emitter, root.name, decl.name, let_type as Type*, decl.is_const);
                continue;
            }
            let c_init = be_try_emit_let_initializer(self, decl.value, let_type as Type*);
            if (c_init != null) {
                cem_emit_let_declaration(self.emitter, root.name, decl, let_type as Type*, c_init as string,
                    be_is_symbol_exported(self, root.name, decl.name));
            } else {
                if (decl.is_const) {
                    be_ice("[ICE-1181] unsupported top-level let initializer");
                }
                cem_emit_zero_initialized_let_declaration(self.emitter, root.name, decl, let_type as Type*,
                    be_is_symbol_exported(self, root.name, decl.name));
            }
        }
    }

    for (let iface_i2 = 0; iface_i2 < driver_interface_count(self.result.driver_state); iface_i2 = iface_i2 + 1) {
        let mi2 = driver_interface_get(self.result.driver_state, iface_i2);
        let module_has_bindings2 = false;
        for (let let_i = 0; let_i < vec_size(mi2.let_entries); let_i = let_i + 1) {
            let entry2 = ptr_vec_get(mi2.let_entries, let_i) as InterfaceLetEntry*;
            if (be_is_module_output(self) && !be_target_consumes_symbol(self, mi2.module_name, entry2.name)) {
                continue;
            }
            if (!module_has_bindings2) {
                cem_emit_module_comment(self.emitter, mi2.module_name);
                module_has_bindings2 = true;
            }
            cem_emit_interface_let_declaration(self.emitter, mi2.module_name, entry2);
        }
    }
}

/**
 * Return whether one module needs a deferred top-level init function.
 *
 * @param self Backend state to inspect.
 * @param root Parsed module to inspect.
 * @return `true` if at least one top-level `let` needs runtime initialization.
 */
func be_module_has_deferred_let_initializers(self: Backend*, root: Module*) -> bool {
    let prev_module = self.current_module;
    let prev_unit = self.current_unit;
    let prev_env = self.current_env;
    self.current_module = root.name;
    self.current_unit = be_find_unit(self, root.name);
    self.current_env = be_find_env(self, root.name);
    if (self.current_unit == null) {
        be_ice("[ICE-1362] missing unit for deferred-init scan: " + root.name);
    }

    for (let i = 0; i < vec_size(root.decls); i = i + 1) {
        let top = ptr_vec_get(root.decls, i) as TopLevelDecl*;
        if (ord(top.kind) != ord(TD_LET)) {
            continue;
        }
        let decl = top.data as LetDecl*;
        if (decl.is_const) {
            continue;
        }
        let let_type = sig_lookup_let_type(self.result.signatures as SignatureTables*, root.name, decl.name);
        if (let_type == null) {
            be_ice("[ICE-1151] missing Let type for " + root.name + "." + decl.name);
        }
        let c_init = be_try_emit_let_initializer(self, decl.value, let_type as Type*);
        if (c_init == null) {
            self.current_module = prev_module;
            self.current_unit = prev_unit;
            self.current_env = prev_env;
            return true;
        }
    }
    self.current_module = prev_module;
    self.current_unit = prev_unit;
    self.current_env = prev_env;
    return false;
}

/**
 * Emit one deferred top-level `let` assignment inside a module init function.
 *
 * @param self Backend state to update.
 * @param module_name Defining module name.
 * @param decl Binding declaration node.
 * @param let_type Resolved binding type.
 */
func be_emit_deferred_top_level_let_assignment(self: Backend*, module_name: string, decl: LetDecl*, let_type: Type*) {
    let c_name = cem_mangle_let_name(module_name, decl.name);
    be_emit_line_directive(self, decl.span);
    let c_value = be_emit_owned_expr_with_expected_type(self, decl.value, let_type);
    if (analysis_has_arc_data(self.result, let_type)) {
        let temp = cem_fresh_tmp(self.emitter, "tmp");
        cem_emit_temp_decl(self.emitter, cem_emit_type(let_type), temp, c_value);
        be_emit_value_cleanup(self, c_name, let_type);
        cem_emit_assignment(self.emitter, c_name, temp);
    } else {
        cem_emit_assignment(self.emitter, c_name, c_value);
    }
}

/**
 * Emit a post-order dependency walk for module init sequencing.
 *
 * @param self Backend state to inspect.
 * @param module_name Module to visit.
 * @param visited Set of already visited module names.
 * @param ordered Destination vector in init-call order.
 */
func be_collect_module_init_order_visit(self: Backend*, module_name: string, visited: StringVector*, ordered: StringVector*) {
    if (dr_sv_has(visited, module_name)) {
        return;
    }
    sv_push(visited, module_name);
    let unit = be_find_unit(self, module_name);
    if (unit == null || (unit as DriverUnit*).parse_result.root_module == null) {
        return;
    }
    let root = ((unit as DriverUnit*).parse_result.root_module as Module*);
    for (let i = 0; i < vec_size(root.imports); i = i + 1) {
        let imp = ptr_vec_get(root.imports, i) as Import*;
        be_collect_module_init_order_visit(self, imp.name, visited, ordered);
    }
    sv_push(ordered, module_name);
}

/**
 * Collect module names in deterministic top-level init order.
 *
 * @param self Backend state to inspect.
 * @return New vector of module names in dependency/source order.
 */
func be_collect_module_init_order(self: Backend*) -> StringVector* {
    let ordered = sv_create(driver_unit_count(self.result.driver_state));
    with (let visited = sv_create(driver_unit_count(self.result.driver_state)) => sv_free(visited)) {
        if (!is_empty_s(self.result.driver_state.entry_module)) {
            be_collect_module_init_order_visit(self, self.result.driver_state.entry_module, visited, ordered);
        } else {
            for (let i = 0; i < driver_unit_count(self.result.driver_state); i = i + 1) {
                let unit = driver_unit_get(self.result.driver_state, i);
                if (unit.parse_result.root_module == null) {
                    continue;
                }
                be_collect_module_init_order_visit(self, (unit.parse_result.root_module as Module*).name, visited, ordered);
            }
        }
    }
    return ordered;
}

/**
 * Emit one hidden module init function when a module has deferred top-level lets.
 *
 * @param self Backend state to update.
 * @param root Parsed module to inspect.
 * @return `true` if a function was emitted.
 */
func be_emit_module_init_function(self: Backend*, root: Module*) -> bool {
    if (!be_module_has_deferred_let_initializers(self, root)) {
        return false;
    }

    self.current_module = root.name;
    self.current_unit = be_find_unit(self, root.name);
    self.current_env = be_find_env(self, root.name);
    cem_emit_module_comment(self.emitter, root.name);
    cem_emit_hidden_void_function_header(self.emitter, cem_mangle_module_init_name(root.name));
    for (let i = 0; i < vec_size(root.decls); i = i + 1) {
        let top = ptr_vec_get(root.decls, i) as TopLevelDecl*;
        if (ord(top.kind) != ord(TD_LET)) {
            continue;
        }
        let decl = top.data as LetDecl*;
        if (decl.is_const) {
            continue;
        }
        let let_type = sig_lookup_let_type(self.result.signatures as SignatureTables*, root.name, decl.name);
        if (let_type == null) {
            be_ice("[ICE-1151] missing Let type for " + root.name + "." + decl.name);
        }
        let c_init = be_try_emit_let_initializer(self, decl.value, let_type as Type*);
        if (c_init != null) {
            continue;
        }
        be_emit_deferred_top_level_let_assignment(self, root.name, decl, let_type as Type*);
    }
    cem_emit_function_definition_footer(self.emitter);
    return true;
}

/**
 * Emit hidden module/global init functions for deferred top-level `let` initializers.
 *
 * @param self Backend state to update.
 * @return `true` if a global init chain was emitted.
 */
func be_emit_top_level_init_functions(self: Backend*) -> bool {
    if (self.result.signatures == null) {
        return false;
    }

    with (let ordered = be_collect_module_init_order(self) => sv_free(ordered),
          let deferred = sv_create(sv_size(ordered)) => sv_free(deferred)) {
        for (let i = 0; i < sv_size(ordered); i = i + 1) {
            let module_name = sv_get(ordered, i);
            let unit = be_find_unit(self, module_name);
            if (unit == null || (unit as DriverUnit*).parse_result.root_module == null) {
                continue;
            }
            let root = ((unit as DriverUnit*).parse_result.root_module as Module*);
            if (be_module_has_deferred_let_initializers(self, root)) {
                sv_push(deferred, module_name);
            }
        }

        if (sv_size(deferred) == 0) {
            return false;
        }

        cem_emit_section_comment(self.emitter, "Top-level init functions");
        for (let deferred_i = 0; deferred_i < sv_size(deferred); deferred_i = deferred_i + 1) {
            let module_name = sv_get(deferred, deferred_i);
            let unit = be_find_unit(self, module_name);
            if (unit == null || (unit as DriverUnit*).parse_result.root_module == null) {
                continue;
            }
            let root = ((unit as DriverUnit*).parse_result.root_module as Module*);
            if (!be_emit_module_init_function(self, root)) {
                be_ice("[ICE-1361] deferred init module disappeared: " + module_name);
            }
        }

        cem_emit_hidden_void_function_header(self.emitter, cem_global_init_name());
        for (let call_i = 0; call_i < sv_size(deferred); call_i = call_i + 1) {
            ccb_emit(self.emitter.out, cem_mangle_module_init_name(sv_get(deferred, call_i)) + "(" + ");");
        }
        cem_emit_function_definition_footer(self.emitter);
        return true;
    }
}

/**
 * Emit one module's always-present external lifecycle pair.
 *
 * `I4init` performs only this module's deferred binding initialization and
 * `I4fini` performs only this module's ARC-managed top-level cleanup.
 *
 * @param self Backend state to update.
 * @param root Selected source module.
 */
func be_emit_module_lifecycle_functions(self: Backend*, root: Module*) {
    if (self.result.signatures == null) {
        return;
    }

    self.current_module = root.name;
    self.current_unit = be_find_unit(self, root.name);
    self.current_env = be_find_env(self, root.name);
    if (self.current_unit == null) {
        be_ice("[ICE-1362] missing unit for module lifecycle emission: " + root.name);
    }

    cem_emit_section_comment(self.emitter, "Module lifecycle functions");
    cem_emit_module_comment(self.emitter, root.name);
    cem_emit_external_void_function_header(self.emitter, cem_mangle_module_init_name(root.name));
    cem_emit_module_metadata_anchors(self.emitter, root.name);
    for (let i = 0; i < vec_size(root.decls); i = i + 1) {
        let top = ptr_vec_get(root.decls, i) as TopLevelDecl*;
        if (ord(top.kind) != ord(TD_LET)) {
            continue;
        }
        let decl = top.data as LetDecl*;
        if (decl.is_const) {
            continue;
        }
        let let_type = sig_lookup_let_type(self.result.signatures as SignatureTables*, root.name, decl.name);
        if (let_type == null) {
            be_ice("[ICE-1151] missing Let type for " + root.name + "." + decl.name);
        }
        let c_init = be_try_emit_let_initializer(self, decl.value, let_type as Type*);
        if (c_init == null) {
            be_emit_deferred_top_level_let_assignment(self, root.name, decl, let_type as Type*);
        }
    }
    cem_emit_function_definition_footer(self.emitter);

    cem_emit_external_void_function_header(self.emitter, cem_mangle_module_fini_name(root.name));
    cem_emit_module_top_level_let_cleanup(self.emitter, root.name);
    cem_emit_function_definition_footer(self.emitter);
}

/**
 * Emit all function declarations.
 *
 * @param self Backend state to update.
 */
func be_emit_function_declarations(self: Backend*) {
    if (self.result.signatures == null) {
        return;
    }

    cem_emit_section_comment(self.emitter, "Function declarations");
    for (let i = 0; i < driver_unit_count(self.result.driver_state); i = i + 1) {
        let unit = driver_unit_get(self.result.driver_state, i);
        if (unit.parse_result.root_module == null) {
            continue;
        }

        let root = unit.parse_result.root_module as Module*;
        let emit_definitions = be_emits_module_definitions(self, root.name);
        let module_has_functions = false;
        if (!be_is_module_output(self)) {
            cem_emit_module_comment(self.emitter, root.name);
            module_has_functions = true;
        }
        for (let j = 0; j < vec_size(root.decls); j = j + 1) {
            let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
            if (ord(top.kind) != ord(TD_FUNC)) {
                continue;
            }
            let decl = top.data as FuncDecl*;
            if (!emit_definitions && !be_target_consumes_symbol(self, root.name, decl.name)) {
                continue;
            }
            if (!module_has_functions) {
                cem_emit_module_comment(self.emitter, root.name);
                module_has_functions = true;
            }
            let func_type = sig_lookup_func_type(self.result.signatures as SignatureTables*, root.name, decl.name);
            if (func_type == null) {
                be_ice("[ICE-1150] missing FuncType for " + root.name + "." + decl.name);
            }
            cem_emit_function_declaration(self.emitter, root.name, decl, func_type as Type*,
                !emit_definitions || be_is_symbol_exported(self, root.name, decl.name));
        }
    }

    for (let iface_i = 0; iface_i < driver_interface_count(self.result.driver_state); iface_i = iface_i + 1) {
        let mi = driver_interface_get(self.result.driver_state, iface_i);
        let module_has_functions2 = false;
        for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
            let entry = ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*;
            if (be_is_module_output(self) && !be_target_consumes_symbol(self, mi.module_name, entry.name)) {
                continue;
            }
            if (!module_has_functions2) {
                cem_emit_module_comment(self.emitter, mi.module_name);
                module_has_functions2 = true;
            }
            cem_emit_interface_function_declaration(self.emitter, mi.module_name, entry);
        }
    }
}

/**
 * Emit one local or module lvalue.
 *
 * @param self Backend state to inspect.
 * @param expr_id Target expression id.
 * @return Lowered lvalue expression.
 */
func be_emit_lvalue(self: Backend*, expr_id: ExprId) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    match (expr.kind) {
        EX_UNARY => {
            if (expr.text_value == "*" && be_has_side_effects(self, expr.expr_a)) {
                with (let ptr_ty = be_expr_type(self, expr.expr_a) => type_free_opt(ptr_ty)) {
                    if (ptr_ty == null) {
                        return be_ice_string("[ICE-1242] missing type for dereference operand");
                    }
                    let ptr_temp = cem_fresh_tmp(self.emitter, "ptr");
                    let c_ptr_expr = be_emit_expr(self, expr.expr_a);
                    cem_emit_temp_decl(self.emitter, cem_emit_type(ptr_ty as Type*), ptr_temp, c_ptr_expr);
                    return cem_emit_deref_lvalue(be_emit_checked_pointer_expr(self, ptr_temp, ptr_ty as Type*, "_RT_ACCESS_WRITE"));
                }
            }
            if (expr.text_value == "*") {
                with (let ptr_ty2 = be_expr_type(self, expr.expr_a) => type_free_opt(ptr_ty2)) {
                    if (ptr_ty2 == null) {
                        return be_ice_string("[ICE-1242] missing type for dereference operand");
                    }
                    return cem_emit_deref_lvalue(
                        be_emit_checked_pointer_expr(self, be_emit_expr(self, expr.expr_a), ptr_ty2 as Type*, "_RT_ACCESS_WRITE")
                    );
                }
            }
        }
        EX_FIELD => {
            with (let obj_ty = be_expr_type(self, expr.expr_a) => type_free_opt(obj_ty)) {
                if (obj_ty == null) {
                    return be_ice_string("[ICE-1243] missing type for field access object");
                }
                let obj_ptr_ty = be_pointer_type_or_null(obj_ty as Type*);
                if (obj_ptr_ty == null && be_is_place_expr(self, expr.expr_a)) {
                    // The store lands inside the object's own storage, so the
                    // object must be emitted as an lvalue: inner pointer
                    // accesses keep write mode and no struct temp copy is
                    // introduced.
                    return cem_emit_field_lvalue(be_emit_lvalue(self, expr.expr_a), expr.text_value, false);
                }
                if (be_has_side_effects(self, expr.expr_a)) {
                    let obj_temp = cem_fresh_tmp(self.emitter, "obj");
                    let c_obj_expr = be_emit_expr(self, expr.expr_a);
                    cem_emit_temp_decl(self.emitter, cem_emit_type(obj_ty as Type*), obj_temp, c_obj_expr);
                    if (obj_ptr_ty != null) {
                        return cem_emit_field_lvalue(
                            be_emit_checked_pointer_expr(self, obj_temp, obj_ptr_ty as Type*, "_RT_ACCESS_WRITE"),
                            expr.text_value,
                            true
                        );
                    }
                    return cem_emit_field_lvalue(obj_temp, expr.text_value, false);
                }
                let c_obj_expr = be_emit_expr(self, expr.expr_a);
                if (obj_ptr_ty != null) {
                    c_obj_expr = be_emit_checked_pointer_expr(self, c_obj_expr, obj_ptr_ty as Type*, "_RT_ACCESS_WRITE");
                    return cem_emit_field_lvalue(c_obj_expr, expr.text_value, true);
                }
                return cem_emit_field_lvalue(c_obj_expr, expr.text_value, false);
            }
        }
        EX_INDEX => {
            let base_has_effects = be_has_side_effects(self, expr.expr_a);
            let index_has_effects = be_has_side_effects(self, expr.expr_b);
            with (let base_ty_for_index = be_expr_type(self, expr.expr_a) => type_free_opt(base_ty_for_index)) {
                if (base_ty_for_index == null) {
                    return be_ice_string("[ICE-1244] missing type for index base");
                }
                let final_base = be_emit_expr(self, expr.expr_a);
                let final_index = be_emit_expr(self, expr.expr_b);

                let raw_array_base = false;
                let base_expr = expr_arena_get(be_current_expr_arena(self), expr.expr_a);
                if (ord(base_expr.kind) == ord(EX_INDEX)) {
                    with (let nested_base_ty = be_expr_type(self, base_expr.expr_a) => type_free_opt(nested_base_ty)) {
                        raw_array_base = nested_base_ty != null &&
                            ord((nested_base_ty as Type*).kind) == ord(TY_ARRAY);
                    }
                }

                if (base_has_effects && !raw_array_base) {
                    let base_temp = cem_fresh_tmp(self.emitter, "base");
                    cem_emit_temp_decl(self.emitter, cem_emit_type(base_ty_for_index as Type*), base_temp, final_base);
                    final_base = base_temp;
                }

                if (index_has_effects) {
                    let idx_temp = cem_fresh_tmp(self.emitter, "idx");
                    cem_emit_temp_decl(self.emitter, "dea_int", idx_temp, final_index);
                    final_index = idx_temp;
                }

                return be_emit_checked_index_lvalue(self, final_base, final_index, base_ty_for_index as Type*, raw_array_base, "_RT_ACCESS_WRITE");
            }
        }
        EX_PAREN => {
            return be_emit_lvalue(self, expr.expr_a);
        }
        _ => {}
    }
    return be_emit_expr(self, expr_id);
}

/**
 * Emit one binary operation.
 *
 * @param self Backend state to inspect.
 * @param expr_id Binary expression id.
 * @return Lowered binary expression.
 */
func be_emit_binary_op(self: Backend*, expr_id: ExprId) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    let left = expr_arena_get(be_current_expr_arena(self), expr.expr_a);
    let right = expr_arena_get(be_current_expr_arena(self), expr.expr_b);

    if (expr.text_value == "&&" || expr.text_value == "||") {
        return be_emit_condition_value(self, expr_id);
    }

    if ((expr.text_value == "==" || expr.text_value == "!=") &&
        (ord(left.kind) == ord(EX_NULL) || ord(right.kind) == ord(EX_NULL))) {
        let other_id = expr.expr_a;
        if (ord(left.kind) == ord(EX_NULL)) {
            other_id = expr.expr_b;
        }

        with (let other_ty = be_expr_type(self, other_id) => type_free_opt(other_ty)) {
            let c_other = be_emit_expr(self, other_id);
            if (other_ty != null && ord((other_ty as Type*).kind) == ord(TY_NULLABLE) &&
                !cem_is_niche_nullable(other_ty as Type*)) {
                if (expr.text_value == "==") {
                    return cem_emit_null_check_eq(c_other);
                }
                return cem_emit_null_check_ne(c_other);
            }
            return cem_emit_pointer_null_check(c_other, expr.text_value);
        }
    }

    with (let left_ty = be_expr_type(self, expr.expr_a) => type_free_opt(left_ty),
          let right_ty = be_expr_type(self, expr.expr_b) => type_free_opt(right_ty),
          let result_ty = be_expr_type(self, expr_id) => type_free_opt(result_ty),
          let common_int_ty: Type*? = null => type_free_opt(common_int_ty)) {
        if ((expr.text_value == "+" || expr.text_value == "-" || expr.text_value == "*" ||
             expr.text_value == "/" || expr.text_value == "%" || expr.text_value == "&" ||
             expr.text_value == "|" || expr.text_value == "^" || expr.text_value == "<<" ||
             expr.text_value == ">>") &&
            result_ty != null && be_is_int_assignable(result_ty as Type*)) {
            common_int_ty = type_clone(result_ty as Type*);
        } else if ((expr.text_value == "==" || expr.text_value == "!=" || expr.text_value == "<" ||
                    expr.text_value == "<=" || expr.text_value == ">" || expr.text_value == ">=") &&
            left_ty != null && right_ty != null) {
            common_int_ty = be_common_int_type(left_ty as Type*, right_ty as Type*);
        }

        let c_left = be_emit_expr(self, expr.expr_a);
        let c_right = be_emit_expr(self, expr.expr_b);

        if ((expr.text_value == "==" || expr.text_value == "!=") &&
            left_ty != null && right_ty != null &&
            ord((left_ty as Type*).kind) == ord(TY_NULLABLE) &&
            ord((right_ty as Type*).kind) == ord(TY_NULLABLE)) {
            let l_ty = left_ty as Type*;
            if (!cem_is_niche_nullable(l_ty)) {
                return cem_emit_opt_equals_call(expr.text_value, c_left, c_right, l_ty.inner as Type*);
            }
        }

        if (common_int_ty != null) {
            if (left_ty != null) {
                c_left = be_convert_expr_with_expected_type(c_left, left_ty as Type*, common_int_ty as Type*);
            }
            if (right_ty != null) {
                c_right = be_convert_expr_with_expected_type(c_right, right_ty as Type*, common_int_ty as Type*);
            }
        }
        if ((expr.text_value == "==" || expr.text_value == "!=") &&
            left_ty != null && right_ty != null &&
            type_is_builtin(left_ty as Type*, "string") && type_is_builtin(right_ty as Type*, "string")) {
            if (be_should_materialize_arc_temp(self, expr.expr_a, left_ty as Type*)) {
                c_left = be_materialize_arc_temp(self, c_left, left_ty as Type*);
            }
            if (be_should_materialize_arc_temp(self, expr.expr_b, right_ty as Type*)) {
                c_right = be_materialize_arc_temp(self, c_right, right_ty as Type*);
            }
            let c_cmp = cem_emit_string_equals_call(c_left, c_right);
            if (expr.text_value == "!=") {
                return cem_emit_unary_op("!", c_cmp);
            }
            return c_cmp;
        }
        if ((expr.text_value == "<" || expr.text_value == "<=" ||
                expr.text_value == ">" || expr.text_value == ">=") &&
            left_ty != null && right_ty != null &&
            type_is_builtin(left_ty as Type*, "string") && type_is_builtin(right_ty as Type*, "string")) {
            if (be_should_materialize_arc_temp(self, expr.expr_a, left_ty as Type*)) {
                c_left = be_materialize_arc_temp(self, c_left, left_ty as Type*);
            }
            if (be_should_materialize_arc_temp(self, expr.expr_b, right_ty as Type*)) {
                c_right = be_materialize_arc_temp(self, c_right, right_ty as Type*);
            }
            return cem_emit_string_compare_call(expr.text_value, c_left, c_right);
        }

        // string + string -> string (concatenation via runtime helper)
        if (expr.text_value == "+" &&
            left_ty != null && right_ty != null &&
            type_is_builtin(left_ty as Type*, "string") && type_is_builtin(right_ty as Type*, "string")) {
            if (be_should_materialize_arc_temp(self, expr.expr_a, left_ty as Type*)) {
                c_left = be_materialize_arc_temp(self, c_left, left_ty as Type*);
            }
            if (be_should_materialize_arc_temp(self, expr.expr_b, right_ty as Type*)) {
                c_right = be_materialize_arc_temp(self, c_right, right_ty as Type*);
            }
            return be_emit_direct_function_call(self, "rt_string_concat", c_left + ", " + c_right);
        }

        let checked_int_op = left_ty != null && right_ty != null &&
            be_is_int_assignable(left_ty as Type*) && be_is_int_assignable(right_ty as Type*);
        if (expr.text_value == "/") {
            if (checked_int_op) {
                if (common_int_ty != null) {
                    return cem_emit_checked_int_div_for_type(common_int_ty as Type*, c_left, c_right);
                }
                return cem_emit_checked_int_div(c_left, c_right);
            }
            return cem_emit_binary_op(expr.text_value, c_left, c_right);
        }
        if (expr.text_value == "%") {
            if (checked_int_op) {
                if (common_int_ty != null) {
                    return cem_emit_checked_int_mod_for_type(common_int_ty as Type*, c_left, c_right);
                }
                return cem_emit_checked_int_mod(c_left, c_right);
            }
            return cem_emit_binary_op(expr.text_value, c_left, c_right);
        }
        if (expr.text_value == "*") {
            if (checked_int_op) {
                if (common_int_ty != null) {
                    return cem_emit_checked_int_mul_for_type(common_int_ty as Type*, c_left, c_right);
                }
                return cem_emit_checked_int_mul(c_left, c_right);
            }
            return cem_emit_binary_op(expr.text_value, c_left, c_right);
        }
        if (expr.text_value == "+") {
            if (checked_int_op) {
                if (common_int_ty != null) {
                    return cem_emit_checked_int_add_for_type(common_int_ty as Type*, c_left, c_right);
                }
                return cem_emit_checked_int_add(c_left, c_right);
            }
            return cem_emit_binary_op(expr.text_value, c_left, c_right);
        }
        if (expr.text_value == "-") {
            if (checked_int_op) {
                if (common_int_ty != null) {
                    return cem_emit_checked_int_sub_for_type(common_int_ty as Type*, c_left, c_right);
                }
                return cem_emit_checked_int_sub(c_left, c_right);
            }
            return cem_emit_binary_op(expr.text_value, c_left, c_right);
        }
        return cem_emit_binary_op(expr.text_value, c_left, c_right);
    }
}

/**
 * Emit one top-level condition expression for direct statement headers.
 *
 * Only the outermost condition operator is unwrapped; child expressions keep
 * the normal expression emitter so precedence-preserving inner parentheses stay
 * intact.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to lower.
 * @return Lowered condition expression.
 */
func be_emit_condition_expr(self: Backend*, expr_id: ExprId) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_PAREN)) {
        return be_emit_condition_expr(self, expr.expr_a);
    }
    if (ord(expr.kind) != ord(EX_BINARY)) {
        return be_emit_expr(self, expr_id);
    }
    let left = expr_arena_get(be_current_expr_arena(self), expr.expr_a);
    let right = expr_arena_get(be_current_expr_arena(self), expr.expr_b);

    if ((expr.text_value == "==" || expr.text_value == "!=") &&
        (ord(left.kind) == ord(EX_NULL) || ord(right.kind) == ord(EX_NULL))) {
        let other_id = expr.expr_a;
        if (ord(left.kind) == ord(EX_NULL)) {
            other_id = expr.expr_b;
        }

        with (let other_ty = be_expr_type(self, other_id) => type_free_opt(other_ty)) {
            let c_other = be_emit_expr(self, other_id);
            if (other_ty != null && ord((other_ty as Type*).kind) == ord(TY_NULLABLE) &&
                !cem_is_niche_nullable(other_ty as Type*)) {
                if (expr.text_value == "==") {
                    return cem_emit_null_check_eq(c_other);
                }
                return cem_emit_null_check_ne(c_other);
            }
            return cem_emit_condition_pointer_null_check(c_other, expr.text_value);
        }
    }

    with (let left_ty = be_expr_type(self, expr.expr_a) => type_free_opt(left_ty),
          let right_ty = be_expr_type(self, expr.expr_b) => type_free_opt(right_ty),
          let common_int_ty: Type*? = null => type_free_opt(common_int_ty)) {
        if ((expr.text_value == "==" || expr.text_value == "!=" || expr.text_value == "<" ||
             expr.text_value == "<=" || expr.text_value == ">" || expr.text_value == ">=") &&
            left_ty != null && right_ty != null) {
            common_int_ty = be_common_int_type(left_ty as Type*, right_ty as Type*);
        }

        let c_left = be_emit_expr(self, expr.expr_a);
        let c_right = be_emit_expr(self, expr.expr_b);

        if (common_int_ty != null) {
            if (left_ty != null) {
                c_left = be_convert_expr_with_expected_type(c_left, left_ty as Type*, common_int_ty as Type*);
            }
            if (right_ty != null) {
                c_right = be_convert_expr_with_expected_type(c_right, right_ty as Type*, common_int_ty as Type*);
            }
        }
        if ((expr.text_value == "==" || expr.text_value == "!=") &&
            left_ty != null && right_ty != null &&
            ord((left_ty as Type*).kind) == ord(TY_NULLABLE) &&
            ord((right_ty as Type*).kind) == ord(TY_NULLABLE)) {
            let l_ty = left_ty as Type*;
            if (!cem_is_niche_nullable(l_ty)) {
                return cem_emit_opt_equals_call(expr.text_value, c_left, c_right, l_ty.inner as Type*);
            }
        }
        if ((expr.text_value == "==" || expr.text_value == "!=") &&
            left_ty != null && right_ty != null &&
            type_is_builtin(left_ty as Type*, "string") && type_is_builtin(right_ty as Type*, "string")) {
            if (be_should_materialize_arc_temp(self, expr.expr_a, left_ty as Type*)) {
                c_left = be_materialize_arc_temp(self, c_left, left_ty as Type*);
            }
            if (be_should_materialize_arc_temp(self, expr.expr_b, right_ty as Type*)) {
                c_right = be_materialize_arc_temp(self, c_right, right_ty as Type*);
            }
            let c_cmp = cem_emit_string_equals_call(c_left, c_right);
            if (expr.text_value == "!=") {
                return cem_emit_unary_op("!", c_cmp);
            }
            return c_cmp;
        }
        if ((expr.text_value == "<" || expr.text_value == "<=" ||
             expr.text_value == ">" || expr.text_value == ">=") &&
            left_ty != null && right_ty != null &&
            type_is_builtin(left_ty as Type*, "string") && type_is_builtin(right_ty as Type*, "string")) {
            if (be_should_materialize_arc_temp(self, expr.expr_a, left_ty as Type*)) {
                c_left = be_materialize_arc_temp(self, c_left, left_ty as Type*);
            }
            if (be_should_materialize_arc_temp(self, expr.expr_b, right_ty as Type*)) {
                c_right = be_materialize_arc_temp(self, c_right, right_ty as Type*);
            }
            return cem_emit_condition_string_compare_call(expr.text_value, c_left, c_right);
        }

        if (expr.text_value == "==" || expr.text_value == "!=" || expr.text_value == "<" ||
            expr.text_value == "<=" || expr.text_value == ">" || expr.text_value == ">=") {
            return cem_emit_condition_binary_op(expr.text_value, c_left, c_right);
        }
    }

    return be_emit_expr(self, expr_id);
}

/**
 * Emit one struct or enum-variant constructor.
 *
 * @param self Backend state to inspect.
 * @param expr_id Call expression id.
 * @param sym Resolved constructor symbol.
 * @param result_ty Inferred result type of the call.
 * @return Lowered constructor expression.
 */
func be_emit_constructor_call(self: Backend*, expr_id: ExprId, sym: Symbol*, result_ty: Type*) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(result_ty.kind) == ord(TY_STRUCT) &&
        (ord((sym as Symbol*).kind) == ord(SYM_STRUCT) || ord((sym as Symbol*).kind) == ord(SYM_TYPE_ALIAS))) {
        let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, result_ty.module_name, result_ty.name);
        if (info == null) {
            return be_ice_string("[ICE-1040] missing StructInfo for constructor");
        }
        with (let field_inits = sv_create(8) => sv_free(field_inits)) {
            let struct_info = info as StructInfo*;
            let arg_count = 0;
            if (expr.ids != null) arg_count = vec_size(expr.ids as VectorBase*);
            
            let expected_names: StringVector*? = null;
            let is_out_of_order = false;
            if (expr.arg_labels != null) {
                expected_names = sv_create(arg_count);
                for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                    sv_push(expected_names as StringVector*, (ptr_vec_get(struct_info.fields, p_idx) as StructFieldInfo*).name);
                }
                for (let k = 0; k < arg_count; k = k + 1) {
                    if (sv_get(expected_names as StringVector*, k) != sv_get(expr.arg_labels as StringVector*, k)) {
                        is_out_of_order = true;
                        break;
                    }
                }
            }

            with (let c_arg_tmps = sv_create(arg_count) => sv_free(c_arg_tmps)) {
                for (let i = 0; i < arg_count; i = i + 1) {
                    let arg_id = id_vec_get(expr.ids as VectorBase*, i);
                    let param_index = i;
                    if (expected_names != null) {
                        let label = sv_get(expr.arg_labels as StringVector*, i);
                        for (let j = 0; j < arg_count; j = j + 1) {
                            if (sv_get(expected_names as StringVector*, j) == label) {
                                param_index = j;
                                break;
                            }
                        }
                    }

                    let field = ptr_vec_get(struct_info.fields, param_index) as StructFieldInfo*;
                    let c_arg = be_emit_owned_expr_with_expected_type(self, arg_id, field.field_type);
                    c_arg = be_finalize_lowered_constructor_arg(self, c_arg, field.field_type, is_out_of_order);
                    sv_push(c_arg_tmps, c_arg);
                }

                for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                    let source_index = p_idx;
                    if (expected_names != null) {
                        let expected_label = sv_get(expected_names as StringVector*, p_idx);
                        for (let i = 0; i < arg_count; i = i + 1) {
                            if (sv_get(expr.arg_labels as StringVector*, i) == expected_label) {
                                source_index = i;
                                break;
                            }
                        }
                    }
                    let field = ptr_vec_get(struct_info.fields, p_idx) as StructFieldInfo*;
                    sv_push(field_inits, field.name);
                    sv_push(field_inits, sv_get(c_arg_tmps, source_index));
                }
            }
            if (expected_names != null) sv_free(expected_names as StringVector*);
            return cem_emit_struct_constructor_for_type(result_ty, field_inits);
        }
    }

    if (ord((sym as Symbol*).kind) == ord(SYM_ENUM_VARIANT)) {
        let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, result_ty.module_name, result_ty.name);
        if (enum_info == null) {
            return be_ice_string("[ICE-1050] missing EnumInfo for constructor");
        }
        let variant_name = sym.name;
        let variant_info = cem_find_enum_variant_info(enum_info as EnumInfo*, variant_name);
        if (variant_info == null) {
            return be_ice_string("[ICE-1051] missing VariantInfo for constructor");
        }
        with (let payload_inits = sv_create(8) => sv_free(payload_inits)) {
            let info2 = variant_info as EnumVariantInfo*;
            let arg_count = 0;
            if (expr.ids != null) arg_count = vec_size(expr.ids as VectorBase*);

            let expected_names: StringVector*? = null;
            let is_out_of_order = false;
            if (expr.arg_labels != null) {
                expected_names = sv_create(arg_count);
                for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                    sv_push(expected_names as StringVector*, sv_get(info2.field_names, p_idx));
                }
                for (let k = 0; k < arg_count; k = k + 1) {
                    if (sv_get(expected_names as StringVector*, k) != sv_get(expr.arg_labels as StringVector*, k)) {
                        is_out_of_order = true;
                        break;
                    }
                }
            }

            with (let c_arg_tmps = sv_create(arg_count) => sv_free(c_arg_tmps)) {
                for (let i = 0; i < arg_count; i = i + 1) {
                    let arg_id = id_vec_get(expr.ids as VectorBase*, i);
                    let param_index = i;
                    if (expected_names != null) {
                        let label = sv_get(expr.arg_labels as StringVector*, i);
                        for (let j = 0; j < arg_count; j = j + 1) {
                            if (sv_get(expected_names as StringVector*, j) == label) {
                                param_index = j;
                                break;
                            }
                        }
                    }

                    let field_ty = ptr_vec_get(info2.field_types, param_index) as Type*;
                    let c_arg = be_emit_owned_expr_with_expected_type(self, arg_id, field_ty);
                    c_arg = be_finalize_lowered_constructor_arg(self, c_arg, field_ty, is_out_of_order);
                    sv_push(c_arg_tmps, c_arg);
                }

                for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                    let source_index = p_idx;
                    if (expected_names != null) {
                        let expected_label = sv_get(expected_names as StringVector*, p_idx);
                        for (let i = 0; i < arg_count; i = i + 1) {
                            if (sv_get(expr.arg_labels as StringVector*, i) == expected_label) {
                                source_index = i;
                                break;
                            }
                        }
                    }
                    sv_push(payload_inits, sv_get(info2.field_names, p_idx));
                    sv_push(payload_inits, sv_get(c_arg_tmps, source_index));
                }
            }
            if (expected_names != null) sv_free(expected_names as StringVector*);
            return cem_emit_variant_constructor_for_type(result_ty, variant_name, payload_inits);
        }
    }

    return be_ice_string("[ICE-1100] unsupported constructor symbol");
}

/**
 * Emit one `is` intrinsic call.
 *
 * @param self Backend state to inspect.
 * @param expr Call expression node.
 * @return Lowered enum-tag comparison.
 */
func be_emit_is_intrinsic(self: Backend*, expr: ExprNode*) -> string {
    let args = expr.ids as VectorBase*;
    let value_id = id_vec_get(args, 0);
    let variant_expr = expr_arena_get(be_current_expr_arena(self), id_vec_get(args, 1));
    if (ord(variant_expr.kind) != ord(EX_VAR_REF)) {
        return be_ice_string("[ICE-2270] `is` variant argument must be a var-ref expression");
    }

    let variant_sym = be_lookup_symbol(self, variant_expr.text_value, variant_expr.module_path, variant_expr.name_qualifier);
    if (variant_sym == null || ord((variant_sym as Symbol*).kind) != ord(SYM_ENUM_VARIANT)) {
        return be_ice_string("[ICE-2271] `is` variant argument did not resolve to an enum variant");
    }

    with (let enum_ty = be_expr_type(self, value_id) => type_free_opt(enum_ty)) {
        if (enum_ty == null || ord((enum_ty as Type*).kind) != ord(TY_ENUM)) {
            return be_ice_string("[ICE-2272] `is` value argument is missing enum type information");
        }
        let variant = variant_sym as Symbol*;
        if (variant.module_name != (enum_ty as Type*).module_name || variant.owner_name != (enum_ty as Type*).name) {
            return be_ice_string("[ICE-2273] `is` variant argument does not belong to the enum value type");
        }
        return cem_emit_is(be_emit_expr(self, value_id), enum_ty as Type*, variant.name);
    }
}

/**
 * Emit one `slice` intrinsic call as a slice descriptor compound literal.
 *
 * Generated C evaluates the source, start, and count operands in argument order,
 * performs range checks via `_rt_panic_oob` before any pointer arithmetic, and
 * yields a descriptor whose `data` is `NULL` when the resulting length is zero.
 *
 * @param self Backend state to update.
 * @param expr Call expression node.
 * @param expr_id Call expression id.
 * @return Lowered slice descriptor expression.
 */
func be_emit_slice_descriptor(self: Backend*, expr: ExprNode*, expr_id: ExprId) -> string {
    let args = expr.ids as VectorBase*;
    let argc = vec_size(args);
    let src_id = id_vec_get(args, 0);

    let result_c = "";
    with (let result_ty = be_expr_type(self, expr_id) => type_free_opt(result_ty)) {
        if (result_ty == null || ord((result_ty as Type*).kind) != ord(TY_SLICE)) {
            return be_ice_string("[ICE-2272] missing slice result type");
        }
        result_c = cem_emit_type(result_ty as Type*);
    }

    with (let src_ty = be_expr_type(self, src_id) => type_free_opt(src_ty)) {
        if (src_ty == null) {
            return be_ice_string("[ICE-2273] missing slice source type");
        }
        let src_is_array = ord((src_ty as Type*).kind) == ord(TY_ARRAY);
        if (!src_is_array && ord((src_ty as Type*).kind) != ord(TY_SLICE)) {
            return be_ice_string("[ICE-2274] slice source is neither array nor slice");
        }
        let elem_c = cem_emit_type((src_ty as Type*).inner as Type*);

        let src_ref = be_emit_expr(self, src_id);
        if (be_has_side_effects(self, src_id)) {
            if (src_is_array) {
                src_ref = be_materialize_slice_array_temp(self, src_ref, src_id, src_ty as Type*, "slice_src");
            } else {
                let src_temp = cem_fresh_tmp(self.emitter, "slice_src");
                cem_emit_temp_decl(self.emitter, cem_emit_type(src_ty as Type*), src_temp, src_ref);
                src_ref = src_temp;
            }
        }

        let base_len = "(" + src_ref + ").len";
        if (src_is_array) {
            base_len = "((dea_int)" + int_to_string((src_ty as Type*).array_len) + ")";
        }
        let base_data = "(" + src_ref + ").data";

        let start_c = "((dea_int)0)";
        if (argc >= 2) {
            let start_temp = cem_fresh_tmp(self.emitter, "slice_start");
            cem_emit_temp_decl(self.emitter, "dea_int", start_temp, be_emit_expr(self, id_vec_get(args, 1)));
            start_c = start_temp;
        }
        let count_c = "";
        if (argc >= 3) {
            let count_temp = cem_fresh_tmp(self.emitter, "slice_count");
            cem_emit_temp_decl(self.emitter, "dea_int", count_temp, be_emit_expr(self, id_vec_get(args, 2)));
            count_c = count_temp;
        }

        let len_init = base_len;
        if (argc == 2) {
            ccb_emit(self.emitter.out, "if ((" + start_c + ") < 0 || (" + start_c + ") > " + base_len + ") {");
            ccb_indent(self.emitter.out);
            ccb_emit(self.emitter.out, "_rt_panic_oob(" + start_c + ", " + base_len + ");");
            ccb_dedent(self.emitter.out);
            ccb_emit(self.emitter.out, "}");
            len_init = "((" + base_len + ") - (" + start_c + "))";
        } else if (argc == 3) {
            let remaining_c = "((" + base_len + ") - (" + start_c + "))";
            ccb_emit(self.emitter.out, "if ((" + start_c + ") < 0 || (" + start_c + ") > " + base_len + ") {");
            ccb_indent(self.emitter.out);
            ccb_emit(self.emitter.out, "_rt_panic_oob(" + start_c + ", " + base_len + ");");
            ccb_dedent(self.emitter.out);
            ccb_emit(self.emitter.out, "}");
            ccb_emit(self.emitter.out, "if ((" + count_c + ") < 0 || (" + count_c + ") > " + remaining_c + ") {");
            ccb_indent(self.emitter.out);
            ccb_emit(self.emitter.out, "_rt_panic_oob(" + count_c + ", " + remaining_c + ");");
            ccb_dedent(self.emitter.out);
            ccb_emit(self.emitter.out, "}");
            len_init = count_c;
        }

        let len_temp = cem_fresh_tmp(self.emitter, "slice_len");
        cem_emit_temp_decl(self.emitter, "dea_int", len_temp, len_init);
        let data_c = "((" + len_temp + ") == 0 ? (" + elem_c + " *)0 : (" + base_data + ") + (" + start_c + "))";
        return "((" + result_c + "){ .len = " + len_temp + ", .data = " + data_c + " })";
    }
}

/**
 * Lower the complete argument list for a typed variadic call.
 *
 * Ordinary trailing values are copied into an owning fixed-array temporary and
 * exposed to the callee through the effective slice parameter. A final spread
 * argument already denotes the complete slice tail and is passed through.
 *
 * @param self Backend state to update.
 * @param expr Variadic call expression.
 * @param func_ty Resolved variadic function type.
 * @return Comma-separated lowered C arguments.
 */
func be_emit_variadic_call_args(self: Backend*, expr: ExprNode*, func_ty: Type*) -> string {
    let params = func_ty.params as VectorBase*;
    let fixed_count = vec_size(params) - 1;
    let slice_ty = ptr_vec_get(params, fixed_count) as Type*;
    let elem_ty = slice_ty.inner as Type*;
    let args = expr.ids as VectorBase*;
    let arg_count = vec_size(args);

    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < fixed_count; i = i + 1) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            let arg_id = id_vec_get(args, i);
            let expected = ptr_vec_get(params, i) as Type*;
            let c_arg = be_emit_expr_with_expected_type(self, arg_id, expected);
            c_arg = be_finalize_lowered_call_arg(self, arg_id, c_arg, expected, false);
            sb_append(sb, c_arg);
        }

        if (fixed_count > 0) {
            sb_append(sb, ", ");
        }

        if (expr.has_spread_arg) {
            let spread_id = id_vec_get(args, fixed_count);
            let spread_c = be_emit_expr_with_expected_type(self, spread_id, slice_ty);
            spread_c = be_finalize_lowered_call_arg(self, spread_id, spread_c, slice_ty, false);
            sb_append(sb, spread_c);
            return sb_to_string(sb);
        }

        let variadic_count = arg_count - fixed_count;
        if (variadic_count == 0) {
            sb_append(sb, "((" + cem_emit_type(slice_ty) + "){ .len = 0, .data = NULL })");
            return sb_to_string(sb);
        }

        with (let pack_ty = type_new_array(type_clone(elem_ty), variadic_count) => type_free(pack_ty),
              let init = sb_create() => sb_free(init)) {
            sb_append(init, "((" + cem_emit_type(pack_ty) + "){ .data = {");
            for (let j = 0; j < variadic_count; j = j + 1) {
                if (j > 0) {
                    sb_append(init, ", ");
                }
                let value_id = id_vec_get(args, fixed_count + j);
                sb_append(init, be_emit_owned_expr_with_expected_type(self, value_id, elem_ty));
            }
            sb_append(init, "} })");

            let pack_name = cem_fresh_tmp(self.emitter, "varargs");
            cem_emit_temp_decl(self.emitter, cem_emit_type(pack_ty), pack_name, sb_to_string(init));
            if (self.current_scope == null) {
                be_ice("[ICE-1313] variadic pack materialization requires an active scope");
            }
            if (analysis_has_arc_data(self.result, pack_ty)) {
                sc_add_owned(self.current_scope as ScopeContext*, pack_name, pack_ty);
            } else {
                sc_add_declared(self.current_scope as ScopeContext*, pack_name, pack_ty);
            }
            sb_append(sb, "((" + cem_emit_type(slice_ty) + "){ .len = ((dea_int)" +
                int_to_string(variadic_count) + "), .data = " + pack_name + ".data })");
            return sb_to_string(sb);
        }
    }
}

/**
 * Emit one call expression.
 *
 * @param self Backend state to inspect.
 * @param expr_id Call expression id.
 * @return Lowered call expression.
 */
func be_emit_call(self: Backend*, expr_id: ExprId) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    let callee = expr_arena_get(be_current_expr_arena(self), expr.expr_a);
    let callee_sym: Symbol*? = null;

    if (ord(callee.kind) == ord(EX_VAR_REF)) {
        callee_sym = be_lookup_symbol(self, callee.text_value, callee.module_path, callee.name_qualifier);

        if (dea_is_intrinsic_symbol(callee_sym, "sizeof") && expr.ids != null && vec_size(expr.ids as VectorBase*) == 1) {
            let arg = expr_arena_get(be_current_expr_arena(self), id_vec_get(expr.ids as VectorBase*, 0));
            if (ord(arg.kind) == ord(EX_TYPE) && arg.type_ref != null) {
                with (let target_ty = be_resolve_type_ref(self, arg.type_ref as TypeRef*) => type_free_opt(target_ty)) {
                    if (target_ty == null) {
                        return be_ice_string("[ICE-2268] failed to resolve sizeof target type");
                    }
                    return cem_emit_sizeof_type(target_ty as Type*);
                }
            }
            with (let target_ty2 = analysis_get_intrinsic_target(self.result, self.current_module as string, expr_id)
                    => type_free_opt(target_ty2)) {
                if (target_ty2 == null) {
                    return be_ice_string("[ICE-2268] failed to resolve sizeof target type");
                }
                return cem_emit_sizeof_type(target_ty2 as Type*);
            }
        }

        if (dea_is_intrinsic_symbol(callee_sym, "ord") && expr.ids != null && vec_size(expr.ids as VectorBase*) == 1) {
            return cem_emit_ord(be_emit_expr(self, id_vec_get(expr.ids as VectorBase*, 0)));
        }

        if (dea_is_intrinsic_symbol(callee_sym, "is") && expr.ids != null && vec_size(expr.ids as VectorBase*) == 2) {
            return be_emit_is_intrinsic(self, expr);
        }

        if (dea_is_intrinsic_symbol(callee_sym, "len") && expr.ids != null && vec_size(expr.ids as VectorBase*) == 1) {
            let len_arg_id = id_vec_get(expr.ids as VectorBase*, 0);
            with (let len_arg_ty = be_expr_type(self, len_arg_id) => type_free_opt(len_arg_ty)) {
                if (len_arg_ty == null) {
                    return be_ice_string("[ICE-2271] missing type for len argument");
                }
                if (ord((len_arg_ty as Type*).kind) == ord(TY_ARRAY)) {
                    return "((dea_int)" + int_to_string((len_arg_ty as Type*).array_len) + ")";
                }
                if (ord((len_arg_ty as Type*).kind) == ord(TY_SLICE)) {
                    return "(" + be_emit_expr(self, len_arg_id) + ").len";
                }
                if (type_is_builtin(len_arg_ty as Type*, "string")) {
                    let c_arg = be_emit_expr(self, len_arg_id);
                    if (be_should_materialize_arc_temp(self, len_arg_id, len_arg_ty as Type*)) {
                        c_arg = be_materialize_arc_temp(self, c_arg, len_arg_ty as Type*);
                    }
                    return be_emit_direct_function_call(self, "rt_strlen", c_arg);
                }
                return be_ice_string("[ICE-2271] len argument is neither array, slice, nor string");
            }
        }

        if (dea_is_intrinsic_symbol(callee_sym, "slice") && expr.ids != null &&
            vec_size(expr.ids as VectorBase*) >= 1 && vec_size(expr.ids as VectorBase*) <= 3) {
            return be_emit_slice_descriptor(self, expr, expr_id);
        }

        if (dea_is_symbol(callee_sym)) {
            return be_ice_string("[ICE-2269] intrinsic call escaped regular lowering");
        }

        if (callee_sym != null) {
            with (let result_ty = be_expr_type(self, expr_id) => type_free_opt(result_ty)) {
                if (result_ty != null && ((ord((callee_sym as Symbol*).kind) == ord(SYM_STRUCT)) ||
                    (ord((callee_sym as Symbol*).kind) == ord(SYM_TYPE_ALIAS) &&
                        ord((result_ty as Type*).kind) == ord(TY_STRUCT)) ||
                    ord((callee_sym as Symbol*).kind) == ord(SYM_ENUM_VARIANT))) {
                    return be_emit_constructor_call(self, expr_id, callee_sym as Symbol*, result_ty as Type*);
                }
            }

            if (ord((callee_sym as Symbol*).kind) == ord(SYM_FUNC)) {
                let func_ty = sig_lookup_func_type(self.result.signatures as SignatureTables*,
                    (callee_sym as Symbol*).module_name, (callee_sym as Symbol*).name);
                if (func_ty == null) {
                    return be_ice_string("[ICE-1150] missing FuncType for " + (callee_sym as Symbol*).module_name +
                        "." + (callee_sym as Symbol*).name);
                }
                let c_func_name = be_function_c_name(self, callee_sym as Symbol*, func_ty as Type*);

                if ((func_ty as Type*).is_variadic) {
                    return be_emit_direct_function_call(self, c_func_name,
                        be_emit_variadic_call_args(self, expr, func_ty as Type*));
                }

                with (let sb = sb_create() => sb_free(sb)) {
                    let arg_count = 0;
                    if (expr.ids != null) {
                        arg_count = vec_size(expr.ids as VectorBase*);
                    }
                    let expected_names: StringVector*? = null;
                    let is_out_of_order = false;
                    if (expr.arg_labels != null) {
                        expected_names = be_clone_function_param_names(self, callee_sym as Symbol*);
                        if (expected_names == null) {
                            return be_ice_string("[ICE-2270] regular function call is missing parameter names");
                        }
                        for (let k = 0; k < arg_count; k = k + 1) {
                            if (sv_get(expected_names as StringVector*, k) != sv_get(expr.arg_labels as StringVector*, k)) {
                                is_out_of_order = true;
                                break;
                            }
                        }
                    }

                    with (let c_arg_tmps = sv_create(arg_count) => sv_free(c_arg_tmps)) {
                        for (let i = 0; i < arg_count; i = i + 1) {
                            let arg_id = id_vec_get(expr.ids as VectorBase*, i);
                            
                            let param_index = i;
                            if (expected_names != null) {
                                let label = sv_get(expr.arg_labels as StringVector*, i);
                                for (let j = 0; j < arg_count; j = j + 1) {
                                    if (sv_get(expected_names as StringVector*, j) == label) {
                                        param_index = j;
                                        break;
                                    }
                                }
                            }

                            let param_ty: Type*? = null;
                            if (func_ty != null && vec_size((func_ty as Type*).params as VectorBase*) == arg_count) {
                                param_ty = ptr_vec_get((func_ty as Type*).params as VectorBase*, param_index) as Type*;
                            }

                            let c_arg = "";
                            if (param_ty != null) {
                                c_arg = be_emit_expr_with_expected_type(self, arg_id, param_ty as Type*);
                            } else {
                                c_arg = be_emit_expr(self, arg_id);
                            }

                            if (param_ty != null) {
                                c_arg = be_finalize_lowered_call_arg(self, arg_id, c_arg, param_ty as Type*,
                                    is_out_of_order);
                            } else {
                                with (let arg_ty = be_expr_type(self, arg_id) => type_free_opt(arg_ty)) {
                                    if (arg_ty != null) {
                                        c_arg = be_finalize_lowered_call_arg(self, arg_id, c_arg, arg_ty as Type*,
                                            is_out_of_order);
                                    }
                                }
                            }
                            sv_push(c_arg_tmps, c_arg);
                        }

                        for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                            if (p_idx > 0) sb_append(sb, ", ");
                            let source_index = p_idx;
                            if (expected_names != null) {
                                let expected_label = sv_get(expected_names as StringVector*, p_idx);
                                for (let i = 0; i < arg_count; i = i + 1) {
                                    if (sv_get(expr.arg_labels as StringVector*, i) == expected_label) {
                                        source_index = i;
                                        break;
                                    }
                                }
                            }
                            sb_append(sb, sv_get(c_arg_tmps, source_index));
                        }
                    }
                    if (expected_names != null) sv_free(expected_names as StringVector*);
                    return be_emit_direct_function_call(self, c_func_name, sb_to_string(sb));
                }
            }
        }
    }

    with (let sb2 = sb_create() => sb_free(sb2)) {
        with (let callee_ty = be_expr_type(self, expr.expr_a) => type_free_opt(callee_ty)) {
            if (callee_ty != null && ord((callee_ty as Type*).kind) == ord(TY_FUNC) &&
                (callee_ty as Type*).is_variadic) {
                sb_append(sb2, be_emit_variadic_call_args(self, expr, callee_ty as Type*));
            } else {
                let arg_count2 = 0;
                if (expr.ids != null) {
                    arg_count2 = vec_size(expr.ids as VectorBase*);
                }
                for (let i = 0; i < arg_count2; i = i + 1) {
                    if (i > 0) {
                        sb_append(sb2, ", ");
                    }
                    let arg_id2 = id_vec_get(expr.ids as VectorBase*, i);
                    let c_arg3 = be_emit_expr(self, arg_id2);
                    with (let arg_ty3 = be_expr_type(self, arg_id2) => type_free_opt(arg_ty3)) {
                        if (arg_ty3 != null && be_should_materialize_arc_temp(self, arg_id2, arg_ty3 as Type*)) {
                            c_arg3 = be_materialize_arc_temp(self, c_arg3, arg_ty3 as Type*);
                        }
                        sb_append(sb2, c_arg3);
                    }
                }
            }
            let c_callee = be_emit_expr(self, expr.expr_a);
            if (callee_ty != null && ord((callee_ty as Type*).kind) == ord(TY_FUNC)) {
                let callee_tmp = cem_fresh_tmp(self.emitter, "func");
                cem_emit_temp_decl(self.emitter, cem_emit_type(callee_ty as Type*), callee_tmp, c_callee);
                cem_emit_if_header(self.emitter, cem_emit_pointer_null_check(callee_tmp, "=="));
                cem_emit_block_start(self.emitter);
                cem_emit_expr_stmt(self.emitter, "_rt_panic(\"call through null function pointer\")");
                cem_emit_block_end(self.emitter);
                c_callee = callee_tmp;
            }
            return cem_emit_function_call(cem_emit_paren_expr(c_callee), sb_to_string(sb2));
        }
    }
}

/**
 * Pre-collect fixed-array wrappers needed only by ordinary variadic calls.
 *
 * @param self Backend state to inspect.
 */
func be_prepare_variadic_pack_wrappers(self: Backend*) {
    for (let unit_i = 0; unit_i < driver_unit_count(self.result.driver_state); unit_i = unit_i + 1) {
        let unit = driver_unit_get(self.result.driver_state, unit_i);
        if (unit.parse_result.root_module == null) {
            continue;
        }
        let root = unit.parse_result.root_module as Module*;
        if (!be_emits_module_definitions(self, root.name)) {
            continue;
        }
        self.current_module = root.name;
        self.current_unit = unit;
        self.current_env = be_find_env(self, root.name);
        let arena = unit.parse_result.expr_arena;
        for (let expr_i = 0; expr_i < vec_size(arena.nodes); expr_i = expr_i + 1) {
            let expr = expr_arena_get(arena, expr_i);
            if (ord(expr.kind) != ord(EX_CALL) || expr.has_spread_arg) {
                continue;
            }
            with (let callee_ty = be_expr_type(self, expr.expr_a) => type_free_opt(callee_ty)) {
                if (callee_ty == null || ord((callee_ty as Type*).kind) != ord(TY_FUNC) ||
                    !(callee_ty as Type*).is_variadic) {
                    continue;
                }
                let params = (callee_ty as Type*).params as VectorBase*;
                let fixed_count = vec_size(params) - 1;
                let arg_count = vec_size(expr.ids as VectorBase*);
                let variadic_count = arg_count - fixed_count;
                if (variadic_count <= 0) {
                    continue;
                }
                let slice_ty = ptr_vec_get(params, fixed_count) as Type*;
                with (let pack_ty = type_new_array(type_clone(slice_ty.inner as Type*), variadic_count) => type_free(pack_ty)) {
                    cem_collect_array_wrappers_from_type(self.emitter, pack_ty);
                    cem_collect_opt_wrappers_from_type(self.emitter, pack_ty);
                    cem_collect_func_ptrs_from_type(self.emitter, pack_ty);
                }
            }
        }
    }
}

/**
 * Emit one heap-allocation `new` expression.
 *
 * @param self Backend state to inspect.
 * @param expr_id New-expression id.
 * @return Lowered pointer expression.
 */
func be_emit_new_expr(self: Backend*, expr_id: ExprId) -> string {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    with (let new_ty = be_expr_type(self, expr_id) => type_free_opt(new_ty)) {
        if (new_ty == null || ord((new_ty as Type*).kind) != ord(TY_POINTER)) {
            return be_ice_string("[ICE-1200] missing inferred pointer type for new expression");
        }

        let base_ty = ((new_ty as Type*).inner as Type*);
        let c_base = cem_emit_type(base_ty);
        let c_ptr_ty = cem_emit_pointer_type(base_ty);
        let tmp = cem_fresh_tmp(self.emitter, "new");
        cem_emit_alloc_obj(self.emitter, c_ptr_ty, c_base, tmp);

        let arg_count = 0;
        if (expr.ids != null) {
            arg_count = vec_size(expr.ids as VectorBase*);
        }

        if (arg_count == 0 && ord(base_ty.kind) != ord(TY_ENUM)) {
            cem_emit_zero_init(self.emitter, tmp, c_base);
            return tmp;
        }

        if (ord(base_ty.kind) == ord(TY_ARRAY)) {
            if (arg_count == 0) {
                cem_emit_zero_init(self.emitter, tmp, c_base);
                return tmp;
            }
            let arg_id = id_vec_get(expr.ids as VectorBase*, 0);
            let literal_arg_id = be_unwrap_paren_expr_id(self, arg_id);
            let arg_expr = expr_arena_get(be_current_expr_arena(self), literal_arg_id);
            if (ord(arg_expr.kind) == ord(EX_ARRAY_LITERAL)) {
                with (let arg_ty = be_expr_type(self, literal_arg_id) => type_free_opt(arg_ty)) {
                    if (arg_ty != null && type_equals(arg_ty as Type*, base_ty.inner as Type*)) {
                        cem_emit_checked_pointer_assignment(self.emitter, tmp, c_base,
                            be_emit_array_fill_value(self, literal_arg_id, base_ty));
                        return tmp;
                    }
                }
                cem_emit_checked_pointer_assignment(self.emitter, tmp, c_base, be_emit_array_literal_value(self, literal_arg_id, base_ty));
                return tmp;
            }
            cem_emit_checked_pointer_assignment(self.emitter, tmp, c_base, be_emit_array_fill_value(self, arg_id, base_ty));
            return tmp;
        }

        if (ord(base_ty.kind) == ord(TY_STRUCT)) {
            let info = sig_lookup_struct_info(self.result.signatures as SignatureTables*, base_ty.module_name, base_ty.name);
            if (info == null) {
                return be_ice_string("[ICE-1210] missing StructInfo for " + base_ty.module_name + "." + base_ty.name);
            }
            with (let field_inits = sv_create(8) => sv_free(field_inits)) {
                let expected_names: StringVector*? = null;
                let is_out_of_order = false;
                if (expr.arg_labels != null) {
                    expected_names = sv_create(arg_count);
                    for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                        sv_push(expected_names as StringVector*, (ptr_vec_get((info as StructInfo*).fields, p_idx) as StructFieldInfo*).name);
                    }
                    for (let k = 0; k < arg_count; k = k + 1) {
                        if (sv_get(expected_names as StringVector*, k) != sv_get(expr.arg_labels as StringVector*, k)) {
                            is_out_of_order = true;
                            break;
                        }
                    }
                }

                with (let c_arg_tmps = sv_create(arg_count) => sv_free(c_arg_tmps)) {
                    for (let i = 0; i < arg_count; i = i + 1) {
                        let arg_id = id_vec_get(expr.ids as VectorBase*, i);
                        let param_index = i;
                        if (expected_names != null) {
                            let label = sv_get(expr.arg_labels as StringVector*, i);
                            for (let j = 0; j < arg_count; j = j + 1) {
                                if (sv_get(expected_names as StringVector*, j) == label) {
                                    param_index = j;
                                    break;
                                }
                            }
                        }

                        let field = ptr_vec_get((info as StructInfo*).fields, param_index) as StructFieldInfo*;
                        let c_arg = be_emit_owned_expr_with_expected_type(self, arg_id, field.field_type);
                        c_arg = be_finalize_lowered_constructor_arg(self, c_arg, field.field_type, is_out_of_order);
                        sv_push(c_arg_tmps, c_arg);
                    }

                    for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                        let source_index = p_idx;
                        if (expected_names != null) {
                            let expected_label = sv_get(expected_names as StringVector*, p_idx);
                            for (let i = 0; i < arg_count; i = i + 1) {
                                if (sv_get(expr.arg_labels as StringVector*, i) == expected_label) {
                                    source_index = i;
                                    break;
                                }
                            }
                        }
                        
                        let field = ptr_vec_get((info as StructInfo*).fields, p_idx) as StructFieldInfo*;
                        sv_push(field_inits, field.name);
                        sv_push(field_inits, sv_get(c_arg_tmps, source_index));
                    }
                }
                if (expected_names != null) sv_free(expected_names as StringVector*);
                cem_emit_struct_init_from_fields(self.emitter, tmp, base_ty, field_inits);
                return tmp;
            }
        }

        if (ord(base_ty.kind) == ord(TY_ENUM)) {
            let variant_name = "";
            if (expr.type_ref != null) {
                variant_name = (expr.type_ref as TypeRef*).name;
            }
            let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, base_ty.module_name, base_ty.name);
            if (enum_info == null) {
                return be_ice_string("[ICE-1220] new enum allocation missing variant symbol");
            }
            let variant_info = cem_find_enum_variant_info(enum_info as EnumInfo*, variant_name);
            if (variant_info == null) {
                return be_ice_string("[ICE-1220] new enum allocation missing variant symbol");
            }
            with (let payload_inits = sv_create(8) => sv_free(payload_inits)) {
                let info2 = variant_info as EnumVariantInfo*;
                let expected_names: StringVector*? = null;
                let is_out_of_order = false;
                if (expr.arg_labels != null) {
                    expected_names = sv_create(arg_count);
                    for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                        sv_push(expected_names as StringVector*, sv_get(info2.field_names, p_idx));
                    }
                    for (let k = 0; k < arg_count; k = k + 1) {
                        if (sv_get(expected_names as StringVector*, k) != sv_get(expr.arg_labels as StringVector*, k)) {
                            is_out_of_order = true;
                            break;
                        }
                    }
                }

                with (let c_arg_tmps = sv_create(arg_count) => sv_free(c_arg_tmps)) {
                    for (let i = 0; i < arg_count; i = i + 1) {
                        let arg_id = id_vec_get(expr.ids as VectorBase*, i);
                        let param_index = i;
                        if (expected_names != null) {
                            let label = sv_get(expr.arg_labels as StringVector*, i);
                            for (let j = 0; j < arg_count; j = j + 1) {
                                if (sv_get(expected_names as StringVector*, j) == label) {
                                    param_index = j;
                                    break;
                                }
                            }
                        }

                        let field_ty = ptr_vec_get(info2.field_types, param_index) as Type*;
                        let c_arg = be_emit_owned_expr_with_expected_type(self, arg_id, field_ty);
                        c_arg = be_finalize_lowered_constructor_arg(self, c_arg, field_ty, is_out_of_order);
                        sv_push(c_arg_tmps, c_arg);
                    }

                    for (let p_idx = 0; p_idx < arg_count; p_idx = p_idx + 1) {
                        let source_index = p_idx;
                        if (expected_names != null) {
                            let expected_label = sv_get(expected_names as StringVector*, p_idx);
                            for (let i = 0; i < arg_count; i = i + 1) {
                                if (sv_get(expr.arg_labels as StringVector*, i) == expected_label) {
                                    source_index = i;
                                    break;
                                }
                            }
                        }

                        sv_push(payload_inits, sv_get(info2.field_names, p_idx));
                        sv_push(payload_inits, sv_get(c_arg_tmps, source_index));
                    }
                }
                if (expected_names != null) sv_free(expected_names as StringVector*);

                cem_emit_enum_variant_init(self.emitter, tmp, base_ty, variant_name, payload_inits);
                return tmp;
            }
        }

        if (arg_count == 1) {
            cem_emit_checked_pointer_assignment(self.emitter, tmp, c_base, be_emit_expr(self, id_vec_get(expr.ids as VectorBase*, 0)));
            return tmp;
        }

        return be_ice_string("[ICE-1231] unsupported new expression for type '" + type_format(base_ty) + "'");
    }
}

/**
 * Emit one expression.
 *
 * @param self Backend state to inspect.
 * @param expr_id Expression id to lower.
 * @return Lowered expression string.
 */
func be_emit_expr(self: Backend*, expr_id: ExprId) -> string {
    let bigint_expr = be_emit_typed_bigint_expr(self, expr_id, null);
    if (bigint_expr != null) {
        return bigint_expr as string;
    }
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    match (expr.kind) {
        EX_INT => { return cem_emit_int_literal(expr.int_value); }
        EX_BIGINT => { return cem_emit_bigint_literal(expr.text_value, expr.base_value); }
        EX_FLOAT => { return cem_emit_real_literal(expr.text_value); }
        EX_DOUBLE => { return cem_emit_real_literal(expr.text_value); }
        EX_BYTE => { return cem_emit_byte_literal(expr.int_value as byte); }
        EX_STRING => { return cem_emit_string_literal(expr.text_value); }
        EX_BOOL => { return cem_emit_bool_literal(expr.bool_value); }
        EX_NULL => {
            with (let expected_ty = be_expr_type(self, expr_id) => type_free_opt(expected_ty)) {
                if (expected_ty == null) {
                    return be_ice_string("[ICE-1091] missing expected type for null literal");
                }
                return cem_emit_null_literal(expected_ty as Type*, false);
            }
        }
        EX_VAR_REF => {
            let res = analysis_get_var_ref_resolution(self.result, self.current_module as string, expr_id);
            if (res != null && (res as int) == ord(VAR_RES_LOCAL)) {
                return cem_emit_var_ref(cem_mangle_identifier(expr.text_value));
            }

            let sym = be_lookup_symbol(self, expr.text_value, expr.module_path, expr.name_qualifier);
            if (sym == null) {
                return be_ice_string("[ICE-1103] unresolved variable reference after type checking: " + self.current_module as string + "::" + expr.text_value);
            }

            if (ord((sym as Symbol*).kind) == ord(SYM_FUNC)) {
                let func_ty = sig_lookup_func_type(self.result.signatures as SignatureTables*,
                    (sym as Symbol*).module_name, (sym as Symbol*).name);
                if (func_ty == null) {
                    return be_ice_string("[ICE-1150] missing FuncType for " + (sym as Symbol*).module_name +
                        "." + (sym as Symbol*).name);
                }
                return cem_emit_var_ref(be_function_c_name(self, sym as Symbol*, func_ty as Type*));
            }

            if (ord((sym as Symbol*).kind) == ord(SYM_LET)) {
                return cem_emit_var_ref(cem_mangle_let_name((sym as Symbol*).module_name, (sym as Symbol*).name));
            }

            if (ord((sym as Symbol*).kind) == ord(SYM_ENUM_VARIANT)) {
                with (let expr_ty = be_expr_type(self, expr_id) => type_free_opt(expr_ty),
                      let payload = sv_create(0) => sv_free(payload)) {
                    if (expr_ty == null) {
                        return be_ice_string("[ICE-1104] missing enum type for bare variant constructor");
                    }
                    return cem_emit_variant_constructor_for_type(expr_ty as Type*, (sym as Symbol*).name, payload);
                }
            }

            return be_ice_string("[ICE-1102] unsupported module-level variable reference");
        }
        EX_UNARY => {
            let c_inner = be_emit_expr(self, expr.expr_a);
            if (expr.text_value == "*") {
                with (let operand_ty = be_expr_type(self, expr.expr_a) => type_free_opt(operand_ty)) {
                    if (operand_ty == null) {
                        return be_ice_string("[ICE-1247] missing type for dereference operand");
                    }
                    c_inner = be_emit_checked_pointer_expr(self, c_inner, operand_ty as Type*, "_RT_ACCESS_READ");
                }
            }
            if (expr.text_value == "~") {
                with (let result_ty = be_expr_type(self, expr_id) => type_free_opt(result_ty)) {
                    if (result_ty != null && be_is_int_assignable(result_ty as Type*)) {
                        return cem_emit_cast(cem_emit_type(result_ty as Type*), cem_emit_unary_op(expr.text_value, c_inner));
                    }
                }
            }
            return cem_emit_unary_op(expr.text_value, c_inner);
        }
        EX_BINARY => { return be_emit_binary_op(self, expr_id); }
        EX_CALL => { return be_emit_call(self, expr_id); }
        EX_INDEX => {
            let base_has_effects = be_has_side_effects(self, expr.expr_a);
            let index_has_effects = be_has_side_effects(self, expr.expr_b);
            with (let base_ty_for_index = be_expr_type(self, expr.expr_a) => type_free_opt(base_ty_for_index)) {
                if (base_ty_for_index == null) {
                    return be_ice_string("[ICE-1898] missing type for index base");
                }
                let final_base = be_emit_expr(self, expr.expr_a);
                let final_index = be_emit_expr(self, expr.expr_b);

                let raw_array_base = false;
                let base_expr = expr_arena_get(be_current_expr_arena(self), expr.expr_a);
                if (ord(base_expr.kind) == ord(EX_INDEX)) {
                    with (let nested_base_ty = be_expr_type(self, base_expr.expr_a) => type_free_opt(nested_base_ty)) {
                        raw_array_base = nested_base_ty != null &&
                            ord((nested_base_ty as Type*).kind) == ord(TY_ARRAY);
                    }
                }

                if (base_has_effects && !raw_array_base) {
                    let base_temp = cem_fresh_tmp(self.emitter, "base");
                    cem_emit_temp_decl(self.emitter, cem_emit_type(base_ty_for_index as Type*), base_temp, final_base);
                    final_base = base_temp;
                }

                if (index_has_effects) {
                    let idx_temp = cem_fresh_tmp(self.emitter, "idx");
                    cem_emit_temp_decl(self.emitter, "dea_int", idx_temp, final_index);
                    final_index = idx_temp;
                }

                return be_emit_checked_index_lvalue(self, final_base, final_index, base_ty_for_index as Type*, raw_array_base, "_RT_ACCESS_READ");
            }
        }
        EX_FIELD => {
            with (let obj_ty = be_expr_type(self, expr.expr_a) => type_free_opt(obj_ty)) {
                let c_obj = be_emit_expr(self, expr.expr_a);
                let obj_ptr_ty = be_pointer_type_or_null(obj_ty);
                if (obj_ptr_ty != null) {
                    c_obj = be_emit_checked_pointer_expr(self, c_obj, obj_ptr_ty as Type*, "_RT_ACCESS_READ");
                    return cem_emit_field_access(c_obj, expr.text_value, true);
                }
                return cem_emit_field_access(c_obj, expr.text_value, false);
            }
        }
        EX_PAREN => { return cem_emit_paren_expr(be_emit_expr(self, expr.expr_a)); }
        EX_CAST => {
            with (let src_ty = be_expr_type(self, expr.expr_a) => type_free_opt(src_ty),
                  let dst_ty = be_resolve_type_ref(self, expr.type_ref as TypeRef*) => type_free_opt(dst_ty)) {
                if (dst_ty == null) {
                    return be_ice_string("[ICE-1110] failed to resolve cast target type");
                }
                let c_inner = be_emit_expr(self, expr.expr_a);
                let c_dst = cem_emit_type(dst_ty as Type*);

                if (src_ty != null && type_equals(src_ty as Type*, dst_ty as Type*)) {
                    return c_inner;
                }

                if (src_ty != null &&
                    be_is_int_assignable(src_ty as Type*) &&
                    be_is_int_assignable(dst_ty as Type*) &&
                    !be_int_range_contains(dst_ty as Type*, src_ty as Type*)) {
                    if (be_is_legacy_checked_cast_source(src_ty as Type*)) {
                        return cem_emit_checked_narrow_cast(c_dst, c_inner);
                    }
                    if (be_is_signed_int(src_ty as Type*)) {
                        return cem_emit_checked_signed_cast(c_dst, c_inner);
                    }
                    return cem_emit_checked_unsigned_cast(c_dst, c_inner);
                }

                if (ord((dst_ty as Type*).kind) == ord(TY_NULLABLE)) {
                    let dst_inner = (dst_ty as Type*).inner as Type*;
                    if (src_ty != null && type_equals(dst_inner, src_ty as Type*)) {
                        if (cem_is_niche_nullable(dst_ty as Type*)) {
                            return cem_emit_cast(c_dst, c_inner);
                        }
                        return cem_emit_some_value_for_nullable(dst_ty as Type*, c_inner);
                    }
                    if (src_ty != null && be_is_int_assignable(src_ty as Type*) && be_is_int_assignable(dst_inner)) {
                        let c_payload = c_inner;
                        if (!be_int_range_contains(dst_inner, src_ty as Type*)) {
                            let c_inner_dst = cem_emit_type(dst_inner);
                            if (be_is_legacy_checked_cast_source(src_ty as Type*)) {
                                c_payload = cem_emit_checked_narrow_cast(c_inner_dst, c_inner);
                            } else if (be_is_signed_int(src_ty as Type*)) {
                                c_payload = cem_emit_checked_signed_cast(c_inner_dst, c_inner);
                            } else {
                                c_payload = cem_emit_checked_unsigned_cast(c_inner_dst, c_inner);
                            }
                        } else if (be_can_widen_int(dst_inner, src_ty as Type*)) {
                            c_payload = cem_emit_widen_int(c_inner, src_ty as Type*, dst_inner);
                        } else {
                            c_payload = cem_emit_cast(cem_emit_type(dst_inner), c_inner);
                        }
                        if (cem_is_niche_nullable(dst_ty as Type*)) {
                            return cem_emit_cast(c_dst, c_payload);
                        }
                        return cem_emit_some_value_for_nullable(dst_ty as Type*, c_payload);
                    }
                }

                if (src_ty != null && ord((src_ty as Type*).kind) == ord(TY_NULLABLE) &&
                    type_equals(((src_ty as Type*).inner as Type*), dst_ty as Type*)) {
                    if (cem_is_niche_nullable(src_ty as Type*)) {
                        return cem_emit_unwrap_ptr(c_dst, c_inner, type_format(src_ty as Type*));
                    }
                    let tmp = cem_fresh_tmp(self.emitter, "unwrap");
                    cem_emit_temp_decl(self.emitter, cem_emit_type(src_ty as Type*), tmp, c_inner);
                    return cem_emit_unwrap_opt(cem_emit_type(src_ty as Type*), tmp, type_format(src_ty as Type*));
                }

                return cem_emit_cast(c_dst, c_inner);
            }
        }
        EX_TYPE => {
            return be_ice_string("[ICE-9149] bare type expression cannot be emitted directly");
        }
        EX_ARRAY_LITERAL => {
            return be_ice_string("[ICE-9150] array literal requires contextual emission");
        }
        EX_ARRAY_CONSTRUCTOR => {
            with (let arr_ty = be_expr_type(self, expr_id) => type_free_opt(arr_ty)) {
                if (arr_ty == null || ord((arr_ty as Type*).kind) != ord(TY_ARRAY)) {
                    return be_ice_string("[ICE-9151] array constructor missing array type");
                }
                if (expr.ids == null || vec_size(expr.ids as VectorBase*) != 1) {
                    return be_ice_string("[ICE-9152] invalid array constructor arity after type checking");
                }
                let arg_id = id_vec_get(expr.ids as VectorBase*, 0);
                let literal_arg_id = be_unwrap_paren_expr_id(self, arg_id);
                let arg_expr = expr_arena_get(be_current_expr_arena(self), literal_arg_id);
                if (ord(arg_expr.kind) == ord(EX_ARRAY_LITERAL)) {
                    with (let arg_ty = be_expr_type(self, literal_arg_id) => type_free_opt(arg_ty)) {
                        if (arg_ty != null && type_equals(arg_ty as Type*, (arr_ty as Type*).inner as Type*)) {
                            return be_emit_array_fill_value(self, literal_arg_id, arr_ty as Type*);
                        }
                    }
                    return be_emit_array_literal_value(self, literal_arg_id, arr_ty as Type*);
                }
                return be_emit_array_fill_value(self, arg_id, arr_ty as Type*);
            }
        }
        EX_NEW => {
            return be_emit_new_expr(self, expr_id);
        }
        EX_TRY => {
            with (let src_ty = be_expr_type(self, expr.expr_a) => type_free_opt(src_ty)) {
                if (src_ty == null || ord((src_ty as Type*).kind) != ord(TY_NULLABLE)) {
                    return be_ice_string("[ICE-1130] TryExpr operand is not nullable");
                }
                if (self.current_func_result == null || ord((self.current_func_result as Type*).kind) != ord(TY_NULLABLE)) {
                    return be_ice_string("[ICE-1131] TryExpr used in non-nullable function");
                }

                let tmp = cem_fresh_tmp(self.emitter, "try");
                cem_emit_temp_decl(self.emitter, cem_emit_type(src_ty as Type*), tmp, be_emit_expr(self, expr.expr_a));
                let ret_none = cem_emit_null_literal(self.current_func_result as Type*, false);

                if (cem_is_niche_nullable(src_ty as Type*)) {
                    if (be_scope_chain_has_cleanup(self)) {
                        cem_emit_if_header(self.emitter, cem_emit_condition_pointer_null_check(tmp, "=="));
                        cem_emit_block_start(self.emitter);
                        be_emit_cleanup_for_return(self, null);
                        cem_emit_return_stmt(self.emitter, ret_none);
                        cem_emit_block_end(self.emitter);
                    } else {
                        cem_emit_try_check_niche(self.emitter, tmp, ret_none);
                    }
                    return tmp;
                }

                if (be_scope_chain_has_cleanup(self)) {
                    cem_emit_if_header(self.emitter, cem_emit_null_check_eq(tmp));
                    cem_emit_block_start(self.emitter);
                    be_emit_cleanup_for_return(self, null);
                    cem_emit_return_stmt(self.emitter, ret_none);
                    cem_emit_block_end(self.emitter);
                } else {
                    cem_emit_try_check_value(self.emitter, tmp, ret_none);
                }
                return cem_emit_try_extract_value(tmp);
            }
        }
    }
}

/**
 * Emit cleanup for one by-value expression.
 *
 * @param self Backend state to update.
 * @param c_expr Lowered value expression.
 * @param ty Type of the value.
 */
func be_emit_value_cleanup(self: Backend*, c_expr: string, ty: Type*) {
    cem_emit_value_cleanup(self.emitter, c_expr, ty);
}

/**
 * Emit cleanup for a pointer-to-struct expression.
 *
 * @param self Backend state to update.
 * @param c_ptr_expr Lowered pointer expression.
 * @param struct_type Struct type to clean.
 */
func be_emit_struct_cleanup(self: Backend*, c_ptr_expr: string, struct_type: Type*) {
    cem_emit_struct_cleanup(self.emitter, c_ptr_expr, struct_type);
}

/**
 * Emit cleanup for a pointer-to-enum expression.
 *
 * @param self Backend state to update.
 * @param c_ptr_expr Lowered pointer expression.
 * @param enum_type Enum type to clean.
 */
func be_emit_enum_cleanup(self: Backend*, c_ptr_expr: string, enum_type: Type*) {
    cem_emit_enum_cleanup(self.emitter, c_ptr_expr, enum_type);
}

/**
 * Emit cleanup for owned values declared in one scope.
 *
 * @param self Backend state to update.
 * @param scope Scope to clean.
 */
func be_emit_cleanup_at_scope_exit(self: Backend*, scope: ScopeContext*) {
    for (let i = vec_size(scope.owned_vars) - 1; i >= 0; i = i - 1) {
        let item = ptr_vec_get(scope.owned_vars, i) as ScopeVar*;
        if (analysis_has_arc_data(self.result, item.var_type)) {
            be_emit_value_cleanup(self, item.name, item.var_type);
        }
    }
}

/**
 * Emit `with` cleanup recorded on one scope.
 *
 * @param self Backend state to update.
 * @param scope Scope carrying `with` cleanup state.
 */
func be_emit_with_cleanup_from_scope(self: Backend*, scope: ScopeContext*) {
    if (scope.with_cleanup_block < 0 && !sc_has_inline_cleanup(scope)) {
        return;
    }

    let old = scope.with_cleanup_in_progress;
    scope.with_cleanup_in_progress = true;
    cem_emit_block_start(self.emitter);
    let cleanup_scope = be_push_scope(self);

    if (scope.with_cleanup_block >= 0) {
        be_emit_block_sequence(self, scope.with_cleanup_block);
    } else {
        let items = scope.with_cleanup_inline as VectorBase*;
        for (let i = vec_size(items) - 1; i >= 0; i = i - 1) {
            be_emit_stmt(self, id_vec_get(items, i));
        }
    }

    if (!self.next_stmt_unreachable) {
        be_emit_cleanup_at_scope_exit(self, cleanup_scope);
    }
    be_pop_scope(self);
    cem_emit_block_end(self.emitter);
    scope.with_cleanup_in_progress = old;
}

/**
 * Register one inline `with` cleanup item in LIFO order.
 *
 * @param scope Scope carrying inline cleanup state.
 * @param item Parsed with item whose cleanup should be registered.
 */
func be_register_inline_with_cleanup(scope: ScopeContext*, item: WithItem*) {
    if (item.has_cleanup && item.cleanup_stmt >= 0) {
        sc_push_inline_cleanup(scope, item.cleanup_stmt);
    }
}

/**
 * Emit cleanup required before returning from the current function.
 *
 * @param self Backend state to update.
 * @param returned_var Optional owned local to keep alive across cleanup.
 */
func be_emit_cleanup_for_return(self: Backend*, returned_var: string?) {
    let scope = self.current_scope;
    while (scope != null) {
        let cur = scope as ScopeContext*;
        if (((cur.with_cleanup_block >= 0) || sc_has_inline_cleanup(cur)) && !cur.with_cleanup_in_progress) {
            be_emit_with_cleanup_from_scope(self, cur);
        }
        for (let i = vec_size(cur.owned_vars) - 1; i >= 0; i = i - 1) {
            let item = ptr_vec_get(cur.owned_vars, i) as ScopeVar*;
            if (returned_var != null && item.name == returned_var as string) {
                continue;
            }
            if (analysis_has_arc_data(self.result, item.var_type)) {
                be_emit_value_cleanup(self, item.name, item.var_type);
            }
        }
        scope = cur.parent;
    }
}

/**
 * Emit cleanup required before breaking or continuing out of the innermost loop.
 *
 * @param self Backend state to update.
 * @param is_break `true` for break, `false` for continue.
 */
func be_emit_cleanup_for_loop_exit(self: Backend*, is_break: bool) {
    if (self.current_loop_cleanup_scopes == null) {
        be_ice("[ICE-1020] break/continue outside of loop");
    }

    let frame = self.current_loop_cleanup_scopes as LoopCleanupScopes*;
    let target_scope_id = frame.continue_scope_id;
    if (is_break) {
        target_scope_id = frame.break_scope_id;
    }

    let scope = self.current_scope;
    while (scope != null) {
        let cur = scope as ScopeContext*;
        if (((cur.with_cleanup_block >= 0) || sc_has_inline_cleanup(cur)) && !cur.with_cleanup_in_progress) {
            be_emit_with_cleanup_from_scope(self, cur);
        }
        for (let i = vec_size(cur.owned_vars) - 1; i >= 0; i = i - 1) {
            let item = ptr_vec_get(cur.owned_vars, i) as ScopeVar*;
            if (analysis_has_arc_data(self.result, item.var_type)) {
                be_emit_value_cleanup(self, item.name, item.var_type);
            }
        }
        if (cur.scope_id == target_scope_id) {
            break;
        }
        scope = cur.parent;
    }
}

/**
 * Emit a return statement, optionally registering one inline with-item cleanup first.
 *
 * @param self Backend state to update.
 * @param stmt Parsed return statement.
 * @param inline_scope Optional with scope for a committed inline header return.
 * @param inline_cleanup Cleanup statement to register when inline_scope is present.
 */
func be_emit_return_stmt_with_inline_cleanup(
    self: Backend*,
    stmt: StmtNode*,
    inline_scope: ScopeContext*?,
    inline_cleanup: StmtId
) {
    if (stmt.expr_a >= 0) {
        if (self.current_func_result == null) {
            be_ice("[ICE-1293] backend missing current function result type");
        }
        let returned_var = be_lookup_owned_local_name(self, stmt.expr_a);
        let c_value = "";
        if (returned_var != null) {
            c_value = be_emit_expr_with_expected_type(self, stmt.expr_a, self.current_func_result as Type*);
        } else {
            c_value = be_emit_owned_expr_with_expected_type(self, stmt.expr_a, self.current_func_result as Type*);
        }
        if (inline_scope != null && inline_cleanup >= 0) {
            sc_push_inline_cleanup(inline_scope as ScopeContext*, inline_cleanup);
        }
        if (be_scope_chain_has_cleanup(self)) {
            let ret_tmp = cem_fresh_tmp(self.emitter, "ret");
            cem_emit_temp_decl(self.emitter, cem_emit_type(self.current_func_result as Type*), ret_tmp, c_value);
            be_emit_cleanup_for_return(self, returned_var);
            cem_emit_return_stmt(self.emitter, ret_tmp);
        } else {
            cem_emit_return_stmt(self.emitter, c_value);
        }
    } else {
        if (inline_scope != null && inline_cleanup >= 0) {
            sc_push_inline_cleanup(inline_scope as ScopeContext*, inline_cleanup);
        }
        if (be_scope_chain_has_cleanup(self)) {
            be_emit_cleanup_for_return(self, null);
        }
        cem_emit_return_void_stmt(self.emitter);
    }
    self.next_stmt_unreachable = true;
}

/**
 * Emit one match-pattern payload binding set.
 *
 * @param self Backend state to update.
 * @param pattern_id Pattern id to inspect.
 * @param enum_type Scrutinee enum type.
 * @param arm_scope Arm scope receiving borrowed bindings.
 */
func be_emit_pattern_bindings(self: Backend*, pattern_id: PatternId, enum_type: Type*, arm_scope: ScopeContext*) {
    let pattern = pattern_arena_get(be_current_unit(self).parse_result.pattern_arena, pattern_id);
    if (ord(pattern.kind) != ord(PT_VARIANT)) {
        return;
    }

    let enum_info = sig_lookup_enum_info(self.result.signatures as SignatureTables*, enum_type.module_name, enum_type.name);
    if (enum_info == null) {
        return;
    }

    let variant_info = cem_find_enum_variant_info(enum_info as EnumInfo*, pattern.name);
    if (variant_info == null || pattern.vars == null) {
        return;
    }

    let info2 = variant_info as EnumVariantInfo*;
    for (let i = 0; i < sv_size(pattern.vars as StringVector*); i = i + 1) {
        let field_ty = ptr_vec_get(info2.field_types, i) as Type*;
        let c_name = cem_mangle_identifier(sv_get(pattern.vars as StringVector*, i));
        cem_emit_let_decl(self.emitter, cem_emit_type(field_ty), c_name,
            cem_emit_pattern_binding_init("_scrutinee", pattern.name,
                sv_get(info2.field_names, i)));
        sc_add_declared(arm_scope, c_name, field_ty);
    }
}

/**
 * Emit one `case` literal.
 *
 * @param self Backend state to inspect.
 * @param expr_id Literal expression id.
 * @param expected_type Case scrutinee type.
 * @return Lowered constant expression.
 */
func be_emit_case_literal(self: Backend*, expr_id: ExprId, expected_type: Type*) -> string {
    let bigint_literal = be_emit_typed_bigint_expr(self, expr_id, null);
    if (bigint_literal != null) {
        return bigint_literal as string;
    }
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    match (expr.kind) {
        EX_INT => { return cem_emit_int_literal(expr.int_value); }
        EX_BIGINT => { return cem_emit_bigint_literal(expr.text_value, expr.base_value); }
        EX_FLOAT => { return cem_emit_real_literal(expr.text_value); }
        EX_DOUBLE => { return cem_emit_real_literal(expr.text_value); }
        EX_BYTE => { return cem_emit_byte_literal(expr.int_value as byte); }
        EX_BOOL => { return cem_emit_bool_literal(expr.bool_value); }
        EX_STRING => { return cem_emit_string_literal(expr.text_value); }
        _ => {
            let value = be_eval_const_value(self, expr_id);
            if (value == null) {
                return be_ice_string("[ICE-1194] unsupported case literal type");
            }
            let evaluated = value as ConstValue*;
            let result = be_emit_const_scalar_numeric(evaluated, expected_type);
            if (result == null) {
                match (evaluated.kind) {
                    CV_BOOL => { result = cem_emit_bool_literal(evaluated.bool_value); }
                    CV_STRING => { result = cem_emit_string_literal(evaluated.text_value); }
                    _ => {}
                }
            }
            tr_const_value_free(evaluated);
            if (result == null) {
                return be_ice_string("[ICE-1194] unsupported null case literal");
            }
            return result as string;
        }
    }
}

func be_case_int_literal_value(self: Backend*, expr_id: ExprId) -> int? {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);
    if (ord(expr.kind) == ord(EX_INT)) {
        return expr.int_value;
    }
    if (ord(expr.kind) == ord(EX_BYTE)) {
        return expr.int_value;
    }
    let value = be_eval_const_value(self, expr_id);
    if (value != null) {
        let evaluated = value as ConstValue*;
        let result: int? = null;
        if (ord(evaluated.kind) == ord(CV_INT) || ord(evaluated.kind) == ord(CV_BYTE) ||
            ord(evaluated.kind) == ord(CV_OTHER_INT)) {
            result = evaluated.int_value;
        }
        tr_const_value_free(evaluated);
        return result;
    }
    return null;
}

func be_case_literal_is_bigint(self: Backend*, expr_id: ExprId) -> bool {
    if (be_bigint_expr_text(self, expr_id) != null && be_bigint_expr_base(self, expr_id) != null) {
        return true;
    }
    let value = be_eval_const_value(self, expr_id);
    if (value == null) {
        return false;
    }
    let evaluated = value as ConstValue*;
    let result = ord(evaluated.kind) == ord(CV_BIGINT);
    tr_const_value_free(evaluated);
    return result;
}

func be_case_literal_is_always_false(self: Backend*, scrutinee_ty: Type*, expr_id: ExprId) -> bool {
    let text = be_bigint_expr_text(self, expr_id);
    let base = be_bigint_expr_base(self, expr_id);
    if (text != null && base != null) {
        return !bigint_fits_builtin(scrutinee_ty, text as string, base as int);
    }

    let value = be_case_int_literal_value(self, expr_id);
    if (value != null) {
        return !int_value_fits_builtin(scrutinee_ty, value as int);
    }
    return false;
}

func be_case_needs_if_else(self: Backend*, scrutinee_ty: Type*, arms: VectorBase*) -> bool {
    if (type_is_builtin(scrutinee_ty, "string") ||
        type_is_builtin(scrutinee_ty, "float") ||
        type_is_builtin(scrutinee_ty, "double") ||
        type_is_builtin(scrutinee_ty, "tiny") ||
        type_is_builtin(scrutinee_ty, "byte") ||
        type_is_builtin(scrutinee_ty, "short") ||
        type_is_builtin(scrutinee_ty, "ushort")) {
        return true;
    }

    for (let i = 0; i < vec_size(arms); i = i + 1) {
        let arm = ptr_vec_get(arms, i) as CaseArm*;
        let lit_node = expr_arena_get(be_current_expr_arena(self), arm.literal);
        if (ord(lit_node.kind) == ord(EX_FLOAT) ||
            ord(lit_node.kind) == ord(EX_DOUBLE) ||
            be_case_literal_is_bigint(self, arm.literal) ||
            be_case_literal_is_always_false(self, scrutinee_ty, arm.literal)) {
            return true;
        }
    }
    return false;
}

/**
 * Emit a `drop` statement.
 *
 * @param self Backend state to update.
 * @param stmt Parsed drop statement.
 */
func be_emit_drop_stmt(self: Backend*, stmt: StmtNode*) {
    let c_name = cem_mangle_identifier(stmt.name);
    let var_type = be_lookup_local_var_type(self, stmt.name);
    if (var_type == null) {
        let sym = be_lookup_symbol(self, stmt.name, null, null);
        if (sym == null) {
            be_ice("[ICE-1060] undefined variable in drop: " + stmt.name);
        }
        var_type = (sym as Symbol*).resolved_type;
    }
    if (var_type == null) {
        be_ice("[ICE-1060] drop requires resolved variable type");
    }

    let ptr_type = be_pointer_type_or_null(var_type as Type*);
    if (ptr_type == null) {
        be_ice("[ICE-1061] drop requires pointer type, got '" + type_format(var_type as Type*) + "'");
    }

    let pointee = (ptr_type as Type*).inner as Type*;
    let drop_tmp = cem_fresh_tmp(self.emitter, "drop");
    let c_ptr_type = cem_emit_type(ptr_type as Type*);
    cem_emit_temp_decl(
        self.emitter,
        c_ptr_type,
        drop_tmp,
        cem_emit_drop_begin_expr(
            c_name,
            c_ptr_type,
            be_sizeof_expr_for_type(pointee),
            be_alignof_expr_for_type(pointee)
        )
    );

    if (ord(pointee.kind) == ord(TY_STRUCT)) {
        be_emit_struct_cleanup(self, drop_tmp, pointee);
    } else if (ord(pointee.kind) == ord(TY_ENUM)) {
        be_emit_enum_cleanup(self, drop_tmp, pointee);
    } else if (ord(pointee.kind) == ord(TY_ARRAY)) {
        cem_emit_if_header(self.emitter, cem_emit_pointer_null_check(drop_tmp, "!="));
        cem_emit_block_start(self.emitter);
        be_emit_value_cleanup(self, "*" + drop_tmp, pointee);
        cem_emit_block_end(self.emitter);
    } else if (analysis_is_arc_type(pointee)) {
        cem_emit_if_header(self.emitter, cem_emit_pointer_null_check(drop_tmp, "!="));
        cem_emit_block_start(self.emitter);
        cem_emit_string_release(self.emitter, "*" + drop_tmp);
        cem_emit_block_end(self.emitter);
    }

    cem_emit_drop_finish_call(self.emitter, drop_tmp);
    cem_emit_null_assignment(self.emitter, c_name);
    self.next_stmt_unreachable = false;
}

/**
 * Emit a `match` statement.
 *
 * @param self Backend state to update.
 * @param stmt Parsed match statement.
 */
func be_emit_match_stmt(self: Backend*, stmt: StmtNode*) {
    with (let scrutinee_ty = be_expr_type(self, stmt.expr_a) => type_free_opt(scrutinee_ty)) {
        if (scrutinee_ty == null) {
            be_ice("[ICE-1190] missing inferred type for match scrutinee");
        }

        cem_emit_block_start(self.emitter);
        let outer_scope = be_push_scope(self);
        let c_scrutinee_expr = be_emit_expr(self, stmt.expr_a);
        cem_emit_match_scrutinee_decl(self.emitter, cem_emit_type(scrutinee_ty as Type*), c_scrutinee_expr);
        if (be_is_unwrap_cast_from_place(self, stmt.expr_a) && analysis_has_arc_data(self.result, scrutinee_ty as Type*)) {
            be_emit_retain_for_copied_value(self, "_scrutinee", scrutinee_ty as Type*);
        }
        if (!be_is_place_expr(self, stmt.expr_a) && analysis_has_arc_data(self.result, scrutinee_ty as Type*)) {
            sc_add_owned(outer_scope, "_scrutinee", scrutinee_ty as Type*);
        }

        cem_emit_match_switch_start(self.emitter, "_scrutinee");
        let arms = stmt.match_arms as VectorBase*;
        let unreachable_arms = 0;
        for (let i = 0; i < vec_size(arms); i = i + 1) {
            let arm = ptr_vec_get(arms, i) as MatchArm*;
            let pattern = pattern_arena_get(be_current_unit(self).parse_result.pattern_arena, arm.pattern);
            if (ord(pattern.kind) == ord(PT_WILDCARD)) {
                cem_emit_default_label(self.emitter);
            } else if (ord(pattern.kind) == ord(PT_VARIANT) && ord((scrutinee_ty as Type*).kind) == ord(TY_ENUM)) {
                cem_emit_case_label(self.emitter, cem_emit_enum_tag(scrutinee_ty as Type*, pattern.name));
            } else {
                be_ice("[ICE-1192] unsupported match pattern");
            }

            cem_emit_block_start(self.emitter);
            let arm_scope = be_push_scope(self);
            self.next_stmt_unreachable = false;
            if (ord(pattern.kind) == ord(PT_VARIANT) && ord((scrutinee_ty as Type*).kind) == ord(TY_ENUM)) {
                be_emit_pattern_bindings(self, arm.pattern, scrutinee_ty as Type*, arm_scope);
            }
            be_emit_scoped_stmt_body(self, arm.body);
            if (!self.next_stmt_unreachable) {
                be_emit_cleanup_at_scope_exit(self, arm_scope);
                cem_emit_exit_switch(self.emitter);
            } else {
                unreachable_arms = unreachable_arms + 1;
            }
            be_pop_scope(self);
            cem_emit_block_end(self.emitter);
        }
        cem_emit_switch_end(self.emitter);
        self.next_stmt_unreachable = unreachable_arms == vec_size(arms);
        if (!self.next_stmt_unreachable) {
            be_emit_cleanup_at_scope_exit(self, outer_scope);
        } else {
            cem_emit_unreachable_marker(self.emitter, "'match'");
        }
        be_pop_scope(self);
        cem_emit_block_end(self.emitter);
    }
}

/**
 * Emit a `case` statement.
 *
 * @param self Backend state to update.
 * @param stmt Parsed case statement.
 */
func be_emit_case_stmt(self: Backend*, stmt: StmtNode*) {
    with (let scrutinee_ty = be_expr_type(self, stmt.expr_a) => type_free_opt(scrutinee_ty)) {
        if (scrutinee_ty == null) {
            be_ice("[ICE-1193] missing inferred type for case scrutinee");
        }

        cem_emit_block_start(self.emitter);
        let outer_scope = be_push_scope(self);
        let c_scrutinee_expr = be_emit_expr(self, stmt.expr_a);
        cem_emit_match_scrutinee_decl(self.emitter, cem_emit_type(scrutinee_ty as Type*), c_scrutinee_expr);
        if (be_is_unwrap_cast_from_place(self, stmt.expr_a) && analysis_has_arc_data(self.result, scrutinee_ty as Type*)) {
            be_emit_retain_for_copied_value(self, "_scrutinee", scrutinee_ty as Type*);
        }
        if (!be_is_place_expr(self, stmt.expr_a) && analysis_has_arc_data(self.result, scrutinee_ty as Type*)) {
            sc_add_owned(outer_scope, "_scrutinee", scrutinee_ty as Type*);
        }

        let arms = stmt.case_arms as VectorBase*;
        let total_arms = vec_size(arms);
        if (stmt.case_else != null) {
            total_arms = total_arms + 1;
        }
        let unreachable_arms = 0;

        let needs_if_else = be_case_needs_if_else(self, scrutinee_ty as Type*, arms);

        if (needs_if_else) {
            for (let i = 0; i < vec_size(arms); i = i + 1) {
                let arm = ptr_vec_get(arms, i) as CaseArm*;
                let cond = "";
                if (type_is_builtin(scrutinee_ty as Type*, "string")) {
                    let c_literal = be_emit_case_literal(self, arm.literal, scrutinee_ty as Type*);
                    cond = cem_emit_string_equals_call("_scrutinee", c_literal);
                } else if (be_case_literal_is_always_false(self, scrutinee_ty as Type*, arm.literal)) {
                    cond = "false";
                } else {
                    let c_literal2 = be_emit_case_literal(self, arm.literal, scrutinee_ty as Type*);
                    cond = "_scrutinee == " + c_literal2;
                }
                if (i == 0) {
                    cem_emit_if_header(self.emitter, cond);
                } else {
                    cem_emit_else(self.emitter);
                    cem_emit_if_header(self.emitter, cond);
                }
                cem_emit_block_start(self.emitter);
                let arm_scope = be_push_scope(self);
                self.next_stmt_unreachable = false;
                be_emit_stmt(self, arm.body);
                if (!self.next_stmt_unreachable) {
                    be_emit_cleanup_at_scope_exit(self, arm_scope);
                } else {
                    unreachable_arms = unreachable_arms + 1;
                }
                be_pop_scope(self);
                cem_emit_block_end(self.emitter);
            }
            if (stmt.case_else != null) {
                cem_emit_else(self.emitter);
                cem_emit_block_start(self.emitter);
                let else_scope = be_push_scope(self);
                self.next_stmt_unreachable = false;
                be_emit_stmt(self, (stmt.case_else as CaseElse*).body);
                if (!self.next_stmt_unreachable) {
                    be_emit_cleanup_at_scope_exit(self, else_scope);
                } else {
                    unreachable_arms = unreachable_arms + 1;
                }
                be_pop_scope(self);
                cem_emit_block_end(self.emitter);
            }
        } else {
            cem_emit_switch_start(self.emitter, "_scrutinee");
            for (let i = 0; i < vec_size(arms); i = i + 1) {
                let arm = ptr_vec_get(arms, i) as CaseArm*;
                cem_emit_case_label(self.emitter, be_emit_case_literal(self, arm.literal, scrutinee_ty as Type*));
                cem_emit_block_start(self.emitter);
                let arm_scope = be_push_scope(self);
                self.next_stmt_unreachable = false;
                be_emit_stmt(self, arm.body);
                if (!self.next_stmt_unreachable) {
                    be_emit_cleanup_at_scope_exit(self, arm_scope);
                    cem_emit_exit_switch(self.emitter);
                } else {
                    unreachable_arms = unreachable_arms + 1;
                }
                be_pop_scope(self);
                cem_emit_block_end(self.emitter);
            }
            if (stmt.case_else != null) {
                cem_emit_default_label(self.emitter);
                cem_emit_block_start(self.emitter);
                let else_scope2 = be_push_scope(self);
                self.next_stmt_unreachable = false;
                be_emit_stmt(self, (stmt.case_else as CaseElse*).body);
                if (!self.next_stmt_unreachable) {
                    be_emit_cleanup_at_scope_exit(self, else_scope2);
                    cem_emit_exit_switch(self.emitter);
                } else {
                    unreachable_arms = unreachable_arms + 1;
                }
                be_pop_scope(self);
                cem_emit_block_end(self.emitter);
            }
            cem_emit_switch_end(self.emitter);
        }

        self.next_stmt_unreachable = stmt.case_else != null && unreachable_arms == total_arms;
        if (!self.next_stmt_unreachable) {
            be_emit_cleanup_at_scope_exit(self, outer_scope);
        } else {
            cem_emit_unreachable_marker(self.emitter, "'case'");
        }
        be_pop_scope(self);
        cem_emit_block_end(self.emitter);
    }
}

/**
 * Emit one inline `with` header item and register cleanup at the committed point.
 *
 * @param self Backend state to update.
 * @param item Parsed inline with item.
 * @param with_scope Scope carrying inline cleanup state.
 */
func be_emit_inline_with_header_item(self: Backend*, item: WithItem*, with_scope: ScopeContext*) {
    let init_stmt = stmt_arena_get(be_current_stmt_arena(self), item.init);
    if (!item.has_cleanup || item.cleanup_stmt < 0) {
        be_emit_stmt(self, item.init);
        return;
    }

    if (ord(init_stmt.kind) == ord(ST_RETURN)) {
        be_emit_return_stmt_with_inline_cleanup(self, init_stmt, with_scope, item.cleanup_stmt);
        return;
    }

    if (ord(init_stmt.kind) == ord(ST_BREAK) || ord(init_stmt.kind) == ord(ST_CONTINUE)) {
        be_register_inline_with_cleanup(with_scope, item);
        be_emit_stmt(self, item.init);
        return;
    }

    be_emit_stmt(self, item.init);
    be_register_inline_with_cleanup(with_scope, item);
}

/**
 * Emit a `with` statement.
 *
 * @param self Backend state to update.
 * @param stmt Parsed with statement.
 */
func be_emit_with_stmt(self: Backend*, stmt: StmtNode*) {
    cem_emit_block_start(self.emitter);
    let with_scope = be_push_scope(self);
    if (stmt.stmt_b >= 0) {
        with_scope.with_cleanup_block = stmt.stmt_b;
    }

    let items = stmt.with_items as VectorBase*;
    if (stmt.stmt_b >= 0) {
        with (let predecl_types = spm_create() => be_type_ptr_map_temp_free(predecl_types)) {
            for (let i = 0; i < vec_size(items); i = i + 1) {
                let item = ptr_vec_get(items, i) as WithItem*;
                let init_stmt = stmt_arena_get(be_current_stmt_arena(self), item.init);
                if (ord(init_stmt.kind) == ord(ST_LET)) {
                    let predecl_ty = be_emit_with_cleanup_header_let_predecl(self, init_stmt);
                    if (predecl_ty != null) {
                        spm_put(predecl_types, int_to_string(i), predecl_ty as void*);
                    }
                }
            }

            for (let item_i = 0; item_i < vec_size(items); item_i = item_i + 1) {
                let item = ptr_vec_get(items, item_i) as WithItem*;
                let init_stmt = stmt_arena_get(be_current_stmt_arena(self), item.init);
                let predecl_ty = spm_get(predecl_types, int_to_string(item_i));
                if (predecl_ty != null && ord(init_stmt.kind) == ord(ST_LET)) {
                    be_emit_with_cleanup_header_let_assign(self, init_stmt, predecl_ty as Type*);
                } else {
                    be_emit_stmt(self, item.init);
                }
            }
        }
    } else {
        for (let i = 0; i < vec_size(items); i = i + 1) {
            let item = ptr_vec_get(items, i) as WithItem*;
            be_emit_inline_with_header_item(self, item, with_scope);
        }
    }

    cem_emit_block_start(self.emitter);
    let body_scope = be_push_scope(self);
    be_emit_block_sequence(self, stmt.stmt_a);
    let body_unreachable = self.next_stmt_unreachable;
    if (!body_unreachable) {
        be_emit_cleanup_at_scope_exit(self, body_scope);
    }
    be_pop_scope(self);
    cem_emit_block_end(self.emitter);

    if (!body_unreachable) {
        be_emit_with_cleanup_from_scope(self, with_scope);
        be_emit_cleanup_at_scope_exit(self, with_scope);
    }
    self.next_stmt_unreachable = body_unreachable;
    be_pop_scope(self);
    cem_emit_block_end(self.emitter);
}

/**
 * Emit one block body sequence without outer braces.
 *
 * @param self Backend state to update.
 * @param block_id Block statement id.
 */
func be_emit_block_sequence(self: Backend*, block_id: StmtId) {
    self.next_stmt_unreachable = false;
    let block = stmt_arena_get(be_current_stmt_arena(self), block_id);
    if (ord(block.kind) != ord(ST_BLOCK) || block.ids == null) {
        return;
    }

    let ids = block.ids as VectorBase*;
    for (let i = 0; i < vec_size(ids); i = i + 1) {
        if (self.next_stmt_unreachable) {
            cem_emit_unreachable_comment(self.emitter);
            self.next_stmt_unreachable = false;
        }
        be_emit_stmt(self, id_vec_get(ids, i));
    }
}

/**
 * Emit one lexical block statement.
 *
 * @param self Backend state to update.
 * @param stmt_id Block statement id.
 */
func be_emit_block_stmt(self: Backend*, stmt_id: StmtId) {
    cem_emit_block_start(self.emitter);
    let block_scope = be_push_scope(self);
    be_emit_block_sequence(self, stmt_id);
    if (!self.next_stmt_unreachable) {
        be_emit_cleanup_at_scope_exit(self, block_scope);
    }
    be_pop_scope(self);
    cem_emit_block_end(self.emitter);
}

/**
 * Emit a statement body inside an already-created lexical scope.
 *
 * @param self Backend state to update.
 * @param stmt_id Body statement id.
 */
func be_emit_scoped_stmt_body(self: Backend*, stmt_id: StmtId) {
    let stmt = stmt_arena_get(be_current_stmt_arena(self), stmt_id);
    if (ord(stmt.kind) == ord(ST_BLOCK)) {
        be_emit_block_sequence(self, stmt_id);
    } else {
        be_emit_stmt(self, stmt_id);
    }
}

/**
 * Emit control flow for one statement condition with short-circuit semantics.
 *
 * ARC temps produced while lowering condition leaves stay inside the emitted
 * condition block instead of being hoisted into an enclosing control-flow
 * header.
 *
 * @param self Backend state to update.
 * @param expr_id Condition expression to lower.
 * @param true_label Jump target when the condition is true.
 * @param false_label Jump target when the condition is false.
 */
func be_emit_condition_branch(self: Backend*, expr_id: ExprId, true_label: string, false_label: string) {
    let expr = expr_arena_get(be_current_expr_arena(self), expr_id);

    if (ord(expr.kind) == ord(EX_PAREN)) {
        be_emit_condition_branch(self, expr.expr_a, true_label, false_label);
        return;
    }

    if (ord(expr.kind) == ord(EX_BINARY) && expr.text_value == "&&") {
        let rhs_label = be_fresh_label(self, "cond_rhs");
        be_emit_condition_branch(self, expr.expr_a, rhs_label, false_label);
        cem_emit_label(self.emitter, rhs_label);
        be_emit_condition_branch(self, expr.expr_b, true_label, false_label);
        return;
    }

    if (ord(expr.kind) == ord(EX_BINARY) && expr.text_value == "||") {
        let rhs_label2 = be_fresh_label(self, "cond_rhs");
        be_emit_condition_branch(self, expr.expr_a, true_label, rhs_label2);
        cem_emit_label(self.emitter, rhs_label2);
        be_emit_condition_branch(self, expr.expr_b, true_label, false_label);
        return;
    }

    cem_emit_block_start(self.emitter);
    let leaf_scope = be_push_scope(self);
    let c_cond = be_emit_condition_expr(self, expr_id);
    cem_emit_if_header(self.emitter, c_cond);
    cem_emit_block_start(self.emitter);
    be_emit_cleanup_at_scope_exit(self, leaf_scope);
    cem_emit_goto(self.emitter, true_label);
    cem_emit_block_end(self.emitter);
    be_emit_cleanup_at_scope_exit(self, leaf_scope);
    be_pop_scope(self);
    cem_emit_block_end(self.emitter);
    cem_emit_goto(self.emitter, false_label);
}

/**
 * Evaluate one statement condition into a stable boolean temp.
 *
 * The returned temp is safe to reference from an `if`/`while` header because
 * condition ARC temps are scoped to the emitted condition block and cleaned
 * before control continues.
 *
 * @param self Backend state to update.
 * @param expr_id Condition expression to lower.
 * @return Name of the generated boolean temp.
 */
func be_emit_condition_value(self: Backend*, expr_id: ExprId) -> string {
    let cond_tmp = cem_fresh_tmp(self.emitter, "cond");
    with (let bool_ty = type_builtin_bool() => type_free(bool_ty)) {
        cem_emit_temp_decl(self.emitter, cem_emit_type(bool_ty), cond_tmp, cem_emit_bool_literal(false));
    }

    let true_label = be_fresh_label(self, "cond_true");
    let false_label = be_fresh_label(self, "cond_false");
    let end_label = be_fresh_label(self, "cond_end");

    cem_emit_block_start(self.emitter);
    be_emit_condition_branch(self, expr_id, true_label, false_label);
    cem_emit_label(self.emitter, true_label);
    cem_emit_assignment(self.emitter, cond_tmp, cem_emit_bool_literal(true));
    cem_emit_goto(self.emitter, end_label);
    cem_emit_label(self.emitter, false_label);
    cem_emit_label(self.emitter, end_label);
    cem_emit_block_end(self.emitter);
    return cond_tmp;
}

/**
 * Emit one `if` branch and report whether it ends unreachable.
 *
 * @param self Backend state to update.
 * @param stmt_id Statement id for the branch.
 * @return `true` when control cannot fall through the branch.
 */
func be_emit_if_branch(self: Backend*, stmt_id: StmtId) -> bool {
    let branch = stmt_arena_get(be_current_stmt_arena(self), stmt_id);
    self.next_stmt_unreachable = false;
    if (ord(branch.kind) == ord(ST_BLOCK)) {
        be_emit_block_stmt(self, stmt_id);
    } else {
        cem_emit_block_start(self.emitter);
        let branch_scope = be_push_scope(self);
        be_emit_stmt(self, stmt_id);
        if (!self.next_stmt_unreachable) {
            be_emit_cleanup_at_scope_exit(self, branch_scope);
        }
        be_pop_scope(self);
        cem_emit_block_end(self.emitter);
    }
    return self.next_stmt_unreachable;
}

/**
 * Emit one statement.
 *
 * @param self Backend state to update.
 * @param stmt_id Statement id to lower.
 */
func be_emit_stmt(self: Backend*, stmt_id: StmtId) {
    if (stmt_id < 0) {
        return;
    }

    let stmt = stmt_arena_get(be_current_stmt_arena(self), stmt_id);
    be_emit_line_directive(self, stmt.span);

    match (stmt.kind) {
        ST_BLOCK => {
            be_emit_block_stmt(self, stmt_id);
        }
        ST_LET => {
            let var_ty: Type*? = null;
            if (stmt.type_ref != null) {
                var_ty = be_resolve_type_ref(self, stmt.type_ref as TypeRef*);
            }
            if (var_ty == null) {
                var_ty = be_expr_type(self, stmt.expr_a);
            }
            if (var_ty == null) {
                be_ice("[ICE-1170] missing inferred type for let initializer '" + stmt.name + "'");
            }
            let c_name = cem_mangle_identifier(stmt.name);
            let c_type = cem_emit_type(var_ty as Type*);
            let c_init = be_emit_owned_expr_with_expected_type(self, stmt.expr_a, var_ty as Type*);
            cem_emit_let_decl(self.emitter, c_type, c_name, c_init);
            if (self.current_scope != null) {
                if (analysis_has_arc_data(self.result, var_ty as Type*)) {
                    sc_add_owned(self.current_scope as ScopeContext*, c_name, var_ty as Type*);
                } else {
                    sc_add_declared(self.current_scope as ScopeContext*, c_name, var_ty as Type*);
                }
            }
            self.next_stmt_unreachable = false;
            type_free(var_ty as Type*);
        }
        ST_ASSIGN => {
            with (let dst_ty = be_expr_type(self, stmt.expr_a) => type_free_opt(dst_ty)) {
                if (dst_ty == null) {
                    be_ice("[ICE-1240] missing inferred type for assignment");
                }
                let c_target = be_emit_lvalue(self, stmt.expr_a);
                let c_value = be_emit_owned_expr_with_expected_type(self, stmt.expr_b, dst_ty as Type*);
                if (analysis_has_arc_data(self.result, dst_ty as Type*)) {
                    let temp = cem_fresh_tmp(self.emitter, "tmp");
                    cem_emit_temp_decl(self.emitter, cem_emit_type(dst_ty as Type*), temp, c_value);
                    be_emit_value_cleanup(self, c_target, dst_ty as Type*);
                    cem_emit_assignment(self.emitter, c_target, temp);
                } else {
                    cem_emit_assignment(self.emitter, c_target, c_value);
                }
                self.next_stmt_unreachable = false;
            }
        }
        ST_EXPR => {
            if (ord(expr_arena_get(be_current_expr_arena(self), stmt.expr_a).kind) == ord(EX_NULL)) {
                cem_emit_comment(self.emitter, "null literal");
                self.next_stmt_unreachable = false;
                return;
            }
            let c_expr = be_emit_expr(self, stmt.expr_a);
            with (let expr_ty = be_expr_type(self, stmt.expr_a) => type_free_opt(expr_ty)) {
                if (expr_ty != null && be_should_materialize_arc_temp(self, stmt.expr_a, expr_ty as Type*)) {
                    be_materialize_arc_temp(self, c_expr, expr_ty as Type*);
                } else if (expr_ty != null &&
                           ord(expr_arena_get(be_current_expr_arena(self), stmt.expr_a).kind) == ord(EX_TRY) &&
                           !analysis_has_arc_data(self.result, expr_ty as Type*)) {
                    cem_emit_expr_stmt(self.emitter, cem_emit_discard_expr(c_expr));
                } else {
                    cem_emit_expr_stmt(self.emitter, c_expr);
                }
            }
            self.next_stmt_unreachable = false;
        }
        ST_IF => {
            let c_cond = be_emit_condition_value(self, stmt.expr_a);
            cem_emit_if_header(self.emitter, c_cond);
            let then_unreachable = be_emit_if_branch(self, stmt.stmt_a);

            if (stmt.stmt_b >= 0) {
                cem_emit_else(self.emitter);
                let else_unreachable = be_emit_if_branch(self, stmt.stmt_b);
                self.next_stmt_unreachable = then_unreachable && else_unreachable;
            } else {
                self.next_stmt_unreachable = false;
            }
        }
        ST_WHILE => {
            let break_label = be_fresh_label(self, "lbrk");
            let continue_label = be_fresh_label(self, "lcont");
            be_push_loop_labels(self, break_label, continue_label);
            cem_emit_while_header(self.emitter, cem_emit_bool_literal(true));
            cem_emit_block_start(self.emitter);
            let c_cond = be_emit_condition_value(self, stmt.expr_a);
            cem_emit_if_header(self.emitter, cem_emit_negated_condition(c_cond));
            cem_emit_block_start(self.emitter);
            cem_emit_goto(self.emitter, break_label);
            cem_emit_block_end(self.emitter);
            let loop_scope = be_push_scope(self);
            be_push_loop_cleanup_scopes(self, loop_scope, loop_scope);
            be_emit_scoped_stmt_body(self, stmt.stmt_a);
            if (!self.next_stmt_unreachable) {
                be_emit_cleanup_at_scope_exit(self, loop_scope);
            }
            cem_emit_label(self.emitter, continue_label);
            be_pop_loop_cleanup_scopes(self);
            be_pop_scope(self);
            cem_emit_block_end(self.emitter);
            cem_emit_label(self.emitter, break_label);
            be_pop_loop_labels(self);
            self.next_stmt_unreachable = false;
        }
        ST_FOR => {
            let break_label2 = be_fresh_label(self, "lbrk");
            let continue_label2 = be_fresh_label(self, "lcont");
            let outer_scope = be_push_scope(self);
            cem_emit_for_loop_start(self.emitter);
            if (stmt.stmt_a >= 0) {
                be_emit_stmt(self, stmt.stmt_a);
            }

            be_push_loop_labels(self, break_label2, continue_label2);
            cem_emit_while_header(self.emitter, cem_emit_bool_literal(true));
            cem_emit_block_start(self.emitter);
            if (stmt.expr_a >= 0) {
                let c_cond2 = be_emit_condition_value(self, stmt.expr_a);
                cem_emit_if_header(self.emitter, cem_emit_negated_condition(c_cond2));
                cem_emit_block_start(self.emitter);
                cem_emit_goto(self.emitter, break_label2);
                cem_emit_block_end(self.emitter);
            }
            cem_emit_block_start(self.emitter);
            let loop_scope2 = be_push_scope(self);
            be_push_loop_cleanup_scopes(self, loop_scope2, loop_scope2);
            be_emit_scoped_stmt_body(self, stmt.stmt_c);
            let body_falls_through = !self.next_stmt_unreachable;
            if (body_falls_through) {
                be_emit_cleanup_at_scope_exit(self, loop_scope2);
            }
            be_pop_loop_cleanup_scopes(self);
            be_pop_scope(self);
            cem_emit_block_end(self.emitter);
            self.next_stmt_unreachable = false;
            cem_emit_label(self.emitter, continue_label2);
            be_pop_loop_labels(self);
            if (stmt.stmt_b >= 0) {
                be_emit_stmt(self, stmt.stmt_b);
            }
            cem_emit_block_end(self.emitter);
            self.next_stmt_unreachable = false;
            cem_emit_label(self.emitter, break_label2);
            be_emit_cleanup_at_scope_exit(self, outer_scope);
            be_pop_scope(self);
            cem_emit_for_loop_end(self.emitter);
            self.next_stmt_unreachable = false;
        }
        ST_RETURN => {
            be_emit_return_stmt_with_inline_cleanup(self, stmt, null, invalid_stmt_id());
        }
        ST_DROP => {
            be_emit_drop_stmt(self, stmt);
        }
        ST_MATCH => {
            be_emit_match_stmt(self, stmt);
        }
        ST_CASE => {
            be_emit_case_stmt(self, stmt);
        }
        ST_BREAK => {
            if (self.current_loop_labels == null) {
                be_ice("[ICE-1020] break/continue outside of loop");
            }
            be_emit_cleanup_for_loop_exit(self, true);
            cem_emit_goto(self.emitter, (self.current_loop_labels as LoopLabels*).break_label);
            self.next_stmt_unreachable = true;
        }
        ST_CONTINUE => {
            if (self.current_loop_labels == null) {
                be_ice("[ICE-1020] break/continue outside of loop");
            }
            be_emit_cleanup_for_loop_exit(self, false);
            cem_emit_goto(self.emitter, (self.current_loop_labels as LoopLabels*).continue_label);
            self.next_stmt_unreachable = true;
        }
        ST_WITH => {
            be_emit_with_stmt(self, stmt);
        }
    }
}

/**
 * Check whether the statement sub-tree at `stmt_id` syntactically reassigns
 * `param_name` via a bare `VarRef` target of an `ST_ASSIGN`. Used by the
 * function-prologue emitter to decide whether to defensively retain an
 * ARC-typed parameter on entry.
 *
 * @param self Backend state.
 * @param stmt_id Root statement id, or negative when absent.
 * @param param_name Source-level parameter name to match against assignment targets.
 * @return `true` when any reachable `ST_ASSIGN` targets a bare `VarRef` with that name.
 */
func be_body_reassigns_param(self: Backend*, stmt_id: StmtId, param_name: string) -> bool {
    if (stmt_id < 0) {
        return false;
    }
    let stmt = stmt_arena_get(be_current_stmt_arena(self), stmt_id);
    match (stmt.kind) {
        ST_ASSIGN => {
            let target = expr_arena_get(be_current_expr_arena(self), stmt.expr_a);
            if (ord(target.kind) == ord(EX_VAR_REF) && target.text_value == param_name) {
                return true;
            }
            return false;
        }
        ST_BLOCK => {
            if (stmt.ids == null) {
                return false;
            }
            let ids = stmt.ids as VectorBase*;
            for (let i = 0; i < vec_size(ids); i = i + 1) {
                if (be_body_reassigns_param(self, id_vec_get(ids, i), param_name)) {
                    return true;
                }
            }
            return false;
        }
        ST_IF => {
            if (be_body_reassigns_param(self, stmt.stmt_a, param_name)) { return true; }
            return be_body_reassigns_param(self, stmt.stmt_b, param_name);
        }
        ST_WHILE => {
            return be_body_reassigns_param(self, stmt.stmt_a, param_name);
        }
        ST_FOR => {
            if (be_body_reassigns_param(self, stmt.stmt_a, param_name)) { return true; }
            if (be_body_reassigns_param(self, stmt.stmt_b, param_name)) { return true; }
            return be_body_reassigns_param(self, stmt.stmt_c, param_name);
        }
        ST_MATCH => {
            if (stmt.match_arms == null) {
                return false;
            }
            let arms = stmt.match_arms as VectorBase*;
            for (let i = 0; i < vec_size(arms); i = i + 1) {
                let arm = ptr_vec_get(arms, i) as MatchArm*;
                if (be_body_reassigns_param(self, arm.body, param_name)) {
                    return true;
                }
            }
            return false;
        }
        ST_CASE => {
            if (stmt.case_arms != null) {
                let arms = stmt.case_arms as VectorBase*;
                for (let i = 0; i < vec_size(arms); i = i + 1) {
                    let arm = ptr_vec_get(arms, i) as CaseArm*;
                    if (be_body_reassigns_param(self, arm.body, param_name)) {
                        return true;
                    }
                }
            }
            if (stmt.case_else != null) {
                let else_arm = stmt.case_else as CaseElse*;
                if (be_body_reassigns_param(self, else_arm.body, param_name)) {
                    return true;
                }
            }
            return false;
        }
        ST_WITH => {
            if (stmt.with_items != null) {
                let items = stmt.with_items as VectorBase*;
                for (let i = 0; i < vec_size(items); i = i + 1) {
                    let item = ptr_vec_get(items, i) as WithItem*;
                    if (be_body_reassigns_param(self, item.init, param_name)) {
                        return true;
                    }
                    if (item.has_cleanup && be_body_reassigns_param(self, item.cleanup_stmt, param_name)) {
                        return true;
                    }
                }
            }
            if (be_body_reassigns_param(self, stmt.stmt_a, param_name)) { return true; }
            return be_body_reassigns_param(self, stmt.stmt_b, param_name);
        }
        _ => { return false; }
    }
}

/**
 * Emit all non-extern function definitions.
 *
 * @param self Backend state to update.
 */
func be_emit_function_definitions(self: Backend*) {
    if (self.result.signatures == null) {
        return;
    }

    cem_emit_section_comment(self.emitter, "Function definitions");
    for (let i = 0; i < driver_unit_count(self.result.driver_state); i = i + 1) {
        let unit = driver_unit_get(self.result.driver_state, i);
        if (unit.parse_result.root_module == null) {
            continue;
        }

        let root = unit.parse_result.root_module as Module*;
        if (!be_emits_module_definitions(self, root.name)) {
            continue;
        }
        self.current_module = root.name;
        self.current_unit = unit;
        self.current_env = be_find_env(self, root.name);
        cem_emit_module_separator(self.emitter, root.name);

        for (let j = 0; j < vec_size(root.decls); j = j + 1) {
            let top = ptr_vec_get(root.decls, j) as TopLevelDecl*;
            if (ord(top.kind) != ord(TD_FUNC)) {
                continue;
            }
            let decl = top.data as FuncDecl*;
            if (decl.is_extern) {
                continue;
            }

            let func_type = sig_lookup_func_type(self.result.signatures as SignatureTables*, root.name, decl.name);
            if (func_type == null) {
                be_ice("[ICE-1150] missing FuncType for " + root.name + "." + decl.name);
            }

            be_emit_line_directive(self, decl.span);
            cem_emit_function_definition_header(self.emitter, root.name, decl, func_type as Type*,
                be_is_symbol_exported(self, root.name, decl.name));
            self.current_func_result = (func_type as Type*).result as Type*;
            let func_scope = be_push_scope(self);
            for (let p = 0; p < vec_size(decl.params); p = p + 1) {
                let param_decl = ptr_vec_get(decl.params, p) as Param*;
                let param_ty = ptr_vec_get((func_type as Type*).params as VectorBase*, p) as Type*;
                let c_param_name = cem_mangle_identifier(param_decl.name);
                if (analysis_has_arc_data(self.result, param_ty) &&
                    be_body_reassigns_param(self, decl.body, param_decl.name)) {
                    be_emit_retain_for_copied_value(self, c_param_name, param_ty);
                    sc_add_owned(func_scope, c_param_name, param_ty);
                } else {
                    sc_add_declared(func_scope, c_param_name, param_ty);
                }
            }
            be_emit_block_sequence(self, decl.body);
            if (!self.next_stmt_unreachable) {
                be_emit_cleanup_at_scope_exit(self, func_scope);
            }
            be_pop_scope(self);
            self.current_func_result = null;
            cem_emit_function_definition_footer(self.emitter);
        }
    }
}

/**
 * Return the resolved type of the source `main` definition that owns
 * `I5entry`, or `null` when this module has no entry bridge.
 *
 * This is the single predicate shared by metadata flags and bridge emission.
 *
 * @param self Backend state to inspect.
 * @param root Selected source module.
 * @return Borrowed zero-parameter source-main type, or `null`.
 */
func be_module_entry_type(self: Backend*, root: Module*) -> Type*? {
    if (self.result.signatures == null) {
        return null;
    }

    for (let i = 0; i < vec_size(root.decls); i = i + 1) {
        let top = ptr_vec_get(root.decls, i) as TopLevelDecl*;
        if (ord(top.kind) != ord(TD_FUNC)) {
            continue;
        }
        let decl = top.data as FuncDecl*;
        if (decl.name != "main" || decl.is_extern) {
            continue;
        }
        let func_type = sig_lookup_func_type(self.result.signatures as SignatureTables*, root.name, decl.name);
        if (func_type == null) {
            be_ice("[ICE-1150] missing FuncType for " + root.name + "." + decl.name);
        }
        if (vec_size((func_type as Type*).params as VectorBase*) != 0) {
            return null;
        }
        return func_type as Type*;
    }
    return null;
}

/**
 * Emit `I5entry` for the selected module's already-resolved entry type.
 *
 * @param self Backend state to update.
 * @param root Selected source module.
 * @param entry_type Borrowed entry type returned by `be_module_entry_type`.
 */
func be_emit_module_entry_bridge_if_needed(self: Backend*, root: Module*, entry_type: Type*?) {
    if (entry_type == null) {
        return;
    }
    cem_emit_section_comment(self.emitter, "Module entry bridge");
    cem_emit_module_entry_bridge(self.emitter, root.name, entry_type as Type*);
}

/**
 * Emit the selected module's identity and unique ordered direct-import records.
 *
 * Fingerprints come from the already selected graph providers. Virtual
 * compiler modules do not become standalone object dependencies.
 *
 * @param self Backend state to update.
 * @param root Selected source module.
 * @param has_entry Whether this exact output will define `I5entry`.
 */
func be_emit_module_object_metadata(self: Backend*, root: Module*, has_entry: bool) {
    let graph = driver_graph(self.result.driver_state);
    let target_opt = mg_find_node(graph, root.name);
    if (target_opt == null) {
        be_ice("[ICE-1373] missing graph node for module metadata: " + root.name);
    }
    let target = target_opt as ModuleGraphNode*;
    if (ord(target.origin.kind) != ord(MOK_SOURCE) ||
        ord(mg_node_state(target)) != ord(MNS_RESOLVED)) {
        be_ice("[ICE-1374] module metadata target is not a resolved source: " + root.name);
    }

    let fingerprint = mi_compute_provider_fingerprint(self.result, root.name);
    if (!om_fingerprint_is_valid(fingerprint)) {
        be_ice("[ICE-1375] invalid module metadata fingerprint for " + root.name);
    }

    with (let provider_names = sv_create(mg_node_direct_import_count(target)) => sv_free(provider_names),
          let provider_fingerprints = sv_create(mg_node_direct_import_count(target)) => sv_free(provider_fingerprints),
          let seen = ss_create() => ss_free(seen)) {
        for (let i = 0; i < mg_node_direct_import_count(target); i = i + 1) {
            let provider_name = mg_node_direct_import_get(target, i);
            let provider_opt = mg_find_node(graph, provider_name);
            if (provider_opt == null) {
                be_ice("[ICE-1376] missing direct-import graph node for " + root.name + ": " + provider_name);
            }
            let provider = provider_opt as ModuleGraphNode*;
            if (ord(provider.origin.kind) == ord(MOK_VIRTUAL)) {
                continue;
            }
            if (ord(mg_node_state(provider)) != ord(MNS_RESOLVED)) {
                be_ice("[ICE-1377] unresolved direct-import graph node for " + root.name + ": " + provider_name);
            }
            if (!ss_add(seen, provider_name)) {
                continue;
            }
            let provider_fingerprint = mi_compute_provider_fingerprint(self.result, provider_name);
            if (!om_fingerprint_is_valid(provider_fingerprint)) {
                be_ice("[ICE-1378] invalid direct-import fingerprint for " + root.name + ": " + provider_name);
            }
            sv_push(provider_names, provider_name);
            sv_push(provider_fingerprints, provider_fingerprint);
        }

        let identity_opt = om_encode_identity(root.name, fingerprint, has_entry);
        let imports_opt = om_encode_imports(provider_names, provider_fingerprints);
        if (identity_opt == null || imports_opt == null) {
            be_ice("[ICE-1379] failed to encode module object metadata for " + root.name);
        }
        cem_emit_module_object_metadata(
            self.emitter,
            root.name,
            identity_opt as string,
            imports_opt as string
        );
    }
}

/**
 * Emit the C `main()` wrapper when the entry module defines `main`.
 *
 * @param self Backend state to update.
 * @param has_global_init Whether to call the hidden init chain before user `main`.
 */
func be_emit_main_wrapper_if_needed(self: Backend*, has_global_init: bool) {
    if (is_empty_s(self.result.driver_state.entry_module) || self.result.signatures == null) {
        return;
    }

    let func_type = sig_lookup_func_type(self.result.signatures as SignatureTables*, self.result.driver_state.entry_module,
        "main");
    if (func_type == null) {
        return;
    }
    cem_emit_main_wrapper(self.emitter, self.result.driver_state.entry_module, func_type as Type*, has_global_init,
        cem_global_init_name());
}

/**
 * Run the shared C-generation pipeline for one selected output boundary.
 *
 * @param self Backend state to update.
 * @return Complete generated C translation unit.
 */
func be_generate_output(self: Backend*) -> string {
    let target_root: Module*? = null;
    let target_entry_type: Type*? = null;
    if (be_is_module_output(self)) {
        target_root = be_target_root(self);
        self.required_type_keys = be_collect_required_type_keys(self, target_root as Module*);
        cem_set_module_type_keys(self.emitter, self.required_type_keys as StringSet*);
        target_entry_type = be_module_entry_type(self, target_root as Module*);
    }

    log_stage(self.cfg, "Generating C code", "");
    log_debug(self.cfg, "Preparing optional wrapper types");
    cem_prepare_optional_wrappers(self.emitter);
    be_prepare_variadic_pack_wrappers(self);
    log_debug(self.cfg, "Emitting header and forward declarations");
    cem_emit_header(self.emitter, self.opts);
    cem_emit_forward_decls(self.emitter);
    cem_emit_section_comment(self.emitter, "Optional wrapper types (builtins / early)");
    cem_emit_optional_wrappers(self.emitter, true);
    be_emit_type_definitions(self);
    cem_emit_section_comment(self.emitter, "Array wrapper types");
    cem_emit_array_wrappers(self.emitter);
    cem_emit_section_comment(self.emitter, "Slice descriptor types");
    cem_emit_slice_wrappers(self.emitter);
    cem_emit_section_comment(self.emitter, "Optional wrapper types (late)");
    cem_emit_optional_wrappers(self.emitter, false);
    cem_emit_section_comment(self.emitter, "Function pointer typedefs");
    cem_emit_func_ptr_typedefs(self.emitter);
    be_emit_let_declarations(self);
    be_emit_function_declarations(self);
    if (target_root != null) {
        be_emit_module_object_metadata(self, target_root as Module*, target_entry_type != null);
        be_emit_module_lifecycle_functions(self, target_root as Module*);
        be_emit_function_definitions(self);
        be_emit_module_entry_bridge_if_needed(self, target_root as Module*, target_entry_type);
    } else {
        let has_global_init = be_emit_top_level_init_functions(self);
        be_emit_function_definitions(self);
        be_emit_main_wrapper_if_needed(self, has_global_init);
    }
    return cem_get_output(self.emitter);
}

/**
 * Generate legacy whole-program C source from a typed analysis result.
 *
 * @param result Typed analysis result to lower.
 * @param opts Codegen options to honor.
 * @param cfg Logging configuration to use.
 * @return Complete generated C translation unit.
 */
func backend_generate(result: AnalysisResult*, opts: CodegenOptions*, cfg: LogConfig*) -> string {
    if (analysis_has_errors(result)) {
        be_ice("[ICE-9303] backend_generate requires analysis without errors");
    }

    with (let self = be_create(result, opts, cfg) => be_free(self)) {
        return be_generate_output(self);
    }
}

/**
 * Generate C source defining exactly one source-backed module.
 *
 * @param result Typed analysis result to lower.
 * @param target_module Canonical source module whose definitions to emit.
 * @param opts Codegen options to honor.
 * @param cfg Logging configuration to use.
 * @return Complete generated module translation unit.
 */
func backend_generate_module(
    result: AnalysisResult*,
    target_module: string,
    opts: CodegenOptions*,
    cfg: LogConfig*
) -> string {
    if (analysis_has_errors(result)) {
        be_ice("[ICE-9303] backend_generate_module requires analysis without errors");
    }

    with (let self = be_create_module(result, target_module, opts, cfg) => be_free(self)) {
        return be_generate_output(self);
    }
}
