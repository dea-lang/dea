/**
 * Emit a function-call expression.
 *
 * @param c_func_name Function expression.
 * @param c_args Comma-separated lowered arguments.
 * @return Function-call expression.
 */
func cem_emit_function_call(c_func_name: string, c_args: string) -> string {
    return c_func_name + "(" + c_args + ")";
}

/**
 * Emit a field-access expression.
 *
 * @param c_obj Object expression.
 * @param field_name Field identifier.
 * @param is_pointer Whether the object is a pointer.
 * @return Field-access expression using `.` or `->`.
 */
func cem_emit_field_access(c_obj: string, field_name: string, is_pointer: bool) -> string {
    if (is_pointer) {
        return "(" + c_obj + ")->" + field_name;
    }
    return "(" + c_obj + ")." + field_name;
}

/**
 * Emit a parenthesized expression.
 *
 * @param c_inner Inner expression.
 * @return Parenthesized expression.
 */
func cem_emit_paren_expr(c_inner: string) -> string {
    return "(" + c_inner + ")";
}

/**
 * Emit a C cast expression.
 *
 * @param c_type Destination C type.
 * @param c_inner Inner expression.
 * @return Cast expression.
 */
func cem_emit_cast(c_type: string, c_inner: string) -> string {
    return "((" + c_type + ")(" + c_inner + "))";
}

/**
 * Emit a runtime-checked pointer access expression.
 *
 * Declares one static per-call-site cache slot so the runtime validates
 * repeated accesses from the same site with a single range check.
 *
 * @param self Emitter to update.
 * @param c_ptr_expr Pointer expression.
 * @param c_ptr_type Lowered pointer type.
 * @param c_required_size Required byte extent expression.
 * @param c_required_align Required alignment expression.
 * @param access_mode Runtime access mode expression.
 * @return Checked pointer expression.
 */
func cem_emit_checked_ptr_access(self: CEmitter*, c_ptr_expr: string, c_ptr_type: string, c_required_size: string, c_required_align: string, access_mode: string) -> string {
    let site = cem_fresh_tmp(self, "site");
    ccb_emit(self.out, "static _rt_ptr_site " + site + ";");
    cem_restore_active_line_directive(self);
    return "((" + c_ptr_type + ")_rt_check_ptr_site(&" + site + ", (void*)(" + c_ptr_expr + "), (dea_int)(" +
        c_required_size + "), (dea_int)(" + c_required_align + "), " + access_mode + ", __FILE__, __LINE__))";
}

/**
 * Emit a runtime-checked indexed pointer access expression.
 *
 * @param self Emitter to update.
 * @param c_base_expr Base pointer expression.
 * @param c_index_expr Index expression.
 * @param c_ptr_type Lowered pointer type.
 * @param c_element_size Element byte extent expression.
 * @param c_required_align Required alignment expression.
 * @param access_mode Runtime access mode expression.
 * @param allow_untracked Whether the base pointer may legitimately reference
 *        storage the allocation tracker does not know about.
 * @return Checked pointer expression.
 */
func cem_emit_checked_ptr_index_access(self: CEmitter*, c_base_expr: string, c_index_expr: string, c_ptr_type: string,
                                       c_element_size: string, c_required_align: string, access_mode: string,
                                       allow_untracked: bool) -> string {
    let mode_expr = access_mode;
    if (allow_untracked) {
        mode_expr = "(" + access_mode + " | _RT_ACCESS_UNTRACKED_OK)";
    }
    let site = cem_fresh_tmp(self, "site");
    ccb_emit(self.out, "static _rt_ptr_site " + site + ";");
    cem_restore_active_line_directive(self);
    return "((" + c_ptr_type + ")_rt_check_index_ptr_site(&" + site + ", (void*)(" + c_base_expr + "), (dea_int)(" +
        c_index_expr + "), (dea_int)(" + c_element_size + "), (dea_int)(" + c_required_align + "), " +
        mode_expr + ", __FILE__, __LINE__))";
}

/**
 * Emit a checked pointer to one complete object of the given C base type.
 *
 * @param self Emitter to update.
 * @param c_ptr_expr Pointer expression.
 * @param c_base_type Lowered pointee type.
 * @param access_mode Runtime access mode expression.
 * @return Checked pointer expression.
 */
func cem_emit_checked_ptr_access_for_base(self: CEmitter*, c_ptr_expr: string, c_base_type: string, access_mode: string) -> string {
    return cem_emit_checked_ptr_access(
        self,
        c_ptr_expr,
        c_base_type + "*",
        "sizeof(" + c_base_type + ")",
        "_RT_ALIGNOF(" + c_base_type + ")",
        access_mode
    );
}

/**
 * Emit the expression that validates and begins a generated drop.
 *
 * @param c_ptr_expr Pointer expression.
 * @param c_ptr_type Lowered pointer type.
 * @param c_required_size Required pointee byte extent.
 * @param c_required_align Required pointee alignment.
 * @return Checked pointer expression.
 */
func cem_emit_drop_begin_expr(c_ptr_expr: string, c_ptr_type: string, c_required_size: string,
                              c_required_align: string) -> string {
    return "((" + c_ptr_type + ")_rt_drop_begin_impl((void*)(" + c_ptr_expr + "), (dea_int)(" +
        c_required_size + "), (dea_int)(" + c_required_align + "), __FILE__, __LINE__))";
}

/**
 * Emit the runtime call that completes a generated drop.
 *
 * @param self Emitter to update.
 * @param c_ptr_expr Checked drop pointer expression.
 */
func cem_emit_drop_finish_call(self: CEmitter*, c_ptr_expr: string) {
    ccb_emit(self.out, "_rt_drop_finish_impl((void*)(" + c_ptr_expr + "), __FILE__, __LINE__);");
}

/**
 * Emit a checked narrowing cast call.
 *
 * @param c_dst_type Destination C type name.
 * @param c_inner Inner expression.
 * @return Runtime-call expression.
 */
func cem_emit_checked_narrow_cast(c_dst_type: string, c_inner: string) -> string {
    return "(_rt_narrow_" + c_dst_type + "(" + c_inner + "))";
}

func cem_emit_checked_signed_cast(c_dst_type: string, c_inner: string) -> string {
    return "(_rt_cast_" + c_dst_type + "_from_signed((dea_long)(" + c_inner + ")))";
}

func cem_emit_checked_unsigned_cast(c_dst_type: string, c_inner: string) -> string {
    return "(_rt_cast_" + c_dst_type + "_from_unsigned((dea_ulong)(" + c_inner + ")))";
}

/**
 * Emit an unwrap call for pointer-shaped nullable values.
 *
 * @param c_dst_type Destination C type.
 * @param c_inner Inner nullable expression.
 * @param type_str Human-readable source type.
 * @return Unwrap expression.
 */
func cem_emit_unwrap_ptr(c_dst_type: string, c_inner: string, type_str: string) -> string {
    return "((" + c_dst_type + ") _unwrap_ptr(" + c_inner + ", \"" + type_str + "\"))";
}

/**
 * Emit an unwrap call for wrapper-shaped nullable values.
 *
 * @param c_src_type Source wrapper type.
 * @param c_inner Inner nullable expression.
 * @param type_str Human-readable source type.
 * @return Unwrap expression.
 */
func cem_emit_unwrap_opt(c_src_type: string, c_inner: string, type_str: string) -> string {
    return "(((" + c_src_type + "*) _unwrap_opt(&(" + c_inner + "), \"" + type_str + "\"))->value)";
}

/**
 * Emit a null-equality check for wrapper-shaped nullable values.
 *
 * @param c_expr Wrapper expression.
 * @return Equality-check expression.
 */
func cem_emit_null_check_eq(c_expr: string) -> string {
    return "(!(" + cem_emit_optional_has_value(c_expr) + "))";
}

/**
 * Emit a null-inequality check for wrapper-shaped nullable values.
 *
 * @param c_expr Wrapper expression.
 * @return Inequality-check expression.
 */
func cem_emit_null_check_ne(c_expr: string) -> string {
    return cem_emit_optional_has_value(c_expr);
}

/**
 * Emit a pointer null comparison.
 *
 * @param c_expr Pointer expression.
 * @param op Comparison operator.
 * @return Comparison expression.
 */
func cem_emit_pointer_null_check(c_expr: string, op: string) -> string {
    return "(" + c_expr + " " + op + " NULL" + ")";
}

/**
 * Emit a top-level pointer null comparison for direct statement headers.
 *
 * @param c_expr Pointer expression.
 * @param op Comparison operator.
 * @return Non-parenthesized comparison expression.
 */
func cem_emit_condition_pointer_null_check(c_expr: string, op: string) -> string {
    return c_expr + " " + op + " NULL";
}

/**
 * Emit access to an optional wrapper's `has_value` flag.
 *
 * @param c_expr Wrapper expression.
 * @return Member-access expression.
 */
func cem_emit_optional_has_value(c_expr: string) -> string {
    return "(" + c_expr + ").has_value";
}

/**
 * Emit access to an optional wrapper's payload value.
 *
 * @param c_expr Wrapper expression.
 * @return Member-access expression.
 */
func cem_emit_optional_value(c_expr: string) -> string {
    return "(" + c_expr + ").value";
}

/**
 * Emit access to an enum tag.
 *
 * @param c_expr Enum expression.
 * @return Member-access expression.
 */
func cem_emit_enum_tag_access(c_expr: string) -> string {
    return "(" + c_expr + ").tag";
}

/**
 * Emit access to one enum payload field.
 *
 * @param c_expr Enum expression.
 * @param variant Active variant name.
 * @param field Field name.
 * @return Member-access expression.
 */
func cem_emit_enum_payload_field_access(c_expr: string, variant: string, field: string) -> string {
    return "(" + c_expr + ").data." + variant + "." + field;
}

/**
 * Emit the runtime string-equality helper call.
 *
 * @param lhs Left operand.
 * @param rhs Right operand.
 * @return Call expression.
 */
func cem_emit_string_equals_call(lhs: string, rhs: string) -> string {
    return "rt_string_equals(" + lhs + ", " + rhs + ")";
}

/**
 * Emit a string concatenation call via the runtime helper.
 *
 * @param lhs Left operand C expression.
 * @param rhs Right operand C expression.
 * @return Function-call expression.
 */
func cem_emit_string_concat_call(lhs: string, rhs: string) -> string {
    return "rt_string_concat(" + lhs + ", " + rhs + ")";
}


/**
 * Emits the inline equality check for a nullable non-pointer value.
 *
 * @param op The equality operator ("==" or "!=").
 * @param lhs The C expression for the left-hand side.
 * @param rhs The C expression for the right-hand side.
 * @param inner_ty The inner type of the nullable.
 * @return The parenthesized C expression for the equality check.
 */
func cem_emit_opt_equals_call(op: string, lhs: string, rhs: string, inner_ty: Type*) -> string {
    let cmp_inner = "";
    if (type_is_builtin(inner_ty, "string")) {
        cmp_inner = cem_emit_string_equals_call(lhs + ".value", rhs + ".value");
        if (op == "!=") {
            cmp_inner = cem_emit_unary_op("!", cmp_inner);
        }
    } else {
        cmp_inner = cem_emit_binary_op(op, lhs + ".value", rhs + ".value");
    }

    let hl = lhs + ".has_value";
    let hr = rhs + ".has_value";

    if (op == "==") {
        // ((!a.has_value && !b.has_value) || (a.has_value && b.has_value && a.value == b.value))
        let part1 = "((!" + hl + " && !" + hr;
        let part2 = ") || (" + hl + " && " + hr;
        return part1 + part2 + " && " + cmp_inner + "))";
    }

    // ((a.has_value != b.has_value) || (a.has_value && b.has_value && a.value != b.value))
    let part1 = "((" + hl + " != " + hr;
    let part2 = ") || (" + hl + " && " + hr;
    return part1 + part2 + " && " + cmp_inner + "))";
}

/**
 * Emit the runtime string-compare helper call plus a relational check.
 *
 * @param op Relational operator token.
 * @param lhs Left operand.
 * @param rhs Right operand.
 * @return Parenthesized comparison expression.
 */
func cem_emit_string_compare_call(op: string, lhs: string, rhs: string) -> string {
    return "(rt_string_compare(" + lhs + ", " + rhs + ") " + op + " 0)";
}

/**
 * Emit a top-level string relational check for direct statement headers.
 *
 * @param op Relational operator token.
 * @param lhs Left operand.
 * @param rhs Right operand.
 * @return Non-parenthesized comparison expression.
 */
func cem_emit_condition_string_compare_call(op: string, lhs: string, rhs: string) -> string {
    return "rt_string_compare(" + lhs + ", " + rhs + ") " + op + " 0";
}

/**
 * Emit a statement-context discard wrapper for an expression.
 *
 * @param c_expr Expression to discard.
 * @return Wrapped expression.
 */
func cem_emit_discard_expr(c_expr: string) -> string {
    return "(void)(" + c_expr + ")";
}

/**
 * Emit a dereference lvalue.
 *
 * @param ptr_expr Pointer expression.
 * @return Dereference lvalue text.
 */
func cem_emit_deref_lvalue(ptr_expr: string) -> string {
    return "(*" + ptr_expr + ")";
}

/**
 * Emit a field lvalue.
 *
 * @param obj Object expression.
 * @param field Field identifier.
 * @param is_pointer Whether the object is a pointer.
 * @return Lvalue field-access text.
 */
func cem_emit_field_lvalue(obj: string, field: string, is_pointer: bool) -> string {
    if (is_pointer) {
        return obj + "->" + field;
    }
    return obj + "." + field;
}

/**
 * Emit an index lvalue.
 *
 * @param base Base expression.
 * @param index Index expression.
 * @return Indexed lvalue text.
 */
func cem_emit_index_lvalue(base: string, index: string) -> string {
    return base + "[" + index + "]";
}

/**
 * Emit a struct constructor literal.
 *
 * @param c_struct_name Mangled C struct name.
 * @param field_inits Vector of alternating field-name and field-value strings.
 * @return Compound-literal expression.
 */
func cem_emit_struct_constructor(c_struct_name: string, field_inits: StringVector*) -> string {
    if (sv_size(field_inits) == 0) {
        return "(struct " + c_struct_name + "){ 0" + " }";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "(struct ");
        sb_append(sb, c_struct_name);
        sb_append(sb, "){ ");
        for (let i = 0; i < sv_size(field_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(field_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(field_inits, i + 1));
        }
        sb_append(sb, " }");
        return sb_to_string(sb);
    }
}

/**
 * Emit a brace-only struct initializer for static storage duration.
 *
 * @param field_inits Vector of alternating field-name and field-value strings.
 * @return Brace-only initializer text.
 */
func cem_emit_struct_static_initializer(field_inits: StringVector*) -> string {
    if (sv_size(field_inits) == 0) {
        return "{ 0 }";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "{ ");
        for (let i = 0; i < sv_size(field_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(field_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(field_inits, i + 1));
        }
        sb_append(sb, " }");
        return sb_to_string(sb);
    }
}

/**
 * Emit a struct constructor for a resolved struct type.
 *
 * @param struct_type Struct type to construct.
 * @param field_inits Vector of alternating field-name and field-value strings.
 * @return Compound-literal expression.
 */
func cem_emit_struct_constructor_for_type(struct_type: Type*, field_inits: StringVector*) -> string {
    return cem_emit_struct_constructor(cem_mangle_struct_name(struct_type.module_name, struct_type.name), field_inits);
}

/**
 * Emit a brace-only struct initializer for a resolved struct type.
 *
 * @param struct_type Struct type to construct.
 * @param field_inits Vector of alternating field-name and field-value strings.
 * @return Brace-only initializer text.
 */
func cem_emit_struct_static_initializer_for_type(struct_type: Type*, field_inits: StringVector*) -> string {
    return cem_emit_struct_static_initializer(field_inits);
}

/**
 * Emit an enum-variant constructor literal.
 *
 * @param c_enum_name Mangled C enum name.
 * @param variant_name Variant name.
 * @param tag_value Mangled tag constant.
 * @param payload_inits Vector of alternating field-name and field-value strings.
 * @return Tagged-union literal expression.
 */
func cem_emit_variant_constructor(c_enum_name: string, variant_name: string, tag_value: string,
                                  payload_inits: StringVector*) -> string {
    if (sv_size(payload_inits) == 0) {
        return "(struct " + c_enum_name + "){ .tag = " + tag_value + " }";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "(struct ");
        sb_append(sb, c_enum_name);
        sb_append(sb, "){ .tag = ");
        sb_append(sb, tag_value);
        sb_append(sb, ", .data = { .");
        sb_append(sb, variant_name);
        sb_append(sb, " = { ");
        for (let i = 0; i < sv_size(payload_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(payload_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(payload_inits, i + 1));
        }
        sb_append(sb, " } } }");
        return sb_to_string(sb);
    }
}

/**
 * Emit a brace-only enum-variant initializer for static storage duration.
 *
 * @param variant_name Variant name.
 * @param tag_value Mangled tag constant.
 * @param payload_inits Vector of alternating field-name and field-value strings.
 * @return Brace-only tagged-union initializer.
 */
func cem_emit_variant_static_initializer(variant_name: string, tag_value: string,
                                         payload_inits: StringVector*) -> string {
    if (sv_size(payload_inits) == 0) {
        return "{ .tag = " + tag_value + " }";
    }

    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "{ .tag = ");
        sb_append(sb, tag_value);
        sb_append(sb, ", .data = { .");
        sb_append(sb, variant_name);
        sb_append(sb, " = { ");
        for (let i = 0; i < sv_size(payload_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(payload_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(payload_inits, i + 1));
        }
        sb_append(sb, " } } }");
        return sb_to_string(sb);
    }
}

/**
 * Emit an enum-variant constructor for a resolved enum type.
 *
 * @param enum_type Enum type to construct.
 * @param variant_name Variant name.
 * @param payload_inits Vector of alternating field-name and field-value strings.
 * @return Tagged-union literal expression.
 */
func cem_emit_variant_constructor_for_type(enum_type: Type*, variant_name: string, payload_inits: StringVector*) -> string {
    let c_enum_name = cem_mangle_enum_name(enum_type.module_name, enum_type.name);
    let tag_value = cem_emit_enum_tag(enum_type, variant_name);
    return cem_emit_variant_constructor(c_enum_name, variant_name, tag_value, payload_inits);
}

/**
 * Emit a brace-only enum-variant initializer for a resolved enum type.
 *
 * @param enum_type Enum type to construct.
 * @param variant_name Variant name.
 * @param payload_inits Vector of alternating field-name and field-value strings.
 * @return Brace-only tagged-union initializer.
 */
func cem_emit_variant_static_initializer_for_type(enum_type: Type*, variant_name: string,
                                                  payload_inits: StringVector*) -> string {
    let tag_value = cem_emit_enum_tag(enum_type, variant_name);
    return cem_emit_variant_static_initializer(variant_name, tag_value, payload_inits);
}

/**
 * Emit an expression statement.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered expression.
 */
func cem_emit_expr_stmt(self: CEmitter*, c_expr: string) {
    ccb_emit(self.out, c_expr + ";");
}

/**
 * Emit a return statement.
 *
 * @param self Emitter to update.
 * @param c_value Lowered return value.
 */
func cem_emit_return_stmt(self: CEmitter*, c_value: string) {
    ccb_emit(self.out, "return " + c_value + ";");
}

/**
 * Emit a `return;` statement.
 *
 * @param self Emitter to update.
 */
func cem_emit_return_void_stmt(self: CEmitter*) {
    ccb_emit(self.out, "return;");
}

/**
 * Emit a C label.
 *
 * @param self Emitter to update.
 * @param label Label name.
 */
func cem_emit_label(self: CEmitter*, label: string) {
    ccb_dedent(self.out);
    ccb_emit(self.out, label + ":" + ";");
    ccb_indent(self.out);
}

/**
 * Emit a `goto` statement.
 *
 * @param self Emitter to update.
 * @param label Target label.
 */
func cem_emit_goto(self: CEmitter*, label: string) {
    ccb_emit(self.out, "goto " + label + ";");
}

/**
 * Emit a block start.
 *
 * @param self Emitter to update.
 */
func cem_emit_block_start(self: CEmitter*) {
    ccb_emit(self.out, "{");
    ccb_indent(self.out);
}

/**
 * Emit a block end.
 *
 * @param self Emitter to update.
 */
func cem_emit_block_end(self: CEmitter*) {
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
}

/**
 * Emit a `while` header.
 *
 * @param self Emitter to update.
 * @param c_cond Lowered condition expression.
 */
func cem_emit_while_header(self: CEmitter*, c_cond: string) {
    ccb_emit(self.out, "while (" + c_cond + ")");
}

/**
 * Emit an `if` header.
 *
 * @param self Emitter to update.
 * @param c_cond Lowered condition expression.
 */
func cem_emit_if_header(self: CEmitter*, c_cond: string) {
    ccb_emit(self.out, "if (" + c_cond + ")");
}

/**
 * Emit an `else` keyword.
 *
 * @param self Emitter to update.
 */
func cem_emit_else(self: CEmitter*) {
    ccb_emit(self.out, "else");
}

/**
 * Emit the Stage 1-shaped for-loop wrapper start.
 *
 * @param self Emitter to update.
 */
func cem_emit_for_loop_start(self: CEmitter*) {
    ccb_emit(self.out, "// for loop");
    cem_emit_block_start(self);
}

/**
 * Emit the Stage 1-shaped for-loop wrapper end.
 *
 * @param self Emitter to update.
 */
func cem_emit_for_loop_end(self: CEmitter*) {
    cem_emit_block_end(self);
}

/**
 * Emit a local variable declaration.
 *
 * @param self Emitter to update.
 * @param c_type Lowered C type.
 * @param c_var_name Lowered variable name.
 * @param c_init Lowered initializer.
 */
func cem_emit_let_decl(self: CEmitter*, c_type: string, c_var_name: string, c_init: string) {
    ccb_emit(self.out, c_type + " " + c_var_name + " = " + c_init + ";");
}

/**
 * Emit an assignment statement.
 *
 * @param self Emitter to update.
 * @param c_target Lowered lvalue.
 * @param c_value Lowered rvalue.
 */
func cem_emit_assignment(self: CEmitter*, c_target: string, c_value: string) {
    ccb_emit(self.out, c_target + " = " + c_value + ";");
}

/**
 * Emit a temporary declaration.
 *
 * @param self Emitter to update.
 * @param c_type Lowered C type.
 * @param c_temp_name Temporary identifier.
 * @param c_value Lowered initializer.
 */
func cem_emit_temp_decl(self: CEmitter*, c_type: string, c_temp_name: string, c_value: string) {
    ccb_emit(self.out, c_type + " " + c_temp_name + " = " + c_value + ";");
}

/**
 * Emit a block comment.
 *
 * @param self Emitter to update.
 * @param comment Comment text.
 */
func cem_emit_comment(self: CEmitter*, comment: string) {
    ccb_emit(self.out, "/* " + comment + " */");
}

/**
 * Emit a switch-exit `break;`.
 *
 * @param self Emitter to update.
 */
func cem_emit_exit_switch(self: CEmitter*) {
    ccb_emit(self.out, "break;");
}

/**
 * Emit an assignment through a pointer.
 *
 * @param self Emitter to update.
 * @param c_ptr_name C pointer expression.
 * @param c_value Lowered value expression.
 */
func cem_emit_pointer_assignment(self: CEmitter*, c_ptr_name: string, c_value: string) {
    ccb_emit(self.out, "*" + c_ptr_name + " = " + c_value + ";");
}

/**
 * Emit an assignment through a runtime-checked object pointer.
 *
 * @param self Emitter to update.
 * @param c_ptr_name C pointer expression.
 * @param c_base_type Lowered pointee type.
 * @param c_value Lowered value expression.
 */
func cem_emit_checked_pointer_assignment(self: CEmitter*, c_ptr_name: string, c_base_type: string, c_value: string) {
    let checked = cem_emit_checked_ptr_access_for_base(self, c_ptr_name, c_base_type, "_RT_ACCESS_WRITE");
    ccb_emit(self.out, "*" + checked + " = " + c_value + ";");
}

/**
 * Emit an ARC string retain call.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered string expression.
 */
func cem_emit_string_retain(self: CEmitter*, c_expr: string) {
    if (self.trace_arc) {
        ccb_emit(self.out, "_rt_string_retain_impl(" + c_expr + ", __FILE__, __LINE__)" + ";");
        return;
    }
    ccb_emit(self.out, "rt_string_retain(" + c_expr + ")" + ";");
}

/**
 * Emit an ARC string release call.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered string expression.
 */
func cem_emit_string_release(self: CEmitter*, c_expr: string) {
    if (self.trace_arc) {
        ccb_emit(self.out, "_rt_string_release_impl(" + c_expr + ", __FILE__, __LINE__)" + ";");
        return;
    }
    ccb_emit(self.out, "rt_string_release(" + c_expr + ")" + ";");
}

/**
 * Emit the temporary scrutinee declaration used by `match`/`case`.
 *
 * @param self Emitter to update.
 * @param c_type Lowered scrutinee type.
 * @param c_expr Lowered scrutinee expression.
 */
func cem_emit_match_scrutinee_decl(self: CEmitter*, c_type: string, c_expr: string) {
    ccb_emit(self.out, c_type + " _scrutinee = " + c_expr + ";");
}

/**
 * Emit a `switch` header.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered switch expression.
 */
func cem_emit_switch_start(self: CEmitter*, c_expr: string) {
    ccb_emit(self.out, "switch (" + c_expr + ")" + " {");
}

/**
 * Emit the switch used for enum `match`.
 *
 * @param self Emitter to update.
 * @param scrutinee_name Scrutinee variable name.
 */
func cem_emit_match_switch_start(self: CEmitter*, scrutinee_name: string) {
    cem_emit_switch_start(self, cem_emit_enum_tag_access(scrutinee_name));
}

/**
 * Emit the closing brace of a `switch`.
 *
 * @param self Emitter to update.
 */
func cem_emit_switch_end(self: CEmitter*) {
    ccb_emit(self.out, "}");
}

/**
 * Emit a `case` label.
 *
 * @param self Emitter to update.
 * @param c_value Lowered tag or literal.
 */
func cem_emit_case_label(self: CEmitter*, c_value: string) {
    ccb_emit(self.out, "case " + c_value + ":");
}

/**
 * Emit a `default:` label.
 *
 * @param self Emitter to update.
 */
func cem_emit_default_label(self: CEmitter*) {
    ccb_emit(self.out, "default:");
}

/**
 * Emit a NULL assignment.
 *
 * @param self Emitter to update.
 * @param c_var Lowered lvalue expression.
 */
func cem_emit_null_assignment(self: CEmitter*, c_var: string) {
    ccb_emit(self.out, c_var + " = NULL" + ";");
}

/**
 * Emit one heap-allocation temporary.
 *
 * @param self Emitter to update.
 * @param c_ptr_type Lowered pointer type.
 * @param c_base_type Lowered base type.
 * @param c_temp_name Temporary variable name.
 */
func cem_emit_alloc_obj(self: CEmitter*, c_ptr_type: string, c_base_type: string, c_temp_name: string) {
    if (self.trace_memory) {
        ccb_emit(self.out, c_ptr_type + " " + c_temp_name + " = (" + c_ptr_type + ")_rt_alloc_obj_impl((dea_int)sizeof(" + c_base_type + "), __FILE__, __LINE__);");
        return;
    }
    ccb_emit(self.out, c_ptr_type + " " + c_temp_name + " = (" + c_ptr_type + ")_rt_alloc_obj((dea_int)sizeof(" + c_base_type + "));");
}

/**
 * Emit one pointer-target aggregate initialization.
 *
 * @param self Emitter to update.
 * @param c_temp_name Pointer temporary name.
 * @param c_base_type Lowered base type.
 * @param c_init_str Lowered initializer body without outer braces.
 */
func cem_emit_struct_init(self: CEmitter*, c_temp_name: string, c_base_type: string, c_init_str: string) {
    let checked = cem_emit_checked_ptr_access_for_base(self, c_temp_name, c_base_type, "_RT_ACCESS_WRITE");
    ccb_emit(self.out, "*" + checked + " = (" + c_base_type + "){ " + c_init_str + " };");
}

/**
 * Emit one pointer-target struct initialization from field pairs.
 *
 * @param self Emitter to update.
 * @param c_temp_name Pointer temporary name.
 * @param base_type Struct type being initialized.
 * @param field_inits Vector of alternating field-name and field-value strings.
 */
func cem_emit_struct_init_from_fields(self: CEmitter*, c_temp_name: string, base_type: Type*, field_inits: StringVector*) {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(field_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(field_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(field_inits, i + 1));
        }
        cem_emit_struct_init(self, c_temp_name, cem_emit_type(base_type), sb_to_string(sb));
    }
}

/**
 * Emit one pointer-target enum-variant initialization.
 *
 * @param self Emitter to update.
 * @param c_temp_name Pointer temporary name.
 * @param enum_type Enum type being initialized.
 * @param variant_name Active variant name.
 * @param payload_inits Vector of alternating field-name and field-value strings.
 */
func cem_emit_enum_variant_init(self: CEmitter*, c_temp_name: string, enum_type: Type*, variant_name: string,
                                payload_inits: StringVector*) {
    let tag_value = cem_emit_enum_tag(enum_type, variant_name);
    if (sv_size(payload_inits) == 0) {
        cem_emit_struct_init(self, c_temp_name, cem_emit_type(enum_type), ".tag = " + tag_value);
        return;
    }

    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, ".tag = ");
        sb_append(sb, tag_value);
        sb_append(sb, ", .data = { .");
        sb_append(sb, variant_name);
        sb_append(sb, " = { ");
        for (let i = 0; i < sv_size(payload_inits); i = i + 2) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, ".");
            sb_append(sb, sv_get(payload_inits, i));
            sb_append(sb, " = ");
            sb_append(sb, sv_get(payload_inits, i + 1));
        }
        sb_append(sb, " } }");
        cem_emit_struct_init(self, c_temp_name, cem_emit_type(enum_type), sb_to_string(sb));
    }
}

/**
 * Emit zero-initialization through a pointer.
 *
 * @param self Emitter to update.
 * @param c_temp_name Pointer temporary name.
 * @param c_base_type Lowered base type.
 */
func cem_emit_zero_init(self: CEmitter*, c_temp_name: string, c_base_type: string) {
    let checked = cem_emit_checked_ptr_access_for_base(self, c_temp_name, c_base_type, "_RT_ACCESS_WRITE");
    ccb_emit(self.out, "*" + checked + " = (" + c_base_type + "){ 0" + " }" + ";");
}

/**
 * Emit the null-check used by `?` on niche optionals.
 *
 * @param self Emitter to update.
 * @param c_tmp Temporary variable name.
 * @param ret_none Lowered `none` return value.
 */
func cem_emit_try_check_niche(self: CEmitter*, c_tmp: string, ret_none: string) {
    ccb_emit(self.out, "if " + cem_emit_pointer_null_check(c_tmp, "==") + " return " + ret_none + ";");
}

/**
 * Emit the `has_value` check used by `?` on value optionals.
 *
 * @param self Emitter to update.
 * @param c_tmp Temporary variable name.
 * @param ret_none Lowered `none` return value.
 */
func cem_emit_try_check_value(self: CEmitter*, c_tmp: string, ret_none: string) {
    ccb_emit(self.out, "if " + cem_emit_null_check_eq(c_tmp) + " return " + ret_none + ";");
}

/**
 * Emit the value extraction used by `?` on value optionals.
 *
 * @param c_tmp Temporary variable name.
 * @return Lowered extraction expression.
 */
func cem_emit_try_extract_value(c_tmp: string) -> string {
    return "(" + cem_emit_optional_value(c_tmp) + ")";
}

/**
 * Emit one match-arm payload binding initializer.
 *
 * @param scrutinee Scrutinee variable name.
 * @param variant Active variant name.
 * @param field Payload field name.
 * @return Lowered payload access.
 */
func cem_emit_pattern_binding_init(scrutinee: string, variant: string, field: string) -> string {
    return cem_emit_enum_payload_field_access(scrutinee, variant, field);
}

/**
 * Report whether any variant field in an enum carries ARC-managed data.
 *
 * @param self Emitter to inspect.
 * @param enum_info Resolved enum metadata.
 * @return `true` when cleanup code must inspect the active variant.
 */
func cem_enum_info_has_arc_data(self: CEmitter*, enum_info: EnumInfo*) -> bool {
    for (let i = 0; i < vec_size(enum_info.variants); i = i + 1) {
        let variant = ptr_vec_get(enum_info.variants, i) as EnumVariantInfo*;
        for (let j = 0; j < vec_size(variant.field_types); j = j + 1) {
            if (analysis_has_arc_data(cem_analysis(self), ptr_vec_get(variant.field_types, j) as Type*)) {
                return true;
            }
        }
    }
    return false;
}

/**
 * Emit cleanup for a by-value expression according to its type.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered value expression.
 * @param ty Type of the value.
 */
func cem_emit_value_cleanup(self: CEmitter*, c_expr: string, ty: Type*) {
    if (analysis_is_arc_type(ty)) {
        cem_emit_string_release(self, c_expr);
        return;
    }

    if (ord(ty.kind) == ord(TY_NULLABLE)) {
        let inner = ty.inner as Type*;
        if (ord(inner.kind) == ord(TY_POINTER) || !analysis_has_arc_data(cem_analysis(self), inner)) {
            return;
        }
        ccb_emit(self.out, "if (" + cem_emit_optional_has_value(c_expr) + ")" + " {");
        ccb_indent(self.out);
        cem_emit_value_cleanup(self, cem_emit_optional_value(c_expr), inner);
        ccb_dedent(self.out);
        ccb_emit(self.out, "}");
        return;
    }

    if (ord(ty.kind) == ord(TY_ARRAY)) {
        if (!analysis_has_arc_data(cem_analysis(self), ty.inner as Type*)) {
            return;
        }
        let idx = cem_fresh_tmp(self, "arr_i");
        ccb_emit(self.out, "for (dea_int " + idx + " = " + int_to_string(ty.array_len) +
            "; " + idx + " > 0; " + idx + " = " + idx + " - 1) {");
        ccb_indent(self.out);
        let inner = ty.inner as Type*;
        if (ord(inner.kind) == ord(TY_ARRAY)) {
            cem_emit_raw_array_cleanup(self, "(" + c_expr + ").data[" + idx + " - 1]", inner);
        } else {
            cem_emit_value_cleanup(self, "(" + c_expr + ").data[" + idx + " - 1]", inner);
        }
        ccb_dedent(self.out);
        ccb_emit(self.out, "}");
        return;
    }

    if (ord(ty.kind) == ord(TY_STRUCT)) {
        let info = sig_lookup_struct_info(cem_analysis(self).signatures as SignatureTables*, ty.module_name, ty.name);
        if (info == null) {
            return;
        }
        let fields = (info as StructInfo*).fields;
        for (let i = 0; i < vec_size(fields); i = i + 1) {
            let field = ptr_vec_get(fields, i) as StructFieldInfo*;
            cem_emit_value_cleanup(self, cem_emit_field_access(c_expr, field.name, false), field.field_type);
        }
        return;
    }

    if (ord(ty.kind) == ord(TY_ENUM)) {
        let enum_info = sig_lookup_enum_info(cem_analysis(self).signatures as SignatureTables*, ty.module_name, ty.name);
        if (enum_info == null) {
            return;
        }
        if (!cem_enum_info_has_arc_data(self, enum_info as EnumInfo*)) {
            return;
        }

        cem_emit_switch_start(self, cem_emit_enum_tag_access(c_expr));
        for (let i = 0; i < vec_size((enum_info as EnumInfo*).variants); i = i + 1) {
            let info2 = ptr_vec_get((enum_info as EnumInfo*).variants, i) as EnumVariantInfo*;

            let has_arc = false;
            for (let j = 0; j < vec_size(info2.field_types); j = j + 1) {
                if (analysis_has_arc_data(cem_analysis(self), ptr_vec_get(info2.field_types, j) as Type*)) {
                    has_arc = true;
                    break;
                }
            }
            if (!has_arc) {
                continue;
            }

            ccb_emit(self.out, "case " + cem_emit_enum_tag(ty, info2.name) + ": {");
            ccb_indent(self.out);
            for (let cleanup_j = 0; cleanup_j < vec_size(info2.field_types); cleanup_j = cleanup_j + 1) {
                let field_ty = ptr_vec_get(info2.field_types, cleanup_j) as Type*;
                cem_emit_value_cleanup(self, cem_emit_enum_payload_field_access(c_expr, info2.name,
                    sv_get(info2.field_names, cleanup_j)), field_ty);
            }
            cem_emit_exit_switch(self);
            ccb_dedent(self.out);
            ccb_emit(self.out, "}");
        }
        ccb_emit(self.out, "default: break;");
        cem_emit_switch_end(self);
    }
}

/**
 * Emit cleanup for a raw C array row belonging to a flattened array wrapper.
 *
 * @param self Emitter to update.
 * @param c_expr Lowered raw C array expression.
 * @param ty Array type represented by `c_expr`.
 */
func cem_emit_raw_array_cleanup(self: CEmitter*, c_expr: string, ty: Type*) {
    if (ord(ty.kind) != ord(TY_ARRAY)) {
        cem_emit_value_cleanup(self, c_expr, ty);
        return;
    }
    if (!analysis_has_arc_data(cem_analysis(self), ty.inner as Type*)) {
        return;
    }
    let idx = cem_fresh_tmp(self, "arr_i");
    ccb_emit(self.out, "for (dea_int " + idx + " = " + int_to_string(ty.array_len) +
        "; " + idx + " > 0; " + idx + " = " + idx + " - 1) {");
    ccb_indent(self.out);
    let inner = ty.inner as Type*;
    if (ord(inner.kind) == ord(TY_ARRAY)) {
        cem_emit_raw_array_cleanup(self, c_expr + "[" + idx + " - 1]", inner);
    } else {
        cem_emit_value_cleanup(self, c_expr + "[" + idx + " - 1]", inner);
    }
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
}

/**
 * Emit cleanup for a pointer-to-struct value.
 *
 * @param self Emitter to update.
 * @param c_ptr_expr Lowered pointer expression.
 * @param struct_type Struct type to clean.
 */
func cem_emit_struct_cleanup(self: CEmitter*, c_ptr_expr: string, struct_type: Type*) {
    let info = sig_lookup_struct_info(cem_analysis(self).signatures as SignatureTables*, struct_type.module_name, struct_type.name);
    if (info == null) {
        cem_ice("[ICE-1270] missing StructInfo for " + struct_type.module_name + "." + struct_type.name);
    }

    ccb_emit(self.out, "if (" + c_ptr_expr + " != NULL" + ") {");
    ccb_indent(self.out);
    for (let i = 0; i < vec_size((info as StructInfo*).fields); i = i + 1) {
        let field = ptr_vec_get((info as StructInfo*).fields, i) as StructFieldInfo*;
        cem_emit_value_cleanup(self, c_ptr_expr + "->" + field.name, field.field_type);
    }
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
}

/**
 * Emit cleanup for a pointer-to-enum value.
 *
 * @param self Emitter to update.
 * @param c_ptr_expr Lowered pointer expression.
 * @param enum_type Enum type to clean.
 */
func cem_emit_enum_cleanup(self: CEmitter*, c_ptr_expr: string, enum_type: Type*) {
    let enum_info = sig_lookup_enum_info(cem_analysis(self).signatures as SignatureTables*, enum_type.module_name, enum_type.name);
    if (enum_info == null) {
        cem_ice("[ICE-1080] missing EnumInfo for " + enum_type.module_name + "." + enum_type.name);
    }
    if (!cem_enum_info_has_arc_data(self, enum_info as EnumInfo*)) {
        return;
    }

    ccb_emit(self.out, "if (" + c_ptr_expr + " != NULL" + ") {");
    ccb_indent(self.out);
    cem_emit_switch_start(self, c_ptr_expr + "->tag");
    for (let i = 0; i < vec_size((enum_info as EnumInfo*).variants); i = i + 1) {
        let info2 = ptr_vec_get((enum_info as EnumInfo*).variants, i) as EnumVariantInfo*;

        let has_arc = false;
        for (let j = 0; j < vec_size(info2.field_types); j = j + 1) {
            if (analysis_has_arc_data(cem_analysis(self), ptr_vec_get(info2.field_types, j) as Type*)) {
                has_arc = true;
                break;
            }
        }
        if (!has_arc) {
            continue;
        }

        ccb_emit(self.out, "case " + cem_emit_enum_tag(enum_type, info2.name) + ": {");
        ccb_indent(self.out);
        for (let cleanup_j = 0; cleanup_j < vec_size(info2.field_types); cleanup_j = cleanup_j + 1) {
            let field_ty = ptr_vec_get(info2.field_types, cleanup_j) as Type*;
            cem_emit_value_cleanup(self, c_ptr_expr + "->data." + info2.name + "." +
                sv_get(info2.field_names, cleanup_j), field_ty);
        }
        cem_emit_exit_switch(self);
        ccb_dedent(self.out);
        ccb_emit(self.out, "}");
    }
    ccb_emit(self.out, "default: break;");
    cem_emit_switch_end(self);
    ccb_dedent(self.out);
    ccb_emit(self.out, "}");
}
