func cem_emit_checked_int_div_for_type(result_ty: Type*, c_left: string, c_right: string) -> string {
    if (type_is_builtin(result_ty, "int")) {
        return cem_emit_checked_int_div(c_left, c_right);
    }
    if (type_is_builtin(result_ty, "uint")) {
        return "(_rt_udiv(" + c_left + ", " + c_right + "))";
    }
    if (type_is_builtin(result_ty, "long")) {
        return "(_rt_ldiv(" + c_left + ", " + c_right + "))";
    }
    if (type_is_builtin(result_ty, "ulong")) {
        return "(_rt_uldiv(" + c_left + ", " + c_right + "))";
    }
    return cem_ice_string("[ICE-1320] unsupported checked division type '" + type_format(result_ty) + "'");
}

