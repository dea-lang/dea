module driver;

import sys.rt;

import std.fs;
import std.hashmap;
import std.hashset;
import std.path;
import std.string;
import std.text;
import std.vector;
import util.diag;

import util.strings;
import util.log;
import dea_prelude;
import module_graph;
import source_paths;
import lexer;
import interface_fingerprint;
import mi_utils;
import module_interface;
import parser;
import parser.interface;
import tokens;
import ast;

/**
 * Represents the DriverUnit structure.
 */
struct DriverUnit {
    /** Canonical identity requested from the resolver, not the parsed declaration. */
    module_name: string;
    path: string;
    parse_result: ParseResult*;
}

/**
 * Represents the DriverState structure.
 */
struct DriverState {
    entry_module: string;
    graph: ModuleGraph*;
    /**
     * Module lookups that failed before graph-node creation.
     *
     * Invalid or absent providers intentionally have no public placeholder
     * node; this private ledger suppresses repeated resolution attempts.
     */
    failed_without_node: StringSet*;
    /** Every owned parsed unit shell, including failed or mismatched units. */
    units: VectorBase*; // DriverUnit*
    /** Validated requested module identity -> borrowed DriverUnit*. */
    units_by_name: StringPtrMap*; // module name -> DriverUnit*
    graph_interfaces: VectorBase*; // raw ModuleInterface* selected by the graph
    graph_interfaces_by_name: StringPtrMap*; // module name -> raw ModuleInterface*
    interfaces: VectorBase*; // active semantic ModuleInterface* clones
    interfaces_by_name: StringPtrMap*; // module name -> semantic ModuleInterface*
    projection_interfaces: VectorBase*; // active wire-preserving ModuleInterface* clones
    projection_interfaces_by_name: StringPtrMap*; // module name -> projection ModuleInterface*
    interface_funcs_by_key: StringPtrMap*; // module::function -> InterfaceFuncEntry*
    diags: DiagCollector*;
    source_names: StringVector*; // source cache: file paths
    source_texts: StringVector*; // source cache: file contents
}

/**
 * Carries borrowed, recursion-invariant module-resolution inputs.
 *
 * This context owns none of its pointer or optional-string fields. Its caller
 * must keep every referenced value alive for the complete resolution walk.
 */
struct DriverResolutionContext {
    state: DriverState*;
    candidates: StringPtrMap*;
    search_paths: SourceSearchPaths*;
    interface_roots: StringVector*;
    policy: ModuleResolutionPolicy;
    artifact_root: string?;
    cfg: LogConfig*;
}

/**
 * Free a loaded driver unit and its parse result.
 *
 * @param self Driver unit to free.
 */
func dr_unit_free(self: DriverUnit*) {
    parse_result_free(self.parse_result);
    drop self;
}

/**
 * Free an optional vector of driver units.
 *
 * @param units Optional driver-unit vector to free.
 */
func dr_units_free(units: VectorBase*?) {
    if (units == null) {
        return;
    }

    let v = units as VectorBase*;
    for (let i = 0; i < vec_size(v); i = i + 1) {
        let unit = ptr_vec_get(v, i) as DriverUnit*;
        dr_unit_free(unit);
    }
    vec_free(v);
}

/**
 * Free an optional vector of module interfaces.
 *
 * @param interfaces Optional interface vector to free.
 */
func dr_interfaces_free(interfaces: VectorBase*?) {
    if (interfaces == null) {
        return;
    }

    let v = interfaces as VectorBase*;
    for (let i = 0; i < vec_size(v); i = i + 1) {
        mi_free(ptr_vec_get(v, i) as ModuleInterface*);
    }
    vec_free(v);
}

/**
 * Free driver state and all owned parse/cache data.
 *
 * @param self Driver state to free.
 */
func driver_state_free(self: DriverState*) {
    ss_free(self.failed_without_node);
    spm_free(self.units_by_name);
    spm_free(self.graph_interfaces_by_name);
    spm_free(self.interfaces_by_name);
    spm_free(self.projection_interfaces_by_name);
    spm_free(self.interface_funcs_by_key);
    dr_units_free(self.units);
    dr_interfaces_free(self.graph_interfaces);
    dr_interfaces_free(self.interfaces);
    dr_interfaces_free(self.projection_interfaces);
    mg_free(self.graph);
    diag_free(self.diags);
    sv_free(self.source_names);
    sv_free(self.source_texts);
    drop self;
}

/**
 * Report whether driver analysis produced any errors.
 *
 * @param self Driver state to inspect.
 * @return `true` if the driver's diagnostics contain an error.
 */
func driver_has_errors(self: DriverState*) -> bool {
    return diag_has_errors(self.diags);
}

/**
 * Return the number of diagnostics collected by the driver.
 *
 * @param self Driver state to inspect.
 * @return Total diagnostic count.
 */
func driver_diag_count(self: DriverState*) -> int {
    return diag_count(self.diags);
}

/**
 * Return a driver diagnostic by index.
 *
 * @param self Driver state to inspect.
 * @param index Zero-based diagnostic index.
 * @return Diagnostic at `index`.
 */
func driver_diag_get(self: DriverState*, index: int) -> Diagnostic* {
    return diag_get(self.diags, index);
}

/**
 * Return the number of owned parsed unit shells.
 *
 * @param self Driver state to inspect.
 * @return Unit count, including parser failures and identity mismatches.
 */
func driver_unit_count(self: DriverState*) -> int {
    return vec_size(self.units);
}

/**
 * Return an owned parsed unit shell by index.
 *
 * @param self Driver state to inspect.
 * @param index Zero-based unit index.
 * @return Driver unit at `index`.
 */
func driver_unit_get(self: DriverState*, index: int) -> DriverUnit* {
    return ptr_vec_get(self.units, index) as DriverUnit*;
}

/**
 * Return the deterministic module graph built by the driver.
 *
 * @param self Driver state to inspect.
 * @return Borrowed module graph owned by `self`.
 */
func driver_graph(self: DriverState*) -> ModuleGraph* {
    return self.graph;
}

/**
 * Return the number of active module interfaces.
 *
 * @param self Driver state to inspect.
 * @return Interface count.
 */
func driver_interface_count(self: DriverState*) -> int {
    return vec_size(self.interfaces);
}

/**
 * Return an active module interface by index.
 *
 * @param self Driver state to inspect.
 * @param index Zero-based interface index.
 * @return Module interface at `index`.
 */
func driver_interface_get(self: DriverState*, index: int) -> ModuleInterface* {
    return ptr_vec_get(self.interfaces, index) as ModuleInterface*;
}

/**
 * Build an interface function lookup key.
 *
 * @param module_name Provider module name.
 * @param name Function name.
 * @return Key in `module::function` form.
 */
func dr_interface_func_key(module_name: string, name: string) -> string {
    return module_name + "::" + name;
}

/**
 * Register a parsed unit in ordered ownership and, when valid, by identity.
 *
 * Ordered storage owns every unit shell produced once parsing starts, including
 * lexer/parser failures and header mismatches. The lookup index is narrower:
 * it exposes a unit only when a parsed module header exists and its declared
 * name matches the canonical identity requested by the resolver.
 *
 * @param self Driver state to update.
 * @param unit Owned unit to register.
 */
func dr_register_unit(self: DriverState*, unit: DriverUnit*) {
    ptr_vec_push(self.units, unit as void*);
    if (unit.parse_result.root_module == null) {
        return;
    }
    let mod = unit.parse_result.root_module as Module*;
    if (mod.name != unit.module_name) {
        return;
    }
    spm_put(self.units_by_name, unit.module_name, unit as void*);
}

/**
 * Register an owned raw interface selected while constructing the graph.
 *
 * @param self Driver state to update.
 * @param mi Owned raw interface.
 */
func dr_register_graph_interface(self: DriverState*, mi: ModuleInterface*) {
    ptr_vec_push(self.graph_interfaces, mi as void*);
    spm_put(self.graph_interfaces_by_name, mi.module_name, mi as void*);
}

/**
 * Register an active interface in owned storage and non-owning lookup indexes.
 *
 * @param self Driver state to update.
 * @param mi Owned interface clone to register.
 */
func dr_register_interface(self: DriverState*, mi: ModuleInterface*) {
    ptr_vec_push(self.interfaces, mi as void*);
    spm_put(self.interfaces_by_name, mi.module_name, mi as void*);
    for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
        let entry = ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*;
        let key = dr_interface_func_key(mi.module_name, entry.name);
        if (spm_get(self.interface_funcs_by_key, key) == null) {
            spm_put(self.interface_funcs_by_key, key, entry as void*);
        }
    }
}

/**
 * Register a wire-preserving active interface for later projection.
 *
 * @param self Driver state to update.
 * @param mi Owned unnormalized interface clone to register.
 */
func dr_register_projection_interface(self: DriverState*, mi: ModuleInterface*) {
    ptr_vec_push(self.projection_interfaces, mi as void*);
    spm_put(self.projection_interfaces_by_name, mi.module_name, mi as void*);
}

/**
 * Find an identity-validated driver unit by requested module name.
 *
 * @param self Driver state to inspect.
 * @param module_name Module name to search for.
 * @return Matching driver unit, or `null` if absent or its header did not match.
 */
func driver_find_unit(self: DriverState*, module_name: string) -> DriverUnit*? {
    let unit = spm_get(self.units_by_name, module_name);
    if (unit == null) {
        return null;
    }
    return unit as DriverUnit*;
}

/**
 * Find an active module interface by module name.
 *
 * @param self Driver state to inspect.
 * @param module_name Module name to search for.
 * @return Matching module interface, or `null` if absent.
 */
func driver_find_interface(self: DriverState*, module_name: string) -> ModuleInterface*? {
    let mi = spm_get(self.interfaces_by_name, module_name);
    if (mi == null) {
        return null;
    }
    return mi as ModuleInterface*;
}

/**
 * Find the raw interface selected for a graph node.
 *
 * Unlike `driver_find_interface`, this includes graph-only `link` providers
 * that were intentionally not activated for semantic replay.
 *
 * @param self Driver state to inspect.
 * @param module_name Canonical provider module name.
 * @return Borrowed selected interface, or `null` for source/virtual nodes.
 */
func driver_find_graph_interface(self: DriverState*, module_name: string) -> ModuleInterface*? {
    let mi = spm_get(self.graph_interfaces_by_name, module_name);
    if (mi == null) {
        return null;
    }
    return mi as ModuleInterface*;
}

/**
 * Return one selected provider interface's opaque whole-module fingerprint.
 *
 * @param self Driver state to inspect.
 * @param module_name Canonical provider module name.
 * @return Opaque fingerprint spelling, or `""` when unavailable.
 */
func driver_provider_fingerprint(self: DriverState*, module_name: string) -> string {
    let mi = driver_find_graph_interface(self, module_name);
    if (mi == null) {
        return "";
    }
    return (mi as ModuleInterface*).fingerprint;
}

/**
 * Find a wire-preserving active module interface by module name.
 *
 * @param self Driver state to inspect.
 * @param module_name Module name to search for.
 * @return Matching projection interface, or `null` if absent.
 */
func driver_find_projection_interface(self: DriverState*, module_name: string) -> ModuleInterface*? {
    let mi = spm_get(self.projection_interfaces_by_name, module_name);
    if (mi == null) {
        return null;
    }
    return mi as ModuleInterface*;
}

/**
 * Find an interface function entry by module and function name.
 *
 * @param self Driver state to inspect.
 * @param module_name Provider module name.
 * @param name Function name.
 * @return Matching interface function entry, or `null`.
 */
func driver_find_interface_func(self: DriverState*, module_name: string, name: string) -> InterfaceFuncEntry*? {
    let entry = spm_get(self.interface_funcs_by_key, dr_interface_func_key(module_name, name));
    if (entry == null) {
        return null;
    }
    return entry as InterfaceFuncEntry*;
}

/**
 * Clone interface function parameter names by module and function name.
 *
 * @param self Driver state to inspect.
 * @param module_name Provider module name.
 * @param name Function name.
 * @return Cloned parameter-name vector, or `null`.
 */
func driver_clone_interface_func_param_names(self: DriverState*, module_name: string, name: string) -> StringVector*? {
    let entry = driver_find_interface_func(self, module_name, name);
    if (entry == null) {
        return null;
    }
    return us_sv_clone((entry as InterfaceFuncEntry*).param_names);
}

/**
 * Return identity-validated loaded module names in sorted order.
 *
 * @param self Driver state to inspect.
 * @return New vector containing sorted module names.
 */
func driver_module_names_sorted(self: DriverState*) -> StringVector* {
    let out = spm_keys(self.units_by_name);
    sv_sort(out);
    return out;
}

/**
 * Copy parse diagnostics into the driver collector.
 *
 * @param dst Destination diagnostic collector.
 * @param pr Parse result providing diagnostics.
 */
func dr_copy_parse_diags(dst: DiagCollector*, pr: ParseResult*) {
    for (let i = 0; i < parse_diag_count(pr); i = i + 1) {
        diag_copy(dst, parse_diag_get(pr, i));
    }
}

/**
 * Emit a driver diagnostic without a precise source span.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Filename to attach when known.
 */
func dr_emit_error(diags: DiagCollector*, code: string, message: string, filename: string) {
    diag_error(diags, "Driver", code, message, filename, 0, 0, 0, 0);
}

/**
 * Cache a module-resolution failure that occurred before node construction.
 *
 * The public graph records selected provider identities, so an invalid or
 * absent provider receives no placeholder node. This private cache retains the
 * failure solely to suppress repeated searches and duplicate diagnostics.
 *
 * @param state Driver state receiving the cached failure.
 * @param module_name Canonical identity whose lookup failed.
 * @return Always `false`, for direct use from resolution failure branches.
 */
func dr_fail_without_node(state: DriverState*, module_name: string) -> bool {
    ss_add(state.failed_without_node, module_name);
    return false;
}

/**
 * Check whether a string vector contains a module name.
 *
 * This shared helper is also used by backend closure walks.
 *
 * @param items Vector to search.
 * @param module_name Module name to look for.
 * @return `true` if `module_name` is present in `items`.
 */
func dr_sv_has(items: StringVector*, module_name: string) -> bool {
    for (let i = 0; i < sv_size(items); i = i + 1) {
        if (sv_get(items, i) == module_name) {
            return true;
        }
    }
    return false;
}

/**
 * Create an empty driver state.
 *
 * @param entry_module Entry module name.
 * @param interfaces Optional borrowed interface candidates used to size active storage.
 * @return New driver state owning its analysis data.
 */
func dr_state_create(entry_module: string, interfaces: VectorBase*?) -> DriverState* {
    let interface_capacity = 0;
    if (interfaces != null) {
        interface_capacity = vec_size(interfaces as VectorBase*);
    }
    let state = new DriverState(
        entry_module,
        mg_create(),
        ss_create(),
        ptr_vec_create(8),
        spm_create(),
        ptr_vec_create(interface_capacity),
        spm_create(),
        ptr_vec_create(interface_capacity),
        spm_create(),
        ptr_vec_create(interface_capacity),
        spm_create(),
        spm_create(),
        diag_create(),
        sv_create(4),
        sv_create(4)
    );
    let virtual_node = mg_node_virtual(dea_module_name());
    virtual_node.state = MNS_RESOLVED;
    if (!mg_add_node(state.graph, virtual_node)) {
        mg_node_free(virtual_node);
    }
    return state;
}

/**
 * Build a borrowed supplied-interface lookup while rejecting duplicates.
 *
 * @param state Driver state receiving duplicate diagnostics.
 * @param interfaces Borrowed vector of `ModuleInterface*` values.
 * @return Non-owning map from module name to supplied interface.
 */
func dr_build_interface_candidates(state: DriverState*, interfaces: VectorBase*?) -> StringPtrMap* {
    let candidates = spm_create();
    if (interfaces == null) {
        return candidates;
    }
    let source = interfaces as VectorBase*;
    for (let i = 0; i < vec_size(source); i = i + 1) {
        let mi = ptr_vec_get(source, i) as ModuleInterface*;
        if (!sp_is_valid_module_name(mi.module_name)) {
            dr_emit_error(state.diags, "DRV-0072",
                "invalid canonical supplied-interface module name: '" + mi.module_name + "'",
                "<interface:" + mi.module_name + ">");
        } else if (spm_get(candidates, mi.module_name) != null) {
            dr_emit_error(state.diags, "DRV-0071",
                "duplicate supplied module interface for '" + mi.module_name + "'",
                "<interface:" + mi.module_name + ">");
        } else {
            spm_put(candidates, mi.module_name, mi as void*);
        }
    }
    return candidates;
}

/**
 * Add a graph node, diagnosing an impossible second origin for one identity.
 *
 * @param state Driver state receiving the node and diagnostics.
 * @param node Owned node candidate.
 * @return `true` when the graph accepted ownership.
 */
func dr_add_graph_node(state: DriverState*, node: ModuleGraphNode*) -> bool {
    if (mg_add_node(state.graph, node)) {
        return true;
    }
    let filename = "";
    if (node.origin.path != null) {
        filename = node.origin.path as string;
    }
    dr_emit_error(state.diags, "DRV-0077",
        "conflicting graph identity for module '" + node.module_name + "'", filename);
    mg_node_free(node);
    return false;
}

/**
 * Validate every configured interface root before resolving the entry.
 *
 * @param state Driver state receiving diagnostics.
 * @param interface_roots Ordered filesystem interface roots.
 * @return `true` when every root exists and is a directory.
 */
func dr_validate_interface_roots(state: DriverState*, interface_roots: StringVector*) -> bool {
    let ok = true;
    for (let i = 0; i < sv_size(interface_roots); i = i + 1) {
        let root = sv_get(interface_roots, i);
        if (!std.fs::is_dir(root)) {
            dr_emit_error(state.diags, "DRV-0073",
                "interface root is not a directory: " + root, root);
            ok = false;
        }
    }
    return ok;
}

/**
 * Copy interface parser diagnostics into the driver collector.
 *
 * @param dst Destination diagnostic collector.
 * @param parsed Interface parse result providing diagnostics.
 */
func dr_copy_interface_diags(dst: DiagCollector*, parsed: InterfaceParseResult*) {
    for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
        diag_copy(dst, diag_get(parsed.diags, i));
    }
}

/**
 * Format a complete canonical dependency cycle.
 *
 * @param stack Current resolution stack, including the current provider.
 * @param module_name Resolving module encountered again.
 * @return Chain in `a -> b -> a` form.
 */
func dr_format_cycle(stack: StringVector*, module_name: string) -> string {
    let start = 0;
    for (let i = 0; i < sv_size(stack); i = i + 1) {
        if (sv_get(stack, i) == module_name) {
            start = i;
            break;
        }
    }

    with (let sb = sb_create() => sb_free(sb)) {
        for (let i2 = start; i2 < sv_size(stack); i2 = i2 + 1) {
            if (i2 > start) {
                sb_append(sb, " -> ");
            }
            sb_append(sb, sv_get(stack, i2));
        }
        if (sv_size(stack) > start) {
            sb_append(sb, " -> ");
        }
        sb_append(sb, module_name);
        return sb_to_string(sb);
    }
}

/**
 * Lex and parse one module source file while emitting Stage 1-style debug logs.
 *
 * @param path Source path being processed.
 * @param source Source text to lex and parse.
 * @param cfg Logging configuration.
 * @return Parse result for the module.
 */
func dr_parse_source(path: string, source: string, cfg: LogConfig*) -> ParseResult* {
    log_debug(cfg, "Lexing " + path);
    let ls = ls_create(source, path);
    let toks = tokenize(ls);
    if (toks == null) {
        return parse_lex_error_result(ls, path);
    }

    let tv = toks as TokenVector;
    log_debug(cfg, "Lexed " + int_to_string(tv_len(tv)) + " token(s) from " + path);
    log_debug(cfg, "Parsing " + path);
    let pr = parse_module_tokens_owned(tv, path);
    ls_free(ls);

    if (pr.root_module != null) {
        let mod = pr.root_module as Module*;
        log_debug(cfg, "Parsed module '" + mod.name + "' from " + path);
    }

    return pr;
}

/**
 * Resolve and record every lifecycle, semantic, and link dependency from one
 * interface.
 *
 * All three views are traversed even after one provider fails, preserving
 * every manifest edge and allowing provider-level failure caching to suppress
 * duplicate diagnostics.
 *
 * @param ctx Borrowed resolution context.
 * @param node Interface-backed graph node receiving manifest edges.
 * @param raw Selected raw interface providing dependency entries.
 * @param stack Canonical resolution stack including `node`.
 * @return `true` when every dependency resolves.
 */
func dr_resolve_interface_dependencies(ctx: DriverResolutionContext*, node: ModuleGraphNode*,
                                       raw: ModuleInterface*, stack: StringVector*) -> bool {
    let ok = true;
    for (let import_i = 0; import_i < vec_size(raw.module_imports);
         import_i = import_i + 1) {
        let imported = ptr_vec_get(
            raw.module_imports, import_i) as InterfaceModuleImport*;
        mg_node_add_interface_import(node, imported.provider_module);
        if (!dr_resolve_module(ctx, stack, imported.provider_module)) {
            ok = false;
        }
    }
    for (let req_i = 0; req_i < vec_size(raw.require_entries); req_i = req_i + 1) {
        let dep = ptr_vec_get(raw.require_entries, req_i) as InterfaceDepEntry*;
        mg_node_add_dependency(node, MDK_REQUIRE, dep.provider_module, dep.symbol_name,
            dep.provider_fingerprint);
        if (!dr_resolve_module(ctx, stack, dep.provider_module)) {
            ok = false;
        }
    }
    for (let link_i = 0; link_i < vec_size(raw.link_entries); link_i = link_i + 1) {
        let dep2 = ptr_vec_get(raw.link_entries, link_i) as InterfaceDepEntry*;
        mg_node_add_dependency(node, MDK_LINK, dep2.provider_module, dep2.symbol_name,
            dep2.provider_fingerprint);
        if (!dr_resolve_module(ctx, stack, dep2.provider_module)) {
            ok = false;
        }
    }

    if (ok) {
        node.state = MNS_RESOLVED;
    } else {
        node.state = MNS_FAILED;
    }
    return ok;
}

/**
 * Recursively resolve one canonical module into the graph.
 *
 * @param ctx Borrowed recursion-invariant resolution inputs.
 * @param stack Canonical resolution stack.
 * @param module_name Requested module.
 * @return `true` when this node reaches the resolved state.
 */
func dr_resolve_module(ctx: DriverResolutionContext*, stack: StringVector*, module_name: string) -> bool {
    let state = ctx.state;
    if (ss_has(state.failed_without_node, module_name)) {
        log_debug(ctx.cfg, "Module '" + module_name + "' retains its failed pre-graph resolution state");
        return false;
    }

    if (!sp_is_valid_module_name(module_name)) {
        dr_emit_error(state.diags, "DRV-0072",
            "invalid canonical module name: '" + module_name + "'", "");
        return dr_fail_without_node(state, module_name);
    }

    let existing_opt = mg_find_node(state.graph, module_name);
    if (existing_opt != null) {
        let existing = existing_opt as ModuleGraphNode*;
        if (ord(existing.state) == ord(MNS_RESOLVED)) {
            log_debug(ctx.cfg, "Module '" + module_name + "' already resolved (cache hit)");
            return true;
        }
        if (ord(existing.state) == ord(MNS_FAILED)) {
            log_debug(ctx.cfg, "Module '" + module_name + "' retains its failed resolution state");
            return false;
        }
        if (ord(existing.state) == ord(MNS_RESOLVING)) {
            let chain = dr_format_cycle(stack, module_name);
            dr_emit_error(state.diags, "DRV-0030", "Cyclic module dependency: " + chain, "");
            return false;
        }
        dr_emit_error(state.diags, "DRV-0077",
            "conflicting unresolved graph identity for module '" + module_name + "'", "");
        existing.state = MNS_FAILED;
        return false;
    }

    if (dea_is_virtual_module_name(module_name)) {
        log_debug(ctx.cfg, "Treating module '" + module_name + "' as compiler-synthesized prelude");
        return true;
    }

    with (let next_stack = us_sv_clone(stack) => sv_free(next_stack)) {
        sv_push(next_stack, module_name);

        if (module_name != state.entry_module) {
            let candidate = spm_get(ctx.candidates, module_name);
            if (candidate != null) {
                let raw = miu_clone_interface(candidate as ModuleInterface*);
                let interface_name = "<interface:" + module_name + ">";
                if (!ifp_verify(raw, state.diags, interface_name)) {
                    mi_free(raw);
                    return dr_fail_without_node(state, module_name);
                }

                let node = mg_node_from_registry(module_name);
                node.state = MNS_RESOLVING;
                if (!dr_add_graph_node(state, node)) {
                    mi_free(raw);
                    return false;
                }

                dr_register_graph_interface(state, raw);
                log_debug(ctx.cfg, "Using supplied interface for module '" + module_name + "'");
                return dr_resolve_interface_dependencies(ctx, node, raw, next_stack);
            }

            let interface_path_opt = sp_resolve_interface(ctx.interface_roots, module_name);
            if (interface_path_opt != null) {
                let interface_path = interface_path_opt as string;
                if (!std.fs::is_file(interface_path)) {
                    dr_emit_error(state.diags, "DRV-0075",
                        "selected module interface is not a readable regular file: " + interface_path,
                        interface_path);
                    return dr_fail_without_node(state, module_name);
                }
                let interface_text_opt = read_file(interface_path);
                if (interface_text_opt == null) {
                    dr_emit_error(state.diags, "DRV-0075",
                        "cannot read selected module interface: " + interface_path, interface_path);
                    return dr_fail_without_node(state, module_name);
                }
                let interface_raw = interface_text_opt as string;
                if (!us_is_valid_utf8(interface_raw)) {
                    dr_emit_error(state.diags, "DRV-0076",
                        "selected module interface is not valid UTF-8", interface_path);
                    return dr_fail_without_node(state, module_name);
                }
                let interface_text = us_strip_utf8_bom(interface_raw);
                sv_push(state.source_names, interface_path);
                sv_push(state.source_texts, interface_text);

                let parsed = pi_parse_interface(interface_text, interface_path);
                dr_copy_interface_diags(state.diags, parsed);
                if (ipr_has_errors(parsed) || parsed.interface == null) {
                    ipr_free(parsed);
                    return dr_fail_without_node(state, module_name);
                }

                let raw2 = parsed.interface as ModuleInterface*;
                parsed.interface = null;
                ipr_free(parsed);
                if (raw2.module_name != module_name) {
                    let msg = "module name mismatch: file " + interface_path + " declares '" + raw2.module_name;
                    dr_emit_error(state.diags, "DRV-0020",
                        msg + "' but was loaded as '" + module_name + "'", interface_path);
                    mi_free(raw2);
                    return dr_fail_without_node(state, module_name);
                }

                if (!ifp_verify(raw2, state.diags, interface_path)) {
                    mi_free(raw2);
                    return dr_fail_without_node(state, module_name);
                }

                let artifacts = mg_artifacts_from_interface(module_name, interface_path, state.diags);
                if (artifacts == null) {
                    mi_free(raw2);
                    return dr_fail_without_node(state, module_name);
                }
                let node2 = mg_node_from_interface(module_name, interface_path,
                    artifacts as ModuleArtifactPaths*);
                node2.state = MNS_RESOLVING;
                if (!dr_add_graph_node(state, node2)) {
                    mi_free(raw2);
                    return false;
                }

                dr_register_graph_interface(state, raw2);
                return dr_resolve_interface_dependencies(ctx, node2, raw2, next_stack);
            }

            if (ord(ctx.policy) == ord(MRP_REQUIRE_INTERFACE)) {
                dr_emit_error(state.diags, "DRV-0074",
                    "required module interface for '" + module_name + "' was not found", "");
                return dr_fail_without_node(state, module_name);
            }
        }

        let path_opt = sp_resolve(ctx.search_paths, module_name);
        if (path_opt == null) {
            dr_emit_error(state.diags, "DRV-0010",
                "Module '" + module_name + "' not found in system_roots or project_roots", "");
            return dr_fail_without_node(state, module_name);
        }
        let path = path_opt as string;
        let artifacts2: ModuleArtifactPaths*? = null;
        if (ctx.artifact_root != null) {
            artifacts2 = mg_artifacts_for_module(ctx.artifact_root as string, module_name, state.diags);
            if (artifacts2 == null) {
                return dr_fail_without_node(state, module_name);
            }
        }
        let node3 = mg_node_from_source(module_name, path, artifacts2);
        node3.state = MNS_RESOLVING;
        if (!dr_add_graph_node(state, node3)) {
            return false;
        }

        log_debug(ctx.cfg, "Resolved '" + module_name + "' to " + path);
        let source_opt = read_file(path);
        if (source_opt == null) {
            dr_emit_error(state.diags, "DRV-0011", "cannot read source file: " + path, path);
            node3.state = MNS_FAILED;
            return false;
        }
        let source_raw = source_opt as string;
        if (!us_is_valid_utf8(source_raw)) {
            dr_emit_error(state.diags, "DRV-0040", "source file is not valid UTF-8", path);
            node3.state = MNS_FAILED;
            return false;
        }
        let source = us_strip_utf8_bom(source_raw);
        sv_push(state.source_names, path);
        sv_push(state.source_texts, source);

        let pr = dr_parse_source(path, source, ctx.cfg);
        let unit = new DriverUnit(module_name, path, pr);
        dr_register_unit(state, unit);
        dr_copy_parse_diags(state.diags, pr);

        let ok3 = !parse_has_errors(pr);
        if (pr.root_module == null) {
            ok3 = false;
        } else {
            let mod = pr.root_module as Module*;
            if (mod.name != module_name) {
                let msg2 = "module name mismatch: file " + path + " declares '" + mod.name;
                dr_emit_error(state.diags, "DRV-0020",
                    msg2 + "' but was loaded as '" + module_name + "'", path);
                ok3 = false;
            } else {
                for (let imp_i = 0; imp_i < vec_size(mod.imports); imp_i = imp_i + 1) {
                    let imp = ptr_vec_get(mod.imports, imp_i) as Import*;
                    mg_node_add_direct_import(node3, imp.name);
                }
                for (let imp_i2 = 0; imp_i2 < vec_size(mod.imports); imp_i2 = imp_i2 + 1) {
                    let imp2 = ptr_vec_get(mod.imports, imp_i2) as Import*;
                    if (!dr_resolve_module(ctx, next_stack, imp2.name)) {
                        ok3 = false;
                    }
                }
            }
        }
        if (ok3) node3.state = MNS_RESOLVED;
        else node3.state = MNS_FAILED;
        return ok3;
    }
}

/**
 * Normalize all selected interfaces after the complete peer closure exists.
 *
 * @param state Driver state containing raw parsed interfaces.
 */
func dr_normalize_graph_interfaces(state: DriverState*) {
    with (let source_modules = ptr_vec_create(vec_size(state.units)) => vec_free(source_modules)) {
        for (let unit_i = 0; unit_i < vec_size(state.units); unit_i = unit_i + 1) {
            let unit = ptr_vec_get(state.units, unit_i) as DriverUnit*;
            if (unit.parse_result.root_module != null) {
                ptr_vec_push(source_modules, unit.parse_result.root_module as void*);
            }
        }

        for (let i = 0; i < vec_size(state.graph_interfaces); i = i + 1) {
            pi_normalize_interface_types_with_sources(
                ptr_vec_get(state.graph_interfaces, i) as ModuleInterface*,
                state.graph_interfaces,
                source_modules
            );
        }
    }
}

/**
 * Activate direct interface imports and their transitive `require` closure.
 *
 * `link`-only graph nodes remain intentionally absent from the semantic and
 * projection interface registries.
 *
 * @param state Driver state whose graph closure is complete.
 */
func dr_activate_graph_interfaces(state: DriverState*) {
    with (let active = ss_create() => ss_free(active),
          let nodes = mg_nodes_sorted(state.graph) => vec_free(nodes)) {
        for (let i = 0; i < vec_size(nodes); i = i + 1) {
            let node = ptr_vec_get(nodes, i) as ModuleGraphNode*;
            if (ord(node.origin.kind) != ord(MOK_SOURCE) || ord(node.state) != ord(MNS_RESOLVED)) {
                continue;
            }
            for (let imp_i = 0; imp_i < mg_node_direct_import_count(node); imp_i = imp_i + 1) {
                let imported_name = mg_node_direct_import_get(node, imp_i);
                let imported_opt = mg_find_node(state.graph, imported_name);
                if (imported_opt == null) {
                    continue;
                }
                let imported = imported_opt as ModuleGraphNode*;
                if (ord(imported.state) == ord(MNS_RESOLVED) &&
                    (ord(imported.origin.kind) == ord(MOK_INTERFACE) ||
                     ord(imported.origin.kind) == ord(MOK_REGISTRY))) {
                    ss_add(active, imported.module_name);
                }
            }
        }

        let changed = true;
        while (changed) {
            changed = false;
            for (let node_i = 0; node_i < vec_size(nodes); node_i = node_i + 1) {
                let node2 = ptr_vec_get(nodes, node_i) as ModuleGraphNode*;
                if (!ss_has(active, node2.module_name)) {
                    continue;
                }
                for (let dep_i = 0; dep_i < mg_node_dependency_count(node2); dep_i = dep_i + 1) {
                    let dep = mg_node_dependency_get(node2, dep_i);
                    if (ord(dep.kind) != ord(MDK_REQUIRE)) {
                        continue;
                    }
                    let provider_opt = mg_find_node(state.graph, dep.provider_module);
                    if (provider_opt == null) {
                        continue;
                    }
                    let provider = provider_opt as ModuleGraphNode*;
                    if (ord(provider.state) == ord(MNS_RESOLVED) &&
                        (ord(provider.origin.kind) == ord(MOK_INTERFACE) ||
                         ord(provider.origin.kind) == ord(MOK_REGISTRY)) &&
                        ss_add(active, provider.module_name)) {
                        changed = true;
                    }
                }
            }
        }

        with (let names = mg_node_names_sorted(state.graph) => sv_free(names)) {
            for (let name_i = 0; name_i < sv_size(names); name_i = name_i + 1) {
                let name = sv_get(names, name_i);
                if (!ss_has(active, name)) {
                    continue;
                }
                let raw_opt = driver_find_graph_interface(state, name);
                if (raw_opt == null) {
                    continue;
                }
                let raw = raw_opt as ModuleInterface*;
                dr_register_projection_interface(state, miu_clone_interface(raw));
                let semantic = miu_clone_interface(raw);
                miu_resolve_interface_alias_refs(semantic);
                dr_register_interface(state, semantic);
            }
        }
    }
}

/**
 * Build one module graph through the shared filesystem/registry loader.
 *
 * @param search_paths Source search paths used for module resolution.
 * @param entry_module Canonical source entry module.
 * @param interface_roots Ordered filesystem interface roots.
 * @param policy Missing-interface policy for imported modules.
 * @param artifact_root Optional artifact root associated with source nodes.
 * @param interfaces Optional borrowed test registry; never combined by public APIs with filesystem roots.
 * @param cfg Logging configuration.
 * @return Driver state containing the graph, parsed sources, selected interfaces, and diagnostics.
 */
func dr_analyze_entry_core(search_paths: SourceSearchPaths*, entry_module: string,
                           interface_roots: StringVector*, policy: ModuleResolutionPolicy,
                           artifact_root: string?, interfaces: VectorBase*?, cfg: LogConfig*) -> DriverState* {
    log_info(cfg, "Starting analysis for entry module '" + entry_module + "'");
    log_stage(cfg, "Building compilation unit", entry_module);
    let state = dr_state_create(entry_module, interfaces);
    with (let candidates = dr_build_interface_candidates(state, interfaces) => spm_free(candidates)) {
        if (dr_validate_interface_roots(state, interface_roots) && !driver_has_errors(state)) {
            with (
                let ctx = new DriverResolutionContext(
                    state, candidates, search_paths, interface_roots, policy, artifact_root, cfg
                ) => drop ctx,
                let stack = sv_create(8) => sv_free(stack)
            ) {
                dr_resolve_module(ctx, stack, entry_module);
            }
        }
        if (!driver_has_errors(state)) {
            dr_normalize_graph_interfaces(state);
            dr_activate_graph_interfaces(state);
        }
        with (let names = mg_node_names_sorted(state.graph) => sv_free(names)) {
            log_debug(cfg, "Module graph contains " + int_to_string(sv_size(names)) +
                " node(s): " + join_s(names, ", "));
        }
    }
    return state;
}

/**
 * Load and parse an entry module and its source-fallback closure.
 *
 * @param search_paths Source search paths used for module resolution.
 * @param entry_module Entry module name.
 * @param cfg Logging configuration.
 * @return Driver state containing parsed modules, graph data, and diagnostics.
 */
func driver_analyze_entry(search_paths: SourceSearchPaths*, entry_module: string, cfg: LogConfig*) -> DriverState* {
    with (let interface_roots = sv_create(0) => sv_free(interface_roots)) {
        return dr_analyze_entry_core(search_paths, entry_module, interface_roots,
            MRP_ALLOW_SOURCE_FALLBACK, null, null, cfg);
    }
}

/**
 * Analyze a source entry with ordered filesystem interface resolution.
 *
 * @param search_paths Source search paths used for source fallback.
 * @param entry_module Canonical source entry module.
 * @param interface_roots Ordered filesystem interface roots.
 * @param policy Missing-interface policy for imported modules.
 * @param artifact_root Optional artifact root associated with source nodes.
 * @param cfg Logging configuration.
 * @return Driver state containing the resolved graph and diagnostics.
 */
func driver_analyze_entry_with_resolution(search_paths: SourceSearchPaths*, entry_module: string,
                                          interface_roots: StringVector*, policy: ModuleResolutionPolicy,
                                          artifact_root: string?, cfg: LogConfig*) -> DriverState* {
    return dr_analyze_entry_core(search_paths, entry_module, interface_roots, policy, artifact_root, null, cfg);
}

/**
 * Load a source entry through the test registry adapter over the graph loader.
 *
 * @param search_paths Source search paths used for module resolution.
 * @param entry_module Entry module name.
 * @param interfaces Borrowed vector of parsed provider interfaces.
 * @param cfg Logging configuration.
 * @return Driver state containing active cloned interfaces, graph data, and diagnostics.
 */
func driver_analyze_entry_with_interfaces(search_paths: SourceSearchPaths*, entry_module: string,
                                          interfaces: VectorBase*?, cfg: LogConfig*) -> DriverState* {
    with (let interface_roots = sv_create(0) => sv_free(interface_roots)) {
        return dr_analyze_entry_core(search_paths, entry_module, interface_roots,
            MRP_ALLOW_SOURCE_FALLBACK, null, interfaces, cfg);
    }
}
