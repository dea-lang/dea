module wrapper_emitter;

import std.text;
import std.vector;

import module_lifecycle;

/**
 * Append one complete source line.
 *
 * @param out Wrapper source buffer.
 * @param line Line text without its terminating newline.
 */
func we_append_line(out: CharBuffer*, line: string) {
    cb_append_s(out, line);
    cb_append(out, '\n');
}

/**
 * Emit the standalone executable wrapper for one verified Dea link set.
 *
 * `lifecycle_order` is already dependency-first and contains each linked Dea
 * module exactly once. Initialization preserves that order; finalization uses
 * its exact reverse. The selected entry bridge supplies the normalized process
 * status, while this wrapper owns the only process-level C `main`.
 *
 * @param lifecycle_order Verified dependency-first module order.
 * @param entry_module Canonical module name carrying the selected entry bridge.
 * @return Complete C source for the executable wrapper.
 */
func we_emit_wrapper(lifecycle_order: StringVector*, entry_module: string) -> string {
    with (let out = cb_create() => cb_free(out)) {
        we_append_line(out, "/* Generated by l1c --link. */");
        we_append_line(out, "#include \"dea_rt.h\"");
        we_append_line(out, "");

        for (let i = 0; i < sv_size(lifecycle_order); i = i + 1) {
            let module_name = sv_get(lifecycle_order, i);
            we_append_line(out, "extern void " + ml_init_symbol_name(module_name) + "(void);");
            we_append_line(out, "extern void " + ml_fini_symbol_name(module_name) + "(void);");
        }
        we_append_line(out, "extern int " + ml_entry_symbol_name(entry_module) + "(void);");
        we_append_line(out, "");

        we_append_line(out, "int main(int argc, char **argv)");
        we_append_line(out, "{");
        we_append_line(out, "    int dea_exit_code;");
        we_append_line(out, "");
        we_append_line(out, "    _rt_init_args(argc, argv);");
        for (let i = 0; i < sv_size(lifecycle_order); i = i + 1) {
            we_append_line(out, "    " + ml_init_symbol_name(sv_get(lifecycle_order, i)) + "();");
        }
        we_append_line(out, "    dea_exit_code = " + ml_entry_symbol_name(entry_module) + "();");
        for (let i = sv_size(lifecycle_order); i > 0; i = i - 1) {
            we_append_line(out, "    " + ml_fini_symbol_name(sv_get(lifecycle_order, i - 1)) + "();");
        }
        we_append_line(out, "    return dea_exit_code;");
        we_append_line(out, "}");

        return cb_to_string(out);
    }
}
