module type_resolve.const_eval;

import std.hashmap;
import std.string;
import ast;
import driver.state;
import lexer;
import name_resolver.state;
import parser.token_value;
import symbols;
import tokens;
import types;
import type_resolve.const_value;
import type_resolve.lookup;

/**
 * Parse a scalar canonical interface literal into a const value.
 *
 * Aggregate constructor and enum-variant literals deliberately return `null`;
 * callers still know the symbol is a const through `Symbol.is_const`.
 *
 * @param literal Canonical literal text from an interface const entry.
 * @return Owned scalar constant value, or `null` for non-scalar literals.
 */
func tr_const_eval_interface_literal_raw(literal: string) -> ConstValue*? {
    if (literal == "") {
        return null;
    }
    with (let ls = ls_create(literal, "<interface-const>") => ls_free(ls)) {
        let tokens_opt = tokenize(ls);
        if (tokens_opt == null) {
            return null;
        }
        with (let tv = tokens_opt as TokenVector => tv_free(tv)) {
            if (tv_len(tv) == 3) {
                let sign = tv_get(tv, 0);
                let tok = tv_get(tv, 1);
                let eof = tv_get(tv, 2);
                if (ord(sign.token_type) != ord(TT_MINUS) || ord(eof.token_type) != ord(TT_EOF)) {
                    return null;
                }
                match (tok.token_type) {
                    TT_INT(text, value) => {
                        if (starts_with_s(token_int_text(tok) as string, "-")) {
                            return null;
                        }
                        return tr_const_value_new(CV_INT, 0 - value, false, "", 0);
                    }
                    TT_REALNUM(sig, exp_text, is_float) => {
                        let real_text = token_real_text(tok) as string;
                        if (starts_with_s(real_text, "-")) {
                            return null;
                        }
                        let kind = CV_DOUBLE;
                        if (is_float) {
                            kind = CV_FLOAT;
                        }
                        return tr_const_value_new(kind, 0, false, "-" + real_text, 0);
                    }
                    TT_BIGINT(text2, base) => { return null; }
                    _ => { return null; }
                }
            }
            if (tv_len(tv) != 2) {
                return null;
            }
            let tok = tv_get(tv, 0);
            let eof = tv_get(tv, 1);
            if (ord(eof.token_type) != ord(TT_EOF)) {
                return null;
            }
            match (tok.token_type) {
                TT_INT(text, value) => { return tr_const_value_new(CV_INT, value, false, "", 0); }
                TT_BIGINT(text2, base) => { return tr_const_value_new(CV_BIGINT, 0, false, text2, base); }
                TT_BYTE(text3, value2) => { return tr_const_value_new(CV_BYTE, value2 as int, false, text3, 0); }
                TT_STRING(text4, value3) => {
                    return tr_const_value_new(CV_STRING, 0, false, value3, 0);
                }
                TT_REALNUM(sig, exp_text, is_float) => {
                    let kind = CV_DOUBLE;
                    if (is_float) {
                        kind = CV_FLOAT;
                    }
                    return tr_const_value_new(kind, 0, false, token_real_text(tok) as string, 0);
                }
                TT_TRUE => { return tr_const_value_new(CV_BOOL, 0, true, "", 0); }
                TT_FALSE => { return tr_const_value_new(CV_BOOL, 0, false, "", 0); }
                TT_NULL => { return tr_const_value_new(CV_NULL, 0, false, "", 0); }
                _ => { return null; }
            }
        }
    }
}

/**
 * Evaluate an interface-backed const symbol to a compile-time scalar value.
 *
 * @param ctx Const-evaluation context.
 * @param sym Interface-backed const symbol.
 * @param key Cache key for the symbol.
 * @return Owned scalar constant value, or `null` for aggregate/non-scalar literals.
 */
func tr_const_eval_interface_symbol(ctx: ConstEvalContext*, sym: Symbol*, key: string) -> ConstValue*? {
    let raw = tr_const_eval_interface_literal_raw(sym.const_literal);
    if (raw == null) {
        return null;
    }
    let resolved_type = spm_get(ctx.tables.let_types, key);
    let value: ConstValue*? = null;
    if (resolved_type != null) {
        value = tr_const_value_for_type(raw as ConstValue*, resolved_type as Type*);
    } else {
        value = raw;
        raw = null;
    }
    if (raw != null) {
        tr_const_value_free(raw as ConstValue*);
    }
    if (value == null) {
        return null;
    }
    spm_put(ctx.cache, key, tr_const_value_clone(value as ConstValue*) as void*);
    return value;
}

/**
 * Return the Dea 32-bit `int` minimum used by Stage 1 const folding.
 *
 * @return Minimum representable `int` payload.
 */
func tr_const_int_min_value() -> int {
    return -2147483648;
}

/**
 * Return the Dea 32-bit `int` maximum used by Stage 1 const folding.
 *
 * @return Maximum representable `int` payload.
 */
func tr_const_int_max_value() -> int {
    return 2147483647;
}

/**
 * Safely negate one const integer payload.
 *
 * @param value Integer payload.
 * @return Negated payload, or `null` on overflow.
 */
func tr_const_safe_negate(value: int) -> int? {
    if (value == tr_const_int_min_value()) {
        return null;
    }
    return -value;
}

/**
 * Safely fold bitwise-not over one 32-bit `int` payload.
 *
 * @param value Integer payload.
 * @return Folded payload.
 */
func tr_const_safe_bitwise_not(value: int) -> int? {
    if (value == tr_const_int_max_value()) {
        return tr_const_int_min_value();
    }
    return -(value + 1);
}

/**
 * Safely add two const integer payloads.
 *
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Sum, or `null` on overflow.
 */
func tr_const_safe_add(lhs: int, rhs: int) -> int? {
    let max = tr_const_int_max_value();
    let min = tr_const_int_min_value();
    if (lhs > 0 && rhs > max - lhs) {
        return null;
    }
    if (lhs < 0 && rhs < min - lhs) {
        return null;
    }
    return lhs + rhs;
}

/**
 * Safely subtract two const integer payloads.
 *
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Difference, or `null` on overflow.
 */
func tr_const_safe_subtract(lhs: int, rhs: int) -> int? {
    let max = tr_const_int_max_value();
    let min = tr_const_int_min_value();
    if (rhs > 0 && lhs < min + rhs) {
        return null;
    }
    if (rhs < 0 && lhs > max + rhs) {
        return null;
    }
    return lhs - rhs;
}

/**
 * Safely multiply two const integer payloads.
 *
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Product, or `null` on overflow.
 */
func tr_const_safe_multiply(lhs: int, rhs: int) -> int? {
    if (lhs == 0 || rhs == 0) {
        return 0;
    }
    let max = tr_const_int_max_value();
    let min = tr_const_int_min_value();
    if (lhs > 0) {
        if (rhs > 0) {
            if (lhs > max / rhs) return null;
        } else {
            if (rhs < min / lhs) return null;
        }
    } else {
        if (rhs > 0) {
            if (lhs < min / rhs) return null;
        } else {
            if (lhs < max / rhs) return null;
        }
    }
    return lhs * rhs;
}

/**
 * Safely divide two const integer payloads.
 *
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Quotient, or `null` for invalid arithmetic.
 */
func tr_const_safe_divide(lhs: int, rhs: int) -> int? {
    if (rhs == 0) {
        return null;
    }
    if (lhs == tr_const_int_min_value() && rhs == -1) {
        return null;
    }
    return lhs / rhs;
}

/**
 * Safely fold integer remainder over const payloads.
 *
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Remainder, or `null` for invalid arithmetic.
 */
func tr_const_safe_modulo(lhs: int, rhs: int) -> int? {
    if (rhs == 0) {
        return null;
    }
    if (lhs == tr_const_int_min_value() && rhs == -1) {
        return null;
    }
    return lhs % rhs;
}

/**
 * Return 2 raised to a supported non-negative shift count.
 *
 * @param shift Shift count.
 * @return Power of two, or `null` when unsupported.
 */
func tr_const_eval_pow2(shift: int) -> int? {
    if (shift < 0 || shift > 30) {
        return null;
    }
    let result = 1;
    for (let i = 0; i < shift; i = i + 1) {
        let next = tr_const_safe_multiply(result, 2);
        if (next == null) return null;
        result = next as int;
    }
    return result;
}

/**
 * Safely fold a bitwise operator for non-negative 32-bit `int` payloads.
 *
 * L0 reserves bitwise operators, so the bootstrap evaluator computes these
 * with arithmetic over positive integer payloads.
 *
 * @param op Operator spelling.
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Folded integer payload, or `null` when unsupported.
 */
func tr_const_safe_positive_bitwise(op: string, lhs: int, rhs: int) -> int? {
    if (lhs < 0 || rhs < 0) {
        return null;
    }
    let left = lhs;
    let right = rhs;
    let place = 1;
    let result = 0;
    while (left > 0 || right > 0) {
        let left_bit = left % 2;
        let right_bit = right % 2;
        let out_bit = 0;
        if (op == "&") {
            if (left_bit == 1 && right_bit == 1) {
                out_bit = 1;
            }
        } else if (op == "|") {
            if (left_bit == 1 || right_bit == 1) {
                out_bit = 1;
            }
        } else if (op == "^") {
            if (left_bit != right_bit) {
                out_bit = 1;
            }
        } else {
            return null;
        }
        if (out_bit == 1) {
            let next_result = tr_const_safe_add(result, place);
            if (next_result == null) return null;
            result = next_result as int;
        }
        left = left / 2;
        right = right / 2;
        if (left > 0 || right > 0) {
            let next_place = tr_const_safe_multiply(place, 2);
            if (next_place == null) return null;
            place = next_place as int;
        }
    }
    return result;
}

/**
 * Safely shift a non-negative const integer payload left.
 *
 * @param lhs Left integer payload.
 * @param rhs Shift count.
 * @return Shifted payload, or `null` when unsupported.
 */
func tr_const_safe_shift_left(lhs: int, rhs: int) -> int? {
    if (lhs < 0) {
        return null;
    }
    let factor = tr_const_eval_pow2(rhs);
    if (factor == null) {
        return null;
    }
    return tr_const_safe_multiply(lhs, factor as int);
}

/**
 * Safely shift a non-negative const integer payload right.
 *
 * @param lhs Left integer payload.
 * @param rhs Shift count.
 * @return Shifted payload, or `null` when unsupported.
 */
func tr_const_safe_shift_right(lhs: int, rhs: int) -> int? {
    if (lhs < 0) {
        return null;
    }
    let divisor = tr_const_eval_pow2(rhs);
    if (divisor == null) {
        return null;
    }
    return lhs / (divisor as int);
}

/**
 * Fold one integer binary operator to a 32-bit `int` payload.
 *
 * @param op Operator spelling.
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Folded integer payload, or `null` for invalid operations.
 */
func tr_const_eval_integer_binary_payload(op: string, lhs: int, rhs: int) -> int? {
    if (op == "+") return tr_const_safe_add(lhs, rhs);
    if (op == "-") return tr_const_safe_subtract(lhs, rhs);
    if (op == "*") return tr_const_safe_multiply(lhs, rhs);
    if (op == "/") return tr_const_safe_divide(lhs, rhs);
    if (op == "%") return tr_const_safe_modulo(lhs, rhs);
    if (op == "&" || op == "|" || op == "^") return tr_const_safe_positive_bitwise(op, lhs, rhs);
    if (op == "<<") return tr_const_safe_shift_left(lhs, rhs);
    if (op == ">>") return tr_const_safe_shift_right(lhs, rhs);
    return null;
}

/**
 * Fold one integer binary operator.
 *
 * @param op Operator spelling.
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Folded integer value, or `null` for invalid operations.
 */
func tr_const_eval_integer_binary(op: string, lhs: int, rhs: int) -> ConstValue*? {
    let payload = tr_const_eval_integer_binary_payload(op, lhs, rhs);
    if (payload == null) {
        return null;
    }
    return tr_const_int_value(payload as int);
}

/**
 * Fold one integer comparison operator.
 *
 * @param op Operator spelling.
 * @param lhs Left integer payload.
 * @param rhs Right integer payload.
 * @return Folded boolean value, or `null` when `op` is not a comparison.
 */
func tr_const_eval_integer_compare(op: string, lhs: int, rhs: int) -> ConstValue*? {
    if (op == "<") {
        return tr_const_bool_value(lhs < rhs);
    }
    if (op == "<=") {
        return tr_const_bool_value(lhs <= rhs);
    }
    if (op == ">") {
        return tr_const_bool_value(lhs > rhs);
    }
    if (op == ">=") {
        return tr_const_bool_value(lhs >= rhs);
    }
    return null;
}

/**
 * Compare two supported scalar constant values for equality.
 *
 * @param left Left constant value.
 * @param right Right constant value.
 * @return Equality result, or `null` when the value families are unsupported.
 */
func tr_const_eval_values_equal(left: ConstValue*, right: ConstValue*) -> bool? {
    if (tr_const_value_is_integer_like(left) && tr_const_value_is_integer_like(right)) {
        return left.int_value == right.int_value;
    }
    if (ord(left.kind) == ord(CV_BOOL) && ord(right.kind) == ord(CV_BOOL)) {
        return left.bool_value == right.bool_value;
    }
    if (ord(left.kind) == ord(CV_STRING) && ord(right.kind) == ord(CV_STRING)) {
        return left.text_value == right.text_value;
    }
    return null;
}

/**
 * Return whether an expression names a semantically accepted const declaration.
 *
 * This distinguishes non-constant expressions from constants whose value kind is
 * intentionally unsupported by the scalar constant evaluator.
 *
 * @param ctx Const-evaluation context.
 * @param env Module environment controlling name lookup.
 * @param expr_id Expression to inspect.
 * @return `true` when the expression names a resolved const declaration.
 */
func tr_expr_names_resolved_const(ctx: ConstEvalContext*, env: ModuleEnv*, expr_id: ExprId) -> bool {
    let unit = driver_find_unit(ctx.driver_state, env.module_name);
    if (unit == null || expr_id < 0) {
        return false;
    }
    let expr = expr_arena_get((unit as DriverUnit*).parse_result.expr_arena, expr_id);
    if (ord(expr.kind) == ord(EX_PAREN)) {
        return tr_expr_names_resolved_const(ctx, env, expr.expr_a);
    }
    if (ord(expr.kind) != ord(EX_VAR_REF)) {
        return false;
    }
    let sym = tr_symbol_lookup(ctx.nr, env, expr.text_value, expr.module_path, expr.name_qualifier);
    if (sym == null || ord((sym as Symbol*).kind) != ord(SYM_LET) || !(sym as Symbol*).is_const) {
        return false;
    }
    return spm_get(ctx.tables.let_types, tr_key((sym as Symbol*).module_name, (sym as Symbol*).name)) != null;
}
