module type_resolve;

import std.hashset;
import std.hashmap;
import std.string;
import std.text;
import std.vector;
import util.diag;
import util.numbers;

import ast;
import driver;
import name_resolver;
import symbols;
import types;

/**
 * Build a fully qualified type-resolution key.
 *
 * @param module_name Defining module name.
 * @param name Symbol name within the module.
 * @return Key in `module::name` form.
 */
func tr_key(module_name: string, name: string) -> string {
    return module_name + "::" + name;
}

/**
 * Join a parsed module path into dotted form.
 *
 * @param path Vector of module-path components.
 * @return Dotted module name.
 */
func tr_module_from_path(path: StringVector*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(path); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ".");
            }
            sb_append(sb, sv_get(path, i));
        }
        return sb_to_string(sb);
    }
}

/**
 * Format the fully qualified display name for one parsed type reference.
 *
 * @param tref Parsed type reference to render.
 * @return Display string including module path and name qualifier segments.
 */
func tr_type_ref_full_name(tref: TypeRef*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        if (tref.module_path != null) {
            let mp = tref.module_path as StringVector*;
            for (let i = 0; i < sv_size(mp); i = i + 1) {
                if (i > 0) {
                    sb_append(sb, ".");
                }
                sb_append(sb, sv_get(mp, i));
            }
            if (sv_size(mp) > 0) {
                sb_append(sb, "::");
            }
        }
        if (tref.name_qualifier != null) {
            let nq = tref.name_qualifier as StringVector*;
            for (let i = 0; i < sv_size(nq); i = i + 1) {
                sb_append(sb, sv_get(nq, i));
                sb_append(sb, "::");
            }
        }
        sb_append(sb, tref.name);
        return sb_to_string(sb);
    }
}

/**
 * Format the direct type name suggestion for one parsed type reference.
 *
 * @param tref Parsed type reference to simplify.
 * @return Display string omitting enum-style qualifier segments.
 */
func tr_type_ref_simple_name(tref: TypeRef*) -> string {
    if (tref.module_path == null) {
        return tref.name;
    }
    return tr_module_from_path(tref.module_path as StringVector*) + "::" + tref.name;
}

/**
 * Collect imported module names contributing one ambiguous type name.
 *
 * @param nr Name-resolution result containing all module environments.
 * @param env Current module environment.
 * @param name Ambiguous imported type name.
 * @return Sorted module names that provide the ambiguous type.
 */
func tr_ambiguous_type_modules(nr: NameResolution*, env: ModuleEnv*, name: string) -> StringVector* {
    let modules = sv_create(4);
    for (let i = 0; i < nr_env_count(nr); i = i + 1) {
        let candidate = nr_env_get(nr, i);
        if (!nr_module_env_imports_module(env, candidate.module_name)) {
            continue;
        }
        if (nr_module_env_local(candidate, name) == null) {
            continue;
        }
        sv_push(modules, candidate.module_name);
    }
    sv_sort(modules);
    return modules;
}

/**
 * Format one quoted module list for ambiguous-type diagnostics.
 *
 * @param modules Sorted module names contributing an ambiguity.
 * @return String like `a', 'b`.
 */
func tr_format_ambiguous_modules(modules: StringVector*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(modules); i = i + 1) {
            if (i > 0) {
                sb_append(sb, "', '");
            }
            sb_append(sb, sv_get(modules, i));
        }
        return sb_to_string(sb);
    }
}

/**
 * Format the disambiguation hints for one ambiguous type name.
 *
 * @param modules Sorted module names contributing an ambiguity.
 * @param name Ambiguous type name.
 * @return String like `'a::T' or 'b::T'`.
 */
func tr_format_ambiguous_hints(modules: StringVector*, name: string) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(modules); i = i + 1) {
            if (i > 0) {
                sb_append(sb, " or ");
            }
            sb_append(sb, "'");
            sb_append(sb, sv_get(modules, i));
            sb_append(sb, "::");
            sb_append(sb, name);
            sb_append(sb, "'");
        }
        return sb_to_string(sb);
    }
}

/**
 * Emit a type-resolution diagnostic for a source span.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func tr_diag_error(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_error(diags, "TypeResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Free an optional resolved type.
 *
 * @param ty Optional type to free.
 */
func tr_type_free_opt(ty: Type*?) {
    if (ty != null) {
        type_free(ty as Type*);
    }
}

/**
 * Resolve a symbol visible from a module environment.
 *
 * @param nr Name-resolution data containing module environments.
 * @param env Current module environment.
 * @param name Unqualified symbol name.
 * @param module_path Optional parsed module path for cross-module lookup.
 * @param name_qualifier Optional enum-variant qualifier.
 * @return Resolved symbol, or `null` if lookup fails.
 */
func tr_symbol_lookup(nr: NameResolution*, env: ModuleEnv*, name: string, module_path: StringVector*?,
                       name_qualifier: StringVector*?) -> Symbol*? {
    if (module_path == null) {
        if (name_qualifier == null) {
            if (nr_module_env_is_ambiguous(env, name)) {
                return null;
            }
            return nr_module_env_all(env, name);
        }

        if (sv_size(name_qualifier as StringVector*) != 1) {
            return null;
        }

        let sym = nr_module_env_all(env, name);
        if (sym == null) {
            return null;
        }
        let s = sym as Symbol*;
        if (ord(s.kind) != ord(SYM_ENUM_VARIANT)) {
            return null;
        }
        if (s.owner_name != sv_get(name_qualifier as StringVector*, 0)) {
            return null;
        }
        return s;
    }

    let target_module = tr_module_from_path(module_path as StringVector*);
    let target_env: ModuleEnv*? = null;
    let use_exports = false;
    let alias_env = nr_module_env_alias_target(env, target_module);
    if (alias_env != null) {
        target_env = alias_env as ModuleEnv*;
        use_exports = true;
    } else if (target_module == env.module_name) {
        target_env = env;
    } else if (nr_module_env_qualifies_module(env, target_module)) {
        target_env = nr_env_find(nr, target_module);
        use_exports = true;
    } else {
        return null;
    }
    if (target_env == null) {
        return null;
    }

    if (name_qualifier == null) {
        if (use_exports) {
            return nr_map_symbol_get((target_env as ModuleEnv*).exports, name);
        }
        return nr_module_env_local(target_env as ModuleEnv*, name);
    }

    if (sv_size(name_qualifier as StringVector*) != 1) {
        return null;
    }

    let sym2: Symbol*? = null;
    if (use_exports) {
        sym2 = nr_map_symbol_get((target_env as ModuleEnv*).exports, name);
    } else {
        sym2 = nr_module_env_local(target_env as ModuleEnv*, name);
    }
    if (sym2 == null) {
        return null;
    }
    let s2 = sym2 as Symbol*;
    if (ord(s2.kind) != ord(SYM_ENUM_VARIANT)) {
        return null;
    }
    if (s2.owner_name != sv_get(name_qualifier as StringVector*, 0)) {
        return null;
    }
    return s2;
}

/**
 * Defines compile-time constant value kinds known to semantic resolution.
 */
enum ConstValueKind {
    CV_INT;
    CV_OTHER_INT;
    CV_BIGINT;
    CV_BYTE;
    CV_BOOL;
    CV_STRING;
    CV_FLOAT;
    CV_DOUBLE;
    CV_NULL;
}

/**
 * Represents one evaluated compile-time constant value.
 */
struct ConstValue {
    kind: ConstValueKind;
    int_value: int;
    bool_value: bool;
    text_value: string;
    base_value: int;
}

/**
 * Describes a precise failure encountered while evaluating a constant cast.
 */
struct ConstEvalFailure {
    code: string;
    message: string;
    filename: string;
    span: Span;
}

/**
 * Carries semantic context and per-evaluation cache for const evaluation.
 */
struct ConstEvalContext {
    driver_state: DriverState*;
    tables: SignatureTables*;
    nr: NameResolution*;
    diags: DiagCollector*;
    cache: StringPtrMap*;
    visiting: StringSet*;
    failure: ConstEvalFailure*?;
}

/**
 * Create a compile-time constant value.
 *
 * @param kind Constant value kind.
 * @param int_value Integer payload for integer-like values.
 * @param bool_value Boolean payload.
 * @param text_value Text payload for string, real, and bigint values.
 * @param base_value Literal base for bigint values.
 * @return New constant value.
 */
func tr_const_value_new(kind: ConstValueKind, int_value: int, bool_value: bool, text_value: string,
                        base_value: int) -> ConstValue* {
    return new ConstValue(kind, int_value, bool_value, text_value, base_value);
}

/**
 * Clone a compile-time constant value.
 *
 * @param value Value to clone.
 * @return New owned value with the same payload.
 */
func tr_const_value_clone(value: ConstValue*) -> ConstValue* {
    return new ConstValue(value.kind, value.int_value, value.bool_value, value.text_value, value.base_value);
}

/**
 * Free a compile-time constant value.
 *
 * @param value Value to release.
 */
func tr_const_value_free(value: ConstValue*) {
    drop value;
}

/**
 * Create a const-evaluation context.
 *
 * @param driver_state Parsed driver state.
 * @param tables Signature tables available to semantic resolution.
 * @param nr Name-resolution tables.
 * @param diags Diagnostic collector.
 * @return New const-evaluation context.
 */
func tr_const_eval_context_create(driver_state: DriverState*, tables: SignatureTables*, nr: NameResolution*,
                                  diags: DiagCollector*) -> ConstEvalContext* {
    return new ConstEvalContext(driver_state, tables, nr, diags, spm_create(), ss_create(), null);
}

/**
 * Free a const-evaluation context and cached values.
 *
 * @param self Context to release.
 */
func tr_const_eval_context_free(self: ConstEvalContext*) {
    for (let i = 0; i < spm_capacity(self.cache); i = i + 1) {
        if (spm_slot_occupied(self.cache, i)) {
            tr_const_value_free(spm_slot_value(self.cache, i) as ConstValue*);
        }
    }
    spm_free(self.cache);
    ss_free(self.visiting);
    if (self.failure != null) {
        let failure = self.failure as ConstEvalFailure*;
        drop failure;
    }
    drop self;
}

/**
 * Record the first precise constant-evaluation failure.
 *
 * @param self Evaluation context to update.
 * @param code Diagnostic code, or empty when another declaration or resolver owns the diagnostic.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span.
 */
func tr_const_eval_set_failure(self: ConstEvalContext*, code: string, message: string, filename: string, span: Span) {
    if (self.failure == null) {
        self.failure = new ConstEvalFailure(code, message, filename, span);
    }
}

/**
 * Return whether constant evaluation encountered a precise invalid expression.
 *
 * @param self Evaluation context to inspect.
 * @return `true` after an invalid cast or failed cast-target resolution.
 */
func tr_const_eval_failed(self: ConstEvalContext*) -> bool {
    return self.failure != null;
}

/**
 * Emit the precise failure retained by constant evaluation.
 *
 * @param self Evaluation context carrying the failure.
 */
func tr_const_eval_report_failure(self: ConstEvalContext*) {
    if (self.failure == null) {
        return;
    }
    let failure = self.failure as ConstEvalFailure*;
    if (failure.code != "") {
        tr_diag_error(self.diags, failure.code, failure.message, failure.filename, failure.span);
    }
}

/**
 * Return whether a constant value carries a host-sized integer payload.
 *
 * @param value Value to inspect.
 * @return `true` for integer-like values.
 */
func tr_const_value_is_integer_like(value: ConstValue*) -> bool {
    return ord(value.kind) == ord(CV_INT) || ord(value.kind) == ord(CV_BYTE) ||
           ord(value.kind) == ord(CV_OTHER_INT);
}

/**
 * Return whether a constant value belongs to the builtin integer family.
 *
 * @param value Value to inspect.
 * @return `true` for host-sized or bigint-backed integer values.
 */
func tr_const_value_is_integer(value: ConstValue*) -> bool {
    return tr_const_value_is_integer_like(value) || ord(value.kind) == ord(CV_BIGINT);
}

/**
 * Return whether a type is one of the builtin integer types.
 *
 * @param ty Type to inspect.
 * @return `true` for builtin integer types.
 */
func tr_type_is_integer(ty: Type*) -> bool {
    return ord(ty.kind) == ord(TY_BUILTIN) &&
        (ty.name == "tiny" || ty.name == "byte" || ty.name == "short" || ty.name == "ushort" ||
         ty.name == "int" || ty.name == "uint" || ty.name == "long" || ty.name == "ulong");
}

/**
 * Return a human-readable builtin integer range.
 *
 * @param ty Integer type.
 * @return Inclusive range text.
 */
func tr_builtin_int_range(ty: Type*) -> string {
    if (ty.name == "tiny") return "-128..127";
    if (ty.name == "byte") return "0..255";
    if (ty.name == "short") return "-32768..32767";
    if (ty.name == "ushort") return "0..65535";
    if (ty.name == "int") return "-2147483648..2147483647";
    if (ty.name == "uint") return "0..4294967295";
    if (ty.name == "long") return "-9223372036854775808..9223372036854775807";
    if (ty.name == "ulong") return "0..18446744073709551615";
    return "int";
}

/**
 * Format an integer constant value for diagnostics.
 *
 * @param value Integer constant value.
 * @return Source-like value text.
 */
func tr_const_integer_text(value: ConstValue*) -> string {
    if (ord(value.kind) == ord(CV_BIGINT)) {
        return bigint_to_string(value.text_value, value.base_value);
    }
    return int_to_string(value.int_value);
}

/**
 * Return whether an integer constant fits a target integer type.
 *
 * @param value Integer constant value.
 * @param target Target integer type.
 * @return `true` when the value is representable by `target`.
 */
func tr_const_integer_fits(value: ConstValue*, target: Type*) -> bool {
    if (ord(value.kind) == ord(CV_BIGINT)) {
        return bigint_fits_builtin(target, value.text_value, value.base_value);
    }
    return int_value_fits_builtin(target, value.int_value);
}

/**
 * Reclassify a checked integer value for its cast target.
 *
 * @param value Source integer value known to fit.
 * @param target Target integer type.
 * @return Target-typed constant value.
 */
func tr_const_integer_for_target(value: ConstValue*, target: Type*) -> ConstValue* {
    if (ord(value.kind) == ord(CV_BIGINT)) {
        return tr_const_value_clone(value);
    }
    if (target.name == "int") {
        return tr_const_value_new(CV_INT, value.int_value, false, "", 0);
    }
    if (target.name == "byte") {
        return tr_const_value_new(CV_BYTE, value.int_value, false, "", 0);
    }
    return tr_const_value_new(CV_OTHER_INT, value.int_value, false, target.name, 0);
}

/**
 * Normalize real-literal spelling for a target real type.
 *
 * @param text Canonical source spelling.
 * @param target_name `float` or `double`.
 * @return Spelling carrying the target type's suffix convention.
 */
func tr_real_text_for_target(text: string, target_name: string) -> string {
    if (target_name == "float") {
        if (ends_with_s(text, "f")) {
            return text;
        }
        return text + "f";
    }
    if (ends_with_s(text, "f")) {
        return slice_s(text, 0, len_s(text) - 1);
    }
    return text;
}

/**
 * Reclassify a raw initializer value using a resolved declaration type.
 *
 * @param value Raw evaluated initializer value.
 * @param ty Resolved declaration type.
 * @return New value adjusted to the declared scalar kind, or `null` when not representable.
 */
func tr_const_value_for_type(value: ConstValue*, ty: Type*) -> ConstValue*? {
    if (ord(ty.kind) != ord(TY_BUILTIN)) {
        return null;
    }
    if (ty.name == "int") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_INT, value.int_value, false, "", 0);
        }
    } else if (ty.name == "byte") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_BYTE, value.int_value, false, "", 0);
        }
    } else if (ty.name == "tiny" || ty.name == "short" || ty.name == "ushort" ||
               ty.name == "uint" || ty.name == "long" || ty.name == "ulong") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_OTHER_INT, value.int_value, false, ty.name, 0);
        }
        if (ord(value.kind) == ord(CV_BIGINT) && bigint_fits_builtin(ty, value.text_value, value.base_value)) {
            return tr_const_value_clone(value);
        }
    } else if (ty.name == "bool") {
        if (ord(value.kind) == ord(CV_BOOL)) {
            return tr_const_value_clone(value);
        }
    } else if (ty.name == "string") {
        if (ord(value.kind) == ord(CV_STRING)) {
            return tr_const_value_clone(value);
        }
    } else if (ty.name == "float") {
        if (ord(value.kind) == ord(CV_FLOAT)) {
            return tr_const_value_clone(value);
        }
        if (ord(value.kind) == ord(CV_DOUBLE)) {
            return tr_const_value_new(CV_FLOAT, 0, false, tr_real_text_for_target(value.text_value, "float"), 0);
        }
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_FLOAT, 0, false, int_to_string(value.int_value), 0);
        }
    } else if (ty.name == "double") {
        if (ord(value.kind) == ord(CV_DOUBLE) || ord(value.kind) == ord(CV_FLOAT)) {
            return tr_const_value_new(CV_DOUBLE, 0, false, tr_real_text_for_target(value.text_value, "double"), 0);
        }
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_DOUBLE, 0, false, int_to_string(value.int_value), 0);
        }
    }
    return null;
}

/**
 * Return the simple builtin type name from a const declaration annotation.
 *
 * @param decl Const declaration to inspect.
 * @return Builtin type name, or empty string when the annotation is not simple.
 */
func tr_const_decl_builtin_name(decl: LetDecl*) -> string {
    if (decl.type_ref == null) {
        return "";
    }
    let tref = decl.type_ref as TypeRef*;
    if (tref.module_path != null || tref.name_qualifier != null || tref.func_params != null ||
        tref.func_result != null || tref.suffixes != null || tref.pointer_depth != 0 || tref.is_nullable) {
        return "";
    }
    if (type_is_builtin_name(tref.name)) {
        return tref.name;
    }
    return "";
}

/**
 * Reclassify a raw initializer value using its const declaration annotation.
 *
 * @param value Raw evaluated initializer value.
 * @param decl Const declaration carrying the explicit type annotation.
 * @return New value adjusted to the declared scalar kind, or `null` when not representable.
 */
func tr_const_value_for_decl(value: ConstValue*, decl: LetDecl*) -> ConstValue*? {
    let builtin = tr_const_decl_builtin_name(decl);
    if (builtin == "int") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_INT, value.int_value, false, "", 0);
        }
    } else if (builtin == "byte") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_BYTE, value.int_value, false, "", 0);
        }
    } else if (builtin == "tiny" || builtin == "short" || builtin == "ushort" ||
               builtin == "uint" || builtin == "long" || builtin == "ulong") {
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_OTHER_INT, value.int_value, false, builtin, 0);
        }
        if (ord(value.kind) == ord(CV_BIGINT)) {
            with (let builtin_ty = type_new_builtin(builtin) => type_free(builtin_ty)) {
                if (bigint_fits_builtin(builtin_ty, value.text_value, value.base_value)) {
                    return tr_const_value_clone(value);
                }
            }
        }
    } else if (builtin == "bool") {
        if (ord(value.kind) == ord(CV_BOOL)) {
            return tr_const_value_clone(value);
        }
    } else if (builtin == "string") {
        if (ord(value.kind) == ord(CV_STRING)) {
            return tr_const_value_clone(value);
        }
    } else if (builtin == "float") {
        if (ord(value.kind) == ord(CV_FLOAT)) {
            return tr_const_value_clone(value);
        }
        if (ord(value.kind) == ord(CV_DOUBLE)) {
            return tr_const_value_new(CV_FLOAT, 0, false, tr_real_text_for_target(value.text_value, "float"), 0);
        }
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_FLOAT, 0, false, int_to_string(value.int_value), 0);
        }
    } else if (builtin == "double") {
        if (ord(value.kind) == ord(CV_DOUBLE) || ord(value.kind) == ord(CV_FLOAT)) {
            return tr_const_value_new(CV_DOUBLE, 0, false, tr_real_text_for_target(value.text_value, "double"), 0);
        }
        if (tr_const_value_is_integer_like(value)) {
            return tr_const_value_new(CV_DOUBLE, 0, false, int_to_string(value.int_value), 0);
        }
    }
    return null;
}

/**
 * Evaluate one supported scalar cast in a constant expression.
 *
 * @param ctx Const-evaluation context.
 * @param env Module environment controlling type and name lookup.
 * @param arena Expression arena containing the cast.
 * @param expr Cast expression node.
 * @return Owned target-typed value, or `null` when unsupported or invalid.
 */
func tr_const_eval_cast(ctx: ConstEvalContext*, env: ModuleEnv*, arena: ExprArena*, expr: ExprNode*) -> ConstValue*? {
    if (expr.type_ref == null) {
        // A parsed cast always carries a target type ref; treat its absence as a
        // non-constant expression so the visible SIG-0200/TYP-0815 path reports it.
        return null;
    }

    let source = tr_const_eval_expr_in_env(ctx, env, arena, expr.expr_a);
    if (source == null) {
        return null;
    }

    let target: Type*? = null;
    with (let seen = ss_create() => ss_free(seen)) {
        target = tr_resolve_type_ref(ctx.tables, ctx.nr, ctx.driver_state, env, expr.type_ref as TypeRef*,
            ctx.diags, seen);
    }
    if (target == null) {
        tr_const_value_free(source as ConstValue*);
        tr_const_eval_set_failure(ctx, "", "", env.module_ptr.filename, expr.span);
        return null;
    }

    let src = source as ConstValue*;
    let dst = target as Type*;
    let result: ConstValue*? = null;
    if (tr_const_value_is_integer(src) && tr_type_is_integer(dst)) {
        if (!tr_const_integer_fits(src, dst)) {
            tr_const_eval_set_failure(
                ctx,
                "TYP-0700",
                "integer constant " + tr_const_integer_text(src) + " is outside " + tr_builtin_int_range(dst) +
                    " for target type '" + type_format(dst) + "'",
                env.module_ptr.filename,
                expr.span
            );
        } else {
            result = tr_const_integer_for_target(src, dst);
        }
    } else if ((ord(src.kind) == ord(CV_FLOAT) || ord(src.kind) == ord(CV_DOUBLE)) &&
               ord(dst.kind) == ord(TY_BUILTIN) && (dst.name == "float" || dst.name == "double")) {
        let target_kind = CV_DOUBLE;
        if (dst.name == "float") {
            target_kind = CV_FLOAT;
        }
        result = tr_const_value_new(target_kind, 0, false, tr_real_text_for_target(src.text_value, dst.name), 0);
    } else if (ord(src.kind) == ord(CV_BOOL) && type_is_builtin(dst, "bool")) {
        result = tr_const_value_clone(src);
    } else if (ord(src.kind) == ord(CV_STRING) && type_is_builtin(dst, "string")) {
        result = tr_const_value_clone(src);
    }

    tr_const_value_free(src);
    type_free(dst);
    return result;
}

/**
 * Evaluate a const declaration symbol to a compile-time value.
 *
 * @param ctx Const-evaluation context.
 * @param sym Symbol to evaluate.
 * @return Owned constant value, or `null` when not evaluable.
 */
func tr_const_eval_symbol(ctx: ConstEvalContext*, sym: Symbol*) -> ConstValue*? {
    if (ord(sym.kind) != ord(SYM_LET) || sym.decl_ptr == null) {
        return null;
    }
    let decl = sym.decl_ptr as LetDecl*;
    if (!decl.is_const) {
        return null;
    }

    let key = tr_key(sym.module_name, sym.name);
    let cached = spm_get(ctx.cache, key);
    if (cached != null) {
        return tr_const_value_clone(cached as ConstValue*);
    }

    let unit = driver_find_unit(ctx.driver_state, sym.module_name);
    let env = nr_env_find(ctx.nr, sym.module_name);
    if (unit == null || env == null) {
        return null;
    }

    if (ss_has(ctx.visiting, key)) {
        tr_diag_error(
            ctx.diags,
            "SIG-0201",
            "compile-time constant cycle involving '" + sym.name + "'",
            (unit as DriverUnit*).path,
            sym.span
        );
        return null;
    }

    ss_add(ctx.visiting, key);
    let raw = tr_const_eval_expr_in_env(ctx, env as ModuleEnv*, (unit as DriverUnit*).parse_result.expr_arena,
        decl.value);
    ss_remove(ctx.visiting, key);
    if (raw == null) {
        if (ctx.failure != null) {
            // The referenced declaration owns this diagnostic. Retain failed
            // state to suppress a dependent SIG-0200 without reporting it again.
            (ctx.failure as ConstEvalFailure*).code = "";
        }
        return null;
    }

    let resolved_type = spm_get(ctx.tables.let_types, key);
    let value: ConstValue*? = null;
    if (resolved_type != null) {
        value = tr_const_value_for_type(raw as ConstValue*, resolved_type as Type*);
    } else {
        value = tr_const_value_for_decl(raw as ConstValue*, decl);
    }
    tr_const_value_free(raw as ConstValue*);
    if (value == null) {
        return null;
    }
    spm_put(ctx.cache, key, tr_const_value_clone(value as ConstValue*) as void*);
    return value;
}

/**
 * Evaluate an expression in a specific module environment to a compile-time value.
 *
 * @param ctx Const-evaluation context.
 * @param env Module environment controlling name lookup.
 * @param arena Expression arena containing `expr_id`.
 * @param expr_id Expression to evaluate.
 * @return Owned constant value, or `null` when not evaluable.
 */
func tr_const_eval_expr_in_env(ctx: ConstEvalContext*, env: ModuleEnv*, arena: ExprArena*, expr_id: ExprId) -> ConstValue*? {
    if (expr_id < 0) {
        return null;
    }
    let expr = expr_arena_get(arena, expr_id);
    match (expr.kind) {
        EX_INT => { return tr_const_value_new(CV_INT, expr.int_value, false, "", 0); }
        EX_BIGINT => { return tr_const_value_new(CV_BIGINT, 0, false, expr.text_value, expr.base_value); }
        EX_BYTE => { return tr_const_value_new(CV_BYTE, expr.int_value, false, expr.text_value, 0); }
        EX_BOOL => { return tr_const_value_new(CV_BOOL, 0, expr.bool_value, "", 0); }
        EX_STRING => { return tr_const_value_new(CV_STRING, 0, false, expr.text_value, 0); }
        EX_FLOAT => { return tr_const_value_new(CV_FLOAT, 0, false, expr.text_value, 0); }
        EX_DOUBLE => { return tr_const_value_new(CV_DOUBLE, 0, false, expr.text_value, 0); }
        EX_NULL => { return tr_const_value_new(CV_NULL, 0, false, "", 0); }
        EX_PAREN => { return tr_const_eval_expr_in_env(ctx, env, arena, expr.expr_a); }
        EX_VAR_REF => {
            let sym = tr_symbol_lookup(ctx.nr, env, expr.text_value, expr.module_path, expr.name_qualifier);
            if (sym == null) {
                return null;
            }
            return tr_const_eval_symbol(ctx, sym as Symbol*);
        }
        EX_CAST => { return tr_const_eval_cast(ctx, env, arena, expr); }
        _ => { return null; }
    }
}

/**
 * Evaluate an expression owned by a module environment to a compile-time value.
 *
 * @param ctx Const-evaluation context.
 * @param env Module environment owning the expression.
 * @param expr_id Expression to evaluate.
 * @return Owned constant value, or `null` when not evaluable.
 */
func tr_const_eval_expr(ctx: ConstEvalContext*, env: ModuleEnv*, expr_id: ExprId) -> ConstValue*? {
    let unit = driver_find_unit(ctx.driver_state, env.module_name);
    if (unit == null) {
        return null;
    }
    return tr_const_eval_expr_in_env(ctx, env, (unit as DriverUnit*).parse_result.expr_arena, expr_id);
}

/**
 * Return whether an expression names a semantically accepted const declaration.
 *
 * This distinguishes non-constant expressions from constants whose value kind is
 * intentionally unsupported by the scalar constant evaluator.
 *
 * @param ctx Const-evaluation context.
 * @param env Module environment controlling name lookup.
 * @param expr_id Expression to inspect.
 * @return `true` when the expression names a resolved const declaration.
 */
func tr_expr_names_resolved_const(ctx: ConstEvalContext*, env: ModuleEnv*, expr_id: ExprId) -> bool {
    let unit = driver_find_unit(ctx.driver_state, env.module_name);
    if (unit == null || expr_id < 0) {
        return false;
    }
    let expr = expr_arena_get((unit as DriverUnit*).parse_result.expr_arena, expr_id);
    if (ord(expr.kind) == ord(EX_PAREN)) {
        return tr_expr_names_resolved_const(ctx, env, expr.expr_a);
    }
    if (ord(expr.kind) != ord(EX_VAR_REF)) {
        return false;
    }
    let sym = tr_symbol_lookup(ctx.nr, env, expr.text_value, expr.module_path, expr.name_qualifier);
    if (sym == null || ord((sym as Symbol*).kind) != ord(SYM_LET) || (sym as Symbol*).decl_ptr == null) {
        return false;
    }
    let decl = (sym as Symbol*).decl_ptr as LetDecl*;
    if (!decl.is_const) {
        return false;
    }
    return spm_get(ctx.tables.let_types, tr_key((sym as Symbol*).module_name, (sym as Symbol*).name)) != null;
}

/**
 * Resolve a type alias symbol to its final target type.
 *
 * @param tables Signature tables available during type resolution.
 * @param nr Name-resolution data containing module environments.
 * @param env Current module environment for diagnostics.
 * @param sym Alias symbol to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param seen Alias keys currently being expanded for cycle detection.
 * @return Resolved aliased type, or `null` on failure.
 */
func tr_resolve_alias(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                       sym: Symbol*, diags: DiagCollector*, seen: StringSet*) -> Type*? {
    if (sym.resolved_type != null) {
        return type_clone(sym.resolved_type as Type*);
    }

    let key = tr_key(sym.module_name, sym.name);
    if (ss_has(seen, key)) {
        tr_diag_error(
            diags,
            "SIG-0020",
            "cyclic type alias involving '" + sym.name + "' in module '" + sym.module_name + "'",
            env.module_ptr.filename,
            sym.span
        );
        tr_diag_error(
            diags,
            "TYP-0270",
            "type alias '" + sym.name + "' does not have a resolved type",
            env.module_ptr.filename,
            sym.span
        );
        return null;
    }

    ss_add(seen, key);
    if (sym.decl_ptr == null) {
        ss_remove(seen, key);
        tr_diag_error(
            diags,
            "SIG-0021",
            "compiler-synthesized type alias '" + sym.name + "' in module '" + sym.module_name + "' has no declaration",
            env.module_ptr.filename,
            sym.span
        );
        return null;
    }

    let decl = sym.decl_ptr as TypeAliasDecl*;
    let resolved = tr_resolve_type_ref(tables, nr, driver_state, nr_env_find(nr, sym.module_name) as ModuleEnv*,
        decl.target, diags, seen);
    ss_remove(seen, key);
    if (resolved != null) {
        symbol_set_type_clone(sym, resolved as Type*);
    }
    return resolved;
}

/**
 * Apply pointer and nullable suffixes from a parsed type reference.
 *
 * @param base Resolved base type.
 * @param tref Parsed type reference supplying suffixes.
 * @param diags Diagnostic collector.
 * @param filename Source filename for diagnostics.
 * @return Suffixed type, or `null` if suffix validation fails.
 */
func tr_apply_suffix(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                     base: Type*, tref: TypeRef*, diags: DiagCollector*, filename: string) -> Type*? {
    let current = base;
    if (tref.suffixes != null) {
        let suffixes = tref.suffixes as VectorBase*;
        for (let i = 0; i < vec_size(suffixes); i = i + 1) {
            let suffix = ptr_vec_get(suffixes, i) as TypeSuffix*;
            if (ord(suffix.kind) == ord(TS_POINTER)) {
                if (ord(current.kind) == ord(TY_SLICE)) {
                    type_free(current);
                    tr_diag_error(diags, "TYP-0814", "slice type '[]' may not be a pointer base ('T[]*')",
                        filename, suffix.span);
                    return null;
                }
                current = type_new_pointer(current);
            } else if (ord(suffix.kind) == ord(TS_ARRAY)) {
                let resolved_len = suffix.array_len;
                if (suffix.array_len_expr >= 0) {
                    let value: ConstValue*? = null;
                    let names_resolved_const = false;
                    let const_eval_failed = false;
                    with (let ctx = tr_const_eval_context_create(driver_state, tables, nr, diags) =>
                          tr_const_eval_context_free(ctx)) {
                        value = tr_const_eval_expr(ctx, env, suffix.array_len_expr);
                        if (value == null) {
                            const_eval_failed = tr_const_eval_failed(ctx);
                            if (!const_eval_failed) {
                                names_resolved_const = tr_expr_names_resolved_const(ctx, env, suffix.array_len_expr);
                            }
                        }
                    }
                    if (value == null) {
                        type_free(current);
                        if (const_eval_failed) {
                            return null;
                        }
                        if (names_resolved_const) {
                            tr_diag_error(diags, "TYP-0816", "array length constant is not an int",
                                filename, suffix.span);
                        } else {
                            tr_diag_error(diags, "TYP-0815", "array length expression is not a compile-time constant",
                                filename, suffix.span);
                        }
                        return null;
                    }
                    let const_value = value as ConstValue*;
                    if (ord(const_value.kind) != ord(CV_INT)) {
                        tr_const_value_free(const_value);
                        type_free(current);
                        tr_diag_error(diags, "TYP-0816", "array length constant is not an int", filename, suffix.span);
                        return null;
                    }
                    resolved_len = const_value.int_value;
                    tr_const_value_free(const_value);
                }
                if (resolved_len <= 0) {
                    type_free(current);
                    tr_diag_error(diags, "TYP-0817", "array length constant is not positive", filename, suffix.span);
                    return null;
                }
                suffix.array_len = resolved_len;
                current = type_append_array_dimension(current, resolved_len);
            } else if (ord(suffix.kind) == ord(TS_SLICE) || ord(suffix.kind) == ord(TS_VARIADIC)) {
                if (ord(current.kind) == ord(TY_BUILTIN) && current.name == "void") {
                    type_free(current);
                    tr_diag_error(diags, "SIG-0011", "type 'void' cannot be a slice element", filename, tref.span);
                    return null;
                }
                current = type_new_slice(current);
            } else if (ord(suffix.kind) == ord(TS_NULLABLE)) {
                if (ord(current.kind) == ord(TY_BUILTIN) && current.name == "void") {
                    type_free(current);
                    tr_diag_error(diags, "SIG-0011", "type 'void' cannot be nullable", filename, tref.span);
                    return null;
                }
                if (ord(current.kind) == ord(TY_SLICE)) {
                    type_free(current);
                    tr_diag_error(diags, "TYP-0814", "slice type '[]' may not be made nullable ('T[]?')",
                        filename, suffix.span);
                    return null;
                }
                current = type_new_nullable(current);
            }
        }
        return current;
    }

    for (let j = 0; j < tref.pointer_depth; j = j + 1) {
        current = type_new_pointer(current);
    }

    if (!tref.is_nullable) {
        return current;
    }

    if (ord(current.kind) == ord(TY_BUILTIN) && current.name == "void") {
        type_free(current);
        tr_diag_error(diags, "SIG-0011", "type 'void' cannot be nullable", filename, tref.span);
        return null;
    }

    return type_new_nullable(current);
}

/**
 * Resolve a parsed type reference into a semantic type descriptor.
 *
 * @param tables Signature tables available during type resolution.
 * @param nr Name-resolution data containing module environments.
 * @param env Current module environment for lookup and diagnostics.
 * @param tref Parsed type reference to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param seen Alias keys currently being expanded for cycle detection.
 * @return Resolved type, or `null` if resolution fails.
 */
func tr_resolve_type_ref(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                         tref: TypeRef*, diags: DiagCollector*, seen: StringSet*) -> Type*? {
    if (tref.func_params != null) {
        with (let params: VectorBase*? = ptr_vec_create(vec_size(tref.func_params as VectorBase*)) => type_param_vec_free(params),
              let result: Type*? = null => tr_type_free_opt(result)) {
            let parsed_params = tref.func_params as VectorBase*;
            for (let i = 0; i < vec_size(parsed_params); i = i + 1) {
                let param_type = tr_resolve_type_ref(tables, nr, driver_state, env,
                    ptr_vec_get(parsed_params, i) as TypeRef*, diags, seen);
                if (param_type == null) {
                    return null;
                }
                ptr_vec_push(params as VectorBase*, param_type as void*);
            }
            result = tr_resolve_type_ref(tables, nr, driver_state, env, tref.func_result as TypeRef*, diags, seen);
            if (result == null) {
                return null;
            }
            let is_variadic = vec_size(parsed_params) > 0 &&
                type_ref_is_variadic(ptr_vec_get(parsed_params, vec_size(parsed_params) - 1) as TypeRef*);
            let func_ty = type_new_func(params as VectorBase*, result as Type*, tref.is_unsafe);
            if (is_variadic) {
                func_ty.is_variadic = true;
            }
            params = null;
            result = null;
            return tr_apply_suffix(tables, nr, driver_state, env, func_ty, tref, diags, env.module_ptr.filename);
        }
    }

    if (tref.name_qualifier != null) {
        let full = tr_type_ref_full_name(tref);
        let simple = tr_type_ref_simple_name(tref);
        tr_diag_error(
            diags,
            "SIG-0018",
            "nested symbol path '" + full + "': paths must have the form 'module::symbol' (did you mean '" + simple + "'?)",
            env.module_ptr.filename,
            tref.span
        );
        return null;
    }

    let base: Type*? = null;
    if (tref.module_path == null && type_is_builtin_name(tref.name)) {
        if (tref.name == "bool") {
            base = type_builtin_bool();
        } else if (tref.name == "tiny") {
            base = type_builtin_tiny();
        } else if (tref.name == "byte") {
            base = type_builtin_byte();
        } else if (tref.name == "short") {
            base = type_builtin_short();
        } else if (tref.name == "int") {
            base = type_builtin_int();
        } else if (tref.name == "ushort") {
            base = type_builtin_ushort();
        } else if (tref.name == "uint") {
            base = type_builtin_uint();
        } else if (tref.name == "long") {
            base = type_builtin_long();
        } else if (tref.name == "ulong") {
            base = type_builtin_ulong();
        } else if (tref.name == "float") {
            base = type_builtin_float();
        } else if (tref.name == "double") {
            base = type_builtin_double();
        } else if (tref.name == "uint") {
            base = type_builtin_uint();
        } else if (tref.name == "long") {
            base = type_builtin_long();
        } else if (tref.name == "ulong") {
            base = type_builtin_ulong();
        } else if (tref.name == "string") {
            base = type_builtin_string();
        } else {
            base = type_builtin_void();
        }
        return tr_apply_suffix(tables, nr, driver_state, env, base as Type*, tref, diags, env.module_ptr.filename);
    }

    if (tref.module_path == null && nr_module_env_is_ambiguous(env, tref.name)) {
        with (let modules = tr_ambiguous_type_modules(nr, env, tref.name) => sv_free(modules)) {
            let modules_str = tr_format_ambiguous_modules(modules);
            let hints = tr_format_ambiguous_hints(modules, tref.name);
            tr_diag_error(
                diags,
                "SIG-0019",
                "ambiguous type '" + tref.name + "' (imported from modules '" + modules_str + "'); use " + hints + " to disambiguate",
                env.module_ptr.filename,
                tref.span
            );
        }
        return null;
    }

    let sym = tr_symbol_lookup(nr, env, tref.name, tref.module_path, null);
    if (sym == null) {
        tr_diag_error(
            diags,
            "SIG-0019",
            "unknown type '" + tref.name + "' in module '" + env.module_name + "'",
            env.module_ptr.filename,
            tref.span
        );
        return null;
    }

    let s = sym as Symbol*;
    if (ord(s.kind) == ord(SYM_STRUCT)) {
        base = type_new_struct(s.module_name, s.name);
    } else if (ord(s.kind) == ord(SYM_ENUM)) {
        base = type_new_enum(s.module_name, s.name);
    } else if (ord(s.kind) == ord(SYM_TYPE_ALIAS)) {
        base = tr_resolve_alias(tables, nr, driver_state, env, s, diags, seen);
    } else {
        tr_diag_error(
            diags,
            "SIG-0010",
            "symbol '" + s.name + "' in module '" + env.module_name + "' is not a type (kind=" + symbol_kind_name(s.kind) + ")",
            env.module_ptr.filename,
            tref.span
        );
        return null;
    }

    if (base == null) {
        return null;
    }
    return tr_apply_suffix(tables, nr, driver_state, env, base as Type*, tref, diags, env.module_ptr.filename);
}
