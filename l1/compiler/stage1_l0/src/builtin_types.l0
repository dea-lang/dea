module builtin_types;

/**
 * Check whether a name belongs to the L1 builtin type inventory.
 *
 * This predicate is the compiler-wide authority used by token reservation,
 * parser type lookahead, and semantic type recognition.
 *
 * @param name Type name to inspect.
 * @return `true` if `name` names an L1 builtin type.
 */
func builtin_type_name_is_known(name: string) -> bool {
    return name == "bool" || name == "tiny" || name == "byte" ||
           name == "short" || name == "ushort" || name == "int" ||
           name == "uint" || name == "long" || name == "ulong" ||
           name == "float" || name == "double" || name == "string" ||
           name == "void";
}
