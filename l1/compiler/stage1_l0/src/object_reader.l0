module object_reader;

import std.fs;
import std.integer;
import std.string;
import std.text;
import std.vector;

import object_metadata;
import object_reader_elf;
import object_reader_macho;
import object_reader_pecoff;
import object_reader_types;
import source_paths;

/** Exact Dea metadata tri-state. */
enum ObjectMetadataClassificationKind {
    VALID_DEA_METADATA;
    NO_DEA_METADATA;
    MALFORMED_DEA_METADATA;
}

/** Public flattened payload of `ValidDeaMetadata`. */
struct ValidDeaMetadata {
    module_name: string;
    fingerprint: string;
    ordered_imports: StringVector*;
    import_fingerprints: StringVector*;
    has_entry: bool;
}

/** One metadata classification and its optional payload/reason. */
struct ObjectMetadataClassification {
    kind: ObjectMetadataClassificationKind;
    valid: ValidDeaMetadata*?;
    reason: string;
}

/** Successful format-neutral object inspection. */
struct ObjectInspection {
    format: ObjectFormat;
    defines_main: bool;
    metadata: ObjectMetadataClassification*;
    container: ObjectContainer*;
}

/** Public inspection result; read failures remain outside the tri-state. */
struct ObjectInspectionResult {
    inspection: ObjectInspection*?;
    error: ObjectReadError*?;
}

struct ObjectRecordBytesResult {
    bytes: string?;
    file_offset: int;
    length: int;
    error: string;
}

struct ObjectLbiSymbolName {
    module_name: string;
}

struct ObjectLbiCursor {
    pos: int;
}

func or_clone_strings(values: StringVector*) -> StringVector* {
    let result = sv_create(sv_size(values));
    for (let i = 0; i < sv_size(values); i = i + 1) {
        sv_push(result, sv_get(values, i));
    }
    return result;
}

func valid_dea_metadata_free(self: ValidDeaMetadata*) {
    sv_free(self.ordered_imports);
    sv_free(self.import_fingerprints);
    drop self;
}

func object_metadata_classification_free(self: ObjectMetadataClassification*) {
    if (self.valid != null) {
        valid_dea_metadata_free(self.valid as ValidDeaMetadata*);
    }
    drop self;
}

func object_inspection_free(self: ObjectInspection*) {
    object_metadata_classification_free(self.metadata);
    object_container_free(self.container);
    drop self;
}

func object_inspection_result_free(self: ObjectInspectionResult*) {
    if (self.inspection != null) {
        object_inspection_free(self.inspection as ObjectInspection*);
    }
    if (self.error != null) {
        object_read_error_free(self.error as ObjectReadError*);
    }
    drop self;
}

/** Stable printable name for a supported object format. */
func object_format_name(format: ObjectFormat) -> string {
    if (ord(format) == ord(OBJECT_FORMAT_ELF)) {
        return "ELF";
    }
    if (ord(format) == ord(OBJECT_FORMAT_MACHO)) {
        return "Mach-O";
    }
    return "PE/COFF";
}

/** Exact normalized external-definition query. */
func object_inspection_defines_symbol(self: ObjectInspection*, name: string) -> bool {
    return object_container_defines_symbol(self.container, name);
}

/** Exact process-level C `main` query. */
func object_inspection_defines_main(self: ObjectInspection*) -> bool {
    return self.defines_main;
}

/** Number of normalized external definitions, including duplicates. */
func object_inspection_defined_symbol_count(self: ObjectInspection*) -> int {
    return vec_size(self.container.defined_symbols);
}

/** Borrow one normalized external definition by index. */
func object_inspection_defined_symbol_at(self: ObjectInspection*,
                                         index: int) -> ObjectDefinedSymbol* {
    return ort_ptr_vec_get(
        self.container.defined_symbols, index) as ObjectDefinedSymbol*;
}

func or_classification_none() -> ObjectMetadataClassification* {
    return new ObjectMetadataClassification(NO_DEA_METADATA, null, "");
}

func or_classification_malformed(reason: string) -> ObjectMetadataClassification* {
    return new ObjectMetadataClassification(MALFORMED_DEA_METADATA, null, reason);
}

func or_extract_record(container: ObjectContainer*,
                       symbol: ObjectDefinedSymbol*) -> ObjectRecordBytesResult* {
    if (!symbol.data_resolved) {
        return new ObjectRecordBytesResult(
            null, 0, 0, "metadata symbol has no file-backed section data");
    }
    if (symbol.available_size < OM_HEADER_SIZE ||
        !ort_range_valid(len_s(container.bytes), symbol.file_offset,
                         symbol.available_size)) {
        return new ObjectRecordBytesResult(
            null, 0, 0, "metadata symbol is truncated within its section");
    }
    let payload_length = om_read_u32_le(container.bytes, symbol.file_offset + 12);
    if (payload_length == null) {
        return new ObjectRecordBytesResult(
            null, 0, 0, "metadata payload length is invalid");
    }
    let total_length = checked_add_int(OM_HEADER_SIZE, payload_length as int);
    if (total_length == null || (total_length as int) > symbol.available_size) {
        return new ObjectRecordBytesResult(
            null, 0, 0, "metadata payload extends past its containing section");
    }
    if (symbol.declared_size >= 0 &&
        symbol.declared_size != (total_length as int)) {
        return new ObjectRecordBytesResult(
            null, 0, 0, "metadata payload length disagrees with its symbol size");
    }
    return new ObjectRecordBytesResult(
        slice_s(container.bytes, symbol.file_offset,
                symbol.file_offset + (total_length as int)),
        symbol.file_offset, total_length as int, "");
}

func or_record_bytes_result_free(self: ObjectRecordBytesResult*) {
    drop self;
}

func or_symbol_count(container: ObjectContainer*, exact_name: string) -> int {
    let count = 0;
    for (let i = 0; i < vec_size(container.defined_symbols); i = i + 1) {
        let symbol = ort_ptr_vec_get(
            container.defined_symbols, i) as ObjectDefinedSymbol*;
        if (symbol.name == exact_name) {
            count = count + 1;
        }
    }
    return count;
}

func or_lbi_parse_decimal(symbol: string, cursor: ObjectLbiCursor*) -> int? {
    let start = cursor.pos;
    let value = 0;
    while (cursor.pos < len_s(symbol) &&
           char_at_s(symbol, cursor.pos) >= '0' &&
           char_at_s(symbol, cursor.pos) <= '9') {
        let digit = (char_at_s(symbol, cursor.pos) - '0') as int;
        if (value > (int_max() - digit) / 10) {
            return null;
        }
        value = value * 10 + digit;
        cursor.pos = cursor.pos + 1;
    }
    if (cursor.pos == start ||
        (cursor.pos - start > 1 && char_at_s(symbol, start) == '0')) {
        return null;
    }
    return value;
}

func or_lbi_parse_identifier(symbol: string, cursor: ObjectLbiCursor*) -> bool {
    let length = or_lbi_parse_decimal(symbol, cursor);
    if (length == null || (length as int) <= 0 ||
        (length as int) > len_s(symbol) - cursor.pos) {
        return false;
    }
    let value = slice_s(symbol, cursor.pos, cursor.pos + (length as int));
    if (!sp_is_valid_ident_component(value)) {
        return false;
    }
    cursor.pos = cursor.pos + (length as int);
    return true;
}

func or_lbi_parse_nominal_type(symbol: string, cursor: ObjectLbiCursor*) -> bool {
    let segment_count = 0;
    while (cursor.pos < len_s(symbol) &&
           char_at_s(symbol, cursor.pos) >= '0' &&
           char_at_s(symbol, cursor.pos) <= '9') {
        if (!or_lbi_parse_identifier(symbol, cursor)) {
            return false;
        }
        segment_count = segment_count + 1;
    }
    if (segment_count == 0 || cursor.pos >= len_s(symbol)) {
        return false;
    }
    let leaf_sigil = char_at_s(symbol, cursor.pos);
    if (leaf_sigil != 'S' && leaf_sigil != 'E') {
        return false;
    }
    cursor.pos = cursor.pos + 1;
    return or_lbi_parse_identifier(symbol, cursor);
}

func or_lbi_push_type_task(tasks: VectorBase*, allow_variadic: bool,
                           remaining_bytes: int) -> bool {
    if (vec_size(tasks) >= remaining_bytes) {
        return false;
    }
    vec_push_bool(tasks, allow_variadic);
    return true;
}

func or_lbi_parse_type(symbol: string, cursor: ObjectLbiCursor*,
                       allow_variadic: bool) -> bool {
    with (let tasks = vec_create(sizeof(bool), 8) => vec_free(tasks)) {
        if (!or_lbi_push_type_task(
                tasks, allow_variadic, len_s(symbol) - cursor.pos)) {
            return false;
        }
        while (vec_size(tasks) > 0) {
            if (cursor.pos >= len_s(symbol) ||
                vec_size(tasks) > len_s(symbol) - cursor.pos) {
                return false;
            }
            let task_i = vec_size(tasks) - 1;
            let task_allows_variadic = *(vec_get(tasks, task_i) as bool*);
            tasks.length = tasks.length - 1;

            let sigil = char_at_s(symbol, cursor.pos);
            cursor.pos = cursor.pos + 1;
            if (sigil == 'a' || sigil == 'h' || sigil == 's' || sigil == 't' ||
                sigil == 'i' || sigil == 'j' || sigil == 'l' || sigil == 'm' ||
                sigil == 'f' || sigil == 'd' || sigil == 'z' || sigil == 'c' ||
                sigil == 'v') {
                continue;
            }
            if (sigil == 'P' || sigil == 'Q' || sigil == 'W') {
                if (!or_lbi_push_type_task(
                        tasks, false, len_s(symbol) - cursor.pos)) {
                    return false;
                }
                continue;
            }
            if (sigil == 'X') {
                if (cursor.pos >= len_s(symbol) ||
                    char_at_s(symbol, cursor.pos) != 'F' ||
                    !or_lbi_push_type_task(
                        tasks, false, len_s(symbol) - cursor.pos)) {
                    return false;
                }
                continue;
            }
            if (sigil == 'V') {
                if (!task_allows_variadic ||
                    !or_lbi_push_type_task(
                        tasks, false, len_s(symbol) - cursor.pos)) {
                    return false;
                }
                continue;
            }
            if (sigil == 'A') {
                let dimension = or_lbi_parse_decimal(symbol, cursor);
                if (dimension == null || (dimension as int) <= 0 ||
                    cursor.pos >= len_s(symbol) ||
                    char_at_s(symbol, cursor.pos) != '_') {
                    return false;
                }
                cursor.pos = cursor.pos + 1;
                if (!or_lbi_push_type_task(
                        tasks, false, len_s(symbol) - cursor.pos)) {
                    return false;
                }
                continue;
            }
            if (sigil == 'B') {
                if (!or_lbi_parse_identifier(symbol, cursor)) {
                    return false;
                }
                continue;
            }
            if (sigil == 'M') {
                if (!or_lbi_parse_nominal_type(symbol, cursor)) {
                    return false;
                }
                continue;
            }
            if (sigil != 'F') {
                return false;
            }
            let arity = or_lbi_parse_decimal(symbol, cursor);
            if (arity == null ||
                !or_lbi_push_type_task(
                    tasks, false, len_s(symbol) - cursor.pos)) {
                return false;
            }
            for (let param_i = (arity as int) - 1;
                 param_i >= 0; param_i = param_i - 1) {
                if (!or_lbi_push_type_task(
                        tasks, param_i == (arity as int) - 1,
                        len_s(symbol) - cursor.pos)) {
                    return false;
                }
            }
        }
        return true;
    }
}

/**
 * Parse the module and terminal-name envelope of one current LBI symbol.
 *
 * Value type components are parsed with the current LBI grammar so arbitrary
 * strings using the reserved prefix cannot masquerade as same-module symbols.
 */
func or_parse_lbi_symbol_name(symbol: string) -> ObjectLbiSymbolName*? {
    if (!starts_with_s(symbol, "__deaM")) {
        return null;
    }
    let cursor = 6;
    let segment_count = 0;
    with (let module_buf = cb_create() => cb_free(module_buf)) {
        while (cursor < len_s(symbol) &&
               char_at_s(symbol, cursor) >= '0' &&
               char_at_s(symbol, cursor) <= '9') {
            let length_start = cursor;
            let segment_length = 0;
            while (cursor < len_s(symbol) &&
                   char_at_s(symbol, cursor) >= '0' &&
                   char_at_s(symbol, cursor) <= '9') {
                let digit = (char_at_s(symbol, cursor) - '0') as int;
                if (segment_length > (int_max() - digit) / 10) {
                    return null;
                }
                segment_length = segment_length * 10 + digit;
                cursor = cursor + 1;
            }
            if (cursor - length_start > 1 &&
                char_at_s(symbol, length_start) == '0') {
                return null;
            }
            if (segment_length <= 0 || segment_length > len_s(symbol) - cursor) {
                return null;
            }
            let segment = slice_s(symbol, cursor, cursor + segment_length);
            if (!sp_is_valid_ident_component(segment)) {
                return null;
            }
            if (segment_count > 0) {
                cb_append(module_buf, '.');
            }
            cb_append_s(module_buf, segment);
            segment_count = segment_count + 1;
            cursor = cursor + segment_length;
        }
        if (segment_count == 0 || cursor >= len_s(symbol)) {
            return null;
        }
        let sigil = char_at_s(symbol, cursor);
        if (sigil != 'N' && sigil != 'S' && sigil != 'E' && sigil != 'I') {
            return null;
        }
        cursor = cursor + 1;
        let terminal_length_start = cursor;
        let terminal_length = 0;
        while (cursor < len_s(symbol) &&
               char_at_s(symbol, cursor) >= '0' &&
               char_at_s(symbol, cursor) <= '9') {
            let digit2 = (char_at_s(symbol, cursor) - '0') as int;
            if (terminal_length > (int_max() - digit2) / 10) {
                return null;
            }
            terminal_length = terminal_length * 10 + digit2;
            cursor = cursor + 1;
        }
        if (cursor == terminal_length_start ||
            (cursor - terminal_length_start > 1 &&
             char_at_s(symbol, terminal_length_start) == '0') ||
            terminal_length <= 0 || terminal_length > len_s(symbol) - cursor) {
            return null;
        }
        let terminal = slice_s(symbol, cursor, cursor + terminal_length);
        if (!sp_is_valid_ident_component(terminal)) {
            return null;
        }
        cursor = cursor + terminal_length;
        if (sigil == 'I' && terminal != "init" && terminal != "fini" &&
            terminal != "entry" && terminal != "metadata" &&
            terminal != "imports") {
            return null;
        }
        if (sigil == 'N' && cursor < len_s(symbol)) {
            if (char_at_s(symbol, cursor) != 'F' &&
                !(char_at_s(symbol, cursor) == 'X' &&
                  cursor + 1 < len_s(symbol) &&
                  char_at_s(symbol, cursor + 1) == 'F')) {
                return null;
            }
            with (let type_cursor = new ObjectLbiCursor(cursor) => drop type_cursor) {
                if (!or_lbi_parse_type(symbol, type_cursor, false) ||
                    type_cursor.pos != len_s(symbol)) {
                    return null;
                }
                cursor = type_cursor.pos;
            }
        }
        if (cursor != len_s(symbol)) {
            return null;
        }
        let module_name = cb_to_string(module_buf);
        if (!sp_is_valid_module_name(module_name)) {
            return null;
        }
        return new ObjectLbiSymbolName(module_name);
    }
}

/**
 * Apply the exact metadata tri-state to one successfully parsed container.
 */
func object_classify_container(container: ObjectContainer*) -> ObjectMetadataClassification* {
    let saw_dea_marker = false;
    let identity_count = 0;
    let imports_count = 0;
    let identity_symbol: ObjectDefinedSymbol*? = null;
    let imports_symbol: ObjectDefinedSymbol*? = null;
    let identity_symbol_module = "";
    let imports_symbol_module = "";

    for (let i = 0; i < vec_size(container.defined_symbols); i = i + 1) {
        let symbol = ort_ptr_vec_get(
            container.defined_symbols, i) as ObjectDefinedSymbol*;
        if (starts_with_s(symbol.name, "__dea")) {
            saw_dea_marker = true;
        }
        let parsed = om_parse_metadata_symbol_name(symbol.name);
        if (parsed == null) {
            continue;
        }
        let parsed_name = parsed as ObjectMetadataSymbolName*;
        if (parsed_name.record_kind == OM_RECORD_IDENTITY) {
            identity_count = identity_count + 1;
            if (identity_symbol == null) {
                identity_symbol = symbol;
                identity_symbol_module = parsed_name.module_name;
            }
        } else if (parsed_name.record_kind == OM_RECORD_IMPORTS) {
            imports_count = imports_count + 1;
            if (imports_symbol == null) {
                imports_symbol = symbol;
                imports_symbol_module = parsed_name.module_name;
            }
        }
        drop parsed_name;
    }

    if (identity_count == 0 && imports_count == 0) {
        if (saw_dea_marker) {
            return or_classification_malformed(
                "object defines Dea ABI symbols but has no version 1 metadata");
        }
        return or_classification_none();
    }
    if (identity_count != 1 || imports_count != 1) {
        return or_classification_malformed(
            "object must define exactly one identity/imports metadata pair");
    }
    if (identity_symbol_module != imports_symbol_module) {
        return or_classification_malformed(
            "identity and imports symbols name different modules");
    }

    let identity_record = or_extract_record(
        container, identity_symbol as ObjectDefinedSymbol*);
    if (identity_record.bytes == null) {
        let reason = identity_record.error;
        or_record_bytes_result_free(identity_record);
        return or_classification_malformed("identity " + reason);
    }
    let imports_record = or_extract_record(
        container, imports_symbol as ObjectDefinedSymbol*);
    if (imports_record.bytes == null) {
        let reason2 = imports_record.error;
        or_record_bytes_result_free(identity_record);
        or_record_bytes_result_free(imports_record);
        return or_classification_malformed("imports " + reason2);
    }
    if (ort_ranges_overlap(identity_record.file_offset, identity_record.length,
                           imports_record.file_offset, imports_record.length)) {
        or_record_bytes_result_free(identity_record);
        or_record_bytes_result_free(imports_record);
        return or_classification_malformed("identity and imports metadata overlap");
    }

    let identity_result = om_decode_identity(identity_record.bytes as string);
    let imports_result = om_decode_imports(imports_record.bytes as string);
    or_record_bytes_result_free(identity_record);
    or_record_bytes_result_free(imports_record);
    if (identity_result.value == null) {
        let reason3 = identity_result.error;
        om_identity_result_free(identity_result);
        om_imports_result_free(imports_result);
        return or_classification_malformed(reason3);
    }
    if (imports_result.value == null) {
        let reason4 = imports_result.error;
        om_identity_result_free(identity_result);
        om_imports_result_free(imports_result);
        return or_classification_malformed(reason4);
    }
    let identity = identity_result.value as ObjectMetadataIdentity*;
    let imports = imports_result.value as ObjectMetadataImports*;
    if (identity.module_name != identity_symbol_module) {
        om_identity_result_free(identity_result);
        om_imports_result_free(imports_result);
        return or_classification_malformed(
            "identity payload module disagrees with its symbol name");
    }

    for (let marker_i = 0; marker_i < vec_size(container.defined_symbols);
         marker_i = marker_i + 1) {
        let marker_symbol = ort_ptr_vec_get(
            container.defined_symbols, marker_i) as ObjectDefinedSymbol*;
        if (!starts_with_s(marker_symbol.name, "__dea")) {
            continue;
        }
        let lbi_name = or_parse_lbi_symbol_name(marker_symbol.name);
        if (lbi_name == null) {
            om_identity_result_free(identity_result);
            om_imports_result_free(imports_result);
            return or_classification_malformed(
                "object contains an invalid reserved Dea ABI symbol");
        }
        let parsed_lbi = lbi_name as ObjectLbiSymbolName*;
        if (parsed_lbi.module_name != identity.module_name) {
            drop parsed_lbi;
            om_identity_result_free(identity_result);
            om_imports_result_free(imports_result);
            return or_classification_malformed(
                "object contains Dea ABI definitions for multiple modules");
        }
        drop parsed_lbi;
    }

    let init_count = or_symbol_count(container, om_init_symbol_name(identity.module_name));
    let fini_count = or_symbol_count(container, om_fini_symbol_name(identity.module_name));
    let entry_count = or_symbol_count(container, om_entry_symbol_name(identity.module_name));
    if (init_count != 1 || fini_count != 1) {
        om_identity_result_free(identity_result);
        om_imports_result_free(imports_result);
        return or_classification_malformed(
            "metadata module must define exactly one init and fini symbol");
    }
    if ((identity.has_entry && entry_count != 1) ||
        (!identity.has_entry && entry_count != 0)) {
        om_identity_result_free(identity_result);
        om_imports_result_free(imports_result);
        return or_classification_malformed(
            "identity entry flag disagrees with the entry symbol definition");
    }

    let valid = new ValidDeaMetadata(
        identity.module_name,
        identity.fingerprint,
        or_clone_strings(imports.module_names),
        or_clone_strings(imports.fingerprints),
        identity.has_entry
    );
    om_identity_result_free(identity_result);
    om_imports_result_free(imports_result);
    return new ObjectMetadataClassification(VALID_DEA_METADATA, valid, "");
}

func or_finish_container_result(
    adapter_result: ObjectContainerReadResult*) -> ObjectInspectionResult* {
    if (adapter_result.error != null) {
        let error = adapter_result.error as ObjectReadError*;
        adapter_result.error = null;
        drop adapter_result;
        return new ObjectInspectionResult(null, error);
    }
    let container = adapter_result.container as ObjectContainer*;
    adapter_result.container = null;
    drop adapter_result;
    let metadata = object_classify_container(container);
    let defines_main = object_container_defines_symbol(container, "main");
    return new ObjectInspectionResult(
        new ObjectInspection(container.format, defines_main, metadata, container),
        null
    );
}

/**
 * Inspect one in-memory relocatable object without executing host tools.
 */
func object_inspect_bytes(bytes: string) -> ObjectInspectionResult* {
    if (orelf_is_object_magic(bytes)) {
        return or_finish_container_result(orelf_read_bytes(bytes));
    }
    if (ormacho_is_object_magic(bytes) || ormacho_is_fat_magic(bytes)) {
        return or_finish_container_result(ormacho_read_bytes(bytes));
    }
    if (orpecoff_is_object_magic(bytes) ||
        orpecoff_is_pe_image_magic(bytes) ||
        orpecoff_is_extended_magic(bytes)) {
        return or_finish_container_result(orpecoff_read_bytes(bytes));
    }
    if (ort_bytes_equal(bytes, 0, "!<arch>\n")) {
        return new ObjectInspectionResult(null,
            new ObjectReadError(OBJECT_READ_UNSUPPORTED,
                                 "archive files are not relocatable object inputs"));
    }
    return new ObjectInspectionResult(null,
        new ObjectReadError(OBJECT_READ_UNSUPPORTED,
                             "unsupported object-container kind"));
}

/**
 * Read and inspect one relocatable object path.
 */
func object_inspect_path(path: string) -> ObjectInspectionResult* {
    let bytes = read_file(path);
    if (bytes == null) {
        return new ObjectInspectionResult(null,
            new ObjectReadError(OBJECT_READ_IO,
                                 "failed to read object file '" + path + "'"));
    }
    return object_inspect_bytes(bytes as string);
}

/** Compatibility spelling emphasizing the read operation. */
func object_read_bytes(bytes: string) -> ObjectInspectionResult* {
    return object_inspect_bytes(bytes);
}

/** Compatibility spelling emphasizing the read operation. */
func object_read_path(path: string) -> ObjectInspectionResult* {
    return object_inspect_path(path);
}
