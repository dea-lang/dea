module object_reader_pecoff;

import std.string;
import std.vector;

import object_reader_types;

let ORCOFF_MACHINE_I386: int = 332;
let ORCOFF_MACHINE_ARM: int = 448;
let ORCOFF_MACHINE_ARMNT: int = 452;
let ORCOFF_MACHINE_AMD64: int = 34404;
let ORCOFF_MACHINE_ARM64EC: int = 42561;
let ORCOFF_MACHINE_ARM64: int = 43620;
let ORCOFF_SYMBOL_SIZE: int = 18;
let ORCOFF_SECTION_SIZE: int = 40;
let ORCOFF_STORAGE_EXTERNAL: int = 2;

/** Recognize supported standard COFF machine identifiers. */
func orpecoff_machine_is_supported(machine: int) -> bool {
    return machine == ORCOFF_MACHINE_I386 ||
        machine == ORCOFF_MACHINE_ARM ||
        machine == ORCOFF_MACHINE_ARMNT ||
        machine == ORCOFF_MACHINE_AMD64 ||
        machine == ORCOFF_MACHINE_ARM64EC ||
        machine == ORCOFF_MACHINE_ARM64;
}

/** Probe a standard supported COFF header by its machine identifier. */
func orpecoff_is_object_magic(bytes: string) -> bool {
    let machine = ort_read_u16(bytes, 0, true);
    return machine != null && orpecoff_machine_is_supported(machine as int);
}

/** Probe a DOS/PE image wrapper, which is not a relocatable input. */
func orpecoff_is_pe_image_magic(bytes: string) -> bool {
    return len_s(bytes) >= 2 &&
        char_at_s(bytes, 0) == 'M' && char_at_s(bytes, 1) == 'Z';
}

/** Probe Microsoft bigobj/import-object signatures rejected by this reader. */
func orpecoff_is_extended_magic(bytes: string) -> bool {
    return len_s(bytes) >= 4 &&
        (char_at_s(bytes, 0) as int) == 0 &&
        (char_at_s(bytes, 1) as int) == 0 &&
        (char_at_s(bytes, 2) as int) == 255 &&
        (char_at_s(bytes, 3) as int) == 255;
}

func orpecoff_short_name(bytes: string, symbol_base: int) -> string {
    let end = symbol_base + 8;
    for (let cursor = symbol_base; cursor < symbol_base + 8; cursor = cursor + 1) {
        if ((char_at_s(bytes, cursor) as int) == 0) {
            end = cursor;
            break;
        }
    }
    return slice_s(bytes, symbol_base, end);
}

func orpecoff_symbol_name(bytes: string, symbol_base: int,
                          string_offset: int, string_size: int) -> string? {
    let is_long = true;
    for (let i = 0; i < 4; i = i + 1) {
        if ((char_at_s(bytes, symbol_base + i) as int) != 0) {
            is_long = false;
        }
    }
    if (!is_long) {
        return orpecoff_short_name(bytes, symbol_base);
    }
    let name_offset = ort_read_u32(bytes, symbol_base + 4, true);
    if (name_offset == null || (name_offset as int) < 4) {
        return null;
    }
    return ort_read_c_string(bytes, string_offset, string_size, name_offset as int);
}

/** Remove one machine-specific external-name decoration. */
func orpecoff_normalize_symbol_name(name: string, machine: int,
                                    is_function: bool) -> string {
    if (machine == ORCOFF_MACHINE_I386) {
        return ort_strip_one_underscore(name);
    }
    if (machine == ORCOFF_MACHINE_ARM64EC && is_function &&
        len_s(name) > 0 && char_at_s(name, 0) == '#') {
        return slice_s(name, 1, len_s(name));
    }
    return name;
}

/**
 * Read a standard little-endian PE/COFF relocatable object.
 */
func orpecoff_read_bytes(bytes: string) -> ObjectContainerReadResult* {
    if (orpecoff_is_pe_image_magic(bytes)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "PE images are not relocatable COFF objects");
    }
    if (orpecoff_is_extended_magic(bytes)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "COFF bigobj and import objects are unsupported");
    }
    if (len_s(bytes) < 2) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "not a COFF object");
    }
    let machine = ort_read_u16(bytes, 0, true);
    if (machine == null || !orpecoff_machine_is_supported(machine as int)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "unsupported or unrecognized COFF machine");
    }
    if (len_s(bytes) < 20) {
        return ort_read_error(OBJECT_READ_CORRUPT, "truncated COFF header");
    }
    let section_count = ort_read_u16(bytes, 2, true);
    let symbol_offset = ort_read_u32(bytes, 8, true);
    let symbol_count = ort_read_u32(bytes, 12, true);
    let optional_size = ort_read_u16(bytes, 16, true);
    let characteristics = ort_read_u16(bytes, 18, true);
    if (section_count == null || optional_size == null || characteristics == null) {
        return ort_read_error(OBJECT_READ_CORRUPT, "invalid COFF header");
    }
    if (symbol_offset == null || symbol_count == null) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "COFF symbol-table fields exceed supported integer bounds");
    }
    if (!ort_symbol_count_is_storable(symbol_count as int)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "COFF symbol count exceeds supported allocation bounds");
    }
    if ((optional_size as int) != 0 ||
        ((characteristics as int) / 2) % 2 == 1) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "COFF file is not a standard relocatable object");
    }
    let section_table_bytes = ort_checked_product(section_count as int, ORCOFF_SECTION_SIZE);
    if (section_table_bytes == null ||
        !ort_range_valid(len_s(bytes), 20, section_table_bytes as int)) {
        return ort_read_error(OBJECT_READ_CORRUPT, "COFF section table is out of bounds");
    }
    let section_table_end = 20 + (section_table_bytes as int);

    let sections = ort_ptr_vec_create(section_count as int);
    for (let section_i = 0; section_i < section_count as int; section_i = section_i + 1) {
        let base = 20 + section_i * ORCOFF_SECTION_SIZE;
        let raw_size = ort_read_u32(bytes, base + 16, true);
        let raw_offset = ort_read_u32(bytes, base + 20, true);
        if (raw_size == null || raw_offset == null) {
            ort_sections_free(sections);
            return ort_read_error(OBJECT_READ_UNSUPPORTED,
                "COFF section range exceeds supported integer bounds");
        }
        let low_flags = char_at_s(bytes, base + 36) as int;
        let is_uninitialized = (low_flags / 128) % 2 == 1;
        let file_backed = (raw_size as int) > 0 && !is_uninitialized;
        if (file_backed &&
            !ort_range_valid(len_s(bytes), raw_offset as int, raw_size as int)) {
            ort_sections_free(sections);
            return ort_read_error(OBJECT_READ_CORRUPT,
                "COFF section data is out of bounds");
        }
        if (file_backed &&
            ort_ranges_overlap(raw_offset as int, raw_size as int,
                               0, section_table_end)) {
            ort_sections_free(sections);
            return ort_read_error(OBJECT_READ_CORRUPT,
                "COFF section data overlaps the file headers");
        }
        for (let prior_i = 0; prior_i < vec_size(sections); prior_i = prior_i + 1) {
            let prior = ort_ptr_vec_get(sections, prior_i) as ObjectReaderSection*;
            if (file_backed && prior.file_backed &&
                ort_ranges_overlap(raw_offset as int, raw_size as int,
                                   prior.file_offset, prior.size)) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "COFF section data ranges overlap");
            }
        }
        ort_ptr_vec_push(sections,
            new ObjectReaderSection(raw_offset as int, raw_size as int,
                                    0, file_backed) as void*);
    }

    let container = ort_container_create(OBJECT_FORMAT_PECOFF, bytes);
    if ((symbol_count as int) == 0) {
        ort_sections_free(sections);
        if ((symbol_offset as int) != 0) {
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "COFF empty symbol table has a nonzero offset");
        }
        return ort_read_ok(container);
    }
    if ((symbol_offset as int) == 0) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "COFF symbol table has a zero offset");
    }
    let symbol_bytes = ort_checked_product(symbol_count as int, ORCOFF_SYMBOL_SIZE);
    if (symbol_bytes == null ||
        !ort_range_valid(len_s(bytes), symbol_offset as int, symbol_bytes as int)) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "COFF symbol table is out of bounds");
    }
    let string_offset = (symbol_offset as int) + (symbol_bytes as int);
    let string_size = ort_read_u32(bytes, string_offset, true);
    if (string_size == null || (string_size as int) < 4 ||
        !ort_range_valid(len_s(bytes), string_offset, string_size as int)) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "COFF string table is out of bounds");
    }
    if (ort_ranges_overlap(symbol_offset as int, symbol_bytes as int,
                           0, section_table_end) ||
        ort_ranges_overlap(string_offset, string_size as int,
                           0, section_table_end)) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "COFF symbol or string table overlaps the file headers");
    }
    for (let section_i2 = 0; section_i2 < vec_size(sections); section_i2 = section_i2 + 1) {
        let section = ort_ptr_vec_get(sections, section_i2) as ObjectReaderSection*;
        if (section.file_backed &&
            (ort_ranges_overlap(section.file_offset, section.size,
                                symbol_offset as int, symbol_bytes as int) ||
             ort_ranges_overlap(section.file_offset, section.size,
                                string_offset, string_size as int))) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "COFF section data overlaps the symbol or string table");
        }
    }

    let symbol_i = 0;
    while (symbol_i < symbol_count as int) {
        let base = (symbol_offset as int) + symbol_i * ORCOFF_SYMBOL_SIZE;
        let value_nonzero = ort_u32_is_nonzero(bytes, base + 8);
        let section_number = ort_read_i16(bytes, base + 12, true);
        let symbol_type = ort_read_u16(bytes, base + 14, true);
        let storage_class = ort_read_u8(bytes, base + 16);
        let auxiliary_count = ort_read_u8(bytes, base + 17);
        if (value_nonzero == null || section_number == null ||
            symbol_type == null || storage_class == null ||
            auxiliary_count == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "truncated COFF symbol entry");
        }
        if ((auxiliary_count as int) > (symbol_count as int) - symbol_i - 1) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "COFF auxiliary-symbol count exceeds the symbol table");
        }
        let name = orpecoff_symbol_name(
            bytes, base, string_offset, string_size as int);
        if (name == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "COFF symbol name is out of range or unterminated");
        }

        let is_defined = (section_number as int) > 0 ||
            (section_number as int) == -1 ||
            ((section_number as int) == 0 && (value_nonzero as bool));
        if ((storage_class as int) == ORCOFF_STORAGE_EXTERNAL && is_defined) {
            if (len_s(name as string) == 0) {
                ort_sections_free(sections);
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "defined external COFF symbol has an empty name");
            }
            let is_function = ((symbol_type as int) / 16) % 4 == 2;
            let normalized = orpecoff_normalize_symbol_name(
                name as string, machine as int, is_function);
            if ((section_number as int) <= 0) {
                ort_container_add_symbol(container, normalized, 0, 0, -1, false);
            } else {
                if ((section_number as int) > vec_size(sections)) {
                    ort_sections_free(sections);
                    return ort_container_error(container, OBJECT_READ_CORRUPT,
                        "COFF symbol section number is out of range");
                }
                let section = ort_ptr_vec_get(
                    sections, (section_number as int) - 1) as ObjectReaderSection*;
                let value = ort_read_u32(bytes, base + 8, true);
                if (value == null) {
                    ort_sections_free(sections);
                    return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                        "COFF symbol value exceeds supported integer bounds");
                }
                if ((value as int) > section.size) {
                    ort_sections_free(sections);
                    return ort_container_error(container, OBJECT_READ_CORRUPT,
                        "COFF symbol value lies outside its section");
                }
                let available = section.size - (value as int);
                if (!section.file_backed) {
                    ort_container_add_symbol(
                        container, normalized, 0, available, -1, false);
                } else {
                    if ((value as int) > len_s(bytes) - section.file_offset) {
                        ort_sections_free(sections);
                        return ort_container_error(container, OBJECT_READ_CORRUPT,
                            "COFF symbol file location is out of bounds");
                    }
                    ort_container_add_symbol(container, normalized,
                        section.file_offset + (value as int), available, -1, true);
                }
            }
        }
        symbol_i = symbol_i + 1 + (auxiliary_count as int);
    }

    ort_sections_free(sections);
    return ort_read_ok(container);
}
