/**
 * Defers one source-declaration shape check until all aliases materialize.
 */
struct SigPendingShapeCheck {
    module_name: string;
    ty: Type*;
    code: string;
    message: string;
    filename: string;
    span: Span;
}

/**
 * Build a fully qualified signature-table key.
 *
 * @param module_name Defining module name.
 * @param name Symbol name.
 * @return Key in `module::name` form.
 */
func sig_key(module_name: string, name: string) -> string {
    return module_name + "::" + name;
}

/**
 * Return the declared name carried by one top-level AST entry.
 *
 * @param top Top-level declaration to inspect.
 * @return Declaration name.
 */
func sig_top_decl_name(top: TopLevelDecl*) -> string {
    match (top.kind) {
        TD_STRUCT => { return (top.data as StructDecl*).name; }
        TD_ENUM => { return (top.data as EnumDecl*).name; }
        TD_FUNC => { return (top.data as FuncDecl*).name; }
        TD_TYPE_ALIAS => { return (top.data as TypeAliasDecl*).name; }
        TD_LET => { return (top.data as LetDecl*).name; }
    }
}

/**
 * Return the source span carried by one top-level AST entry.
 *
 * @param top Top-level declaration to inspect.
 * @return Declaration span.
 */
func sig_top_decl_span(top: TopLevelDecl*) -> Span {
    match (top.kind) {
        TD_STRUCT => { return (top.data as StructDecl*).span; }
        TD_ENUM => { return (top.data as EnumDecl*).span; }
        TD_FUNC => { return (top.data as FuncDecl*).span; }
        TD_TYPE_ALIAS => { return (top.data as TypeAliasDecl*).span; }
        TD_LET => { return (top.data as LetDecl*).span; }
    }
}

/**
 * Emit a signature-resolution error for a source span.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func sig_diag_error(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_error(diags, "SignatureResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Emit a name-resolution warning after resolved signatures are available.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func sig_name_diag_warn(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_warn(diags, "NameResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Emit a name-resolution error after resolved signatures are available.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func sig_name_diag_error(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_error(diags, "NameResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Free a vector of owned types.
 *
 * @param items Optional vector of `Type*` values to free.
 */
func sig_type_vec_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let vec = items as VectorBase*;
    for (let i = 0; i < vec_size(vec); i = i + 1) {
        type_free(ptr_vec_get(vec, i) as Type*);
    }
    vec_free(vec);
}

/**
 * Free an optional string set.
 *
 * @param self Optional string set to free.
 */
func sig_set_free_opt(self: StringSet*?) {
    if (self != null) {
        ss_free(self as StringSet*);
    }
}

/**
 * Free an optional vector of owned types.
 *
 * @param items Optional vector of `Type*` values to free.
 */
func sig_type_vec_free_opt(items: VectorBase*?) {
    if (items != null) {
        sig_type_vec_free(items as VectorBase*);
    }
}

/**
 * Free a temporary vector of struct-field metadata.
 *
 * @param items Optional vector of `StructFieldInfo*` values to free.
 */
func sig_struct_field_vec_temp_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let vec = items as VectorBase*;
    for (let i = 0; i < vec_size(vec); i = i + 1) {
        let field = ptr_vec_get(vec, i) as StructFieldInfo*;
        type_free(field.field_type);
        drop field;
    }
    vec_free(vec);
}

/**
 * Free a temporary vector of enum-variant metadata.
 *
 * @param items Optional vector of `EnumVariantInfo*` values to free.
 */
func sig_enum_variant_vec_temp_free(items: VectorBase*?) {
    if (items == null) {
        return;
    }
    let vec = items as VectorBase*;
    for (let i = 0; i < vec_size(vec); i = i + 1) {
        let variant = ptr_vec_get(vec, i) as EnumVariantInfo*;
        sig_type_vec_free(variant.field_types);
        sv_free(variant.field_names);
        drop variant;
    }
    vec_free(vec);
}

/**
 * Retain one resolved temporary type for post-finalization shape checking.
 *
 * @param checks Vector receiving an owned pending check.
 * @param module_name Module that owns unqualified names inside `ty`.
 * @param ty Resolved temporary type to clone.
 * @param code Diagnostic code to emit for an invalid shape.
 * @param message Diagnostic message to emit.
 * @param filename Source filename.
 * @param span Source span.
 */
func sig_pending_shape_add(checks: VectorBase*, module_name: string, ty: Type*, code: string,
                           message: string, filename: string, span: Span) {
    ptr_vec_push(checks,
        new SigPendingShapeCheck(module_name, type_clone(ty), code, message, filename, span) as void*);
}

/**
 * Free deferred shape checks and their owned type clones.
 *
 * @param checks Optional vector of `SigPendingShapeCheck*` values.
 */
func sig_pending_shapes_free(checks: VectorBase*?) {
    if (checks == null) {
        return;
    }
    let vec = checks as VectorBase*;
    for (let i = 0; i < vec_size(vec); i = i + 1) {
        let check = ptr_vec_get(vec, i) as SigPendingShapeCheck*;
        type_free(check.ty);
        drop check;
    }
    vec_free(vec);
}

/**
 * Look up a resolved function type.
 *
 * @param self Signature tables to inspect.
 * @param module_name Defining module name.
 * @param name Function name.
 * @return Function type, or `null` if absent.
 */
func sig_lookup_func_type(self: SignatureTables*, module_name: string, name: string) -> Type*? {
    let value = spm_get(self.func_types, sig_key(module_name, name));
    if (value == null) {
        return null;
    }
    return value as Type*;
}

/**
 * Look up resolved struct metadata.
 *
 * @param self Signature tables to inspect.
 * @param module_name Defining module name.
 * @param name Struct name.
 * @return Struct info, or `null` if absent.
 */
func sig_lookup_struct_info(self: SignatureTables*, module_name: string, name: string) -> StructInfo*? {
    let value = spm_get(self.struct_infos, sig_key(module_name, name));
    if (value == null) {
        return null;
    }
    return value as StructInfo*;
}

/**
 * Look up resolved enum metadata.
 *
 * @param self Signature tables to inspect.
 * @param module_name Defining module name.
 * @param name Enum name.
 * @return Enum info, or `null` if absent.
 */
func sig_lookup_enum_info(self: SignatureTables*, module_name: string, name: string) -> EnumInfo*? {
    let value = spm_get(self.enum_infos, sig_key(module_name, name));
    if (value == null) {
        return null;
    }
    return value as EnumInfo*;
}

/**
 * Look up a resolved top-level binding type.
 *
 * @param self Signature tables to inspect.
 * @param module_name Defining module name.
 * @param name Binding name.
 * @return Resolved type, or `null` if absent.
 */
func sig_lookup_let_type(self: SignatureTables*, module_name: string, name: string) -> Type*? {
    let value = spm_get(self.let_types, sig_key(module_name, name));
    if (value == null) {
        return null;
    }
    return value as Type*;
}

/**
 * Create empty signature tables.
 *
 * @return New signature tables.
 */
func sig_make_tables() -> SignatureTables* {
    return new SignatureTables(spm_create(), spm_create(), spm_create(), spm_create(), ss_create());
}

/**
 * Report whether a resolved type is, or transitively contains, a slice.
 *
 * Recursion descends into array element types so that array-of-slice forms are
 * also detected. It does not descend into function parameter or result types,
 * because slices are permitted as function parameters.
 *
 * @param ty Resolved type to inspect.
 * @return `true` when `ty` is a slice or an array whose element contains a slice.
 */
func sig_type_contains_slice(ty: Type*) -> bool {
    if (ord(ty.kind) == ord(TY_SLICE)) {
        return true;
    }
    if (ord(ty.kind) == ord(TY_ARRAY)) {
        return sig_type_contains_slice(ty.inner as Type*);
    }
    return false;
}

/**
 * Emit a slice-escape diagnostic when a type appears in a disallowed long-lived position.
 *
 * @param ty Resolved type to inspect.
 * @param code Diagnostic code to emit.
 * @param message Diagnostic message to emit.
 * @param diags Diagnostic collector.
 * @param filename Source filename to report.
 * @param span Source span to report.
 */
func sig_reject_slice_escape(ty: Type*, code: string, message: string, diags: DiagCollector*, filename: string,
                             span: Span) {
    if (sig_type_contains_slice(ty)) {
        sig_diag_error(diags, code, message, filename, span);
    }
}

/**
 * Finalize and check exact type positions retained from source declarations.
 *
 * Keeping these clones alive until every source signature is resolved
 * preserves independent slice diagnostics without running shape checks before
 * cross-provider aliases can be materialized.
 *
 * @param checks Deferred shape checks to process.
 * @param tables Finalized signature tables.
 * @param nr Name-resolution data containing source and interface aliases.
 * @param driver_state Driver state containing provider interfaces and units.
 * @param diags Diagnostic collector.
 */
func sig_check_pending_materialized_shapes(checks: VectorBase*, tables: SignatureTables*, nr: NameResolution*,
                                           driver_state: DriverState*, diags: DiagCollector*) {
    with (let seen = ss_create() => ss_free(seen)) {
        for (let i = 0; i < vec_size(checks); i = i + 1) {
            let check = ptr_vec_get(checks, i) as SigPendingShapeCheck*;
            tr_finalize_materialized_type(tables, nr, driver_state, check.module_name, check.ty, diags, seen);
            sig_reject_slice_escape(check.ty, check.code, check.message, diags, check.filename, check.span);
        }
    }
}

/**
 * Check interface slice placement after every semantic type has materialized.
 *
 * Source declarations are checked through their retained per-declaration type
 * clones. This pass only covers active interface surfaces, whose semantic
 * clones have no parsed declaration counterpart.
 *
 * @param nr Name-resolution data containing synthetic interface modules.
 * @param driver_state Driver state containing finalized semantic interfaces.
 * @param diags Diagnostic collector.
 */
func sig_check_materialized_interface_shapes(nr: NameResolution*, driver_state: DriverState*,
                                             diags: DiagCollector*) {
    for (let iface_i = 0; iface_i < driver_interface_count(driver_state); iface_i = iface_i + 1) {
        let mi = driver_interface_get(driver_state, iface_i);
        let env_opt = nr_env_find(nr, mi.module_name);
        if (env_opt == null) {
            continue;
        }
        let env = env_opt as ModuleEnv*;
        for (let struct_i = 0; struct_i < vec_size(mi.struct_infos); struct_i = struct_i + 1) {
            let info3 = ptr_vec_get(mi.struct_infos, struct_i) as StructInfo*;
            for (let field_i3 = 0; field_i3 < vec_size(info3.fields); field_i3 = field_i3 + 1) {
                sig_reject_slice_escape((ptr_vec_get(info3.fields, field_i3) as StructFieldInfo*).field_type,
                    "TYP-0811", "slice type may not be used as a struct field", diags,
                    env.module_ptr.filename, info3.span);
            }
        }
        for (let enum_i = 0; enum_i < vec_size(mi.enum_infos); enum_i = enum_i + 1) {
            let info4 = ptr_vec_get(mi.enum_infos, enum_i) as EnumInfo*;
            for (let variant_i2 = 0; variant_i2 < vec_size(info4.variants); variant_i2 = variant_i2 + 1) {
                let variant2 = ptr_vec_get(info4.variants, variant_i2) as EnumVariantInfo*;
                for (let field_i4 = 0; field_i4 < vec_size(variant2.field_types); field_i4 = field_i4 + 1) {
                    sig_reject_slice_escape(ptr_vec_get(variant2.field_types, field_i4) as Type*, "TYP-0813",
                        "slice type may not be used as an enum payload field", diags, env.module_ptr.filename,
                        info4.span);
                }
            }
        }
        for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
            let entry = ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*;
            sig_reject_slice_escape(entry.ty.result as Type*, "TYP-0810",
                "slice type may not be a function return type", diags, env.module_ptr.filename,
                env.module_ptr.span);
        }
        for (let let_i = 0; let_i < vec_size(mi.let_entries); let_i = let_i + 1) {
            let entry2 = ptr_vec_get(mi.let_entries, let_i) as InterfaceLetEntry*;
            sig_reject_slice_escape(entry2.ty, "TYP-0812", "slice type may not be used in a top-level let", diags,
                env.module_ptr.filename, env.module_ptr.span);
        }
    }
}

/**
 * Resolve one struct declaration into stored signature metadata.
 *
 * @param tables Signature tables receiving resolved struct info.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the declaration.
 * @param decl Struct declaration to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param pending_shapes Deferred per-declaration shape checks.
 */
func sig_resolve_struct(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                        decl: StructDecl*, diags: DiagCollector*, pending_shapes: VectorBase*) {
    with (let fields: VectorBase*? = ptr_vec_create(vec_size(decl.fields)) => sig_struct_field_vec_temp_free(fields),
          let seen: StringSet*? = ss_create() => sig_set_free_opt(seen)) {
        let ok = true;
        for (let i = 0; i < vec_size(decl.fields); i = i + 1) {
            let field_decl = ptr_vec_get(decl.fields, i) as FieldDecl*;
            let field_type = tr_resolve_type_ref(tables, nr, driver_state, env, field_decl.type_ref, diags,
                seen as StringSet*);
            if (field_type == null) {
                ok = false;
                continue;
            }
            sig_pending_shape_add(pending_shapes, env.module_name, field_type as Type*, "TYP-0811",
                "slice type may not be used as a struct field", env.module_ptr.filename, field_decl.type_ref.span);
            ptr_vec_push(fields as VectorBase*, new StructFieldInfo(field_decl.name, field_type as Type*) as void*);
        }

        if (!ok) {
            return;
        }

        let info = new StructInfo(
            sig_key(env.module_name, decl.name),
            env.module_name,
            decl.name,
            env.module_ptr.filename,
            decl.span,
            type_new_struct(env.module_name, decl.name),
            fields as VectorBase*,
            ss_has(env.opaque_exports, decl.name)
        );
        spm_put(tables.struct_infos, info.key, info as void*);
        let sym_opt = nr_module_env_local(env, decl.name);
        if (sym_opt == null) {
            fields = null;
            return;
        }
        let sym = sym_opt as Symbol*;
        symbol_set_type_clone(sym, info.struct_type);
        fields = null;
    }
}

/**
 * Resolve one enum declaration into stored signature metadata.
 *
 * @param tables Signature tables receiving resolved enum info.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the declaration.
 * @param decl Enum declaration to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param pending_shapes Deferred per-declaration shape checks.
 */
func sig_resolve_enum(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                      decl: EnumDecl*, diags: DiagCollector*, pending_shapes: VectorBase*) {
    with (let variants: VectorBase*? = ptr_vec_create(vec_size(decl.variants)) => sig_enum_variant_vec_temp_free(variants),
          let seen: StringSet*? = ss_create() => sig_set_free_opt(seen)) {
        let ok = true;
        for (let i = 0; i < vec_size(decl.variants); i = i + 1) {
            let variant_decl = ptr_vec_get(decl.variants, i) as EnumVariant*;
            let field_types = ptr_vec_create(vec_size(variant_decl.fields));
            let field_names = sv_create(vec_size(variant_decl.fields));
            for (let j = 0; j < vec_size(variant_decl.fields); j = j + 1) {
                let field_decl = ptr_vec_get(variant_decl.fields, j) as FieldDecl*;
                let field_type = tr_resolve_type_ref(tables, nr, driver_state, env, field_decl.type_ref, diags,
                    seen as StringSet*);
                if (field_type == null) {
                    ok = false;
                    continue;
                }
                sig_pending_shape_add(pending_shapes, env.module_name, field_type as Type*, "TYP-0813",
                    "slice type may not be used as an enum payload field", env.module_ptr.filename,
                    field_decl.type_ref.span);
                ptr_vec_push(field_types, field_type as void*);
                sv_push(field_names, field_decl.name);
            }
            ptr_vec_push(variants as VectorBase*, new EnumVariantInfo(variant_decl.name, field_types, field_names) as void*);
        }

        if (!ok) {
            return;
        }

        let info = new EnumInfo(
            sig_key(env.module_name, decl.name),
            env.module_name,
            decl.name,
            env.module_ptr.filename,
            decl.span,
            type_new_enum(env.module_name, decl.name),
            variants as VectorBase*,
            ss_has(env.opaque_exports, decl.name)
        );
        spm_put(tables.enum_infos, info.key, info as void*);
        let sym_opt = nr_module_env_local(env, decl.name);
        if (sym_opt == null) {
            variants = null;
            return;
        }
        let sym = sym_opt as Symbol*;
        symbol_set_type_clone(sym, info.enum_type);
        variants = null;
    }
}

/**
 * Resolve one function declaration into a stored function type.
 *
 * @param tables Signature tables receiving resolved function types.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the declaration.
 * @param decl Function declaration to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param pending_shapes Deferred per-declaration shape checks.
 */
func sig_resolve_func(tables: SignatureTables*, nr: NameResolution*, driver_state: DriverState*, env: ModuleEnv*,
                      decl: FuncDecl*, diags: DiagCollector*, pending_shapes: VectorBase*) {
    with (let params: VectorBase*? = ptr_vec_create(vec_size(decl.params)) => sig_type_vec_free_opt(params),
          let seen: StringSet*? = ss_create() => sig_set_free_opt(seen)) {
        let ok = true;
        for (let i = 0; i < vec_size(decl.params); i = i + 1) {
            let param = ptr_vec_get(decl.params, i) as Param*;
            let param_type = tr_resolve_type_ref(tables, nr, driver_state, env, param.type_ref, diags,
                seen as StringSet*);
            if (param_type == null) {
                ok = false;
                continue;
            }
            ptr_vec_push(params as VectorBase*, param_type as void*);
        }

        let ret_type = tr_resolve_type_ref(tables, nr, driver_state, env, decl.return_type, diags,
            seen as StringSet*);
        if (ret_type == null) {
            ok = false;
        } else {
            sig_pending_shape_add(pending_shapes, env.module_name, ret_type as Type*, "TYP-0810",
                "slice type may not be a function return type", env.module_ptr.filename,
                (decl.return_type as TypeRef*).span);
        }

        if (!ok) {
            if (ret_type != null) {
                type_free(ret_type as Type*);
            }
            return;
        }

        let is_variadic = vec_size(decl.params) > 0 &&
            type_ref_is_variadic((ptr_vec_get(decl.params, vec_size(decl.params) - 1) as Param*).type_ref);
        if (decl.is_extern && is_variadic) {
            sig_diag_error(diags, "SIG-0220", "extern functions cannot be variadic",
                env.module_ptr.filename, decl.span);
            type_param_vec_free(params);
            params = null;
            type_free(ret_type as Type*);
            return;
        }
        let func_type = type_new_func(params as VectorBase*, ret_type as Type*, decl.is_unsafe);
        if (is_variadic) {
            func_type.is_variadic = true;
        }
        let key = sig_key(env.module_name, decl.name);
        spm_put(tables.func_types, key, func_type as void*);
        let sym_opt = nr_module_env_local(env, decl.name);
        if (sym_opt == null) {
            params = null;
            return;
        }
        let sym = sym_opt as Symbol*;
        symbol_set_type_clone(sym, func_type);
        params = null;
    }
}

/**
 * Infer a top-level literal initializer type without full expression checking.
 *
 * @param tables Signature tables available during signature resolution.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the initializer.
 * @param driver_state Driver state providing parsed ASTs.
 * @param expr_id Expression id to inspect.
 * @return Inferred literal type, or `null` when inference is not supported.
 */
func sig_infer_literal_type(tables: SignatureTables*, nr: NameResolution*, env: ModuleEnv*, driver_state: DriverState*,
                            expr_id: ExprId) -> Type*? {
    let unit = driver_find_unit(driver_state, env.module_name);
    if (unit == null) {
        return null;
    }
    let expr = expr_arena_get((unit as DriverUnit*).parse_result.expr_arena, expr_id);

    if (ord(expr.kind) == ord(EX_INT)) {
        return type_builtin_int();
    }
    if (ord(expr.kind) == ord(EX_BIGINT)) {
        return null;
    }
    if (ord(expr.kind) == ord(EX_FLOAT)) {
        return type_builtin_float();
    }
    if (ord(expr.kind) == ord(EX_DOUBLE)) {
        return type_builtin_double();
    }
    if (ord(expr.kind) == ord(EX_BYTE)) {
        return type_builtin_byte();
    }
    if (ord(expr.kind) == ord(EX_BOOL)) {
        return type_builtin_bool();
    }
    if (ord(expr.kind) == ord(EX_STRING)) {
        return type_builtin_string();
    }
    if (ord(expr.kind) == ord(EX_NULL)) {
        return null;
    }
    if (ord(expr.kind) == ord(EX_VAR_REF)) {
        let sym = tr_symbol_lookup(nr, env, expr.text_value, expr.module_path, expr.name_qualifier);
        if (sym != null && sig_symbol_is_zero_field_enum_variant(tables, sym as Symbol*)) {
            let target = sym as Symbol*;
            return type_new_enum(target.module_name, target.owner_name);
        }
        return null;
    }
    if (ord(expr.kind) != ord(EX_CALL)) {
        return null;
    }

    let callee = expr_arena_get((unit as DriverUnit*).parse_result.expr_arena, expr.expr_a);
    if (ord(callee.kind) != ord(EX_VAR_REF)) {
        return null;
    }

    let sym = tr_symbol_lookup(nr, env, callee.text_value, callee.module_path, callee.name_qualifier);
    if (sym == null) {
        return null;
    }

    let target = sym as Symbol*;
    if (ord(target.kind) == ord(SYM_STRUCT)) {
        return type_new_struct(target.module_name, target.name);
    }
    if (ord(target.kind) == ord(SYM_ENUM_VARIANT)) {
        return type_new_enum(target.module_name, target.owner_name);
    }
    if (ord(target.kind) == ord(SYM_TYPE_ALIAS) && target.resolved_type != null) {
        let alias_type = target.resolved_type as Type*;
        if (ord(alias_type.kind) == ord(TY_STRUCT)) {
            return type_clone(alias_type);
        }
    }
    return null;
}

/**
 * Report whether one symbol names a zero-field enum variant.
 *
 * @param sym Symbol to inspect.
 * @return `true` when `sym` is a zero-field enum variant.
 */
func sig_symbol_is_zero_field_enum_variant(tables: SignatureTables*, sym: Symbol*) -> bool {
    if (ord(sym.kind) != ord(SYM_ENUM_VARIANT)) {
        return false;
    }
    if (sym.decl_ptr != null) {
        let variant = sym.decl_ptr as EnumVariant*;
        return vec_size(variant.fields) == 0;
    }

    let info_opt = sig_lookup_enum_info(tables, sym.module_name, sym.owner_name);
    if (info_opt == null) {
        return false;
    }
    let info = info_opt as EnumInfo*;
    for (let i = 0; i < vec_size(info.variants); i = i + 1) {
        let variant_info = ptr_vec_get(info.variants, i) as EnumVariantInfo*;
        if (variant_info.name == sym.name) {
            return vec_size(variant_info.field_types) == 0;
        }
    }
    return false;
}

/**
 * Check whether every constructor argument in a top-level binding initializer is constant.
 *
 * @param tables Signature tables available during signature resolution.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the initializer.
 * @param arena Expression arena that owns the arguments.
 * @param args Optional vector of argument ids.
 * @return `true` if every argument is constant.
 */
func sig_const_args_are_constant(tables: SignatureTables*, nr: NameResolution*, env: ModuleEnv*, arena: ExprArena*,
                                 args: VectorBase*?) -> bool {
    if (args == null) {
        return true;
    }
    let ids = args as VectorBase*;
    for (let i = 0; i < vec_size(ids); i = i + 1) {
        if (!sig_expr_is_const_initializer(tables, nr, env, arena, id_vec_get(ids, i))) {
            return false;
        }
    }
    return true;
}

/**
 * Check whether one top-level binding initializer stays inside the static-initializer subset.
 *
 * @param tables Signature tables available during signature resolution.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the initializer.
 * @param arena Expression arena that owns the expression.
 * @param expr_id Expression id to inspect.
 * @return `true` if the initializer is compile-time constant.
 */
func sig_expr_is_const_initializer(tables: SignatureTables*, nr: NameResolution*, env: ModuleEnv*, arena: ExprArena*,
                                   expr_id: ExprId) -> bool {
    if (expr_id < 0) {
        return false;
    }
    let expr = expr_arena_get(arena, expr_id);
    match (expr.kind) {
        EX_INT => { return true; }
        EX_BIGINT => { return true; }
        EX_FLOAT => { return true; }
        EX_DOUBLE => { return true; }
        EX_BYTE => { return true; }
        EX_STRING => { return true; }
        EX_BOOL => { return true; }
        EX_NULL => { return true; }
        EX_ARRAY_LITERAL => {
            let ids = expr.ids as VectorBase*;
            for (let i = 0; i < vec_size(ids); i = i + 1) {
                if (!sig_expr_is_const_initializer(tables, nr, env, arena, id_vec_get(ids, i))) {
                    return false;
                }
            }
            return true;
        }
        EX_VAR_REF => {
            let sym = tr_symbol_lookup(nr, env, expr.text_value, expr.module_path, expr.name_qualifier);
            if (sym == null) {
                return false;
            }
            return sig_symbol_is_zero_field_enum_variant(tables, sym as Symbol*);
        }
        EX_CALL => {
            let callee = expr_arena_get(arena, expr.expr_a);
            if (ord(callee.kind) != ord(EX_VAR_REF)) {
                return false;
            }

            let sym = tr_symbol_lookup(nr, env, callee.text_value, callee.module_path, callee.name_qualifier);
            if (sym == null) {
                return false;
            }

            let target = sym as Symbol*;
            if (ord(target.kind) == ord(SYM_STRUCT) || ord(target.kind) == ord(SYM_ENUM_VARIANT)) {
                return sig_const_args_are_constant(tables, nr, env, arena, expr.ids);
            }
            if (ord(target.kind) == ord(SYM_TYPE_ALIAS) && target.resolved_type != null &&
                ord((target.resolved_type as Type*).kind) == ord(TY_STRUCT)) {
                return sig_const_args_are_constant(tables, nr, env, arena, expr.ids);
            }
            return false;
        }
        _ => { return false; }
    }
}

/**
 * Resolve or infer the type of one top-level `let` binding.
 *
 * @param tables Signature tables receiving resolved `let` types.
 * @param nr Name-resolution data for symbol lookups.
 * @param env Module environment owning the declaration.
 * @param driver_state Driver state providing parsed ASTs.
 * @param decl `let` declaration to resolve.
 * @param diags Diagnostic collector for resolution failures.
 * @param pending_shapes Deferred per-declaration shape checks.
 */
func sig_resolve_let(tables: SignatureTables*, nr: NameResolution*, env: ModuleEnv*, driver_state: DriverState*,
                     decl: LetDecl*, diags: DiagCollector*, pending_shapes: VectorBase*) {
    let let_type: Type*? = null;
    if (decl.type_ref != null) {
        with (let seen = ss_create() => ss_free(seen)) {
            let_type = tr_resolve_type_ref(tables, nr, driver_state, env, decl.type_ref as TypeRef*, diags, seen);
        }
    } else {
        let_type = sig_infer_literal_type(tables, nr, env, driver_state, decl.value);
        if (let_type == null) {
            let unit = driver_find_unit(driver_state, env.module_name);
            if (unit != null) {
                let expr = expr_arena_get((unit as DriverUnit*).parse_result.expr_arena, decl.value);
                if (ord(expr.kind) == ord(EX_BIGINT)) {
                    sig_diag_error(
                        diags,
                        "TYP-0702",
                        "integer literal " + bigint_to_string(expr.text_value, expr.base_value) + " requires a contextual integer type",
                        env.module_ptr.filename,
                        expr.span
                    );
                    return;
                }
            }
            sig_diag_error(
                diags,
                "SIG-0030",
                "cannot infer type for let '" + decl.name + "' - type annotation required for non-literal initializers",
                env.module_ptr.filename,
                decl.span
            );
            return;
        }
    }

    if (let_type == null) {
        return;
    }
    sig_pending_shape_add(pending_shapes, env.module_name, let_type as Type*, "TYP-0812",
        "slice type may not be used in a top-level let", env.module_ptr.filename, decl.span);

    if (decl.is_const) {
        let unit = driver_find_unit(driver_state, env.module_name);
        let is_const_initializer = false;
        let const_eval_failed = false;
        if (unit != null) {
            is_const_initializer = sig_expr_is_const_initializer(tables, nr, env,
                (unit as DriverUnit*).parse_result.expr_arena, decl.value);
            if (!is_const_initializer) {
                with (let ctx = tr_const_eval_context_create(driver_state, tables, nr, diags) =>
                      tr_const_eval_context_free(ctx)) {
                    let const_value = tr_const_eval_expr(ctx, env, decl.value);
                    if (const_value != null) {
                        tr_const_value_free(const_value as ConstValue*);
                        is_const_initializer = true;
                    } else if (tr_const_eval_failed(ctx)) {
                        tr_const_eval_report_failure(ctx);
                        const_eval_failed = true;
                    }
                }
            }
        }
        if (!is_const_initializer) {
            type_free(let_type as Type*);
            if (!const_eval_failed) {
                sig_diag_error(
                    diags,
                    "SIG-0200",
                    "initializer for const '" + decl.name + "' must be compile-time constant",
                    env.module_ptr.filename,
                    decl.span
                );
            }
            return;
        }
    }

    let key = sig_key(env.module_name, decl.name);
    spm_put(tables.let_types, key, let_type as void*);
    let sym_opt = nr_module_env_local(env, decl.name);
    if (sym_opt != null) {
        let sym = sym_opt as Symbol*;
        symbol_set_type_clone(sym, let_type as Type*);
    }
}

/**
 * Collect value-type dependencies referenced by a type.
 *
 * @param ty Type to inspect.
 * @param out Set that receives fully qualified dependency keys.
 */
func sig_extract_dependencies(ty: Type*, out: StringSet*) {
    if (ord(ty.kind) == ord(TY_POINTER)) {
        return;
    }
    if (ord(ty.kind) == ord(TY_SLICE)) {
        return;
    }
    if (ord(ty.kind) == ord(TY_NULLABLE)) {
        let inner = ty.inner as Type*;
        if (ord(inner.kind) == ord(TY_POINTER)) {
            return;
        }
        sig_extract_dependencies(inner, out);
        return;
    }
    if (ord(ty.kind) == ord(TY_STRUCT) || ord(ty.kind) == ord(TY_ENUM)) {
        ss_add(out, sig_key(ty.module_name, ty.name));
    }
}

/**
 * Visit one value-type node in the cycle-detection graph.
 *
 * @param tables Signature tables containing resolved struct and enum metadata.
 * @param key Fully qualified type key to visit.
 * @param visiting DFS stack set for cycle detection.
 * @param visited Set of nodes already proven acyclic.
 * @param diags Diagnostic collector for emitted cycle errors.
 * @return `true` if this visit reaches a value-type cycle.
 */
func sig_cycle_visit(tables: SignatureTables*, key: string, visiting: StringSet*, visited: StringSet*,
                     diags: DiagCollector*) -> bool {
    if (ss_has(visited, key)) {
        return false;
    }
    if (ss_has(visiting, key)) {
        return true;
    }

    ss_add(visiting, key);

    let struct_info = spm_get(tables.struct_infos, key);
    if (struct_info != null) {
        let info = struct_info as StructInfo*;
        with (let deps = ss_create() => ss_free(deps)) {
            for (let i = 0; i < vec_size(info.fields); i = i + 1) {
                let field = ptr_vec_get(info.fields, i) as StructFieldInfo*;
                sig_extract_dependencies(field.field_type, deps);
            }
            for (let dep_i = 0; dep_i < ss_capacity(deps); dep_i = dep_i + 1) {
                if (!ss_slot_occupied(deps, dep_i)) {
                    continue;
                }
                if (sig_cycle_visit(tables, ss_slot_key(deps, dep_i), visiting, visited, diags)) {
                    sig_diag_error(
                        diags,
                        "SIG-0040",
                        "Value-type cycle detected involving " + key + ". Consider using pointers to break the cycle.",
                        info.filename,
                        info.span
                    );
                    return true;
                }
            }
        }
    }

    let enum_info = spm_get(tables.enum_infos, key);
    if (enum_info != null) {
        let info2 = enum_info as EnumInfo*;
        with (let deps2 = ss_create() => ss_free(deps2)) {
            for (let i = 0; i < vec_size(info2.variants); i = i + 1) {
                let variant = ptr_vec_get(info2.variants, i) as EnumVariantInfo*;
                for (let j = 0; j < vec_size(variant.field_types); j = j + 1) {
                    sig_extract_dependencies(ptr_vec_get(variant.field_types, j) as Type*, deps2);
                }
            }
            for (let dep2_i = 0; dep2_i < ss_capacity(deps2); dep2_i = dep2_i + 1) {
                if (!ss_slot_occupied(deps2, dep2_i)) {
                    continue;
                }
                if (sig_cycle_visit(tables, ss_slot_key(deps2, dep2_i), visiting, visited, diags)) {
                    sig_diag_error(
                        diags,
                        "SIG-0040",
                        "Value-type cycle detected involving " + key + ". Consider using pointers to break the cycle.",
                        info2.filename,
                        info2.span
                    );
                    return true;
                }
            }
        }
    }

    ss_remove(visiting, key);
    ss_add(visited, key);
    return false;
}

/**
 * Detect value-type cycles across resolved structs and enums.
 *
 * @param tables Signature tables to inspect.
 * @param diags Diagnostic collector.
 */
func sig_detect_value_type_cycles(tables: SignatureTables*, diags: DiagCollector*) {
    with (let visiting = ss_create() => ss_free(visiting),
          let visited = ss_create() => ss_free(visited),
          let keys = spm_keys(tables.struct_infos) => sv_free(keys),
          let enum_keys = spm_keys(tables.enum_infos) => sv_free(enum_keys)) {
        for (let i = 0; i < sv_size(keys); i = i + 1) {
            if (sig_cycle_visit(tables, sv_get(keys, i), visiting, visited, diags)) {
                return;
            }
        }
        for (let enum_key_i = 0; enum_key_i < sv_size(enum_keys); enum_key_i = enum_key_i + 1) {
            if (sig_cycle_visit(tables, sv_get(enum_keys, enum_key_i), visiting, visited, diags)) {
                return;
            }
        }
    }
}

/**
 * Format a nominal type name for export-surface diagnostics.
 *
 * @param ty Struct or enum type.
 * @return `module::Name` display string.
 */
func sig_nominal_display(ty: Type*) -> string {
    return ty.module_name + "::" + ty.name;
}

/**
 * Check one nominal type reference against provider export visibility.
 *
 * @param nr Name-resolution data containing provider export sets.
 * @param ty Nominal type to check.
 * @param require_transparent Whether layout visibility is required.
 * @param diags Diagnostic collector.
 * @param filename Source filename to report.
 * @param span Source span to report.
 * @return `true` if the nominal reference is visible enough.
 */
func sig_check_nominal_export_visibility(nr: NameResolution*, ty: Type*, require_transparent: bool,
                                         diags: DiagCollector*, filename: string, span: Span) -> bool {
    let provider_opt = nr_env_find(nr, ty.module_name);
    if (provider_opt == null) {
        return true;
    }
    let provider = provider_opt as ModuleEnv*;
    if (spm_get(provider.exports, ty.name) == null) {
        sig_diag_error(
            diags,
            "RES-0037",
            "exported surface references unexported type '" + sig_nominal_display(ty) + "'",
            filename,
            span
        );
        return false;
    }
    if (require_transparent && ss_has(provider.opaque_exports, ty.name)) {
        sig_diag_error(
            diags,
            "RES-0038",
            "opaque type '" + sig_nominal_display(ty) + "' is used where transparent layout is required",
            filename,
            span
        );
        return false;
    }
    return true;
}

/**
 * Check every nominal type named inside an exported surface type.
 *
 * @param tables Signature tables for nested function signatures.
 * @param nr Name-resolution data containing export visibility.
 * @param ty Type tree to inspect.
 * @param require_transparent Whether the current position requires layout.
 * @param diags Diagnostic collector.
 * @param filename Source filename to report.
 * @param span Source span to report.
 * @return `true` if all nominal references are visible enough.
 */
func sig_check_export_surface_type(tables: SignatureTables*, nr: NameResolution*, ty: Type*,
                                   require_transparent: bool, diags: DiagCollector*, filename: string,
                                   span: Span) -> bool {
    match (ty.kind) {
        TY_BUILTIN => { return true; }
        TY_NULL => { return true; }
        TY_STRUCT => {
            return sig_check_nominal_export_visibility(nr, ty, require_transparent, diags, filename, span);
        }
        TY_ENUM => {
            return sig_check_nominal_export_visibility(nr, ty, require_transparent, diags, filename, span);
        }
        TY_POINTER => {
            return sig_check_export_surface_type(tables, nr, ty.inner as Type*, false, diags, filename, span);
        }
        TY_NULLABLE => {
            let inner = ty.inner as Type*;
            if (ord(inner.kind) == ord(TY_POINTER)) {
                return sig_check_export_surface_type(tables, nr, inner, false, diags, filename, span);
            }
            return sig_check_export_surface_type(tables, nr, inner, require_transparent, diags, filename, span);
        }
        TY_ARRAY => {
            return sig_check_export_surface_type(tables, nr, ty.inner as Type*, true, diags, filename, span);
        }
        TY_SLICE => {
            return sig_check_export_surface_type(tables, nr, ty.inner as Type*, true, diags, filename, span);
        }
        TY_FUNC => {
            let ok = true;
            let params = ty.params as VectorBase*;
            for (let i = 0; i < vec_size(params); i = i + 1) {
                if (!sig_check_export_surface_type(tables, nr, ptr_vec_get(params, i) as Type*, true, diags, filename, span)) {
                    ok = false;
                }
            }
            if (!sig_check_export_surface_type(tables, nr, ty.result as Type*, true, diags, filename, span)) {
                ok = false;
            }
            return ok;
        }
    }
}

/**
 * Check fields of an exported transparent struct.
 *
 * @param tables Signature tables containing resolved field types.
 * @param nr Name-resolution data containing export visibility.
 * @param info Exported struct metadata.
 * @param diags Diagnostic collector.
 */
func sig_check_exported_struct_surface(tables: SignatureTables*, nr: NameResolution*, info: StructInfo*,
                                       diags: DiagCollector*) {
    if (info.is_opaque) {
        return;
    }
    for (let i = 0; i < vec_size(info.fields); i = i + 1) {
        let field = ptr_vec_get(info.fields, i) as StructFieldInfo*;
        sig_check_export_surface_type(tables, nr, field.field_type, true, diags, info.filename, info.span);
    }
}

/**
 * Check variants of an exported transparent enum.
 *
 * @param tables Signature tables containing resolved variant payload types.
 * @param nr Name-resolution data containing export visibility.
 * @param info Exported enum metadata.
 * @param diags Diagnostic collector.
 */
func sig_check_exported_enum_surface(tables: SignatureTables*, nr: NameResolution*, info: EnumInfo*,
                                     diags: DiagCollector*) {
    if (info.is_opaque) {
        return;
    }
    for (let i = 0; i < vec_size(info.variants); i = i + 1) {
        let variant = ptr_vec_get(info.variants, i) as EnumVariantInfo*;
        for (let j = 0; j < vec_size(variant.field_types); j = j + 1) {
            sig_check_export_surface_type(tables, nr, ptr_vec_get(variant.field_types, j) as Type*, true,
                diags, info.filename, info.span);
        }
    }
}

/**
 * Enforce that exported declarations only expose exported nominal types.
 *
 * @param tables Signature tables containing resolved declaration types.
 * @param nr Name-resolution data containing export sets.
 * @param diags Diagnostic collector.
 */
func sig_check_exported_surfaces(tables: SignatureTables*, nr: NameResolution*, diags: DiagCollector*) {
    for (let env_i = 0; env_i < nr_env_count(nr); env_i = env_i + 1) {
        let env = nr_env_get(nr, env_i);
        with (let keys = nr_module_env_export_keys(env) => sv_free(keys)) {
            for (let i = 0; i < sv_size(keys); i = i + 1) {
                let name = sv_get(keys, i);
                let sym_opt = spm_get(env.exports, name);
                if (sym_opt == null) {
                    continue;
                }
                let sym = sym_opt as Symbol*;
                match (sym.kind) {
                    SYM_STRUCT => {
                        let info_opt = sig_lookup_struct_info(tables, env.module_name, name);
                        if (info_opt != null) {
                            sig_check_exported_struct_surface(tables, nr, info_opt as StructInfo*, diags);
                        }
                    }
                    SYM_ENUM => {
                        let info_opt = sig_lookup_enum_info(tables, env.module_name, name);
                        if (info_opt != null) {
                            sig_check_exported_enum_surface(tables, nr, info_opt as EnumInfo*, diags);
                        }
                    }
                    SYM_FUNC => {
                        let ty_opt = sig_lookup_func_type(tables, env.module_name, name);
                        if (ty_opt != null) {
                            sig_check_export_surface_type(tables, nr, ty_opt as Type*, true, diags,
                                env.module_ptr.filename, sym.span);
                        }
                    }
                    SYM_TYPE_ALIAS => {
                        if (sym.resolved_type != null) {
                            sig_check_export_surface_type(tables, nr, sym.resolved_type as Type*, true, diags,
                                env.module_ptr.filename, sym.span);
                        }
                    }
                    SYM_LET => {
                        let ty_opt = sig_lookup_let_type(tables, env.module_name, name);
                        if (ty_opt != null) {
                            sig_check_export_surface_type(tables, nr, ty_opt as Type*, true, diags,
                                env.module_ptr.filename, sym.span);
                        }
                    }
                    SYM_ENUM_VARIANT => {
                    }
                }
            }
        }
    }
}

/**
 * Emit deferred local/imported extern shadow diagnostics.
 *
 * @param tables Resolved signature tables.
 * @param nr Name-resolution data containing deferred checks.
 * @param diags Diagnostic collector.
 */
func sig_check_pending_extern_shadows(tables: SignatureTables*, nr: NameResolution*, diags: DiagCollector*) {
    for (let env_i = 0; env_i < nr_env_count(nr); env_i = env_i + 1) {
        let env = nr_env_get(nr, env_i);
        for (let shadow_i = 0; shadow_i < nr_module_env_pending_extern_shadow_count(env); shadow_i = shadow_i + 1) {
            let shadow = nr_module_env_pending_extern_shadow_get(env, shadow_i);
            let local_ty = sig_lookup_func_type(tables, shadow.local.module_name, shadow.local.name);
            let imported_ty = sig_lookup_func_type(tables, shadow.imported.module_name, shadow.imported.name);
            if (local_ty == null || imported_ty == null) {
                continue;
            }
            if (type_equals(local_ty as Type*, imported_ty as Type*)) {
                sig_name_diag_warn(
                    diags,
                    "RES-0020",
                    "imported extern function '" + nr_build_top_key(shadow.imported_module, shadow.name) +
                        "' will be shadowed by a compatible local extern declaration in module '" + env.module_name + "'",
                    env.module_ptr.filename,
                    shadow.local.span
                );
            } else {
                sig_name_diag_error(
                    diags,
                    "RES-0023",
                    "imported extern function '" + nr_build_top_key(shadow.imported_module, shadow.name) +
                        "' has an incompatible signature with the local extern declaration in module '" +
                        env.module_name + "'",
                    env.module_ptr.filename,
                    shadow.local.span
                );
            }
        }
    }
}

/**
 * Store an interface-backed struct signature.
 *
 * @param tables Signature tables receiving replayed metadata.
 * @param info Interface struct metadata.
 */
func sig_replay_interface_struct(tables: SignatureTables*, info: StructInfo*) {
    let cloned = miu_clone_struct_info(info);
    spm_put(tables.struct_infos, cloned.key, cloned as void*);
}

/**
 * Store an interface-backed enum signature.
 *
 * @param tables Signature tables receiving replayed metadata.
 * @param info Interface enum metadata.
 */
func sig_replay_interface_enum(tables: SignatureTables*, info: EnumInfo*) {
    let cloned = miu_clone_enum_info(info);
    spm_put(tables.enum_infos, cloned.key, cloned as void*);
}

/**
 * Store interface-backed function and binding signatures.
 *
 * @param tables Signature tables receiving replayed metadata.
 * @param mi Interface metadata to replay.
 */
func sig_replay_interface_entries(tables: SignatureTables*, mi: ModuleInterface*) {
    for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
        let entry = ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*;
        spm_put(tables.func_types, sig_key(mi.module_name, entry.name), type_clone(entry.ty) as void*);
    }

    for (let let_i = 0; let_i < vec_size(mi.let_entries); let_i = let_i + 1) {
        let entry2 = ptr_vec_get(mi.let_entries, let_i) as InterfaceLetEntry*;
        spm_put(tables.let_types, sig_key(mi.module_name, entry2.name), type_clone(entry2.ty) as void*);
    }
}

/**
 * Replay supplied module-interface signatures into semantic tables.
 *
 * @param tables Signature tables receiving replayed metadata.
 * @param driver_state Driver state containing cloned interfaces.
 */
func sig_replay_interfaces(tables: SignatureTables*, driver_state: DriverState*) {
    for (let iface_i = 0; iface_i < driver_interface_count(driver_state); iface_i = iface_i + 1) {
        let mi = driver_interface_get(driver_state, iface_i);
        for (let struct_i = 0; struct_i < vec_size(mi.struct_infos); struct_i = struct_i + 1) {
            sig_replay_interface_struct(tables, ptr_vec_get(mi.struct_infos, struct_i) as StructInfo*);
        }
        for (let enum_i = 0; enum_i < vec_size(mi.enum_infos); enum_i = enum_i + 1) {
            sig_replay_interface_enum(tables, ptr_vec_get(mi.enum_infos, enum_i) as EnumInfo*);
        }
        sig_replay_interface_entries(tables, mi);
    }
}

/**
 * Check one raw interface type against its module's semantic closure.
 *
 * @param owner_module Interface module whose surface contains `ty`.
 * @param ty Wire-preserving interface type to inspect.
 * @param closure Semantic provider closure for `owner_module`.
 * @param reported Provider modules already diagnosed for this interface.
 * @param diags Diagnostic collector.
 * @param filename Synthetic interface filename for diagnostics.
 * @param span Interface span for diagnostics.
 * @return `true` when every referenced provider is in `closure`.
 */
func sig_check_interface_closure_type(owner_module: string, ty: Type*, closure: StringSet*,
                                      reported: StringSet*, diags: DiagCollector*, filename: string,
                                      span: Span) -> bool {
    if (ord(ty.kind) == ord(TY_POINTER) || ord(ty.kind) == ord(TY_NULLABLE) ||
        ord(ty.kind) == ord(TY_ARRAY) || ord(ty.kind) == ord(TY_SLICE)) {
        return sig_check_interface_closure_type(owner_module, ty.inner as Type*, closure, reported, diags,
            filename, span);
    }
    if (ord(ty.kind) == ord(TY_FUNC)) {
        let ok = true;
        let params = ty.params as VectorBase*;
        for (let param_i = 0; param_i < vec_size(params); param_i = param_i + 1) {
            if (!sig_check_interface_closure_type(owner_module, ptr_vec_get(params, param_i) as Type*, closure,
                reported, diags, filename, span)) {
                ok = false;
            }
        }
        if (!sig_check_interface_closure_type(owner_module, ty.result as Type*, closure, reported, diags,
            filename, span)) {
            ok = false;
        }
        return ok;
    }
    if (ord(ty.kind) != ord(TY_STRUCT) && ord(ty.kind) != ord(TY_ENUM)) {
        return true;
    }
    if (ty.module_name == "" || ty.module_name == owner_module || ss_has(closure, ty.module_name)) {
        return true;
    }
    if (!ss_has(reported, ty.module_name)) {
        ss_add(reported, ty.module_name);
        sig_diag_error(
            diags,
            "RES-0040",
            "interface surface references a provider outside its semantic require closure",
            filename,
            span
        );
    }
    return false;
}

/**
 * Check every type-bearing declaration in one interface clone.
 *
 * @param mi Interface surface to inspect.
 * @param closure Semantic provider closure for `mi`.
 * @param reported Provider modules already diagnosed across interface clones.
 * @param diags Diagnostic collector.
 * @param filename Synthetic interface filename for diagnostics.
 * @param default_span Fallback span for entries without declaration metadata.
 */
func sig_check_interface_closure_surface(mi: ModuleInterface*, closure: StringSet*, reported: StringSet*,
                                         diags: DiagCollector*, filename: string, default_span: Span) {
    for (let struct_i = 0; struct_i < vec_size(mi.struct_infos); struct_i = struct_i + 1) {
        let info = ptr_vec_get(mi.struct_infos, struct_i) as StructInfo*;
        for (let field_i = 0; field_i < vec_size(info.fields); field_i = field_i + 1) {
            sig_check_interface_closure_type(mi.module_name,
                (ptr_vec_get(info.fields, field_i) as StructFieldInfo*).field_type, closure, reported, diags,
                filename, info.span);
        }
    }
    for (let enum_i = 0; enum_i < vec_size(mi.enum_infos); enum_i = enum_i + 1) {
        let info2 = ptr_vec_get(mi.enum_infos, enum_i) as EnumInfo*;
        for (let variant_i = 0; variant_i < vec_size(info2.variants); variant_i = variant_i + 1) {
            let variant = ptr_vec_get(info2.variants, variant_i) as EnumVariantInfo*;
            for (let field_i2 = 0; field_i2 < vec_size(variant.field_types); field_i2 = field_i2 + 1) {
                sig_check_interface_closure_type(mi.module_name,
                    ptr_vec_get(variant.field_types, field_i2) as Type*, closure, reported, diags, filename,
                    info2.span);
            }
        }
    }
    for (let alias_i = 0; alias_i < vec_size(mi.alias_entries); alias_i = alias_i + 1) {
        sig_check_interface_closure_type(mi.module_name,
            (ptr_vec_get(mi.alias_entries, alias_i) as InterfaceAliasEntry*).ty, closure, reported, diags, filename,
            default_span);
    }
    for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
        sig_check_interface_closure_type(mi.module_name,
            (ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*).ty, closure, reported, diags, filename,
            default_span);
    }
    for (let let_i = 0; let_i < vec_size(mi.let_entries); let_i = let_i + 1) {
        sig_check_interface_closure_type(mi.module_name,
            (ptr_vec_get(mi.let_entries, let_i) as InterfaceLetEntry*).ty, closure, reported, diags, filename,
            default_span);
    }
}

/**
 * Enforce semantic require closure for every resolved interface surface.
 *
 * Validation reads every selected raw graph interface, including link-only
 * nodes that have no name-resolution environment. Active interfaces receive a
 * second pass over their finalized semantic clone so providers exposed by
 * transparent alias expansion are also checked.
 *
 * @param driver_state Driver state containing the graph and interface clones.
 * @param diags Diagnostic collector.
 */
func sig_check_interface_semantic_closures(driver_state: DriverState*, diags: DiagCollector*) {
    let graph = driver_graph(driver_state);
    with (let nodes = mg_nodes_sorted(graph) => vec_free(nodes)) {
        for (let node_i = 0; node_i < vec_size(nodes); node_i = node_i + 1) {
            let node = ptr_vec_get(nodes, node_i) as ModuleGraphNode*;
            if (ord(node.state) != ord(MNS_RESOLVED) ||
                (ord(node.origin.kind) != ord(MOK_INTERFACE) && ord(node.origin.kind) != ord(MOK_REGISTRY))) {
                continue;
            }
            let raw_opt = driver_find_graph_interface(driver_state, node.module_name);
            if (raw_opt == null) {
                continue;
            }
            let raw = raw_opt as ModuleInterface*;
            let filename = "<interface:" + node.module_name + ">";
            if (node.origin.path != null) {
                filename = node.origin.path as string;
            }
            with (let closure = mg_semantic_closure(graph, node.module_name) => ss_free(closure),
                  let reported = ss_create() => ss_free(reported)) {
                sig_check_interface_closure_surface(raw, closure, reported, diags, filename, Span(0, 0, 0, 0));
                let semantic_opt = driver_find_interface(driver_state, node.module_name);
                if (semantic_opt != null) {
                    sig_check_interface_closure_surface(semantic_opt as ModuleInterface*, closure, reported, diags,
                        filename, Span(0, 0, 0, 0));
                }
            }
        }
    }
}

/**
 * Resolve top-level type signatures for parsed modules.
 *
 * @param driver_state Parsed driver state.
 * @param nr Name-resolution result.
 * @param diags Diagnostic collector.
 * @return Populated signature tables.
 */
func sig_resolve(driver_state: DriverState*, nr: NameResolution*, diags: DiagCollector*) -> SignatureTables* {
    let tables = sig_make_tables();
    let pending_shapes = ptr_vec_create(4);

    sig_replay_interfaces(tables, driver_state);

    for (let i = 0; i < nr_env_count(nr); i = i + 1) {
        let env = nr_env_get(nr, i);
        let mod = env.module_ptr;
        for (let j = 0; j < vec_size(mod.decls); j = j + 1) {
            let top = ptr_vec_get(mod.decls, j) as TopLevelDecl*;
            let canonical_sym = nr_module_env_local(env, sig_top_decl_name(top));
            if (canonical_sym != null) {
                let canonical_span = (canonical_sym as Symbol*).span;
                let top_span = sig_top_decl_span(top);
                if (canonical_span.start_line != top_span.start_line ||
                    canonical_span.start_column != top_span.start_column ||
                    canonical_span.end_line != top_span.end_line ||
                    canonical_span.end_column != top_span.end_column) {
                    continue;
                }
            }
            match (top.kind) {
                TD_STRUCT => {
                    sig_resolve_struct(tables, nr, driver_state, env, top.data as StructDecl*, diags,
                        pending_shapes);
                }
                TD_ENUM => {
                    sig_resolve_enum(tables, nr, driver_state, env, top.data as EnumDecl*, diags,
                        pending_shapes);
                }
                TD_FUNC => {
                    sig_resolve_func(tables, nr, driver_state, env, top.data as FuncDecl*, diags,
                        pending_shapes);
                }
                TD_TYPE_ALIAS => {
                    let sym = nr_module_env_local(env, (top.data as TypeAliasDecl*).name);
                    if (sym != null) {
                        with (let seen = ss_create() => ss_free(seen)) {
                            let resolved_alias = tr_resolve_alias(tables, nr, driver_state, env, sym as Symbol*, diags,
                                seen);
                            if (resolved_alias != null) {
                                type_free(resolved_alias as Type*);
                            }
                        }
                    }
                }
                TD_LET => {
                    sig_resolve_let(tables, nr, env, driver_state, top.data as LetDecl*, diags,
                        pending_shapes);
                }
            }
        }
    }

    tr_finalize_materialized_types(tables, nr, driver_state, diags);
    sig_check_interface_semantic_closures(driver_state, diags);
    sig_check_pending_materialized_shapes(pending_shapes, tables, nr, driver_state, diags);
    sig_check_materialized_interface_shapes(nr, driver_state, diags);
    sig_detect_value_type_cycles(tables, diags);
    sig_check_pending_extern_shadows(tables, nr, diags);
    sig_check_exported_surfaces(tables, nr, diags);
    sig_pending_shapes_free(pending_shapes);
    return tables;
}
