module object_reader_elf;

import std.string;
import std.vector;

import object_reader_types;

let ORELF_CLASS_32: int = 1;
let ORELF_CLASS_64: int = 2;
let ORELF_DATA_LE: int = 1;
let ORELF_DATA_BE: int = 2;
let ORELF_ET_REL: int = 1;
let ORELF_SHT_NULL: int = 0;
let ORELF_SHT_SYMTAB: int = 2;
let ORELF_SHT_STRTAB: int = 3;
let ORELF_SHT_NOBITS: int = 8;
let ORELF_SHN_UNDEF: int = 0;
let ORELF_SHN_LORESERVE: int = 65280;

/** Exact ELF magic probe. */
func orelf_is_object_magic(bytes: string) -> bool {
    return len_s(bytes) >= 4 &&
        (char_at_s(bytes, 0) as int) == 127 &&
        char_at_s(bytes, 1) == 'E' &&
        char_at_s(bytes, 2) == 'L' &&
        char_at_s(bytes, 3) == 'F';
}

func orelf_section_base(section_table: int, section_size: int, index: int) -> int {
    return section_table + section_size * index;
}

func orelf_section_type(bytes: string, base: int, little: bool) -> int? {
    return ort_read_u32(bytes, base + 4, little);
}

func orelf_section_offset(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u64_int(bytes, base + 24, little);
    }
    return ort_read_u32(bytes, base + 16, little);
}

func orelf_section_size(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u64_int(bytes, base + 32, little);
    }
    return ort_read_u32(bytes, base + 20, little);
}

func orelf_section_link(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u32(bytes, base + 40, little);
    }
    return ort_read_u32(bytes, base + 24, little);
}

func orelf_section_entry_size(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u64_int(bytes, base + 56, little);
    }
    return ort_read_u32(bytes, base + 36, little);
}

func orelf_symbol_value(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u64_int(bytes, base + 8, little);
    }
    return ort_read_u32(bytes, base + 4, little);
}

func orelf_symbol_size(bytes: string, base: int, is_64: bool, little: bool) -> int? {
    if (is_64) {
        return ort_read_u64_int(bytes, base + 16, little);
    }
    return ort_read_u32(bytes, base + 8, little);
}

func orelf_symbol_info_offset(is_64: bool) -> int {
    if (is_64) {
        return 4;
    }
    return 12;
}

func orelf_symbol_section_offset(is_64: bool) -> int {
    if (is_64) {
        return 6;
    }
    return 14;
}

/**
 * Normalize only the leading underscore aliases emitted by Darwin TinyCC.
 *
 * TinyCC writes an ELF container on Darwin while retaining Mach-O-style
 * external symbol decoration.  Other ELF symbol names remain byte-exact.
 */
func orelf_normalize_symbol_name(name: string) -> string {
    if (name == "_main") {
        return "main";
    }
    if (starts_with_s(name, "___dea")) {
        return slice_s(name, 1, len_s(name));
    }
    return name;
}

/**
 * Read a complete ELF32/ELF64 relocatable object from bytes.
 */
func orelf_read_bytes(bytes: string) -> ObjectContainerReadResult* {
    if (!orelf_is_object_magic(bytes)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "not an ELF object");
    }
    if (len_s(bytes) < 16) {
        return ort_read_error(OBJECT_READ_CORRUPT, "truncated ELF identification");
    }

    let elf_class = char_at_s(bytes, 4) as int;
    let encoding = char_at_s(bytes, 5) as int;
    if (elf_class != ORELF_CLASS_32 && elf_class != ORELF_CLASS_64) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "unsupported ELF class");
    }
    if (encoding != ORELF_DATA_LE && encoding != ORELF_DATA_BE) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "unsupported ELF byte order");
    }
    if ((char_at_s(bytes, 6) as int) != 1) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "unsupported ELF identification version");
    }

    let is_64 = elf_class == ORELF_CLASS_64;
    let little = encoding == ORELF_DATA_LE;
    let header_size = 52;
    let section_header_size = 40;
    if (is_64) {
        header_size = 64;
        section_header_size = 64;
    }
    if (len_s(bytes) < header_size) {
        return ort_read_error(OBJECT_READ_CORRUPT, "truncated ELF header");
    }

    let object_type = ort_read_u16(bytes, 16, little);
    let object_version = ort_read_u32(bytes, 20, little);
    if (object_type == null || object_version == null) {
        return ort_read_error(OBJECT_READ_CORRUPT, "invalid ELF header fields");
    }
    if ((object_type as int) != ORELF_ET_REL) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "ELF file is not relocatable");
    }
    if ((object_version as int) != 1) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "unsupported ELF object version");
    }

    let section_table: int? = null;
    let encoded_header_size: int? = null;
    let encoded_section_size: int? = null;
    let section_count: int? = null;
    let section_name_index: int? = null;
    if (is_64) {
        section_table = ort_read_u64_int(bytes, 40, little);
        encoded_header_size = ort_read_u16(bytes, 52, little);
        encoded_section_size = ort_read_u16(bytes, 58, little);
        section_count = ort_read_u16(bytes, 60, little);
        section_name_index = ort_read_u16(bytes, 62, little);
    } else {
        section_table = ort_read_u32(bytes, 32, little);
        encoded_header_size = ort_read_u16(bytes, 40, little);
        encoded_section_size = ort_read_u16(bytes, 46, little);
        section_count = ort_read_u16(bytes, 48, little);
        section_name_index = ort_read_u16(bytes, 50, little);
    }
    if (section_table == null || encoded_header_size == null ||
        encoded_section_size == null || section_count == null ||
        section_name_index == null) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "ELF section-table fields exceed supported integer bounds");
    }
    if ((encoded_header_size as int) != header_size ||
        (encoded_section_size as int) != section_header_size) {
        return ort_read_error(OBJECT_READ_CORRUPT, "invalid ELF header or section-header size");
    }
    if ((section_count as int) == 0 || (section_name_index as int) == 65535) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "ELF extended section numbering is unsupported");
    }
    if ((section_name_index as int) != 0 &&
        (section_name_index as int) >= (section_count as int)) {
        return ort_read_error(OBJECT_READ_CORRUPT, "ELF section-name table index is out of range");
    }
    let section_table_bytes = ort_checked_product(section_count as int, section_header_size);
    if (section_table_bytes == null ||
        !ort_range_valid(len_s(bytes), section_table as int, section_table_bytes as int)) {
        return ort_read_error(OBJECT_READ_CORRUPT, "ELF section table is out of bounds");
    }
    if (ort_ranges_overlap(section_table as int, section_table_bytes as int,
                           0, header_size)) {
        return ort_read_error(OBJECT_READ_CORRUPT,
            "ELF section table overlaps the file header");
    }
    let first_type = orelf_section_type(bytes, section_table as int, little);
    if (first_type == null || (first_type as int) != ORELF_SHT_NULL) {
        return ort_read_error(OBJECT_READ_CORRUPT, "ELF section zero is not null");
    }

    /* Validate every file-backed section before following symbol references. */
    for (let section_i = 0; section_i < section_count as int; section_i = section_i + 1) {
        let base = orelf_section_base(section_table as int, section_header_size, section_i);
        let section_type = orelf_section_type(bytes, base, little);
        let file_offset = orelf_section_offset(bytes, base, is_64, little);
        let file_size = orelf_section_size(bytes, base, is_64, little);
        if (section_type == null || file_offset == null || file_size == null) {
            return ort_read_error(OBJECT_READ_UNSUPPORTED,
                "ELF section range exceeds supported integer bounds");
        }
        if ((section_type as int) != ORELF_SHT_NOBITS &&
            !ort_range_valid(len_s(bytes), file_offset as int, file_size as int)) {
            return ort_read_error(OBJECT_READ_CORRUPT, "ELF section data is out of bounds");
        }
        if ((section_type as int) != ORELF_SHT_NOBITS &&
            (file_size as int) > 0 &&
            (ort_ranges_overlap(file_offset as int, file_size as int,
                                0, header_size) ||
             ort_ranges_overlap(file_offset as int, file_size as int,
                                section_table as int, section_table_bytes as int))) {
            return ort_read_error(OBJECT_READ_CORRUPT,
                "ELF section data overlaps file or section headers");
        }
        for (let prior_i = 0; prior_i < section_i; prior_i = prior_i + 1) {
            let prior_base = orelf_section_base(
                section_table as int, section_header_size, prior_i);
            let prior_type = orelf_section_type(bytes, prior_base, little);
            let prior_offset = orelf_section_offset(bytes, prior_base, is_64, little);
            let prior_size = orelf_section_size(bytes, prior_base, is_64, little);
            if (prior_type == null || prior_offset == null || prior_size == null) {
                return ort_read_error(OBJECT_READ_UNSUPPORTED,
                    "ELF section range exceeds supported integer bounds");
            }
            if ((section_type as int) != ORELF_SHT_NOBITS &&
                (prior_type as int) != ORELF_SHT_NOBITS &&
                ort_ranges_overlap(file_offset as int, file_size as int,
                                   prior_offset as int, prior_size as int)) {
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "ELF file-backed section ranges overlap");
            }
        }
    }

    let container = ort_container_create(OBJECT_FORMAT_ELF, bytes);
    for (let section_i2 = 0; section_i2 < section_count as int; section_i2 = section_i2 + 1) {
        let section_base = orelf_section_base(
            section_table as int, section_header_size, section_i2);
        let type_value = orelf_section_type(bytes, section_base, little);
        if (type_value == null || (type_value as int) != ORELF_SHT_SYMTAB) {
            continue;
        }

        let symbol_offset = orelf_section_offset(bytes, section_base, is_64, little);
        let symbol_bytes = orelf_section_size(bytes, section_base, is_64, little);
        let string_index = orelf_section_link(bytes, section_base, is_64, little);
        let entry_size = orelf_section_entry_size(bytes, section_base, is_64, little);
        let expected_entry_size = 16;
        if (is_64) {
            expected_entry_size = 24;
        }
        if (symbol_offset == null || symbol_bytes == null ||
            string_index == null || entry_size == null) {
            return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                "ELF symbol-table fields exceed supported integer bounds");
        }
        if ((entry_size as int) != expected_entry_size ||
            (symbol_bytes as int) % expected_entry_size != 0) {
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "ELF symbol table has an invalid entry size");
        }
        if ((string_index as int) <= 0 ||
            (string_index as int) >= (section_count as int)) {
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "ELF symbol string-table link is out of range");
        }
        let string_base = orelf_section_base(
            section_table as int, section_header_size, string_index as int);
        let string_type = orelf_section_type(bytes, string_base, little);
        let string_offset = orelf_section_offset(bytes, string_base, is_64, little);
        let string_size = orelf_section_size(bytes, string_base, is_64, little);
        if (string_type == null || string_offset == null || string_size == null) {
            return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                "ELF string-table fields exceed supported integer bounds");
        }
        if ((string_type as int) != ORELF_SHT_STRTAB || (string_size as int) <= 0 ||
            !ort_range_valid(len_s(bytes), string_offset as int, string_size as int) ||
            (char_at_s(bytes, string_offset as int) as int) != 0) {
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "ELF symbol string table is invalid");
        }
        if (ort_ranges_overlap(symbol_offset as int, symbol_bytes as int,
                               string_offset as int, string_size as int) ||
            ort_ranges_overlap(symbol_offset as int, symbol_bytes as int,
                               section_table as int, section_table_bytes as int) ||
            ort_ranges_overlap(string_offset as int, string_size as int,
                               section_table as int, section_table_bytes as int)) {
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "ELF symbol, string, and section tables overlap");
        }

        let symbol_count = (symbol_bytes as int) / expected_entry_size;
        if (!ort_symbol_count_is_storable(symbol_count)) {
            return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                "ELF symbol count exceeds supported allocation bounds");
        }
        for (let symbol_i = 0; symbol_i < symbol_count; symbol_i = symbol_i + 1) {
            let symbol_base = (symbol_offset as int) + symbol_i * expected_entry_size;
            let name_offset = ort_read_u32(bytes, symbol_base, little);
            let info = ort_read_u8(bytes, symbol_base + orelf_symbol_info_offset(is_64));
            let section_index = ort_read_u16(
                bytes, symbol_base + orelf_symbol_section_offset(is_64), little);
            if (name_offset == null || info == null || section_index == null) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "truncated ELF symbol entry");
            }
            if ((section_index as int) == 65535) {
                return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                    "ELF extended symbol section indexes are unsupported");
            }
            let symbol_name = ort_read_c_string(
                bytes, string_offset as int, string_size as int, name_offset as int);
            if (symbol_name == null) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "ELF symbol name is out of range or unterminated");
            }
            let binding = (info as int) / 16;
            if ((binding != 1 && binding != 2) ||
                (section_index as int) == ORELF_SHN_UNDEF) {
                continue;
            }
            if (len_s(symbol_name as string) == 0) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "defined external ELF symbol has an empty name");
            }
            let normalized_name = orelf_normalize_symbol_name(symbol_name as string);

            if ((section_index as int) >= ORELF_SHN_LORESERVE) {
                ort_container_add_symbol(container, normalized_name,
                                         0, 0, -1, false);
                continue;
            }
            if ((section_index as int) >= (section_count as int)) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "ELF symbol section index is out of range");
            }
            let target_base = orelf_section_base(
                section_table as int, section_header_size, section_index as int);
            let target_type = orelf_section_type(bytes, target_base, little);
            let target_offset = orelf_section_offset(bytes, target_base, is_64, little);
            let target_size = orelf_section_size(bytes, target_base, is_64, little);
            let symbol_value = orelf_symbol_value(bytes, symbol_base, is_64, little);
            let declared_size = orelf_symbol_size(bytes, symbol_base, is_64, little);
            if (target_type == null || target_offset == null || target_size == null ||
                symbol_value == null || declared_size == null) {
                return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                    "ELF symbol location exceeds supported integer bounds");
            }
            if ((symbol_value as int) > (target_size as int)) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "ELF symbol value lies outside its section");
            }
            let useful_size = -1;
            if ((declared_size as int) > 0) {
                useful_size = declared_size as int;
            }
            let available = (target_size as int) - (symbol_value as int);
            if (useful_size > available) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "ELF symbol size lies outside its section");
            }
            if ((target_type as int) == ORELF_SHT_NOBITS) {
                ort_container_add_symbol(container, normalized_name,
                                         0, available, useful_size, false);
                continue;
            }
            if (!ort_range_valid(len_s(bytes), target_offset as int, target_size as int) ||
                (symbol_value as int) > len_s(bytes) - (target_offset as int)) {
                return ort_container_error(container, OBJECT_READ_CORRUPT,
                    "ELF symbol file location is out of bounds");
            }
            ort_container_add_symbol(container, normalized_name,
                (target_offset as int) + (symbol_value as int),
                available, useful_size, true);
        }
    }
    return ort_read_ok(container);
}
