module object_reader_macho;

import std.string;
import std.vector;

import object_reader_types;

let ORMACHO_MH_OBJECT: int = 1;
let ORMACHO_LC_SEGMENT: int = 1;
let ORMACHO_LC_SYMTAB: int = 2;
let ORMACHO_LC_SEGMENT_64: int = 25;
let ORMACHO_LC_LINKER_OPTION: int = 45;
let ORMACHO_N_TYPE_UNDF: int = 0;
let ORMACHO_N_TYPE_PBUD: int = 6;
let ORMACHO_N_TYPE_SECT: int = 7;

func ormacho_byte(bytes: string, offset: int) -> int {
    return char_at_s(bytes, offset) as int;
}

/** Probe one supported thin Mach-O magic and return whether it is 64-bit. */
func ormacho_magic_is_64(bytes: string) -> bool? {
    if (len_s(bytes) < 4) {
        return null;
    }
    if ((ormacho_byte(bytes, 0) == 206 && ormacho_byte(bytes, 1) == 250 &&
         ormacho_byte(bytes, 2) == 237 && ormacho_byte(bytes, 3) == 254) ||
        (ormacho_byte(bytes, 0) == 254 && ormacho_byte(bytes, 1) == 237 &&
         ormacho_byte(bytes, 2) == 250 && ormacho_byte(bytes, 3) == 206)) {
        return false;
    }
    if ((ormacho_byte(bytes, 0) == 207 && ormacho_byte(bytes, 1) == 250 &&
         ormacho_byte(bytes, 2) == 237 && ormacho_byte(bytes, 3) == 254) ||
        (ormacho_byte(bytes, 0) == 254 && ormacho_byte(bytes, 1) == 237 &&
         ormacho_byte(bytes, 2) == 250 && ormacho_byte(bytes, 3) == 207)) {
        return true;
    }
    return null;
}

/** Return the byte order selected by one supported thin Mach-O magic. */
func ormacho_magic_is_little(bytes: string) -> bool {
    return ormacho_byte(bytes, 0) == 206 || ormacho_byte(bytes, 0) == 207;
}

/** Exact supported thin Mach-O probe. */
func ormacho_is_object_magic(bytes: string) -> bool {
    return ormacho_magic_is_64(bytes) != null;
}

/** Exact fat/universal Mach-O probe, which the reader rejects explicitly. */
func ormacho_is_fat_magic(bytes: string) -> bool {
    if (len_s(bytes) < 4) {
        return false;
    }
    return
        (ormacho_byte(bytes, 0) == 202 && ormacho_byte(bytes, 1) == 254 &&
         ormacho_byte(bytes, 2) == 186 &&
         (ormacho_byte(bytes, 3) == 190 || ormacho_byte(bytes, 3) == 191)) ||
        ((ormacho_byte(bytes, 0) == 190 || ormacho_byte(bytes, 0) == 191) &&
         ormacho_byte(bytes, 1) == 186 && ormacho_byte(bytes, 2) == 254 &&
         ormacho_byte(bytes, 3) == 202);
}

func ormacho_field_is_nonzero(bytes: string, offset: int, size: int) -> bool? {
    if (!ort_range_valid(len_s(bytes), offset, size)) {
        return null;
    }
    for (let i = 0; i < size; i = i + 1) {
        if ((char_at_s(bytes, offset + i) as int) != 0) {
            return true;
        }
    }
    return false;
}

/**
 * Read a complete thin Mach-O 32-bit or 64-bit relocatable object.
 */
func ormacho_read_bytes(bytes: string) -> ObjectContainerReadResult* {
    if (ormacho_is_fat_magic(bytes)) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "fat or universal Mach-O objects are unsupported");
    }
    let is_64_value = ormacho_magic_is_64(bytes);
    if (is_64_value == null) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "not a supported Mach-O object");
    }
    let is_64 = is_64_value as bool;
    let little = ormacho_magic_is_little(bytes);
    let header_size = 28;
    let nlist_size = 12;
    let command_alignment = 4;
    if (is_64) {
        header_size = 32;
        nlist_size = 16;
        command_alignment = 8;
    }
    if (len_s(bytes) < header_size) {
        return ort_read_error(OBJECT_READ_CORRUPT, "truncated Mach-O header");
    }
    let file_type = ort_read_u32(bytes, 12, little);
    let command_count = ort_read_u32(bytes, 16, little);
    let command_bytes = ort_read_u32(bytes, 20, little);
    if (file_type == null || command_count == null || command_bytes == null) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED,
            "Mach-O header fields exceed supported integer bounds");
    }
    if ((file_type as int) != ORMACHO_MH_OBJECT) {
        return ort_read_error(OBJECT_READ_UNSUPPORTED, "Mach-O file is not relocatable");
    }
    if (!ort_range_valid(len_s(bytes), header_size, command_bytes as int)) {
        return ort_read_error(OBJECT_READ_CORRUPT, "Mach-O load-command table is out of bounds");
    }
    if ((command_count as int) > (command_bytes as int) / 8) {
        return ort_read_error(OBJECT_READ_CORRUPT,
            "Mach-O load-command count exceeds its table");
    }

    let sections = ort_ptr_vec_create(8);
    let have_symtab = false;
    let symbol_offset = 0;
    let symbol_count = 0;
    let string_offset = 0;
    let string_size = 0;
    let linker_control = OBJECT_LINKER_CONTROL_NONE;
    let command_cursor = header_size;
    let command_end = header_size + (command_bytes as int);
    for (let command_i = 0; command_i < command_count as int;
         command_i = command_i + 1) {
        if (!ort_range_valid(command_end, command_cursor, 8)) {
            ort_sections_free(sections);
            return ort_read_error(OBJECT_READ_CORRUPT, "truncated Mach-O load command");
        }
        let command = ort_read_u32(bytes, command_cursor, little);
        let command_size = ort_read_u32(bytes, command_cursor + 4, little);
        if (command == null || command_size == null ||
            (command_size as int) < 8 ||
            (command_size as int) % command_alignment != 0 ||
            !ort_range_valid(command_end, command_cursor, command_size as int)) {
            ort_sections_free(sections);
            return ort_read_error(OBJECT_READ_CORRUPT, "invalid Mach-O load command size");
        }
        if ((command as int) == ORMACHO_LC_LINKER_OPTION) {
            linker_control = OBJECT_LINKER_CONTROL_MACHO_LINKER_OPTION;
        }

        if ((command as int) == ORMACHO_LC_SEGMENT ||
            (command as int) == ORMACHO_LC_SEGMENT_64) {
            let command_is_64 = (command as int) == ORMACHO_LC_SEGMENT_64;
            if (command_is_64 != is_64) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "Mach-O segment command does not match object width");
            }
            let segment_header_size = 56;
            let section_size = 68;
            let section_count_offset = 48;
            if (is_64) {
                segment_header_size = 72;
                section_size = 80;
                section_count_offset = 64;
            }
            if ((command_size as int) < segment_header_size) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "truncated Mach-O segment command");
            }
            let count = ort_read_u32(bytes, command_cursor + section_count_offset, little);
            if (count == null) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_UNSUPPORTED,
                    "Mach-O section count exceeds supported integer bounds");
            }
            let section_bytes = ort_checked_product(count as int, section_size);
            if (section_bytes == null ||
                (section_bytes as int) > (command_size as int) - segment_header_size ||
                (command_size as int) != segment_header_size + (section_bytes as int)) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "Mach-O segment section table is inconsistent");
            }
            if ((count as int) > 255 - vec_size(sections)) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_UNSUPPORTED,
                    "Mach-O object has more than 255 sections");
            }

            for (let section_i = 0; section_i < count as int; section_i = section_i + 1) {
                let base = command_cursor + segment_header_size + section_i * section_size;
                let address: int? = null;
                let size: int? = null;
                let file_offset: int? = null;
                let section_type_offset = 56;
                if (is_64) {
                    address = ort_read_u64_int(bytes, base + 32, little);
                    size = ort_read_u64_int(bytes, base + 40, little);
                    file_offset = ort_read_u32(bytes, base + 48, little);
                    section_type_offset = 64;
                } else {
                    address = ort_read_u32(bytes, base + 32, little);
                    size = ort_read_u32(bytes, base + 36, little);
                    file_offset = ort_read_u32(bytes, base + 40, little);
                }
                if (address == null || size == null || file_offset == null) {
                    ort_sections_free(sections);
                    return ort_read_error(OBJECT_READ_UNSUPPORTED,
                        "Mach-O section range exceeds supported integer bounds");
                }
                let type_byte_offset = base + section_type_offset;
                if (!little) {
                    type_byte_offset = type_byte_offset + 3;
                }
                let section_type = char_at_s(bytes, type_byte_offset) as int;
                let file_backed = section_type != 1 &&
                    section_type != 12 && section_type != 18;
                if (file_backed &&
                    !ort_range_valid(len_s(bytes), file_offset as int, size as int)) {
                    ort_sections_free(sections);
                    return ort_read_error(OBJECT_READ_CORRUPT,
                        "Mach-O section data is out of bounds");
                }
                if (file_backed && (size as int) > 0 &&
                    ort_ranges_overlap(file_offset as int, size as int,
                                       0, command_end)) {
                    ort_sections_free(sections);
                    return ort_read_error(OBJECT_READ_CORRUPT,
                        "Mach-O section data overlaps the file headers");
                }
                for (let prior_i = 0; prior_i < vec_size(sections);
                     prior_i = prior_i + 1) {
                    let prior = ort_ptr_vec_get(
                        sections, prior_i) as ObjectReaderSection*;
                    if (file_backed && prior.file_backed &&
                        ort_ranges_overlap(file_offset as int, size as int,
                                           prior.file_offset, prior.size)) {
                        ort_sections_free(sections);
                        return ort_read_error(OBJECT_READ_CORRUPT,
                            "Mach-O file-backed section ranges overlap");
                    }
                }
                ort_ptr_vec_push(sections,
                    new ObjectReaderSection(file_offset as int, size as int,
                                            address as int, file_backed) as void*);
            }
        } else if ((command as int) == ORMACHO_LC_SYMTAB) {
            if ((command_size as int) != 24 || have_symtab) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_CORRUPT,
                    "invalid or duplicate Mach-O symbol-table command");
            }
            let parsed_symbol_offset = ort_read_u32(bytes, command_cursor + 8, little);
            let parsed_symbol_count = ort_read_u32(bytes, command_cursor + 12, little);
            let parsed_string_offset = ort_read_u32(bytes, command_cursor + 16, little);
            let parsed_string_size = ort_read_u32(bytes, command_cursor + 20, little);
            if (parsed_symbol_offset == null || parsed_symbol_count == null ||
                parsed_string_offset == null || parsed_string_size == null) {
                ort_sections_free(sections);
                return ort_read_error(OBJECT_READ_UNSUPPORTED,
                    "Mach-O symbol-table fields exceed supported integer bounds");
            }
            have_symtab = true;
            symbol_offset = parsed_symbol_offset as int;
            symbol_count = parsed_symbol_count as int;
            string_offset = parsed_string_offset as int;
            string_size = parsed_string_size as int;
        }
        command_cursor = command_cursor + (command_size as int);
    }
    if (command_cursor != command_end) {
        ort_sections_free(sections);
        return ort_read_error(OBJECT_READ_CORRUPT,
            "Mach-O load commands do not consume their declared table");
    }

    let container = ort_container_create(OBJECT_FORMAT_MACHO, bytes);
    container.linker_control = linker_control;
    if (!have_symtab) {
        ort_sections_free(sections);
        return ort_read_ok(container);
    }
    let symbol_bytes = ort_checked_product(symbol_count, nlist_size);
    if (!ort_symbol_count_is_storable(symbol_count)) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
            "Mach-O symbol count exceeds supported allocation bounds");
    }
    if (symbol_bytes == null ||
        !ort_range_valid(len_s(bytes), symbol_offset, symbol_bytes as int) ||
        string_size <= 0 ||
        !ort_range_valid(len_s(bytes), string_offset, string_size) ||
        (char_at_s(bytes, string_offset) as int) != 0) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "Mach-O symbol or string table is out of bounds");
    }
    if (ort_ranges_overlap(symbol_offset, symbol_bytes as int,
                           string_offset, string_size) ||
        ort_ranges_overlap(symbol_offset, symbol_bytes as int,
                           0, command_end) ||
        ort_ranges_overlap(string_offset, string_size,
                           0, command_end)) {
        ort_sections_free(sections);
        return ort_container_error(container, OBJECT_READ_CORRUPT,
            "Mach-O symbol, string, and file-header tables overlap");
    }
    for (let section_i2 = 0; section_i2 < vec_size(sections);
         section_i2 = section_i2 + 1) {
        let section = ort_ptr_vec_get(
            sections, section_i2) as ObjectReaderSection*;
        if (section.file_backed &&
            (ort_ranges_overlap(section.file_offset, section.size,
                                symbol_offset, symbol_bytes as int) ||
             ort_ranges_overlap(section.file_offset, section.size,
                                string_offset, string_size))) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O section data overlaps the symbol or string table");
        }
    }

    for (let symbol_i = 0; symbol_i < symbol_count; symbol_i = symbol_i + 1) {
        let base = symbol_offset + symbol_i * nlist_size;
        let name_offset = ort_read_u32(bytes, base, little);
        let symbol_type = ort_read_u8(bytes, base + 4);
        let section_number = ort_read_u8(bytes, base + 5);
        if (name_offset == null || symbol_type == null || section_number == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "truncated Mach-O symbol entry");
        }
        let name = ort_read_c_string(bytes, string_offset, string_size,
                                     name_offset as int);
        if (name == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O symbol name is out of range or unterminated");
        }
        let is_stab = (symbol_type as int) / 32 != 0;
        let is_external = (symbol_type as int) % 2 == 1;
        let type_code = ((symbol_type as int) / 2) % 8;
        if (is_stab || !is_external) {
            continue;
        }

        let value_size = 4;
        if (is_64) {
            value_size = 8;
        }
        let value_offset = base + 8;
        let value_nonzero = ormacho_field_is_nonzero(bytes, value_offset, value_size);
        if (value_nonzero == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "truncated Mach-O symbol value");
        }
        let is_defined = type_code != ORMACHO_N_TYPE_PBUD &&
            (type_code != ORMACHO_N_TYPE_UNDF || (value_nonzero as bool));
        if (!is_defined) {
            continue;
        }
        if (len_s(name as string) == 0) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "defined external Mach-O symbol has an empty name");
        }
        let normalized = ort_strip_one_underscore(name as string);
        if (type_code != ORMACHO_N_TYPE_SECT) {
            ort_container_add_symbol(container, normalized, 0, 0, -1, false);
            continue;
        }
        if ((section_number as int) <= 0 ||
            (section_number as int) > vec_size(sections)) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O symbol section ordinal is out of range");
        }
        let section = ort_ptr_vec_get(
            sections, (section_number as int) - 1) as ObjectReaderSection*;
        let value: int? = null;
        if (is_64) {
            value = ort_read_u64_int(bytes, value_offset, little);
        } else {
            value = ort_read_u32(bytes, value_offset, little);
        }
        if (value == null) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_UNSUPPORTED,
                "Mach-O symbol address exceeds supported integer bounds");
        }
        if ((value as int) < section.address) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O symbol address precedes its section");
        }
        let relative = (value as int) - section.address;
        if (relative > section.size) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O symbol address lies outside its section");
        }
        let available = section.size - relative;
        if (!section.file_backed) {
            ort_container_add_symbol(container, normalized, 0, available, -1, false);
            continue;
        }
        if (!ort_range_valid(len_s(bytes), section.file_offset, section.size) ||
            relative > len_s(bytes) - section.file_offset) {
            ort_sections_free(sections);
            return ort_container_error(container, OBJECT_READ_CORRUPT,
                "Mach-O symbol file location is out of bounds");
        }
        ort_container_add_symbol(container, normalized,
            section.file_offset + relative, available, -1, true);
    }
    ort_sections_free(sections);
    return ort_read_ok(container);
}
