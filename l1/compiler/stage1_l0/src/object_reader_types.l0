module object_reader_types;

import std.integer;
import std.string;
import std.vector;

/** Supported relocatable-object containers. */
enum ObjectFormat {
    OBJECT_FORMAT_ELF;
    OBJECT_FORMAT_MACHO;
    OBJECT_FORMAT_PECOFF;
}

/** Format-specific carriers that can add implicit final-link controls. */
enum ObjectLinkerControlKind {
    OBJECT_LINKER_CONTROL_NONE;
    OBJECT_LINKER_CONTROL_ELF_DEPENDENT_LIBRARIES;
    OBJECT_LINKER_CONTROL_MACHO_LINKER_OPTION;
    OBJECT_LINKER_CONTROL_PECOFF_DRECTVE;
}

/** Failures outside the Dea metadata classification tri-state. */
enum ObjectReadErrorKind {
    OBJECT_READ_IO;
    OBJECT_READ_UNSUPPORTED;
    OBJECT_READ_CORRUPT;
}

/** A typed object-container read failure. */
struct ObjectReadError {
    kind: ObjectReadErrorKind;
    message: string;
}

/**
 * One normalized externally defined symbol.
 *
 * `file_offset` and `available_size` describe the bytes from the symbol to the
 * end of its containing file-backed section.  `declared_size` is `-1` when the
 * container does not provide a useful symbol size.  An externally defined
 * absolute/common/zero-fill symbol is retained with `data_resolved == false`.
 */
struct ObjectDefinedSymbol {
    name: string;
    file_offset: int;
    available_size: int;
    declared_size: int;
    data_resolved: bool;
}

/** Format-neutral output of a container adapter. */
struct ObjectContainer {
    format: ObjectFormat;
    bytes: string;
    defined_symbols: VectorBase*; /* ObjectDefinedSymbol*, duplicates retained */
    linker_control: ObjectLinkerControlKind;
}

/** Adapter result; exactly one of `container` and `error` is non-null. */
struct ObjectContainerReadResult {
    container: ObjectContainer*?;
    error: ObjectReadError*?;
}

/** Internal file-backed section descriptor shared by adapters. */
struct ObjectReaderSection {
    file_offset: int;
    size: int;
    address: int;
    file_backed: bool;
}

/** Create a pointer vector without importing compiler AST helpers. */
func ort_ptr_vec_create(initial_capacity: int) -> VectorBase* {
    return vec_create(sizeof(void*), initial_capacity);
}

/** Append one pointer to a pointer vector. */
func ort_ptr_vec_push(self: VectorBase*, value: void*) {
    vec_push_ptr(self, value);
}

/** Read one pointer from a pointer vector. */
func ort_ptr_vec_get(self: VectorBase*, index: int) -> void* {
    return *(vec_get(self, index) as void**);
}

/** Free a vector of owned section descriptors. */
func ort_sections_free(sections: VectorBase*) {
    for (let i = 0; i < vec_size(sections); i = i + 1) {
        let section = ort_ptr_vec_get(sections, i) as ObjectReaderSection*;
        drop section;
    }
    vec_free(sections);
}

/** Free a vector of owned symbol descriptors. */
func ort_symbols_free(symbols: VectorBase*) {
    for (let i = 0; i < vec_size(symbols); i = i + 1) {
        let symbol = ort_ptr_vec_get(symbols, i) as ObjectDefinedSymbol*;
        drop symbol;
    }
    vec_free(symbols);
}

/** Free a successfully read container. */
func object_container_free(self: ObjectContainer*) {
    ort_symbols_free(self.defined_symbols);
    drop self;
}

/** Free a typed read error. */
func object_read_error_free(self: ObjectReadError*) {
    drop self;
}

/** Free an adapter result and whichever payload it owns. */
func object_container_read_result_free(self: ObjectContainerReadResult*) {
    if (self.container != null) {
        object_container_free(self.container as ObjectContainer*);
    }
    if (self.error != null) {
        object_read_error_free(self.error as ObjectReadError*);
    }
    drop self;
}

/** Construct an adapter success. */
func ort_read_ok(container: ObjectContainer*) -> ObjectContainerReadResult* {
    return new ObjectContainerReadResult(container, null);
}

/** Construct an adapter failure. */
func ort_read_error(kind: ObjectReadErrorKind, message: string) -> ObjectContainerReadResult* {
    return new ObjectContainerReadResult(null, new ObjectReadError(kind, message));
}

/** Free a partial container, then construct an adapter failure. */
func ort_container_error(container: ObjectContainer*, kind: ObjectReadErrorKind,
                         message: string) -> ObjectContainerReadResult* {
    object_container_free(container);
    return ort_read_error(kind, message);
}

/** Create an empty format-neutral container retaining the original bytes. */
func ort_container_create(format: ObjectFormat, bytes: string) -> ObjectContainer* {
    return new ObjectContainer(
        format, bytes, ort_ptr_vec_create(16), OBJECT_LINKER_CONTROL_NONE);
}

/** Append one externally defined symbol without coalescing duplicates. */
func ort_container_add_symbol(container: ObjectContainer*, name: string,
                              file_offset: int, available_size: int,
                              declared_size: int, data_resolved: bool) {
    ort_ptr_vec_push(container.defined_symbols,
        new ObjectDefinedSymbol(name, file_offset, available_size,
                                declared_size, data_resolved) as void*);
}

/** Exact normalized defined-symbol query. */
func object_container_defines_symbol(container: ObjectContainer*, name: string) -> bool {
    for (let i = 0; i < vec_size(container.defined_symbols); i = i + 1) {
        let symbol = ort_ptr_vec_get(container.defined_symbols, i) as ObjectDefinedSymbol*;
        if (symbol.name == name) {
            return true;
        }
    }
    return false;
}

/**
 * Check a half-open byte range without first adding its endpoints.
 */
func ort_range_valid(total: int, offset: int, size: int) -> bool {
    return total >= 0 && offset >= 0 && size >= 0 &&
        offset <= total && size <= total - offset;
}

/** Check whether two already-valid non-empty half-open ranges overlap. */
func ort_ranges_overlap(left_offset: int, left_size: int,
                        right_offset: int, right_size: int) -> bool {
    if (left_size <= 0 || right_size <= 0) {
        return false;
    }
    if (left_offset <= right_offset) {
        return right_offset - left_offset < left_size;
    }
    return left_offset - right_offset < right_size;
}

/** Checked non-negative multiplication. */
func ort_checked_product(left: int, right: int) -> int? {
    if (left < 0 || right < 0) {
        return null;
    }
    return checked_mul_int(left, right);
}

/**
 * Bound a prospective pointer-vector population including its next growth
 * step.  The shared vector doubles capacity, so two pointer slots per possible
 * element must remain representable.
 */
func ort_symbol_count_is_storable(count: int) -> bool {
    return count >= 0 &&
        checked_mul_int(count, 2 * sizeof(void*)) != null;
}

/** Read one byte from a bounded offset. */
func ort_read_u8(bytes: string, offset: int) -> int? {
    if (!ort_range_valid(len_s(bytes), offset, 1)) {
        return null;
    }
    return char_at_s(bytes, offset) as int;
}

/** Read one endian-selected unsigned 16-bit integer. */
func ort_read_u16(bytes: string, offset: int, little_endian: bool) -> int? {
    if (!ort_range_valid(len_s(bytes), offset, 2)) {
        return null;
    }
    let first = char_at_s(bytes, offset) as int;
    let second = char_at_s(bytes, offset + 1) as int;
    if (little_endian) {
        return first + second * 256;
    }
    return first * 256 + second;
}

/**
 * Read one endian-selected unsigned 32-bit integer representable as `int`.
 */
func ort_read_u32(bytes: string, offset: int, little_endian: bool) -> int? {
    if (!ort_range_valid(len_s(bytes), offset, 4)) {
        return null;
    }
    let b0 = char_at_s(bytes, offset) as int;
    let b1 = char_at_s(bytes, offset + 1) as int;
    let b2 = char_at_s(bytes, offset + 2) as int;
    let b3 = char_at_s(bytes, offset + 3) as int;
    let high = b3;
    if (!little_endian) {
        high = b0;
    }
    if (high >= 128) {
        return null;
    }
    if (little_endian) {
        return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216;
    }
    return b3 + b2 * 256 + b1 * 65536 + b0 * 16777216;
}

/** Return whether a bounded four-byte unsigned field is nonzero. */
func ort_u32_is_nonzero(bytes: string, offset: int) -> bool? {
    if (!ort_range_valid(len_s(bytes), offset, 4)) {
        return null;
    }
    for (let i = 0; i < 4; i = i + 1) {
        if ((char_at_s(bytes, offset + i) as int) != 0) {
            return true;
        }
    }
    return false;
}

/**
 * Read one endian-selected unsigned 64-bit integer representable as `int`.
 *
 * The bootstrap language intentionally exposes no unsigned 64-bit scalar.
 * Values with any nonzero high-half byte are therefore unsupported.
 */
func ort_read_u64_int(bytes: string, offset: int, little_endian: bool) -> int? {
    if (!ort_range_valid(len_s(bytes), offset, 8)) {
        return null;
    }
    let high_offset = offset + 4;
    let low_offset = offset;
    if (!little_endian) {
        high_offset = offset;
        low_offset = offset + 4;
    }
    for (let i = 0; i < 4; i = i + 1) {
        if ((char_at_s(bytes, high_offset + i) as int) != 0) {
            return null;
        }
    }
    return ort_read_u32(bytes, low_offset, little_endian);
}

/** Read one endian-selected signed 16-bit integer. */
func ort_read_i16(bytes: string, offset: int, little_endian: bool) -> int? {
    let value = ort_read_u16(bytes, offset, little_endian);
    if (value == null) {
        return null;
    }
    if ((value as int) >= 32768) {
        return (value as int) - 65536;
    }
    return value;
}

/**
 * Read a NUL-terminated byte string inside one bounded table.
 */
func ort_read_c_string(bytes: string, table_offset: int, table_size: int,
                       relative_offset: int) -> string? {
    if (!ort_range_valid(len_s(bytes), table_offset, table_size) ||
        relative_offset < 0 || relative_offset >= table_size) {
        return null;
    }
    let start = table_offset + relative_offset;
    let end = table_offset + table_size;
    for (let cursor = start; cursor < end; cursor = cursor + 1) {
        if ((char_at_s(bytes, cursor) as int) == 0) {
            return slice_s(bytes, start, cursor);
        }
    }
    return null;
}

/** Return whether bytes at an offset equal one exact byte string. */
func ort_bytes_equal(bytes: string, offset: int, expected: string) -> bool {
    if (!ort_range_valid(len_s(bytes), offset, len_s(expected))) {
        return false;
    }
    for (let i = 0; i < len_s(expected); i = i + 1) {
        if (char_at_s(bytes, offset + i) != char_at_s(expected, i)) {
            return false;
        }
    }
    return true;
}

/** Strip exactly one ABI-added leading underscore. */
func ort_strip_one_underscore(name: string) -> string {
    if (len_s(name) > 0 && char_at_s(name, 0) == '_') {
        return slice_s(name, 1, len_s(name));
    }
    return name;
}
