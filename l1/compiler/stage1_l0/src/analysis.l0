/**
 * Copies diagnostic messages from the driver state to a diagnostic collector.
 *
 * @param dst The destination diagnostic collector.
 * @param src The source driver state containing diagnostics.
 */
func analysis_copy_driver_diags(dst: DiagCollector*, src: DriverState*) {
    for (let i = 0; i < driver_diag_count(src); i = i + 1) {
        diag_copy(dst, driver_diag_get(src, i));
    }
}

/**
 * Format the Stage 1-style signature-resolution summary text.
 *
 * @param sigs Resolved signature tables.
 * @return Summary string for verbose logging.
 */
func analysis_signature_summary(sigs: SignatureTables*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        sb_append(sb, "Signature resolution found ");
        sb_append(sb, int_to_string(spm_size(sigs.func_types)));
        sb_append(sb, " function(s), ");
        sb_append(sb, int_to_string(spm_size(sigs.struct_infos)));
        sb_append(sb, " struct(s), ");
        sb_append(sb, int_to_string(spm_size(sigs.enum_infos)));
        sb_append(sb, " enum(s), ");
        sb_append(sb, int_to_string(spm_size(sigs.let_types)));
        sb_append(sb, " top-level binding(s)");
        return sb_to_string(sb);
    }
}

/**
 * Run semantic analysis over an already resolved driver state.
 *
 * @param driver_state Owned resolved driver state.
 * @param cfg Logging configuration.
 * @return The complete analysis result including semantic context.
 */
func analysis_analyze_driver_state(driver_state: DriverState*, cfg: LogConfig*) -> AnalysisResult* {
    let result = new AnalysisResult(
        driver_state,
        diag_create(),
        null,
        null,
        null,
        spm_create(),
        sim_create(),
        spm_create()
    );
    analysis_copy_driver_diags(result.diags, driver_state);

    if (driver_has_errors(driver_state)) {
        return result;
    }

    log_stage(cfg, "Resolving module-level names", "");
    let nr_diag_start = diag_count(result.diags);
    let names = nr_resolve(driver_state, result.diags);
    result.names = names;
    log_debug(cfg, "Name resolution produced " + int_to_string(diag_count(result.diags) - nr_diag_start) + " diagnostic(s)");

    log_stage(cfg, "Resolving type signatures", "");
    let sigs = sig_resolve(driver_state, names, result.diags);
    result.signatures = sigs;
    log_debug(cfg, analysis_signature_summary(sigs));

    log_stage(cfg, "Resolving local scopes", "");
    let local_envs = locals_resolve(driver_state, result.diags);
    result.locals_result = local_envs;
    log_debug(cfg, "Local scope resolution processed " + int_to_string(locals_env_count(local_envs)) + " function(s)");

    log_stage(cfg, "Type-checking expressions", "");
    let expr_diag_start = diag_count(result.diags);
    expr_types_check(result);
    log_debug(cfg, "Expression type checking produced " + int_to_string(diag_count(result.diags) - expr_diag_start) + " diagnostic(s)");
    log_info(cfg, "Analysis complete: " + int_to_string(analysis_diag_count(result)) + " total diagnostic(s), " + int_to_string(result.diags.error_count) + " error(s)");

    return result;
}

/**
 * Analyzes the entry module and its source-fallback dependencies.
 *
 * @param search_paths The source search paths configuration.
 * @param entry_module The name of the entry module.
 * @param cfg The logging configuration.
 * @return The complete analysis result including semantic context.
 */
func analysis_analyze_entry(search_paths: SourceSearchPaths*, entry_module: string, cfg: LogConfig*) -> AnalysisResult* {
    return analysis_analyze_driver_state(driver_analyze_entry(search_paths, entry_module, cfg), cfg);
}

/**
 * Analyze an entry through ordered filesystem-interface resolution.
 *
 * @param search_paths Source search paths used for source fallback.
 * @param entry_module Canonical source entry module.
 * @param interface_roots Ordered filesystem interface roots.
 * @param policy Missing-interface policy for imported modules.
 * @param artifact_root Optional artifact root associated with source nodes.
 * @param cfg Logging configuration.
 * @return Complete analysis result including the resolved module graph.
 */
func analysis_analyze_entry_with_resolution(search_paths: SourceSearchPaths*, entry_module: string,
                                            interface_roots: StringVector*, policy: ModuleResolutionPolicy,
                                            artifact_root: string?, cfg: LogConfig*) -> AnalysisResult* {
    let driver_state = driver_analyze_entry_with_resolution(
        search_paths,
        entry_module,
        interface_roots,
        policy,
        artifact_root,
        cfg
    );
    return analysis_analyze_driver_state(driver_state, cfg);
}

/**
 * Analyzes the entry module with a supplied direct-provider interface registry.
 *
 * @param search_paths The source search paths configuration.
 * @param entry_module The name of the entry module.
 * @param interfaces Borrowed vector of `ModuleInterface*` direct-provider candidates.
 * @param cfg The logging configuration.
 * @return The complete analysis result including semantic context.
 */
func analysis_analyze_entry_with_interfaces(search_paths: SourceSearchPaths*, entry_module: string,
                                            interfaces: VectorBase*?, cfg: LogConfig*) -> AnalysisResult* {
    let driver_state = driver_analyze_entry_with_interfaces(search_paths, entry_module, interfaces, cfg);
    return analysis_analyze_driver_state(driver_state, cfg);
}

/**
 * Emit the `.l1m` module interface text for an analyzed module.
 *
 * Returns `null` if the analysis result lacks name-resolution or signature
 * tables. Callers should check `analysis_has_errors` before calling this
 * function.
 *
 * @param result Analysis result to emit the interface for.
 * @param module_name Module whose interface to emit.
 * @return Canonical `.l1m` text, or `null` if projection fails.
 */
func analysis_emit_interface(result: AnalysisResult*, module_name: string) -> string? {
    let mi = mi_project(result, module_name);
    if (mi == null) {
        return null;
    }
    let text = ie_emit(mi as ModuleInterface*);
    mi_free(mi as ModuleInterface*);
    return text;
}

/**
 * Abort on an internal interface-projection error from a string-returning
 * helper.
 *
 * @param message ICE message to report.
 * @return Dummy return used only to satisfy control-flow typing.
 */
func mi_ice_string(message: string) -> string {
    assert(false, message);
    return "";
}

/**
 * Build the qualified name string for a var-ref expression.
 *
 * @param node Expression node of kind EX_VAR_REF.
 * @return Qualified name as a string.
 */
func mi_var_ref_name(node: ExprNode*) -> string {
    if (node.module_path == null) {
        return node.text_value;
    }
    let path = node.module_path as StringVector*;
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(path); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ".");
            }
            sb_append(sb, sv_get(path, i));
        }
        sb_append(sb, "::");
        sb_append(sb, node.text_value);
        return sb_to_string(sb);
    }
}

/**
 * Build the canonical interface spelling for one resolved variable reference.
 *
 * Cross-module names use the provider's canonical module identity regardless
 * of whether source lookup used an open, selective, or aliased import.
 * Enum-variant literals retain the variant symbol itself; dependency manifests
 * normalize that symbol separately to the owning enum. Same-module references
 * remain unqualified.
 *
 * @param nr Name-resolution data used to resolve provider identity.
 * @param env Module environment owning the expression.
 * @param node Expression node of kind EX_VAR_REF.
 * @return Canonical literal symbol spelling.
 */
func mi_resolved_var_ref_name(nr: NameResolution*, env: ModuleEnv*, node: ExprNode*) -> string {
    let sym_opt = tr_symbol_lookup(nr, env, node.text_value, node.module_path, node.name_qualifier);
    if (sym_opt == null) {
        return mi_var_ref_name(node);
    }
    let sym = sym_opt as Symbol*;
    if (!nr_is_cross_module_symbol(env.module_name, sym)) {
        return sym.name;
    }
    return sym.module_name + "::" + sym.name;
}

/**
 * Return whether an expression is a supported cast wrapped in parentheses.
 *
 * @param arena Expression arena.
 * @param expr_id Expression to inspect.
 * @return `true` when the expression's outer value is a cast.
 */
func mi_expr_is_const_cast(arena: ExprArena*, expr_id: ExprId) -> bool {
    let node = expr_arena_get(arena, expr_id);
    if (ord(node.kind) == ord(EX_PAREN)) {
        return mi_expr_is_const_cast(arena, node.expr_a);
    }
    return ord(node.kind) == ord(EX_CAST);
}

/**
 * Format an evaluated scalar constant as a canonical interface literal.
 *
 * @param value Evaluated constant value.
 * @return Target-typed literal spelling.
 */
func mi_format_const_value(value: ConstValue*) -> string {
    match (value.kind) {
        CV_INT => { return int_to_string(value.int_value); }
        CV_OTHER_INT => { return int_to_string(value.int_value); }
        CV_BIGINT => { return bigint_to_string(value.text_value, value.base_value); }
        CV_BYTE => { return int_to_string(value.int_value); }
        CV_BOOL => {
            if (value.bool_value) return "true";
            return "false";
        }
        CV_STRING => { return "\"" + se_encode_c_string_bytes(value.text_value) + "\""; }
        CV_FLOAT => { return value.text_value; }
        CV_DOUBLE => { return value.text_value; }
        CV_NULL => { return "null"; }
    }
}

/**
 * Recursive literal formatter operating on an already-resolved arena.
 *
 * @param nr Name-resolution data used to canonicalize provider identities.
 * @param env Module environment owning the expression.
 * @param arena Expression arena.
 * @param expr_id Expression to format.
 * @return Canonical literal text.
 */
func mi_format_literal_in(nr: NameResolution*, env: ModuleEnv*, arena: ExprArena*, expr_id: ExprId) -> string {
    let node = expr_arena_get(arena, expr_id);
    match (node.kind) {
        EX_INT => {
            return int_to_string(node.int_value);
        }
        EX_BIGINT => {
            return bigint_to_string(node.text_value, node.base_value);
        }
        EX_FLOAT => {
            return node.text_value;
        }
        EX_DOUBLE => {
            return node.text_value;
        }
        EX_BYTE => {
            return node.text_value;
        }
        EX_STRING => {
            return "\"" + se_encode_c_string_bytes(node.text_value) + "\"";
        }
        EX_BOOL => {
            if (node.bool_value) {
                return "true";
            }
            return "false";
        }
        EX_NULL => {
            return "null";
        }
        EX_VAR_REF => {
            return mi_resolved_var_ref_name(nr, env, node);
        }
        EX_ARRAY_LITERAL => {
            with (let sb2 = sb_create() => sb_free(sb2)) {
                sb_append(sb2, "[");
                let ids2 = node.ids as VectorBase*;
                for (let j = 0; j < vec_size(ids2); j = j + 1) {
                    if (j > 0) {
                        sb_append(sb2, ", ");
                    }
                    sb_append(sb2, mi_format_literal_in(nr, env, arena, id_vec_get(ids2, j)));
                }
                sb_append(sb2, "]");
                return sb_to_string(sb2);
            }
        }
        EX_CALL => {
            let callee = expr_arena_get(arena, node.expr_a);
            let callee_name = mi_resolved_var_ref_name(nr, env, callee);
            if (node.ids == null || vec_size(node.ids as VectorBase*) == 0) {
                return callee_name + "()";
            }
            with (let sb = sb_create() => sb_free(sb)) {
                sb_append(sb, callee_name);
                sb_append(sb, "(");
                let ids = node.ids as VectorBase*;
                for (let i = 0; i < vec_size(ids); i = i + 1) {
                    if (i > 0) {
                        sb_append(sb, ", ");
                    }
                    sb_append(sb, mi_format_literal_in(nr, env, arena, id_vec_get(ids, i)));
                }
                sb_append(sb, ")");
                return sb_to_string(sb);
            }
        }
        _ => {
            return mi_ice_string("[ICE-1400] mi_format_literal_in: unsupported expression kind in interface const literal");
        }
    }
}

/**
 * Format a compile-time-constant expression as its canonical literal text.
 *
 * @param driver_state Driver state holding parsed ASTs.
 * @param nr Name-resolution data used to canonicalize provider identities.
 * @param env Module environment owning the expression.
 * @param module_name Module owning the expression.
 * @param expr_id Expression to format.
 * @return Canonical literal text.
 */
func mi_format_literal(driver_state: DriverState*, nr: NameResolution*, env: ModuleEnv*, module_name: string,
                       expr_id: ExprId) -> string {
    let unit = driver_find_unit(driver_state, module_name) as DriverUnit*;
    let pr = unit.parse_result;
    let arena = pr.expr_arena;
    return mi_format_literal_in(nr, env, arena, expr_id);
}

/**
 * Return whether a dependency vector already contains one canonical symbol.
 *
 * @param entries Vector of `InterfaceDepEntry*` values.
 * @param provider_module Canonical provider module name.
 * @param symbol_name Canonical provider symbol name.
 * @return `true` when the dependency is already present.
 */
func mi_has_dep(entries: VectorBase*, provider_module: string, symbol_name: string) -> bool {
    for (let i = 0; i < vec_size(entries); i = i + 1) {
        let entry = ptr_vec_get(entries, i) as InterfaceDepEntry*;
        if (entry.provider_module == provider_module && entry.symbol_name == symbol_name) {
            return true;
        }
    }
    return false;
}

/**
 * Add one canonical dependency entry with its provider-wide fingerprint.
 *
 * @param result Analysis result providing selected provider metadata.
 * @param this_module Module being projected.
 * @param provider_module Canonical provider module name.
 * @param symbol_name Canonical provider symbol name.
 * @param out Destination vector of `InterfaceDepEntry*` values.
 */
func mi_add_dep(result: AnalysisResult*, this_module: string, provider_module: string,
                symbol_name: string, out: VectorBase*) {
    if (provider_module == this_module || dea_is_virtual_module_name(provider_module) ||
        mi_has_dep(out, provider_module, symbol_name)) {
        return;
    }
    let fingerprint = driver_provider_fingerprint(result.driver_state, provider_module);
    ptr_vec_push(out, new InterfaceDepEntry(provider_module, symbol_name, fingerprint) as void*);
}

/**
 * Add one resolved symbol as a canonical dependency entry.
 *
 * @param result Analysis result providing selected provider metadata.
 * @param this_module Module being projected.
 * @param sym Resolved provider-owned symbol.
 * @param out Destination vector of `InterfaceDepEntry*` values.
 */
func mi_add_symbol_dep(result: AnalysisResult*, this_module: string, sym: Symbol*, out: VectorBase*) {
    if (!nr_is_cross_module_symbol(this_module, sym)) {
        return;
    }
    mi_add_dep(result, this_module, sym.module_name, nr_dependency_symbol_name(sym), out);
}

/**
 * Collect cross-module nominal type references reachable from a resolved type tree.
 *
 * This fallback is used only for inferred public binding types, for which no
 * parsed `TypeRef` exists. Explicit public types are walked from their parsed
 * form so imported type-alias identities are preserved.
 *
 * @param result Analysis result providing selected provider metadata.
 * @param ty Type tree to inspect.
 * @param this_module Dotted name of the module being projected.
 * @param out Destination vector of `InterfaceDepEntry*`.
 */
func mi_collect_type_refs(result: AnalysisResult*, ty: Type*, this_module: string, out: VectorBase*) {
    let kind = ord(ty.kind);
    if (kind == ord(TY_STRUCT) || kind == ord(TY_ENUM)) {
        if (ty.module_name != "" && ty.module_name != this_module) {
            mi_add_dep(result, this_module, ty.module_name, ty.name, out);
        }
        return;
    }
    if (kind == ord(TY_POINTER) || kind == ord(TY_NULLABLE) || kind == ord(TY_ARRAY) ||
        kind == ord(TY_SLICE)) {
        mi_collect_type_refs(result, ty.inner as Type*, this_module, out);
        return;
    }
    if (kind == ord(TY_FUNC)) {
        let params = ty.params as VectorBase*;
        for (let i = 0; i < vec_size(params); i = i + 1) {
            mi_collect_type_refs(result, ptr_vec_get(params, i) as Type*, this_module, out);
        }
        mi_collect_type_refs(result, ty.result as Type*, this_module, out);
    }
}

/**
 * Collect public dependencies from one parsed type reference.
 *
 * Imported aliases are recorded by alias identity instead of being replaced
 * by their resolved nominal target. Same-module aliases are followed so a
 * private helper alias cannot hide a public cross-module dependency.
 *
 * @param result Analysis result providing semantic and provider metadata.
 * @param nr Name-resolution tables.
 * @param env Module environment owning the parsed reference.
 * @param tref Parsed type reference to walk.
 * @param this_module Module being projected.
 * @param out Destination `require` vector.
 * @param seen_aliases Same-module aliases currently being expanded.
 */
func mi_collect_public_type_ref_in(result: AnalysisResult*, nr: NameResolution*, env: ModuleEnv*, tref: TypeRef*,
                                   this_module: string, out: VectorBase*, seen_aliases: StringSet*) {
    if (tref.func_params != null) {
        let params = tref.func_params as VectorBase*;
        for (let i = 0; i < vec_size(params); i = i + 1) {
            mi_collect_public_type_ref_in(result, nr, env, ptr_vec_get(params, i) as TypeRef*, this_module, out,
                seen_aliases);
        }
        if (tref.func_result != null) {
            mi_collect_public_type_ref_in(result, nr, env, tref.func_result as TypeRef*, this_module, out,
                seen_aliases);
        }
    } else if (!(tref.module_path == null && type_is_builtin_name(tref.name))) {
        let sym_opt = tr_symbol_lookup(nr, env, tref.name, tref.module_path, null);
        if (sym_opt != null) {
            let sym = sym_opt as Symbol*;
            if (nr_is_cross_module_symbol(this_module, sym)) {
                mi_add_symbol_dep(result, this_module, sym, out);
            } else if (sym.module_name == this_module && ord(sym.kind) == ord(SYM_TYPE_ALIAS) &&
                       sym.decl_ptr != null) {
                let alias_key = sym.module_name + "::" + sym.name;
                if (!ss_has(seen_aliases, alias_key)) {
                    ss_add(seen_aliases, alias_key);
                    let alias_decl = sym.decl_ptr as TypeAliasDecl*;
                    mi_collect_public_type_ref_in(result, nr, env, alias_decl.target, this_module, out,
                        seen_aliases);
                    ss_remove(seen_aliases, alias_key);
                }
            }
        }
    }

    if (tref.suffixes != null) {
        let suffixes = tref.suffixes as VectorBase*;
        let unit = driver_find_unit(result.driver_state, this_module);
        if (unit != null) {
            let arena = (unit as DriverUnit*).parse_result.expr_arena;
            for (let suffix_i = 0; suffix_i < vec_size(suffixes); suffix_i = suffix_i + 1) {
                let suffix = ptr_vec_get(suffixes, suffix_i) as TypeSuffix*;
                if (suffix.array_len_expr >= 0) {
                    mi_collect_value_refs(result, nr, env, arena, suffix.array_len_expr, this_module, out);
                }
            }
        }
    }
}

/**
 * Collect public dependencies from one parsed type reference.
 *
 * @param result Analysis result providing semantic and provider metadata.
 * @param nr Name-resolution tables.
 * @param env Module environment owning the parsed reference.
 * @param tref Parsed type reference to walk.
 * @param this_module Module being projected.
 * @param out Destination `require` vector.
 */
func mi_collect_public_type_ref(result: AnalysisResult*, nr: NameResolution*, env: ModuleEnv*, tref: TypeRef*,
                                this_module: string, out: VectorBase*) {
    with (let seen_aliases = ss_create() => ss_free(seen_aliases)) {
        mi_collect_public_type_ref_in(result, nr, env, tref, this_module, out, seen_aliases);
    }
}

/**
 * Collect cross-module symbol references reachable from a constant-value
 * expression tree.
 *
 * @param result Analysis result providing selected provider metadata.
 * @param nr Name resolution for symbol lookups.
 * @param env Owning module environment.
 * @param arena Expression arena owning the value tree.
 * @param expr_id Expression to inspect.
 * @param this_module Dotted name of the module being projected.
 * @param out Destination vector of `InterfaceDepEntry*`.
 */
func mi_collect_value_refs(result: AnalysisResult*, nr: NameResolution*, env: ModuleEnv*, arena: ExprArena*,
                           expr_id: ExprId, this_module: string, out: VectorBase*) {
    if (expr_id < 0) {
        return;
    }
    let node = expr_arena_get(arena, expr_id);
    if (ord(node.kind) == ord(EX_VAR_REF)) {
        let sym_opt = tr_symbol_lookup(nr, env, node.text_value, node.module_path, node.name_qualifier);
        if (sym_opt != null) {
            mi_add_symbol_dep(result, this_module, sym_opt as Symbol*, out);
        }
    }
    if (node.type_ref != null) {
        mi_collect_public_type_ref(result, nr, env, node.type_ref as TypeRef*, this_module, out);
    }
    if (node.expr_a >= 0) {
        mi_collect_value_refs(result, nr, env, arena, node.expr_a, this_module, out);
    }
    if (node.expr_b >= 0) {
        mi_collect_value_refs(result, nr, env, arena, node.expr_b, this_module, out);
    }
    if (node.expr_c >= 0) {
        mi_collect_value_refs(result, nr, env, arena, node.expr_c, this_module, out);
    }
    if (node.ids != null) {
        let ids = node.ids as VectorBase*;
        for (let i = 0; i < vec_size(ids); i = i + 1) {
            mi_collect_value_refs(result, nr, env, arena, id_vec_get(ids, i), this_module, out);
        }
    }
}

/**
 * Convenience wrapper around `mi_collect_value_refs` that looks up the
 * source unit's expression arena via the driver state.
 *
 * @param result Analysis result providing selected provider metadata.
 * @param nr Name resolution for symbol lookups.
 * @param env Owning module environment.
 * @param module_name Module owning the expression.
 * @param expr_id Expression to inspect.
 * @param out Destination vector of `InterfaceDepEntry*`.
 */
func mi_collect_value_refs_for(result: AnalysisResult*, nr: NameResolution*, env: ModuleEnv*,
                                module_name: string, expr_id: ExprId, out: VectorBase*) {
    let unit = driver_find_unit(result.driver_state, module_name) as DriverUnit*;
    let pr = unit.parse_result;
    mi_collect_value_refs(result, nr, env, pr.expr_arena, expr_id, module_name, out);
}

/**
 * Collect parameter names from a function symbol's declaration.
 *
 * @param sym Function symbol.
 * @return New StringVector containing the parameter names in declaration order.
 */
func mi_collect_param_names(sym: Symbol*) -> StringVector* {
    let names = sv_create(4);
    if (sym.decl_ptr == null) {
        return names;
    }
    let decl = sym.decl_ptr as FuncDecl*;
    for (let i = 0; i < vec_size(decl.params); i = i + 1) {
        let param = ptr_vec_get(decl.params, i) as Param*;
        sv_push(names, param.name);
    }
    return names;
}

/**
 * Project the exported surface of an analyzed module into a ModuleInterface.
 *
 * @param result Analysis result to project from.
 * @param module_name Module whose exports to project.
 * @return Projected interface, or `null` on guard failure.
 */
func mi_project(result: AnalysisResult*, module_name: string) -> ModuleInterface*? {
    if (result.names == null || result.signatures == null) {
        return null;
    }

    let active_interface = driver_find_projection_interface(result.driver_state, module_name);
    if (active_interface != null) {
        return miu_clone_interface(active_interface as ModuleInterface*);
    }

    let nr = result.names as NameResolution*;
    let sigs = result.signatures as SignatureTables*;

    let env_opt = nr_env_find(nr, module_name);
    if (env_opt == null) {
        return null;
    }
    let env = env_opt as ModuleEnv*;

    let require_entries = ptr_vec_create(4);
    let link_entries = ptr_vec_create(4);
    let struct_infos = ptr_vec_create(4);
    let enum_infos = ptr_vec_create(4);
    let alias_entries = ptr_vec_create(4);
    let func_entries = ptr_vec_create(8);
    let let_entries = ptr_vec_create(8);

    with (let keys = nr_module_env_export_keys(env) => sv_free(keys)) {
        sv_sort(keys);
        for (let i = 0; i < sv_size(keys); i = i + 1) {
            let key = sv_get(keys, i);
            let sym_opt = spm_get(env.exports, key);
            if (sym_opt == null) {
                continue;
            }
            let sym = sym_opt as Symbol*;

            match (sym.kind) {
                SYM_ENUM_VARIANT => {
                }
                SYM_TYPE_ALIAS => {
                    if (sym.resolved_type == null) {
                        continue;
                    }
                    let alias_ty = type_clone(sym.resolved_type as Type*);
                    assert(sym.decl_ptr != null, "source alias symbol must retain its declaration");
                    let alias_decl = sym.decl_ptr as TypeAliasDecl*;
                    mi_collect_public_type_ref(result, nr, env, alias_decl.target, module_name,
                        require_entries);
                    let entry = new InterfaceAliasEntry(key, alias_ty, "");
                    ptr_vec_push(alias_entries, entry as void*);
                }
                SYM_STRUCT => {
                    let info_opt = sig_lookup_struct_info(sigs, module_name, key);
                    if (info_opt == null) {
                        continue;
                    }
                    let cloned_struct = miu_clone_struct_info(info_opt as StructInfo*);
                    if (!cloned_struct.is_opaque) {
                        assert(sym.decl_ptr != null, "source struct symbol must retain its declaration");
                        let struct_decl = sym.decl_ptr as StructDecl*;
                        for (let fi = 0; fi < vec_size(struct_decl.fields); fi = fi + 1) {
                            let field_decl = ptr_vec_get(struct_decl.fields, fi) as FieldDecl*;
                            mi_collect_public_type_ref(result, nr, env, field_decl.type_ref, module_name,
                                require_entries);
                        }
                    }
                    ptr_vec_push(struct_infos, cloned_struct as void*);
                }
                SYM_ENUM => {
                    let info_opt = sig_lookup_enum_info(sigs, module_name, key);
                    if (info_opt == null) {
                        continue;
                    }
                    let cloned_enum = miu_clone_enum_info(info_opt as EnumInfo*);
                    if (!cloned_enum.is_opaque) {
                        assert(sym.decl_ptr != null, "source enum symbol must retain its declaration");
                        let enum_decl = sym.decl_ptr as EnumDecl*;
                        for (let vi = 0; vi < vec_size(enum_decl.variants); vi = vi + 1) {
                            let variant_decl = ptr_vec_get(enum_decl.variants, vi) as EnumVariant*;
                            for (let vfi = 0; vfi < vec_size(variant_decl.fields); vfi = vfi + 1) {
                                let field_decl2 = ptr_vec_get(variant_decl.fields, vfi) as FieldDecl*;
                                mi_collect_public_type_ref(result, nr, env, field_decl2.type_ref, module_name,
                                    require_entries);
                            }
                        }
                    }
                    ptr_vec_push(enum_infos, cloned_enum as void*);
                }
                SYM_FUNC => {
                    let ty_opt = sig_lookup_func_type(sigs, module_name, key);
                    if (ty_opt == null) {
                        continue;
                    }
                    let func_ty = type_clone(ty_opt as Type*);
                    assert(sym.decl_ptr != null, "source function symbol must retain its declaration");
                    let func_decl = sym.decl_ptr as FuncDecl*;
                    for (let pi = 0; pi < vec_size(func_decl.params); pi = pi + 1) {
                        let param = ptr_vec_get(func_decl.params, pi) as Param*;
                        mi_collect_public_type_ref(result, nr, env, param.type_ref, module_name,
                            require_entries);
                    }
                    mi_collect_public_type_ref(result, nr, env, func_decl.return_type, module_name,
                        require_entries);
                    let param_names = mi_collect_param_names(sym);
                    let entry = new InterfaceFuncEntry(key, param_names, func_ty, sym.is_extern, "");
                    ptr_vec_push(func_entries, entry as void*);
                }
                SYM_LET => {
                    let ty_opt = sig_lookup_let_type(sigs, module_name, key);
                    if (ty_opt == null) {
                        continue;
                    }
                    let let_ty = type_clone(ty_opt as Type*);
                    let decl = sym.decl_ptr as LetDecl*;
                    if (decl.type_ref != null) {
                        mi_collect_public_type_ref(result, nr, env, decl.type_ref as TypeRef*, module_name,
                            require_entries);
                    } else {
                        mi_collect_type_refs(result, let_ty, module_name, require_entries);
                    }
                    let is_const = decl.is_const;
                    let literal = "";
                    if (is_const) {
                        mi_collect_value_refs_for(result, nr, env, module_name, decl.value, require_entries);
                        let folded_scalar = false;
                        with (let ctx = tr_const_eval_context_create(result.driver_state, sigs, nr, result.diags) =>
                              tr_const_eval_context_free(ctx)) {
                            let value = tr_const_eval_expr(ctx, env, decl.value);
                            if (value != null) {
                                literal = mi_format_const_value(value as ConstValue*);
                                tr_const_value_free(value as ConstValue*);
                                folded_scalar = true;
                            }
                        }
                        if (!folded_scalar) {
                            literal = mi_format_literal(result.driver_state, nr, env, module_name, decl.value);
                        }
                    }
                    let entry = new InterfaceLetEntry(key, let_ty, is_const, literal, "");
                    ptr_vec_push(let_entries, entry as void*);
                }
            }
        }
    }

    for (let ref_i = 0; ref_i < nr_resolved_symbol_count(nr); ref_i = ref_i + 1) {
        let ref = nr_resolved_symbol_get(nr, ref_i);
        if (ref.consumer_module != module_name ||
            mi_has_dep(require_entries, ref.provider_module, ref.symbol_name)) {
            continue;
        }
        mi_add_dep(result, module_name, ref.provider_module, ref.symbol_name, link_entries);
    }

    return new ModuleInterface(module_name, "", require_entries, link_entries, struct_infos, enum_infos, alias_entries, func_entries, let_entries);
}
