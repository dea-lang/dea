module cli_args;

import std.io;
import std.string;
import std.text;
import std.vector;
import util.diag;
import build_info;
import source_paths;

/**
 * Defines the CliMode enumeration.
 */
enum CliMode {
    CM_RUN;
    CM_BUILD;
    CM_COMPILE;
    CM_LINK;
    CM_EMIT_INTERFACE;
    CM_GEN;
    CM_CHECK;
    CM_TOK;
    CM_AST;
    CM_SYM;
    CM_TYPE;
}

/**
 * Identifies how one standalone-link operand entered the CLI.
 */
enum LinkOperandKind {
    LOK_DEA_OBJECT;
    LOK_FOREIGN_OBJECT;
}

/**
 * Represents one ordered standalone-link input.
 */
struct LinkOperand {
    kind: LinkOperandKind;
    path: string;
}

/**
 * Represents the CliOptions structure.
 */
struct CliOptions {
    mode: CliMode;
    mode_explicit: bool;

    verbosity: int;
    log: bool;

    project_roots: StringVector*;
    sys_roots: StringVector*;
    interface_paths: StringVector*;

    output: string?;
    keep_c: bool;
    c_compiler: string?;
    c_options: string?;
    runtime_include: string?;
    runtime_lib: string?;

    no_line_directives: bool;
    trace_arc: bool;
    trace_memory: bool;
    unchecked: bool;
    check_basic: bool;

    all_modules: bool;
    include_eof: bool;

    link_operands: VectorBase*;
    entry_module: string?;

    entry_target: string?;
    extra_target_count: int;
    program_args: StringVector*;
}

/**
 * Create an empty vector of owned link operands.
 *
 * @return New ordered link-operand vector.
 */
func cli_link_operands_create() -> VectorBase* {
    return vec_create(sizeof(void*), 4);
}

/**
 * Append one owned link operand.
 *
 * @param operands Ordered link-operand vector.
 * @param kind Operand classification supplied by the CLI spelling.
 * @param path Operand path.
 */
func cli_link_operands_push(operands: VectorBase*, kind: LinkOperandKind, path: string) {
    vec_push_ptr(operands, new LinkOperand(kind, path) as void*);
}

/**
 * Return the number of ordered link operands.
 *
 * @param operands Link-operand vector to inspect.
 * @return Number of stored operands.
 */
func cli_link_operands_count(operands: VectorBase*) -> int {
    return vec_size(operands);
}

/**
 * Return one ordered link operand.
 *
 * @param operands Link-operand vector to inspect.
 * @param index Zero-based operand index.
 * @return Borrowed operand at `index`.
 */
func cli_link_operands_get(operands: VectorBase*, index: int) -> LinkOperand* {
    return (*(vec_get(operands, index) as void**)) as LinkOperand*;
}

/**
 * Free an ordered link-operand vector and its owned entries.
 *
 * @param operands Link-operand vector to free.
 */
func cli_link_operands_free(operands: VectorBase*) {
    for (let i = 0; i < vec_size(operands); i = i + 1) {
        let operand = cli_link_operands_get(operands, i);
        drop operand;
    }
    vec_free(operands);
}

/**
 * Represents the CliParseResult structure.
 */
struct CliParseResult {
    options: CliOptions*?;
    diags: DiagCollector*;
    help_requested: bool;
    version_requested: bool;
    verbosity: int;
    rich_log: bool;
}

/**
 * Create a `CliOptions` instance with default values.
 *
 * @return New CLI options object.
 */
func cli_options_create() -> CliOptions* {
    return new CliOptions(
        CM_BUILD,
        false,
        0,
        false,
        sv_create(2),
        sv_create(2),
        sv_create(2),
        null,
        false,
        null,
        null,
        null,
        null,
        false,
        false,
        false,
        false,
        false,
        false,
        false,
        cli_link_operands_create(),
        null,
        null,
        0,
        sv_create(4)
    );
}

/**
 * Free a `CliOptions` instance.
 *
 * @param self CLI options to free.
 */
func cli_options_free(self: CliOptions*) {
    sv_free(self.project_roots);
    sv_free(self.sys_roots);
    sv_free(self.interface_paths);
    cli_link_operands_free(self.link_operands);
    sv_free(self.program_args);
    drop self;
}

/**
 * Free a nullable `CliOptions` instance when present.
 *
 * @param self Optional CLI options to free.
 */
func cli_options_free_opt(self: CliOptions*?) {
    if (self != null) {
        cli_options_free(self as CliOptions*);
    }
}

/**
 * Free a nullable diagnostic collector when present.
 *
 * @param self Optional diagnostic collector to free.
 */
func cli_diag_free_opt(self: DiagCollector*?) {
    if (self != null) {
        diag_free(self as DiagCollector*);
    }
}

/**
 * Free a CLI parse result and any owned options.
 *
 * @param self Parse result to free.
 */
func cli_parse_result_free(self: CliParseResult*) {
    if (self.options != null) {
        cli_options_free(self.options as CliOptions*);
    }
    diag_free(self.diags);
    drop self;
}

/**
 * Emit a command-line diagnostic without source coordinates.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 */
func cli_emit_error(diags: DiagCollector*, code: string, message: string) {
    diag_error(diags, "l1c", code, message, "", 0, 0, 0, 0);
}

/**
 * Emit the standard diagnostic for a recognized canonical option whose
 * behavior is not implemented yet.
 *
 * @param diags Diagnostic collector.
 * @param option Canonical short option.
 * @param purpose Reserved option purpose.
 */
func cli_emit_reserved_option_error(diags: DiagCollector*, option: string, purpose: string) {
    cli_emit_error(
        diags,
        "L1C-2032",
        "option '" + option + "' is reserved for " + purpose + " and is not supported yet"
    );
}

/**
 * Return whether a diagnostic collector contains one diagnostic code.
 *
 * @param diags Diagnostic collector to inspect.
 * @param code Diagnostic code to find.
 * @return `true` when the code is present.
 */
func cli_has_diagnostic_code(diags: DiagCollector*, code: string) -> bool {
    for (let i = 0; i < diag_count(diags); i = i + 1) {
        if (diag_get(diags, i).code == code) {
            return true;
        }
    }
    return false;
}

/**
 * Emit a command-line warning without source coordinates.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 */
func cli_emit_warning(diags: DiagCollector*, code: string, message: string) {
    diag_warn(diags, "l1c", code, message, "", 0, 0, 0, 0);
}

/**
 * Return the user-facing compiler identity/version text.
 *
 * @return Stable compiler identity text for help and `--version`.
 */
func cli_compiler_identity_text() -> string {
    return "Dea language / L1 compiler (Stage 1)";
}

/**
 * Return the canonical long flag for a CLI mode.
 *
 * @param mode CLI mode to format.
 * @return Long-form flag such as `--check`.
 */
func cli_mode_flag(mode: CliMode) -> string {
    match (mode) {
        CM_RUN => { return "--run"; }
        CM_BUILD => { return "--build"; }
        CM_COMPILE => { return "--compile"; }
        CM_LINK => { return "--link"; }
        CM_EMIT_INTERFACE => { return "--emit-interface"; }
        CM_GEN => { return "--gen"; }
        CM_CHECK => { return "--check"; }
        CM_TOK => { return "--tok"; }
        CM_AST => { return "--ast"; }
        CM_SYM => { return "--sym"; }
        CM_TYPE => { return "--type"; }
    }
}

/**
 * Return the short display name for a CLI mode.
 *
 * @param mode CLI mode to format.
 * @return Short mode name such as `check`.
 */
func cli_mode_name(mode: CliMode) -> string {
    match (mode) {
        CM_RUN => { return "run"; }
        CM_BUILD => { return "build"; }
        CM_COMPILE => { return "compile"; }
        CM_LINK => { return "link"; }
        CM_EMIT_INTERFACE => { return "emit-interface"; }
        CM_GEN => { return "gen"; }
        CM_CHECK => { return "check"; }
        CM_TOK => { return "tok"; }
        CM_AST => { return "ast"; }
        CM_SYM => { return "sym"; }
        CM_TYPE => { return "type"; }
    }
}

/**
 * Set the active CLI mode or emit an error for conflicting mode flags.
 *
 * @param opts Parsed CLI options.
 * @param diags Diagnostic collector.
 * @param mode Mode requested by the current flag.
 */
func cli_try_set_mode(opts: CliOptions*, diags: DiagCollector*, mode: CliMode) {
    if (!opts.mode_explicit) {
        opts.mode = mode;
        opts.mode_explicit = true;
        return;
    }

    if (ord(opts.mode) != ord(mode)) {
        cli_emit_error(
            diags,
            "L1C-2002",
            "multiple mode flags provided: " + cli_mode_flag(opts.mode) + " conflicts with " + cli_mode_flag(mode)
        );
    }
}

/**
 * Return the index of the `--` argument separator.
 *
 * @param argv Full argument vector.
 * @return Separator index, or `-1` if `--` is not present.
 */
func cli_split_index(argv: StringVector*) -> int {
    for (let i = 0; i < sv_size(argv); i = i + 1) {
        if (sv_get(argv, i) == "--") {
            return i;
        }
    }
    return -1;
}

/**
 * Report whether the compiler CLI args explicitly request help output.
 *
 * Only tokens before the `--` separator count as compiler CLI arguments.
 *
 * @param argv Full argument vector excluding the executable name.
 * @param cli_end Exclusive end index for compiler CLI arguments.
 * @return `true` when `-h` or `--help` is present before `cli_end`.
 */
func cli_has_help_flag(argv: StringVector*, cli_end: int) -> bool {
    for (let i = 0; i < cli_end; i = i + 1) {
        let token = sv_get(argv, i);
        if (token == "-h" || token == "--help") {
            return true;
        }
    }
    return false;
}

/**
 * Report whether the compiler CLI args explicitly request version output.
 *
 * Only tokens before the `--` separator count as compiler CLI arguments.
 *
 * @param argv Full argument vector excluding the executable name.
 * @param cli_end Exclusive end index for compiler CLI arguments.
 * @return `true` when `--version` is present before `cli_end`.
 */
func cli_has_version_flag(argv: StringVector*, cli_end: int) -> bool {
    for (let i = 0; i < cli_end; i = i + 1) {
        if (sv_get(argv, i) == "--version") {
            return true;
        }
    }
    return false;
}

/**
 * Print one CLI help/usage line to standard output or standard error.
 *
 * @param to_stderr Whether the text should be written to standard error.
 * @param text Line text without a trailing newline.
 */
func cli_print_line(to_stderr: bool, text: string) {
    if (to_stderr) {
        err_printl_s(text);
    } else {
        printl_s(text);
    }
}

/**
 * Print a blank line to standard output or standard error.
 *
 * @param to_stderr Whether the newline should be written to standard error.
 */
func cli_print_blank_line(to_stderr: bool) {
    if (to_stderr) {
        err_printl();
    } else {
        printl_s("");
    }
}

/**
 * Print the short Stage 1 usage banner.
 *
 * @param to_stderr Whether the banner should be written to standard error.
 */
func cli_print_usage(to_stderr: bool) {
    cli_print_line(to_stderr, "usage: l1c [-h] [--version] [-v] [-Vl] [-Rp PROJECT_ROOT] [-Rs SYS_ROOT] [--run | --build |");
    cli_print_line(to_stderr, "           -c | --compile | --link | --emit-interface | --gen | --check | --tok | --ast | --sym | --type]");
    cli_print_line(to_stderr, "           [-I INTERFACE_PATH]");
    cli_print_line(to_stderr, "           [--output OUTPUT]");
    cli_print_line(to_stderr, "           [--foreign-object C_OBJECT] [--entry MODULE]");
    cli_print_line(to_stderr, "           [--c-compiler C_COMPILER] [--c-options C_OPTIONS]");
    cli_print_line(to_stderr, "           [--runtime-include RUNTIME_INCLUDE] [--runtime-lib RUNTIME_LIB]");
    cli_print_line(to_stderr, "           [--no-line-directives] [--trace-arc] [--trace-memory] [--unchecked]");
    cli_print_line(to_stderr, "           [--check-basic]");
    cli_print_line(to_stderr, "           [--keep-c]");
    cli_print_line(to_stderr, "           [--all-modules] [--include-eof]");
    cli_print_line(to_stderr, "           targets [targets ...]");
    cli_print_line(to_stderr, "       l1c --link DEA_OBJECT... [--foreign-object C_OBJECT]... [--entry MODULE] -o OUTPUT");
}

/**
 * Print the full Stage 1 help text.
 */
func cli_print_help() {
    cli_print_usage(false);
    cli_print_blank_line(false);
    cli_print_line(false, cli_compiler_identity_text());
    cli_print_blank_line(false);
    cli_print_line(false, "positional arguments:");
    cli_print_line(false, "  targets               One target module/file name, or one or more positional");
    cli_print_line(false, "                        Dea object paths with '--link'");
    cli_print_blank_line(false);
    cli_print_line(false, "options:");
    cli_print_line(false, "  -h, --help            show this help message and exit");
    cli_print_line(false, "  --version             show compiler version and exit");
    cli_print_line(false, "  -v, --verbose         Increase verbosity: -v=INFO, -vvv=DEBUG");
    cli_print_line(false, "  -Vl, --log            Enable rich log formatting (timestamps, levels)");
    cli_print_line(false, "  -Rp, --project-root PROJECT_ROOT");
    cli_print_line(false, "                        Add a project source root (can be passed multiple");
    cli_print_line(false, "                        times)");
    cli_print_line(false, "  -Rs, --sys-root SYS_ROOT");
    cli_print_line(false, "                        Add a system/stdlib source root (can be passed");
    cli_print_line(false, "                        multiple times; default: $L1_SYSTEM as colon-separated");
    cli_print_line(false, "                        paths)");
    cli_print_line(false, "  --run, -r             Build and run a module");
    cli_print_line(false, "  --build               Build an executable (default mode)");
    cli_print_line(false, "  -c, --compile         Compile one module to sibling .o and .l1m artifacts");
    cli_print_line(false, "  --link                Link verified Dea objects into an executable");
    cli_print_line(false, "  --emit-interface      Emit the module interface (.l1m) text for the target module");
    cli_print_line(false, "  --gen, -Gc, --codegen Generate C code");
    cli_print_line(false, "  --check, --analyze    Parse and analyze a module");
    cli_print_line(false, "  --tok, --tokens       Dump lexer tokens");
    cli_print_line(false, "  --ast                 Pretty-print the AST");
    cli_print_line(false, "  --sym, --symbols      Dump module-level symbols");
    cli_print_line(false, "  --type, --types       Dump resolved types");
    cli_print_line(false, "  --output, -o OUTPUT   Output path (valid in: '--build', '--compile', '--emit-interface', '--gen', '--link', '--run')");
    cli_print_line(false, "  --foreign-object C_OBJECT");
    cli_print_line(false, "                        Add an explicit metadata-free relocatable C object");
    cli_print_line(false, "                        in encounter order (repeatable; valid in: '--link')");
    cli_print_line(false, "  --entry MODULE        Select one canonical dotted Dea entry module");
    cli_print_line(false, "                        (at most once; valid in: '--link')");
    cli_print_line(false, "  --c-compiler, -Cc C_COMPILER");
    cli_print_line(false, "                        C compiler to use (valid in: '--build', '--compile',");
    cli_print_line(false, "                        '--link', '--run'; default: $L1_CC has highest");
    cli_print_line(false, "                        precedence if set; then tcc, gcc, clang, cc from PATH,");
    cli_print_line(false, "                        or $CC, in that order)");
    cli_print_line(false, "  --c-options, -Co C_OPTIONS");
    cli_print_line(false, "                        Extra options to pass to the C compiler (valid in:");
    cli_print_line(false, "                        '--build', '--compile', '--link', '--run'; default");
    cli_print_line(false, "                        prepends $L1_CFLAGS; options from --c-options are");
    cli_print_line(false, "                        appended after env options; e.g. -Co=\"-Og -DDEBUG\")");
    cli_print_line(false, "  -I, --interface-path INTERFACE_PATH");
    cli_print_line(false, "                        Add an interface search path (repeatable; valid in:");
    cli_print_line(false, "                        '--compile'; searched in declaration order)");
    cli_print_line(false, "  --runtime-include, -Ri RUNTIME_INCLUDE");
    cli_print_line(false, "                        Path to Dea runtime headers such as `dea_rt.h`");
    cli_print_line(false, "                        (default: $L1_RUNTIME_INCLUDE or");
    cli_print_line(false, "                        $L1_BUILD_DIR/include; valid in: '--build',");
    cli_print_line(false, "                        '--compile', '--link', '--run')");
    cli_print_line(false, "  --runtime-lib, -Rl RUNTIME_LIB");
    cli_print_line(false, "                        Path to Dea runtime library search directory");
    cli_print_line(false, "                        (default: $L1_RUNTIME_LIB or");
    cli_print_line(false, "                        $L1_BUILD_DIR/lib; valid in: '--build', '--link', '--run')");
    cli_print_line(false, "  -g                    Reserved debug-information option (not supported yet)");
    cli_print_line(false, "  -S                    Reserved assembly-output option (not supported yet)");
    cli_print_line(false, "  -L LIBRARY_PATH       Reserved library search path (not supported yet)");
    cli_print_line(false, "  -l LIBRARY            Reserved library link option (not supported yet)");
    cli_print_line(false, "  --no-line-directives, -NLD");
    cli_print_line(false, "                        Disable #line directives in generated C code (valid");
    cli_print_line(false, "                        in: '--build', '--compile', '--gen', '--run')");
    cli_print_line(false, "  --trace-arc           Use the traced runtime archive for ARC diagnostics;");
    cli_print_line(false, "                        with '--gen', generated C calls traced runtime");
    cli_print_line(false, "                        entrypoints directly (link libdea_rt_traced.a)");
    cli_print_line(false, "  --trace-memory        Use the traced runtime archive for memory diagnostics;");
    cli_print_line(false, "                        with '--gen', generated C calls traced runtime");
    cli_print_line(false, "                        entrypoints directly (link libdea_rt_traced.a)");
    cli_print_line(false, "  --unchecked           Disable runtime pointer validation and use the unchecked");
    cli_print_line(false, "                        runtime archive; with '--gen', generated C defines");
    cli_print_line(false, "                        DEA_RT_UNCHECKED (link libdea_rt_unchecked.a)");
    cli_print_line(false, "  --check-basic         Use the basic checked runtime archive; with '--gen',");
    cli_print_line(false, "                        generated C defines DEA_RT_CHECK_BASIC (link");
    cli_print_line(false, "                        libdea_rt_check_basic.a)");
    cli_print_line(false, "  --keep-c              Keep generated C file (valid in: '--build', '--compile',");
    cli_print_line(false, "                        '--run'; compile mode adds the sibling .c artifact)");
    cli_print_line(false, "  --all-modules, -a     Process all modules in the compilation unit (valid in:");
    cli_print_line(false, "                        '--tok', '--ast', '--sym', '--type')");
    cli_print_line(false, "  --include-eof         Include the EOF token in output (valid in: '--tok')");
    cli_print_blank_line(false);
    cli_print_line(false, "Modes are selected with flags (default: --build). Use '--' to pass program");
    cli_print_line(false, "arguments for --run.");
}

/**
 * Print the compiler identity/version text.
 */
func cli_print_version() {
    let version_text = build_info_version_text(cli_compiler_identity_text());
    if (version_text == null) {
        printl_s(cli_compiler_identity_text());
        return;
    }
    printl_s(version_text as string);
}

/**
 * Count verbosity flags in a short option cluster.
 *
 * @param token Argument token to inspect.
 * @return Number of `v` characters in a token like `-vvv`, or `-1` if the token is not such a cluster.
 */
func cli_verbose_cluster_count(token: string) -> int {
    if (len_s(token) < 2 || char_at_s(token, 0) != '-') {
        return -1;
    }

    for (let i = 1; i < len_s(token); i = i + 1) {
        if (char_at_s(token, i) != 'v') {
            return -1;
        }
    }

    return len_s(token) - 1;
}

/**
 * Return the value following an option that requires one.
 *
 * @param argv Full argument vector.
 * @param i Index of the option token.
 * @param option Exact option token used in diagnostics.
 * @param diags Diagnostic collector.
 * @return Following argument value, or `null` after emitting a missing-value error.
 */
func cli_require_next_value(argv: StringVector*, i: int, option: string, diags: DiagCollector*) -> string? {
    if (i + 1 >= sv_size(argv) || sv_get(argv, i + 1) == "--") {
        cli_emit_error(diags, "L1C-2003", "missing value for option '" + option + "'");
        return null;
    }
    return sv_get(argv, i + 1);
}

/**
 * Assign a positional target argument.
 *
 * @param opts Parsed CLI options.
 * @param token Positional argument to record.
 */
func cli_assign_target(opts: CliOptions*, token: string) {
    cli_link_operands_push(opts.link_operands, LOK_DEA_OBJECT, token);
    if (opts.entry_target == null) {
        opts.entry_target = token;
    } else {
        opts.extra_target_count = opts.extra_target_count + 1;
    }
}

/**
 * Count ordered operands with one CLI classification.
 *
 * @param opts Parsed CLI options.
 * @param kind Operand kind to count.
 * @return Number of matching operands.
 */
func cli_count_link_operands(opts: CliOptions*, kind: LinkOperandKind) -> int {
    let count = 0;
    for (let i = 0; i < cli_link_operands_count(opts.link_operands); i = i + 1) {
        if (ord(cli_link_operands_get(opts.link_operands, i).kind) == ord(kind)) {
            count = count + 1;
        }
    }
    return count;
}

/**
 * Validate that mode-specific flags are used with compatible modes.
 *
 * @param opts Parsed CLI options.
 * @param diags Diagnostic collector for incompatibility errors.
 */
func cli_validate_mode_scoped_flags(opts: CliOptions*, diags: DiagCollector*) {
    let mode = opts.mode;
    let is_link = ord(mode) == ord(CM_LINK);

    if (is_link && sv_size(opts.project_roots) > 0) {
        cli_emit_error(
            diags,
            "L1C-2090",
            "option '--project-root' is not valid with mode: --link"
        );
    }

    if (is_link && sv_size(opts.sys_roots) > 0) {
        cli_emit_error(
            diags,
            "L1C-2090",
            "option '--sys-root' is not valid with mode: --link"
        );
    }

    if (sv_size(opts.interface_paths) > 0 && ord(mode) != ord(CM_COMPILE)) {
        cli_emit_error(diags, "L1C-2031", "option '--interface-path' is valid only with mode: --compile");
    }

    if (opts.output != null && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_LINK) &&
        ord(mode) != ord(CM_GEN) && ord(mode) != ord(CM_EMIT_INTERFACE)) {
        cli_emit_error(diags, "L1C-2010", "option '--output' is valid only with modes: --build, --compile, --emit-interface, --gen, --link, --run");
    }

    if (opts.keep_c && ord(mode) != ord(CM_BUILD) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_RUN)) {
        cli_emit_error(diags, "L1C-2011", "option '--keep-c' is valid only with modes: --build, --compile, --run");
    }

    if (opts.c_compiler != null && ord(mode) != ord(CM_BUILD) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_LINK) && ord(mode) != ord(CM_RUN)) {
        cli_emit_error(diags, "L1C-2012", "option '--c-compiler' is valid only with modes: --build, --compile, --link, --run");
    }

    if (opts.c_options != null && ord(mode) != ord(CM_BUILD) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_LINK) && ord(mode) != ord(CM_RUN)) {
        cli_emit_error(diags, "L1C-2013", "option '--c-options' is valid only with modes: --build, --compile, --link, --run");
    }

    if (opts.runtime_include != null && ord(mode) != ord(CM_BUILD) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_LINK) && ord(mode) != ord(CM_RUN)) {
        cli_emit_error(diags, "L1C-2014", "option '--runtime-include' is valid only with modes: --build, --compile, --link, --run");
    }

    if (opts.runtime_lib != null && ord(mode) != ord(CM_BUILD) &&
        ord(mode) != ord(CM_LINK) && ord(mode) != ord(CM_RUN)) {
        cli_emit_error(diags, "L1C-2015", "option '--runtime-lib' is valid only with modes: --build, --link, --run");
    }

    if (opts.no_line_directives && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_GEN)) {
        cli_emit_error(diags, "L1C-2016", "option '--no-line-directives' is valid only with modes: --build, --compile, --gen, --run");
    }

    if (opts.trace_arc && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_GEN) && ord(mode) != ord(CM_LINK)) {
        cli_emit_error(diags, "L1C-2017", "option '--trace-arc' is valid only with modes: --build, --compile, --gen, --link, --run");
    }

    if (opts.trace_memory && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_GEN) && ord(mode) != ord(CM_LINK)) {
        cli_emit_error(diags, "L1C-2018", "option '--trace-memory' is valid only with modes: --build, --compile, --gen, --link, --run");
    }

    if (ord(mode) == ord(CM_GEN) && (opts.trace_arc || opts.trace_memory)) {
        cli_emit_warning(
            diags,
            "L1C-0019",
            "'--trace-arc'/'--trace-memory' under '--gen' produces traced-archive-compatible C; the caller must link against 'libdea_rt_traced.a' (or compile with -DDEA_TRACE_ARC / -DDEA_TRACE_MEMORY if linking the runtime sources directly)"
        );
    }

    if (opts.unchecked && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_GEN) && ord(mode) != ord(CM_LINK)) {
        cli_emit_error(diags, "L1C-2025", "option '--unchecked' is valid only with modes: --build, --compile, --gen, --link, --run");
    }

    if (opts.check_basic && ord(mode) != ord(CM_BUILD) && ord(mode) != ord(CM_RUN) &&
        ord(mode) != ord(CM_COMPILE) && ord(mode) != ord(CM_GEN) && ord(mode) != ord(CM_LINK)) {
        cli_emit_error(diags, "L1C-2027", "option '--check-basic' is valid only with modes: --build, --compile, --gen, --link, --run");
    }

    if (opts.unchecked && (opts.trace_arc || opts.trace_memory)) {
        cli_emit_error(diags, "L1C-2026", "option '--unchecked' cannot be combined with '--trace-arc' or '--trace-memory'");
    }

    if (opts.check_basic && (opts.unchecked || opts.trace_arc || opts.trace_memory)) {
        cli_emit_error(diags, "L1C-2028", "option '--check-basic' cannot be combined with '--unchecked', '--trace-arc', or '--trace-memory'");
    }

    if (ord(mode) == ord(CM_GEN) && opts.unchecked) {
        cli_emit_warning(
            diags,
            "L1C-0020",
            "'--unchecked' under '--gen' produces unchecked-runtime C; the caller should link against 'libdea_rt_unchecked.a' (or compile with -DDEA_RT_UNCHECKED if linking the runtime sources directly)"
        );
    }

    if (ord(mode) == ord(CM_GEN) && opts.check_basic) {
        cli_emit_warning(
            diags,
            "L1C-0021",
            "'--check-basic' under '--gen' produces basic checked-runtime C; the caller should link against 'libdea_rt_check_basic.a' (or compile with -DDEA_RT_CHECK_BASIC if linking the runtime sources directly)"
        );
    }

    if (opts.all_modules &&
        ord(mode) != ord(CM_TOK) &&
        ord(mode) != ord(CM_AST) &&
        ord(mode) != ord(CM_SYM) &&
        ord(mode) != ord(CM_TYPE)) {
        cli_emit_error(diags, "L1C-2019", "option '--all-modules' is valid only with modes: --ast, --sym, --tok, --type");
    }

    if (opts.include_eof && ord(mode) != ord(CM_TOK)) {
        cli_emit_error(diags, "L1C-2020", "option '--include-eof' is valid only with modes: --tok");
    }

    if (cli_count_link_operands(opts, LOK_FOREIGN_OBJECT) > 0 && !is_link) {
        cli_emit_error(diags, "L1C-2091", "option '--foreign-object' is valid only with mode: --link");
    }

    if (opts.entry_module != null && !is_link) {
        cli_emit_error(diags, "L1C-2092", "option '--entry' is valid only with mode: --link");
    }
}

/**
 * Parse command-line arguments into structured options.
 *
 * @param argv Argument vector excluding the executable name.
 * @return Parsed options together with any diagnostics produced during parsing.
 */
func cli_parse(argv: StringVector*) -> CliParseResult* {
    with (
        let opts: CliOptions*? = cli_options_create() => cli_options_free_opt(opts),
        let diags: DiagCollector*? = diag_create() => cli_diag_free_opt(diags)
    ) {
        let split_idx = cli_split_index(argv);
        let cli_end = sv_size(argv);
        if (split_idx >= 0) {
            cli_end = split_idx;
            for (let i = split_idx + 1; i < sv_size(argv); i = i + 1) {
                sv_push((opts as CliOptions*).program_args, sv_get(argv, i));
            }
        }

        if (cli_has_help_flag(argv, cli_end)) {
            let parsed_verbosity = (opts as CliOptions*).verbosity;
            let parsed_log = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let help_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                true,
                false,
                parsed_verbosity,
                parsed_log
            );
            diags = null;
            return help_result;
        }

        if (cli_has_version_flag(argv, cli_end)) {
            let parsed_verbosity2 = (opts as CliOptions*).verbosity;
            let parsed_log2 = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let version_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                false,
                true,
                parsed_verbosity2,
                parsed_log2
            );
            diags = null;
            return version_result;
        }

        let i = 0;
        let entry_option_count = 0;
        let output_option_count = 0;
        while (i < cli_end) {
            let token = sv_get(argv, i);

            if (token == "--run" || token == "-r") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_RUN);
                i = i + 1;
                continue;
            }
            if (token == "--build") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_BUILD);
                i = i + 1;
                continue;
            }
            if (token == "-c" || token == "--compile") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_COMPILE);
                i = i + 1;
                continue;
            }
            if (token == "--link") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_LINK);
                i = i + 1;
                continue;
            }
            if (token == "--emit-interface") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_EMIT_INTERFACE);
                i = i + 1;
                continue;
            }
            if (token == "--gen" || token == "--codegen" || token == "-Gc") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_GEN);
                i = i + 1;
                continue;
            }
            if (token == "--check" || token == "--analyze") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_CHECK);
                i = i + 1;
                continue;
            }
            if (token == "--tok" || token == "--tokens") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_TOK);
                i = i + 1;
                continue;
            }
            if (token == "--ast") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_AST);
                i = i + 1;
                continue;
            }
            if (token == "--sym" || token == "--symbols") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_SYM);
                i = i + 1;
                continue;
            }
            if (token == "--type" || token == "--types") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_TYPE);
                i = i + 1;
                continue;
            }

            if (token == "--verbose") {
                (opts as CliOptions*).verbosity = (opts as CliOptions*).verbosity + 1;
                i = i + 1;
                continue;
            }

            let vcount = cli_verbose_cluster_count(token);
            if (vcount > 0) {
                (opts as CliOptions*).verbosity = (opts as CliOptions*).verbosity + vcount;
                i = i + 1;
                continue;
            }

            if (token == "-Vl" || token == "--log") {
                (opts as CliOptions*).log = true;
                i = i + 1;
                continue;
            }

            if (token == "-NLD" || token == "--no-line-directives") {
                (opts as CliOptions*).no_line_directives = true;
                i = i + 1;
                continue;
            }

            if (token == "--unchecked") {
                (opts as CliOptions*).unchecked = true;
                i = i + 1;
                continue;
            }

            if (token == "--check-basic") {
                (opts as CliOptions*).check_basic = true;
                i = i + 1;
                continue;
            }

            if (token == "--trace-arc") {
                (opts as CliOptions*).trace_arc = true;
                i = i + 1;
                continue;
            }

            if (token == "--trace-memory") {
                (opts as CliOptions*).trace_memory = true;
                i = i + 1;
                continue;
            }

            if (token == "--keep-c") {
                (opts as CliOptions*).keep_c = true;
                i = i + 1;
                continue;
            }

            if (token == "-a" || token == "--all-modules") {
                (opts as CliOptions*).all_modules = true;
                i = i + 1;
                continue;
            }

            if (token == "--include-eof") {
                (opts as CliOptions*).include_eof = true;
                i = i + 1;
                continue;
            }

            if (token == "--foreign-object") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    cli_link_operands_push(
                        (opts as CliOptions*).link_operands,
                        LOK_FOREIGN_OBJECT,
                        value as string
                    );
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--foreign-object=")) {
                let value = slice_s(token, len_s("--foreign-object="), len_s(token));
                if (is_empty_s(value)) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2003",
                        "missing value for option '--foreign-object'"
                    );
                } else {
                    cli_link_operands_push(
                        (opts as CliOptions*).link_operands,
                        LOK_FOREIGN_OBJECT,
                        value
                    );
                }
                i = i + 1;
                continue;
            }

            if (token == "--entry") {
                entry_option_count = entry_option_count + 1;
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (entry_option_count > 1) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2093",
                        "option '--entry' may be provided at most once"
                    );
                } else if (value != null) {
                    (opts as CliOptions*).entry_module = value;
                }
                if (value == null) {
                    i = i + 1;
                } else {
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--entry=")) {
                entry_option_count = entry_option_count + 1;
                let value = slice_s(token, len_s("--entry="), len_s(token));
                if (entry_option_count > 1) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2093",
                        "option '--entry' may be provided at most once"
                    );
                } else if (is_empty_s(value)) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2003",
                        "missing value for option '--entry'"
                    );
                } else {
                    (opts as CliOptions*).entry_module = value;
                }
                i = i + 1;
                continue;
            }

            if (token == "-Rp" || token == "--project-root") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).project_roots, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--project-root=")) {
                let value = slice_s(token, len_s("--project-root="), len_s(token));
                sv_push((opts as CliOptions*).project_roots, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Rp=")) {
                let value = slice_s(token, len_s("-Rp="), len_s(token));
                sv_push((opts as CliOptions*).project_roots, value);
                i = i + 1;
                continue;
            }

            if (token == "-Rs" || token == "--sys-root") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).sys_roots, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--sys-root=")) {
                let value = slice_s(token, len_s("--sys-root="), len_s(token));
                sv_push((opts as CliOptions*).sys_roots, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Rs=")) {
                let value = slice_s(token, len_s("-Rs="), len_s(token));
                sv_push((opts as CliOptions*).sys_roots, value);
                i = i + 1;
                continue;
            }

            if (token == "-o" || token == "--output") {
                output_option_count = output_option_count + 1;
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).output = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--output=")) {
                output_option_count = output_option_count + 1;
                let value = slice_s(token, len_s("--output="), len_s(token));
                if (is_empty_s(value)) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2003",
                        "missing value for option '--output'"
                    );
                } else {
                    (opts as CliOptions*).output = value;
                }
                i = i + 1;
                continue;
            }

            if (token == "-Cc" || token == "--c-compiler") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).c_compiler = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--c-compiler=")) {
                (opts as CliOptions*).c_compiler = slice_s(token, len_s("--c-compiler="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Cc=")) {
                (opts as CliOptions*).c_compiler = slice_s(token, len_s("-Cc="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Co" || token == "--c-options") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).c_options = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--c-options=")) {
                (opts as CliOptions*).c_options = slice_s(token, len_s("--c-options="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Co=")) {
                (opts as CliOptions*).c_options = slice_s(token, len_s("-Co="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-I" || token == "--interface-path") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).interface_paths, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--interface-path=")) {
                let value = slice_s(token, len_s("--interface-path="), len_s(token));
                sv_push((opts as CliOptions*).interface_paths, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-I") && len_s(token) > len_s("-I") &&
                char_at_s(token, len_s("-I")) != '=') {
                let value = slice_s(token, len_s("-I"), len_s(token));
                sv_push((opts as CliOptions*).interface_paths, value);
                i = i + 1;
                continue;
            }

            if (token == "-Ri" || token == "--runtime-include") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).runtime_include = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--runtime-include=")) {
                (opts as CliOptions*).runtime_include = slice_s(token, len_s("--runtime-include="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Ri=")) {
                (opts as CliOptions*).runtime_include = slice_s(token, len_s("-Ri="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Rl" || token == "--runtime-lib") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).runtime_lib = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--runtime-lib=")) {
                (opts as CliOptions*).runtime_lib = slice_s(token, len_s("--runtime-lib="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-Rl=")) {
                (opts as CliOptions*).runtime_lib = slice_s(token, len_s("-Rl="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-g") {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-g", "debug information");
                i = i + 1;
                continue;
            }

            if (token == "-S") {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-S", "assembly output");
                i = i + 1;
                continue;
            }

            if (token == "-L") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    cli_emit_reserved_option_error(diags as DiagCollector*, "-L", "external library search");
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-L") && len_s(token) > len_s("-L") &&
                char_at_s(token, len_s("-L")) != '=') {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-L", "external library search");
                i = i + 1;
                continue;
            }

            if (token == "-l") {
                let value2 = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value2 == null) {
                    i = i + 1;
                } else {
                    cli_emit_reserved_option_error(diags as DiagCollector*, "-l", "external library selection");
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-l") && len_s(token) > len_s("-l") &&
                char_at_s(token, len_s("-l")) != '=') {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-l", "external library selection");
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-")) {
                cli_emit_error(diags as DiagCollector*, "L1C-2001", "unknown option '" + token + "'");
                i = i + 1;
                continue;
            }

            cli_assign_target(opts as CliOptions*, token);
            i = i + 1;
        }

        if (cli_has_diagnostic_code(diags as DiagCollector*, "L1C-2003")) {
            let missing_value_verbosity = (opts as CliOptions*).verbosity;
            let missing_value_log = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let missing_value_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                false,
                false,
                missing_value_verbosity,
                missing_value_log
            );
            diags = null;
            return missing_value_result;
        }

        let parsed_opts = opts as CliOptions*;
        if (ord(parsed_opts.mode) == ord(CM_LINK)) {
            if (cli_count_link_operands(parsed_opts, LOK_DEA_OBJECT) == 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L1C-2095",
                    "mode '--link' requires at least one positional Dea object"
                );
            }
            if (output_option_count != 1 || parsed_opts.output == null) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L1C-2096",
                    "mode '--link' requires exactly one output path through '-o' or '--output'"
                );
            }
            if (parsed_opts.entry_module != null) {
                let entry_module = parsed_opts.entry_module as string;
                if (!sp_is_valid_module_name(entry_module)) {
                    cli_emit_error(
                        diags as DiagCollector*,
                        "L1C-2094",
                        "invalid entry module name '" + entry_module +
                        "': expected a canonical dotted module name"
                    );
                }
            }
        } else if (parsed_opts.entry_target == null) {
            cli_emit_error(diags as DiagCollector*, "L1C-2021", "missing required target module/file name");
        }

        if (ord(parsed_opts.mode) == ord(CM_RUN)) {
            if ((opts as CliOptions*).extra_target_count > 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L1C-2022",
                    "mode '--run' accepts exactly one target; use '--' before runtime program arguments"
                );
            }
        } else if (ord(parsed_opts.mode) != ord(CM_LINK)) {
            if (split_idx >= 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L1C-2023",
                    "arguments after '--' are valid only with '--run'"
                );
            }
            if ((opts as CliOptions*).extra_target_count > 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L1C-2024",
                    "multiple targets are not supported yet; pass exactly one target"
                );
            }
        } else if (split_idx >= 0) {
            cli_emit_error(
                diags as DiagCollector*,
                "L1C-2023",
                "arguments after '--' are valid only with '--run'"
            );
        }

        cli_validate_mode_scoped_flags(opts as CliOptions*, diags as DiagCollector*);

        let parsed_verbosity3 = (opts as CliOptions*).verbosity;
        let parsed_log3 = (opts as CliOptions*).log;
        if (diag_has_errors(diags as DiagCollector*)) {
            cli_options_free(opts as CliOptions*);
            opts = null;
        }

        let result = new CliParseResult(
            opts,
            diags as DiagCollector*,
            false,
            false,
            parsed_verbosity3,
            parsed_log3
        );
        diags = null;
        opts = null;
        return result;
    }
}
