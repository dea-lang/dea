module name_resolver;

import sys.rt;

import std.hashmap;
import std.hashset;
import std.string;
import std.text;
import std.vector;
import util.diag;
import util.strings;

import ast;
import dea_prelude;
import driver;
import module_interface;
import symbols;
import types;

/**
 * Represents the ModuleEnv structure.
 */
struct ModuleEnv {
    module_name: string;
    module_ptr: Module*;
    module_ptr_owned: bool;
    locals: StringPtrMap*;           // string -> Symbol*
    exports: StringPtrMap*;          // string -> Symbol* (non-owning)
    opaque_exports: StringSet*;      // names exported opaquely
    imported: StringPtrMap*;         // string -> Symbol* (non-owning)
    all: StringPtrMap*;              // string -> Symbol* (non-owning for imported, owning via locals)
    ambiguous_imports: StringSet*;
    imported_modules: StringSet*;
    qualified_modules: StringSet*;
    open_import_modules: StringSet*;
    alias_imports: StringPtrMap*;     // string -> ModuleEnv* (non-owning)
    prelude_imported: StringSet*;
    pending_extern_shadows: VectorBase*; // PendingExternShadow*
}

/**
 * Deferred local/imported extern shadow check.
 */
struct PendingExternShadow {
    local: Symbol*;          // non-owning
    imported: Symbol*;       // non-owning
    imported_module: string;
    name: string;
}

/**
 * Represents the NameResolution structure.
 */
struct NameResolution {
    envs: VectorBase*;               // ModuleEnv*
    by_name: StringPtrMap*;          // string -> ModuleEnv* (non-owning)
    resolved_symbols: VectorBase*;   // ResolvedSymbolRef*
    resolved_symbol_keys: StringSet*;
}

/**
 * Represents one canonical cross-module symbol resolved from a consumer.
 *
 * Enum-variant lookups are normalized to their owning enum before entries are
 * recorded. Same-module and compiler-synthesized virtual-module lookups never
 * enter this ledger.
 */
struct ResolvedSymbolRef {
    consumer_module: string;
    provider_module: string;
    symbol_name: string;
}

/**
 * Emit a name-resolution error for a source span.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func nr_span_diag_error(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_error(diags, "NameResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Emit a name-resolution warning for a source span.
 *
 * @param diags Diagnostic collector.
 * @param code Diagnostic code.
 * @param message Diagnostic message.
 * @param filename Source filename.
 * @param span Source span to highlight.
 */
func nr_span_diag_warn(diags: DiagCollector*, code: string, message: string, filename: string, span: Span) {
    diag_warn(diags, "NameResolver", code, message, filename, span.start_line, span.start_column, span.end_line,
        span.end_column);
}

/**
 * Return a symbol from a string-pointer map when present.
 *
 * @param self Symbol map to inspect.
 * @param name Symbol name to look up.
 * @return Matching symbol, or `null` if absent.
 */
func nr_map_symbol_get(self: StringPtrMap*, name: string) -> Symbol*? {
    let value = spm_get(self, name);
    if (value == null) {
        return null;
    }
    return value as Symbol*;
}

/**
 * Build a fully qualified top-level symbol key.
 *
 * @param module_name Defining module name.
 * @param name Symbol name.
 * @return Key in `module::name` form.
 */
func nr_build_top_key(module_name: string, name: string) -> string {
    return module_name + "::" + name;
}

/**
 * Compare two parsed type references for signature compatibility.
 *
 * @param left First type reference.
 * @param right Second type reference.
 * @return `true` if the two type references describe the same type syntax.
 */
func nr_path_is_same_signature(left: TypeRef*?, right: TypeRef*?) -> bool {
    if (left == null || right == null) {
        return left == null && right == null;
    }

    let lt = left as TypeRef*;
    let rt = right as TypeRef*;
    if (lt.name != rt.name || lt.pointer_depth != rt.pointer_depth || lt.is_nullable != rt.is_nullable) {
        return false;
    }
    if ((lt.suffixes == null) != (rt.suffixes == null)) {
        return false;
    }
    if (lt.suffixes != null) {
        let ls = lt.suffixes as VectorBase*;
        let rs = rt.suffixes as VectorBase*;
        if (vec_size(ls) != vec_size(rs)) {
            return false;
        }
        for (let si = 0; si < vec_size(ls); si = si + 1) {
            let a = ptr_vec_get(ls, si) as TypeSuffix*;
            let b = ptr_vec_get(rs, si) as TypeSuffix*;
            if (ord(a.kind) != ord(b.kind) || a.array_len != b.array_len) {
                return false;
            }
        }
    }

    let left_modules = lt.module_path;
    let right_modules = rt.module_path;
    if ((left_modules == null) != (right_modules == null)) {
        return false;
    }
    if (left_modules != null) {
        let lv = left_modules as StringVector*;
        let rv = right_modules as StringVector*;
        if (sv_size(lv) != sv_size(rv)) {
            return false;
        }
        for (let i = 0; i < sv_size(lv); i = i + 1) {
            if (sv_get(lv, i) != sv_get(rv, i)) {
                return false;
            }
        }
    }

    let left_names = lt.name_qualifier;
    let right_names = rt.name_qualifier;
    if ((left_names == null) != (right_names == null)) {
        return false;
    }
    if (left_names != null) {
        let lv2 = left_names as StringVector*;
        let rv2 = right_names as StringVector*;
        if (sv_size(lv2) != sv_size(rv2)) {
            return false;
        }
        for (let i = 0; i < sv_size(lv2); i = i + 1) {
            if (sv_get(lv2, i) != sv_get(rv2, i)) {
                return false;
            }
        }
    }

    return true;
}

/**
 * Check whether two extern function symbols have compatible signatures.
 *
 * @param local_sym Local symbol.
 * @param imported_sym Imported symbol.
 * @return `true` if both are extern functions with matching signatures.
 */
func nr_extern_signatures_compatible(local_sym: Symbol*, imported_sym: Symbol*) -> bool {
    if (ord(local_sym.kind) != ord(SYM_FUNC) || ord(imported_sym.kind) != ord(SYM_FUNC)) {
        return false;
    }
    if (local_sym.decl_ptr == null || imported_sym.decl_ptr == null) {
        return false;
    }

    let local_decl = local_sym.decl_ptr as FuncDecl*;
    let imported_decl = imported_sym.decl_ptr as FuncDecl*;
    if (!local_decl.is_extern || !imported_decl.is_extern) {
        return false;
    }
    if (vec_size(local_decl.params) != vec_size(imported_decl.params)) {
        return false;
    }
    if (!nr_path_is_same_signature(local_decl.return_type, imported_decl.return_type)) {
        return false;
    }

    for (let i = 0; i < vec_size(local_decl.params); i = i + 1) {
        let lp = ptr_vec_get(local_decl.params, i) as Param*;
        let rp = ptr_vec_get(imported_decl.params, i) as Param*;
        if (!nr_path_is_same_signature(lp.type_ref, rp.type_ref)) {
            return false;
        }
    }

    return true;
}

/**
 * Free a symbol map that owns its symbol values.
 *
 * @param self Symbol map to free.
 */
func nr_symbol_free_map(self: StringPtrMap*) {
    for (let i = 0; i < spm_capacity(self); i = i + 1) {
        if (spm_slot_occupied(self, i)) {
            symbol_free(spm_slot_value(self, i) as Symbol*);
        }
    }
    spm_free(self);
}

/**
 * Free a module environment and its owned local symbols.
 *
 * @param self Module environment to free.
 */
func nr_module_env_free(self: ModuleEnv*) {
    nr_symbol_free_map(self.locals);
    spm_free(self.exports);
    ss_free(self.opaque_exports);
    spm_free(self.imported);
    spm_free(self.all);
    ss_free(self.ambiguous_imports);
    ss_free(self.imported_modules);
    ss_free(self.qualified_modules);
    ss_free(self.open_import_modules);
    spm_free(self.alias_imports);
    ss_free(self.prelude_imported);
    for (let shadow_i = 0; shadow_i < vec_size(self.pending_extern_shadows); shadow_i = shadow_i + 1) {
        let shadow = ptr_vec_get(self.pending_extern_shadows, shadow_i) as PendingExternShadow*;
        drop shadow;
    }
    vec_free(self.pending_extern_shadows);
    if (self.module_ptr_owned) {
        module_free(self.module_ptr);
    }
    drop self;
}

/**
 * Free a complete name-resolution result.
 *
 * @param self Name-resolution result to free.
 */
func nr_free(self: NameResolution*) {
    for (let i = 0; i < vec_size(self.envs); i = i + 1) {
        nr_module_env_free(ptr_vec_get(self.envs, i) as ModuleEnv*);
    }
    vec_free(self.envs);
    spm_free(self.by_name);
    for (let ref_i = 0; ref_i < vec_size(self.resolved_symbols); ref_i = ref_i + 1) {
        let resolved_ref = ptr_vec_get(self.resolved_symbols, ref_i) as ResolvedSymbolRef*;
        drop resolved_ref;
    }
    vec_free(self.resolved_symbols);
    ss_free(self.resolved_symbol_keys);
    drop self;
}

/**
 * Return the canonical dependency name for a resolved symbol.
 *
 * @param sym Resolved symbol to normalize.
 * @return Owning enum name for a variant, otherwise the symbol's own name.
 */
func nr_dependency_symbol_name(sym: Symbol*) -> string {
    if (ord(sym.kind) == ord(SYM_ENUM_VARIANT)) {
        return sym.owner_name;
    }
    return sym.name;
}

/**
 * Report whether a resolved symbol is a real cross-module dependency.
 *
 * @param consumer_module Module from which the lookup was performed.
 * @param sym Successfully resolved symbol.
 * @return `true` for non-virtual provider symbols owned by another module.
 */
func nr_is_cross_module_symbol(consumer_module: string, sym: Symbol*) -> bool {
    return sym.module_name != consumer_module && !dea_is_virtual_module_name(sym.module_name);
}

/**
 * Record one successful cross-module symbol lookup in the canonical ledger.
 *
 * Repeated lookups of the same provider-owned symbol from one consumer are
 * deduplicated. Enum variants share their owning enum's ledger identity.
 *
 * @param self Name-resolution result receiving the lookup.
 * @param consumer_env Environment from which the lookup was performed.
 * @param sym Successfully resolved symbol.
 */
func nr_record_resolved_symbol(self: NameResolution*, consumer_env: ModuleEnv*, sym: Symbol*) {
    if (!nr_is_cross_module_symbol(consumer_env.module_name, sym)) {
        return;
    }
    let symbol_name = nr_dependency_symbol_name(sym);
    let key = consumer_env.module_name + "|" + sym.module_name + "::" + symbol_name;
    if (ss_has(self.resolved_symbol_keys, key)) {
        return;
    }
    ss_add(self.resolved_symbol_keys, key);
    ptr_vec_push(self.resolved_symbols,
        new ResolvedSymbolRef(consumer_env.module_name, sym.module_name, symbol_name) as void*);
}

/**
 * Return the number of canonical cross-module resolved-symbol entries.
 *
 * @param self Name-resolution result to inspect.
 * @return Resolved-symbol entry count.
 */
func nr_resolved_symbol_count(self: NameResolution*) -> int {
    return vec_size(self.resolved_symbols);
}

/**
 * Return one canonical cross-module resolved-symbol entry.
 *
 * @param self Name-resolution result to inspect.
 * @param index Zero-based entry index.
 * @return Borrowed resolved-symbol entry.
 */
func nr_resolved_symbol_get(self: NameResolution*, index: int) -> ResolvedSymbolRef* {
    return ptr_vec_get(self.resolved_symbols, index) as ResolvedSymbolRef*;
}

/**
 * Return the number of module environments in the result.
 *
 * @param self Name-resolution result to inspect.
 * @return Module-environment count.
 */
func nr_env_count(self: NameResolution*) -> int {
    return vec_size(self.envs);
}

/**
 * Return a module environment by index.
 *
 * @param self Name-resolution result to inspect.
 * @param index Zero-based environment index.
 * @return Module environment at `index`.
 */
func nr_env_get(self: NameResolution*, index: int) -> ModuleEnv* {
    return ptr_vec_get(self.envs, index) as ModuleEnv*;
}

/**
 * Find a module environment by module name.
 *
 * @param self Name-resolution result to inspect.
 * @param module_name Module name to look up.
 * @return Matching environment, or `null` if absent.
 */
func nr_env_find(self: NameResolution*, module_name: string) -> ModuleEnv*? {
    let value = spm_get(self.by_name, module_name);
    if (value == null) {
        return null;
    }
    return value as ModuleEnv*;
}

/**
 * Look up a locally defined symbol in a module environment.
 *
 * @param self Module environment to inspect.
 * @param name Symbol name to look up.
 * @return Local symbol, or `null` if absent.
 */
func nr_module_env_local(self: ModuleEnv*, name: string) -> Symbol*? {
    return nr_map_symbol_get(self.locals, name);
}

/**
 * Look up an imported symbol in a module environment.
 *
 * @param self Module environment to inspect.
 * @param name Symbol name to look up.
 * @return Imported symbol, or `null` if absent.
 */
func nr_module_env_imported(self: ModuleEnv*, name: string) -> Symbol*? {
    return nr_map_symbol_get(self.imported, name);
}

/**
 * Look up any visible symbol in a module environment.
 *
 * @param self Module environment to inspect.
 * @param name Symbol name to look up.
 * @return Visible symbol, or `null` if absent or ambiguous.
 */
func nr_module_env_all(self: ModuleEnv*, name: string) -> Symbol*? {
    return nr_map_symbol_get(self.all, name);
}

/**
 * Check whether an imported name is ambiguous in a module environment.
 *
 * @param self Module environment to inspect.
 * @param name Symbol name to check.
 * @return `true` if multiple imports provide `name`.
 */
func nr_module_env_is_ambiguous(self: ModuleEnv*, name: string) -> bool {
    return ss_has(self.ambiguous_imports, name);
}

/**
 * Check whether a module environment imports a given module.
 *
 * @param self Module environment to inspect.
 * @param module_name Imported module name to check.
 * @return `true` if `module_name` appears in the import set.
 */
func nr_module_env_imports_module(self: ModuleEnv*, module_name: string) -> bool {
    return ss_has(self.imported_modules, module_name);
}

/**
 * Check whether a module environment allows direct `module::name` lookup for a module.
 *
 * @param self Module environment to inspect.
 * @param module_name Module name to check.
 * @return `true` if `module_name` can be used as a qualified namespace.
 */
func nr_module_env_qualifies_module(self: ModuleEnv*, module_name: string) -> bool {
    return ss_has(self.qualified_modules, module_name);
}

/**
 * Look up the module environment bound to an import alias.
 *
 * @param self Module environment to inspect.
 * @param alias Alias namespace to look up.
 * @return Imported module environment for `alias`, or `null`.
 */
func nr_module_env_alias_target(self: ModuleEnv*, alias: string) -> ModuleEnv*? {
    let value = spm_get(self.alias_imports, alias);
    if (value == null) {
        return null;
    }
    return value as ModuleEnv*;
}

/**
 * Check whether one visible imported name currently comes from the implicit `dea` prelude.
 *
 * @param self Module environment to inspect.
 * @param name Imported symbol name to check.
 * @return `true` when `name` currently resolves through the implicit prelude open.
 */
func nr_module_env_has_prelude_name(self: ModuleEnv*, name: string) -> bool {
    return ss_has(self.prelude_imported, name);
}

/**
 * Return pending extern-shadow check count.
 *
 * @param self Module environment to inspect.
 * @return Number of deferred checks.
 */
func nr_module_env_pending_extern_shadow_count(self: ModuleEnv*) -> int {
    return vec_size(self.pending_extern_shadows);
}

/**
 * Return one pending extern-shadow check.
 *
 * @param self Module environment to inspect.
 * @param index Deferred check index.
 * @return Pending extern-shadow check at `index`.
 */
func nr_module_env_pending_extern_shadow_get(self: ModuleEnv*, index: int) -> PendingExternShadow* {
    return ptr_vec_get(self.pending_extern_shadows, index) as PendingExternShadow*;
}

/**
 * Return the names of locally defined symbols.
 *
 * @param self Module environment to inspect.
 * @return New vector of local symbol names.
 */
func nr_module_env_local_keys(self: ModuleEnv*) -> StringVector* {
    return spm_keys(self.locals);
}

/**
 * Return the names of imported symbols.
 *
 * @param self Module environment to inspect.
 * @return New vector of imported symbol names.
 */
func nr_module_env_imported_keys(self: ModuleEnv*) -> StringVector* {
    return spm_keys(self.imported);
}

/**
 * Return the names exported by a module environment.
 *
 * @param self Module environment to inspect.
 * @return New vector of exported symbol names.
 */
func nr_module_env_export_keys(self: ModuleEnv*) -> StringVector* {
    return spm_keys(self.exports);
}

/**
 * Return the names of all visible non-ambiguous symbols.
 *
 * @param self Module environment to inspect.
 * @return New vector of visible symbol names.
 */
func nr_module_env_all_keys(self: ModuleEnv*) -> StringVector* {
    return spm_keys(self.all);
}

/**
 * Add a top-level local symbol to a module environment.
 *
 * @param env Module environment being populated.
 * @param diags Diagnostic collector for duplicate-definition errors.
 * @param name Symbol name.
 * @param sym Symbol to insert.
 */
func nr_define_local(env: ModuleEnv*, diags: DiagCollector*, name: string, sym: Symbol*) {
    if (spm_has(env.locals, name)) {
        nr_span_diag_error(
            diags,
            "RES-0010",
            "duplicate top-level definition of '" + name + "' in module '" + env.module_name + "'",
            env.module_ptr.filename,
            sym.span
        );
        symbol_free(sym);
        return;
    }

    spm_put(env.locals, name, sym as void*);
    spm_put(env.all, name, sym as void*);
}

/**
 * Record a local/imported extern shadow check that needs resolved signatures.
 *
 * @param env Importing module environment.
 * @param imported_module Module that provided the imported symbol.
 * @param name Shadowed symbol name.
 * @param local Local symbol.
 * @param imported Imported symbol.
 */
func nr_add_pending_extern_shadow(env: ModuleEnv*, imported_module: string, name: string, local: Symbol*,
                                  imported: Symbol*) {
    ptr_vec_push(env.pending_extern_shadows,
        new PendingExternShadow(local, imported, imported_module, name) as void*);
}

/**
 * Collect locally declared top-level symbols for one module.
 *
 * @param env Module environment being populated.
 * @param diags Diagnostic collector.
 */
func nr_collect_locals(env: ModuleEnv*, diags: DiagCollector*) {
    let mod = env.module_ptr;
    for (let i = 0; i < vec_size(mod.decls); i = i + 1) {
        let top = ptr_vec_get(mod.decls, i) as TopLevelDecl*;
        match (top.kind) {
            TD_FUNC => {
                let decl = top.data as FuncDecl*;
                let sym = symbol_create(decl.name, SYM_FUNC, env.module_name, "", decl as void*, decl.span);
                sym.is_extern = decl.is_extern;
                nr_define_local(env, diags, decl.name, sym);
            }
            TD_STRUCT => {
                let decl = top.data as StructDecl*;
                nr_define_local(env, diags, decl.name,
                    symbol_create(decl.name, SYM_STRUCT, env.module_name, "", decl as void*, decl.span));
            }
            TD_ENUM => {
                let decl = top.data as EnumDecl*;
                nr_define_local(env, diags, decl.name,
                    symbol_create(decl.name, SYM_ENUM, env.module_name, "", decl as void*, decl.span));
                for (let j = 0; j < vec_size(decl.variants); j = j + 1) {
                    let variant = ptr_vec_get(decl.variants, j) as EnumVariant*;
                    nr_define_local(env, diags, variant.name,
                        symbol_create(variant.name, SYM_ENUM_VARIANT, env.module_name, decl.name, variant as void*,
                            decl.span));
                }
            }
            TD_TYPE_ALIAS => {
                let decl = top.data as TypeAliasDecl*;
                nr_define_local(env, diags, decl.name,
                    symbol_create(decl.name, SYM_TYPE_ALIAS, env.module_name, "", decl as void*, decl.span));
            }
            TD_LET => {
                let decl = top.data as LetDecl*;
                let sym2 = symbol_create(decl.name, SYM_LET, env.module_name, "", decl as void*, decl.span);
                sym2.is_const = decl.is_const;
                nr_define_local(env, diags, decl.name, sym2);
            }
        }
    }
}

/**
 * Return whether a top-level name is exported by default.
 *
 * @param name Symbol name.
 * @return `true` if `name` does not begin with `_`.
 */
func nr_default_exports_name(name: string) -> bool {
    return !starts_with_s(name, "_");
}

/**
 * Return whether a parsed export manifest marks a name as opaque.
 *
 * @param manifest Export manifest to inspect.
 * @param name Exported name.
 * @return `true` when `name` was written with the `opaque` qualifier.
 */
func nr_manifest_name_is_opaque(manifest: ExportManifest*, name: string) -> bool {
    for (let i = 0; i < sv_size(manifest.opaque_names); i = i + 1) {
        if (sv_get(manifest.opaque_names, i) == name) {
            return true;
        }
    }
    return false;
}

/**
 * Export the variants of every transparently exported enum.
 *
 * Enum variants are derived members of their owning enum's public surface,
 * not independently exportable top-level declarations.
 *
 * @param env Module environment whose base export set is complete.
 */
func nr_export_transparent_enum_variants(env: ModuleEnv*) {
    for (let i = 0; i < spm_capacity(env.locals); i = i + 1) {
        if (!spm_slot_occupied(env.locals, i)) {
            continue;
        }
        let name = spm_slot_key(env.locals, i);
        let sym = spm_slot_value(env.locals, i) as Symbol*;
        if (ord(sym.kind) != ord(SYM_ENUM_VARIANT)) {
            continue;
        }
        let owner = spm_get(env.exports, sym.owner_name);
        if (owner == null || ord((owner as Symbol*).kind) != ord(SYM_ENUM) ||
            ss_has(env.opaque_exports, sym.owner_name)) {
            continue;
        }
        spm_put(env.exports, name, sym as void*);
    }
}

/**
 * Compute one module's exported symbol map from its manifest and locals.
 *
 * @param env Module environment being populated.
 * @param diags Diagnostic collector.
 */
func nr_compute_exports(env: ModuleEnv*, diags: DiagCollector*) {
    let manifest = env.module_ptr.export_manifest;
    if (manifest == null) {
        for (let i = 0; i < spm_capacity(env.locals); i = i + 1) {
            if (spm_slot_occupied(env.locals, i)) {
                let name = spm_slot_key(env.locals, i);
                let sym = spm_slot_value(env.locals, i) as Symbol*;
                if (ord(sym.kind) != ord(SYM_ENUM_VARIANT) && nr_default_exports_name(name)) {
                    spm_put(env.exports, name, sym as void*);
                }
            }
        }
        nr_export_transparent_enum_variants(env);
        return;
    }

    let m = manifest as ExportManifest*;
    if (m.export_all) {
        for (let j = 0; j < spm_capacity(env.locals); j = j + 1) {
            if (spm_slot_occupied(env.locals, j)) {
                let sym2 = spm_slot_value(env.locals, j) as Symbol*;
                if (ord(sym2.kind) != ord(SYM_ENUM_VARIANT)) {
                    spm_put(env.exports, spm_slot_key(env.locals, j), sym2 as void*);
                }
            }
        }
        nr_export_transparent_enum_variants(env);
        return;
    }

    with (let seen = ss_create() => ss_free(seen)) {
        for (let name_i = 0; name_i < sv_size(m.names); name_i = name_i + 1) {
            let export_name = sv_get(m.names, name_i);
            if (ss_has(seen, export_name)) {
                nr_span_diag_error(
                    diags,
                    "RES-0030",
                    "duplicate name '" + export_name + "' in export manifest",
                    env.module_ptr.filename,
                    m.span
                );
                continue;
            }
            ss_add(seen, export_name);

            let sym = nr_module_env_local(env, export_name);
            if (sym == null || ord((sym as Symbol*).kind) == ord(SYM_ENUM_VARIANT)) {
                nr_span_diag_error(
                    diags,
                    "RES-0031",
                    "export manifest names unknown top-level symbol '" + export_name + "' in module '" + env.module_name + "'",
                    env.module_ptr.filename,
                    m.span
                );
                continue;
            }
            spm_put(env.exports, export_name, sym as void*);
            if (nr_manifest_name_is_opaque(m, export_name)) {
                let exported_sym = sym as Symbol*;
                if (ord(exported_sym.kind) == ord(SYM_STRUCT) || ord(exported_sym.kind) == ord(SYM_ENUM)) {
                    ss_add(env.opaque_exports, export_name);
                } else {
                    nr_span_diag_error(
                        diags,
                        "RES-0039",
                        "`opaque` export requires a struct or enum type; '" + export_name + "' is " + symbol_kind_name(exported_sym.kind),
                        env.module_ptr.filename,
                        m.span
                    );
                }
            }
        }
    }
    nr_export_transparent_enum_variants(env);
}

/**
 * Return whether two imported symbol handles identify the same top-level symbol.
 *
 * @param left First symbol.
 * @param right Second symbol.
 * @return `true` when both handles point at the same exported symbol identity.
 */
func nr_symbols_same_identity(left: Symbol*, right: Symbol*) -> bool {
    return left.module_name == right.module_name &&
        left.name == right.name &&
        left.owner_name == right.owner_name &&
        ord(left.kind) == ord(right.kind);
}

/**
 * Return whether a string vector already contains a name.
 *
 * @param values Vector to inspect.
 * @param name Name to look up.
 * @return `true` if `name` is present.
 */
func nr_sv_has(values: StringVector*, name: string) -> bool {
    for (let i = 0; i < sv_size(values); i = i + 1) {
        if (sv_get(values, i) == name) {
            return true;
        }
    }
    return false;
}

/**
 * Format names as a comma-separated quoted list for diagnostics.
 *
 * @param names Names to format.
 * @return String such as `'a', 'b', 'c'`.
 */
func nr_format_quoted_names(names: StringVector*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(names); i = i + 1) {
            if (i > 0) {
                sb_append(sb, ", ");
            }
            sb_append(sb, "'");
            sb_append(sb, sv_get(names, i));
            sb_append(sb, "'");
        }
        return sb_to_string(sb);
    }
}

/**
 * Import one symbol into a module environment's unqualified import surface.
 *
 * @param env Importing module environment.
 * @param imported_env Imported module environment.
 * @param diags Diagnostic collector.
 * @param name Imported symbol name.
 * @param sym Imported symbol.
 */
func nr_import_symbol(env: ModuleEnv*, imported_env: ModuleEnv*, diags: DiagCollector*, name: string, sym: Symbol*) {
    if (spm_has(env.alias_imports, name)) {
        nr_span_diag_error(
            diags,
            "RES-0034",
            "name '" + name + "' cannot be used both as an import alias and as a visible symbol in module '" + env.module_name + "'",
            env.module_ptr.filename,
            env.module_ptr.span
        );
        return;
    }

    let local_sym = nr_module_env_local(env, name);
    if (local_sym != null) {
        let local = local_sym as Symbol*;
        if (nr_extern_signatures_compatible(local, sym)) {
            nr_span_diag_warn(
                diags,
                "RES-0020",
                "imported extern function '" + nr_build_top_key(imported_env.module_name, name) + "' will be shadowed by a compatible local extern declaration in module '" + env.module_name + "'",
                env.module_ptr.filename,
                local.span
            );
        } else if (ord(local.kind) == ord(SYM_FUNC) && ord(sym.kind) == ord(SYM_FUNC) &&
                   local.is_extern && sym.is_extern && sym.decl_ptr == null) {
            nr_add_pending_extern_shadow(env, imported_env.module_name, name, local, sym);
        } else {
            nr_span_diag_warn(
                diags,
                "RES-0021",
                "imported symbol '" + nr_build_top_key(imported_env.module_name, name) + "' will be shadowed by a local definition in module '" + env.module_name + "'",
                env.module_ptr.filename,
                local.span
            );
        }
        return;
    }

    if (spm_has(env.imported, name)) {
        let existing_import = nr_module_env_imported(env, name) as Symbol*;
        if (nr_symbols_same_identity(existing_import, sym)) {
            return;
        }

        if (nr_module_env_has_prelude_name(env, name)) {
            nr_span_diag_warn(
                diags,
                "RES-0021",
                "imported symbol '" + nr_build_top_key(existing_import.module_name, name) +
                    "' will be shadowed by imported symbol '" + nr_build_top_key(imported_env.module_name, name) +
                    "' in module '" + env.module_name + "'",
                env.module_ptr.filename,
                env.module_ptr.span
            );
            spm_remove(env.imported, name);
            spm_remove(env.all, name);
            spm_put(env.imported, name, sym as void*);
            if (!ss_has(env.ambiguous_imports, name)) {
                spm_put(env.all, name, sym as void*);
            }
            ss_remove(env.prelude_imported, name);
            return;
        }
        nr_span_diag_warn(
            diags,
            "RES-0022",
            "symbol '" + name + "' imported from multiple modules into '" + env.module_name + "'",
            env.module_ptr.filename,
            env.module_ptr.span
        );
        ss_add(env.ambiguous_imports, name);
        spm_remove(env.all, name);
        return;
    }

    spm_put(env.imported, name, sym as void*);
    if (!ss_has(env.ambiguous_imports, name)) {
        spm_put(env.all, name, sym as void*);
    }
}

/**
 * Merge one imported module's exported symbols into a module environment.
 *
 * @param env Importing module environment.
 * @param imported_env Imported module environment.
 * @param diags Diagnostic collector.
 * @param imp Import declaration being processed.
 */
func nr_open_imports_one(env: ModuleEnv*, imported_env: ModuleEnv*, diags: DiagCollector*, imp: Import*?) {
    for (let i = 0; i < spm_capacity(imported_env.exports); i = i + 1) {
        if (spm_slot_occupied(imported_env.exports, i)) {
            nr_import_symbol(env, imported_env, diags, spm_slot_key(imported_env.exports, i),
                spm_slot_value(imported_env.exports, i) as Symbol*);
        }
    }
}

/**
 * Bind an import alias namespace.
 *
 * @param env Importing module environment.
 * @param imported_env Imported module environment.
 * @param diags Diagnostic collector.
 * @param imp Alias import declaration.
 */
func nr_bind_import_alias(env: ModuleEnv*, imported_env: ModuleEnv*, diags: DiagCollector*, imp: Import*) {
    if (spm_has(env.alias_imports, imp.alias)) {
        nr_span_diag_error(
            diags,
            "RES-0033",
            "duplicate import alias '" + imp.alias + "' in module '" + env.module_name + "'",
            env.module_ptr.filename,
            imp.span
        );
        return;
    }

    if (spm_has(env.locals, imp.alias) || spm_has(env.imported, imp.alias) || spm_has(env.all, imp.alias)) {
        nr_span_diag_error(
            diags,
            "RES-0034",
            "name '" + imp.alias + "' cannot be used both as an import alias and as a visible symbol in module '" + env.module_name + "'",
            env.module_ptr.filename,
            imp.span
        );
        return;
    }

    spm_put(env.alias_imports, imp.alias, imported_env as void*);
}

/**
 * Bind selected exported symbols from one imported module.
 *
 * @param env Importing module environment.
 * @param imported_env Imported module environment.
 * @param diags Diagnostic collector.
 * @param imp Selective import declaration.
 */
func nr_bind_selective_import(env: ModuleEnv*, imported_env: ModuleEnv*, diags: DiagCollector*, imp: Import*) {
    let names = imp.names as StringVector*;
    with (let redundant = sv_create(sv_size(names)) => sv_free(redundant)) {
        for (let i = 0; i < sv_size(names); i = i + 1) {
            let name = sv_get(names, i);
            let value = spm_get(imported_env.exports, name);
            if (value == null) {
                nr_span_diag_error(
                    diags,
                    "RES-0032",
                    "module '" + imported_env.module_name + "' does not export symbol '" + name,
                    env.module_ptr.filename,
                    imp.span
                );
                continue;
            }

            let existing_import = nr_module_env_imported(env, name);
            if (existing_import != null &&
                nr_symbols_same_identity(existing_import as Symbol*, value as Symbol*) &&
                !nr_sv_has(redundant, name)) {
                sv_push(redundant, name);
            }
            nr_import_symbol(env, imported_env, diags, name, value as Symbol*);
        }

        if (sv_size(redundant) > 0) {
            nr_span_diag_warn(
                diags,
                "RES-0035",
                "redundant import: " + nr_format_quoted_names(redundant) + " already imported from '" + imported_env.module_name + "'",
                env.module_ptr.filename,
                imp.span
            );
        }
    }
}

/**
 * Resolve and open every import for a module environment.
 *
 * @param nr Full name-resolution state.
 * @param env Module environment being populated.
 * @param diags Diagnostic collector.
 */
func nr_open_imports(nr: NameResolution*, env: ModuleEnv*, diags: DiagCollector*) {
    if (!dea_is_virtual_module_name(env.module_name)) {
        let dea_env = nr_env_find(nr, dea_module_name());
        if (dea_env != null) {
            ss_add(env.imported_modules, dea_module_name());
            ss_add(env.qualified_modules, dea_module_name());
            nr_open_imports_one(env, dea_env as ModuleEnv*, diags, null);
            for (let i = 0; i < spm_capacity((dea_env as ModuleEnv*).locals); i = i + 1) {
                if (!spm_slot_occupied((dea_env as ModuleEnv*).locals, i)) {
                    continue;
                }
                let name = spm_slot_key((dea_env as ModuleEnv*).locals, i);
                if (spm_has(env.imported, name) && !ss_has(env.ambiguous_imports, name) &&
                    ((nr_module_env_imported(env, name) as Symbol*)).module_name == dea_module_name()) {
                    ss_add(env.prelude_imported, name);
                }
            }
        }
    }

    let mod = env.module_ptr;
    for (let i = 0; i < vec_size(mod.imports); i = i + 1) {
        let imp = ptr_vec_get(mod.imports, i) as Import*;
        if (dea_is_virtual_module_name(imp.name)) {
            continue;
        }
        ss_add(env.imported_modules, imp.name);
        let imported_env = nr_env_find(nr, imp.name);
        if (imported_env == null) {
            nr_span_diag_error(
                diags,
                "RES-0029",
                "unknown imported module '" + imp.name + "' in module '" + env.module_name + "'",
                env.module_ptr.filename,
                env.module_ptr.span
            );
            continue;
        }
        match (imp.kind) {
            IMPORT_OPEN => {
                if (ss_has(env.open_import_modules, imp.name)) {
                    nr_span_diag_warn(
                        diags,
                        "RES-0036",
                        "duplicated 'import " + imp.name + "'",
                        env.module_ptr.filename,
                        imp.span
                    );
                }
                ss_add(env.open_import_modules, imp.name);
                ss_add(env.qualified_modules, imp.name);
                nr_open_imports_one(env, imported_env as ModuleEnv*, diags, imp);
            }
            IMPORT_ALIAS => {
                nr_bind_import_alias(env, imported_env as ModuleEnv*, diags, imp);
            }
            IMPORT_SELECTIVE => {
                nr_bind_selective_import(env, imported_env as ModuleEnv*, diags, imp);
            }
        }
    }
}

/**
 * Create an empty module environment for a parsed module.
 *
 * @param module_ptr Parsed module.
 * @return New module environment for `module_ptr`.
 */
func nr_make_env(module_ptr: Module*) -> ModuleEnv* {
    return nr_make_owned_env(module_ptr, false);
}

/**
 * Create an empty module environment with explicit ownership for the backing module node.
 *
 * @param module_ptr Module node backing the environment.
 * @param module_ptr_owned Whether `module_ptr` should be freed with the environment.
 * @return New module environment.
 */
func nr_make_owned_env(module_ptr: Module*, module_ptr_owned: bool) -> ModuleEnv* {
    return new ModuleEnv(
        module_ptr.name,
        module_ptr,
        module_ptr_owned,
        spm_create(),
        spm_create(),
        ss_create(),
        spm_create(),
        spm_create(),
        ss_create(),
        ss_create(),
        ss_create(),
        ss_create(),
        spm_create(),
        ss_create(),
        ptr_vec_create(0)
    );
}

/**
 * Create the synthesized `dea` module environment.
 *
 * @return New owned `dea` environment.
 */
func nr_make_dea_env() -> ModuleEnv* {
    let module_ptr = dea_make_virtual_module();
    let env = nr_make_owned_env(module_ptr, true);
    dea_populate_locals(env.locals, env.all);
    return env;
}

/**
 * Create the synthetic module node used by an interface-backed environment.
 *
 * @param mi Interface backing the module environment.
 * @return New empty module node for the interface provider.
 */
func nr_make_interface_module(mi: ModuleInterface*) -> Module* {
    return new Module(mi.module_name, null, ptr_vec_create(0), ptr_vec_create(0), dea_zero_span(),
        "<interface:" + mi.module_name + ">");
}

/**
 * Define an interface-backed local/exported symbol.
 *
 * @param env Interface module environment being populated.
 * @param diags Diagnostic collector.
 * @param name Symbol name.
 * @param kind Symbol kind.
 * @param owner_name Owner name for enum variants, otherwise empty.
 * @param resolved_type Optional resolved type to clone into the symbol.
 * @param span Source/interface span for diagnostics.
 */
func nr_define_interface_symbol(env: ModuleEnv*, diags: DiagCollector*, name: string, kind: SymbolKind,
                                owner_name: string, resolved_type: Type*?, span: Span, is_const: bool,
                                const_literal: string, is_extern: bool) {
    let sym = symbol_create(name, kind, env.module_name, owner_name, null, span);
    if (resolved_type != null) {
        symbol_set_type_clone(sym, resolved_type as Type*);
    }
    sym.is_const = is_const;
    sym.const_literal = const_literal;
    sym.is_extern = is_extern;
    nr_define_local(env, diags, name, sym);
}

/**
 * Mark every local interface symbol as exported.
 *
 * @param env Interface module environment.
 */
func nr_export_all_interface_symbols(env: ModuleEnv*) {
    for (let i = 0; i < spm_capacity(env.locals); i = i + 1) {
        if (spm_slot_occupied(env.locals, i)) {
            spm_put(env.exports, spm_slot_key(env.locals, i), spm_slot_value(env.locals, i));
        }
    }
}

/**
 * Populate one module environment from parsed interface metadata.
 *
 * @param env Interface-backed environment to populate.
 * @param mi Interface metadata.
 * @param diags Diagnostic collector.
 */
func nr_populate_interface_env(env: ModuleEnv*, mi: ModuleInterface*, diags: DiagCollector*) {
    for (let i = 0; i < vec_size(mi.struct_infos); i = i + 1) {
        let info = ptr_vec_get(mi.struct_infos, i) as StructInfo*;
        nr_define_interface_symbol(env, diags, info.name, SYM_STRUCT, "", info.struct_type, info.span, false, "",
            false);
        if (info.is_opaque) {
            ss_add(env.opaque_exports, info.name);
        }
    }

    for (let enum_i = 0; enum_i < vec_size(mi.enum_infos); enum_i = enum_i + 1) {
        let info2 = ptr_vec_get(mi.enum_infos, enum_i) as EnumInfo*;
        nr_define_interface_symbol(env, diags, info2.name, SYM_ENUM, "", info2.enum_type, info2.span, false, "",
            false);
        if (info2.is_opaque) {
            ss_add(env.opaque_exports, info2.name);
        } else {
            for (let variant_i = 0; variant_i < vec_size(info2.variants); variant_i = variant_i + 1) {
                let variant = ptr_vec_get(info2.variants, variant_i) as EnumVariantInfo*;
                nr_define_interface_symbol(env, diags, variant.name, SYM_ENUM_VARIANT, info2.name, info2.enum_type,
                    info2.span, false, "", false);
            }
        }
    }

    for (let alias_i = 0; alias_i < vec_size(mi.alias_entries); alias_i = alias_i + 1) {
        let entry = ptr_vec_get(mi.alias_entries, alias_i) as InterfaceAliasEntry*;
        nr_define_interface_symbol(env, diags, entry.name, SYM_TYPE_ALIAS, "", entry.ty, dea_zero_span(), false, "",
            false);
    }

    for (let func_i = 0; func_i < vec_size(mi.func_entries); func_i = func_i + 1) {
        let entry2 = ptr_vec_get(mi.func_entries, func_i) as InterfaceFuncEntry*;
        nr_define_interface_symbol(env, diags, entry2.name, SYM_FUNC, "", entry2.ty, dea_zero_span(), false, "",
            entry2.is_extern);
    }

    for (let let_i = 0; let_i < vec_size(mi.let_entries); let_i = let_i + 1) {
        let entry3 = ptr_vec_get(mi.let_entries, let_i) as InterfaceLetEntry*;
        nr_define_interface_symbol(env, diags, entry3.name, SYM_LET, "", entry3.ty, dea_zero_span(),
            entry3.is_const, entry3.literal, false);
    }

    nr_export_all_interface_symbols(env);
}

/**
 * Create a module environment backed by a parsed `.l1m` interface.
 *
 * @param mi Interface backing the environment.
 * @param diags Diagnostic collector.
 * @return New owned interface environment.
 */
func nr_make_interface_env(mi: ModuleInterface*, diags: DiagCollector*) -> ModuleEnv* {
    let module_ptr = nr_make_interface_module(mi);
    let env = nr_make_owned_env(module_ptr, true);
    nr_populate_interface_env(env, mi, diags);
    return env;
}

/**
 * Return sorted module-environment names.
 *
 * @param self Name-resolution result to inspect.
 * @return Sorted module names.
 */
func nr_env_names_sorted(self: NameResolution*) -> StringVector* {
    let names = spm_keys(self.by_name);
    sv_sort(names);
    return names;
}

/**
 * Build module environments and resolve opened imports.
 *
 * @param driver_state Parsed driver state.
 * @param diags Diagnostic collector.
 * @return Name-resolution result containing per-module environments.
 */
func nr_resolve(driver_state: DriverState*, diags: DiagCollector*) -> NameResolution* {
    let result = new NameResolution(
        ptr_vec_create(driver_unit_count(driver_state) + driver_interface_count(driver_state) + 1),
        spm_create(),
        ptr_vec_create(16),
        ss_create()
    );

    for (let i = 0; i < driver_unit_count(driver_state); i = i + 1) {
        let unit = driver_unit_get(driver_state, i);
        if (unit.parse_result.root_module == null) {
            continue;
        }

        let module_ptr = unit.parse_result.root_module as Module*;
        let env = nr_make_env(module_ptr);
        ptr_vec_push(result.envs, env as void*);
        spm_put(result.by_name, env.module_name, env as void*);
    }

    for (let iface_i = 0; iface_i < driver_interface_count(driver_state); iface_i = iface_i + 1) {
        let iface = driver_interface_get(driver_state, iface_i);
        if (spm_get(result.by_name, iface.module_name) != null) {
            continue;
        }
        let iface_env = nr_make_interface_env(iface, diags);
        ptr_vec_push(result.envs, iface_env as void*);
        spm_put(result.by_name, iface_env.module_name, iface_env as void*);
    }

    let dea_env = nr_make_dea_env();
    ptr_vec_push(result.envs, dea_env as void*);
    spm_put(result.by_name, dea_env.module_name, dea_env as void*);

    for (let env_i = 0; env_i < vec_size(result.envs); env_i = env_i + 1) {
        nr_collect_locals(ptr_vec_get(result.envs, env_i) as ModuleEnv*, diags);
    }

    for (let export_i = 0; export_i < vec_size(result.envs); export_i = export_i + 1) {
        nr_compute_exports(ptr_vec_get(result.envs, export_i) as ModuleEnv*, diags);
    }

    for (let import_i = 0; import_i < vec_size(result.envs); import_i = import_i + 1) {
        nr_open_imports(result, ptr_vec_get(result.envs, import_i) as ModuleEnv*, diags);
    }

    return result;
}
