/** One typed standalone-link input with optional verified Dea authority. */
struct LinkInput {
    kind: LinkOperandKind;
    value: string;
    interface_path: string?;
    interface: ModuleInterface*?;
    visit_state: int;
}

/** Verified standalone link set and its deterministic lifecycle order. */
struct LinkPlan {
    inputs: VectorBase*; /* LinkInput* in CLI encounter order */
    modules_by_name: StringPtrMap*; /* module name -> borrowed LinkInput* */
    lifecycle_order: StringVector*;
    entry_module: string;
}

/** One explicit dependency-walk frame. */
struct LinkVisitFrame {
    input: LinkInput*;
    next_import: int;
}

/** One semantic provider and the consumers that require import reachability. */
struct LinkProvenanceTarget {
    provider_name: string;
    consumers: StringVector*;
    consumer_set: StringSet*;
}

/** Fixed paths owned by one standalone-link transaction. */
struct LinkTransaction {
    root: string;
    wrapper_c: string;
    wrapper_object: string;
    compile_stdout: string;
    compile_stderr: string;
    link_stdout: string;
    link_stderr: string;
}

/** Resolved wrapper include directory and exact public runtime header. */
struct LinkRuntimeInclude {
    directory: string;
    header_path: string;
}

/** Create one pointer-element vector. */
func ld_ptr_vec_create(capacity: int) -> VectorBase* {
    return vec_create(sizeof(void*), capacity);
}

/** Append one pointer to a pointer-element vector. */
func ld_ptr_vec_push(values: VectorBase*, value: void*) {
    vec_push_ptr(values, value);
}

/** Read one pointer from a pointer-element vector. */
func ld_ptr_vec_get(values: VectorBase*, index: int) -> void* {
    return *(vec_get(values, index) as void**);
}

/** Free an owned vector of dependency-walk frames. */
func ld_visit_frames_free(frames: VectorBase*) {
    for (let i = 0; i < vec_size(frames); i = i + 1) {
        let frame = ld_ptr_vec_get(frames, i) as LinkVisitFrame*;
        drop frame;
    }
    vec_free(frames);
}

/** Remove and release the final string-vector entry. */
func ld_string_vector_pop(values: StringVector*) {
    let last = sv_size(values) - 1;
    let slot = vec_get(values, last) as string*;
    *slot = "";
    values.length = last;
}

/** Emit one link-driver diagnostic without source coordinates. */
func ld_error(diags: DiagCollector*, code: string, message: string, path: string) {
    diag_error(diags, "l1c", code, message, path, 0, 0, 0, 0);
}

/** Create one typed link input, taking ownership of its optional interface. */
func ld_input_create(
    kind: LinkOperandKind,
    value: string,
    interface_path: string?,
    interface: ModuleInterface*?
) -> LinkInput* {
    return new LinkInput(kind, value, interface_path, interface, 0);
}

/** Create one opaque foreign input. */
func ld_foreign_input_create(object_path: string) -> LinkInput* {
    return ld_input_create(LOK_FOREIGN_OBJECT, object_path, null, null);
}

/** Return the verified interface owned by one Dea input. */
func ld_input_interface(input: LinkInput*) -> ModuleInterface* {
    return input.interface as ModuleInterface*;
}

/** Free one typed link input. */
func ld_input_free(input: LinkInput*) {
    if (input.interface != null) {
        mi_free(input.interface as ModuleInterface*);
    }
    drop input;
}

/** Free an owned vector of typed link inputs. */
func ld_inputs_free(inputs: VectorBase*) {
    for (let i = 0; i < vec_size(inputs); i = i + 1) {
        ld_input_free(ld_ptr_vec_get(inputs, i) as LinkInput*);
    }
    vec_free(inputs);
}

/** Free a verified link plan and every typed input it owns. */
func ld_plan_free(plan: LinkPlan*) {
    ld_inputs_free(plan.inputs);
    spm_free(plan.modules_by_name);
    sv_free(plan.lifecycle_order);
    drop plan;
}

/** Return one verified input by its encounter index. */
func ld_plan_input_get(plan: LinkPlan*, index: int) -> LinkInput* {
    return ld_ptr_vec_get(plan.inputs, index) as LinkInput*;
}

/** Return whether one typed link input names a caller-selected native file. */
func ld_input_is_native(input: LinkInput*) -> bool {
    return ord(input.kind) == ord(LOK_DEA_OBJECT) ||
        ord(input.kind) == ord(LOK_FOREIGN_OBJECT);
}

/** Return the original caller-selected native path used by the host linker. */
func ld_input_link_path(input: LinkInput*) -> string {
    return input.value;
}

/** Free a resolved runtime include bundle. */
func ld_runtime_include_free(runtime_include: LinkRuntimeInclude*) {
    drop runtime_include;
}

/** Join canonical module names for deterministic diagnostics. */
func ld_join_module_names(names: StringVector*) -> string {
    with (let out = cb_create() => cb_free(out)) {
        for (let i = 0; i < sv_size(names); i = i + 1) {
            if (i > 0) {
                cb_append_s(out, ", ");
            }
            cb_append_s(out, sv_get(names, i));
        }
        return cb_to_string(out);
    }
}

/** Format the canonical cycle ending at `module_name`. */
func ld_format_cycle(stack: StringVector*, module_name: string) -> string {
    let start = 0;
    for (let i = 0; i < sv_size(stack); i = i + 1) {
        if (sv_get(stack, i) == module_name) {
            start = i;
            break;
        }
    }

    with (let out = cb_create() => cb_free(out)) {
        for (let i = start; i < sv_size(stack); i = i + 1) {
            if (i > start) {
                cb_append_s(out, " -> ");
            }
            cb_append_s(out, sv_get(stack, i));
        }
        if (sv_size(stack) > start) {
            cb_append_s(out, " -> ");
        }
        cb_append_s(out, module_name);
        return cb_to_string(out);
    }
}

/** Validate every owned Dea interface before any identity is registered. */
func ld_verify_interfaces(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;
    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (ord(input.kind) != ord(LOK_DEA_OBJECT)) {
            assert(input.interface_path == null && input.interface == null,
                "[ICE-2112] non-Dea link input carries Dea interface state");
            continue;
        }
        if (input.interface_path == null || input.interface == null) {
            ld_error(
                diags,
                "DRV-0074",
                "required sibling module interface was not provided for object: " +
                    input.value,
                input.value
            );
            ok = false;
            continue;
        }
        if (!ifp_verify(
                input.interface as ModuleInterface*,
                diags,
                input.interface_path as string)) {
            ok = false;
        }
    }
    return ok;
}

/** Assert the ownership shape promised by an already-verified CLI input set. */
func _ld_assert_verified_input_invariants(plan: LinkPlan*) {
    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (ord(input.kind) != ord(LOK_DEA_OBJECT)) {
            assert(input.interface_path == null && input.interface == null,
                "[ICE-2112] non-Dea link input carries Dea interface state");
        } else {
            assert(input.interface_path != null && input.interface != null,
                "[ICE-2113] verified Dea link input is missing interface state");
        }
    }
}

/** Register identities from the complete already-verified interface set. */
func ld_register_modules(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;
    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (ord(input.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(input);
        if (spm_has(plan.modules_by_name, interface.module_name)) {
            let previous = spm_get(
                plan.modules_by_name, interface.module_name) as LinkInput*;
            ld_error(
                diags,
                "L1C-2100",
                "duplicate Dea module identity '" + interface.module_name +
                    "' in sibling interfaces for '" + previous.value +
                    "' and '" + input.value + "'",
                input.interface_path as string
            );
            ok = false;
            continue;
        }
        spm_put(plan.modules_by_name, interface.module_name, input as void*);
    }
    return ok;
}

/** Validate one unique provider expectation against the explicit Dea set. */
func ld_validate_provider_expectation(
    plan: LinkPlan*,
    consumer: LinkInput*,
    provider_name: string,
    expected: string,
    seen: StringSet*,
    diags: DiagCollector*
) -> bool {
    if (dea_is_virtual_module_name(provider_name) || ss_has(seen, provider_name)) {
        return true;
    }
    ss_add(seen, provider_name);

    let provider_value = spm_get(plan.modules_by_name, provider_name);
    let consumer_interface = ld_input_interface(consumer);
    if (provider_value == null) {
        ld_error(
            diags,
            "L1C-2101",
            "Dea module '" + consumer_interface.module_name +
                "' names missing provider module '" + provider_name + "'",
            consumer.interface_path as string
        );
        return false;
    }

    let provider = provider_value as LinkInput*;
    let supplied = ld_input_interface(provider).fingerprint;
    if (expected != supplied) {
        ld_error(
            diags,
            "L1C-2102",
            "Dea module '" + consumer_interface.module_name + "' expects provider '" +
                provider_name + "' fingerprint '" + expected +
                "', but supplied interface '" + provider.interface_path as string +
                "' carries '" + supplied + "'",
            consumer.interface_path as string
        );
        return false;
    }
    return true;
}

/** Validate provider presence and supplied fingerprints across all manifests. */
func ld_validate_dependencies(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;

    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let consumer = ld_plan_input_get(plan, i);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(consumer);
        with (let seen = ss_create() => ss_free(seen)) {
            for (let import_i = 0; import_i < vec_size(interface.module_imports);
                 import_i = import_i + 1) {
                let imported = ld_ptr_vec_get(
                    interface.module_imports, import_i) as InterfaceModuleImport*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, imported.provider_module,
                        imported.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
            for (let req_i = 0; req_i < vec_size(interface.require_entries);
                 req_i = req_i + 1) {
                let required = ld_ptr_vec_get(
                    interface.require_entries, req_i) as InterfaceDepEntry*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, required.provider_module,
                        required.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
            for (let link_i = 0; link_i < vec_size(interface.link_entries);
                 link_i = link_i + 1) {
                let linked = ld_ptr_vec_get(
                    interface.link_entries, link_i) as InterfaceDepEntry*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, linked.provider_module,
                        linked.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
        }
    }

    return ok;
}

/** Resolve the explicit or inferred Dea entry module. */
func ld_select_entry(
    plan: LinkPlan*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> string? {
    if (explicit_entry != null) {
        let requested = explicit_entry as string;
        let input_value = spm_get(plan.modules_by_name, requested);
        if (input_value == null) {
            ld_error(
                diags,
                "L1C-2104",
                "explicit entry module '" + requested + "' is not present in the Dea link set",
                ""
            );
            return null;
        }
        let input = input_value as LinkInput*;
        if (!ld_input_interface(input).has_entry) {
            ld_error(
                diags,
                "L1C-2104",
                "explicit entry module '" + requested +
                    "' does not carry 'entry;' in its interface",
                input.interface_path as string
            );
            return null;
        }
        return slice_s(requested, 0, len_s(requested));
    }

    with (let candidates = sv_create(2) => sv_free(candidates)) {
        for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
            let input2 = ld_plan_input_get(plan, i);
            if (ord(input2.kind) == ord(LOK_DEA_OBJECT) &&
                ld_input_interface(input2).has_entry) {
                sv_push(candidates, ld_input_interface(input2).module_name);
            }
        }
        sv_sort(candidates);

        if (sv_size(candidates) == 0) {
            ld_error(
                diags,
                "L1C-2104",
                "Dea link set has no entry module; supply an interface carrying 'entry;'",
                ""
            );
            return null;
        }
        if (sv_size(candidates) > 1) {
            ld_error(
                diags,
                "L1C-2104",
                "Dea link set has multiple entry modules: " +
                    ld_join_module_names(candidates) +
                    "; select one with '--entry'",
                ""
            );
            return null;
        }
        let selected = sv_get(candidates, 0);
        return slice_s(selected, 0, len_s(selected));
    }
}

/** Visit one Dea module in dependency-first order without native recursion. */
func ld_visit_module(
    plan: LinkPlan*,
    input: LinkInput*,
    stack: StringVector*,
    diags: DiagCollector*
) -> bool {
    if (input.visit_state == 2) {
        return true;
    }

    let interface = ld_input_interface(input);
    if (input.visit_state == 1) {
        ld_error(
            diags,
            "L1C-2103",
            "Dea lifecycle import cycle: " +
                ld_format_cycle(stack, interface.module_name),
            input.interface_path as string
        );
        return false;
    }

    with (let frames = ld_ptr_vec_create(8) =>
              ld_visit_frames_free(frames)) {
        input.visit_state = 1;
        sv_push(stack, interface.module_name);
        ld_ptr_vec_push(
            frames, new LinkVisitFrame(input, 0) as void*);

        while (vec_size(frames) > 0) {
            let frame_i = vec_size(frames) - 1;
            let frame = ld_ptr_vec_get(
                frames, frame_i) as LinkVisitFrame*;
            let frame_interface = ld_input_interface(frame.input);

            if (frame.next_import <
                vec_size(frame_interface.module_imports)) {
                let imported = ld_ptr_vec_get(
                    frame_interface.module_imports,
                    frame.next_import
                ) as InterfaceModuleImport*;
                let provider = spm_get(
                    plan.modules_by_name,
                    imported.provider_module
                ) as LinkInput*;
                frame.next_import = frame.next_import + 1;

                if (provider.visit_state == 2) {
                    continue;
                }
                let provider_interface = ld_input_interface(provider);
                if (provider.visit_state == 1) {
                    ld_error(
                        diags,
                        "L1C-2103",
                        "Dea lifecycle import cycle: " +
                            ld_format_cycle(
                                stack, provider_interface.module_name),
                        provider.interface_path as string
                    );
                    return false;
                }

                provider.visit_state = 1;
                sv_push(stack, provider_interface.module_name);
                ld_ptr_vec_push(
                    frames, new LinkVisitFrame(provider, 0) as void*);
                continue;
            }

            ld_string_vector_pop(stack);
            frame.input.visit_state = 2;
            sv_push(
                plan.lifecycle_order,
                frame_interface.module_name
            );
            frames.length = frame_i;
            drop frame;
        }
    }
    return true;
}

/** Compute the selected-entry-first deterministic lifecycle order. */
func ld_compute_lifecycle_order(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    with (let stack = sv_create(8) => sv_free(stack)) {
        let entry_input = spm_get(
            plan.modules_by_name, plan.entry_module) as LinkInput*;
        if (!ld_visit_module(plan, entry_input, stack, diags)) {
            return false;
        }

        for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
            let input = ld_plan_input_get(plan, i);
            if (ord(input.kind) == ord(LOK_DEA_OBJECT) &&
                input.visit_state == 0 &&
                !ld_visit_module(plan, input, stack, diags)) {
                return false;
            }
        }
    }
    return true;
}

/** Collect one unique non-virtual semantic provider name. */
func ld_collect_provenance_provider(
    providers: StringVector*,
    seen: StringSet*,
    provider_name: string
) {
    if (dea_is_virtual_module_name(provider_name) || ss_has(seen, provider_name)) {
        return;
    }
    ss_add(seen, provider_name);
    sv_push(providers, provider_name);
}

/** Collect unique semantic providers from both interface dependency tiers. */
func ld_collect_interface_provenance_providers(
    interface: ModuleInterface*,
    providers: StringVector*,
    seen: StringSet*
) {
    for (let req_i = 0; req_i < vec_size(interface.require_entries);
         req_i = req_i + 1) {
        let required = ld_ptr_vec_get(
            interface.require_entries, req_i) as InterfaceDepEntry*;
        ld_collect_provenance_provider(
            providers, seen, required.provider_module);
    }
    for (let link_i = 0; link_i < vec_size(interface.link_entries);
         link_i = link_i + 1) {
        let linked = ld_ptr_vec_get(
            interface.link_entries, link_i) as InterfaceDepEntry*;
        ld_collect_provenance_provider(
            providers, seen, linked.provider_module);
    }
}

/** Free one semantic-provider target. */
func ld_provenance_target_free(target: LinkProvenanceTarget*) {
    sv_free(target.consumers);
    ss_free(target.consumer_set);
    drop target;
}

/** Free an owned pointer vector of semantic-provider targets. */
func ld_provenance_targets_free(targets: VectorBase*) {
    for (let i = 0; i < vec_size(targets); i = i + 1) {
        ld_provenance_target_free(
            ld_ptr_vec_get(targets, i) as LinkProvenanceTarget*);
    }
    vec_free(targets);
}

/** Return or create the target bucket for one semantic provider. */
func ld_provenance_target_get_or_create(
    targets: VectorBase*,
    targets_by_provider: StringPtrMap*,
    provider_name: string
) -> LinkProvenanceTarget* {
    let existing = spm_get(targets_by_provider, provider_name);
    if (existing != null) {
        return existing as LinkProvenanceTarget*;
    }
    let target = new LinkProvenanceTarget(
        provider_name,
        sv_create(2),
        ss_create()
    );
    ld_ptr_vec_push(targets, target as void*);
    spm_put(targets_by_provider, provider_name, target as void*);
    return target;
}

/** Collect provider-grouped provenance queries in deterministic encounter order. */
func ld_collect_provenance_targets(
    plan: LinkPlan*,
    targets: VectorBase*,
    targets_by_provider: StringPtrMap*
) {
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let consumer = ld_plan_input_get(plan, input_i);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(consumer);
        if (vec_size(interface.require_entries) == 0 &&
            vec_size(interface.link_entries) == 0) {
            continue;
        }
        with (
            let providers = sv_create(4) => sv_free(providers),
            let provider_seen = ss_create() => ss_free(provider_seen)
        ) {
            ld_collect_interface_provenance_providers(
                interface, providers, provider_seen);
            for (let provider_i = 0; provider_i < sv_size(providers);
                 provider_i = provider_i + 1) {
                let target = ld_provenance_target_get_or_create(
                    targets,
                    targets_by_provider,
                    sv_get(providers, provider_i)
                );
                if (ss_add(target.consumer_set, interface.module_name)) {
                    sv_push(target.consumers, interface.module_name);
                }
            }
        }
    }
}

/** Build reverse lifecycle-import adjacency for every registered Dea module. */
func ld_build_reverse_imports(plan: LinkPlan*) -> StringPtrMap* {
    let reverse = spm_create_with_capacity(vec_size(plan.inputs));
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let input = ld_plan_input_get(plan, input_i);
        if (ord(input.kind) == ord(LOK_DEA_OBJECT)) {
            let interface = ld_input_interface(input);
            spm_put(reverse, interface.module_name, sv_create(2) as void*);
        }
    }

    for (let input_i2 = 0; input_i2 < vec_size(plan.inputs);
         input_i2 = input_i2 + 1) {
        let consumer = ld_plan_input_get(plan, input_i2);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface2 = ld_input_interface(consumer);
        for (let import_i = 0; import_i < vec_size(interface2.module_imports);
             import_i = import_i + 1) {
            let imported = ld_ptr_vec_get(
                interface2.module_imports, import_i) as InterfaceModuleImport*;
            let importers = spm_get(
                reverse, imported.provider_module) as StringVector*;
            sv_push(importers, interface2.module_name);
        }
    }
    return reverse;
}

/** Free reverse adjacency vectors and their owning map. */
func ld_reverse_imports_free(plan: LinkPlan*, reverse: StringPtrMap*) {
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let input = ld_plan_input_get(plan, input_i);
        if (ord(input.kind) == ord(LOK_DEA_OBJECT)) {
            let interface = ld_input_interface(input);
            sv_free(spm_get(
                reverse, interface.module_name) as StringVector*);
        }
    }
    spm_free(reverse);
}

/** Return a collision-free key for one canonical consumer/provider query. */
func ld_provenance_pair_key(consumer_name: string, provider_name: string) -> string {
    return consumer_name + "\n" + provider_name;
}

/** Record every unreachable query for one provider through reverse imports. */
func ld_collect_unreachable_target(
    target: LinkProvenanceTarget*,
    reverse: StringPtrMap*,
    unreachable: StringSet*
) {
    with (
        let visited = ss_create() => ss_free(visited),
        let stack = sv_create(8) => sv_free(stack)
    ) {
        let remaining = sv_size(target.consumers);
        let direct_importers = spm_get(
            reverse, target.provider_name) as StringVector*;
        for (let direct_i = 0; direct_i < sv_size(direct_importers);
             direct_i = direct_i + 1) {
            let direct_importer = sv_get(direct_importers, direct_i);
            if (ss_add(visited, direct_importer)) {
                if (ss_has(target.consumer_set, direct_importer)) {
                    remaining = remaining - 1;
                }
                if (remaining > 0) {
                    sv_push(stack, direct_importer);
                }
            }
        }

        while (sv_size(stack) > 0 && remaining > 0) {
            let last = sv_size(stack) - 1;
            let module_name = sv_get(stack, last);
            ld_string_vector_pop(stack);
            let importers = spm_get(reverse, module_name) as StringVector*;
            for (let importer_i = 0; importer_i < sv_size(importers);
                 importer_i = importer_i + 1) {
                let importer = sv_get(importers, importer_i);
                if (ss_add(visited, importer)) {
                    if (ss_has(target.consumer_set, importer)) {
                        remaining = remaining - 1;
                    }
                    if (remaining > 0) {
                        sv_push(stack, importer);
                    }
                }
            }
        }

        for (let consumer_i = 0; consumer_i < sv_size(target.consumers);
             consumer_i = consumer_i + 1) {
            let consumer_name = sv_get(target.consumers, consumer_i);
            if (!ss_has(visited, consumer_name)) {
                ss_add(unreachable, ld_provenance_pair_key(
                    consumer_name, target.provider_name));
            }
        }
    }
}

/** Emit unreachable-provider diagnostics in the original consumer order. */
func ld_emit_unreachable_provenance(
    plan: LinkPlan*,
    unreachable: StringSet*,
    diags: DiagCollector*
) -> bool {
    let ok = true;
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let consumer = ld_plan_input_get(plan, input_i);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(consumer);
        if (vec_size(interface.require_entries) == 0 &&
            vec_size(interface.link_entries) == 0) {
            continue;
        }
        with (
            let providers = sv_create(4) => sv_free(providers),
            let provider_seen = ss_create() => ss_free(provider_seen)
        ) {
            ld_collect_interface_provenance_providers(
                interface, providers, provider_seen);
            for (let provider_i = 0; provider_i < sv_size(providers);
                 provider_i = provider_i + 1) {
                let provider_name = sv_get(providers, provider_i);
                if (ss_has(unreachable, ld_provenance_pair_key(
                        interface.module_name, provider_name))) {
                    ld_error(
                        diags,
                        "L1C-2111",
                        "Dea module '" + interface.module_name +
                            "' names semantic provider '" + provider_name +
                            "' that is not transitively reachable through " +
                            "'import module' records",
                        consumer.interface_path as string
                    );
                    ok = false;
                }
            }
        }
    }
    return ok;
}

/**
 * Validate `require`/`link` provenance through existing lifecycle imports.
 *
 * Queries are grouped by provider and walked over reverse import edges. Each
 * walk stops after reaching every interested consumer, so shared terminal
 * providers and direct-provider workloads avoid one full forward walk per
 * consumer without materializing a quadratic transitive-closure cache.
 */
func ld_validate_transitive_provenance(
    plan: LinkPlan*,
    diags: DiagCollector*
) -> bool {
    with (
        let targets = ld_ptr_vec_create(8) => ld_provenance_targets_free(targets),
        let targets_by_provider = spm_create() => spm_free(targets_by_provider)
    ) {
        ld_collect_provenance_targets(plan, targets, targets_by_provider);
        if (vec_size(targets) == 0) {
            return true;
        }

        with (
            let reverse = ld_build_reverse_imports(plan) =>
                ld_reverse_imports_free(plan, reverse),
            let unreachable = ss_create() => ss_free(unreachable)
        ) {
            for (let target_i = 0; target_i < vec_size(targets);
                 target_i = target_i + 1) {
                ld_collect_unreachable_target(
                    ld_ptr_vec_get(targets, target_i) as LinkProvenanceTarget*,
                    reverse,
                    unreachable
                );
            }
            return ld_emit_unreachable_provenance(plan, unreachable, diags);
        }
    }
}

/** Complete planning from a set whose interfaces are already verified. */
func _ld_prepare_verified_plan(
    plan: LinkPlan*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> LinkPlan*? {
    _ld_assert_verified_input_invariants(plan);

    if (!ld_register_modules(plan, diags) ||
        !ld_validate_dependencies(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }

    let entry = ld_select_entry(plan, explicit_entry, diags);
    if (entry == null) {
        ld_plan_free(plan);
        return null;
    }
    plan.entry_module = entry as string;

    if (!ld_compute_lifecycle_order(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }
    if (!ld_validate_transitive_provenance(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }
    return plan;
}

/**
 * Validate already constructed inputs and build one link plan.
 *
 * Ownership of `inputs` transfers to this function whether it succeeds or
 * fails. Tests may use this boundary to construct interfaces without writing
 * temporary native object files.
 */
func ld_prepare_inputs(
    inputs: VectorBase*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> LinkPlan*? {
    let plan = new LinkPlan(inputs, spm_create(), sv_create(vec_size(inputs)), "");
    if (!ld_verify_interfaces(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }
    return _ld_prepare_verified_plan(plan, explicit_entry, diags);
}

/** Copy parser diagnostics into the link-driver collector. */
func ld_copy_interface_diags(
    diags: DiagCollector*,
    parsed: InterfaceParseResult*
) {
    for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
        diag_copy(diags, diag_get(parsed.diags, i));
    }
}

/** Read, decode, parse, and verify one authoritative sibling interface. */
func ld_load_sibling_interface(
    object_path: string,
    interface_path: string,
    diags: DiagCollector*
) -> ModuleInterface*? {
    let sibling_kind = cfs_path_kind_follow(interface_path);
    if (sibling_kind == CFS_PATH_ABSENT) {
        ld_error(
            diags,
            "DRV-0074",
            "required sibling module interface was not found for object '" +
                object_path + "': " + interface_path,
            interface_path
        );
        return null;
    }
    if (sibling_kind != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "DRV-0075",
            "selected sibling module interface is not a readable regular file: " +
                interface_path,
            interface_path
        );
        return null;
    }

    let raw_opt = read_file(interface_path);
    if (raw_opt == null) {
        ld_error(
            diags,
            "DRV-0075",
            "cannot read selected sibling module interface: " + interface_path,
            interface_path
        );
        return null;
    }
    let raw = raw_opt as string;
    if (!us_is_valid_utf8(raw)) {
        ld_error(
            diags,
            "DRV-0076",
            "selected sibling module interface is not valid UTF-8",
            interface_path
        );
        return null;
    }

    let parsed = pi_parse_interface(us_strip_utf8_bom(raw), interface_path);
    ld_copy_interface_diags(diags, parsed);
    if (ipr_has_errors(parsed) || parsed.interface == null) {
        ipr_free(parsed);
        return null;
    }
    let interface = parsed.interface as ModuleInterface*;
    parsed.interface = null;
    ipr_free(parsed);
    if (!ifp_verify(interface, diags, interface_path)) {
        mi_free(interface);
        return null;
    }
    return interface;
}

/** Validate original native paths and prepare their verified interface set. */
func ld_prepare_cli_inputs(
    operands: VectorBase*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> LinkPlan*? {
    /* Path-only role validation must complete before any filesystem access. */
    let ok = true;
    for (let i = 0; i < cli_link_operands_count(operands); i = i + 1) {
        let operand = cli_link_operands_get(operands, i);
        if (ord(operand.kind) == ord(LOK_DEA_OBJECT)) {
            let interface_path = mg_interface_path_from_object_path(operand.value);
            if (interface_path == null) {
                ld_error(
                    diags,
                    "L1C-2097",
                    "positional Dea native input must have a nonempty basename stem " +
                        "and exact terminal '.o' suffix: " + operand.value,
                    operand.value
                );
                ok = false;
            }
        }
    }
    if (!ok) {
        return null;
    }

    /* Validate every native endpoint before reading any sibling interface. */
    let inputs = ld_ptr_vec_create(cli_link_operands_count(operands));
    ok = true;
    for (let i2 = 0; i2 < cli_link_operands_count(operands); i2 = i2 + 1) {
        let operand2 = cli_link_operands_get(operands, i2);
        let is_native = ord(operand2.kind) == ord(LOK_DEA_OBJECT) ||
            ord(operand2.kind) == ord(LOK_FOREIGN_OBJECT);
        if (!is_native) {
            ld_ptr_vec_push(
                inputs,
                ld_input_create(
                    operand2.kind, operand2.value, null, null) as void*
            );
            continue;
        }

        if (cfs_path_kind_follow(operand2.value) != CFS_PATH_REGULAR) {
            ld_error(
                diags,
                "L1C-2097",
                "standalone-link native input is missing or is not a regular file: " +
                    operand2.value,
                operand2.value
            );
            ok = false;
            continue;
        }

        if (ord(operand2.kind) == ord(LOK_FOREIGN_OBJECT)) {
            ld_ptr_vec_push(
                inputs, ld_foreign_input_create(operand2.value) as void*);
            continue;
        }

        let interface_path2 = mg_interface_path_from_object_path(operand2.value);
        ld_ptr_vec_push(
            inputs,
            ld_input_create(
                operand2.kind,
                operand2.value,
                interface_path2 as string,
                null
            ) as void*
        );
    }
    if (!ok) {
        ld_inputs_free(inputs);
        return null;
    }

    /* Parse and verify the complete sibling set before graph registration. */
    ok = true;
    for (let input_i = 0; input_i < vec_size(inputs); input_i = input_i + 1) {
        let input = ld_ptr_vec_get(inputs, input_i) as LinkInput*;
        if (ord(input.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_load_sibling_interface(
            input.value, input.interface_path as string, diags);
        if (interface == null) {
            ok = false;
            continue;
        }
        input.interface = interface as ModuleInterface*;
    }
    if (!ok) {
        ld_inputs_free(inputs);
        return null;
    }

    let plan = new LinkPlan(inputs, spm_create(), sv_create(vec_size(inputs)), "");
    return _ld_prepare_verified_plan(plan, explicit_entry, diags);
}

/** Construct the fixed paths inside one standalone-link transaction. */
func ld_transaction_create(root: string) -> LinkTransaction* {
    return new LinkTransaction(
        root,
        join(root, "wrapper.c"),
        join(root, "wrapper.o"),
        join(root, "compile.stdout"),
        join(root, "compile.stderr"),
        join(root, "link.stdout"),
        join(root, "link.stderr")
    );
}

/** Free a transaction-path bundle without removing filesystem state. */
func ld_transaction_free(txn: LinkTransaction*) {
    drop txn;
}

/** Exclusively create one output-local transaction for a fixed identity. */
func ld_create_transaction_for_identity(
    output_parent: string,
    pid: int,
    sec: int,
    nsec: int,
    diags: DiagCollector*
) -> LinkTransaction*? {
    for (let attempt = 0; attempt < 100; attempt = attempt + 1) {
        let root = join(
            output_parent,
            ".l1c-link-" + int_to_string(pid) + "-" +
                int_to_string(sec) + "-" + int_to_string(nsec) + "-" +
                int_to_string(attempt)
        );
        /* POSIX 0700; MinGW inherits access control from the trusted parent. */
        let created = cfs_mkdir(root, 448);
        if (created == 1) {
            return ld_transaction_create(root);
        }
        if (created < 0) {
            ld_error(
                diags,
                "L1C-2107",
                "cannot create standalone-link transaction directory: " + root,
                root
            );
            return null;
        }
    }

    ld_error(
        diags,
        "L1C-2107",
        "cannot create a unique standalone-link transaction directory under: " +
            output_parent,
        output_parent
    );
    return null;
}

/** Exclusively create one output-local transaction beside the executable. */
func ld_create_transaction(
    output_parent: string,
    diags: DiagCollector*
) -> LinkTransaction*? {
    let pid = get_pid();
    let sec = 0;
    let nsec = 0;
    let now_opt = wall_now();
    if (now_opt != null) {
        let now = now_opt as WallTime;
        sec = now.sec;
        nsec = now.nsec;
    }
    return ld_create_transaction_for_identity(
        output_parent, pid, sec, nsec, diags);
}

/**
 * Delete one regular transaction child without following substitutions.
 */
func ld_delete_if_present(path: string) -> bool {
    return cfs_remove_regular_file(path) >= 0;
}

/**
 * Remove known regular children and then the verified empty transaction.
 *
 * No recursive removal is performed. Unexpected or substituted contents make
 * cleanup fail and retain the transaction for inspection.
 */
func ld_cleanup_transaction(txn: LinkTransaction*) -> bool {
    let ok = true;
    if (!ld_delete_if_present(txn.wrapper_c)) ok = false;
    if (!ld_delete_if_present(txn.wrapper_object)) ok = false;
    if (!ld_delete_if_present(txn.compile_stdout)) ok = false;
    if (!ld_delete_if_present(txn.compile_stderr)) ok = false;
    if (!ld_delete_if_present(txn.link_stdout)) ok = false;
    if (!ld_delete_if_present(txn.link_stderr)) ok = false;
    if (cfs_remove_empty_dir(txn.root) != 1) ok = false;
    return ok;
}

/** Validate the caller-selected executable destination without creating it. */
func ld_validate_output(output_path: string, diags: DiagCollector*) -> bool {
    if (is_empty_s(output_path)) {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output path must not be empty",
            output_path
        );
        return false;
    }

    let output_parent = parent(output_path);
    let parent_kind = cfs_path_kind_follow(output_parent);
    if (parent_kind != CFS_PATH_DIRECTORY) {
        if (parent_kind < 0) {
            ld_error(
                diags,
                "L1C-2105",
                "cannot inspect standalone-link output parent: " + output_parent,
                output_parent
            );
        } else {
            ld_error(
                diags,
                "L1C-2105",
                "standalone-link output parent does not exist or is not a directory: " +
                    output_parent,
                output_parent
            );
        }
        return false;
    }

    let output_kind = cfs_path_kind(output_path);
    if (output_kind == CFS_PATH_ABSENT ||
        output_kind == CFS_PATH_REGULAR) {
        return true;
    }
    if (output_kind < 0) {
        ld_error(
            diags,
            "L1C-2105",
            "cannot inspect standalone-link output: " + output_path,
            output_path
        );
    } else {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output must be absent or a regular file: " +
                output_path,
            output_path
        );
    }
    return false;
}

/** Reject an existing output alias of one validated compiler input. */
func ld_validate_output_alias(
    output_path: string,
    input_path: string,
    input_kind: string,
    diags: DiagCollector*
) -> bool {
    let same = cfs_same_file(output_path, input_path);
    if (same < 0) {
        ld_error(
            diags,
            "L1C-2105",
            "cannot compare standalone-link output identity with " +
                input_kind + ": " + input_path,
            output_path
        );
        return false;
    }
    if (same == 1) {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output aliases " + input_kind + ": " +
                input_path,
            output_path
        );
        return false;
    }
    return true;
}

/** Reject output aliases of native, interface, runtime, or header inputs. */
func ld_validate_output_aliases(
    output_path: string,
    plan: LinkPlan*,
    runtime_inputs: StringVector*,
    runtime_header: string,
    diags: DiagCollector*
) -> bool {
    if (cfs_path_kind(output_path) != CFS_PATH_REGULAR) {
        return true;
    }

    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (!ld_input_is_native(input)) {
            continue;
        }
        if (!ld_validate_output_alias(
                output_path, input.value, "caller native input", diags)) {
            return false;
        }
        if (input.interface_path != null &&
            !ld_validate_output_alias(
                output_path,
                input.interface_path as string,
                "consumed sibling interface",
                diags)) {
            return false;
        }
    }

    for (let runtime_i = 0; runtime_i < sv_size(runtime_inputs);
        runtime_i = runtime_i + 1) {
        let runtime_path = sv_get(runtime_inputs, runtime_i);
        if (!ld_validate_output_alias(
                output_path, runtime_path, "runtime native input", diags)) {
            return false;
        }
    }
    return ld_validate_output_alias(
        output_path, runtime_header, "resolved runtime header", diags);
}

/** Resolve and validate the runtime include directory and public header. */
func ld_runtime_include(
    opts: CliOptions*,
    diags: DiagCollector*
) -> LinkRuntimeInclude*? {
    let include_opt = bd_runtime_include_dir(opts);
    if (include_opt == null) {
        ld_error(
            diags,
            "L1C-2106",
            "cannot resolve the L1 runtime include directory for standalone linking",
            ""
        );
        return null;
    }
    let include_dir = include_opt as string;
    let header_path = join(include_dir, "dea_rt.h");
    if (cfs_path_kind_follow(include_dir) != CFS_PATH_DIRECTORY ||
        cfs_path_kind_follow(header_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2106",
            "runtime include directory '" + include_dir +
                "' does not contain a readable regular 'dea_rt.h'",
            include_dir
        );
        return null;
    }
    /* Bind the optional so a successful readability probe has an ARC owner. */
    let header_text = read_file(header_path);
    if (header_text == null) {
        ld_error(
            diags,
            "L1C-2106",
            "runtime include directory '" + include_dir +
                "' does not contain a readable regular 'dea_rt.h'",
            include_dir
        );
        return null;
    }
    return new LinkRuntimeInclude(include_dir, header_path);
}

/** Resolve and validate the selected runtime archive by exact path. */
func ld_runtime_archive(
    opts: CliOptions*,
    diags: DiagCollector*
) -> string? {
    let library_opt = bd_runtime_lib_dir(opts);
    if (library_opt == null) {
        ld_error(
            diags,
            "L1C-2106",
            "cannot resolve the L1 runtime library directory for standalone linking",
            ""
        );
        return null;
    }
    let library_dir = library_opt as string;
    let archive_path = join(library_dir, bd_runtime_archive_filename(opts));
    if (cfs_path_kind_follow(library_dir) != CFS_PATH_DIRECTORY ||
        cfs_path_kind_follow(archive_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2106",
            "selected runtime archive is not a regular file: " +
                archive_path,
            archive_path
        );
        return null;
    }
    return archive_path;
}

/**
 * Resolve and validate the runtime inputs for the selected compiler family.
 *
 * Normal compiler families receive the selected archive as one exact path.
 * TinyCC receives the repo-local variant-matched raw-object set when present,
 * preserving the accepted cross-format compatibility boundary.
 */
func ld_runtime_link_inputs(
    opts: CliOptions*,
    compiler: string,
    diags: DiagCollector*
) -> StringVector*? {
    let family = bd_compiler_flag_family(compiler);
    if (family == "tcc") {
        let runtime_objects = bd_runtime_object_paths(opts);
        if (runtime_objects != null &&
            bd_runtime_object_paths_exist(runtime_objects as StringVector*)) {
            let valid_objects = true;
            for (let i = 0; i < sv_size(runtime_objects as StringVector*);
                 i = i + 1) {
                let object_path = sv_get(
                    runtime_objects as StringVector*, i);
                if (cfs_path_kind_follow(object_path) != CFS_PATH_REGULAR) {
                    ld_error(
                        diags,
                        "L1C-2106",
                        "selected TinyCC runtime object is not a regular file: " +
                            object_path,
                        object_path
                    );
                    valid_objects = false;
                }
            }
            if (valid_objects) {
                return runtime_objects as StringVector*;
            }
            bd_runtime_object_paths_free(runtime_objects);
            return null;
        }
        bd_runtime_object_paths_free(runtime_objects);
    }

    let archive = ld_runtime_archive(opts, diags);
    if (archive == null) {
        return null;
    }
    let result = sv_create(1);
    sv_push(result, archive as string);
    return result;
}

/** Resolve the selected host compiler before scratch allocation. */
func ld_take_compiler(opts: CliOptions*, diags: DiagCollector*) -> string? {
    let compiler = bd_take_c_compiler(opts);
    if (compiler == null) {
        ld_error(
            diags,
            "L1C-2106",
            "no C compiler found for standalone linking: use '--c-compiler' or set L1_CC",
            ""
        );
        return null;
    }
    return compiler;
}

/**
 * Validate compiler-dependent external-link controls before native work.
 *
 * Library names and search paths retain the canonical compiler-driver
 * spellings where supported; MSVC requires a different command layout and is
 * rejected. Runtime search paths need a documented family-specific lowering
 * and are deliberately unavailable on Windows.
 */
func ld_validate_external_link_operands(
    operands: VectorBase*,
    compiler: string,
    diags: DiagCollector*
) -> bool {
    let family = bd_compiler_flag_family(compiler);
    let supported_rpath_family = family == "gcc" || family == "cc" ||
        family == "tcc";
    let ok = true;
    for (let i = 0; i < cli_link_operands_count(operands); i = i + 1) {
        let operand = cli_link_operands_get(operands, i);
        if (family == "msvc" &&
            (ord(operand.kind) == ord(LOK_LIBRARY) ||
             ord(operand.kind) == ord(LOK_LIBRARY_SEARCH))) {
            ld_error(
                diags,
                "L1C-2072",
                "canonical '-l' and '-L' external-library controls are " +
                    "unsupported by the selected MSVC driver family",
                operand.value
            );
            ok = false;
            continue;
        }
        if (ord(operand.kind) != ord(LOK_RPATH)) {
            continue;
        }
        if (bd_is_windows()) {
            ld_error(
                diags,
                "L1C-2072",
                "runtime library search paths are unsupported on Windows: " +
                    operand.value,
                operand.value
            );
            ok = false;
            continue;
        }
        if (!supported_rpath_family) {
            ld_error(
                diags,
                "L1C-2072",
                "runtime library search path requires a recognized GCC/Clang, " +
                    "exact 'cc', or TinyCC driver; selected compiler family is '" +
                    family + "': " + operand.value,
                operand.value
            );
            ok = false;
            continue;
        }
        if (family == "tcc" && contains_s(operand.value, ",")) {
            ld_error(
                diags,
                "L1C-2072",
                "TinyCC cannot preserve a comma inside a runtime library " +
                    "search path: " + operand.value,
                operand.value
            );
            ok = false;
        }
    }
    return ok;
}

/**
 * Return a host-driver argument that is unambiguously a filesystem path.
 *
 * Prefixing relative option/response-shaped names preserves the selected file
 * while preventing the host driver from reinterpreting it. MSVC receives
 * rooted forward-slash paths with native separators so `/path` is not parsed
 * as an option.
 */
func ld_host_input_path(path: string, family: string) -> string {
    if (family == "msvc" && len_s(path) > 0 &&
        char_at_s(path, 0) == '/') {
        return replace_s(path, "/", "\\");
    }
    if (!is_absolute(path) && len_s(path) > 0 &&
        (char_at_s(path, 0) == '-' || char_at_s(path, 0) == '@')) {
        return join(".", path);
    }
    return path;
}

/** Return whether one word is stable through the Windows `system()` shell. */
func ld_windows_shell_word_safe(word: string) -> bool {
    return bd_windows_shell_word_safe(word);
}

/** Validate exact Windows host-command words with one diagnostic contract. */
func ld_validate_windows_shell_words(
    words: StringVector*,
    code: string,
    message: string,
    diags: DiagCollector*
) -> bool {
    return bd_validate_windows_shell_words(
        words, code, message, diags);
}

/** Validate standalone values before Windows shell-backed scratch work. */
func ld_validate_windows_shell_values(
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    runtime_inputs: StringVector*,
    output_path: string,
    plan: LinkPlan*,
    diags: DiagCollector*
) -> bool {
    with (let values = sv_create(
              8 + sv_size(extra_opts) + sv_size(runtime_inputs) +
                  vec_size(plan.inputs)) =>
              sv_free(values)) {
        sv_push(values, compiler);
        sv_push(values, runtime_include);
        sv_push(values, output_path);
        for (let option_i = 0; option_i < sv_size(extra_opts);
             option_i = option_i + 1) {
            sv_push(values, sv_get(extra_opts, option_i));
        }
        for (let i = 0; i < sv_size(runtime_inputs); i = i + 1) {
            sv_push(values, sv_get(runtime_inputs, i));
        }
        for (let input_i = 0; input_i < vec_size(plan.inputs);
             input_i = input_i + 1) {
            sv_push(values, ld_plan_input_get(plan, input_i).value);
        }
        return ld_validate_windows_shell_words(
            values,
            "L1C-2106",
            "host linking does not support '%', '!', double quotes, " +
                "or line breaks in Windows host-command values",
            diags
        );
    }
}

/** Validate build/run values that are known before source compilation. */
func ld_validate_windows_build_run_values(
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    runtime_inputs: StringVector*,
    output_path: string,
    operands: VectorBase*,
    diags: DiagCollector*
) -> bool {
    with (let values = sv_create(
              8 + sv_size(extra_opts) + sv_size(runtime_inputs) +
                  cli_link_operands_count(operands)) =>
              sv_free(values)) {
        sv_push(values, compiler);
        sv_push(values, runtime_include);
        sv_push(values, output_path);
        for (let option_i = 0; option_i < sv_size(extra_opts);
             option_i = option_i + 1) {
            sv_push(values, sv_get(extra_opts, option_i));
        }
        for (let runtime_i = 0; runtime_i < sv_size(runtime_inputs);
             runtime_i = runtime_i + 1) {
            sv_push(values, sv_get(runtime_inputs, runtime_i));
        }
        for (let operand_i = 0;
             operand_i < cli_link_operands_count(operands);
             operand_i = operand_i + 1) {
            let operand = cli_link_operands_get(operands, operand_i);
            /* The source target is replaced by generated object paths later. */
            if (ord(operand.kind) != ord(LOK_DEA_OBJECT)) {
                sv_push(values, operand.value);
            }
        }
        return ld_validate_windows_shell_words(
            values,
            "L1C-2106",
            "host linking does not support '%', '!', double quotes, " +
                "or line breaks in Windows host-command values",
            diags
        );
    }
}

/** Push the wrapper-only host compilation command. */
func ld_push_wrapper_compile_words(
    words: StringVector*,
    compiler: string,
    family: string,
    extra_opts: StringVector*,
    optimize: string?,
    runtime_include: string,
    wrapper_c: string,
    wrapper_object: string
) {
    cd_push_object_compile_words(
        words,
        compiler,
        family,
        "unknown",
        extra_opts,
        optimize,
        runtime_include,
        "",
        ld_host_input_path(wrapper_c, family),
        ld_host_input_path(wrapper_object, family)
    );
}

/** Push the final host-link command while retaining typed input order. */
func ld_push_final_link_words(
    words: StringVector*,
    compiler: string,
    family: string,
    wrapper_object: string,
    plan: LinkPlan*,
    runtime_archive: string,
    output_path: string
) {
    with (let runtime_inputs = sv_create(1) => sv_free(runtime_inputs)) {
        sv_push(runtime_inputs, runtime_archive);
        ld_push_final_link_words_with_runtime_inputs(
            words,
            compiler,
            family,
            wrapper_object,
            plan,
            runtime_inputs,
            output_path
        );
    }
}

/** Push the final host-link command with prevalidated runtime inputs. */
func ld_push_final_link_words_with_runtime_inputs(
    words: StringVector*,
    compiler: string,
    family: string,
    wrapper_object: string,
    plan: LinkPlan*,
    runtime_inputs: StringVector*,
    output_path: string
) {
    sv_push(words, compiler);
    /*
     * Raw C options are intentionally wrapper-compile-only in link mode.
     * Forwarding them here would let response files, object paths, library
     * flags, or linker pass-through options bypass the typed input boundary.
     */
    sv_push(words, ld_host_input_path(wrapper_object, family));
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let input = ld_plan_input_get(plan, input_i);
        if (ld_input_is_native(input)) {
            sv_push(words, ld_host_input_path(
                ld_input_link_path(input), family));
        } else if (ord(input.kind) == ord(LOK_LIBRARY)) {
            sv_push(words, "-l" + input.value);
        } else if (ord(input.kind) == ord(LOK_LIBRARY_SEARCH)) {
            sv_push(words, "-L" + input.value);
        } else if (ord(input.kind) == ord(LOK_RPATH)) {
            if (family == "tcc") {
                sv_push(words, "-Wl,-rpath=" + input.value);
            } else {
                sv_push(words, "-Xlinker");
                sv_push(words, "-rpath");
                sv_push(words, "-Xlinker");
                sv_push(words, input.value);
            }
        } else {
            assert(ord(input.kind) == ord(LOK_LINK_ARG),
                "[ICE-2114] unknown typed link input kind");
            sv_push(words, input.value);
        }
    }
    for (let runtime_i = 0; runtime_i < sv_size(runtime_inputs);
         runtime_i = runtime_i + 1) {
        sv_push(words, ld_host_input_path(
            sv_get(runtime_inputs, runtime_i), family));
    }
    if (family != "msvc") {
        /*
         * The authoritative sibling interface intentionally excludes private
         * implementation use of `sys.real`. Supplying the host math library
         * unconditionally keeps such separately compiled modules linkable.
         */
        sv_push(words, "-lm");
    }
    bd_push_output_flags(words, family, output_path);
}

/**
 * Add the platform transport quoting required by `system()`.
 *
 * Windows `system()` delegates to `cmd.exe /c`. The extra outer quote pair
 * lets cmd.exe consume that transport layer while preserving the inner quote
 * pair around a compiler executable path that contains spaces.
 */
func ld_wrap_system_command(command: string, windows: bool) -> string {
    if (windows) {
        return "\"" + command + "\"";
    }
    return command;
}

/** Execute one captured host command and preserve its output. */
func ld_run_host_command(
    words: StringVector*,
    stdout_path: string,
    stderr_path: string,
    code: string,
    failure_message: string,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> bool {
    if (bd_is_windows()) {
        with (let shell_values = sv_create(sv_size(words) + 2) =>
                  sv_free(shell_values)) {
            for (let i = 0; i < sv_size(words); i = i + 1) {
                sv_push(shell_values, sv_get(words, i));
            }
            sv_push(shell_values, stdout_path);
            sv_push(shell_values, stderr_path);
            if (!ld_validate_windows_shell_words(
                    shell_values,
                    code,
                    failure_message +
                        ": unsupported Windows shell expansion or quote character",
                    diags)) {
                return false;
            }
        }
    }
    log_info(cfg, bd_join_display_words(words));
    let command = ld_wrap_system_command(
        bd_join_shell_words(words) + " > " +
            bd_shell_quote(stdout_path) + " 2> " +
            bd_shell_quote(stderr_path),
        bd_is_windows()
    );
    let rc = system(command);
    let failed = rc != 0;
    if (failed) {
        ld_error(diags, code, failure_message, "");
    }
    bd_replay_compile_output(cfg, stdout_path, stderr_path, failed);
    return !failed;
}

/** Validate the no-follow wrapper object endpoint before final linking. */
func ld_validate_wrapper_object(
    wrapper_path: string,
    diags: DiagCollector*
) -> bool {
    if (cfs_path_kind(wrapper_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2108",
            "wrapper compiler did not produce a no-follow regular object: " +
                wrapper_path,
            wrapper_path
        );
        return false;
    }
    return true;
}

/**
 * Compile and link one verified plan through caller-supplied scratch paths.
 *
 * This common executor never allocates or cleans the transaction that owns
 * `scratch`; standalone CLI orchestration and later build/run orchestration
 * retain that responsibility.
 */
func ld_execute_plan(
    plan: LinkPlan*,
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    runtime_inputs: StringVector*,
    output_path: string,
    scratch: LinkTransaction*,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> bool {
    let wrapper_source = we_emit_wrapper(
        plan.lifecycle_order, plan.entry_module);
    if (write_file(scratch.wrapper_c, wrapper_source) == null) {
        ld_error(
            diags,
            "L1C-2107",
            "cannot write standalone-link wrapper: " + scratch.wrapper_c,
            scratch.wrapper_c
        );
        return false;
    }

    with (
        let compile_words = sv_create(20) => sv_free(compile_words),
        let link_words = sv_create(20 + vec_size(plan.inputs)) =>
            sv_free(link_words)
    ) {
        let family = bd_compiler_flag_family(compiler);
        let optimize = bd_get_optimize_flag(family, extra_opts);
        ld_push_wrapper_compile_words(
            compile_words,
            compiler,
            family,
            extra_opts,
            optimize,
            runtime_include,
            scratch.wrapper_c,
            scratch.wrapper_object
        );
        log_info(cfg, "Compiling standalone-link wrapper:");
        if (!ld_run_host_command(
                compile_words,
                scratch.compile_stdout,
                scratch.compile_stderr,
                "L1C-2108",
                "standalone-link wrapper compilation failed",
                cfg,
                diags)) {
            return false;
        }
        if (!ld_validate_wrapper_object(scratch.wrapper_object, diags)) {
            return false;
        }

        ld_push_final_link_words_with_runtime_inputs(
            link_words,
            compiler,
            family,
            scratch.wrapper_object,
            plan,
            runtime_inputs,
            output_path
        );
        log_info(cfg, "Linking standalone executable:");
        if (!ld_run_host_command(
                link_words,
                scratch.link_stdout,
                scratch.link_stderr,
                "L1C-2109",
                "standalone host link failed",
                cfg,
                diags)) {
            return false;
        }
    }

    if (cfs_path_kind(output_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2109",
            "host linker did not produce a regular executable: " + output_path,
            output_path
        );
        return false;
    }
    return true;
}

/** Execute public `l1c --link` mode. */
func ld_cmd_link(opts: CliOptions*, cfg: LogConfig*) -> int {
    with (let diags = diag_create() => diag_free(diags)) {
        let plan = ld_prepare_cli_inputs(
            opts.link_operands, opts.entry_module, diags);
        if (plan == null) {
            dp_print_collector(diags);
            return 1;
        }
        let verified = plan as LinkPlan*;
        let output_path = opts.output as string;

        let valid_output = ld_validate_output(output_path, diags);
        let compiler = ld_take_compiler(opts, diags);
        let extra_opts = bd_collect_c_option_words(opts);
        let runtime_include = ld_runtime_include(opts, diags);
        let runtime_inputs: StringVector*? = null;
        let valid_external = true;
        if (compiler != null) {
            valid_external = ld_validate_external_link_operands(
                opts.link_operands, compiler as string, diags);
            runtime_inputs = ld_runtime_link_inputs(
                opts, compiler as string, diags);
        }
        let valid_aliases = true;
        let valid_windows_values = true;
        if (valid_output && runtime_inputs != null && runtime_include != null) {
            let resolved_include = runtime_include as LinkRuntimeInclude*;
            valid_aliases = ld_validate_output_aliases(
                output_path,
                verified,
                runtime_inputs as StringVector*,
                resolved_include.header_path,
                diags
            );
        }
        if (bd_is_windows() &&
            compiler != null && runtime_include != null &&
            runtime_inputs != null) {
            valid_windows_values = ld_validate_windows_shell_values(
                compiler as string,
                extra_opts,
                (runtime_include as LinkRuntimeInclude*).directory,
                runtime_inputs as StringVector*,
                output_path,
                verified,
                diags
            );
        }
        if (!valid_output || compiler == null ||
            runtime_include == null || runtime_inputs == null ||
            !valid_external || !valid_aliases || !valid_windows_values) {
            dp_print_collector(diags);
            if (runtime_inputs != null) {
                sv_free(runtime_inputs as StringVector*);
            }
            if (runtime_include != null) {
                ld_runtime_include_free(
                    runtime_include as LinkRuntimeInclude*);
            }
            sv_free(extra_opts);
            ld_plan_free(verified);
            return 1;
        }

        let output_parent = parent(output_path);
        let txn = ld_create_transaction(output_parent, diags);
        if (txn == null) {
            dp_print_collector(diags);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(
                runtime_include as LinkRuntimeInclude*);
            sv_free(extra_opts);
            ld_plan_free(verified);
            return 1;
        }
        let scratch = txn as LinkTransaction*;

        let succeeded = ld_execute_plan(
            verified,
            compiler as string,
            extra_opts,
            (runtime_include as LinkRuntimeInclude*).directory,
            runtime_inputs as StringVector*,
            output_path,
            scratch,
            cfg,
            diags
        );
        let cleaned = ld_cleanup_transaction(scratch);
        if (!cleaned) {
            ld_error(
                diags,
                "L1C-2109",
                "standalone-link transaction cleanup failed; retained files in " +
                    scratch.root,
                scratch.root
            );
        }

        if (diag_count(diags) > 0) {
            dp_print_collector(diags);
        }
        ld_transaction_free(scratch);
        sv_free(runtime_inputs as StringVector*);
        ld_runtime_include_free(
            runtime_include as LinkRuntimeInclude*);
        sv_free(extra_opts);
        ld_plan_free(verified);

        if (!succeeded || !cleaned) {
            return 1;
        }
        log_info(cfg, "Linked executable: " + output_path);
        return 0;
    }
}

/** Visit one resolved module-graph node in dependency-first build order. */
func ld_build_order_visit(
    graph: ModuleGraph*,
    node: ModuleGraphNode*,
    visiting: StringSet*,
    completed: StringSet*,
    ordered: VectorBase*,
    diags: DiagCollector*
) -> bool {
    if (ss_has(completed, node.module_name)) {
        return true;
    }
    if (!ss_add(visiting, node.module_name)) {
        ld_error(
            diags,
            "L1C-2130",
            "build/run module ordering encountered a dependency cycle at '" +
                node.module_name + "'",
            ""
        );
        return false;
    }

    let ok = true;
    if (ord(node.origin.kind) == ord(MOK_SOURCE)) {
        for (let import_i = 0;
             import_i < mg_node_direct_import_count(node);
             import_i = import_i + 1) {
            let imported = mg_find_node(
                graph, mg_node_direct_import_get(node, import_i));
            if (imported != null &&
                !ld_build_order_visit(
                    graph,
                    imported as ModuleGraphNode*,
                    visiting,
                    completed,
                    ordered,
                    diags
                )) {
                ok = false;
            }
        }
    } else {
        for (let interface_i = 0;
             interface_i < mg_node_interface_import_count(node);
             interface_i = interface_i + 1) {
            let imported2 = mg_find_node(
                graph,
                mg_node_interface_import_get(node, interface_i));
            if (imported2 != null &&
                !ld_build_order_visit(
                    graph,
                    imported2 as ModuleGraphNode*,
                    visiting,
                    completed,
                    ordered,
                    diags
                )) {
                ok = false;
            }
        }
        for (let dep_i = 0;
             dep_i < mg_node_dependency_count(node);
             dep_i = dep_i + 1) {
            let dependency = mg_node_dependency_get(node, dep_i);
            let provider = mg_find_node(
                graph, dependency.provider_module);
            if (provider != null &&
                !ld_build_order_visit(
                    graph,
                    provider as ModuleGraphNode*,
                    visiting,
                    completed,
                    ordered,
                    diags
                )) {
                ok = false;
            }
        }
    }

    ss_remove(visiting, node.module_name);
    if (!ok) {
        return false;
    }
    ss_add(completed, node.module_name);
    ld_ptr_vec_push(ordered, node as void*);
    return true;
}

/** Build the deterministic dependency-first order for one resolved graph. */
func ld_build_order(
    graph: ModuleGraph*,
    entry_module: string,
    diags: DiagCollector*
) -> VectorBase*? {
    let ordered = ld_ptr_vec_create(mg_node_count(graph));
    with (
        let visiting = ss_create() => ss_free(visiting),
        let completed = ss_create() => ss_free(completed),
        let names = mg_node_names_sorted(graph) => sv_free(names)
    ) {
        let entry = mg_find_node(graph, entry_module);
        if (entry == null || !ld_build_order_visit(
                graph,
                entry as ModuleGraphNode*,
                visiting,
                completed,
                ordered,
                diags
            )) {
            vec_free(ordered);
            return null;
        }
        for (let i = 0; i < sv_size(names); i = i + 1) {
            let node = mg_find_node(graph, sv_get(names, i));
            if (node != null && !ld_build_order_visit(
                    graph,
                    node as ModuleGraphNode*,
                    visiting,
                    completed,
                    ordered,
                    diags
                )) {
                vec_free(ordered);
                return null;
            }
        }
    }
    return ordered;
}

/** Register the common link scratch paths beneath a disjoint hidden directory. */
func ld_build_run_transaction(
    workspace: CompilerWorkspace*,
    diags: DiagCollector*
) -> LinkTransaction*? {
    /* A leading dot cannot collide with a canonical Dea module segment. */
    let scratch_root = join(workspace.root, ".link");
    if (cfs_mkdir(scratch_root, 448) != 1) {
        ld_error(
            diags,
            "L1C-2107",
            "cannot create build/run link scratch directory: " +
                scratch_root,
            scratch_root
        );
        return null;
    }
    cfs_workspace_register_directory(workspace, scratch_root);
    let wrapper_c = join(scratch_root, "__dea_wrapper.c");
    let wrapper_object = join(scratch_root, "__dea_wrapper.o");
    let compile_stdout = join(scratch_root, "wrapper-compile.stdout");
    let compile_stderr = join(scratch_root, "wrapper-compile.stderr");
    let link_stdout = join(scratch_root, "final-link.stdout");
    let link_stderr = join(scratch_root, "final-link.stderr");
    cfs_workspace_register_file(workspace, wrapper_c);
    cfs_workspace_register_file(workspace, wrapper_object);
    cfs_workspace_register_file(workspace, compile_stdout);
    cfs_workspace_register_file(workspace, compile_stderr);
    cfs_workspace_register_file(workspace, link_stdout);
    cfs_workspace_register_file(workspace, link_stderr);
    return new LinkTransaction(
        scratch_root,
        wrapper_c,
        wrapper_object,
        compile_stdout,
        compile_stderr,
        link_stdout,
        link_stderr
    );
}

/** Compile every source-backed node in deterministic dependency order. */
func ld_compile_source_nodes(
    opts: CliOptions*,
    cfg: LogConfig*,
    prepared: BuildPreparedInput*,
    ordered: VectorBase*,
    workspace: CompilerWorkspace*,
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    diags: DiagCollector*
) -> bool {
    with (let interface_roots = sv_create(
            sv_size(opts.interface_paths) + 1) =>
            sv_free(interface_roots)) {
        /* Preserve authoritative -I precedence, then expose staged providers. */
        for (let root_i = 0;
             root_i < sv_size(opts.interface_paths);
             root_i = root_i + 1) {
            sv_push(interface_roots, sv_get(opts.interface_paths, root_i));
        }
        sv_push(interface_roots, workspace.root);

        for (let i = 0; i < vec_size(ordered); i = i + 1) {
            let node = ld_ptr_vec_get(ordered, i) as ModuleGraphNode*;
            if (ord(node.origin.kind) != ord(MOK_SOURCE)) {
                continue;
            }
            if (node.artifacts == null) {
                ld_error(
                    diags,
                    "L1C-2131",
                    "source-backed build/run module has no private artifact association: " +
                        node.module_name,
                    ""
                );
                return false;
            }

            /*
             * Re-enter the one-module semantic boundary. The entry itself is
             * always loaded from source, while every non-virtual dependency
             * must resolve through an authoritative or already staged .l1m.
             */
            let unit_result = analysis_analyze_entry_with_resolution(
                prepared.search_paths,
                node.module_name,
                interface_roots,
                MRP_REQUIRE_INTERFACE,
                workspace.root,
                cfg
            );
            if (analysis_diag_count(unit_result) > 0) {
                dp_print_collector_with_sources(
                    unit_result.diags,
                    analysis_source_names(unit_result),
                    analysis_source_texts(unit_result)
                );
            }
            if (analysis_has_errors(unit_result)) {
                analysis_result_free(unit_result);
                return false;
            }
            let compiled = cd_compile_analyzed_to_workspace(
                opts,
                cfg,
                unit_result,
                node.module_name,
                node.artifacts as ModuleArtifactPaths*,
                workspace,
                compiler,
                extra_opts,
                runtime_include,
                diags
            );
            analysis_result_free(unit_result);
            if (!compiled) {
                return false;
            }
        }
    }
    return true;
}

/** Inject the graph Dea set where the source target occurred in CLI order. */
func ld_build_run_operands(
    cli_operands: VectorBase*,
    ordered: VectorBase*
) -> VectorBase* {
    let operands = cli_link_operands_create();
    for (let cli_i = 0;
         cli_i < cli_link_operands_count(cli_operands);
         cli_i = cli_i + 1) {
        let cli_operand = cli_link_operands_get(
            cli_operands, cli_i);
        if (ord(cli_operand.kind) != ord(LOK_DEA_OBJECT)) {
            cli_link_operands_push(
                operands, cli_operand.kind, cli_operand.value);
            continue;
        }

        for (let node_i = 0;
             node_i < vec_size(ordered);
             node_i = node_i + 1) {
            let node = ld_ptr_vec_get(
                ordered, node_i) as ModuleGraphNode*;
            if (ord(node.origin.kind) != ord(MOK_SOURCE) &&
                ord(node.origin.kind) != ord(MOK_INTERFACE)) {
                continue;
            }
            if (node.artifacts != null) {
                cli_link_operands_push(
                    operands,
                    LOK_DEA_OBJECT,
                    (node.artifacts as ModuleArtifactPaths*).object_path
                );
            }
        }
    }
    return operands;
}

/** Validate an absent retained-C tree destination before native work. */
func ld_validate_retained_c_root(
    root: string?,
    diags: DiagCollector*
) -> bool {
    if (root == null) {
        return true;
    }
    let path = root as string;
    let parent_path = parent(path);
    if (cfs_path_kind_follow(parent_path) != CFS_PATH_DIRECTORY) {
        ld_error(
            diags,
            "L1C-2132",
            "retained-C output parent does not exist or is not a directory: " +
                parent_path,
            parent_path
        );
        return false;
    }
    if (cfs_path_kind(path) != CFS_PATH_ABSENT) {
        ld_error(
            diags,
            "L1C-2132",
            "retained-C output path must be absent: " + path,
            path
        );
        return false;
    }
    return true;
}

/** Reject canonical module paths that may alias the retained wrapper. */
func ld_validate_retained_c_modules(
    root: string?,
    ordered: VectorBase*,
    diags: DiagCollector*
) -> bool {
    if (root == null) {
        return true;
    }
    for (let i = 0; i < vec_size(ordered); i = i + 1) {
        let node = ld_ptr_vec_get(ordered, i) as ModuleGraphNode*;
        if (ord(node.origin.kind) == ord(MOK_SOURCE) &&
            to_lower_s(node.module_name) == "__dea_wrapper") {
            let collision = join(
                root as string, "__dea_wrapper.c");
            ld_error(
                diags,
                "L1C-2132",
                "retained-C module path collides with the generated wrapper: " +
                    collision,
                collision
            );
            return false;
        }
    }
    return true;
}

/** Create one retained-C directory and remember its cleanup order. */
func ld_ensure_retained_c_directory(
    root: string,
    directory: string,
    directories: StringVector*,
    diags: DiagCollector*
) -> bool {
    if (directory == root) {
        return true;
    }
    let directory_parent = parent(directory);
    if (directory_parent == directory ||
        !ld_ensure_retained_c_directory(
            root, directory_parent, directories, diags)) {
        return false;
    }
    let kind = cfs_path_kind(directory);
    if (kind == CFS_PATH_ABSENT) {
        if (cfs_mkdir(directory, 511) != 1) {
            ld_error(
                diags,
                "L1C-2132",
                "cannot create retained-C directory: " + directory,
                directory
            );
            return false;
        }
        sv_push(directories, directory);
        return true;
    }
    if (kind == CFS_PATH_DIRECTORY) {
        return true;
    }
    ld_error(
        diags,
        "L1C-2132",
        "retained-C path component is not a directory: " + directory,
        directory
    );
    return false;
}

/** Remove one partially constructed retained-C tree. */
func ld_cleanup_retained_c_tree(
    root: string,
    files: StringVector*,
    directories: StringVector*
) -> bool {
    let ok = true;
    for (let i = 0; i < sv_size(files); i = i + 1) {
        if (cfs_remove_regular_file(sv_get(files, i)) < 0) {
            ok = false;
        }
    }
    for (let dir_i = sv_size(directories) - 1;
         dir_i >= 0; dir_i = dir_i - 1) {
        if (cfs_remove_empty_dir(sv_get(directories, dir_i)) < 0) {
            ok = false;
        }
    }
    if (cfs_remove_empty_dir(root) < 0) {
        ok = false;
    }
    return ok;
}

/** Copy one generated C file without regeneration or rewriting. */
func ld_copy_retained_c_file(
    source: string,
    destination: string,
    files: StringVector*,
    diags: DiagCollector*
) -> bool {
    let bytes = read_file(source);
    sv_push(files, destination);
    if (bytes == null ||
        write_file(destination, bytes as string) == null) {
        ld_error(
            diags,
            "L1C-2132",
            "cannot copy retained generated C file to: " + destination,
            destination
        );
        return false;
    }
    return true;
}

/** Publish the complete mirrored generated-C tree after a successful link. */
func ld_retain_build_run_c(
    root: string?,
    ordered: VectorBase*,
    wrapper_source: string,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> bool {
    if (root == null) {
        return true;
    }
    let retained_root = root as string;
    if (cfs_mkdir(retained_root, 511) != 1) {
        ld_error(
            diags,
            "L1C-2132",
            "cannot create retained-C output tree: " + retained_root,
            retained_root
        );
        return false;
    }

    with (
        let files = sv_create(vec_size(ordered) + 1) => sv_free(files),
        let directories = sv_create(4) => sv_free(directories)
    ) {
        let ok = true;
        for (let i = 0; i < vec_size(ordered); i = i + 1) {
            let node = ld_ptr_vec_get(
                ordered, i) as ModuleGraphNode*;
            if (ord(node.origin.kind) != ord(MOK_SOURCE)) {
                continue;
            }
            let destination_opt = mg_artifacts_for_module(
                retained_root, node.module_name, diags);
            if (destination_opt == null) {
                ok = false;
                break;
            }
            let destination =
                destination_opt as ModuleArtifactPaths*;
            if (!ld_ensure_retained_c_directory(
                    retained_root,
                    parent(destination.c_path),
                    directories,
                    diags
                ) ||
                !ld_copy_retained_c_file(
                    (node.artifacts as ModuleArtifactPaths*).c_path,
                    destination.c_path,
                    files,
                    diags
                )) {
                ok = false;
            }
            mg_artifacts_free(destination);
            if (!ok) {
                break;
            }
        }

        let wrapper_destination = join(
            retained_root, "__dea_wrapper.c");
        if (ok && !ld_copy_retained_c_file(
                wrapper_source,
                wrapper_destination,
                files,
                diags
            )) {
            ok = false;
        }
        if (!ok) {
            if (!ld_cleanup_retained_c_tree(
                    retained_root, files, directories)) {
                ld_error(
                    diags,
                    "L1C-2132",
                    "retained-C rollback failed; partial tree remains at: " +
                        retained_root,
                    retained_root
                );
            }
            return false;
        }
    }
    log_info(cfg, "Retained generated-C tree: " + retained_root);
    return true;
}

/** Execute the selected temporary run program with exact argv forwarding. */
func ld_run_built_program(
    executable: string,
    program_args: StringVector*,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> int {
    with (
        let words = sv_create(sv_size(program_args) + 1) =>
            sv_free(words),
        let status_box = vec_create(sizeof(int), 1) =>
            vec_free(status_box)
    ) {
        sv_push(words, executable);
        for (let i = 0; i < sv_size(program_args); i = i + 1) {
            sv_push(words, sv_get(program_args, i));
        }
        log_info(cfg, "Running: " + bd_join_display_words(words));
        vec_push_int(status_box, 0);
        let program_status = vec_get(status_box, 0) as int*;
        let launch = cfs_run_process(words, program_status);
        if (launch != 1) {
            ld_error(
                diags,
                "L1C-2133",
                "failed to launch run-mode executable: " + executable,
                executable
            );
            return 1;
        }
        return *program_status;
    }
}

/** Complete multi-CU compilation, verified linking, retention, and execution. */
func ld_build_run_in_workspace(
    opts: CliOptions*,
    cfg: LogConfig*,
    prepared: BuildPreparedInput*,
    workspace: CompilerWorkspace*,
    executable: string,
    retained_c_root: string?,
    run_program: bool
) -> int {
    with (let diags = diag_create() => diag_free(diags)) {
        if (!ld_validate_output(executable, diags) ||
            !ld_validate_retained_c_root(retained_c_root, diags)) {
            dp_print_collector(diags);
            return 1;
        }

        let result = analysis_analyze_entry_with_resolution(
            prepared.search_paths,
            prepared.entry_module,
            opts.interface_paths,
            MRP_ALLOW_SOURCE_FALLBACK,
            workspace.root,
            cfg
        );
        if (analysis_diag_count(result) > 0) {
            dp_print_collector_with_sources(
                result.diags,
                analysis_source_names(result),
                analysis_source_texts(result)
            );
        }
        if (analysis_has_errors(result)) {
            analysis_result_free(result);
            return 1;
        }

        let ordered_opt = ld_build_order(
            driver_graph(result.driver_state),
            prepared.entry_module,
            diags
        );
        if (ordered_opt == null) {
            dp_print_collector(diags);
            analysis_result_free(result);
            return 1;
        }
        let ordered = ordered_opt as VectorBase*;
        if (!ld_validate_retained_c_modules(
                retained_c_root, ordered, diags)) {
            dp_print_collector(diags);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }
        let compiler = ld_take_compiler(opts, diags);
        let extra_opts = bd_collect_c_option_words(opts);
        let runtime_include = ld_runtime_include(opts, diags);
        let runtime_inputs: StringVector*? = null;
        let valid_external = true;
        if (compiler != null) {
            valid_external = ld_validate_external_link_operands(
                opts.link_operands, compiler as string, diags);
            runtime_inputs = ld_runtime_link_inputs(
                opts, compiler as string, diags);
        }
        let valid_precompile_windows_values = true;
        if (bd_is_windows() &&
            compiler != null && runtime_include != null &&
            runtime_inputs != null) {
            valid_precompile_windows_values =
                ld_validate_windows_build_run_values(
                    compiler as string,
                    extra_opts,
                    (runtime_include as LinkRuntimeInclude*).directory,
                    runtime_inputs as StringVector*,
                    executable,
                    opts.link_operands,
                    diags
                );
        }
        if (compiler == null || runtime_include == null ||
            runtime_inputs == null || !valid_external ||
            !valid_precompile_windows_values ||
            !bd_validate_float_c_options(
                result, extra_opts, diags)) {
            dp_print_collector(diags);
            if (runtime_inputs != null) {
                sv_free(runtime_inputs as StringVector*);
            }
            if (runtime_include != null) {
                ld_runtime_include_free(
                    runtime_include as LinkRuntimeInclude*);
            }
            sv_free(extra_opts);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }

        let resolved_include = runtime_include as LinkRuntimeInclude*;
        if (!ld_compile_source_nodes(
                opts,
                cfg,
                prepared,
                ordered,
                workspace,
                compiler as string,
                extra_opts,
                resolved_include.directory,
                diags
            )) {
            dp_print_collector(diags);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(resolved_include);
            sv_free(extra_opts);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }

        let operands = ld_build_run_operands(
            opts.link_operands, ordered);
        let plan = ld_prepare_cli_inputs(
            operands, prepared.entry_module, diags);
        cli_link_operands_free(operands);
        if (plan == null) {
            dp_print_collector(diags);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(resolved_include);
            sv_free(extra_opts);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }
        let verified = plan as LinkPlan*;

        let valid_aliases = ld_validate_output_aliases(
            executable,
            verified,
            runtime_inputs as StringVector*,
            resolved_include.header_path,
            diags
        );
        let valid_windows_values = true;
        if (bd_is_windows()) {
            valid_windows_values = ld_validate_windows_shell_values(
                compiler as string,
                extra_opts,
                resolved_include.directory,
                runtime_inputs as StringVector*,
                executable,
                verified,
                diags
            );
        }
        if (!valid_aliases || !valid_windows_values) {
            dp_print_collector(diags);
            ld_plan_free(verified);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(resolved_include);
            sv_free(extra_opts);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }

        let scratch_opt = ld_build_run_transaction(
            workspace, diags);
        if (scratch_opt == null) {
            dp_print_collector(diags);
            ld_plan_free(verified);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(resolved_include);
            sv_free(extra_opts);
            vec_free(ordered);
            analysis_result_free(result);
            return 1;
        }
        let scratch = scratch_opt as LinkTransaction*;
        let linked = ld_execute_plan(
            verified,
            compiler as string,
            extra_opts,
            resolved_include.directory,
            runtime_inputs as StringVector*,
            executable,
            scratch,
            cfg,
            diags
        );
        let primary_status = 1;
        if (linked && ld_retain_build_run_c(
                retained_c_root,
                ordered,
                scratch.wrapper_c,
                cfg,
                diags
            )) {
            primary_status = 0;
            if (run_program) {
                primary_status = ld_run_built_program(
                    executable, opts.program_args, cfg, diags);
            }
        }
        if (diag_count(diags) > 0) {
            dp_print_collector(diags);
        }
        ld_transaction_free(scratch);
        ld_plan_free(verified);
        sv_free(runtime_inputs as StringVector*);
        ld_runtime_include_free(resolved_include);
        sv_free(extra_opts);
        vec_free(ordered);
        analysis_result_free(result);
        return primary_status;
    }
}

/** Execute multi-compilation-unit `--build` or `--run`. */
func ld_cmd_build_run(
    opts: CliOptions*,
    cfg: LogConfig*,
    run_program: bool
) -> int {
    with (
        let prepare_diags = diag_create() => diag_free(prepare_diags),
        let workspace_diags = diag_create() => diag_free(workspace_diags)
    ) {
        let prepared = bd_prepare_input(opts, prepare_diags, cfg);
        if (prepared == null) {
            dp_print_collector(prepare_diags);
            return 1;
        }
        let prep = prepared as BuildPreparedInput*;
        let executable = bd_default_exe_name();
        if (run_program) {
            executable = "";
            if (opts.output != null) {
                diag_warn(
                    prepare_diags,
                    "l1c",
                    "L1C-0017",
                    "'--output' is ignored in '--run' mode; the executable remains temporary and '--keep-c' uses the canonical module name",
                    "",
                    0,
                    0,
                    0,
                    0
                );
                dp_print_collector(prepare_diags);
            }
        } else if (opts.output != null) {
            executable = opts.output as string;
        }

        let retained_c_root: string? = null;
        if (opts.keep_c) {
            if (run_program) {
                retained_c_root = prep.entry_module + ".dea-c";
            } else {
                retained_c_root = executable + ".dea-c";
            }
        }

        let workspace_tag = "build";
        if (run_program) {
            workspace_tag = "run";
        }
        let workspace = cfs_workspace_create(
            workspace_tag, workspace_diags);
        if (workspace == null) {
            dp_print_collector(workspace_diags);
            bd_prepared_input_free(prep);
            return 1;
        }
        let owned_workspace = workspace as CompilerWorkspace*;
        if (run_program) {
            executable = cfs_workspace_child(
                owned_workspace, "program" + bd_exe_suffix());
        }
        let primary_status = ld_build_run_in_workspace(
            opts,
            cfg,
            prep,
            owned_workspace,
            executable,
            retained_c_root,
            run_program
        );
        bd_prepared_input_free(prep);
        let cleanup_ok = cfs_workspace_cleanup(
            owned_workspace, workspace_diags);
        if (!cleanup_ok) {
            dp_print_collector(workspace_diags);
        }
        cfs_workspace_free(owned_workspace);
        return cfs_apply_cleanup_status(
            primary_status, cleanup_ok);
    }
}

/** Execute multi-compilation-unit `--build`. */
func ld_cmd_build(opts: CliOptions*, cfg: LogConfig*) -> int {
    return ld_cmd_build_run(opts, cfg, false);
}

/** Execute multi-compilation-unit `--run`. */
func ld_cmd_run(opts: CliOptions*, cfg: LogConfig*) -> int {
    return ld_cmd_build_run(opts, cfg, true);
}
