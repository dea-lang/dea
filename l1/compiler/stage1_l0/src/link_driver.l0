/** One typed standalone-link input with optional verified Dea authority. */
struct LinkInput {
    kind: LinkOperandKind;
    object_path: string;
    interface_path: string?;
    interface: ModuleInterface*?;
    visit_state: int;
}

/** Verified standalone link set and its deterministic lifecycle order. */
struct LinkPlan {
    inputs: VectorBase*; /* LinkInput* in CLI encounter order */
    modules_by_name: StringPtrMap*; /* module name -> borrowed LinkInput* */
    lifecycle_order: StringVector*;
    entry_module: string;
}

/** One explicit dependency-walk frame. */
struct LinkVisitFrame {
    input: LinkInput*;
    next_import: int;
}

/** Fixed paths owned by one standalone-link transaction. */
struct LinkTransaction {
    root: string;
    wrapper_c: string;
    wrapper_object: string;
    compile_stdout: string;
    compile_stderr: string;
    link_stdout: string;
    link_stderr: string;
}

/** Resolved wrapper include directory and exact public runtime header. */
struct LinkRuntimeInclude {
    directory: string;
    header_path: string;
}

/** Create one pointer-element vector. */
func ld_ptr_vec_create(capacity: int) -> VectorBase* {
    return vec_create(sizeof(void*), capacity);
}

/** Append one pointer to a pointer-element vector. */
func ld_ptr_vec_push(values: VectorBase*, value: void*) {
    vec_push_ptr(values, value);
}

/** Read one pointer from a pointer-element vector. */
func ld_ptr_vec_get(values: VectorBase*, index: int) -> void* {
    return *(vec_get(values, index) as void**);
}

/** Free an owned vector of dependency-walk frames. */
func ld_visit_frames_free(frames: VectorBase*) {
    for (let i = 0; i < vec_size(frames); i = i + 1) {
        let frame = ld_ptr_vec_get(frames, i) as LinkVisitFrame*;
        drop frame;
    }
    vec_free(frames);
}

/** Remove and release the final string-vector entry. */
func ld_string_vector_pop(values: StringVector*) {
    let last = sv_size(values) - 1;
    let slot = vec_get(values, last) as string*;
    *slot = "";
    values.length = last;
}

/** Emit one link-driver diagnostic without source coordinates. */
func ld_error(diags: DiagCollector*, code: string, message: string, path: string) {
    diag_error(diags, "l1c", code, message, path, 0, 0, 0, 0);
}

/** Create one typed link input, taking ownership of its optional interface. */
func ld_input_create(
    kind: LinkOperandKind,
    object_path: string,
    interface_path: string?,
    interface: ModuleInterface*?
) -> LinkInput* {
    return new LinkInput(kind, object_path, interface_path, interface, 0);
}

/** Create one opaque foreign input. */
func ld_foreign_input_create(object_path: string) -> LinkInput* {
    return ld_input_create(LOK_FOREIGN_OBJECT, object_path, null, null);
}

/** Return the verified interface owned by one Dea input. */
func ld_input_interface(input: LinkInput*) -> ModuleInterface* {
    return input.interface as ModuleInterface*;
}

/** Free one typed link input. */
func ld_input_free(input: LinkInput*) {
    if (input.interface != null) {
        mi_free(input.interface as ModuleInterface*);
    }
    drop input;
}

/** Free an owned vector of typed link inputs. */
func ld_inputs_free(inputs: VectorBase*) {
    for (let i = 0; i < vec_size(inputs); i = i + 1) {
        ld_input_free(ld_ptr_vec_get(inputs, i) as LinkInput*);
    }
    vec_free(inputs);
}

/** Free a verified link plan and every typed input it owns. */
func ld_plan_free(plan: LinkPlan*) {
    ld_inputs_free(plan.inputs);
    spm_free(plan.modules_by_name);
    sv_free(plan.lifecycle_order);
    drop plan;
}

/** Return one verified input by its encounter index. */
func ld_plan_input_get(plan: LinkPlan*, index: int) -> LinkInput* {
    return ld_ptr_vec_get(plan.inputs, index) as LinkInput*;
}

/** Return the original caller-selected native path used by the host linker. */
func ld_input_link_path(input: LinkInput*) -> string {
    return input.object_path;
}

/** Free a resolved runtime include bundle. */
func ld_runtime_include_free(runtime_include: LinkRuntimeInclude*) {
    drop runtime_include;
}

/** Join canonical module names for deterministic diagnostics. */
func ld_join_module_names(names: StringVector*) -> string {
    with (let out = cb_create() => cb_free(out)) {
        for (let i = 0; i < sv_size(names); i = i + 1) {
            if (i > 0) {
                cb_append_s(out, ", ");
            }
            cb_append_s(out, sv_get(names, i));
        }
        return cb_to_string(out);
    }
}

/** Format the canonical cycle ending at `module_name`. */
func ld_format_cycle(stack: StringVector*, module_name: string) -> string {
    let start = 0;
    for (let i = 0; i < sv_size(stack); i = i + 1) {
        if (sv_get(stack, i) == module_name) {
            start = i;
            break;
        }
    }

    with (let out = cb_create() => cb_free(out)) {
        for (let i = start; i < sv_size(stack); i = i + 1) {
            if (i > start) {
                cb_append_s(out, " -> ");
            }
            cb_append_s(out, sv_get(stack, i));
        }
        if (sv_size(stack) > start) {
            cb_append_s(out, " -> ");
        }
        cb_append_s(out, module_name);
        return cb_to_string(out);
    }
}

/** Validate every owned Dea interface before any identity is registered. */
func ld_verify_interfaces(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;
    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (ord(input.kind) == ord(LOK_FOREIGN_OBJECT)) {
            if (input.interface_path != null || input.interface != null) {
                ld_error(
                    diags,
                    "L1C-2097",
                    "foreign link input unexpectedly carries a Dea interface: " +
                        input.object_path,
                    input.object_path
                );
                ok = false;
            }
            continue;
        }
        if (input.interface_path == null || input.interface == null) {
            ld_error(
                diags,
                "DRV-0074",
                "required sibling module interface was not provided for object: " +
                    input.object_path,
                input.object_path
            );
            ok = false;
            continue;
        }
        if (!ifp_verify(
                input.interface as ModuleInterface*,
                diags,
                input.interface_path as string)) {
            ok = false;
        }
    }
    return ok;
}

/** Register identities from the complete already-verified interface set. */
func ld_register_modules(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;
    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (ord(input.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(input);
        if (spm_has(plan.modules_by_name, interface.module_name)) {
            let previous = spm_get(
                plan.modules_by_name, interface.module_name) as LinkInput*;
            ld_error(
                diags,
                "L1C-2100",
                "duplicate Dea module identity '" + interface.module_name +
                    "' in sibling interfaces for '" + previous.object_path +
                    "' and '" + input.object_path + "'",
                input.interface_path as string
            );
            ok = false;
            continue;
        }
        spm_put(plan.modules_by_name, interface.module_name, input as void*);
    }
    return ok;
}

/** Validate one unique provider expectation against the explicit Dea set. */
func ld_validate_provider_expectation(
    plan: LinkPlan*,
    consumer: LinkInput*,
    provider_name: string,
    expected: string,
    seen: StringSet*,
    diags: DiagCollector*
) -> bool {
    if (dea_is_virtual_module_name(provider_name) || ss_has(seen, provider_name)) {
        return true;
    }
    ss_add(seen, provider_name);

    let provider_value = spm_get(plan.modules_by_name, provider_name);
    let consumer_interface = ld_input_interface(consumer);
    if (provider_value == null) {
        ld_error(
            diags,
            "L1C-2101",
            "Dea module '" + consumer_interface.module_name +
                "' names missing provider module '" + provider_name + "'",
            consumer.interface_path as string
        );
        return false;
    }

    let provider = provider_value as LinkInput*;
    let supplied = ld_input_interface(provider).fingerprint;
    if (expected != supplied) {
        ld_error(
            diags,
            "L1C-2102",
            "Dea module '" + consumer_interface.module_name + "' expects provider '" +
                provider_name + "' fingerprint '" + expected +
                "', but supplied interface '" + provider.interface_path as string +
                "' carries '" + supplied + "'",
            consumer.interface_path as string
        );
        return false;
    }
    return true;
}

/** Validate provider presence and supplied fingerprints across all manifests. */
func ld_validate_dependencies(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    let ok = true;

    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let consumer = ld_plan_input_get(plan, i);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(consumer);
        with (let seen = ss_create() => ss_free(seen)) {
            for (let import_i = 0; import_i < vec_size(interface.module_imports);
                 import_i = import_i + 1) {
                let imported = ld_ptr_vec_get(
                    interface.module_imports, import_i) as InterfaceModuleImport*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, imported.provider_module,
                        imported.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
            for (let req_i = 0; req_i < vec_size(interface.require_entries);
                 req_i = req_i + 1) {
                let required = ld_ptr_vec_get(
                    interface.require_entries, req_i) as InterfaceDepEntry*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, required.provider_module,
                        required.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
            for (let link_i = 0; link_i < vec_size(interface.link_entries);
                 link_i = link_i + 1) {
                let linked = ld_ptr_vec_get(
                    interface.link_entries, link_i) as InterfaceDepEntry*;
                if (!ld_validate_provider_expectation(
                        plan, consumer, linked.provider_module,
                        linked.provider_fingerprint, seen, diags)) {
                    ok = false;
                }
            }
        }
    }

    return ok;
}

/** Resolve the explicit or inferred Dea entry module. */
func ld_select_entry(
    plan: LinkPlan*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> string? {
    if (explicit_entry != null) {
        let requested = explicit_entry as string;
        let input_value = spm_get(plan.modules_by_name, requested);
        if (input_value == null) {
            ld_error(
                diags,
                "L1C-2104",
                "explicit entry module '" + requested + "' is not present in the Dea link set",
                ""
            );
            return null;
        }
        let input = input_value as LinkInput*;
        if (!ld_input_interface(input).has_entry) {
            ld_error(
                diags,
                "L1C-2104",
                "explicit entry module '" + requested +
                    "' does not carry 'entry;' in its interface",
                input.interface_path as string
            );
            return null;
        }
        return slice_s(requested, 0, len_s(requested));
    }

    with (let candidates = sv_create(2) => sv_free(candidates)) {
        for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
            let input2 = ld_plan_input_get(plan, i);
            if (ord(input2.kind) == ord(LOK_DEA_OBJECT) &&
                ld_input_interface(input2).has_entry) {
                sv_push(candidates, ld_input_interface(input2).module_name);
            }
        }
        sv_sort(candidates);

        if (sv_size(candidates) == 0) {
            ld_error(
                diags,
                "L1C-2104",
                "Dea link set has no entry module; supply an interface carrying 'entry;'",
                ""
            );
            return null;
        }
        if (sv_size(candidates) > 1) {
            ld_error(
                diags,
                "L1C-2104",
                "Dea link set has multiple entry modules: " +
                    ld_join_module_names(candidates) +
                    "; select one with '--entry'",
                ""
            );
            return null;
        }
        let selected = sv_get(candidates, 0);
        return slice_s(selected, 0, len_s(selected));
    }
}

/** Visit one Dea module in dependency-first order without native recursion. */
func ld_visit_module(
    plan: LinkPlan*,
    input: LinkInput*,
    stack: StringVector*,
    diags: DiagCollector*
) -> bool {
    if (input.visit_state == 2) {
        return true;
    }

    let interface = ld_input_interface(input);
    if (input.visit_state == 1) {
        ld_error(
            diags,
            "L1C-2103",
            "Dea lifecycle import cycle: " +
                ld_format_cycle(stack, interface.module_name),
            input.interface_path as string
        );
        return false;
    }

    with (let frames = ld_ptr_vec_create(8) =>
              ld_visit_frames_free(frames)) {
        input.visit_state = 1;
        sv_push(stack, interface.module_name);
        ld_ptr_vec_push(
            frames, new LinkVisitFrame(input, 0) as void*);

        while (vec_size(frames) > 0) {
            let frame_i = vec_size(frames) - 1;
            let frame = ld_ptr_vec_get(
                frames, frame_i) as LinkVisitFrame*;
            let frame_interface = ld_input_interface(frame.input);

            if (frame.next_import <
                vec_size(frame_interface.module_imports)) {
                let imported = ld_ptr_vec_get(
                    frame_interface.module_imports,
                    frame.next_import
                ) as InterfaceModuleImport*;
                let provider = spm_get(
                    plan.modules_by_name,
                    imported.provider_module
                ) as LinkInput*;
                frame.next_import = frame.next_import + 1;

                if (provider.visit_state == 2) {
                    continue;
                }
                let provider_interface = ld_input_interface(provider);
                if (provider.visit_state == 1) {
                    ld_error(
                        diags,
                        "L1C-2103",
                        "Dea lifecycle import cycle: " +
                            ld_format_cycle(
                                stack, provider_interface.module_name),
                        provider.interface_path as string
                    );
                    return false;
                }

                provider.visit_state = 1;
                sv_push(stack, provider_interface.module_name);
                ld_ptr_vec_push(
                    frames, new LinkVisitFrame(provider, 0) as void*);
                continue;
            }

            ld_string_vector_pop(stack);
            frame.input.visit_state = 2;
            sv_push(
                plan.lifecycle_order,
                frame_interface.module_name
            );
            frames.length = frame_i;
            drop frame;
        }
    }
    return true;
}

/** Compute the selected-entry-first deterministic lifecycle order. */
func ld_compute_lifecycle_order(plan: LinkPlan*, diags: DiagCollector*) -> bool {
    with (let stack = sv_create(8) => sv_free(stack)) {
        let entry_input = spm_get(
            plan.modules_by_name, plan.entry_module) as LinkInput*;
        if (!ld_visit_module(plan, entry_input, stack, diags)) {
            return false;
        }

        for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
            let input = ld_plan_input_get(plan, i);
            if (ord(input.kind) == ord(LOK_DEA_OBJECT) &&
                input.visit_state == 0 &&
                !ld_visit_module(plan, input, stack, diags)) {
                return false;
            }
        }
    }
    return true;
}

/** Collect one unique non-virtual semantic provider name. */
func ld_collect_provenance_provider(
    providers: StringVector*,
    seen: StringSet*,
    provider_name: string
) {
    if (dea_is_virtual_module_name(provider_name) || ss_has(seen, provider_name)) {
        return;
    }
    ss_add(seen, provider_name);
    sv_push(providers, provider_name);
}

/** Validate `require`/`link` provenance through existing lifecycle imports. */
func ld_validate_transitive_provenance(
    plan: LinkPlan*,
    diags: DiagCollector*
) -> bool {
    let ok = true;

    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        let consumer = ld_plan_input_get(plan, input_i);
        if (ord(consumer.kind) != ord(LOK_DEA_OBJECT)) {
            continue;
        }
        let interface = ld_input_interface(consumer);
        with (
            let providers = sv_create(4) => sv_free(providers),
            let provider_seen = ss_create() => ss_free(provider_seen)
        ) {
            for (let req_i = 0; req_i < vec_size(interface.require_entries);
                 req_i = req_i + 1) {
                let required = ld_ptr_vec_get(
                    interface.require_entries, req_i) as InterfaceDepEntry*;
                ld_collect_provenance_provider(
                    providers, provider_seen, required.provider_module);
            }
            for (let link_i = 0; link_i < vec_size(interface.link_entries);
                 link_i = link_i + 1) {
                let linked = ld_ptr_vec_get(
                    interface.link_entries, link_i) as InterfaceDepEntry*;
                ld_collect_provenance_provider(
                    providers, provider_seen, linked.provider_module);
            }
            if (sv_size(providers) == 0) {
                continue;
            }

            with (
                let reachable = ss_create() => ss_free(reachable),
                let stack = sv_create(vec_size(interface.module_imports) + 4) =>
                    sv_free(stack)
            ) {
                for (let import_i = 0; import_i < vec_size(interface.module_imports);
                     import_i = import_i + 1) {
                    let imported = ld_ptr_vec_get(
                        interface.module_imports, import_i) as InterfaceModuleImport*;
                    sv_push(stack, imported.provider_module);
                }

                while (sv_size(stack) > 0) {
                    let last = sv_size(stack) - 1;
                    let module_name = sv_get(stack, last);
                    ld_string_vector_pop(stack);
                    if (ss_has(reachable, module_name)) {
                        continue;
                    }
                    ss_add(reachable, module_name);
                    let reached = spm_get(
                        plan.modules_by_name, module_name) as LinkInput*;
                    let reached_interface = ld_input_interface(reached);
                    for (let import_i2 = 0;
                         import_i2 < vec_size(reached_interface.module_imports);
                         import_i2 = import_i2 + 1) {
                        let imported2 = ld_ptr_vec_get(
                            reached_interface.module_imports,
                            import_i2
                        ) as InterfaceModuleImport*;
                        if (!ss_has(reachable, imported2.provider_module)) {
                            sv_push(stack, imported2.provider_module);
                        }
                    }
                }

                for (let provider_i = 0; provider_i < sv_size(providers);
                     provider_i = provider_i + 1) {
                    let provider_name = sv_get(providers, provider_i);
                    if (!ss_has(reachable, provider_name)) {
                        ld_error(
                            diags,
                            "L1C-2111",
                            "Dea module '" + interface.module_name +
                                "' names semantic provider '" + provider_name +
                                "' that is not transitively reachable through " +
                                "'import module' records",
                            consumer.interface_path as string
                        );
                        ok = false;
                    }
                }
            }
        }
    }
    return ok;
}

/**
 * Validate already constructed inputs and build one link plan.
 *
 * Ownership of `inputs` transfers to this function whether it succeeds or
 * fails. Tests may use this boundary to construct verified interfaces without
 * writing temporary native object files.
 */
func ld_prepare_inputs(
    inputs: VectorBase*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> LinkPlan*? {
    let plan = new LinkPlan(inputs, spm_create(), sv_create(vec_size(inputs)), "");

    if (!ld_verify_interfaces(plan, diags) ||
        !ld_register_modules(plan, diags) ||
        !ld_validate_dependencies(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }

    let entry = ld_select_entry(plan, explicit_entry, diags);
    if (entry == null) {
        ld_plan_free(plan);
        return null;
    }
    plan.entry_module = entry as string;

    if (!ld_compute_lifecycle_order(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }
    if (!ld_validate_transitive_provenance(plan, diags)) {
        ld_plan_free(plan);
        return null;
    }
    return plan;
}

/** Copy parser diagnostics into the link-driver collector. */
func ld_copy_interface_diags(
    diags: DiagCollector*,
    parsed: InterfaceParseResult*
) {
    for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
        diag_copy(diags, diag_get(parsed.diags, i));
    }
}

/** Read, decode, parse, and verify one authoritative sibling interface. */
func ld_load_sibling_interface(
    object_path: string,
    interface_path: string,
    diags: DiagCollector*
) -> ModuleInterface*? {
    let sibling_kind = cfs_path_kind_follow(interface_path);
    if (sibling_kind == CFS_PATH_ABSENT) {
        ld_error(
            diags,
            "DRV-0074",
            "required sibling module interface was not found for object '" +
                object_path + "': " + interface_path,
            interface_path
        );
        return null;
    }
    if (sibling_kind != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "DRV-0075",
            "selected sibling module interface is not a readable regular file: " +
                interface_path,
            interface_path
        );
        return null;
    }

    let raw_opt = read_file(interface_path);
    if (raw_opt == null) {
        ld_error(
            diags,
            "DRV-0075",
            "cannot read selected sibling module interface: " + interface_path,
            interface_path
        );
        return null;
    }
    let raw = raw_opt as string;
    if (!us_is_valid_utf8(raw)) {
        ld_error(
            diags,
            "DRV-0076",
            "selected sibling module interface is not valid UTF-8",
            interface_path
        );
        return null;
    }

    let parsed = pi_parse_interface(us_strip_utf8_bom(raw), interface_path);
    ld_copy_interface_diags(diags, parsed);
    if (ipr_has_errors(parsed) || parsed.interface == null) {
        ipr_free(parsed);
        return null;
    }
    let interface = parsed.interface as ModuleInterface*;
    parsed.interface = null;
    ipr_free(parsed);
    if (!ifp_verify(interface, diags, interface_path)) {
        mi_free(interface);
        return null;
    }
    return interface;
}

/** Validate original native paths and prepare their verified interface set. */
func ld_prepare_cli_inputs(
    operands: VectorBase*,
    explicit_entry: string?,
    diags: DiagCollector*
) -> LinkPlan*? {
    /* Path-only role validation must complete before any filesystem access. */
    let ok = true;
    for (let i = 0; i < cli_link_operands_count(operands); i = i + 1) {
        let operand = cli_link_operands_get(operands, i);
        if (ord(operand.kind) == ord(LOK_DEA_OBJECT)) {
            let interface_path = mg_interface_path_from_object_path(operand.path);
            if (interface_path == null) {
                ld_error(
                    diags,
                    "L1C-2097",
                    "positional Dea native input must have a nonempty basename stem " +
                        "and exact terminal '.o' suffix: " + operand.path,
                    operand.path
                );
                ok = false;
            }
        }
    }
    if (!ok) {
        return null;
    }

    /* Validate every native endpoint before reading any sibling interface. */
    let inputs = ld_ptr_vec_create(cli_link_operands_count(operands));
    ok = true;
    for (let i2 = 0; i2 < cli_link_operands_count(operands); i2 = i2 + 1) {
        let operand2 = cli_link_operands_get(operands, i2);
        if (cfs_path_kind_follow(operand2.path) != CFS_PATH_REGULAR) {
            ld_error(
                diags,
                "L1C-2097",
                "standalone-link native input is missing or is not a regular file: " +
                    operand2.path,
                operand2.path
            );
            ok = false;
            continue;
        }

        if (ord(operand2.kind) == ord(LOK_FOREIGN_OBJECT)) {
            ld_ptr_vec_push(
                inputs, ld_foreign_input_create(operand2.path) as void*);
            continue;
        }

        let interface_path2 = mg_interface_path_from_object_path(operand2.path);
        ld_ptr_vec_push(
            inputs,
            ld_input_create(
                operand2.kind,
                operand2.path,
                interface_path2 as string,
                null
            ) as void*
        );
    }
    if (!ok) {
        ld_inputs_free(inputs);
        return null;
    }

    /* Parse and verify the complete sibling set before graph registration. */
    ok = true;
    for (let input_i = 0; input_i < vec_size(inputs); input_i = input_i + 1) {
        let input = ld_ptr_vec_get(inputs, input_i) as LinkInput*;
        if (ord(input.kind) == ord(LOK_FOREIGN_OBJECT)) {
            continue;
        }
        let interface = ld_load_sibling_interface(
            input.object_path, input.interface_path as string, diags);
        if (interface == null) {
            ok = false;
            continue;
        }
        input.interface = interface as ModuleInterface*;
    }
    if (!ok) {
        ld_inputs_free(inputs);
        return null;
    }

    return ld_prepare_inputs(inputs, explicit_entry, diags);
}

/** Construct the fixed paths inside one standalone-link transaction. */
func ld_transaction_create(root: string) -> LinkTransaction* {
    return new LinkTransaction(
        root,
        join(root, "wrapper.c"),
        join(root, "wrapper.o"),
        join(root, "compile.stdout"),
        join(root, "compile.stderr"),
        join(root, "link.stdout"),
        join(root, "link.stderr")
    );
}

/** Free a transaction-path bundle without removing filesystem state. */
func ld_transaction_free(txn: LinkTransaction*) {
    drop txn;
}

/** Exclusively create one output-local transaction for a fixed identity. */
func ld_create_transaction_for_identity(
    output_parent: string,
    pid: int,
    sec: int,
    nsec: int,
    diags: DiagCollector*
) -> LinkTransaction*? {
    for (let attempt = 0; attempt < 100; attempt = attempt + 1) {
        let root = join(
            output_parent,
            ".l1c-link-" + int_to_string(pid) + "-" +
                int_to_string(sec) + "-" + int_to_string(nsec) + "-" +
                int_to_string(attempt)
        );
        /* POSIX 0700; MinGW inherits access control from the trusted parent. */
        let created = cfs_mkdir(root, 448);
        if (created == 1) {
            return ld_transaction_create(root);
        }
        if (created < 0) {
            ld_error(
                diags,
                "L1C-2107",
                "cannot create standalone-link transaction directory: " + root,
                root
            );
            return null;
        }
    }

    ld_error(
        diags,
        "L1C-2107",
        "cannot create a unique standalone-link transaction directory under: " +
            output_parent,
        output_parent
    );
    return null;
}

/** Exclusively create one output-local transaction beside the executable. */
func ld_create_transaction(
    output_parent: string,
    diags: DiagCollector*
) -> LinkTransaction*? {
    let pid = get_pid();
    let sec = 0;
    let nsec = 0;
    let now_opt = wall_now();
    if (now_opt != null) {
        let now = now_opt as WallTime;
        sec = now.sec;
        nsec = now.nsec;
    }
    return ld_create_transaction_for_identity(
        output_parent, pid, sec, nsec, diags);
}

/**
 * Delete one regular transaction child without following substitutions.
 */
func ld_delete_if_present(path: string) -> bool {
    return cfs_remove_regular_file(path) >= 0;
}

/**
 * Remove known regular children and then the verified empty transaction.
 *
 * No recursive removal is performed. Unexpected or substituted contents make
 * cleanup fail and retain the transaction for inspection.
 */
func ld_cleanup_transaction(txn: LinkTransaction*) -> bool {
    let ok = true;
    if (!ld_delete_if_present(txn.wrapper_c)) ok = false;
    if (!ld_delete_if_present(txn.wrapper_object)) ok = false;
    if (!ld_delete_if_present(txn.compile_stdout)) ok = false;
    if (!ld_delete_if_present(txn.compile_stderr)) ok = false;
    if (!ld_delete_if_present(txn.link_stdout)) ok = false;
    if (!ld_delete_if_present(txn.link_stderr)) ok = false;
    if (cfs_remove_empty_dir(txn.root) != 1) ok = false;
    return ok;
}

/** Validate the caller-selected executable destination without creating it. */
func ld_validate_output(output_path: string, diags: DiagCollector*) -> bool {
    if (is_empty_s(output_path)) {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output path must not be empty",
            output_path
        );
        return false;
    }

    let output_parent = parent(output_path);
    let parent_kind = cfs_path_kind_follow(output_parent);
    if (parent_kind != CFS_PATH_DIRECTORY) {
        if (parent_kind < 0) {
            ld_error(
                diags,
                "L1C-2105",
                "cannot inspect standalone-link output parent: " + output_parent,
                output_parent
            );
        } else {
            ld_error(
                diags,
                "L1C-2105",
                "standalone-link output parent does not exist or is not a directory: " +
                    output_parent,
                output_parent
            );
        }
        return false;
    }

    let output_kind = cfs_path_kind(output_path);
    if (output_kind == CFS_PATH_ABSENT ||
        output_kind == CFS_PATH_REGULAR) {
        return true;
    }
    if (output_kind < 0) {
        ld_error(
            diags,
            "L1C-2105",
            "cannot inspect standalone-link output: " + output_path,
            output_path
        );
    } else {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output must be absent or a regular file: " +
                output_path,
            output_path
        );
    }
    return false;
}

/** Reject an existing output alias of one validated compiler input. */
func ld_validate_output_alias(
    output_path: string,
    input_path: string,
    input_kind: string,
    diags: DiagCollector*
) -> bool {
    let same = cfs_same_file(output_path, input_path);
    if (same < 0) {
        ld_error(
            diags,
            "L1C-2105",
            "cannot compare standalone-link output identity with " +
                input_kind + ": " + input_path,
            output_path
        );
        return false;
    }
    if (same == 1) {
        ld_error(
            diags,
            "L1C-2105",
            "standalone-link output aliases " + input_kind + ": " +
                input_path,
            output_path
        );
        return false;
    }
    return true;
}

/** Reject output aliases of native, interface, runtime, or header inputs. */
func ld_validate_output_aliases(
    output_path: string,
    plan: LinkPlan*,
    runtime_inputs: StringVector*,
    runtime_header: string,
    diags: DiagCollector*
) -> bool {
    if (cfs_path_kind(output_path) != CFS_PATH_REGULAR) {
        return true;
    }

    for (let i = 0; i < vec_size(plan.inputs); i = i + 1) {
        let input = ld_plan_input_get(plan, i);
        if (!ld_validate_output_alias(
                output_path, input.object_path, "caller native input", diags)) {
            return false;
        }
        if (input.interface_path != null &&
            !ld_validate_output_alias(
                output_path,
                input.interface_path as string,
                "consumed sibling interface",
                diags)) {
            return false;
        }
    }

    for (let runtime_i = 0; runtime_i < sv_size(runtime_inputs);
        runtime_i = runtime_i + 1) {
        let runtime_path = sv_get(runtime_inputs, runtime_i);
        if (!ld_validate_output_alias(
                output_path, runtime_path, "runtime native input", diags)) {
            return false;
        }
    }
    return ld_validate_output_alias(
        output_path, runtime_header, "resolved runtime header", diags);
}

/** Resolve and validate the runtime include directory and public header. */
func ld_runtime_include(
    opts: CliOptions*,
    diags: DiagCollector*
) -> LinkRuntimeInclude*? {
    let include_opt = bd_runtime_include_dir(opts);
    if (include_opt == null) {
        ld_error(
            diags,
            "L1C-2106",
            "cannot resolve the L1 runtime include directory for standalone linking",
            ""
        );
        return null;
    }
    let include_dir = include_opt as string;
    let header_path = join(include_dir, "dea_rt.h");
    if (cfs_path_kind_follow(include_dir) != CFS_PATH_DIRECTORY ||
        cfs_path_kind_follow(header_path) != CFS_PATH_REGULAR ||
        read_file(header_path) == null) {
        ld_error(
            diags,
            "L1C-2106",
            "runtime include directory '" + include_dir +
                "' does not contain a readable regular 'dea_rt.h'",
            include_dir
        );
        return null;
    }
    return new LinkRuntimeInclude(include_dir, header_path);
}

/** Resolve and validate the selected runtime archive by exact path. */
func ld_runtime_archive(
    opts: CliOptions*,
    diags: DiagCollector*
) -> string? {
    let library_opt = bd_runtime_lib_dir(opts);
    if (library_opt == null) {
        ld_error(
            diags,
            "L1C-2106",
            "cannot resolve the L1 runtime library directory for standalone linking",
            ""
        );
        return null;
    }
    let library_dir = library_opt as string;
    let archive_path = join(library_dir, bd_runtime_archive_filename(opts));
    if (cfs_path_kind_follow(library_dir) != CFS_PATH_DIRECTORY ||
        cfs_path_kind_follow(archive_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2106",
            "selected runtime archive is not a regular file: " +
                archive_path,
            archive_path
        );
        return null;
    }
    return archive_path;
}

/**
 * Resolve and validate the runtime inputs for the selected compiler family.
 *
 * Normal compiler families receive the selected archive as one exact path.
 * TinyCC receives the repo-local variant-matched raw-object set when present,
 * preserving the accepted cross-format compatibility boundary.
 */
func ld_runtime_link_inputs(
    opts: CliOptions*,
    compiler: string,
    diags: DiagCollector*
) -> StringVector*? {
    let family = bd_compiler_flag_family(compiler);
    if (family == "tcc") {
        let runtime_objects = bd_runtime_object_paths(opts);
        if (runtime_objects != null &&
            bd_runtime_object_paths_exist(runtime_objects as StringVector*)) {
            let valid_objects = true;
            for (let i = 0; i < sv_size(runtime_objects as StringVector*);
                 i = i + 1) {
                let object_path = sv_get(
                    runtime_objects as StringVector*, i);
                if (cfs_path_kind_follow(object_path) != CFS_PATH_REGULAR) {
                    ld_error(
                        diags,
                        "L1C-2106",
                        "selected TinyCC runtime object is not a regular file: " +
                            object_path,
                        object_path
                    );
                    valid_objects = false;
                }
            }
            if (valid_objects) {
                return runtime_objects as StringVector*;
            }
            bd_runtime_object_paths_free(runtime_objects);
            return null;
        }
        bd_runtime_object_paths_free(runtime_objects);
    }

    let archive = ld_runtime_archive(opts, diags);
    if (archive == null) {
        return null;
    }
    let result = sv_create(1);
    sv_push(result, archive as string);
    return result;
}

/** Resolve the selected host compiler before scratch allocation. */
func ld_take_compiler(opts: CliOptions*, diags: DiagCollector*) -> string? {
    let compiler = bd_take_c_compiler(opts);
    if (compiler == null) {
        ld_error(
            diags,
            "L1C-2106",
            "no C compiler found for standalone linking: use '--c-compiler' or set L1_CC",
            ""
        );
        return null;
    }
    return compiler;
}

/**
 * Return a host-driver argument that is unambiguously a filesystem path.
 *
 * Prefixing relative option/response-shaped names preserves the selected file
 * while preventing the host driver from reinterpreting it. MSVC receives
 * rooted forward-slash paths with native separators so `/path` is not parsed
 * as an option.
 */
func ld_host_input_path(path: string, family: string) -> string {
    if (family == "msvc" && len_s(path) > 0 &&
        char_at_s(path, 0) == '/') {
        return replace_s(path, "/", "\\");
    }
    if (!is_absolute(path) && len_s(path) > 0 &&
        (char_at_s(path, 0) == '-' || char_at_s(path, 0) == '@')) {
        return join(".", path);
    }
    return path;
}

/** Return whether one word is stable through the Windows `system()` shell. */
func ld_windows_shell_word_safe(word: string) -> bool {
    for (let i = 0; i < len_s(word); i = i + 1) {
        let c = char_at_s(word, i);
        if (c == '%' || c == '!' || c == '"' ||
            c == '\r' || c == '\n') {
            return false;
        }
    }
    return true;
}

/** Lowercase hexadecimal digit used by command-value diagnostic escaping. */
func ld_diagnostic_hex_digit(value: int) -> byte {
    if (value < 10) {
        return (('0' as int) + value) as byte;
    }
    return (('a' as int) + value - 10) as byte;
}

/** Render one rejected command word without diagnostic control characters. */
func ld_diagnostic_word(word: string) -> string {
    with (let out = cb_create() => cb_free(out)) {
        for (let i = 0; i < len_s(word); i = i + 1) {
            let value = char_at_s(word, i) as int;
            if (value < 32 || value == 127) {
                cb_append_s(out, "\\x");
                cb_append(out, ld_diagnostic_hex_digit(value / 16));
                cb_append(out, ld_diagnostic_hex_digit(value % 16));
            } else {
                cb_append(out, value as byte);
            }
        }
        return cb_to_string(out);
    }
}

/** Validate exact Windows host-command words with one diagnostic contract. */
func ld_validate_windows_shell_words(
    words: StringVector*,
    code: string,
    message: string,
    diags: DiagCollector*
) -> bool {
    for (let i = 0; i < sv_size(words); i = i + 1) {
        let word = sv_get(words, i);
        if (!ld_windows_shell_word_safe(word)) {
            let displayed = ld_diagnostic_word(word);
            ld_error(
                diags, code, message + ": " + displayed, displayed);
            return false;
        }
    }
    return true;
}

/** Validate standalone values before Windows shell-backed scratch work. */
func ld_validate_windows_shell_values(
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    runtime_inputs: StringVector*,
    output_path: string,
    plan: LinkPlan*,
    diags: DiagCollector*
) -> bool {
    with (let values = sv_create(
              8 + sv_size(extra_opts) + sv_size(runtime_inputs) +
                  vec_size(plan.inputs)) =>
              sv_free(values)) {
        sv_push(values, compiler);
        sv_push(values, runtime_include);
        sv_push(values, output_path);
        for (let option_i = 0; option_i < sv_size(extra_opts);
             option_i = option_i + 1) {
            sv_push(values, sv_get(extra_opts, option_i));
        }
        for (let i = 0; i < sv_size(runtime_inputs); i = i + 1) {
            sv_push(values, sv_get(runtime_inputs, i));
        }
        for (let input_i = 0; input_i < vec_size(plan.inputs);
             input_i = input_i + 1) {
            sv_push(values, ld_plan_input_get(plan, input_i).object_path);
        }
        return ld_validate_windows_shell_words(
            values,
            "L1C-2106",
            "standalone linking does not support '%', '!', double quotes, " +
                "or line breaks in Windows host-command values",
            diags
        );
    }
}

/** Push the wrapper-only host compilation command. */
func ld_push_wrapper_compile_words(
    words: StringVector*,
    compiler: string,
    family: string,
    extra_opts: StringVector*,
    optimize: string?,
    runtime_include: string,
    wrapper_c: string,
    wrapper_object: string
) {
    cd_push_object_compile_words(
        words,
        compiler,
        family,
        extra_opts,
        optimize,
        runtime_include,
        ld_host_input_path(wrapper_c, family),
        ld_host_input_path(wrapper_object, family)
    );
}

/** Push the final host-link command while retaining typed input order. */
func ld_push_final_link_words(
    words: StringVector*,
    compiler: string,
    family: string,
    wrapper_object: string,
    plan: LinkPlan*,
    runtime_archive: string,
    output_path: string
) {
    with (let runtime_inputs = sv_create(1) => sv_free(runtime_inputs)) {
        sv_push(runtime_inputs, runtime_archive);
        ld_push_final_link_words_with_runtime_inputs(
            words,
            compiler,
            family,
            wrapper_object,
            plan,
            runtime_inputs,
            output_path
        );
    }
}

/** Push the final host-link command with prevalidated runtime inputs. */
func ld_push_final_link_words_with_runtime_inputs(
    words: StringVector*,
    compiler: string,
    family: string,
    wrapper_object: string,
    plan: LinkPlan*,
    runtime_inputs: StringVector*,
    output_path: string
) {
    sv_push(words, compiler);
    /*
     * Raw C options are intentionally wrapper-compile-only in link mode.
     * Forwarding them here would let response files, object paths, library
     * flags, or linker pass-through options bypass the typed input boundary.
     */
    sv_push(words, ld_host_input_path(wrapper_object, family));
    for (let input_i = 0; input_i < vec_size(plan.inputs);
         input_i = input_i + 1) {
        sv_push(words, ld_host_input_path(
            ld_input_link_path(ld_plan_input_get(plan, input_i)), family));
    }
    for (let runtime_i = 0; runtime_i < sv_size(runtime_inputs);
         runtime_i = runtime_i + 1) {
        sv_push(words, ld_host_input_path(
            sv_get(runtime_inputs, runtime_i), family));
    }
    if (family != "msvc") {
        /*
         * The authoritative sibling interface intentionally excludes private
         * implementation use of `sys.real`. Supplying the host math library
         * unconditionally keeps such separately compiled modules linkable.
         */
        sv_push(words, "-lm");
    }
    bd_push_output_flags(words, family, output_path);
}

/**
 * Add the platform transport quoting required by `system()`.
 *
 * Windows `system()` delegates to `cmd.exe /c`. The extra outer quote pair
 * lets cmd.exe consume that transport layer while preserving the inner quote
 * pair around a compiler executable path that contains spaces.
 */
func ld_wrap_system_command(command: string, windows: bool) -> string {
    if (windows) {
        return "\"" + command + "\"";
    }
    return command;
}

/** Execute one captured host command and preserve its output. */
func ld_run_host_command(
    words: StringVector*,
    stdout_path: string,
    stderr_path: string,
    code: string,
    failure_message: string,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> bool {
    if (bd_is_windows()) {
        with (let shell_values = sv_create(sv_size(words) + 2) =>
                  sv_free(shell_values)) {
            for (let i = 0; i < sv_size(words); i = i + 1) {
                sv_push(shell_values, sv_get(words, i));
            }
            sv_push(shell_values, stdout_path);
            sv_push(shell_values, stderr_path);
            if (!ld_validate_windows_shell_words(
                    shell_values,
                    code,
                    failure_message +
                        ": unsupported Windows shell expansion or quote character",
                    diags)) {
                return false;
            }
        }
    }
    log_info(cfg, bd_join_display_words(words));
    let command = ld_wrap_system_command(
        bd_join_shell_words(words) + " > " +
            bd_shell_quote(stdout_path) + " 2> " +
            bd_shell_quote(stderr_path),
        bd_is_windows()
    );
    let rc = system(command);
    let failed = rc != 0;
    if (failed) {
        ld_error(diags, code, failure_message, "");
    }
    bd_replay_compile_output(cfg, stdout_path, stderr_path, failed);
    return !failed;
}

/** Validate the no-follow wrapper object endpoint before final linking. */
func ld_validate_wrapper_object(
    wrapper_path: string,
    diags: DiagCollector*
) -> bool {
    if (cfs_path_kind(wrapper_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2108",
            "wrapper compiler did not produce a no-follow regular object: " +
                wrapper_path,
            wrapper_path
        );
        return false;
    }
    return true;
}

/**
 * Compile and link one verified plan through caller-supplied scratch paths.
 *
 * This common executor never allocates or cleans the transaction that owns
 * `scratch`; standalone CLI orchestration and later build/run orchestration
 * retain that responsibility.
 */
func ld_execute_plan(
    plan: LinkPlan*,
    compiler: string,
    extra_opts: StringVector*,
    runtime_include: string,
    runtime_inputs: StringVector*,
    output_path: string,
    scratch: LinkTransaction*,
    cfg: LogConfig*,
    diags: DiagCollector*
) -> bool {
    let wrapper_source = we_emit_wrapper(
        plan.lifecycle_order, plan.entry_module);
    if (write_file(scratch.wrapper_c, wrapper_source) == null) {
        ld_error(
            diags,
            "L1C-2107",
            "cannot write standalone-link wrapper: " + scratch.wrapper_c,
            scratch.wrapper_c
        );
        return false;
    }

    with (
        let compile_words = sv_create(20) => sv_free(compile_words),
        let link_words = sv_create(20 + vec_size(plan.inputs)) =>
            sv_free(link_words)
    ) {
        let family = bd_compiler_flag_family(compiler);
        let optimize = bd_get_optimize_flag(family, extra_opts);
        ld_push_wrapper_compile_words(
            compile_words,
            compiler,
            family,
            extra_opts,
            optimize,
            runtime_include,
            scratch.wrapper_c,
            scratch.wrapper_object
        );
        log_info(cfg, "Compiling standalone-link wrapper:");
        if (!ld_run_host_command(
                compile_words,
                scratch.compile_stdout,
                scratch.compile_stderr,
                "L1C-2108",
                "standalone-link wrapper compilation failed",
                cfg,
                diags)) {
            return false;
        }
        if (!ld_validate_wrapper_object(scratch.wrapper_object, diags)) {
            return false;
        }

        ld_push_final_link_words_with_runtime_inputs(
            link_words,
            compiler,
            family,
            scratch.wrapper_object,
            plan,
            runtime_inputs,
            output_path
        );
        log_info(cfg, "Linking standalone executable:");
        if (!ld_run_host_command(
                link_words,
                scratch.link_stdout,
                scratch.link_stderr,
                "L1C-2109",
                "standalone host link failed",
                cfg,
                diags)) {
            return false;
        }
    }

    if (cfs_path_kind(output_path) != CFS_PATH_REGULAR) {
        ld_error(
            diags,
            "L1C-2109",
            "host linker did not produce a regular executable: " + output_path,
            output_path
        );
        return false;
    }
    return true;
}

/** Execute public `l1c --link` mode. */
func ld_cmd_link(opts: CliOptions*, cfg: LogConfig*) -> int {
    with (let diags = diag_create() => diag_free(diags)) {
        let plan = ld_prepare_cli_inputs(
            opts.link_operands, opts.entry_module, diags);
        if (plan == null) {
            dp_print_collector(diags);
            return 1;
        }
        let verified = plan as LinkPlan*;
        let output_path = opts.output as string;

        let valid_output = ld_validate_output(output_path, diags);
        let compiler = ld_take_compiler(opts, diags);
        let extra_opts = bd_collect_c_option_words(opts);
        let runtime_include = ld_runtime_include(opts, diags);
        let runtime_inputs: StringVector*? = null;
        if (compiler != null) {
            runtime_inputs = ld_runtime_link_inputs(
                opts, compiler as string, diags);
        }
        let valid_aliases = true;
        let valid_windows_values = true;
        if (valid_output && runtime_inputs != null && runtime_include != null) {
            let resolved_include = runtime_include as LinkRuntimeInclude*;
            valid_aliases = ld_validate_output_aliases(
                output_path,
                verified,
                runtime_inputs as StringVector*,
                resolved_include.header_path,
                diags
            );
        }
        if (bd_is_windows() &&
            compiler != null && runtime_include != null &&
            runtime_inputs != null) {
            valid_windows_values = ld_validate_windows_shell_values(
                compiler as string,
                extra_opts,
                (runtime_include as LinkRuntimeInclude*).directory,
                runtime_inputs as StringVector*,
                output_path,
                verified,
                diags
            );
        }
        if (!valid_output || compiler == null ||
            runtime_include == null || runtime_inputs == null ||
            !valid_aliases || !valid_windows_values) {
            dp_print_collector(diags);
            if (runtime_inputs != null) {
                sv_free(runtime_inputs as StringVector*);
            }
            if (runtime_include != null) {
                ld_runtime_include_free(
                    runtime_include as LinkRuntimeInclude*);
            }
            sv_free(extra_opts);
            ld_plan_free(verified);
            return 1;
        }

        let output_parent = parent(output_path);
        let txn = ld_create_transaction(output_parent, diags);
        if (txn == null) {
            dp_print_collector(diags);
            sv_free(runtime_inputs as StringVector*);
            ld_runtime_include_free(
                runtime_include as LinkRuntimeInclude*);
            sv_free(extra_opts);
            ld_plan_free(verified);
            return 1;
        }
        let scratch = txn as LinkTransaction*;

        let succeeded = ld_execute_plan(
            verified,
            compiler as string,
            extra_opts,
            (runtime_include as LinkRuntimeInclude*).directory,
            runtime_inputs as StringVector*,
            output_path,
            scratch,
            cfg,
            diags
        );
        let cleaned = ld_cleanup_transaction(scratch);
        if (!cleaned) {
            ld_error(
                diags,
                "L1C-2109",
                "standalone-link transaction cleanup failed; retained files in " +
                    scratch.root,
                scratch.root
            );
        }

        if (diag_count(diags) > 0) {
            dp_print_collector(diags);
        }
        ld_transaction_free(scratch);
        sv_free(runtime_inputs as StringVector*);
        ld_runtime_include_free(
            runtime_include as LinkRuntimeInclude*);
        sv_free(extra_opts);
        ld_plan_free(verified);

        if (!succeeded || !cleaned) {
            return 1;
        }
        log_info(cfg, "Linked executable: " + output_path);
        return 0;
    }
}
