/**
 * Returns the root directory for test fixtures.
 *
 * @return The driver fixture directory used by these tests.
 */
func fixture_root() -> string {
    return "compiler/stage1_l0/tests/fixtures/driver";
}

/**
 * Return the root containing filesystem interface-resolution fixtures.
 *
 * @return Module-graph fixture directory.
 */
func interface_fixture_root() -> string {
    return "compiler/stage1_l0/tests/fixtures/module_graph";
}

/**
 * Creates and configures source search paths for testing.
 *
 * @return Source search paths rooted at the driver fixtures directory.
 */
func make_paths() -> SourceSearchPaths* {
    let sp = sp_create();
    sp_add_project_root(sp, fixture_root());
    return sp;
}

/**
 * Checks if a specific diagnostic code is present in the results.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to look for.
 * @return `true` if the diagnostic code is present, otherwise `false`.
 */
func has_driver_diag_code(result: DriverState*, code: string) -> bool {
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            return true;
        }
    }
    return false;
}

/**
 * Counts diagnostics with the requested code.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to count.
 * @return Number of diagnostics carrying `code`.
 */
func driver_diag_code_count(result: DriverState*, code: string) -> int {
    let found = 0;
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            found = found + 1;
        }
    }
    return found;
}

/**
 * Return the first message carrying one diagnostic code.
 *
 * @param result Driver result to inspect.
 * @param code Diagnostic code to match.
 * @return Matching message, or `null`.
 */
func driver_diag_message(result: DriverState*, code: string) -> string? {
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            return d.message;
        }
    }
    return null;
}

/**
 * Tests test_transitive_import_closure_ok.
 */
func test_transitive_import_closure_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "ok_main", cfg);

        assert(!driver_has_errors(result), "expected no driver errors for ok_main");
        assert(driver_unit_count(result) == 4, "expected 4 loaded modules in closure");

        driver_state_free(result);
    }
    sp_free(sp);
}

