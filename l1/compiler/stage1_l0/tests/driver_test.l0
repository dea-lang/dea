/**
 * Tests invalid selected interface UTF-8 reports DRV-0076 authoritatively.
 */
func test_selected_invalid_utf8_interface_reports_drv_0076() {
    let path = "build/utf8_provider.l1m";
    assert(write_file(path, byte_to_s(255 as byte)) != null, "expected invalid UTF-8 fixture write");

    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, "build");
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "utf8_entry", roots, MRP_ALLOW_SOURCE_FALLBACK, null, cfg
        );
        assert(driver_has_errors(result), "invalid interface UTF-8 should fail");
        assert(has_driver_diag_code(result, "DRV-0076"), "expected DRV-0076");
        assert(driver_find_unit(result, "utf8_provider") == null, "invalid interface must not fall back");
        driver_state_free(result);
    }
    std.fs::delete_file(path);
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests interface require/link cycles report the complete canonical chain and
 * never transition failed nodes to resolved cache entries.
 */
func test_interface_cycle_reports_complete_chain_and_failed_state() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "interfaces_cycle"));
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "interface_cycle_entry", roots, MRP_REQUIRE_INTERFACE, null, cfg
        );
        assert(driver_has_errors(result), "interface cycle should fail");
        let message = driver_diag_message(result, "DRV-0030");
        assert(message != null, "expected DRV-0030 cycle diagnostic");
        assert(contains_s(message as string, "cycle.one -> cycle.two -> cycle.one"),
            "cycle diagnostic must contain the complete canonical chain");
        let one = mg_find_node(driver_graph(result), "cycle.one") as ModuleGraphNode*;
        let two = mg_find_node(driver_graph(result), "cycle.two") as ModuleGraphNode*;
        assert(ord(one.state) == ord(MNS_FAILED), "cycle.one must remain failed");
        assert(ord(two.state) == ord(MNS_FAILED), "cycle.two must remain failed");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Main entry point for the module.
 */
func main() {
    test_transitive_import_closure_ok();
    test_import_cycle_reports_error();
    test_module_name_mismatch_reports_error();
    test_read_failure_reports_error();
    test_lexer_errors_recover_into_parser();
    test_resolution_entry_is_always_source();
    test_interface_first_transitive_graph_contract();
    test_required_interface_missing_is_specific();
    test_repeated_missing_provider_is_resolved_once();
    test_source_fallback_preserves_root_precedence();
    test_invalid_interface_root_reports_drv_0073();
    test_selected_malformed_interface_is_authoritative();
    test_conflicting_graph_identity_reports_drv_0077();
    test_selected_interface_header_mismatch_is_authoritative();
    test_selected_nonregular_interface_reports_drv_0075();
    test_selected_invalid_utf8_interface_reports_drv_0076();
    test_interface_cycle_reports_complete_chain_and_failed_state();
    printl_s("driver_test: all tests passed");
}
