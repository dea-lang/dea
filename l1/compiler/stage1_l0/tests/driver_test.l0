/**
 * Tests test_lexer_errors_recover_into_parser.
 */
func test_lexer_errors_recover_into_parser() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "invalid_chars", cfg);

        assert(driver_has_errors(result), "expected lexer errors");
        assert(driver_diag_code_count(result, "LEX-0040") == 3, "expected three LEX-0040 diagnostics");
        assert(driver_diag_code_count(result, "PAR-0310") == 1, "expected one missing-module-header diagnostic");
        assert(driver_unit_count(result) == 1, "expected one failed unit shell after lexer errors");
        let unit = driver_unit_get(result, 0);
        assert(unit.parse_result.root_module == null, "expected no parsed module without a module header");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests the requested target remains source-backed even when a matching
 * malformed interface exists and strict interface policy is selected.
 */
func test_resolution_entry_is_always_source() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "interfaces_first"));
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "ok_leaf", roots, MRP_REQUIRE_INTERFACE, null, cfg
        );
        assert(!driver_has_errors(result), "matching entry interface must be ignored");
        assert(driver_unit_count(result) == 1, "entry should be parsed from source");
        let node = mg_find_node(driver_graph(result), "ok_leaf") as ModuleGraphNode*;
        assert(ord(node.origin.kind) == ord(MOK_SOURCE), "entry graph node must be source-backed");
        assert(mg_node_count(driver_graph(result)) == 2, "source-only graph should also contain virtual dea");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests first-root interface selection, recursive require/link closure,
 * semantic activation, artifacts, sorted enumeration, and exact imports.
 */
func test_interface_first_transitive_graph_contract() {
    let sp = make_paths();
    let roots = sv_create(2);
    let first = join(interface_fixture_root(), "interfaces_first");
    let second = join(interface_fixture_root(), "interfaces_second");
    sv_push(roots, first);
    sv_push(roots, second);

    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "graph_entry", roots, MRP_REQUIRE_INTERFACE, "build/module-artifacts", cfg
        );
        assert(!driver_has_errors(result), "interface-first graph should resolve");
        assert(driver_unit_count(result) == 1, "interface providers must not load source");
        assert(driver_provider_fingerprint(result, "graph.provider") == "first-root",
            "first matching interface root must win");

        let graph = driver_graph(result);
        assert(mg_node_count(graph) == 6, "expected entry, dea, and four interface graph nodes");
        with (let names = mg_node_names_sorted(graph) => sv_free(names),
              let names2 = mg_node_names_sorted(graph) => sv_free(names2)) {
            assert(sv_size(names) == 6 && sv_size(names2) == 6, "sorted graph enumeration size mismatch");
            assert(sv_get(names, 0) == "dea", "dea should sort first");
            assert(sv_get(names, 1) == "graph.linked", "link provider ordering mismatch");
            assert(sv_get(names, 2) == "graph.provider", "direct provider ordering mismatch");
            assert(sv_get(names, 3) == "graph.required", "require provider ordering mismatch");
            assert(sv_get(names, 4) == "graph.unused", "unused direct import ordering mismatch");
            assert(sv_get(names, 5) == "graph_entry", "entry ordering mismatch");
            for (let i = 0; i < sv_size(names); i = i + 1) {
                assert(sv_get(names, i) == sv_get(names2, i), "graph enumeration must be stable");
            }
        }

        let entry = mg_find_node(graph, "graph_entry") as ModuleGraphNode*;
        assert(mg_node_direct_import_count(entry) == 3, "direct imports must retain duplicates and unused entries");
        assert(mg_node_direct_import_get(entry, 0) == "graph.provider", "first direct import mismatch");
        assert(mg_node_direct_import_get(entry, 1) == "graph.unused", "unused direct import mismatch");
        assert(mg_node_direct_import_get(entry, 2) == "graph.provider", "duplicate direct import mismatch");
        assert(entry.artifacts != null, "source artifact root should associate artifacts");
        assert((entry.artifacts as ModuleArtifactPaths*).interface_path ==
            "build/module-artifacts/graph_entry.l1m", "source artifact spelling mismatch");

        let provider = mg_find_node(graph, "graph.provider") as ModuleGraphNode*;
        assert(ord(provider.origin.kind) == ord(MOK_INTERFACE), "provider should be filesystem-interface backed");
        assert(provider.origin.path != null && provider.origin.path as string == join(first, "graph/provider.l1m"),
            "selected provider path mismatch");
        assert(provider.artifacts != null, "filesystem interface must derive sibling artifacts");
        assert((provider.artifacts as ModuleArtifactPaths*).c_path == join(first, "graph/provider.c"),
            "interface sibling C path mismatch");
        assert(mg_node_dependency_count(provider) == 2, "provider manifest edge count mismatch");
        let require_dep = mg_node_dependency_get(provider, 0);
        let link_dep = mg_node_dependency_get(provider, 1);
        assert(ord(require_dep.kind) == ord(MDK_REQUIRE), "first edge must retain require tier");
        assert(require_dep.expected_fingerprint == "require-expectation", "require expectation must be opaque");
        assert(ord(link_dep.kind) == ord(MDK_LINK), "second edge must retain link tier");
        assert(link_dep.expected_fingerprint == "link-expectation", "link expectation must be opaque");

        assert(driver_interface_count(result) == 3,
            "direct providers plus transitive require providers should activate exactly once");
        assert(driver_find_interface(result, "graph.provider") != null, "direct provider should activate");
        assert(driver_find_interface(result, "graph.unused") != null, "unused direct import should activate");
        assert(driver_find_interface(result, "graph.required") != null, "transitive require provider should activate");
        assert(driver_find_interface(result, "graph.linked") == null, "link-only provider must not enter semantic scope");
        assert(driver_find_graph_interface(result, "graph.linked") != null,
            "link-only provider must remain available through the graph");
        assert(!has_driver_diag_code(result, "DRV-0030"), "duplicate imports are cache hits, not cycles");
        driver_state_free(result);
    }

    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests strict resolution rejects a missing imported interface without using
 * otherwise available source fallback.
 */
func test_required_interface_missing_is_specific() {
    let sp = sp_create();
    sp_add_project_root(sp, fixture_root());
    sp_add_system_root(sp, join(fixture_root(), "source_system"));
    let roots = sv_create(0);
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "fallback_entry", roots, MRP_REQUIRE_INTERFACE, null, cfg
        );
        assert(driver_has_errors(result), "strict policy should reject missing provider interface");
        assert(has_driver_diag_code(result, "DRV-0074"), "expected DRV-0074");
        assert(driver_find_unit(result, "graph.fallback") == null, "strict policy must not load provider source");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests repeated manifest edges to one absent provider retain every graph edge
 * while reporting and searching for that provider only once.
 */
func test_repeated_missing_provider_is_resolved_once() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "interfaces_repeated_missing"));

    with (let strict_cfg = log_config_create(LL_SILENT, false) => drop strict_cfg) {
        let strict = driver_analyze_entry_with_resolution(
            sp, "repeated_missing_entry", roots, MRP_REQUIRE_INTERFACE, null, strict_cfg
        );
        assert(driver_has_errors(strict), "strict policy should reject the absent provider");
        assert(driver_diag_code_count(strict, "DRV-0074") == 1,
            "strict policy should report one missing-interface diagnostic per provider");
        assert(driver_diag_code_count(strict, "DRV-0010") == 0,
            "strict policy must not attempt source fallback");
        let strict_fanout = mg_find_node(driver_graph(strict), "missing.fanout") as ModuleGraphNode*;
        assert(ord(strict_fanout.state) == ord(MNS_FAILED), "fanout node should retain failed state");
        assert(mg_node_dependency_count(strict_fanout) == 3,
            "resolution caching must retain all require and link edges");
        assert(mg_find_node(driver_graph(strict), "missing.provider") == null,
            "an absent provider must not create a public graph node");
        driver_state_free(strict);
    }

    with (let fallback_cfg = log_config_create(LL_SILENT, false) => drop fallback_cfg) {
        let fallback = driver_analyze_entry_with_resolution(
            sp, "repeated_missing_entry", roots, MRP_ALLOW_SOURCE_FALLBACK, null, fallback_cfg
        );
        assert(driver_has_errors(fallback), "fallback policy should reject the absent source provider");
        assert(driver_diag_code_count(fallback, "DRV-0010") == 1,
            "fallback policy should report one missing-source diagnostic per provider");
        assert(driver_diag_code_count(fallback, "DRV-0074") == 0,
            "fallback policy should not report a strict-interface diagnostic");
        let fallback_fanout = mg_find_node(driver_graph(fallback), "missing.fanout") as ModuleGraphNode*;
        assert(ord(fallback_fanout.state) == ord(MNS_FAILED), "fanout node should retain failed state");
        assert(mg_node_dependency_count(fallback_fanout) == 3,
            "fallback caching must retain all require and link edges");
        assert(mg_find_node(driver_graph(fallback), "missing.provider") == null,
            "an absent source provider must not create a public graph node");
        driver_state_free(fallback);
    }

    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests source fallback retains system-root-before-project-root precedence.
 */
func test_source_fallback_preserves_root_precedence() {
    let sp = sp_create();
    let system_root = join(fixture_root(), "source_system");
    let project_root = join(fixture_root(), "source_project");
    sp_add_system_root(sp, system_root);
    sp_add_project_root(sp, fixture_root());
    sp_add_project_root(sp, project_root);
    let roots = sv_create(0);
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "fallback_entry", roots, MRP_ALLOW_SOURCE_FALLBACK, null, cfg
        );
        assert(!driver_has_errors(result), "source fallback should resolve");
        let unit = driver_find_unit(result, "graph.fallback") as DriverUnit*;
        assert(unit.path == join(system_root, "graph/fallback.l1"), "system source root must win fallback");
        let node = mg_find_node(driver_graph(result), "graph.fallback") as ModuleGraphNode*;
        assert(ord(node.origin.kind) == ord(MOK_SOURCE), "fallback provider should be source-backed");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests interface roots are validated before source loading begins.
 */
func test_invalid_interface_root_reports_drv_0073() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "does-not-exist"));
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "ok_leaf", roots, MRP_ALLOW_SOURCE_FALLBACK, null, cfg
        );
        assert(driver_has_errors(result), "invalid root should fail graph loading");
        assert(has_driver_diag_code(result, "DRV-0073"), "expected DRV-0073");
        assert(driver_unit_count(result) == 0, "invalid roots should fail before entry parsing");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests the first existing malformed interface is authoritative over source.
 */
func test_selected_malformed_interface_is_authoritative() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "interfaces_bad_parse"));
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "provider_entry", roots, MRP_ALLOW_SOURCE_FALLBACK, null, cfg
        );
        assert(driver_has_errors(result), "malformed selected interface should fail");
        assert(has_driver_diag_code(result, "PAR-0561"), "selected interface should retain parser diagnostics");
        assert(driver_diag_code_count(result, "PAR-0561") == 1, "selected interface must be parsed only once");
        assert(!has_driver_diag_code(result, "DRV-0030"), "a repeated failed-node lookup is not a cycle");
        assert(driver_find_unit(result, "graph.provider") == null, "malformed selection must not fall back to source");
        let node = mg_find_node(driver_graph(result), "graph.provider") as ModuleGraphNode*;
        assert(ord(node.state) == ord(MNS_FAILED), "selected malformed interface node must remain failed");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

/**
 * Tests conflicting attempts to register one canonical graph identity use the
 * dedicated DRV-0077 diagnostic and preserve the first origin.
 */
func test_conflicting_graph_identity_reports_drv_0077() {
    let state = dr_state_create("conflict", null);
    let first = mg_node_from_source("conflict", "first/conflict.l1", null);
    let second = mg_node_from_source("conflict", "second/conflict.l1", null);
    assert(dr_add_graph_node(state, first), "first canonical graph identity should register");
    assert(!dr_add_graph_node(state, second), "conflicting canonical graph identity should fail");
    assert(has_driver_diag_code(state, "DRV-0077"), "expected DRV-0077");
    let retained = mg_find_node(driver_graph(state), "conflict") as ModuleGraphNode*;
    assert(retained.origin.path != null && retained.origin.path as string == "first/conflict.l1",
        "graph must preserve the first selected origin");
    driver_state_free(state);
}

/**
 * Tests interface header identity mismatch reuses DRV-0020 authoritatively.
 */
func test_selected_interface_header_mismatch_is_authoritative() {
    let sp = make_paths();
    let roots = sv_create(1);
    sv_push(roots, join(interface_fixture_root(), "interfaces_bad_header"));
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry_with_resolution(
            sp, "provider_entry", roots, MRP_ALLOW_SOURCE_FALLBACK, null, cfg
        );
        assert(driver_has_errors(result), "mismatched selected interface should fail");
        assert(has_driver_diag_code(result, "DRV-0020"), "expected DRV-0020 for interface identity mismatch");
        assert(driver_find_unit(result, "graph.provider") == null, "mismatch must not fall back to source");
        driver_state_free(result);
    }
    sv_free(roots);
    sp_free(sp);
}

