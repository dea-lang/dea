module wrapper_emitter_test;

import std.assert;
import std.io;
import std.string;
import std.vector;

import wrapper_emitter;

/**
 * Pin the complete standalone wrapper and its lifecycle ordering.
 */
func test_wrapper_lifecycle_and_entry() {
    with (let lifecycle_order = sv_create(4) => sv_free(lifecycle_order)) {
        sv_push(lifecycle_order, "demo.leaf");
        sv_push(lifecycle_order, "demo.dependency");
        sv_push(lifecycle_order, "demo.main");
        sv_push(lifecycle_order, "side.effect");

        let actual = we_emit_wrapper(lifecycle_order, "demo.main");
        let expected =
            "/* Generated by l1c --link. */\n" +
            "#include \"dea_rt.h\"\n" +
            "\n" +
            "extern void __deaM4demo4leafI4init(void);\n" +
            "extern void __deaM4demo4leafI4fini(void);\n" +
            "extern void __deaM4demo10dependencyI4init(void);\n" +
            "extern void __deaM4demo10dependencyI4fini(void);\n" +
            "extern void __deaM4demo4mainI4init(void);\n" +
            "extern void __deaM4demo4mainI4fini(void);\n" +
            "extern void __deaM4side6effectI4init(void);\n" +
            "extern void __deaM4side6effectI4fini(void);\n" +
            "extern int __deaM4demo4mainI5entry(void);\n" +
            "\n" +
            "int main(int argc, char **argv)\n" +
            "{\n" +
            "    int dea_exit_code;\n" +
            "\n" +
            "    _rt_init_args(argc, argv);\n" +
            "    __deaM4demo4leafI4init();\n" +
            "    __deaM4demo10dependencyI4init();\n" +
            "    __deaM4demo4mainI4init();\n" +
            "    __deaM4side6effectI4init();\n" +
            "    dea_exit_code = __deaM4demo4mainI5entry();\n" +
            "    __deaM4side6effectI4fini();\n" +
            "    __deaM4demo4mainI4fini();\n" +
            "    __deaM4demo10dependencyI4fini();\n" +
            "    __deaM4demo4leafI4fini();\n" +
            "    return dea_exit_code;\n" +
            "}\n";

        assert(actual == expected,
            "wrapper must preserve dependency-first init and exact reverse fini");
        assert(find_s(actual, "_rt_init_args(argc, argv);") <
            find_s(actual, "__deaM4demo4leafI4init();"),
            "runtime argument setup must precede module initialization");
        assert(find_s(actual, "__deaM4side6effectI4init();") <
            find_s(actual, "dea_exit_code = __deaM4demo4mainI5entry();"),
            "selected entry must run after every module initializer");
        assert(find_s(actual, "dea_exit_code = __deaM4demo4mainI5entry();") <
            find_s(actual, "__deaM4side6effectI4fini();"),
            "finalization must begin after the selected entry returns");
        assert(!contains_s(actual, "__deaM4side6effectI5entry"),
            "wrapper must declare and invoke only the selected entry bridge");
    }
}

/**
 * Ensure the generated source owns exactly one process-level C entry point.
 */
func test_wrapper_owns_only_process_main() {
    with (let lifecycle_order = sv_create(1) => sv_free(lifecycle_order)) {
        sv_push(lifecycle_order, "app");
        let actual = we_emit_wrapper(lifecycle_order, "app");
        let first_main = find_s(actual, "int main(int argc, char **argv)");

        assert(first_main >= 0, "wrapper must define the process-level C main");
        assert(find_s(slice_s(actual, first_main + 1, len_s(actual)),
            "int main(int argc, char **argv)") < 0,
            "wrapper must define exactly one process-level C main");
        assert(contains_s(actual, "extern int __deaM3appI5entry(void);"),
            "selected Dea entry must remain an external bridge declaration");
    }
}

/**
 * Main entry point.
 */
func main() {
    test_wrapper_lifecycle_and_entry();
    test_wrapper_owns_only_process_main();
    printl_s("wrapper_emitter_test: all tests passed");
}
