/**
 * Create an empty driver state for isolated semantic helper tests.
 *
 * @return New empty driver state.
 */
func bt_empty_driver_state() -> DriverState* {
    return dr_state_create("", null);
}

/**
 * Create an empty analysis result for isolated helper tests.
 *
 * @return New empty analysis result.
 */
func bt_empty_analysis_result() -> AnalysisResult* {
    return new AnalysisResult(bt_empty_driver_state(), diag_create(), null, null, null, spm_create(), sim_create(), spm_create());
}

/**
 * Parse and add one source module to a driver state.
 *
 * @param state Driver state to update.
 * @param source Module source text.
 * @param filename Source filename for diagnostics.
 */
func bt_push_source_unit(state: DriverState*, source: string, filename: string) {
    let pr = parse_module_source(source, filename);
    if (pr.root_module == null) {
        dr_register_unit(state, new DriverUnit("", filename, pr));
        return;
    }

    let mod = pr.root_module as Module*;
    sv_push(state.source_names, filename);
    sv_push(state.source_texts, source);
    dr_register_unit(state, new DriverUnit(mod.name, filename, pr));
}

/**
 * Build a full semantic analysis result from in-memory module sources.
 *
 * @param entry_module Entry-module name.
 * @param filenames Source filenames aligned with `sources`.
 * @param sources Module source texts aligned with `filenames`.
 * @return Fully analyzed result.
 */
func bt_analyze_sources(entry_module: string, filenames: StringVector*, sources: StringVector*) -> AnalysisResult* {
    let state = dr_state_create(entry_module, null);

    for (let i = 0; i < sv_size(sources); i = i + 1) {
        bt_push_source_unit(state, sv_get(sources, i), sv_get(filenames, i));
    }

    let result = new AnalysisResult(state, diag_create(), null, null, null, spm_create(), sim_create(), spm_create());
    result.names = nr_resolve(state, result.diags);
    result.signatures = sig_resolve(state, result.names as NameResolution*, result.diags);
    result.locals_result = locals_resolve(state, result.diags);
    expr_types_check(result);
    return result;
}

/**
 * Join newline-terminated source lines into one module source string.
 *
 * @param lines Source lines in order.
 * @return Combined source text with trailing newlines.
 */
func bt_source(lines: StringVector*) -> string {
    with (let sb = sb_create() => sb_free(sb)) {
        for (let i = 0; i < sv_size(lines); i = i + 1) {
            sb_append(sb, sv_get(lines, i));
            sb_append(sb, "\n");
        }
        return sb_to_string(sb);
    }
}

/**
 * Count non-overlapping occurrences of one substring.
 *
 * @param text Text to scan.
 * @param needle Substring to count.
 * @return Occurrence count.
 */
func bt_count_substring(text: string, needle: string) -> int {
    let count = 0;
    let pos = 0;
    while (true) {
        let found = find_from_s(text, needle, pos);
        if (found < 0) {
            return count;
        }
        count = count + 1;
        pos = found + len_s(needle);
    }
    return count;
}

/**
 * Tests test_codegen_options_defaults.
 */
func test_codegen_options_defaults() {
    let opts = cg_options_create();
    assert(opts.emit_line_directives, "line directives should default to enabled");
    assert(!opts.trace_arc, "trace_arc should default to false");
    assert(!opts.trace_memory, "trace_memory should default to false");
    cg_options_free(opts);
}

/**
 * Tests test_scope_context_tracks_declared_and_owned_variables.
 */
func test_scope_context_tracks_declared_and_owned_variables() {
    let scope = sc_create(null);
    let ty = type_builtin_int();
    sc_add_declared(scope, "plain", ty);
    sc_add_owned(scope, "owned", ty);

    assert(sc_lookup_declared_type(scope, "plain") != null, "declared variable should be found");
    assert(sc_lookup_declared_type(scope, "owned") != null, "owned variable should be found");
    assert(vec_size(scope.owned_vars) == 1, "expected one owned variable");

    sc_remove_owned(scope, "owned");
    assert(vec_size(scope.owned_vars) == 0, "owned variable should be removed");

    type_free(ty);
    sc_free(scope);
}

/**
 * Tests test_scope_context_inline_cleanup_tracking.
 */
func test_scope_context_inline_cleanup_tracking() {
    let scope = sc_create(null);
    assert(!sc_has_inline_cleanup(scope), "inline cleanup should start empty");
    sc_push_inline_cleanup(scope, 3);
    sc_push_inline_cleanup(scope, 9);
    assert(sc_has_inline_cleanup(scope), "inline cleanup should be present");
    assert(vec_size(scope.with_cleanup_inline as VectorBase*) == 2, "expected two cleanup items");
    sc_free(scope);
}

/**
 * Tests test_backend_scope_helpers_manage_cleanup_state.
 */
func test_backend_scope_helpers_manage_cleanup_state() {
    with (let result = bt_empty_analysis_result() => analysis_result_free(result),
          let opts = cg_options_create() => cg_options_free(opts),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let self = be_create(result, opts, cfg) => be_free(self)) {
        let borrowed_ty = type_builtin_int();
        let owned_ty = type_builtin_string();
        let temp_ty = type_builtin_string();
        let root = be_push_scope(self);
        sc_add_declared(root, "borrowed", borrowed_ty);
        sc_add_owned(root, "owned_name", owned_ty);

        assert(be_lookup_local_var_type(self, "borrowed") != null, "declared local lookup should succeed");
        assert(be_scope_chain_has_cleanup(self), "owned ARC local should trigger cleanup detection");

        let temp = be_materialize_arc_temp(self, "((dea_string)DEA_STRING_CONST(\"x\", 1))", temp_ty);
        assert(temp == "dea_arc_1", "ARC temp naming mismatch");
        assert(vec_size(root.owned_vars) == 2, "materialized ARC temp should become owned");

        let child = be_push_scope(self);
        sc_push_inline_cleanup(child, 7);
        assert(be_scope_chain_has_cleanup(self), "inline cleanup in child scope should be visible");
        be_pop_scope(self);
        be_pop_scope(self);
        type_free(borrowed_ty);
        type_free(owned_ty);
        type_free(temp_ty);
    }
}

/**
 * Tests test_analysis_expr_lookup_helpers.
 */
func test_analysis_expr_lookup_helpers() {
    let result = bt_empty_analysis_result();
    let expr_key = analysis_expr_key("demo.main", 7);
    assert(expr_key == "demo.main::7", "expression key mismatch");

    spm_put(result.expr_types, analysis_expr_key("demo.main", 7), type_builtin_bool() as void*);
    spm_put(result.intrinsic_targets, analysis_expr_key("demo.main", 8), type_builtin_int() as void*);
    sim_put(result.var_ref_resolution, analysis_expr_key("demo.main", 9), ord(VAR_RES_LOCAL));

    let expr_ty = analysis_get_expr_type(result, "demo.main", 7);
    let intrinsic_ty = analysis_get_intrinsic_target(result, "demo.main", 8);
    let var_res = analysis_get_var_ref_resolution(result, "demo.main", 9);

    assert(expr_ty != null, "expression type lookup should succeed");
    assert(type_is_builtin(expr_ty as Type*, "bool"), "expression type should be bool");
    assert(intrinsic_ty != null, "intrinsic target lookup should succeed");
    assert(type_is_builtin(intrinsic_ty as Type*, "int"), "intrinsic target should be int");
    assert(var_res != null && (var_res as int) == ord(VAR_RES_LOCAL), "var-ref resolution mismatch");

    type_free(expr_ty as Type*);
    type_free(intrinsic_ty as Type*);
    analysis_result_free(result);
}

/**
 * Tests test_analysis_has_arc_data_for_struct_and_nullable_pointer.
 */
func test_analysis_has_arc_data_for_struct_and_nullable_pointer() {
    let result = bt_empty_analysis_result();

    let struct_fields = ptr_vec_create(1);
    ptr_vec_push(struct_fields, new StructFieldInfo("name", type_builtin_string()) as void*);
    let struct_info = new StructInfo(
        "demo.main::Thing",
        "demo.main",
        "Thing",
        "",
        span_here(1, 1),
        type_new_struct("demo.main", "Thing"),
        struct_fields,
        "",
        false
    );

    result.signatures = new SignatureTables(spm_create(), spm_create(), spm_create(), spm_create());
    spm_put((result.signatures as SignatureTables*).struct_infos, "demo.main::Thing", struct_info as void*);

    let query_struct = type_new_struct("demo.main", "Thing");
    let query_nullable_ptr = type_new_nullable(type_new_pointer(type_builtin_int()));

    assert(analysis_has_arc_data(result, query_struct), "struct with string field should have ARC data");
    assert(!analysis_has_arc_data(result, query_nullable_ptr), "nullable pointer should use niche encoding without ARC");

    type_free(query_struct);
    type_free(query_nullable_ptr);
    analysis_result_free(result);
}

/**
 * Tests test_backend_generate_types_and_top_level_lets.
 */
func test_backend_generate_types_and_top_level_lets() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct Point {");
        sv_push(lines, "    x: int;");
        sv_push(lines, "    y: int;");
        sv_push(lines, "}");
        sv_push(lines, "enum MaybePoint {");
        sv_push(lines, "    None;");
        sv_push(lines, "    Some(value: Point);");
        sv_push(lines, "}");
        sv_push(lines, "type Alias = Point;");
        sv_push(lines, "let origin: Alias = Alias(0, 0);");
        sv_push(lines, "let empty = None;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let p: Alias = Alias(origin.x, origin.y);");
        sv_push(lines, "    return p.x + ord(empty);");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for type-order fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "/* Type definitions (dependency-ordered) */"),
            "type-definition section comment missing");
        assert(contains_s(generated,
            "struct __deaM4demo4mainS5Point {\n    dea_int x;\n    dea_int y;\n};\n#endif\n\n#ifndef DEA_DEFINED___deaM4demo4mainE10MaybePoint"),
            "struct should be emitted before dependent enum");
        assert(contains_s(generated, "struct __deaM4demo4mainS5Point __deaM4demo4mainN6origin = { .x = 0, .y = 0 };"),
            "top-level alias-backed struct constructor let mismatch");
        assert(contains_s(generated, "struct __deaM4demo4mainS5Point p = (struct __deaM4demo4mainS5Point){ .x = (__deaM4demo4mainN6origin).x, .y = (__deaM4demo4mainN6origin).y };"),
            "local alias-backed struct constructor lowering mismatch");
        assert(contains_s(generated, "struct __deaM4demo4mainE10MaybePoint __deaM4demo4mainN5empty = { .tag = __deaM4demo4mainE10MaybePoint_None };"),
            "top-level bare variant let mismatch");
        assert(contains_s(generated, "(p).x"), "field access lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests `const` top-level bindings lower to `static const` C declarations.
 */
func test_backend_generate_top_level_consts() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(15) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct Point {");
        sv_push(lines, "    x: int;");
        sv_push(lines, "    y: int;");
        sv_push(lines, "}");
        sv_push(lines, "type Alias = Point;");
        sv_push(lines, "const origin: Alias = Alias(0, 0);");
        sv_push(lines, "enum Color {");
        sv_push(lines, "    Red;");
        sv_push(lines, "    Green(value: int);");
        sv_push(lines, "}");
        sv_push(lines, "const answer: int = 42;");
        sv_push(lines, "const folded: int = (answer + 6) / 4;");
        sv_push(lines, "const color: Color = Red;");
        sv_push(lines, "func main() -> int { return answer + folded + origin.x + origin.y + ord(color); }");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for top-level const fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "const struct __deaM4demo4mainS5Point __deaM4demo4mainN6origin = { .x = 0, .y = 0 };"),
            "top-level const alias-backed struct lowering mismatch");
        assert(contains_s(generated, "const dea_int __deaM4demo4mainN6answer = 42;"),
            "top-level const scalar lowering mismatch");
        assert(contains_s(generated, "const dea_int __deaM4demo4mainN6folded = 12;"),
            "top-level folded const scalar lowering mismatch");
        assert(contains_s(generated, "const struct __deaM4demo4mainE5Color __deaM4demo4mainN5color = { .tag = __deaM4demo4mainE5Color_Red };"),
            "top-level const bare variant lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests deferred top-level `let` initializers lower through hidden module init functions.
 */
func test_backend_generate_nonconstant_top_level_lets() {
    with (let filenames = sv_create(2) => sv_free(filenames),
          let sources = sv_create(2) => sv_free(sources),
          let dep_lines = sv_create(8) => sv_free(dep_lines),
          let main_lines = sv_create(8) => sv_free(main_lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/dep.l1");
        sv_push(dep_lines, "module demo.dep;");
        sv_push(dep_lines, "let base: int = seed();");
        sv_push(dep_lines, "func seed() -> int { return 20; }");
        sv_push(dep_lines, "func get_base() -> int { return base; }");
        sv_push(sources, bt_source(dep_lines));

        sv_push(filenames, "demo/main.l1");
        sv_push(main_lines, "module demo.main;");
        sv_push(main_lines, "import demo.dep;");
        sv_push(main_lines, "let answer: int = bump(demo.dep::get_base());");
        sv_push(main_lines, "func bump(x: int) -> int { return x + 3; }");
        sv_push(main_lines, "func main() -> int { return answer; }");
        sv_push(sources, bt_source(main_lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for deferred top-level lets");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "dea_int __deaM4demo3depN4base = 0;"),
            "deferred dep binding should be zero-initialized");
        assert(contains_s(generated, "dea_int __deaM4demo4mainN6answer = 0;"),
            "deferred main binding should be zero-initialized");
        assert(contains_s(generated, "static void __deaM4demo3depI4init(void)"),
            "dep init function missing");
        assert(contains_s(generated, "__deaM4demo3depN4base = __deaM4demo3depN4seedF0i();"),
            "dep init assignment mismatch");
        assert(contains_s(generated, "static void __deaM4demo4mainI4init(void)"),
            "main init function missing");
        assert(contains_s(generated, "__deaM4demo4mainN6answer = _rt_iadd(__deaM4demo4mainN4bumpF1ii(__deaM4demo3depN8get_baseF0i()), 0);") ||
            contains_s(generated, "__deaM4demo4mainN6answer = __deaM4demo4mainN4bumpF1ii(__deaM4demo3depN8get_baseF0i());"),
            "main init assignment mismatch");
        assert(contains_s(generated,
            "static void _dea_init_modules(void)\n{\n    __deaM4demo3depI4init();\n    __deaM4demo4mainI4init();\n}\n"),
            "global init chain order mismatch");
        assert(contains_s(generated,
            "_rt_init_args(argc, argv);\n    _dea_init_modules();\n    int dea_exit_code = (int) __deaM4demo4mainN4mainF0i();\n    return dea_exit_code;"),
            "main wrapper should call global init chain");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_basic_control_flow.
 */
func test_backend_generate_basic_control_flow() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func add(a: int, b: int) -> int {");
        sv_push(lines, "    return a + b;");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let sum = 0;");
        sv_push(lines, "    for (let i = 0; i < 3; i = i + 1) {");
        sv_push(lines, "        if (i < 2) {");
        sv_push(lines, "            sum = sum + add(i, 1);");
        sv_push(lines, "        }");
        sv_push(lines, "    }");
        sv_push(lines, "    while (sum > 0) {");
        sv_push(lines, "        return sum;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for control-flow fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "dea_int __deaM4demo4mainN3addF2iii(dea_int a, dea_int b);"),
            "function declaration mismatch");
        assert(contains_s(generated, "return (_rt_iadd(a, b));"), "checked integer add lowering mismatch");
        assert(contains_s(generated, "// for loop"), "for-loop wrapper comment mismatch");
        assert(contains_s(generated, "dea_int i = 0;\n        while (1)"),
            "for-loop lowering mismatch");
        assert(contains_s(generated, "if (i < 2)"), "if lowering mismatch");
        assert(!contains_s(generated, "if ((i < 2))"), "if lowering should avoid redundant condition parens");
        assert(contains_s(generated, "sum = (_rt_iadd(sum, __deaM4demo4mainN3addF2iii(i, 1)));"),
            "assignment and call lowering mismatch");
        assert(contains_s(generated, "while (1)"), "while lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_loop_exit_case_lowering.
 */
func test_backend_generate_loop_exit_case_lowering() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    for (let i = 0; i < 3; i = i + 1) {");
        sv_push(lines, "        case (i) {");
        sv_push(lines, "            0 => {");
        sv_push(lines, "                continue;");
        sv_push(lines, "            }");
        sv_push(lines, "            else {");
        sv_push(lines, "                break;");
        sv_push(lines, "            }");
        sv_push(lines, "        }");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for case/loop fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "switch (_scrutinee) {"), "case lowering should use switch for ints");
        assert(contains_s(generated, "goto __lcont_"), "continue should lower to loop label goto");
        assert(contains_s(generated, "goto __lbrk_"), "break should lower to loop label goto");

        analysis_result_free(result);
    }
}

/**
 * Tests that `case` statements on floats or narrower domains lower to if/else if.
 */
func test_backend_generate_case_if_else_lowering() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func check_float(f: float) -> int {");
        sv_push(lines, "    case (f) {");
        sv_push(lines, "        1.0f => { return 1; }");
        sv_push(lines, "        -2.5f => { return 2; }");
        sv_push(lines, "        _ => { return 3; }");
        sv_push(lines, "    }");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for case/float fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(!contains_s(generated, "switch"), "float case lowering should not use switch");
        assert(contains_s(generated, "if (_scrutinee == 1.0f)"), "expected float literal condition");
        if (!contains_s(generated, "if (_scrutinee == -2.5f)")) {
            printl_ss("Generated text:", generated);
        }
        assert(contains_s(generated, "if (_scrutinee == -2.5f)"), "expected negative float literal condition");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_match_and_with_cleanup_block.
 */
func test_backend_generate_match_and_with_cleanup_block() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(24) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "enum MaybeInt {");
        sv_push(lines, "    None;");
        sv_push(lines, "    Some(value: int);");
        sv_push(lines, "}");
        sv_push(lines, "func make() -> MaybeInt {");
        sv_push(lines, "    return Some(7);");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let total = 0;");
        sv_push(lines, "    with (let x = 1) {");
        sv_push(lines, "        total = x;");
        sv_push(lines, "    } cleanup {");
        sv_push(lines, "        total = x;");
        sv_push(lines, "    }");
        sv_push(lines, "    match (make()) {");
        sv_push(lines, "        Some(v) => {");
        sv_push(lines, "            return v;");
        sv_push(lines, "        }");
        sv_push(lines, "        None => {");
        sv_push(lines, "            return total;");
        sv_push(lines, "        }");
        sv_push(lines, "    }");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for match/with fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "struct __deaM4demo4mainE8MaybeInt _scrutinee = __deaM4demo4mainN4makeF0M4demo4mainE8MaybeInt();"),
            "match scrutinee temp mismatch");
        assert(contains_s(generated, "switch ((_scrutinee).tag) {"), "match lowering should switch on enum tag");
        assert(contains_s(generated, "dea_int v = (_scrutinee).data.Some.value;"), "pattern binding mismatch");
        assert(contains_s(generated, "total = x;\n        }\n        {\n            total = x;"),
            "with cleanup block should run after body in header scope");

        analysis_result_free(result);
    }
}

/**
 * Tests lowering for single-statement loop bodies and match arms.
 */
func test_backend_generate_single_statement_loop_and_match_bodies() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(18) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "enum MaybeInt {");
        sv_push(lines, "    None;");
        sv_push(lines, "    Some(value: int);");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let total = 0;");
        sv_push(lines, "    while (total < 2) total = total + 1;");
        sv_push(lines, "    for (let i = 0; i < 2; i = i + 1) total = total + i;");
        sv_push(lines, "    match (Some(total)) {");
        sv_push(lines, "        Some(v) => total = v + 1;");
        sv_push(lines, "        _ => total = 0;");
        sv_push(lines, "    }");
        sv_push(lines, "    return total;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for single-statement loop/match fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "while (1)"), "while lowering mismatch for single-statement body");
        assert(contains_s(generated, "total = (_rt_iadd(total, 1));"),
            "single-statement while body assignment lowering mismatch");
        assert(contains_s(generated, "// for loop"), "for-loop lowering mismatch for single-statement body");
        assert(contains_s(generated, "total = (_rt_iadd(total, i));"),
            "single-statement for body assignment lowering mismatch");
        assert(contains_s(generated, "switch ((_scrutinee).tag) {"), "match lowering mismatch for single-statement arm");
        assert(contains_s(generated, "dea_int v = (_scrutinee).data.Some.value;"),
            "pattern binding lowering mismatch for single-statement match arm");
        assert(contains_s(generated, "total = (_rt_iadd(v, 1));"),
            "single-statement match arm assignment lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_with_cleanup_block_header_try_predeclares_nullable_lets.
 */
func test_backend_generate_with_cleanup_block_header_try_predeclares_nullable_lets() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(23) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "enum Expr {");
        sv_push(lines, "    Num(value: int);");
        sv_push(lines, "}");
        sv_push(lines, "func parse(c: int) -> Expr*? {");
        sv_push(lines, "    return null;");
        sv_push(lines, "}");
        sv_push(lines, "func free_expr(e: Expr*?) {");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> Expr*? {");
        sv_push(lines, "    let result: Expr*? = null;");
        sv_push(lines, "    with (let left: Expr*? = parse(0)?,");
        sv_push(lines, "          let right: Expr*? = parse(1)?) {");
        sv_push(lines, "        return result;");
        sv_push(lines, "    } cleanup {");
        sv_push(lines, "        if (result == null) { free_expr(left); free_expr(right); }");
        sv_push(lines, "    }");
        sv_push(lines, "    return result;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for with-header try fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "struct __deaM4demo4mainE4Expr* left = NULL;"),
            "nullable cleanup-block header let should be predeclared to null");
        assert(contains_s(generated, "struct __deaM4demo4mainE4Expr* right = NULL;"),
            "second nullable cleanup-block header let should be predeclared to null");
        assert(contains_s(generated, "left = dea_try_"), "predeclared left should be assigned after the try succeeds");
        assert(contains_s(generated, "right = dea_try_"), "predeclared right should be assigned after the try succeeds");
        assert(!contains_s(generated, "struct __deaM4demo4mainE4Expr* left = dea_try_"),
            "left should not be redeclared after predeclaration");
        assert(!contains_s(generated, "struct __deaM4demo4mainE4Expr* right = dea_try_"),
            "right should not be redeclared after predeclaration");
        assert(contains_s(generated, "__deaM4demo4mainN9free_exprF1QPM4demo4mainE4Exprv(left);"),
            "cleanup block should still reference the predeclared left variable");
        assert(contains_s(generated, "__deaM4demo4mainN9free_exprF1QPM4demo4mainE4Exprv(right);"),
            "cleanup block should still reference the predeclared right variable");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_drop_statement.
 */
func test_backend_generate_drop_statement() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(8) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "extern func alloc() -> int*;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let p = alloc();");
        sv_push(lines, "    drop p;");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for drop fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "_rt_drop((void*)p);"), "drop call mismatch");
        assert(contains_s(generated, "p = NULL;"), "drop should null the pointer after release");

        analysis_result_free(result);
    }
}

/**
 * Tests generated drop precheck ordering before heap array cleanup.
 */
func test_backend_generate_drop_precheck_before_array_cleanup() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func zap(p: string[1]*) {");
        sv_push(lines, "    drop p;");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let p: string[1]* = new string[1]([\"hello\"]);");
        sv_push(lines, "    zap(p);");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for array drop precheck fixture");

        let generated = backend_generate(result, opts, cfg);
        let precheck_idx = find_s(generated, "_rt_drop_precheck((void*)p);");
        let cleanup_idx = find_s(generated, "for (dea_int");
        let drop_idx = find_s(generated, "_rt_drop((void*)p);");
        assert(precheck_idx >= 0, "drop precheck missing");
        assert(cleanup_idx >= 0, "array cleanup loop missing");
        assert(drop_idx >= 0, "drop call missing");
        assert(precheck_idx < cleanup_idx, "drop precheck should precede array cleanup");
        assert(cleanup_idx < drop_idx, "array cleanup should precede final drop");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_new_and_try_lowering.
 */
func test_backend_generate_new_and_try_lowering() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(24) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct Box {");
        sv_push(lines, "    value: int;");
        sv_push(lines, "}");
        sv_push(lines, "enum Result {");
        sv_push(lines, "    Ok(value: int);");
        sv_push(lines, "}");
        sv_push(lines, "func maybe(flag: bool) -> int? {");
        sv_push(lines, "    if (flag) { return 7; }");
        sv_push(lines, "    return null;");
        sv_push(lines, "}");
        sv_push(lines, "func maybe_box(flag: bool) -> Box*? {");
        sv_push(lines, "    if (flag) { return new Box(11); }");
        sv_push(lines, "    return null;");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int? {");
        sv_push(lines, "    let z = new Box();");
        sv_push(lines, "    let p = new Box(7);");
        sv_push(lines, "    let r = new Ok(9);");
        sv_push(lines, "    let q = maybe_box(true)?;");
        sv_push(lines, "    let x = maybe(true)?;");
        sv_push(lines, "    drop q;");
        sv_push(lines, "    drop z;");
        sv_push(lines, "    drop p;");
        sv_push(lines, "    drop r;");
        sv_push(lines, "    return x;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for new/try fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "_rt_alloc_obj((dea_int)sizeof(struct __deaM4demo4mainS3Box));"),
            "new expression should allocate heap storage");
        assert(contains_s(generated, "(struct __deaM4demo4mainS3Box){ 0 }"),
            "zero-arg struct new should lower to zero initialization");
        assert(contains_s(generated, "*dea_new_"), "new expression should initialize the allocated object");
        assert(contains_s(generated, "__deaM4demo4mainE6Result_Ok"),
            "enum variant new should initialize the variant tag");
        assert(contains_s(generated, "dea_opt_int dea_try_"), "try expression should materialize a temp");
        assert(contains_s(generated, "if (!((dea_try_"), "try expression should check has_value");
        assert(contains_s(generated, "if (dea_try_"), "niche-nullable try should keep a direct null check");
        assert(!contains_s(generated, "if ((dea_try_"), "niche-nullable try should avoid redundant condition parens");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_intrinsics_use_analyzed_target_types.
 */
func test_backend_generate_intrinsics_use_analyzed_target_types() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(24) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "enum Flag {");
        sv_push(lines, "    Off;");
        sv_push(lines, "    On;");
        sv_push(lines, "}");
        sv_push(lines, "enum Color {");
        sv_push(lines, "    Red;");
        sv_push(lines, "    RGB(r: int, g: int, b: int);");
        sv_push(lines, "}");
        sv_push(lines, "struct Pair {");
        sv_push(lines, "    left: int;");
        sv_push(lines, "    right: int;");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let p = Pair(1, sizeof(Pair));");
        sv_push(lines, "    let f = On;");
        sv_push(lines, "    let c = RGB(1, 2, 3);");
        sv_push(lines, "    if (is(c, RGB)) {");
        sv_push(lines, "        return p.right + ord(f);");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for sizeof/ord/is fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "((dea_int)sizeof(struct __deaM4demo4mainS4Pair))"),
            "sizeof should lower through the analyzed target type");
        assert(contains_s(generated, "((dea_int)((f).tag))"), "ord should lower to the enum tag");
        assert(contains_s(generated, "(((c).tag) == __deaM4demo4mainE5Color_RGB)"),
            "is should lower to a direct enum-tag comparison");

        analysis_result_free(result);
    }
}

/**
 * Tests out-of-order named argument lowering through source-order temporaries.
 */
func test_backend_generate_named_args_use_source_order_temporaries() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(32) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct Pair {");
        sv_push(lines, "    first: int;");
        sv_push(lines, "    second: int;");
        sv_push(lines, "}");
        sv_push(lines, "enum Choice {");
        sv_push(lines, "    Pick(left: int, right: int);");
        sv_push(lines, "}");
        sv_push(lines, "func value(v: int) -> int { return v; }");
        sv_push(lines, "func combine(a: int, b: int) -> int { return a - b; }");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let call = combine(b: value(3), a: value(10));");
        sv_push(lines, "    let pair = Pair(second: value(20), first: value(10));");
        sv_push(lines, "    let choice = Pick(right: value(2), left: value(1));");
        sv_push(lines, "    return call + pair.first + ord(choice);");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for named-argument lowering fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "dea_int dea_arg_"),
            "out-of-order named arguments should materialize source-order temporaries");
        assert(contains_s(generated, "__deaM4demo4mainN7combineF2iii(dea_arg_") &&
               contains_s(generated, ", dea_arg_"),
            "out-of-order named function call should use reordered temporaries");
        assert(contains_s(generated, ".first = dea_arg_") && contains_s(generated, ".second = dea_arg_"),
            "out-of-order named struct constructor should use reordered temporaries");
        assert(contains_s(generated, ".left = dea_arg_") && contains_s(generated, ".right = dea_arg_"),
            "out-of-order named enum constructor should use reordered temporaries");

        analysis_result_free(result);
    }
}

/**
 * Tests that user functions named like intrinsics are not lowered as `dea` intrinsics.
 */
func test_backend_generate_dea_intrinsics_respect_symbol_origin() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(32) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "enum Flag {");
        sv_push(lines, "    Off;");
        sv_push(lines, "    On;");
        sv_push(lines, "}");
        sv_push(lines, "func sizeof(x: int) -> int {");
        sv_push(lines, "    return x + 7;");
        sv_push(lines, "}");
        sv_push(lines, "func ord(x: int) -> int {");
        sv_push(lines, "    return x + 9;");
        sv_push(lines, "}");
        sv_push(lines, "func is(x: int, y: int) -> int {");
        sv_push(lines, "    return x + y + 11;");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let a = sizeof(4);");
        sv_push(lines, "    let b = ord(5);");
        sv_push(lines, "    let c = is(6, 7);");
        sv_push(lines, "    let d = dea::sizeof(Flag);");
        sv_push(lines, "    let e = dea::ord(On);");
        sv_push(lines, "    if (dea::is(On, On)) {");
        sv_push(lines, "        return a + b + c + d + e;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for dea shadowing fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "__deaM4demo4mainN6sizeofF1ii(4)"),
            "local sizeof should lower as a normal function call");
        assert(contains_s(generated, "__deaM4demo4mainN3ordF1ii(5)"),
            "local ord should lower as a normal function call");
        assert(contains_s(generated, "__deaM4demo4mainN2isF2iii(6, 7)"),
            "local is should lower as a normal function call");
        assert(contains_s(generated, "((dea_int)sizeof(struct __deaM4demo4mainE4Flag))"),
            "dea::sizeof should lower through intrinsic emission");
        assert(contains_s(generated, "((dea_int)(((struct __deaM4demo4mainE4Flag){ .tag = __deaM4demo4mainE4Flag_On }).tag))"),
            "dea::ord should lower through intrinsic emission");
        assert(contains_s(generated, "((((struct __deaM4demo4mainE4Flag){ .tag = __deaM4demo4mainE4Flag_On }).tag) == __deaM4demo4mainE4Flag_On)"),
            "dea::is should lower through intrinsic emission");

        analysis_result_free(result);
    }
}

/**
 * Tests `is` lowering for an imported enum-returning call and qualified variant name.
 */
func test_backend_generate_is_with_call_expr_and_qualified_variant() {
    with (let filenames = sv_create(2) => sv_free(filenames),
          let sources = sv_create(2) => sv_free(sources),
          let dep_lines = sv_create(16) => sv_free(dep_lines),
          let main_lines = sv_create(16) => sv_free(main_lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;

        sv_push(filenames, "config/types.l1");
        sv_push(dep_lines, "module config.types;");
        sv_push(dep_lines, "enum Key {");
        sv_push(dep_lines, "    String;");
        sv_push(dep_lines, "    Number;");
        sv_push(dep_lines, "}");
        sv_push(dep_lines, "func get_key() -> Key {");
        sv_push(dep_lines, "    return String;");
        sv_push(dep_lines, "}");
        sv_push(sources, bt_source(dep_lines));

        sv_push(filenames, "demo/main.l1");
        sv_push(main_lines, "module demo.main;");
        sv_push(main_lines, "import config.types;");
        sv_push(main_lines, "func main() -> int {");
        sv_push(main_lines, "    if (is(config.types::get_key(), config.types::String)) {");
        sv_push(main_lines, "        return 1;");
        sv_push(main_lines, "    }");
        sv_push(main_lines, "    return 0;");
        sv_push(main_lines, "}");
        sv_push(sources, bt_source(main_lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for qualified `is` fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "(((__deaM6config5typesN7get_keyF0M6config5typesE3Key()).tag) == __deaM6config5typesE3Key_String)"),
            "qualified `is` should lower call result and qualified variant to a direct tag comparison");

        analysis_result_free(result);
    }
}

/**
 * Tests test_backend_generate_string_copy_retains.
 */
func test_backend_generate_string_copy_retains() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(8) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let s = \"hi\";");
        sv_push(lines, "    let t = s;");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for ARC copy fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "rt_string_retain(dea_copy_"), "copying an owned string should retain");
        assert(contains_s(generated, "rt_string_release(t);"), "owned local cleanup should release copied string");
        assert(contains_s(generated, "rt_string_release(s);"), "owned local cleanup should release original string");

        analysis_result_free(result);
    }
}

/**
 * Tests casted-place string copies still retain before entering a new owner.
 */
func test_backend_generate_identity_cast_string_copy_retains() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(8) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func sink(x: string) {}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let first = \"hi\";");
        sv_push(lines, "    sink(first as string);");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for identity-cast ARC copy fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "__deaM4demo4mainN4sinkF1cv(first);"),
            "identity cast should pass the borrowed place directly to the callee");
        assert(!contains_s(generated, "dea_string dea_arc_"),
            "identity cast should not materialize a scope-owned ARC temp");
        assert(!contains_s(generated, "rt_string_release(dea_arc_"),
            "identity cast should not release a temporary ARC alias after the call");

        analysis_result_free(result);
    }
}

/**
 * Tests raw-pointer indexing lowering for reads, writes, and single evaluation of side-effectful operands.
 */
func test_backend_generate_pointer_indexing_contract() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(20) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "extern func next_index() -> int;");
        sv_push(lines, "extern func make_ptr() -> int*;");
        sv_push(lines, "unsafe func read(p: int*, i: int) -> int {");
        sv_push(lines, "    return p[i];");
        sv_push(lines, "}");
        sv_push(lines, "unsafe func write(p: int*, i: int, value: int) {");
        sv_push(lines, "    p[i] = value;");
        sv_push(lines, "}");
        sv_push(lines, "unsafe func write_effectful(value: int) {");
        sv_push(lines, "    make_ptr()[next_index()] = value;");
        sv_push(lines, "}");
        sv_push(lines, "unsafe func read_effectful() -> int {");
        sv_push(lines, "    return make_ptr()[next_index()];");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int { return 0; }");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for pointer-indexing fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "return p[i];"), "pointer-index read should lower to direct C indexing");
        assert(contains_s(generated, "p[i] = value;"), "pointer-index write should lower to direct C indexing");
        assert(contains_s(generated, "dea_int* dea_base_"),
            "effectful write base should be captured once");
        assert(contains_s(generated, "dea_int dea_idx_"),
            "effectful write index should be captured once");
        assert(contains_s(generated, " = value;"),
            "effectful write should still emit one indexed assignment after temp capture");
        assert(contains_s(generated, "dea_int* dea_base_"),
            "effectful read base should be captured once");
        assert(contains_s(generated, "return dea_base_"),
            "effectful read should return the indexed temporary base");

        analysis_result_free(result);
    }
}

/**
 * Tests fixed-size array wrappers, literals, constructors, and checked indexing.
 */
func test_backend_generate_fixed_arrays() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(24) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func get_index() -> int { return 1; }");
        sv_push(lines, "unsafe func read_row(p: int[3]*, i: int, j: int) -> int { return p[i][j]; }");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let a: int[3] = [1, 2];");
        sv_push(lines, "    let p: int[3] = ((([9, 8, 7])));");
        sv_push(lines, "    let z: int[3] = [];");
        sv_push(lines, "    let b = int[3](7);");
        sv_push(lines, "    let m: int[2][3] = [[1, 2, 3], [4, 5, 6]];");
        sv_push(lines, "    let pm: int[2][3] = ((([([9, 8, 7]), (([6, 5, 4]))])));");
        sv_push(lines, "    let filled = int[2][3]([8, 9]);");
        sv_push(lines, "    let filled_paren = int[2][3]((([6, 7])));");
        sv_push(lines, "    let heap = new int[2][3]([4, 5]);");
        sv_push(lines, "    let heap_paren = new int[2][3]((([2, 3])));");
        sv_push(lines, "    let opt_arr: int[3]? = a;");
        sv_push(lines, "    return a[get_index()] + p[0] + z[0] + b[2] + m[get_index()][get_index()] + pm[0][0] + filled[1][0] + filled_paren[1][0] + (*heap)[1][1] + (*heap_paren)[1][1] + sizeof(int[3]) + sizeof(a[0]);");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "fixed array fixture should analyze without errors");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "typedef struct __deaA3_i { dea_int data[3]; } __deaA3_i;"),
            "expected int[3] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA2_A3_i { dea_int data[2][3]; } __deaA2_A3_i;"),
            "expected flattened int[2][3] wrapper typedef");
        assert(contains_s(generated, "typedef struct { dea_bool has_value; __deaA3_i value; } dea_opt_a3_int;"),
            "expected nullable int[3] wrapper typedef");
        assert(find_s(generated, "} dea_opt_a3_int;") > find_s(generated, "} __deaA3_i;"),
            "expected int[3] wrapper before nullable int[3] wrapper");
        assert(contains_s(generated, "__deaA3_i a = ((__deaA3_i){.data = {1, 2}});"),
            "expected contextual array literal initializer");
        assert(contains_s(generated, "__deaA3_i p = ((__deaA3_i){.data = {9, 8, 7}});"),
            "expected parenthesized contextual array literal initializer");
        assert(contains_s(generated, "__deaA3_i z = ((__deaA3_i){.data = {0}});"),
            "expected C99-compatible empty array literal initializer");
        assert(contains_s(generated, "__deaA2_A3_i filled = dea_arr_"),
            "expected multidimensional literal-as-fill constructor");
        assert(contains_s(generated, "*dea_new_") && contains_s(generated, "dea_arr_"),
            "expected heap multidimensional literal-as-fill constructor");
        assert(contains_s(generated, "_rt_panic_oob("), "expected array bounds checks");
        assert(bt_count_substring(generated, "_rt_panic_oob(") >= 2,
            "expected nested indexing to emit checks at both dimensions");
        assert(contains_s(generated, "((dea_int)sizeof(__deaA3_i))"), "expected sizeof array wrapper");
        assert(contains_s(generated, "((dea_int)sizeof(dea_int))"), "expected sizeof indexed value type");
        assert(!contains_s(generated, "__deaA3_i dea_base_"),
            "nested row indexing should not materialize a flattened row as a wrapper");
        assert(contains_s(generated, "(p[i]).data[j]"),
            "pointer-to-array indexing should keep wrapper boundary before row access");

        analysis_result_free(result);
    }
}

/**
 * Tests slice descriptor lowering, array-to-slice conversion, and checked slice access.
 */
func test_backend_generate_slices() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(20) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func get_index() -> int { return 1; }");
        sv_push(lines, "func sum(s: int[]) -> int { return s[get_index()]; }");
        sv_push(lines, "func combine(prefix: int, s: int[]) -> int { return prefix + s[0]; }");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let a: int[3] = [1, 2, 3];");
        sv_push(lines, "    let whole: int[] = a;");
        sv_push(lines, "    let part = slice(a, 1, 2);");
        sv_push(lines, "    let n = len(whole);");
        sv_push(lines, "    let text = \"he\" + \"llo\";");
        sv_push(lines, "    let text_n = len(text);");
        sv_push(lines, "    let temp_text_n = len(\"x\" + \"yz\");");
        sv_push(lines, "    whole[0] = 9;");
        sv_push(lines, "    return sum(a) + combine(s: a, prefix: 10) + whole[get_index()] + part[0] + n + text_n + temp_text_n;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "slice fixture should analyze without errors");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "typedef struct __deaWi { dea_int len; dea_int *data; } __deaWi;"),
            "expected int[] slice descriptor typedef");
        assert(contains_s(generated, "((__deaWi){ .len = ((dea_int)3), .data = (a).data })"),
            "expected array-to-slice conversion using the array length and storage");
        assert(bt_count_substring(generated, "(__deaWi){ .len = ") >= 2,
            "expected slice descriptors for both the conversion and the slice() call");
        assert(contains_s(generated, "__deaWi dea_arg_"),
            "expected out-of-order array-to-slice call argument to materialize as a slice");
        assert(!contains_s(generated, "__deaA3_i dea_arg_"),
            "array-to-slice call argument must not materialize as the source array type");
        assert(contains_s(generated, "_rt_panic_oob("), "expected slice range/index bounds checks");
        assert(contains_s(generated, ") > ((((dea_int)3)) - (dea_slice_start_"),
            "expected three-argument slice check to compare count with remaining length");
        assert(!contains_s(generated, ") + (dea_slice_count_"),
            "three-argument slice range checks must not add start and count");
        assert(contains_s(generated, ").data["), "expected slice element access through the data pointer");
        assert(contains_s(generated, "(whole).len"), "expected len(slice) to read the descriptor length");
        assert(contains_s(generated, "rt_strlen(text)"), "expected len(string) to call rt_strlen");
        assert(contains_s(generated, "rt_strlen(dea_arc_"), "expected len(string rvalue) to use a cleanup temp");
        assert(contains_s(generated, "(s).len"), "expected slice index check against the descriptor length");

        analysis_result_free(result);
    }
}

/**
 * Tests fixed-size arrays with nested ARC structs and mixed pointer suffix wrappers.
 */
func test_backend_generate_fixed_array_arc_shapes() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(32) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct NestedStruct {");
        sv_push(lines, "    t1: string;");
        sv_push(lines, "    t2: string;");
        sv_push(lines, "}");
        sv_push(lines, "struct MyStruct1 {");
        sv_push(lines, "    s: string;");
        sv_push(lines, "    n: NestedStruct;");
        sv_push(lines, "}");
        sv_push(lines, "struct NestedStruct2 {");
        sv_push(lines, "    v1: string;");
        sv_push(lines, "    v2: NestedStruct[10][20];");
        sv_push(lines, "}");
        sv_push(lines, "func use_complex(p: string[10]*[20]*[30]) -> int { return sizeof(string[10]*[20]*[30]); }");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let n = NestedStruct(\"a\", \"b\");");
        sv_push(lines, "    let one = MyStruct1(\"c\", n);");
        sv_push(lines, "    let arr: MyStruct1[2] = [one];");
        sv_push(lines, "    let seed = NestedStruct(\"d\", \"e\");");
        sv_push(lines, "    let row = NestedStruct[20](seed);");
        sv_push(lines, "    let nested = NestedStruct2(\"f\", NestedStruct[10][20](row));");
        sv_push(lines, "    let arr2: NestedStruct2[1] = [nested];");
        sv_push(lines, "    return sizeof(MyStruct1[2]) + sizeof(NestedStruct2[1]) + sizeof(string[10]*[20]*[30]);");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "fixed array ARC shape fixture should analyze without errors");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "typedef struct __deaA2_M4demo4mainS9MyStruct1"),
            "expected MyStruct1[2] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA10_A20_M4demo4mainS12NestedStruct"),
            "expected flattened NestedStruct[10][20] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA1_M4demo4mainS13NestedStruct2"),
            "expected NestedStruct2[1] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA10_c { dea_string data[10]; } __deaA10_c;"),
            "expected string[10] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA20_PA10_c { __deaA10_c* data[20]; } __deaA20_PA10_c;"),
            "expected string[10]*[20] wrapper typedef");
        assert(contains_s(generated, "typedef struct __deaA30_PA20_PA10_c { __deaA20_PA10_c* data[30]; } __deaA30_PA20_PA10_c;"),
            "expected string[10]*[20]*[30] wrapper typedef");
        assert(contains_s(generated, "rt_string_release"), "expected managed string cleanup calls");
        assert(contains_s(generated, "for (dea_int dea_arr_i_"), "expected recursive array cleanup loops");

        analysis_result_free(result);
    }
}

/**
 * Tests string equality and inequality lowering through the runtime helper.
 */
func test_backend_generate_string_equality_ops() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(12) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let lhs = \"dea\";");
        sv_push(lines, "    let same = \"dea\";");
        sv_push(lines, "    let different = \"dea!\";");
        sv_push(lines, "    if (lhs == same && lhs != different) {");
        sv_push(lines, "        return 23;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string equality fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "rt_string_equals(lhs, same)"), "string equality should lower through runtime helper");
        assert(contains_s(generated, "(!rt_string_equals(lhs, different))"),
            "string inequality should lower through negated runtime helper");

        analysis_result_free(result);
    }
}

/**
 * Tests string relational lowering through the runtime helper.
 */
func test_backend_generate_string_relational_ops() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(14) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l1");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let lhs = \"dea\";");
        sv_push(lines, "    let same = \"dea\";");
        sv_push(lines, "    let longer = \"dea!\";");
        sv_push(lines, "    let higher = \"deb\";");
        sv_push(lines, "    if (lhs < longer && lhs <= same && higher > lhs && higher >= same) {");
        sv_push(lines, "        return 23;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string relational fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "(rt_string_compare(lhs, longer) < 0)"),
            "string less-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(lhs, same) <= 0)"),
            "string less-equal should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, lhs) > 0)"),
            "string greater-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, same) >= 0)"),
            "string greater-equal should lower through runtime helper");

        analysis_result_free(result);
    }
}


