/**
 * Tests string equality and inequality lowering through the runtime helper.
 */
func test_backend_generate_string_equality_ops() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(12) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let lhs = \"dea\";");
        vs_push(lines, "    let same = \"dea\";");
        vs_push(lines, "    let different = \"dea!\";");
        vs_push(lines, "    if (lhs == same && lhs != different) {");
        vs_push(lines, "        return 23;");
        vs_push(lines, "    }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string equality fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "rt_string_equals(lhs, same)"), "string equality should lower through runtime helper");
        assert(contains_s(generated, "(!rt_string_equals(lhs, different))"),
            "string inequality should lower through negated runtime helper");

        analysis_result_free(result);
    }
}

/**
 * Tests string relational lowering through the runtime helper.
 */
func test_backend_generate_string_relational_ops() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(14) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let lhs = \"dea\";");
        vs_push(lines, "    let same = \"dea\";");
        vs_push(lines, "    let longer = \"dea!\";");
        vs_push(lines, "    let higher = \"deb\";");
        vs_push(lines, "    if (lhs < longer && lhs <= same && higher > lhs && higher >= same) {");
        vs_push(lines, "        return 23;");
        vs_push(lines, "    }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string relational fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "(rt_string_compare(lhs, longer) < 0)"),
            "string less-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(lhs, same) <= 0)"),
            "string less-equal should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, lhs) > 0)"),
            "string greater-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, same) >= 0)"),
            "string greater-equal should lower through runtime helper");

        analysis_result_free(result);
    }
}

/**
 * Tests generation for implemented small integer builtin types and checked casts.
 */
func test_backend_generate_small_integer_builtins() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(14) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main(x: int, b: byte, u: ushort) -> int {");
        vs_push(lines, "    let a: tiny = 1;");
        vs_push(lines, "    let c: byte = 65;");
        vs_push(lines, "    let s: short = c;");
        vs_push(lines, "    let us: ushort = c;");
        vs_push(lines, "    let n: tiny = x as tiny;");
        vs_push(lines, "    let m: tiny = b as tiny;");
        vs_push(lines, "    let q: short = u as short;");
        vs_push(lines, "    return a + c + s + us + n + m + q;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for small integer fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "dea_tiny a = 1;"), "tiny let lowering mismatch");
        assert(contains_s(generated, "dea_byte c = 65;"), "byte contextual literal lowering mismatch");
        assert(contains_s(generated, "dea_short s = ((dea_short)(c));"), "byte-to-short widening lowering mismatch");
        assert(contains_s(generated, "dea_ushort us = ((dea_ushort)(c));"), "byte-to-ushort widening lowering mismatch");
        assert(contains_s(generated, "dea_tiny n = (_rt_narrow_dea_tiny(x));"), "int-to-tiny narrowing mismatch");
        assert(contains_s(generated, "dea_tiny m = (_rt_narrow_dea_tiny(b));"), "byte-to-tiny range check mismatch");
        assert(contains_s(generated, "dea_short q = (_rt_narrow_dea_short(u));"), "ushort-to-short range check mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests generation for large integer builtin types, bigint literals, and checked casts.
 */
func test_backend_generate_large_integer_builtins() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(20) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "let max_uint: uint = 0xffffffff;");
        vs_push(lines, "let min_long_hex: long = -0x8000000000000000;");
        vs_push(lines, "let min_long_dec: long = -9223372036854775808;");
        vs_push(lines, "let max_ulong: ulong = 0xffffffffffffffff;");
        vs_push(lines, "let bin_ulong: ulong = 0b1111111111111111111111111111111111111111111111111111111111111111;");
        vs_push(lines, "func zero_ulong_opt_cast_nullable() -> ulong? { return 0 as ulong?; }");
        vs_push(lines, "func zero_ulong_opt_cast_inner() -> ulong? { return 0 as ulong; }");
        vs_push(lines, "func big_long_opt_cast_nullable() -> long? { return 9999999999 as long?; }");
        vs_push(lines, "func direct_long_opt_return() -> long? { return 42; }");
        vs_push(lines, "func direct_ulong_opt_return() -> ulong? { return 42; }");
        vs_push(lines, "func direct_big_long_opt_return() -> long? { return 9999999999; }");
        vs_push(lines, "func main(x: int, u: uint, l: long, ul: ulong, b: byte, us: ushort) -> long {");
        vs_push(lines, "    let a: uint = b;");
        vs_push(lines, "    let c: uint = us;");
        vs_push(lines, "    let d: long = x;");
        vs_push(lines, "    let e: long = u;");
        vs_push(lines, "    let f: ulong = u;");
        vs_push(lines, "    let g: uint = x as uint;");
        vs_push(lines, "    let h: short = ul as short;");
        vs_push(lines, "    let i: long = 2147483648;");
        vs_push(lines, "    let k: long? = 0 as long?;");
        vs_push(lines, "    let j: long = l + e;");
        vs_push(lines, "    if (u == c) { return j + i; }");
        vs_push(lines, "    return j;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for large integer fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "dea_uint __deaM4demo4mainS8max_uint = 0xffffffffU;"),
            "uint top-level hex bigint literal mismatch");
        assert(contains_s(generated, "dea_long __deaM4demo4mainS12min_long_hex = INT64_MIN;"),
            "long top-level negative hex bigint literal mismatch");
        assert(contains_s(generated, "dea_long __deaM4demo4mainS12min_long_dec = INT64_MIN;"),
            "long top-level negative decimal bigint literal mismatch");
        assert(contains_s(generated, "dea_ulong __deaM4demo4mainS9max_ulong = 0xffffffffffffffffULL;"),
            "ulong top-level hex bigint literal mismatch");
        assert(contains_s(generated, "dea_ulong __deaM4demo4mainS9bin_ulong = 0xffffffffffffffffULL;"),
            "binary ulong bigint literal mismatch");
        assert(contains_s(generated, "dea_uint a = ((dea_uint)(b));"), "byte-to-uint widening mismatch");
        assert(contains_s(generated, "dea_uint c = ((dea_uint)(us));"), "ushort-to-uint widening mismatch");
        assert(contains_s(generated, "dea_long d = ((dea_long)(x));"), "int-to-long widening mismatch");
        assert(contains_s(generated, "dea_long e = ((dea_long)(u));"), "uint-to-long widening mismatch");
        assert(contains_s(generated, "dea_ulong f = ((dea_ulong)(u));"), "uint-to-ulong widening mismatch");
        assert(contains_s(generated, "dea_uint g = (_rt_narrow_dea_uint(x));"), "int-to-uint checked cast mismatch");
        assert(contains_s(generated, "dea_short h = (_rt_cast_dea_short_from_unsigned((dea_ulong)(ul)));"),
            "ulong-to-short checked cast mismatch");
        assert(contains_s(generated, "dea_long i = 2147483648LL;"), "long local bigint literal mismatch");
        assert(contains_s(generated, "dea_opt_long k = ((dea_opt_long){.has_value = 1, .value = ((dea_long)(0))});"),
            "int-to-nullable-long cast lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_ulong __deaM4demo4mainS28zero_ulong_opt_cast_nullable(void)\n{\n    return ((dea_opt_ulong){.has_value = 1, .value = (_rt_narrow_dea_ulong(0))});"),
            "int-to-nullable-ulong cast return lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_ulong __deaM4demo4mainS25zero_ulong_opt_cast_inner(void)\n{\n    return ((dea_opt_ulong){.has_value = 1, .value = (_rt_narrow_dea_ulong(0))});"),
            "inner-ulong-to-nullable-ulong return lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_long __deaM4demo4mainS26big_long_opt_cast_nullable(void)\n{\n    return ((dea_opt_long){.has_value = 1, .value = 9999999999LL});"),
            "bigint-to-nullable-long cast return lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_long __deaM4demo4mainS22direct_long_opt_return(void)\n{\n    return ((dea_opt_long){.has_value = 1, .value = ((dea_long)(42))});"),
            "direct int-literal-to-nullable-long return lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_ulong __deaM4demo4mainS23direct_ulong_opt_return(void)\n{\n    return ((dea_opt_ulong){.has_value = 1, .value = ((dea_ulong)(42))});"),
            "direct int-literal-to-nullable-ulong return lowering mismatch");
        assert(contains_s(generated,
            "dea_opt_long __deaM4demo4mainS26direct_big_long_opt_return(void)\n{\n    return ((dea_opt_long){.has_value = 1, .value = 9999999999LL});"),
            "direct bigint-to-nullable-long return lowering mismatch");
        assert(contains_s(generated, "dea_long j = (_rt_ladd(l, e));"), "long addition helper mismatch");
        assert(contains_s(generated, "return (_rt_ladd(j, i));"), "long return addition helper mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests generation for builtin `float` and `double` lowering.
 */
func test_backend_generate_float_double_builtins() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(12) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func widen(x: float) -> double {");
        vs_push(lines, "    return x;");
        vs_push(lines, "}");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let seed: float = 1.0f;");
        vs_push(lines, "    let total: double = widen(seed) + 1.5 + 1.5;");
        vs_push(lines, "    if (total == 4.0 && total >= 4.0) { return 17; }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for float/double fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "#include <float.h>"), "float fixture should emit float contract guards");
        assert(contains_s(generated, "#if FLT_RADIX != 2"), "float fixture should emit radix guard");
        assert(contains_s(generated, "__FAST_MATH__"), "float fixture should emit fast-math guard");
        assert(contains_s(generated, "double __deaM4demo4mainS5widen(float x);"), "float/double function declaration mismatch");
        assert(contains_s(generated, "float seed = 1.0f;"), "float literal local lowering mismatch");
        assert(contains_s(generated, "double total = ((__deaM4demo4mainS5widen(seed) + 1.5) + 1.5);"),
            "double arithmetic lowering mismatch");
        assert(contains_s(generated, "if (total == 4.0)"), "double equality comparison lowering mismatch");
        assert(!contains_s(generated, "if ((total == 4.0))"), "double equality condition should avoid redundant parens");
        assert(contains_s(generated, "if (total >= 4.0)"), "double ordering comparison lowering mismatch");
        assert(!contains_s(generated, "if ((total >= 4.0))"), "double ordering condition should avoid redundant parens");

        analysis_result_free(result);
    }
}

/**
 * Tests condition headers omit only redundant outer parentheses.
 */
func test_backend_generate_condition_header_parens() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(16) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;

        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main(x: int, y: int, flags: int, mask: int) -> int {");
        vs_push(lines, "    if (x == y) {");
        vs_push(lines, "        return 1;");
        vs_push(lines, "    }");
        vs_push(lines, "    while (x < y) {");
        vs_push(lines, "        x = x + 1;");
        vs_push(lines, "    }");
        vs_push(lines, "    if ((flags & mask) != 0) {");
        vs_push(lines, "        return 2;");
        vs_push(lines, "    }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for condition-header fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "if (x == y)"), "equality condition lowering mismatch");
        assert(!contains_s(generated, "if ((x == y))"), "equality condition should avoid redundant parens");
        assert(contains_s(generated, "while (x < y)"), "while condition lowering mismatch");
        assert(!contains_s(generated, "while ((x < y))"), "while condition should avoid redundant parens");
        assert(contains_s(generated, "if ((flags & mask) != 0)"),
            "nested precedence parentheses should be preserved");

        analysis_result_free(result);
    }
}

/**
 * Tests direct C lowering for floating-point arithmetic and explicit numeric casts.
 */
func test_backend_generate_float_double_ops() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(16) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let lhs: float = 8.0f;");
        vs_push(lines, "    let rhs: float = 2.0f;");
        vs_push(lines, "    let diff: float = lhs - rhs;");
        vs_push(lines, "    let prod: float = rhs * 4.0f;");
        vs_push(lines, "    let quot: double = 9.0 / 2.0;");
        vs_push(lines, "    let narrowed: float = quot as float;");
        vs_push(lines, "    let widened: double = lhs as double;");
        vs_push(lines, "    if (diff == 6.0f && prod == 8.0f && quot > 4.0 && narrowed > 4.0f && widened == 8.0) { return 21; }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for floating operator fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "float diff = (lhs - rhs);"), "float subtraction should lower to direct C subtraction");
        assert(contains_s(generated, "float prod = (rhs * 4.0f);"), "float multiplication should lower to direct C multiplication");
        assert(contains_s(generated, "double quot = (9.0 / 2.0);"), "double division should lower to direct C division");
        assert(contains_s(generated, "float narrowed = ((float)(quot));"), "double-to-float cast lowering mismatch");
        assert(contains_s(generated, "double widened = ((double)(lhs));"), "float-to-double cast lowering mismatch");
        assert(!contains_s(generated, "_rt_isub("), "float subtraction should not use checked integer subtraction");
        assert(!contains_s(generated, "_rt_imul("), "float multiplication should not use checked integer multiplication");
        assert(!contains_s(generated, "_rt_idiv("), "double division should not use checked integer division");

        analysis_result_free(result);
    }
}

/**
 * Tests that floating zero-division stays on the plain C operator path.
 */
func test_backend_generate_float_zero_division_plain_c() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(12) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let dz: double = 1.0 / 0.0;");
        vs_push(lines, "    let fz: float = 1.0f / 0.0f;");
        vs_push(lines, "    if (dz > 0.0 && fz > 0.0f) { return 22; }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for floating zero-division fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "double dz = (1.0 / 0.0);"), "double zero-division should lower to direct C division");
        assert(contains_s(generated, "float fz = (1.0f / 0.0f);"), "float zero-division should lower to direct C division");
        assert(!contains_s(generated, "_rt_idiv("), "floating zero-division should not use checked integer division");

        analysis_result_free(result);
    }
}

/**
 * Tests pointer identity backend lowering.
 */
func test_backend_pointer_identity() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(16) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;

        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "struct T { val: int; }");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let p1: T* = new T(1);");
        vs_push(lines, "    let p2: T* = new T(2);");
        vs_push(lines, "    let alias: T* = p1;");
        vs_push(lines, "    if (p1 == p1) { }");
        vs_push(lines, "    if (p1 != p2) { }");
        vs_push(lines, "    if (p1 == p2) { }");
        vs_push(lines, "    if (alias == p1) { }");
        vs_push(lines, "    if (alias != p1) { }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "pointer identity test should analyze without errors");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "(p1 == p1)"), "pointer self-identity equality lowering mismatch");
        assert(contains_s(generated, "(p1 != p2)"), "pointer non-identity inequality lowering mismatch");
        assert(contains_s(generated, "(p1 == p2)"), "pointer non-identity equality lowering mismatch");
        assert(contains_s(generated, "(alias == p1)"), "pointer alias equality lowering mismatch");
        assert(contains_s(generated, "(alias != p1)"), "pointer alias inequality lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Tests nullable identity backend lowering.
 */
func test_backend_nullable_identity() {
    with (let filenames = vs_create(1) => vs_free(filenames),
          let sources = vs_create(1) => vs_free(sources),
          let lines = vs_create(32) => vs_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;

        vs_push(filenames, "demo/main.l1");
        vs_push(lines, "module demo.main;");
        vs_push(lines, "struct T { val: int; }");
        vs_push(lines, "func main() -> int {");
        vs_push(lines, "    let a: int? = 5;");
        vs_push(lines, "    let b: int? = null;");
        vs_push(lines, "    if (a == a) { }");
        vs_push(lines, "    if (a != b) { }");
        vs_push(lines, "    let s1: string? = \"hi\";");
        vs_push(lines, "    let s2: string? = null;");
        vs_push(lines, "    if (s1 == s1) { }");
        vs_push(lines, "    if (s1 != s2) { }");
        vs_push(lines, "    let p1: T*? = new T(1);");
        vs_push(lines, "    let p2: T*? = null;");
        vs_push(lines, "    if (p1 == p1) { }");
        vs_push(lines, "    if (p1 != p2) { }");
        vs_push(lines, "    return 0;");
        vs_push(lines, "}");
        vs_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "nullable identity test should analyze without errors");

        let generated = backend_generate(result, opts, cfg);

        // int? lowering
        assert(contains_s(generated, "((!a.has_value && !a.has_value) || (a.has_value && a.has_value && (a.value == a.value)))"), "int? equality lowering mismatch");
        assert(contains_s(generated, "((a.has_value != b.has_value) || (a.has_value && b.has_value && (a.value != b.value)))"), "int? inequality lowering mismatch");

        // string? lowering
        assert(contains_s(generated, "((!s1.has_value && !s1.has_value) || (s1.has_value && s1.has_value && rt_string_equals(s1.value, s1.value)))"), "string? equality lowering mismatch");
        assert(contains_s(generated, "((s1.has_value != s2.has_value) || (s1.has_value && s2.has_value && (!rt_string_equals(s1.value, s2.value))))"), "string? inequality lowering mismatch");

        // T*? lowering (niche, raw C)
        assert(contains_s(generated, "(p1 == p1)"), "T*? equality lowering mismatch");
        assert(contains_s(generated, "(p1 != p2)"), "T*? inequality lowering mismatch");

        analysis_result_free(result);
    }
}

/**
 * Main entry point for the module.
 */
func main() {
    test_codegen_options_defaults();
    test_scope_context_tracks_declared_and_owned_variables();
    test_scope_context_inline_cleanup_tracking();
    test_backend_scope_helpers_manage_cleanup_state();
    test_analysis_expr_lookup_helpers();
    test_analysis_has_arc_data_for_struct_and_nullable_pointer();
    test_backend_generate_types_and_top_level_lets();
    test_backend_generate_top_level_consts();
    test_backend_generate_basic_control_flow();
    test_backend_generate_loop_exit_case_lowering();
    test_backend_generate_match_and_with_cleanup_block();
    test_backend_generate_single_statement_loop_and_match_bodies();
    test_backend_generate_with_cleanup_block_header_try_predeclares_nullable_lets();
    test_backend_generate_drop_statement();
    test_backend_generate_new_and_try_lowering();
    test_backend_generate_intrinsics_use_analyzed_target_types();
    test_backend_generate_dea_intrinsics_respect_symbol_origin();
    test_backend_generate_is_with_call_expr_and_qualified_variant();
    test_backend_generate_string_copy_retains();
    test_backend_generate_string_equality_ops();
    test_backend_generate_small_integer_builtins();
    test_backend_generate_large_integer_builtins();
    test_backend_generate_float_double_builtins();
    test_backend_generate_float_double_ops();
    test_backend_generate_float_zero_division_plain_c();
    test_backend_pointer_identity();
    test_backend_nullable_identity();
    printl_s("backend_test: all tests passed");
}
