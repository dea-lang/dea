module object_reader_test;

import std.assert;
import std.fs;
import std.io;
import std.string;
import std.system;
import std.text;
import std.vector;

import build_driver;
import object_metadata;
import object_reader;
import object_reader_types;

struct ObjectReaderTestSymbol {
    name: string;
    value: int;
    size: int;
    auxiliary_count: int;
}

struct ObjectReaderTestFixture {
    data: string;
    symbols: VectorBase*; /* ObjectReaderTestSymbol* */
}

func ortest_ptr_vec_create(capacity: int) -> VectorBase* {
    return vec_create(sizeof(void*), capacity);
}

func ortest_ptr_vec_push(values: VectorBase*, value: void*) {
    vec_push_ptr(values, value);
}

func ortest_ptr_vec_get(values: VectorBase*, index: int) -> void* {
    return *(vec_get(values, index) as void**);
}

func ortest_int_vec_create(capacity: int) -> VectorBase* {
    return vec_create(sizeof(int), capacity);
}

func ortest_int_vec_get(values: VectorBase*, index: int) -> int {
    return *(vec_get(values, index) as int*);
}

func ortest_fixture_create(data: string) -> ObjectReaderTestFixture* {
    return new ObjectReaderTestFixture(data, ortest_ptr_vec_create(8));
}

func ortest_fixture_add_symbol_with_aux(
    fixture: ObjectReaderTestFixture*,
    name: string,
    value: int,
    size: int,
    auxiliary_count: int
) {
    ortest_ptr_vec_push(
        fixture.symbols,
        new ObjectReaderTestSymbol(name, value, size, auxiliary_count) as void*
    );
}

func ortest_fixture_add_symbol(
    fixture: ObjectReaderTestFixture*,
    name: string,
    value: int,
    size: int
) {
    ortest_fixture_add_symbol_with_aux(fixture, name, value, size, 0);
}

func ortest_fixture_symbol(
    fixture: ObjectReaderTestFixture*,
    index: int
) -> ObjectReaderTestSymbol* {
    return ortest_ptr_vec_get(
        fixture.symbols, index) as ObjectReaderTestSymbol*;
}

func ortest_fixture_free(fixture: ObjectReaderTestFixture*) {
    for (let i = 0; i < vec_size(fixture.symbols); i = i + 1) {
        let symbol = ortest_fixture_symbol(fixture, i);
        drop symbol;
    }
    vec_free(fixture.symbols);
    drop fixture;
}

func ortest_zero_buffer(size: int) -> CharBuffer* {
    let result = cb_create();
    cb_reserve(result, size);
    for (let i = 0; i < size; i = i + 1) {
        cb_append(result, 0 as byte);
    }
    return result;
}

func ortest_put_u8(out: CharBuffer*, offset: int, value: int) {
    let slot = vec_get(out.chars, offset) as byte*;
    *slot = value as byte;
}

func ortest_put_u16(out: CharBuffer*, offset: int, value: int, little: bool) {
    if (little) {
        ortest_put_u8(out, offset, value % 256);
        ortest_put_u8(out, offset + 1, (value / 256) % 256);
    } else {
        ortest_put_u8(out, offset, (value / 256) % 256);
        ortest_put_u8(out, offset + 1, value % 256);
    }
}

func ortest_put_u32(out: CharBuffer*, offset: int, value: int, little: bool) {
    if (little) {
        for (let i = 0; i < 4; i = i + 1) {
            ortest_put_u8(out, offset + i, (value / ortest_pow256(i)) % 256);
        }
    } else {
        for (let i2 = 0; i2 < 4; i2 = i2 + 1) {
            ortest_put_u8(out, offset + i2, (value / ortest_pow256(3 - i2)) % 256);
        }
    }
}

func ortest_put_u64(out: CharBuffer*, offset: int, value: int, little: bool) {
    if (little) {
        ortest_put_u32(out, offset, value, true);
        ortest_put_u32(out, offset + 4, 0, true);
    } else {
        ortest_put_u32(out, offset, 0, false);
        ortest_put_u32(out, offset + 4, value, false);
    }
}

func ortest_pow256(exponent: int) -> int {
    let result = 1;
    for (let i = 0; i < exponent; i = i + 1) {
        result = result * 256;
    }
    return result;
}

func ortest_put_bytes(out: CharBuffer*, offset: int, bytes: string) {
    for (let i = 0; i < len_s(bytes); i = i + 1) {
        ortest_put_u8(out, offset + i, char_at_s(bytes, i) as int);
    }
}

func ortest_replace_byte(bytes: string, offset: int, value: int) -> string {
    with (let out = cb_create() => cb_free(out)) {
        cb_append_s(out, bytes);
        ortest_put_u8(out, offset, value);
        return cb_to_string(out);
    }
}

func ortest_build_elf(
    fixture: ObjectReaderTestFixture*,
    is_64: bool,
    little: bool
) -> string {
    let header_size = 52;
    let section_size = 40;
    let symbol_size = 16;
    if (is_64) {
        header_size = 64;
        section_size = 64;
        symbol_size = 24;
    }

    let strings = cb_create();
    cb_append(strings, 0 as byte);
    let name_offsets = ortest_int_vec_create(vec_size(fixture.symbols));
    for (let i = 0; i < vec_size(fixture.symbols); i = i + 1) {
        vec_push_int(name_offsets, cb_size(strings));
        cb_append_s(strings, ortest_fixture_symbol(fixture, i).name);
        cb_append(strings, 0 as byte);
    }
    let string_bytes = cb_to_string(strings);
    cb_free(strings);

    let section_table = header_size;
    let data_offset = section_table + 4 * section_size;
    let symbol_offset = data_offset + len_s(fixture.data);
    let symbol_count = vec_size(fixture.symbols) + 1;
    let string_offset = symbol_offset + symbol_count * symbol_size;
    let total_size = string_offset + len_s(string_bytes);
    let out = ortest_zero_buffer(total_size);

    ortest_put_u8(out, 0, 127);
    ortest_put_bytes(out, 1, "ELF");
    let class_byte = 1;
    let endian_byte = 2;
    if (is_64) {
        class_byte = 2;
    }
    if (little) {
        endian_byte = 1;
    }
    ortest_put_u8(out, 4, class_byte);
    ortest_put_u8(out, 5, endian_byte);
    ortest_put_u8(out, 6, 1);
    ortest_put_u16(out, 16, 1, little);
    let machine = 3;
    if (is_64) {
        machine = 62;
    }
    if (!little) {
        machine = 20;
        if (is_64) {
            machine = 21;
        }
    }
    ortest_put_u16(out, 18, machine, little);
    ortest_put_u32(out, 20, 1, little);
    if (is_64) {
        ortest_put_u64(out, 40, section_table, little);
        ortest_put_u16(out, 52, header_size, little);
        ortest_put_u16(out, 58, section_size, little);
        ortest_put_u16(out, 60, 4, little);
        ortest_put_u16(out, 62, 0, little);
    } else {
        ortest_put_u32(out, 32, section_table, little);
        ortest_put_u16(out, 40, header_size, little);
        ortest_put_u16(out, 46, section_size, little);
        ortest_put_u16(out, 48, 4, little);
        ortest_put_u16(out, 50, 0, little);
    }

    let data_section = section_table + section_size;
    let symbol_section = section_table + 2 * section_size;
    let string_section = section_table + 3 * section_size;
    ortest_put_u32(out, data_section + 4, 1, little);
    ortest_put_u32(out, symbol_section + 4, 2, little);
    ortest_put_u32(out, string_section + 4, 3, little);
    if (is_64) {
        ortest_put_u64(out, data_section + 24, data_offset, little);
        ortest_put_u64(out, data_section + 32, len_s(fixture.data), little);
        ortest_put_u64(out, data_section + 48, 1, little);
        ortest_put_u64(out, symbol_section + 24, symbol_offset, little);
        ortest_put_u64(out, symbol_section + 32, symbol_count * symbol_size, little);
        ortest_put_u32(out, symbol_section + 40, 3, little);
        ortest_put_u32(out, symbol_section + 44, 1, little);
        ortest_put_u64(out, symbol_section + 48, 8, little);
        ortest_put_u64(out, symbol_section + 56, symbol_size, little);
        ortest_put_u64(out, string_section + 24, string_offset, little);
        ortest_put_u64(out, string_section + 32, len_s(string_bytes), little);
        ortest_put_u64(out, string_section + 48, 1, little);
    } else {
        ortest_put_u32(out, data_section + 16, data_offset, little);
        ortest_put_u32(out, data_section + 20, len_s(fixture.data), little);
        ortest_put_u32(out, data_section + 32, 1, little);
        ortest_put_u32(out, symbol_section + 16, symbol_offset, little);
        ortest_put_u32(out, symbol_section + 20, symbol_count * symbol_size, little);
        ortest_put_u32(out, symbol_section + 24, 3, little);
        ortest_put_u32(out, symbol_section + 28, 1, little);
        ortest_put_u32(out, symbol_section + 32, 4, little);
        ortest_put_u32(out, symbol_section + 36, symbol_size, little);
        ortest_put_u32(out, string_section + 16, string_offset, little);
        ortest_put_u32(out, string_section + 20, len_s(string_bytes), little);
        ortest_put_u32(out, string_section + 32, 1, little);
    }

    ortest_put_bytes(out, data_offset, fixture.data);
    for (let i2 = 0; i2 < vec_size(fixture.symbols); i2 = i2 + 1) {
        let symbol = ortest_fixture_symbol(fixture, i2);
        let base = symbol_offset + (i2 + 1) * symbol_size;
        ortest_put_u32(out, base, ortest_int_vec_get(name_offsets, i2), little);
        if (is_64) {
            ortest_put_u8(out, base + 4, 16);
            ortest_put_u16(out, base + 6, 1, little);
            ortest_put_u64(out, base + 8, symbol.value, little);
            ortest_put_u64(out, base + 16, symbol.size, little);
        } else {
            ortest_put_u32(out, base + 4, symbol.value, little);
            ortest_put_u32(out, base + 8, symbol.size, little);
            ortest_put_u8(out, base + 12, 16);
            ortest_put_u16(out, base + 14, 1, little);
        }
    }
    ortest_put_bytes(out, string_offset, string_bytes);
    vec_free(name_offsets);
    let result = cb_to_string(out);
    cb_free(out);
    return result;
}

func ortest_build_elf_darwin_tcc(
    fixture: ObjectReaderTestFixture*,
    is_64: bool,
    little: bool
) -> string {
    let decorated = ortest_fixture_create(fixture.data);
    for (let i = 0; i < vec_size(fixture.symbols); i = i + 1) {
        let symbol = ortest_fixture_symbol(fixture, i);
        let name = symbol.name;
        if (name == "main" || starts_with_s(name, "__dea")) {
            name = "_" + name;
        }
        ortest_fixture_add_symbol_with_aux(
            decorated, name, symbol.value, symbol.size, symbol.auxiliary_count);
    }
    let result = ortest_build_elf(decorated, is_64, little);
    ortest_fixture_free(decorated);
    return result;
}

func ortest_build_macho_unknown_command(
    is_64: bool,
    little: bool,
    command_size: int
) -> string {
    let header_size = 28;
    if (is_64) {
        header_size = 32;
    }
    let out = ortest_zero_buffer(header_size + command_size);
    if (is_64) {
        if (little) {
            ortest_put_u8(out, 0, 207);
            ortest_put_u8(out, 1, 250);
            ortest_put_u8(out, 2, 237);
            ortest_put_u8(out, 3, 254);
        } else {
            ortest_put_u8(out, 0, 254);
            ortest_put_u8(out, 1, 237);
            ortest_put_u8(out, 2, 250);
            ortest_put_u8(out, 3, 207);
        }
    } else {
        if (little) {
            ortest_put_u8(out, 0, 206);
            ortest_put_u8(out, 1, 250);
            ortest_put_u8(out, 2, 237);
            ortest_put_u8(out, 3, 254);
        } else {
            ortest_put_u8(out, 0, 254);
            ortest_put_u8(out, 1, 237);
            ortest_put_u8(out, 2, 250);
            ortest_put_u8(out, 3, 206);
        }
    }
    let cpu_type = 7;
    if (is_64) {
        cpu_type = 16777223;
    }
    ortest_put_u32(out, 4, cpu_type, little);
    ortest_put_u32(out, 8, 3, little);
    ortest_put_u32(out, 12, 1, little);
    ortest_put_u32(out, 16, 1, little);
    ortest_put_u32(out, 20, command_size, little);
    ortest_put_u32(out, header_size, 42, little);
    ortest_put_u32(out, header_size + 4, command_size, little);
    let result = cb_to_string(out);
    cb_free(out);
    return result;
}

func ortest_build_macho(
    fixture: ObjectReaderTestFixture*,
    is_64: bool,
    little: bool
) -> string {
    let header_size = 28;
    let segment_header_size = 56;
    let section_size = 68;
    let symbol_size = 12;
    let segment_command = 1;
    if (is_64) {
        header_size = 32;
        segment_header_size = 72;
        section_size = 80;
        symbol_size = 16;
        segment_command = 25;
    }
    let segment_size = segment_header_size + section_size;
    let command_bytes = segment_size + 24;

    let strings = cb_create();
    cb_append(strings, 0 as byte);
    let name_offsets = ortest_int_vec_create(vec_size(fixture.symbols));
    for (let i = 0; i < vec_size(fixture.symbols); i = i + 1) {
        vec_push_int(name_offsets, cb_size(strings));
        cb_append_s(strings, "_");
        cb_append_s(strings, ortest_fixture_symbol(fixture, i).name);
        cb_append(strings, 0 as byte);
    }
    let string_bytes = cb_to_string(strings);
    cb_free(strings);

    let data_offset = header_size + command_bytes;
    let symbol_offset = data_offset + len_s(fixture.data);
    let string_offset = symbol_offset + vec_size(fixture.symbols) * symbol_size;
    let total_size = string_offset + len_s(string_bytes);
    let out = ortest_zero_buffer(total_size);

    if (is_64) {
        if (little) {
            ortest_put_u8(out, 0, 207);
            ortest_put_u8(out, 1, 250);
            ortest_put_u8(out, 2, 237);
            ortest_put_u8(out, 3, 254);
        } else {
            ortest_put_u8(out, 0, 254);
            ortest_put_u8(out, 1, 237);
            ortest_put_u8(out, 2, 250);
            ortest_put_u8(out, 3, 207);
        }
    } else {
        if (little) {
            ortest_put_u8(out, 0, 206);
            ortest_put_u8(out, 1, 250);
            ortest_put_u8(out, 2, 237);
            ortest_put_u8(out, 3, 254);
        } else {
            ortest_put_u8(out, 0, 254);
            ortest_put_u8(out, 1, 237);
            ortest_put_u8(out, 2, 250);
            ortest_put_u8(out, 3, 206);
        }
    }
    let cpu_type = 7;
    if (is_64) {
        cpu_type = 16777223;
    }
    ortest_put_u32(out, 4, cpu_type, little);
    ortest_put_u32(out, 8, 3, little);
    ortest_put_u32(out, 12, 1, little);
    ortest_put_u32(out, 16, 2, little);
    ortest_put_u32(out, 20, command_bytes, little);

    let segment_base = header_size;
    ortest_put_u32(out, segment_base, segment_command, little);
    ortest_put_u32(out, segment_base + 4, segment_size, little);
    if (is_64) {
        ortest_put_u32(out, segment_base + 64, 1, little);
    } else {
        ortest_put_u32(out, segment_base + 48, 1, little);
    }
    let section_base = segment_base + segment_header_size;
    ortest_put_bytes(out, section_base, "__data");
    ortest_put_bytes(out, section_base + 16, "__DATA");
    if (is_64) {
        ortest_put_u64(out, section_base + 32, 0, little);
        ortest_put_u64(out, section_base + 40, len_s(fixture.data), little);
        ortest_put_u32(out, section_base + 48, data_offset, little);
        ortest_put_u32(out, section_base + 68, 0, little);
    } else {
        ortest_put_u32(out, section_base + 32, 0, little);
        ortest_put_u32(out, section_base + 36, len_s(fixture.data), little);
        ortest_put_u32(out, section_base + 40, data_offset, little);
        ortest_put_u32(out, section_base + 64, 0, little);
    }

    let symtab_base = header_size + segment_size;
    ortest_put_u32(out, symtab_base, 2, little);
    ortest_put_u32(out, symtab_base + 4, 24, little);
    ortest_put_u32(out, symtab_base + 8, symbol_offset, little);
    ortest_put_u32(out, symtab_base + 12, vec_size(fixture.symbols), little);
    ortest_put_u32(out, symtab_base + 16, string_offset, little);
    ortest_put_u32(out, symtab_base + 20, len_s(string_bytes), little);

    ortest_put_bytes(out, data_offset, fixture.data);
    for (let i2 = 0; i2 < vec_size(fixture.symbols); i2 = i2 + 1) {
        let symbol = ortest_fixture_symbol(fixture, i2);
        let base = symbol_offset + i2 * symbol_size;
        ortest_put_u32(out, base, ortest_int_vec_get(name_offsets, i2), little);
        ortest_put_u8(out, base + 4, 15);
        ortest_put_u8(out, base + 5, 1);
        if (is_64) {
            ortest_put_u64(out, base + 8, symbol.value, little);
        } else {
            ortest_put_u32(out, base + 8, symbol.value, little);
        }
    }
    ortest_put_bytes(out, string_offset, string_bytes);
    vec_free(name_offsets);
    let result = cb_to_string(out);
    cb_free(out);
    return result;
}

func ortest_macho_symbol_base(
    fixture: ObjectReaderTestFixture*,
    is_64: bool,
    symbol_index: int
) -> int {
    let header_size = 28;
    let segment_size = 56 + 68;
    let symbol_size = 12;
    if (is_64) {
        header_size = 32;
        segment_size = 72 + 80;
        symbol_size = 16;
    }
    let command_bytes = segment_size + 24;
    let data_offset = header_size + command_bytes;
    let symbol_offset = data_offset + len_s(fixture.data);
    return symbol_offset + symbol_index * symbol_size;
}

func ortest_coff_decorated_name(
    symbol: ObjectReaderTestSymbol*,
    machine: int
) -> string {
    if (machine == 332) {
        return "_" + symbol.name;
    }
    /*
     * ARM64EC decorates C function names with one leading `#`.  Fixture
     * symbols with no data extent model functions; metadata arrays retain
     * their ordinary undecorated names.
     */
    if (machine == 42561 && symbol.size == 0) {
        return "#" + symbol.name;
    }
    return symbol.name;
}

func ortest_build_coff(
    fixture: ObjectReaderTestFixture*,
    machine: int
) -> string {
    let string_table = ortest_zero_buffer(4);
    let name_offsets = ortest_int_vec_create(vec_size(fixture.symbols));
    let symbol_count = 0;
    for (let i = 0; i < vec_size(fixture.symbols); i = i + 1) {
        let symbol = ortest_fixture_symbol(fixture, i);
        let decorated = ortest_coff_decorated_name(symbol, machine);
        if (len_s(decorated) <= 8) {
            vec_push_int(name_offsets, 0);
        } else {
            vec_push_int(name_offsets, cb_size(string_table));
            cb_append_s(string_table, decorated);
            cb_append(string_table, 0 as byte);
        }
        symbol_count = symbol_count + 1 + symbol.auxiliary_count;
    }
    let string_bytes = cb_to_string(string_table);
    cb_free(string_table);

    let section_table_end = 60;
    let data_offset = section_table_end;
    let symbol_offset = data_offset + len_s(fixture.data);
    let string_offset = symbol_offset + symbol_count * 18;
    let total_size = string_offset + len_s(string_bytes);
    let out = ortest_zero_buffer(total_size);

    ortest_put_u16(out, 0, machine, true);
    ortest_put_u16(out, 2, 1, true);
    ortest_put_u32(out, 8, symbol_offset, true);
    ortest_put_u32(out, 12, symbol_count, true);
    ortest_put_bytes(out, 20, ".data");
    ortest_put_u32(out, 20 + 16, len_s(fixture.data), true);
    ortest_put_u32(out, 20 + 20, data_offset, true);
    ortest_put_u32(out, 20 + 36, 64, true);
    ortest_put_bytes(out, data_offset, fixture.data);

    let symbol_index = 0;
    for (let i2 = 0; i2 < vec_size(fixture.symbols); i2 = i2 + 1) {
        let symbol2 = ortest_fixture_symbol(fixture, i2);
        let decorated2 = ortest_coff_decorated_name(symbol2, machine);
        let base = symbol_offset + symbol_index * 18;
        let long_offset = ortest_int_vec_get(name_offsets, i2);
        if (long_offset == 0) {
            ortest_put_bytes(out, base, decorated2);
        } else {
            ortest_put_u32(out, base + 4, long_offset, true);
        }
        ortest_put_u32(out, base + 8, symbol2.value, true);
        ortest_put_u16(out, base + 12, 1, true);
        if (symbol2.size == 0) {
            ortest_put_u16(out, base + 14, 32, true);
        }
        ortest_put_u8(out, base + 16, 2);
        ortest_put_u8(out, base + 17, symbol2.auxiliary_count);
        for (let aux_i = 0; aux_i < symbol2.auxiliary_count;
             aux_i = aux_i + 1) {
            /*
             * Make accidental parsing observable: interpreted as a primary
             * symbol, this auxiliary payload would define `main`.
             */
            let aux_base = base + (aux_i + 1) * 18;
            ortest_put_bytes(out, aux_base, "main");
            ortest_put_u16(out, aux_base + 12, 1, true);
            ortest_put_u8(out, aux_base + 16, 2);
        }
        symbol_index = symbol_index + 1 + symbol2.auxiliary_count;
    }
    ortest_put_bytes(out, string_offset, string_bytes);
    ortest_put_u32(out, string_offset, len_s(string_bytes), true);
    vec_free(name_offsets);
    let result = cb_to_string(out);
    cb_free(out);
    return result;
}

func ortest_metadata_records(has_entry: bool) -> StringVector* {
    let result = sv_create(2);
    let identity = om_encode_identity(
        "demo.main", "sip13:0123456789abcdef", has_entry);
    assert(identity != null, "identity fixture should encode");
    sv_push(result, identity as string);
    with (let names = sv_create(2) => sv_free(names),
          let fingerprints = sv_create(2) => sv_free(fingerprints)) {
        sv_push(names, "alpha");
        sv_push(fingerprints, "sip13:1111111111111111");
        sv_push(names, "pkg.beta");
        sv_push(fingerprints, "sip13:2222222222222222");
        let imports = om_encode_imports(names, fingerprints);
        assert(imports != null, "imports fixture should encode");
        sv_push(result, imports as string);
    }
    return result;
}

func ortest_metadata_fixture(
    identity: string,
    imports: string,
    identity_symbols: int,
    imports_symbols: int,
    include_init: bool,
    include_fini: bool,
    include_entry: bool
) -> ObjectReaderTestFixture* {
    let fixture = ortest_fixture_create(identity + imports);
    for (let i = 0; i < identity_symbols; i = i + 1) {
        ortest_fixture_add_symbol(
            fixture, om_identity_symbol_name("demo.main"), 0, len_s(identity));
    }
    for (let i2 = 0; i2 < imports_symbols; i2 = i2 + 1) {
        ortest_fixture_add_symbol(
            fixture, om_imports_symbol_name("demo.main"),
            len_s(identity), len_s(imports));
    }
    let end = len_s(fixture.data);
    if (include_init) {
        ortest_fixture_add_symbol_with_aux(
            fixture, om_init_symbol_name("demo.main"), end, 0, 1);
    }
    if (include_fini) {
        ortest_fixture_add_symbol(
            fixture, om_fini_symbol_name("demo.main"), end, 0);
    }
    if (include_entry) {
        ortest_fixture_add_symbol(
            fixture, om_entry_symbol_name("demo.main"), end, 0);
    }
    return fixture;
}

func ortest_valid_fixture(has_entry: bool) -> ObjectReaderTestFixture* {
    with (let records = ortest_metadata_records(has_entry) => sv_free(records)) {
        let fixture = ortest_metadata_fixture(
            sv_get(records, 0), sv_get(records, 1),
            1, 1, true, true, has_entry);
        ortest_fixture_add_symbol(
            fixture, "__deaM4demo4mainN4workF0i",
            len_s(fixture.data), 0);
        return fixture;
    }
}

func ortest_repeat(value: string, count: int) -> string {
    with (let out = cb_create() => cb_free(out)) {
        for (let i = 0; i < count; i = i + 1) {
            cb_append_s(out, value);
        }
        return cb_to_string(out);
    }
}

func ortest_assert_valid(bytes: string, expected_format: ObjectFormat) {
    with (let result = object_inspect_bytes(bytes) =>
              object_inspection_result_free(result)) {
        assert(result.error == null, "valid fixture should parse as an object");
        let inspection = result.inspection as ObjectInspection*;
        assert(ord(inspection.format) == ord(expected_format),
            "object format mismatch");
        assert(ord(inspection.metadata.kind) == ord(VALID_DEA_METADATA),
            "valid fixture should classify as Dea metadata");
        let metadata = inspection.metadata.valid as ValidDeaMetadata*;
        assert(metadata.module_name == "demo.main", "module identity mismatch");
        assert(metadata.fingerprint == "sip13:0123456789abcdef",
            "module fingerprint mismatch");
        assert(metadata.has_entry, "entry flag mismatch");
        assert(sv_size(metadata.ordered_imports) == 2, "import count mismatch");
        assert(sv_get(metadata.ordered_imports, 0) == "alpha",
            "first ordered import mismatch");
        assert(sv_get(metadata.ordered_imports, 1) == "pkg.beta",
            "second ordered import mismatch");
        assert(sv_get(metadata.import_fingerprints, 0) ==
                   "sip13:1111111111111111",
            "first import fingerprint mismatch");
        assert(sv_get(metadata.import_fingerprints, 1) ==
                   "sip13:2222222222222222",
            "second import fingerprint mismatch");
        assert(!object_inspection_defines_main(inspection),
            "valid Dea fixture should not define process main");
        assert(object_inspection_defines_symbol(
                   inspection, om_init_symbol_name("demo.main")),
            "normalized init definition should be queryable");
    }
}

func ortest_assert_malformed(bytes: string) {
    with (let result = object_inspect_bytes(bytes) =>
              object_inspection_result_free(result)) {
        assert(result.error == null,
            "metadata defect should not become a container-read error");
        assert(ord((result.inspection as ObjectInspection*).metadata.kind) ==
                   ord(MALFORMED_DEA_METADATA),
            "metadata defect should classify as malformed");
        assert(len_s((result.inspection as ObjectInspection*).metadata.reason) > 0,
            "malformed metadata should carry a reason");
    }
}

func test_supported_formats_widths_and_byte_orders() {
    with (let fixture = ortest_valid_fixture(true) => ortest_fixture_free(fixture)) {
        ortest_assert_valid(
            ortest_build_elf(fixture, false, true), OBJECT_FORMAT_ELF);
        ortest_assert_valid(
            ortest_build_elf(fixture, false, false), OBJECT_FORMAT_ELF);
        ortest_assert_valid(
            ortest_build_elf(fixture, true, true), OBJECT_FORMAT_ELF);
        ortest_assert_valid(
            ortest_build_elf(fixture, true, false), OBJECT_FORMAT_ELF);

        ortest_assert_valid(
            ortest_build_macho(fixture, false, true), OBJECT_FORMAT_MACHO);
        ortest_assert_valid(
            ortest_build_macho(fixture, false, false), OBJECT_FORMAT_MACHO);
        ortest_assert_valid(
            ortest_build_macho(fixture, true, true), OBJECT_FORMAT_MACHO);
        ortest_assert_valid(
            ortest_build_macho(fixture, true, false), OBJECT_FORMAT_MACHO);

        ortest_assert_valid(
            ortest_build_coff(fixture, 34404), OBJECT_FORMAT_PECOFF);
        ortest_assert_valid(
            ortest_build_coff(fixture, 332), OBJECT_FORMAT_PECOFF);
        ortest_assert_valid(
            ortest_build_coff(fixture, 448), OBJECT_FORMAT_PECOFF);
        ortest_assert_valid(
            ortest_build_coff(fixture, 452), OBJECT_FORMAT_PECOFF);
        ortest_assert_valid(
            ortest_build_coff(fixture, 43620), OBJECT_FORMAT_PECOFF);
        ortest_assert_valid(
            ortest_build_coff(fixture, 42561), OBJECT_FORMAT_PECOFF);
    }
}

func test_elf_darwin_tcc_alias_normalization() {
    with (let fixture = ortest_valid_fixture(true) =>
              ortest_fixture_free(fixture)) {
        ortest_fixture_add_symbol(fixture, "main", len_s(fixture.data), 0);
        ortest_fixture_add_symbol(fixture, "_helper", len_s(fixture.data), 0);
        with (let result = object_inspect_bytes(
                  ortest_build_elf_darwin_tcc(fixture, true, true)) =>
                  object_inspection_result_free(result)) {
            assert(result.error == null,
                "Darwin TinyCC ELF fixture should parse");
            let inspection = result.inspection as ObjectInspection*;
            assert(ord(inspection.metadata.kind) == ord(VALID_DEA_METADATA),
                "Darwin TinyCC ELF aliases should reveal Dea metadata");
            assert(object_inspection_defines_main(inspection),
                "exact ELF _main alias should normalize to main");
            assert(object_inspection_defines_symbol(
                       inspection, om_init_symbol_name("demo.main")),
                "triple-underscore ELF Dea alias should normalize");
            assert(object_inspection_defines_symbol(inspection, "_helper"),
                "unrelated single-underscore ELF symbol should be preserved");
            assert(!object_inspection_defines_symbol(inspection, "helper"),
                "ELF normalization must not strip arbitrary underscores");
        }
    }
}

func test_no_metadata_and_main_query() {
    let fixture = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(fixture, "main", 0, 0);
    with (let result = object_inspect_bytes(
              ortest_build_coff(fixture, 34404)) =>
              object_inspection_result_free(result)) {
        assert(result.error == null, "ordinary COFF object should parse");
        let inspection = result.inspection as ObjectInspection*;
        assert(ord(inspection.metadata.kind) == ord(NO_DEA_METADATA),
            "ordinary C object should have no Dea metadata");
        assert(object_inspection_defines_main(inspection),
            "ordinary C main should be reported separately");
        assert(object_inspection_defines_symbol(inspection, "main"),
            "exact normalized main query should succeed");
    }
    ortest_fixture_free(fixture);
}

func test_arm64ec_function_name_normalization() {
    let function_fixture = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(function_fixture, "main", 0, 0);
    with (let result = object_inspect_bytes(
              ortest_build_coff(function_fixture, 42561)) =>
              object_inspection_result_free(result)) {
        assert(result.error == null, "ARM64EC COFF object should parse");
        let inspection = result.inspection as ObjectInspection*;
        assert(ord(inspection.metadata.kind) == ord(NO_DEA_METADATA),
            "ordinary ARM64EC C object should have no Dea metadata");
        assert(object_inspection_defines_main(inspection),
            "ARM64EC #main should normalize to main");
        assert(!object_inspection_defines_symbol(inspection, "#main"),
            "normalized ARM64EC spelling should not retain its # decoration");
    }
    ortest_fixture_free(function_fixture);

    let data_fixture = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(data_fixture, "#main", 0, 1);
    ortest_fixture_add_symbol(data_fixture, "#__dea_not_lbi", 0, 1);
    with (let result2 = object_inspect_bytes(
              ortest_build_coff(data_fixture, 42561)) =>
              object_inspection_result_free(result2)) {
        assert(result2.error == null, "ARM64EC data-symbol fixture should parse");
        let inspection2 = result2.inspection as ObjectInspection*;
        assert(ord(inspection2.metadata.kind) == ord(NO_DEA_METADATA),
            "ARM64EC data names beginning # must not become Dea markers");
        assert(!object_inspection_defines_main(inspection2),
            "ARM64EC data #main must not become process main");
        assert(object_inspection_defines_symbol(inspection2, "#main"),
            "ARM64EC data #main should retain its literal spelling");
        assert(object_inspection_defines_symbol(
                   inspection2, "#__dea_not_lbi"),
            "ARM64EC data #__dea spelling should remain literal");
    }
    ortest_fixture_free(data_fixture);
}

func test_malformed_metadata_classification() {
    with (let records = ortest_metadata_records(true) => sv_free(records)) {
        let identity = sv_get(records, 0);
        let imports = sv_get(records, 1);

        with (let missing = ortest_metadata_fixture(
                  identity, imports, 1, 0, true, true, true) =>
                  ortest_fixture_free(missing)) {
            ortest_assert_malformed(ortest_build_elf(missing, true, true));
        }
        with (let duplicate = ortest_metadata_fixture(
                  identity, imports, 2, 1, true, true, true) =>
                  ortest_fixture_free(duplicate)) {
            ortest_assert_malformed(ortest_build_macho(duplicate, true, true));
        }
        let unsupported_identity = ortest_replace_byte(identity, 8, 2);
        with (let unsupported = ortest_metadata_fixture(
                  unsupported_identity, imports, 1, 1, true, true, true) =>
                  ortest_fixture_free(unsupported)) {
            ortest_assert_malformed(ortest_build_coff(unsupported, 34404));
        }
        with (let mismatch = ortest_metadata_fixture(
                  identity, imports, 1, 1, true, true, false) =>
                  ortest_fixture_free(mismatch)) {
            ortest_assert_malformed(ortest_build_elf(mismatch, false, false));
        }
    }

    let old = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(
        old, om_init_symbol_name("demo.main"), 0, 0);
    ortest_assert_malformed(ortest_build_macho(old, false, true));
    ortest_fixture_free(old);

    with (let cross_module = ortest_valid_fixture(true) =>
              ortest_fixture_free(cross_module)) {
        ortest_fixture_add_symbol(
            cross_module, "__deaM5otherI4init",
            len_s(cross_module.data), 0);
        ortest_assert_malformed(
            ortest_build_coff(cross_module, 34404));
    }
    with (let invalid_lbi = ortest_valid_fixture(true) =>
              ortest_fixture_free(invalid_lbi)) {
        ortest_fixture_add_symbol(
            invalid_lbi, "__deaM4demo4mainI3bad",
            len_s(invalid_lbi.data), 0);
        ortest_assert_malformed(
            ortest_build_elf(invalid_lbi, true, true));
    }

    let reserved = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(reserved, "__dea_not_lbi", 0, 0);
    ortest_assert_malformed(ortest_build_coff(reserved, 34404));
    ortest_fixture_free(reserved);
}

func test_lbi_parser_is_symbol_length_bounded() {
    let deep_type = ortest_repeat("P", 96) + "i";
    with (let valid = ortest_valid_fixture(true) =>
              ortest_fixture_free(valid)) {
        ortest_fixture_add_symbol(
            valid, "__deaM4demo4mainN4deepF0" + deep_type,
            len_s(valid.data), 0);
        ortest_fixture_add_symbol(
            valid, "__deaM4demo4mainN3varF2iVii",
            len_s(valid.data), 0);
        ortest_assert_valid(
            ortest_build_elf(valid, true, true), OBJECT_FORMAT_ELF);
    }

    with (let truncated = ortest_valid_fixture(true) =>
              ortest_fixture_free(truncated)) {
        ortest_fixture_add_symbol(
            truncated,
            "__deaM4demo4mainN4deepF0" + ortest_repeat("P", 96),
            len_s(truncated.data), 0);
        ortest_assert_malformed(
            ortest_build_elf(truncated, true, true));
    }

    with (let impossible_arity = ortest_valid_fixture(true) =>
              ortest_fixture_free(impossible_arity)) {
        ortest_fixture_add_symbol(
            impossible_arity, "__deaM4demo4mainN4hugeF999i",
            len_s(impossible_arity.data), 0);
        ortest_assert_malformed(
            ortest_build_coff(impossible_arity, 34404));
    }

    with (let misplaced_variadic = ortest_valid_fixture(true) =>
              ortest_fixture_free(misplaced_variadic)) {
        ortest_fixture_add_symbol(
            misplaced_variadic, "__deaM4demo4mainN3badF2Viii",
            len_s(misplaced_variadic.data), 0);
        ortest_assert_malformed(
            ortest_build_macho(misplaced_variadic, true, true));
    }
}

func test_macho_load_command_alignment() {
    with (let good32 = object_inspect_bytes(
              ortest_build_macho_unknown_command(false, true, 12)) =>
              object_inspection_result_free(good32)) {
        assert(good32.error == null,
            "aligned 32-bit unknown Mach-O command should be skippable");
    }
    with (let good64 = object_inspect_bytes(
              ortest_build_macho_unknown_command(true, true, 16)) =>
              object_inspection_result_free(good64)) {
        assert(good64.error == null,
            "aligned 64-bit unknown Mach-O command should be skippable");
    }
    with (let bad32 = object_inspect_bytes(
              ortest_build_macho_unknown_command(false, true, 10)) =>
              object_inspection_result_free(bad32)) {
        assert(bad32.error != null,
            "32-bit Mach-O command size must be 4-byte aligned");
        assert(ord((bad32.error as ObjectReadError*).kind) ==
                   ord(OBJECT_READ_CORRUPT),
            "misaligned 32-bit Mach-O command should be corrupt");
    }
    with (let bad64 = object_inspect_bytes(
              ortest_build_macho_unknown_command(true, true, 12)) =>
              object_inspection_result_free(bad64)) {
        assert(bad64.error != null,
            "64-bit Mach-O command size must be 8-byte aligned");
        assert(ord((bad64.error as ObjectReadError*).kind) ==
                   ord(OBJECT_READ_CORRUPT),
            "misaligned 64-bit Mach-O command should be corrupt");
    }
}

func test_macho_prebound_undefined_and_common_symbols() {
    let prebound = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(prebound, "main", 1, 0);
    ortest_fixture_add_symbol(prebound, "__dea_not_lbi", 0, 0);
    let prebound_bytes = ortest_build_macho(prebound, true, true);
    for (let i = 0; i < 2; i = i + 1) {
        let base = ortest_macho_symbol_base(prebound, true, i);
        prebound_bytes = ortest_replace_byte(prebound_bytes, base + 4, 13);
        prebound_bytes = ortest_replace_byte(prebound_bytes, base + 5, 0);
    }
    with (let result = object_inspect_bytes(prebound_bytes) =>
              object_inspection_result_free(result)) {
        assert(result.error == null, "Mach-O N_PBUD fixture should parse");
        let inspection = result.inspection as ObjectInspection*;
        assert(ord(inspection.metadata.kind) == ord(NO_DEA_METADATA),
            "N_PBUD Dea-looking symbols must not become metadata markers");
        assert(!object_inspection_defines_main(inspection),
            "N_PBUD main must not count as a definition even with a value");
    }
    ortest_fixture_free(prebound);

    let common = ortest_fixture_create(byte_to_s(0 as byte));
    ortest_fixture_add_symbol(common, "main", 1, 0);
    let common_bytes = ortest_build_macho(common, true, true);
    let common_base = ortest_macho_symbol_base(common, true, 0);
    common_bytes = ortest_replace_byte(common_bytes, common_base + 4, 1);
    common_bytes = ortest_replace_byte(common_bytes, common_base + 5, 0);
    with (let result2 = object_inspect_bytes(common_bytes) =>
              object_inspection_result_free(result2)) {
        assert(result2.error == null, "Mach-O common-symbol fixture should parse");
        let inspection2 = result2.inspection as ObjectInspection*;
        assert(object_inspection_defines_main(inspection2),
            "nonzero N_UNDF common symbol should remain a definition");
    }
    ortest_fixture_free(common);
}

func ortest_assert_no_truncated_prefix_is_valid(bytes: string) {
    for (let i = 0; i < len_s(bytes); i = i + 1) {
        with (let result = object_inspect_bytes(slice_s(bytes, 0, i)) =>
                  object_inspection_result_free(result)) {
            assert(result.error != null,
                "every truncated object prefix must be a typed read error");
        }
    }
}

func test_bounded_container_failures() {
    with (let fixture = ortest_valid_fixture(true) => ortest_fixture_free(fixture)) {
        let elf = ortest_build_elf(fixture, true, true);
        let macho = ortest_build_macho(fixture, true, true);
        let coff = ortest_build_coff(fixture, 34404);
        ortest_assert_no_truncated_prefix_is_valid(elf);
        ortest_assert_no_truncated_prefix_is_valid(macho);
        ortest_assert_no_truncated_prefix_is_valid(coff);

        /* ELF64 section-table offset with a nonzero high half is unsupported. */
        let elf_wide_offset = ortest_replace_byte(elf, 44, 1);
        with (let result = object_inspect_bytes(elf_wide_offset) =>
                  object_inspection_result_free(result)) {
            assert(result.error != null, "wide ELF offset should be a read error");
        }

        /* A maximal representable Mach-O symbol count cannot overflow storage. */
        let symtab_count_offset = 32 + 152 + 12;
        let macho_huge_count = macho;
        macho_huge_count = ortest_replace_byte(
            macho_huge_count, symtab_count_offset, 255);
        macho_huge_count = ortest_replace_byte(
            macho_huge_count, symtab_count_offset + 1, 255);
        macho_huge_count = ortest_replace_byte(
            macho_huge_count, symtab_count_offset + 2, 255);
        macho_huge_count = ortest_replace_byte(
            macho_huge_count, symtab_count_offset + 3, 127);
        with (let result2 = object_inspect_bytes(macho_huge_count) =>
                  object_inspection_result_free(result2)) {
            assert(result2.error != null, "hostile Mach-O count should be a read error");
        }

        /* COFF symbol count cannot extend past the bounded file. */
        let coff_huge_count = coff;
        coff_huge_count = ortest_replace_byte(coff_huge_count, 12, 255);
        coff_huge_count = ortest_replace_byte(coff_huge_count, 13, 255);
        coff_huge_count = ortest_replace_byte(coff_huge_count, 14, 255);
        coff_huge_count = ortest_replace_byte(coff_huge_count, 15, 127);
        with (let result3 = object_inspect_bytes(coff_huge_count) =>
                  object_inspection_result_free(result3)) {
            assert(result3.error != null, "hostile COFF count should be a read error");
        }
    }
}

func test_unsupported_containers_and_io_errors() {
    with (let random = object_inspect_bytes("not an object") =>
              object_inspection_result_free(random)) {
        assert(random.error != null, "random bytes should be unsupported");
        assert(ord((random.error as ObjectReadError*).kind) ==
                   ord(OBJECT_READ_UNSUPPORTED),
            "random bytes should carry unsupported kind");
    }
    with (let archive = object_inspect_bytes("!<arch>\n") =>
              object_inspection_result_free(archive)) {
        assert(archive.error != null, "archive should be unsupported");
    }
    with (let pe = object_inspect_bytes("MZ") =>
              object_inspection_result_free(pe)) {
        assert(pe.error != null, "PE image should be unsupported");
    }
    with (let fixture = ortest_valid_fixture(true) =>
              ortest_fixture_free(fixture)) {
        with (let arm64x = object_inspect_bytes(
                  ortest_build_coff(fixture, 42574)) =>
                  object_inspection_result_free(arm64x)) {
            assert(arm64x.error != null, "COFF ARM64X should be unsupported");
            assert(ord((arm64x.error as ObjectReadError*).kind) ==
                       ord(OBJECT_READ_UNSUPPORTED),
                "unsupported COFF machine should retain unsupported kind");
        }
    }
    let fat_macho =
        byte_to_s(202 as byte) + byte_to_s(254 as byte) +
        byte_to_s(186 as byte) + byte_to_s(190 as byte);
    with (let fat = object_inspect_bytes(fat_macho) =>
              object_inspection_result_free(fat)) {
        assert(fat.error != null, "fat Mach-O should be unsupported");
    }
    with (let missing = object_inspect_path(
              "/path/that/does/not/exist/dea-object-reader-test.o") =>
              object_inspection_result_free(missing)) {
        assert(missing.error != null, "missing path should be an I/O error");
        assert(ord((missing.error as ObjectReadError*).kind) ==
                   ord(OBJECT_READ_IO),
            "missing path should retain I/O error kind");
    }
}

func ortest_append_c_array(out: CharBuffer*, name: string, bytes: string) {
    cb_append_s(out, "const uint8_t ");
    cb_append_s(out, name);
    cb_append_s(out, "[] = {");
    for (let i = 0; i < len_s(bytes); i = i + 1) {
        if (i > 0) {
            cb_append_s(out, ",");
        }
        cb_append_int(out, char_at_s(bytes, i) as int);
    }
    cb_append_s(out, "};\n");
}

func test_native_compiler_smoke_object() {
    let compiler: string? = env_get("L1_CC");
    if (compiler == null) {
        compiler = env_get("CC");
    }
    if (compiler == null) {
        if (bd_is_windows()) {
            compiler = bd_find_c_compiler();
        } else {
            /*
             * Prefer the host's conventional compiler driver.  Stage 1's
             * bootstrap-oriented finder intentionally prefers tcc, which can
             * emit a cross-format object on some development hosts.
             */
            compiler = "cc";
        }
    }
    assert(compiler != null, "native object smoke test requires a C compiler");
    with (let records = ortest_metadata_records(true) => sv_free(records),
          let source = cb_create() => cb_free(source)) {
        cb_append_s(source, "#include <stdint.h>\n");
        ortest_append_c_array(
            source, om_identity_symbol_name("demo.main"), sv_get(records, 0));
        ortest_append_c_array(
            source, om_imports_symbol_name("demo.main"), sv_get(records, 1));
        cb_append_s(source, "void ");
        cb_append_s(source, om_init_symbol_name("demo.main"));
        cb_append_s(source, "(void){(void)((volatile const uint8_t*)");
        cb_append_s(source, om_identity_symbol_name("demo.main"));
        cb_append_s(source, ")[0];(void)((volatile const uint8_t*)");
        cb_append_s(source, om_imports_symbol_name("demo.main"));
        cb_append_s(source, ")[0];}\nvoid ");
        cb_append_s(source, om_fini_symbol_name("demo.main"));
        cb_append_s(source, "(void){}\nint ");
        cb_append_s(source, om_entry_symbol_name("demo.main"));
        cb_append_s(source, "(void){return 0;}\n");
        cb_append_s(source, "int main(void){return 0;}\n");

        let stem = bd_temp_stem("object-reader");
        let c_path = stem + ".c";
        let object_suffix = ".o";
        if (bd_is_windows()) {
            object_suffix = ".obj";
        }
        let object_path = stem + object_suffix;
        assert(write_file(c_path, cb_to_string(source)) != null,
            "native smoke C source should be writable");
        let family = bd_compiler_flag_family(compiler as string);
        let compile_rc = 1;
        with (let command_words = sv_create(7) => sv_free(command_words)) {
            sv_push(command_words, compiler as string);
            if (family == "msvc") {
                sv_push(command_words, "/nologo");
                sv_push(command_words, "/std:c11");
                sv_push(command_words, "/TC");
                sv_push(command_words, "/c");
                sv_push(command_words, c_path);
                sv_push(command_words, "/Fo:" + object_path);
            } else {
                sv_push(command_words, "-std=c99");
                sv_push(command_words, "-c");
                sv_push(command_words, c_path);
                sv_push(command_words, "-o");
                sv_push(command_words, object_path);
            }
            compile_rc = system(bd_join_shell_words(command_words));
        }
        assert(compile_rc == 0, "native metadata fixture should compile");
        with (let result = object_inspect_path(object_path) =>
                  object_inspection_result_free(result)) {
            assert(result.error == null, "native object should be readable");
            let inspection = result.inspection as ObjectInspection*;
            if (ord(inspection.metadata.kind) != ord(VALID_DEA_METADATA)) {
                printl_s("native object metadata reason: " + inspection.metadata.reason);
            }
            assert(ord(inspection.metadata.kind) == ord(VALID_DEA_METADATA),
                "native object should contain valid Dea metadata");
            assert((inspection.metadata.valid as ValidDeaMetadata*).module_name ==
                       "demo.main",
                "native object module mismatch");
            assert(object_inspection_defines_main(inspection),
                "native object process main should normalize");
        }
        delete_file(c_path);
        delete_file(object_path);
    }
}

func main() {
    test_supported_formats_widths_and_byte_orders();
    test_elf_darwin_tcc_alias_normalization();
    test_no_metadata_and_main_query();
    test_arm64ec_function_name_normalization();
    test_malformed_metadata_classification();
    test_lbi_parser_is_symbol_length_bounded();
    test_macho_load_command_alignment();
    test_macho_prebound_undefined_and_common_symbols();
    test_bounded_container_failures();
    test_unsupported_containers_and_io_errors();
    test_native_compiler_smoke_object();
    printl_s("object_reader_test: all tests passed");
}
