/**
 * Tests both compile-mode aliases and ordered interface paths.
 */
func test_compile_mode_and_interface_paths_parsed() {
    with (let argv = sv_create(12) => sv_free(argv)) {
        sv_push(argv, "-c");
        sv_push(argv, "-I");
        sv_push(argv, "interfaces/first");
        sv_push(argv, "-Iinterfaces/second");
        sv_push(argv, "--interface-path=interfaces/third");
        sv_push(argv, "--interface-path");
        sv_push(argv, "interfaces/fourth");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected compile-mode parse success");
        assert(parsed.options != null, "expected compile-mode options");
        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_COMPILE), "expected CM_COMPILE");
        assert(opts.entry_target as string == "app.main", "compile target mismatch");
        assert(sv_size(opts.interface_paths) == 4, "expected four interface paths");
        assert(sv_get(opts.interface_paths, 0) == "interfaces/first", "first interface path mismatch");
        assert(sv_get(opts.interface_paths, 1) == "interfaces/second", "second interface path mismatch");
        assert(sv_get(opts.interface_paths, 2) == "interfaces/third", "third interface path mismatch");
        assert(sv_get(opts.interface_paths, 3) == "interfaces/fourth", "fourth interface path mismatch");
        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(3) => sv_free(argv2)) {
        sv_push(argv2, "--compile");
        sv_push(argv2, "app.main");
        let parsed2 = cli_parse(argv2);
        assert(!diag_has_errors(parsed2.diags), "expected --compile parse success");
        assert(ord((parsed2.options as CliOptions*).mode) == ord(CM_COMPILE), "expected long compile alias");
        cli_parse_result_free(parsed2);
    }
}

/**
 * Tests compile-mode target and mode-conflict validation.
 */
func test_compile_mode_validation() {
    with (let missing = sv_create(1) => sv_free(missing)) {
        sv_push(missing, "--compile");
        let parsed = cli_parse(missing);
        assert(cli_result_has_code(parsed, "L1C-2021"), "expected missing compile target diagnostic");
        cli_parse_result_free(parsed);
    }

    with (let conflict = sv_create(4) => sv_free(conflict)) {
        sv_push(conflict, "--compile");
        sv_push(conflict, "--build");
        sv_push(conflict, "app.main");
        let parsed2 = cli_parse(conflict);
        assert(cli_result_has_code(parsed2, "L1C-2002"), "expected conflicting compile mode diagnostic");
        cli_parse_result_free(parsed2);
    }

    with (let multiple = sv_create(4) => sv_free(multiple)) {
        sv_push(multiple, "--compile");
        sv_push(multiple, "app.main");
        sv_push(multiple, "app.extra");
        let parsed3 = cli_parse(multiple);
        assert(cli_result_has_code(parsed3, "L1C-2024"), "expected multiple compile target diagnostic");
        cli_parse_result_free(parsed3);
    }

    with (let build_only = sv_create(16) => sv_free(build_only)) {
        sv_push(build_only, "--compile");
        sv_push(build_only, "--output");
        sv_push(build_only, "out.o");
        sv_push(build_only, "--keep-c");
        sv_push(build_only, "-Cc");
        sv_push(build_only, "clang");
        sv_push(build_only, "-Co=-O2");
        sv_push(build_only, "-Ri");
        sv_push(build_only, "runtime/include");
        sv_push(build_only, "-Rl=runtime/lib");
        sv_push(build_only, "app.main");
        let parsed4 = cli_parse(build_only);
        assert(cli_result_has_code(parsed4, "L1C-2010"), "expected compile output scope diagnostic");
        assert(cli_result_has_code(parsed4, "L1C-2011"), "expected compile keep-c scope diagnostic");
        assert(cli_result_has_code(parsed4, "L1C-2012"), "expected compile C compiler scope diagnostic");
        assert(cli_result_has_code(parsed4, "L1C-2013"), "expected compile C options scope diagnostic");
        assert(cli_result_has_code(parsed4, "L1C-2014"), "expected compile runtime include scope diagnostic");
        assert(cli_result_has_code(parsed4, "L1C-2015"), "expected compile runtime lib scope diagnostic");
        cli_parse_result_free(parsed4);
    }
}

/**
 * Tests interface paths are gated to compile mode and require values.
 */
func test_interface_path_scope_and_value_validation() {
    with (let missing = sv_create(3) => sv_free(missing)) {
        sv_push(missing, "--compile");
        sv_push(missing, "-I");
        let parsed = cli_parse(missing);
        assert(diag_count(parsed.diags) == 1, "EOF -I should emit only one diagnostic");
        assert(cli_result_has_code(parsed, "L1C-2003"), "expected missing interface-path value diagnostic");
        cli_parse_result_free(parsed);
    }

    with (let build = sv_create(5) => sv_free(build)) {
        sv_push(build, "--build");
        sv_push(build, "-I");
        sv_push(build, "interfaces");
        sv_push(build, "app.main");
        let parsed2 = cli_parse(build);
        assert(cli_result_has_code(parsed2, "L1C-2031"), "expected build interface-path scope diagnostic");
        cli_parse_result_free(parsed2);
    }

    with (let inspect = sv_create(5) => sv_free(inspect)) {
        sv_push(inspect, "--check");
        sv_push(inspect, "--interface-path");
        sv_push(inspect, "interfaces");
        sv_push(inspect, "app.main");
        let parsed3 = cli_parse(inspect);
        assert(cli_result_has_code(parsed3, "L1C-2031"), "expected inspection interface-path scope diagnostic");
        cli_parse_result_free(parsed3);
    }

    with (let run = sv_create(5) => sv_free(run)) {
        sv_push(run, "--run");
        sv_push(run, "--interface-path=interfaces");
        sv_push(run, "app.main");
        let parsed4 = cli_parse(run);
        assert(cli_result_has_code(parsed4, "L1C-2031"), "expected run interface-path scope diagnostic");
        cli_parse_result_free(parsed4);
    }
}

/**
 * Tests separated value options stop at the program-argument separator.
 */
func test_separated_values_do_not_consume_separator() {
    with (let options = sv_create(20) => sv_free(options)) {
        sv_push(options, "-Rp");
        sv_push(options, "--project-root");
        sv_push(options, "-Rs");
        sv_push(options, "--sys-root");
        sv_push(options, "-o");
        sv_push(options, "--output");
        sv_push(options, "-Cc");
        sv_push(options, "--c-compiler");
        sv_push(options, "-Co");
        sv_push(options, "--c-options");
        sv_push(options, "-I");
        sv_push(options, "--interface-path");
        sv_push(options, "-Ri");
        sv_push(options, "--runtime-include");
        sv_push(options, "-Rl");
        sv_push(options, "--runtime-lib");
        sv_push(options, "-L");
        sv_push(options, "-l");

        for (let i = 0; i < sv_size(options); i = i + 1) {
            let option = sv_get(options, i);
            with (let argv = sv_create(5) => sv_free(argv)) {
                sv_push(argv, "--run");
                sv_push(argv, "app.main");
                sv_push(argv, option);
                sv_push(argv, "--");
                let parsed = cli_parse(argv);
                assert(diag_count(parsed.diags) == 1, option + " should emit only one separator-boundary diagnostic");
                assert(cli_result_has_code(parsed, "L1C-2003"), option + " should report a missing value");
                assert(
                    diag_get(parsed.diags, 0).message == "missing value for option '" + option + "'",
                    option + " missing-value diagnostic should preserve the exact token"
                );
                cli_parse_result_free(parsed);
            }
        }
    }
}

/**
 * Tests namespaced short options and unchanged long forms.
 */
func test_namespaced_aliases_and_long_forms() {
    with (let global = sv_create(14) => sv_free(global)) {
        sv_push(global, "-vv");
        sv_push(global, "-Vl");
        sv_push(global, "-Rp");
        sv_push(global, "project/first");
        sv_push(global, "-Rp=project/second");
        sv_push(global, "-Rs");
        sv_push(global, "system/first");
        sv_push(global, "-Rs=system/second");
        sv_push(global, "app.main");
        let parsed = cli_parse(global);
        assert(!diag_has_errors(parsed.diags), "expected namespaced global aliases to parse");
        let opts = parsed.options as CliOptions*;
        assert(opts.verbosity == 2, "verbosity cluster mismatch");
        assert(opts.log, "namespaced log alias mismatch");
        assert(sv_size(opts.project_roots) == 2, "project root count mismatch");
        assert(sv_get(opts.project_roots, 0) == "project/first", "first project root mismatch");
        assert(sv_get(opts.project_roots, 1) == "project/second", "second project root mismatch");
        assert(sv_size(opts.sys_roots) == 2, "system root count mismatch");
        assert(sv_get(opts.sys_roots, 0) == "system/first", "first system root mismatch");
        assert(sv_get(opts.sys_roots, 1) == "system/second", "second system root mismatch");
        cli_parse_result_free(parsed);
    }

    with (let build = sv_create(12) => sv_free(build)) {
        sv_push(build, "-Cc");
        sv_push(build, "tcc");
        sv_push(build, "-Co=-Og -DDEBUG");
        sv_push(build, "-Ri");
        sv_push(build, "runtime/include");
        sv_push(build, "-Rl=runtime/lib");
        sv_push(build, "app.main");
        let parsed2 = cli_parse(build);
        assert(!diag_has_errors(parsed2.diags), "expected namespaced build aliases to parse");
        let opts2 = parsed2.options as CliOptions*;
        assert(opts2.c_compiler as string == "tcc", "C compiler alias mismatch");
        assert(opts2.c_options as string == "-Og -DDEBUG", "C options alias mismatch");
        assert(opts2.runtime_include as string == "runtime/include", "runtime include alias mismatch");
        assert(opts2.runtime_lib as string == "runtime/lib", "runtime lib alias mismatch");
        cli_parse_result_free(parsed2);
    }

    with (let gen = sv_create(3) => sv_free(gen)) {
        sv_push(gen, "-Gc");
        sv_push(gen, "app.main");
        let parsed3 = cli_parse(gen);
        assert(!diag_has_errors(parsed3.diags), "expected namespaced generate alias to parse");
        assert(ord((parsed3.options as CliOptions*).mode) == ord(CM_GEN), "expected -Gc generate mode");
        cli_parse_result_free(parsed3);
    }

    with (let long_forms = sv_create(12) => sv_free(long_forms)) {
        sv_push(long_forms, "--log");
        sv_push(long_forms, "--project-root=project/long");
        sv_push(long_forms, "--sys-root=system/long");
        sv_push(long_forms, "--c-compiler=tcc");
        sv_push(long_forms, "--c-options=-O2");
        sv_push(long_forms, "--runtime-include=runtime/include-long");
        sv_push(long_forms, "--runtime-lib=runtime/lib-long");
        sv_push(long_forms, "app.main");
        let parsed4 = cli_parse(long_forms);
        assert(!diag_has_errors(parsed4.diags), "expected unchanged long forms to parse");
        let long_opts = parsed4.options as CliOptions*;
        assert(long_opts.log, "long log option mismatch");
        assert(sv_get(long_opts.project_roots, 0) == "project/long", "long project root mismatch");
        assert(sv_get(long_opts.sys_roots, 0) == "system/long", "long system root mismatch");
        assert(long_opts.c_compiler as string == "tcc", "long C compiler option mismatch");
        assert(long_opts.c_options as string == "-O2", "long C options mismatch");
        assert(long_opts.runtime_include as string == "runtime/include-long", "long runtime include mismatch");
        assert(long_opts.runtime_lib as string == "runtime/lib-long", "long runtime lib mismatch");
        cli_parse_result_free(parsed4);
    }
}

/**
 * Tests namespaced value options reject concatenated spellings.
 */
func test_namespaced_values_reject_concatenation() {
    with (let concatenated = sv_create(10) => sv_free(concatenated)) {
        sv_push(concatenated, "-Rpproject");
        sv_push(concatenated, "-Rssystem");
        sv_push(concatenated, "-Ccclang");
        sv_push(concatenated, "-Co-O2");
        sv_push(concatenated, "-Riruntime/include");
        sv_push(concatenated, "-Rlruntime/lib");
        sv_push(concatenated, "app.main");
        let parsed = cli_parse(concatenated);
        assert(diag_count(parsed.diags) == 6, "expected each concatenated namespaced value to be rejected");
        for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
            assert(diag_get(parsed.diags, i).code == "L1C-2001", "expected unknown-option diagnostic");
        }
        cli_parse_result_free(parsed);
    }

    with (let mixed_cluster = sv_create(3) => sv_free(mixed_cluster)) {
        sv_push(mixed_cluster, "-vVl");
        sv_push(mixed_cluster, "app.main");
        let parsed2 = cli_parse(mixed_cluster);
        assert(cli_result_has_code(parsed2, "L1C-2001"), "only repeated-v short clusters should be accepted");
        cli_parse_result_free(parsed2);
    }

    with (let missing = sv_create(3) => sv_free(missing)) {
        sv_push(missing, "app.main");
        sv_push(missing, "-Cc");
        let parsed3 = cli_parse(missing);
        assert(diag_count(parsed3.diags) == 1, "expected one namespaced missing-value diagnostic");
        assert(cli_result_has_code(parsed3, "L1C-2003"), "expected namespaced missing-value diagnostic");
        cli_parse_result_free(parsed3);
    }
}

/**
 * Tests canonical reserved options and retired historical spellings.
 */
func test_canonical_reservations_and_retired_aliases() {
    with (let canonical = sv_create(12) => sv_free(canonical)) {
        sv_push(canonical, "-g");
        sv_push(canonical, "-S");
        sv_push(canonical, "-L");
        sv_push(canonical, "external/first");
        sv_push(canonical, "-Lexternal/second");
        sv_push(canonical, "-l");
        sv_push(canonical, "math");
        sv_push(canonical, "-lpthread");
        sv_push(canonical, "app.main");
        let parsed = cli_parse(canonical);
        assert(diag_count(parsed.diags) == 6, "expected one diagnostic per reserved canonical option");
        for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
            assert(diag_get(parsed.diags, i).code == "L1C-2032", "expected reserved-option diagnostic");
        }
        assert(contains_s(diag_get(parsed.diags, 0).message, "debug information"), "-g reservation mismatch");
        assert(contains_s(diag_get(parsed.diags, 1).message, "assembly output"), "-S reservation mismatch");
        assert(contains_s(diag_get(parsed.diags, 2).message, "external library search"), "-L reservation mismatch");
        assert(contains_s(diag_get(parsed.diags, 4).message, "external library selection"), "-l reservation mismatch");
        cli_parse_result_free(parsed);
    }

    with (let missing_library_path = sv_create(1) => sv_free(missing_library_path)) {
        sv_push(missing_library_path, "-L");
        let parsed2 = cli_parse(missing_library_path);
        assert(diag_count(parsed2.diags) == 1, "EOF -L should emit only one diagnostic");
        assert(cli_result_has_code(parsed2, "L1C-2003"), "expected missing -L value diagnostic");
        cli_parse_result_free(parsed2);
    }

    with (let missing_library = sv_create(1) => sv_free(missing_library)) {
        sv_push(missing_library, "-l");
        let parsed3 = cli_parse(missing_library);
        assert(diag_count(parsed3.diags) == 1, "EOF -l should emit only one diagnostic");
        assert(cli_result_has_code(parsed3, "L1C-2003"), "expected missing -l value diagnostic");
        cli_parse_result_free(parsed3);
    }

    with (let retired = sv_create(4) => sv_free(retired)) {
        sv_push(retired, "-P");
        sv_push(retired, "-C");
        sv_push(retired, "app.main");
        let parsed4 = cli_parse(retired);
        assert(diag_count(parsed4.diags) == 2, "expected retired aliases to be unknown");
        assert(diag_get(parsed4.diags, 0).code == "L1C-2001", "expected retired -P to be unknown");
        assert(diag_get(parsed4.diags, 1).code == "L1C-2001", "expected retired -C to be unknown");
        cli_parse_result_free(parsed4);
    }
}

/**
 * Tests canonical attached short values do not accept an equals separator.
 */
func test_canonical_short_equals_rejected() {
    with (let argv = sv_create(6) => sv_free(argv)) {
        sv_push(argv, "-c");
        sv_push(argv, "-I=interfaces");
        sv_push(argv, "-L=external");
        sv_push(argv, "-l=math");
        sv_push(argv, "app.main");
        let parsed = cli_parse(argv);
        assert(diag_count(parsed.diags) == 3, "expected canonical short equals forms to be rejected");
        for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
            assert(diag_get(parsed.diags, i).code == "L1C-2001", "expected unknown-option diagnostic");
        }
        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_help_flag_short_circuits_validation.
 */
func test_help_flag_short_circuits_validation() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "-h");
        sv_push(argv, "--bogus");

        let parsed = cli_parse(argv);
        assert(parsed.help_requested, "expected help request");
        assert(!diag_has_errors(parsed.diags), "help should not emit diagnostics");
        assert(parsed.options == null, "help should not return parsed options");

        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(3) => sv_free(argv2)) {
        sv_push(argv2, "--help");
        sv_push(argv2, "--");

        let parsed2 = cli_parse(argv2);
        assert(parsed2.help_requested, "help before a bare separator should still short-circuit");
        assert(!diag_has_errors(parsed2.diags), "help before a bare separator should not emit diagnostics");
        cli_parse_result_free(parsed2);
    }
}

/**
 * Tests test_version_flag_short_circuits_validation.
 */
func test_version_flag_short_circuits_validation() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "--version");
        sv_push(argv, "--bogus");

        let parsed = cli_parse(argv);
        assert(parsed.version_requested, "expected version request");
        assert(!parsed.help_requested, "version should not set help");
        assert(!diag_has_errors(parsed.diags), "version should not emit diagnostics");
        assert(parsed.options == null, "version should not return parsed options");
        assert(parsed.verbosity == 0, "version request should preserve parsed verbosity");

        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(3) => sv_free(argv2)) {
        sv_push(argv2, "--version");
        sv_push(argv2, "--");

        let parsed2 = cli_parse(argv2);
        assert(parsed2.version_requested, "version before a bare separator should still short-circuit");
        assert(!diag_has_errors(parsed2.diags), "version before a bare separator should not emit diagnostics");
        cli_parse_result_free(parsed2);
    }
}

/**
 * Tests that `--ast` is accepted as a valid mode.
 */
func test_ast_mode_accepted() {
    with (let argv = sv_create(2) => sv_free(argv)) {
        sv_push(argv, "--ast");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected --ast parse success");
        assert(parsed.options != null, "expected parsed options for --ast");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_AST), "expected CM_AST mode");
        assert(opts.entry_target != null, "expected entry target");
        assert(opts.entry_target as string == "app.main", "expected app.main target");
        assert(!opts.all_modules, "all_modules should default to false");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests that `--ast --all-modules` is accepted.
 */
func test_ast_all_modules_accepted() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "--ast");
        sv_push(argv, "--all-modules");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected --ast --all-modules parse success");
        assert(parsed.options != null, "expected parsed options");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_AST), "expected CM_AST mode");
        assert(opts.all_modules, "all_modules must be true");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests trace flags under `--gen` remain warning-only.
 */
func test_gen_trace_flags_emit_warning() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "--gen");
        sv_push(argv, "--trace-arc");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "trace flags under --gen should remain warning-only");
        assert(parsed.options != null, "expected parsed options for --gen trace flags");
        assert(diag_count(parsed.diags) == 1, "expected one warning for --gen trace flags");
        let diag = diag_get(parsed.diags, 0);
        assert(ord(diag.severity) == ord(Warning), "expected trace diagnostic to be a warning");
        assert(diag.code == "L1C-0019", "expected --gen trace warning code");

        cli_parse_result_free(parsed);
    }
}

