    assert_parse_rejected("module interface m;\nfingerprint \"\";\nconst : int = 0;", "PAR-0573", "<missing-const-name>");
}

/**
 * Find a parsed struct field's type by struct and field name.
 *
 * @param mi Parsed module interface to inspect.
 * @param struct_name Name of the struct to search.
 * @param field_name Name of the field within that struct.
 * @return Matching field type, or `null` when not found.
 */
func find_field_type(mi: ModuleInterface*, struct_name: string, field_name: string) -> Type*? {
    for (let i = 0; i < vec_size(mi.struct_infos); i = i + 1) {
        let info = ptr_vec_get(mi.struct_infos, i) as StructInfo*;
        if (info.name != struct_name) {
            continue;
        }
        for (let f = 0; f < vec_size(info.fields); f = f + 1) {
            let field = ptr_vec_get(info.fields, f) as StructFieldInfo*;
            if (field.name == field_name) {
                return field.field_type;
            }
        }
    }
    return null;
}

/**
 * Tests that parsing iface_cross_main with iface_dep as a peer preserves the
 * cross-module nominal kind of imported enum types.
 */
func test_interface_cross_module_kind_with_peers() {
    let dep_text = emit_interface_for("iface_dep");
    let main_text = emit_interface_for("iface_cross_main");

    let dep_parsed = pi_parse_interface(dep_text, "<iface_dep>");
    assert(!ipr_has_errors(dep_parsed), "iface_dep parse should succeed");
    let dep_mi = dep_parsed.interface as ModuleInterface*;

    with (let peers: VectorBase*? = ptr_vec_create(1) => vec_free(peers as VectorBase*)) {
        ptr_vec_push(peers as VectorBase*, dep_mi as void*);

        let main_parsed = pi_parse_interface_with_peers(main_text, "<iface_cross_main>", peers as VectorBase*);
        assert(!ipr_has_errors(main_parsed), "iface_cross_main parse should succeed");
        let main_mi = main_parsed.interface as ModuleInterface*;

        let point_ty_opt = find_field_type(main_mi, "RemoteHolder", "point");
        let tone_ty_opt = find_field_type(main_mi, "RemoteHolder", "tone");
        assert(point_ty_opt != null, "expected RemoteHolder.point field");
        assert(tone_ty_opt != null, "expected RemoteHolder.tone field");
        let point_ty = point_ty_opt as Type*;
        let tone_ty = tone_ty_opt as Type*;

        assert(ord(point_ty.kind) == ord(TY_STRUCT), "RemoteHolder.point must remain struct");
        assert(point_ty.module_name == "iface_dep", "RemoteHolder.point module mismatch");
        assert(point_ty.name == "RemotePoint", "RemoteHolder.point name mismatch");

        assert(ord(tone_ty.kind) == ord(TY_ENUM), "RemoteHolder.tone must be normalized to enum");
        assert(tone_ty.module_name == "iface_dep", "RemoteHolder.tone module mismatch");
        assert(tone_ty.name == "RemoteColor", "RemoteHolder.tone name mismatch");

        ipr_free(main_parsed);
    }

    ipr_free(dep_parsed);
}

/**
 * Tests that without peers, cross-module enums are still readable but lose
 * their kind, documenting the single-module parse limitation.
 */
func test_interface_cross_module_kind_without_peers() {
    let main_text = emit_interface_for("iface_cross_main");
    let parsed = pi_parse_interface(main_text, "<iface_cross_main>");
    assert(!ipr_has_errors(parsed), "iface_cross_main parse should succeed");

    let mi = parsed.interface as ModuleInterface*;
    let tone_ty_opt = find_field_type(mi, "RemoteHolder", "tone");
    assert(tone_ty_opt != null, "expected RemoteHolder.tone field");
    let tone_ty = tone_ty_opt as Type*;
    assert(ord(tone_ty.kind) == ord(TY_STRUCT), "without peers, cross-module enum should remain TY_STRUCT");
    ipr_free(parsed);
}

/**
 * Tests that const literals containing a dotted module path parse and
 * round-trip through emission.
 */
func test_interface_dotted_module_literal_round_trip() {
    let text = "module interface m;\nfingerprint \"\";\n\nconst x: pkg.sub::Color = pkg.sub::Red == \"\";\n\nconst y: pkg.sub::Color = pkg.sub::Rgb(255, 0, 0) == \"\";\n";

    let parsed = pi_parse_interface(text, "<dotted-literal>");
    assert(!ipr_has_errors(parsed), "dotted-literal const should parse");
    let mi = parsed.interface as ModuleInterface*;
    assert(vec_size(mi.let_entries) == 2, "expected two const entries");

    let saw_red = false;
    let saw_rgb = false;
    for (let i = 0; i < vec_size(mi.let_entries); i = i + 1) {
        let entry = ptr_vec_get(mi.let_entries, i) as InterfaceLetEntry*;
        if (entry.name == "x") {
            assert(entry.literal == "pkg.sub::Red", "x literal must round-trip dotted path");
            saw_red = true;
        }
        if (entry.name == "y") {
            assert(entry.literal == "pkg.sub::Rgb(255, 0, 0)", "y literal must round-trip dotted-path call");
            saw_rgb = true;
        }
    }
    assert(saw_red, "expected const x");
    assert(saw_rgb, "expected const y");

    let re_emitted = ie_emit(mi);
    assert(re_emitted == text, "dotted-literal interface text must round-trip byte-for-byte");
    ipr_free(parsed);
}

/**
 * Tests empty, flat, and nested array const literals round-trip canonically.
 */
func test_interface_array_literal_round_trip() {
    let text = "module interface arrays;\n" +
        "fingerprint \"\";\n" +
        "\n" +
        "const empty: int[2] = [] == \"\";\n" +
        "\n" +
        "const flat: int[3] = [1, 2, 3] == \"\";\n" +
        "\n" +
        "const nested: int[2][2] = [[1, 2], [3, 4]] == \"\";\n";
    let parsed = pi_parse_interface(text, "<arrays>");
    assert(!ipr_has_errors(parsed), "array const interface should parse");
    assert(parsed.interface != null, "array const interface should produce metadata");
    assert(ie_emit(parsed.interface as ModuleInterface*) == text,
        "array const interface should round-trip byte-for-byte");
    ipr_free(parsed);

    assert_parse_rejected(
        "module interface arrays;\nfingerprint \"\";\nconst bad: int[2] = [1,] == \"\";\n",
        "PAR-0572",
        "<array-trailing-comma>"
    );
    assert_parse_rejected(
        "module interface arrays;\nfingerprint \"\";\nconst bad: int[2] = [1 2] == \"\";\n",
        "PAR-0572",
        "<array-missing-comma>"
    );
}

/**
 * Tests signed numeric const literals, including bigint-token `int` minimum,
 * round-trip through the constrained interface parser.
 */
func test_interface_negative_literal_round_trip() {
    let text = "module interface signed_literals;\n" +
        "fingerprint \"\";\n" +
        "\n" +
        "const int_min: int = -2147483648 == \"\";\n" +
        "\n" +
        "const min_offset: int = -5 == \"\";\n" +
        "\n" +
        "const min_real: double = -2.5 == \"\";\n" +
        "\n" +
        "const offsets: int[3] = [1, -2, 3] == \"\";\n";
    let parsed = pi_parse_interface(text, "<signed-literals>");
    assert(!ipr_has_errors(parsed), "signed numeric const interface should parse");
    assert(parsed.interface != null, "signed numeric const interface should produce metadata");
    assert(ie_emit(parsed.interface as ModuleInterface*) == text,
        "signed numeric const interface should round-trip byte-for-byte");
    ipr_free(parsed);

    let spaced_text = "module interface signed_literals;\n" +
        "fingerprint \"\";\n" +
        "\n" +
        "const int_min: int = -2147483648 == \"\";\n" +
        "\n" +
        "const min_offset: int = -5 == \"\";\n" +
        "\n" +
        "const min_real: double = -2.5 == \"\";\n";
    let spaced = pi_parse_interface(
        "module interface signed_literals;\nfingerprint \"\";\n" +
            "const int_min: int = - 2147483648 == \"\";\n" +
            "const min_offset: int = - 5 == \"\";\n" +
            "const min_real: double = - 2.5 == \"\";\n",
        "<split-signed-literal>"
    );
    assert(!ipr_has_errors(spaced), "split-token signed numeric const interface should parse");
    assert(ie_emit(spaced.interface as ModuleInterface*) == spaced_text,
        "split-token signed numeric const should canonicalize");
    ipr_free(spaced);

    assert_parse_rejected(
        "module interface signed_literals;\nfingerprint \"\";\nconst bad: bool = -true == \"\";\n",
        "PAR-0572",
        "<signed-nonnumeric>"
    );
    assert_parse_rejected(
        "module interface signed_literals;\nfingerprint \"\";\nconst bad: int = - -5 == \"\";\n",
        "PAR-0572",
        "<double-signed-numeric>"
    );
}

/**
 * Tests duplicate interface names are rejected before interface replay.
 */
func test_interface_duplicate_declaration_rejected() {
    assert_parse_rejected(
        "module interface duplicates;\nfingerprint \"\";\nfunc value() -> int == \"\";\nconst value: int = 1 == \"\";\n",
        "PAR-0577",
        "<duplicate-func-const>"
    );
    assert_parse_rejected(
        "module interface duplicates;\nfingerprint \"\";\nenum Value { Ready; } == \"\";\nfunc Ready() -> int == \"\";\n",
        "PAR-0577",
        "<duplicate-variant-func>"
    );
    assert_parse_rejected(
        "module interface duplicates;\nfingerprint \"\";\nopaque struct Hidden == \"\";\nopaque enum Hidden == \"\";\n",
        "PAR-0577",
        "<duplicate-opaque-nominals>"
    );
}

/**
 * Tests that the interface emitter writes dotted module paths in const
 * literals (e.g. `pkg.sub::Red`, not `pkg::sub::Red`).
 */
func test_emit_interface_dotted_module_literal() {
    let emitted = emit_interface_for("iface_dotted_main");
    assert(contains_s(emitted, "module interface iface_dotted_main;\nfingerprint \"\";\n"),
        "expected dotted-main interface header");
    assert(contains_s(emitted, "const accent_color: pkg.sub::Color = pkg.sub::Rgb(255, 0, 0) == \"\";"),
        "expected dotted-module call literal");
    assert(contains_s(emitted, "const bg_color: pkg.sub::Color = pkg.sub::Red == \"\";"),
        "expected dotted-module variant literal");
    assert(!contains_s(emitted, "pkg::sub::"),
        "dotted module path must use '.' between segments, not '::'");
}

/**
 * Tests that a const literal with a dotted prefix but no '::' is rejected.
 */
func test_interface_dotted_literal_missing_double_colon() {
    assert_parse_rejected(
        "module interface m;\nfingerprint \"\";\nconst x: int = pkg.sub;\n",
        "PAR-0572",
        "<dotted-literal-missing-double-colon>"
    );
}

/**
 * Tests unsafe function markers in emitted and parsed interfaces.
 */
func test_interface_unsafe_function_markers() {
    let emitted = emit_interface_for("iface_unsafe");
    assert(contains_s(emitted, "unsafe func borrow(cb: unsafe func(int) -> int) -> unsafe func(int) -> int == \"\";"),
        "expected unsafe function signature in emitted interface");
    assert(contains_s(emitted, "extern func puts(value: string) -> int == \"\";"),
        "expected extern function signature in emitted interface");
    assert(contains_s(emitted, "unsafe extern func raw_sink(value: int*) -> void == \"\";"),
        "expected unsafe extern function signature in emitted interface");
    assert(contains_s(emitted, "type UnsafeCb = unsafe func(int) -> int == \"\";"),
        "expected unsafe function alias in emitted interface");

    let parsed = pi_parse_interface(emitted, "<iface_unsafe>");
    assert(!ipr_has_errors(parsed), "unsafe interface should parse");
    let mi = parsed.interface as ModuleInterface*;
    let func_entry = ptr_vec_get(mi.func_entries, 0) as InterfaceFuncEntry*;
    assert(func_entry.ty.is_unsafe, "expected top-level unsafe func flag");
    let param_ty = ptr_vec_get(func_entry.ty.params as VectorBase*, 0) as Type*;
    assert(param_ty.is_unsafe, "expected nested unsafe function type");
    let saw_extern = false;
    let saw_unsafe_extern = false;
    for (let i = 0; i < vec_size(mi.func_entries); i = i + 1) {
        let entry = ptr_vec_get(mi.func_entries, i) as InterfaceFuncEntry*;
        if (entry.name == "puts") {
            saw_extern = entry.is_extern && !entry.ty.is_unsafe;
        }
        if (entry.name == "raw_sink") {
            saw_unsafe_extern = entry.is_extern && entry.ty.is_unsafe;
        }
    }
    assert(saw_extern, "expected parsed extern function flag");
    assert(saw_unsafe_extern, "expected parsed unsafe extern function flags");
    ipr_free(parsed);

    assert_parse_rejected("module interface m;\nfingerprint \"\";\nunsafe const x: int = 0;\n", "PAR-0602", "<unsafe-bad-decl>");
}

/**
 * Tests ordered pointer and nullable suffixes round-trip through interfaces.
 */
func test_interface_ordered_type_suffix_round_trip() {
    let text = "module interface ordered_suffix;\nfingerprint \"\";\n\ntype A = int?* == \"\";\n\ntype B = int*? == \"\";\n\ntype C = int?? == \"\";\n\ntype D = int[2][3]? == \"\";\n\nfunc f(a: int?*, row: int[3]) -> int*? == \"\";\n";
    let parsed = pi_parse_interface(text, "<ordered-suffix>");
    assert(!ipr_has_errors(parsed), "ordered suffix interface should parse");
    assert(parsed.interface != null, "expected ordered suffix interface");
    let emitted = ie_emit(parsed.interface as ModuleInterface*);
    assert(emitted == text, "ordered suffix interface should round-trip byte-for-byte");
    ipr_free(parsed);
}

/**
 * Tests variadic declarations and function types round-trip through interfaces.
 */
func test_interface_variadic_round_trip() {
    let text = "module interface variadic_iface;\nfingerprint \"\";\n\nstruct Point {\n  value: int;\n} == \"\";\n\ntype V = func(int, Point...) -> int == \"\";\n\nfunc collect(prefix: int, values: Point...) -> int == \"\";\n";
    let parsed = pi_parse_interface(text, "<variadic-interface>");
    assert(!ipr_has_errors(parsed), "variadic interface should parse");
    let mi = parsed.interface as ModuleInterface*;
    let alias = ptr_vec_get(mi.alias_entries, 0) as InterfaceAliasEntry*;
    assert(alias.ty.is_variadic, "expected variadic function alias");
    let alias_pack = ptr_vec_get(alias.ty.params as VectorBase*, 1) as Type*;
    assert(ord(alias_pack.kind) == ord(TY_SLICE), "expected variadic alias pack slice");
    let alias_element = alias_pack.inner as Type*;
    assert(ord(alias_element.kind) == ord(TY_STRUCT), "expected nominal variadic alias element");
    assert(alias_element.module_name == "variadic_iface", "variadic alias element module mismatch");
    assert(alias_element.name == "Point", "variadic alias element name mismatch");
    let entry = ptr_vec_get(mi.func_entries, 0) as InterfaceFuncEntry*;
    assert(entry.ty.is_variadic, "expected variadic interface function");
    let func_pack = ptr_vec_get(entry.ty.params as VectorBase*, 1) as Type*;
    assert(ord(func_pack.kind) == ord(TY_SLICE), "expected variadic function pack slice");
    let func_element = func_pack.inner as Type*;
    assert(ord(func_element.kind) == ord(TY_STRUCT), "expected nominal variadic function element");
    assert(func_element.module_name == "variadic_iface", "variadic function element module mismatch");
    assert(func_element.name == "Point", "variadic function element name mismatch");
    assert(ie_emit(mi) == text, "variadic interface should round-trip byte-for-byte");
    ipr_free(parsed);
}

/**
 * Tests that peer lookup normalizes a cross-module nominal variadic element
 * through its semantic slice wrapper.
 */
func test_interface_variadic_cross_module_kind_with_peers() {
    let dep_text = emit_interface_for("iface_dep");
    let dep_parsed = pi_parse_interface(dep_text, "<iface_dep-variadic>");
    assert(!ipr_has_errors(dep_parsed), "iface_dep variadic peer parse should succeed");
    let dep_mi = dep_parsed.interface as ModuleInterface*;

    with (let peers: VectorBase*? = ptr_vec_create(1) => vec_free(peers as VectorBase*)) {
        ptr_vec_push(peers as VectorBase*, dep_mi as void*);
        let text = "module interface variadic_cross;\nfingerprint \"\";\n\nrequire iface_dep::RemoteColor == \"\";\n\nfunc collect(values: iface_dep::RemoteColor...) -> void == \"\";\n";
        let parsed = pi_parse_interface_with_peers(text, "<variadic-cross>", peers as VectorBase*);
        assert(!ipr_has_errors(parsed), "cross-module variadic interface should parse");
        let mi = parsed.interface as ModuleInterface*;
        let entry = ptr_vec_get(mi.func_entries, 0) as InterfaceFuncEntry*;
        let pack = ptr_vec_get(entry.ty.params as VectorBase*, 0) as Type*;
        assert(ord(pack.kind) == ord(TY_SLICE), "expected cross-module variadic pack slice");
        let element = pack.inner as Type*;
        assert(ord(element.kind) == ord(TY_ENUM), "cross-module variadic element must normalize to enum");
        assert(element.module_name == "iface_dep", "cross-module variadic element module mismatch");
        assert(element.name == "RemoteColor", "cross-module variadic element name mismatch");
        assert(ie_emit(mi) == text, "cross-module variadic interface should round-trip byte-for-byte");
        ipr_free(parsed);
    }

    ipr_free(dep_parsed);
}

/**
 * Return the synthetic provider interface used to exercise semantic
 * dependency classification and provider-fingerprint propagation.
 *
 * @return Parseable provider `.l1m` text.
 */
func dependency_provider_interface_text() -> string {
    return "module interface iface_dependency_provider;\n" +
        "fingerprint \"opaque:PROVIDER-v1\";\n" +
        "\n" +
        "struct RemotePoint {\n" +
        "  value: int;\n" +
        "} == \"\";\n" +
        "\n" +
        "struct LayoutOne {\n" +
        "  value: int;\n" +
        "} == \"\";\n" +
        "\n" +
        "struct LayoutTwo {\n" +
        "  value: int;\n" +
        "} == \"\";\n" +
        "\n" +
        "enum RemoteColor {\n" +
        "  Red;\n" +
        "} == \"\";\n" +
        "\n" +
        "enum InferredColor {\n" +
        "  Blue;\n" +
        "} == \"\";\n" +
        "\n" +
        "enum ImplColor {\n" +
        "  Green;\n" +
        "} == \"\";\n" +
        "\n" +
        "type RemoteAlias = RemotePoint == \"\";\n" +
        "\n" +
        "func remote_value() -> int == \"\";\n" +
        "\n" +
        "const public_seed: int = 40 == \"\";\n";
}

/**
 * Count ledger entries matching one canonical resolved-symbol identity.
 *
 * @param nr Name-resolution ledger to inspect.
 * @param consumer_module Consumer module name.
 * @param provider_module Provider module name.
 * @param symbol_name Canonical provider symbol name.
 * @return Matching entry count.
 */
func resolved_ref_count(nr: NameResolution*, consumer_module: string, provider_module: string,
                        symbol_name: string) -> int {
    let count = 0;
    for (let i = 0; i < nr_resolved_symbol_count(nr); i = i + 1) {
        let ref = nr_resolved_symbol_get(nr, i);
        if (ref.consumer_module == consumer_module && ref.provider_module == provider_module &&
            ref.symbol_name == symbol_name) {
            count = count + 1;
        }
    }
    return count;
}

/**
 * Tests semantic `require`/`link` projection, canonical ledger deduplication,
 * imported-alias preservation, enum-owner normalization, folded-const walking,
 * virtual-module exclusion, and provider-wide fingerprint propagation.
 */
func test_emit_interface_semantic_dependencies() {
    let parsed = pi_parse_interface(dependency_provider_interface_text(), "<iface_dependency_provider.l1m>");
    assert(!ipr_has_errors(parsed), "synthetic dependency provider should parse");
    assert(parsed.interface != null, "synthetic dependency provider should produce metadata");

    let interfaces = ptr_vec_create(1);
    ptr_vec_push(interfaces, parsed.interface as void*);
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry_with_interfaces(
            sp,
            "iface_dependency_consumer",
            interfaces,
            cfg
        );
        assert(!analysis_has_errors(result), "dependency consumer should analyze against its provider interface");

        let text_opt = analysis_emit_interface(result, "iface_dependency_consumer");
        assert(text_opt != null, "dependency consumer should project an interface");
        let text = text_opt as string;

        assert(contains_s(text,
            "require iface_dependency_provider::RemoteAlias == \"opaque:PROVIDER-v1\";"),
            "public TypeRef walk must preserve the imported alias identity");
        assert(contains_s(text,
            "require iface_dependency_provider::RemoteColor == \"opaque:PROVIDER-v1\";"),
            "public nominal type must become a require dependency");
        assert(contains_s(text,
            "require iface_dependency_provider::public_seed == \"opaque:PROVIDER-v1\";"),
            "folded exported const initializer must still be walked");
        assert(!contains_s(text, "require iface_dependency_provider::RemotePoint"),
            "imported aliases must not be replaced by their resolved nominal target in dependencies");
        assert(contains_s(text,
            "const alias_color: iface_dependency_provider::RemoteColor = iface_dependency_provider::Red == \"\";"),
            "alias-qualified const literals must emit canonical provider identity");
        assert(contains_s(text,
            "const selective_color: iface_dependency_provider::RemoteColor = iface_dependency_provider::Red == \"\";"),
            "selectively imported const literals must emit canonical provider identity");
        assert(contains_s(text,
            "require iface_dependency_provider::InferredColor == \"opaque:PROVIDER-v1\";"),
            "inferred exported bindings must add their resolved provider type to require");
        assert(contains_s(text,
            "let inferred_color: iface_dependency_provider::InferredColor == \"\";"),
            "inferred exported bindings must preserve resolved-type dependency projection");

        assert(contains_s(text,
            "link iface_dependency_provider::ImplColor == \"opaque:PROVIDER-v1\";"),
            "implementation enum variant must normalize to its owning enum");
        assert(contains_s(text,
            "link iface_dependency_provider::remote_value == \"opaque:PROVIDER-v1\";"),
            "implementation-only function use must become a link dependency");
        assert(contains_s(text,
            "link iface_dependency_provider::LayoutOne == \"opaque:PROVIDER-v1\";"),
            "unqualified sizeof type lookup must become a link dependency");
        assert(contains_s(text,
            "link iface_dependency_provider::LayoutTwo == \"opaque:PROVIDER-v1\";"),
            "alias-qualified sizeof type lookup must become a canonical link dependency");
        assert(!contains_s(text, "link iface_dependency_provider::Green"),
            "enum variants must not survive as variant-level dependencies");
        assert(!contains_s(text, "link iface_dependency_provider::public_seed"),
            "require dependencies must be subtracted from link dependencies");
        assert(!contains_s(text, "link iface_dependency_provider::InferredColor"),
            "inferred exported binding types must not remain implementation-tier links");
        assert(!contains_s(text, "require dea::") && !contains_s(text, "link dea::"),
            "compiler-synthesized virtual symbols must not enter dependency manifests");

        let nr = result.names as NameResolution*;
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "iface_dependency_provider", "remote_value") == 1,
            "repeated implementation lookups must deduplicate in the canonical ledger");
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "iface_dependency_provider", "ImplColor") == 1,
            "variant lookup must use one owner-normalized ledger entry");
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "iface_dependency_provider", "LayoutOne") == 1,
            "unqualified sizeof type lookup must enter the canonical ledger");
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "iface_dependency_provider", "LayoutTwo") == 1,
            "alias-qualified sizeof type lookup must enter the canonical ledger under its canonical provider");
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "iface_dependency_provider", "Green") == 0,
            "variant name must not appear in the canonical ledger");
        assert(resolved_ref_count(nr, "iface_dependency_consumer", "dea", "sizeof") == 0,
            "virtual-module lookup must not appear in the canonical ledger");

        analysis_result_free(result);

        let open_result = analysis_analyze_entry_with_interfaces(
            sp,
            "iface_dependency_open_consumer",
            interfaces,
            cfg
        );
        assert(!analysis_has_errors(open_result), "open-import dependency consumer should analyze");
        let open_text_opt = analysis_emit_interface(open_result, "iface_dependency_open_consumer");
        assert(open_text_opt != null, "open-import dependency consumer should project an interface");
        let open_text = open_text_opt as string;
        assert(contains_s(open_text,
            "const open_color: iface_dependency_provider::RemoteColor = iface_dependency_provider::Red == \"\";"),
            "open-import const literals must emit canonical provider identity");
        analysis_result_free(open_result);
    }
    sp_free(sp);
    vec_free(interfaces);
    ipr_free(parsed);
}

/**
 * Tests emitter-level tier subtraction preserves parsed expectation values.
 */
func test_interface_require_subtracts_link() {
    let text = "module interface overlap;\n" +
        "fingerprint \"\";\n" +
        "\n" +
        "require provider::shared == \"require-expectation\";\n" +
        "\n" +
        "link provider::shared == \"link-expectation\";\n" +
        "link provider::unique == \"unique-expectation\";\n";
    let parsed = pi_parse_interface(text, "<overlap>");
    assert(!ipr_has_errors(parsed), "overlapping parsed dependency tiers should parse");
    let emitted = ie_emit(parsed.interface as ModuleInterface*);
    assert(contains_s(emitted, "require provider::shared == \"require-expectation\";"),
        "require tier must preserve its parsed expectation");
    assert(!contains_s(emitted, "link provider::shared"),
        "require tier must suppress the same canonical link key");
    assert(contains_s(emitted, "link provider::unique == \"unique-expectation\";"),
        "unshadowed link tier must preserve its parsed expectation");
    ipr_free(parsed);
}

/**
 * Tests that the new per-symbol `require` and `link` dependency-line forms
 * (including canonical-looking lowercase algorithm-tagged hash strings) parse,
 * sort/deduplicate, and round-trip through emit -> parse -> emit byte-for-byte.
 */
func test_interface_dep_lines_round_trip() {
    let text = "module interface m;\nfingerprint \"sip13:f03142b8c9a7e6f1\";\n\nrequire myapp.rectangle::Rectangle == \"sip13:62649b8c7d5e4f3a\";\nrequire std.integer::Value == \"\";\n\nlink std.io::printl_s == \"sip13:91744a73b8c9d0e5\";\nlink std.real::sqrt_d == \"\";\n\nfunc ping() -> void == \"sip13:0a3862d838283ddd\";\n";

    let parsed = pi_parse_interface(text, "<dep-lines>");
    assert(!ipr_has_errors(parsed), "dep-line interface should parse");
    let mi = parsed.interface as ModuleInterface*;
    assert(mi.fingerprint == "sip13:f03142b8c9a7e6f1", "fingerprint string must round-trip including algorithm tag");
    assert(vec_size(mi.require_entries) == 2, "expected two require entries");
    assert(vec_size(mi.link_entries) == 2, "expected two link entries");

    let req0 = ptr_vec_get(mi.require_entries, 0) as InterfaceDepEntry*;
    assert(req0.provider_module == "myapp.rectangle", "first require provider module mismatch");
    assert(req0.symbol_name == "Rectangle", "first require symbol mismatch");
    assert(req0.hash == "sip13:62649b8c7d5e4f3a", "first require hash mismatch");

    let link0 = ptr_vec_get(mi.link_entries, 0) as InterfaceDepEntry*;
    assert(link0.provider_module == "std.io", "first link provider module mismatch");
    assert(link0.symbol_name == "printl_s", "first link symbol mismatch");

    let func_entry = ptr_vec_get(mi.func_entries, 0) as InterfaceFuncEntry*;
    assert(func_entry.hash == "sip13:0a3862d838283ddd", "func per-symbol hash must round-trip");

    let re_emitted = ie_emit(mi);
    assert(re_emitted == text, "dep-line interface must round-trip byte-for-byte");
    ipr_free(parsed);
}

/**
 * Tests constrained parsing preserves a deliberately non-canonical uppercase
 * fingerprint token without treating that parser-only behavior as validation.
 */
func test_interface_noncanonical_hash_token_round_trip() {
    let text = "module interface opaque_hash;\nfingerprint \"sip13:ABCDEF0123456789\";\n";
    let parsed = pi_parse_interface(text, "<noncanonical-hash-token>");
    assert(!ipr_has_errors(parsed), "opaque hash token should parse before fingerprint verification exists");
    let mi = parsed.interface as ModuleInterface*;
    assert(mi.fingerprint == "sip13:ABCDEF0123456789", "parser must preserve opaque fingerprint spelling");
    assert(ie_emit(mi) == text, "opaque fingerprint spelling must round-trip byte-for-byte");
    ipr_free(parsed);
}

/**
 * Tests targeted diagnostics for the new per-decl hash suffix.
 */
func test_interface_decl_hash_suffix_diagnostics() {
    assert_parse_rejected("module interface m;\nfingerprint \"\";\nfunc ping() -> void;\n", "PAR-0574", "<missing-decl-eqeq>");
    assert_parse_rejected("module interface m;\nfingerprint \"\";\nfunc ping() -> void == ;\n", "PAR-0575", "<missing-decl-hash>");
    assert_parse_rejected("module interface m;\nfingerprint \"\";\nstruct S { } == \"\"\n", "PAR-0576", "<missing-struct-hash-semi>");
}

/**
 * Main entry point for the module.
 */
func main() {
    test_emit_interface_deterministic();
    test_interface_round_trip();
    test_interface_header_rejection();
    test_interface_dotted_module_header();
    test_interface_targeted_diagnostics();
    test_emit_interface_cross_module_types();
    test_emit_interface_require_from_const_value();
    test_emit_interface_no_deps_for_self_contained();
    test_interface_null_type_rejection();
    test_emit_interface_implicit_default();
    test_emit_interface_export_star();
    test_emit_interface_opaque_nominals();
    test_interface_opaque_decl_rejection();
    test_interface_missing_module_name();
    test_interface_missing_fingerprint_keyword();
    test_interface_missing_fingerprint_string();
    test_interface_missing_fingerprint_semi();
    test_interface_missing_colon();
    test_interface_missing_let_semi();
    test_interface_missing_const_value();
    test_interface_missing_const_semi();
    test_interface_missing_decl_idents();
    test_interface_cross_module_kind_with_peers();
    test_interface_cross_module_kind_without_peers();
    test_interface_dotted_module_literal_round_trip();
    test_interface_array_literal_round_trip();
    test_interface_negative_literal_round_trip();
    test_interface_duplicate_declaration_rejected();
    test_emit_interface_dotted_module_literal();
    test_interface_dotted_literal_missing_double_colon();
    test_interface_unsafe_function_markers();
    test_interface_ordered_type_suffix_round_trip();
    test_interface_variadic_round_trip();
    test_interface_variadic_cross_module_kind_with_peers();
    test_emit_interface_semantic_dependencies();
    test_interface_require_subtracts_link();
    test_interface_dep_lines_round_trip();
    test_interface_noncanonical_hash_token_round_trip();
    test_interface_decl_hash_suffix_diagnostics();
    printl_s("interface_test: all tests passed");
}
