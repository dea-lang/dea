/**
 * Returns the root directory for interface fixtures.
 *
 * @return The interface fixture directory used by these tests.
 */
func fixture_root() -> string {
    return "compiler/stage1_l0/tests/fixtures/interface";
}

/**
 * Creates source search paths rooted at the interface fixtures.
 *
 * @return Search paths for interface tests.
 */
func make_paths() -> SourceSearchPaths* {
    let sp = sp_create();
    sp_add_project_root(sp, fixture_root());
    return sp;
}

/**
 * Emit the canonical interface text for one fixture module.
 *
 * @param module_name Entry module to analyze and emit.
 * @return Emitted interface text.
 */
func emit_interface_for(module_name: string) -> string {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, module_name, cfg);
        assert(!analysis_has_errors(result), "expected analysis success for " + module_name + "");
        let text = analysis_emit_interface(result, module_name);
        assert(text != null, "expected interface emission to succeed");
        let emitted = text as string;
        analysis_result_free(result);
        sp_free(sp);
        return emitted;
    }
}

/**
 * Emit the canonical interface text for the demo fixture.
 *
 * @return Emitted interface text.
 */
func emit_demo_interface() -> string {
    return emit_interface_for("iface_demo");
}

/**
 * Assert that interface parsing fails with the expected first diagnostic code.
 *
 * @param source Interface text to parse.
 * @param expected_code Expected first diagnostic code.
 * @param filename Synthetic filename for diagnostics.
 */
func assert_parse_rejected(source: string, expected_code: string, filename: string) {
    let parsed = pi_parse_interface(source, filename);
    assert(ipr_has_errors(parsed), "expected interface parse failure for " + filename + "");
    assert(parsed.interface == null, "rejected interface must not produce a ModuleInterface: " + filename + "");
    assert(diag_count(parsed.diags) > 0, "expected diagnostics for rejected interface: " + filename + "");
    let diag = diag_get(parsed.diags, 0);
    assert(diag.code == expected_code, "unexpected diagnostic code for " + filename + ": " + expected_code);
    ipr_free(parsed);
}

/**
 * Tests that emitted interfaces are deterministic and omit non-export surface.
 */
func test_emit_interface_deterministic() {
    let first = emit_demo_interface();
    let second = emit_demo_interface();

    assert(first == second, "interface emission must be deterministic");
    assert(contains_s(first, "module interface iface_demo;\nfingerprint \"\";\n"), "expected interface header");
    assert(contains_s(first, "struct Point {\n  x: int;\n  y: int;\n} == \"\";"), "expected exported struct");
    assert(contains_s(first, "enum Color {\n  Red;\n  Green;\n  Blue;\n  Rgb(red: int, green: int, blue: int);\n} == \"\";"), "expected exported enum");
    assert(contains_s(first, "type Dims = Size == \"\";"), "expected exported alias");
    assert(contains_s(first, "func area(s: Size) -> int == \"\";"), "expected exported function");
    assert(contains_s(first, "const origin: Point = Point(0, 0) == \"\";"), "expected struct const literal");
    assert(contains_s(first, "const scale_factor: double = 2.5 == \"\";"), "expected scalar const literal");
    assert(contains_s(first, "const cast_count: int = 25 == \"\";"), "expected folded integer cast const literal");
    assert(contains_s(first, "const cast_float: float = 2.5f == \"\";"), "expected folded real cast const literal");
    assert(contains_s(first, "const folded_count: int = 10 == \"\";"), "expected folded scalar const expression");
    assert(contains_s(first, "const neg_seed: int = -25 == \"\";"), "expected folded negative const literal");
    assert(contains_s(first, "const sample_values: int[3] = [1, 2, 3] == \"\";"),
        "expected fixed-array const literal");
    assert(!contains_s(first, " as "), "interface const casts must serialize as folded literals");
    assert(contains_s(first, "const zero_color: Color = Red == \"\";"), "expected enum-variant const literal");
    assert(contains_s(first, "const vivid_color: Color = Rgb(255, 0, 0) == \"\";"), "expected multi-field enum const literal");
    assert(contains_s(first, "let current_offset: Point? == \"\";"), "expected exported let");
    assert(!contains_s(first, "helper"), "private helper must not be emitted");
    assert(!contains_s(first, "export "), "interface files must not emit export manifests");

    let point_index = find_s(first, "struct Point");
    let alias_index = find_s(first, "type Dims = Size == \"\";");
    let func_index = find_s(first, "func area(s: Size) -> int == \"\";");
    let const_index = find_s(first, "const origin: Point = Point(0, 0) == \"\";");
    let let_index = find_s(first, "let current_offset: Point? == \"\";");
    assert(point_index >= 0, "expected struct Point in emitted interface");
    assert(alias_index > point_index, "aliases must follow nominal type declarations");
    assert(func_index > alias_index, "functions must follow aliases");
    assert(const_index > func_index, "consts must follow functions");
    assert(let_index > const_index, "lets must follow consts");
}

/**
 * Tests that parser round-trip preserves canonical emission.
 */
func test_interface_round_trip() {
    let emitted = emit_demo_interface();
    let parsed = pi_parse_interface(emitted, "<iface>");
    assert(!ipr_has_errors(parsed), "round-trip parse should succeed");
    assert(parsed.interface != null, "expected parsed interface");

    let mi = parsed.interface as ModuleInterface*;
    assert(mi.module_name == "iface_demo", "module name mismatch");
    assert(mi.fingerprint == "", "fingerprint placeholder mismatch");
    assert(vec_size(mi.struct_infos) == 2, "expected 2 exported structs");
    assert(vec_size(mi.enum_infos) == 1, "expected 1 exported enum");
    assert(vec_size(mi.alias_entries) == 1, "expected 1 exported alias");
    assert(vec_size(mi.func_entries) == 2, "expected 2 exported funcs");
    assert(vec_size(mi.let_entries) == 12, "expected 11 consts plus 1 let");

    let re_emitted = ie_emit(mi);
    assert(re_emitted == emitted, "parser/emitter round-trip must preserve canonical text");
    ipr_free(parsed);
}

/**
 * Tests malformed headers report the dedicated interface diagnostics.
 */
func test_interface_header_rejection() {
    assert_parse_rejected("module iface_demo;\nfingerprint \"\";\n", "PAR-0561", "<bad>");
}

/**
 * Tests dotted module names in interface headers.
 */
func test_interface_dotted_module_header() {
    let parsed = pi_parse_interface("module interface demo.main;\nfingerprint \"\";\nfunc ping() -> void == \"\";\n", "<dotted>");
    assert(!ipr_has_errors(parsed), "expected dotted module header to parse");
    assert(parsed.interface != null, "expected parsed interface for dotted module header");
    let mi = parsed.interface as ModuleInterface*;
    assert(mi.module_name == "demo.main", "dotted module name mismatch");
    assert(vec_size(mi.func_entries) == 1, "expected single function entry");
    ipr_free(parsed);
}

/**
 * Tests targeted interface parser diagnostics that are easy to regress.
 */
func test_interface_targeted_diagnostics() {
    assert_parse_rejected("interface demo.main;\nfingerprint \"\";\n", "PAR-0560", "<missing-module>");
    assert_parse_rejected("module interface demo.main\nfingerprint \"\";\n", "PAR-0563", "<missing-header-semi>");
    assert_parse_rejected("module interface demo.main;\nfingerprint \"\";\nfunc ping() -> void == \"\"\n", "PAR-0568", "<missing-func-semi>");
    assert_parse_rejected("module interface demo.main;\nfingerprint \"\";\nimport iface_dep;\n", "PAR-0572", "<unexpected-decl>");
}

/**
 * Tests that cross-module nominal types stay fully qualified in emitted output.
 */
func test_emit_interface_cross_module_types() {
    let emitted = emit_interface_for("iface_cross_main");

    assert(contains_s(emitted, "point: iface_dep::RemotePoint;"), "expected qualified struct field type");
    assert(contains_s(emitted, "tone: iface_dep::RemoteColor;"), "expected qualified enum field type");
    assert(contains_s(emitted, "type RemoteAlias = iface_dep::RemotePoint == \"\";"), "expected qualified alias target");
    assert(contains_s(emitted, "func remote_identity(point: iface_dep::RemotePoint) -> iface_dep::RemotePoint == \"\";"),
        "expected qualified function signature");
    assert(contains_s(emitted, "let remote_slot: iface_dep::RemotePoint? == \"\";"), "expected qualified nullable let type");

    assert(contains_s(emitted, "require iface_dep::RemotePoint == \"\";"),
        "expected per-symbol require for cross-module struct directly named in surface");
    assert(contains_s(emitted, "require iface_dep::RemoteColor == \"\";"),
        "expected per-symbol require for cross-module enum directly named in surface");

    let require_index = find_s(emitted, "require iface_dep::RemoteColor");
    let struct_index = find_s(emitted, "struct RemoteHolder");
    assert(require_index > 0 && require_index < struct_index,
        "require section must precede declarations");
}

/**
 * Tests that const values referencing cross-module enum variants do not add
 * variant-level require lines: the parent enum is captured (via the const's
 * declared type), and the variant reaches the consumer transitively through
 * the enum's per-symbol hash.
 */
func test_emit_interface_require_from_const_value() {
    let emitted = emit_interface_for("iface_dotted_main");
    assert(contains_s(emitted, "require pkg.sub::Color == \"\";"),
        "expected require for cross-module const type");
    assert(!contains_s(emitted, "require pkg.sub::Red"),
        "enum-variant references must not produce variant-level require entries");
    assert(!contains_s(emitted, "require pkg.sub::Rgb"),
        "enum-variant constructor references must not produce variant-level require entries");
}

/**
 * Tests that a module with no cross-module references emits no dependency lines.
 */
func test_emit_interface_no_deps_for_self_contained() {
    let emitted = emit_interface_for("iface_demo");
    assert(!contains_s(emitted, "\nrequire "),
        "self-contained module must not emit any require lines");
    assert(!contains_s(emitted, "\nlink "),
        "self-contained module must not emit any link lines");
}

/**
 * Tests that `null` is rejected in interface type position.
 */
func test_interface_null_type_rejection() {
    assert_parse_rejected("module interface demo.main;\nfingerprint \"\";\nlet bad: null;\n", "PAR-0572", "<null-type>");
}

/**
 * Tests that implicit-default exports omit underscore-prefixed symbols.
 */
func test_emit_interface_implicit_default() {
    let emitted = emit_interface_for("iface_implicit");
    assert(contains_s(emitted, "module interface iface_implicit;\nfingerprint \"\";\n"), "expected header");
    assert(contains_s(emitted, "struct Point"), "expected exported struct");
    assert(contains_s(emitted, "func area(p: Point) -> int == \"\";"), "expected exported func");
    assert(!contains_s(emitted, "_helper"), "private _-prefixed func must not be exported with implicit default");
}

/**
 * Tests that `export *;` exports underscore-prefixed symbols.
 */
func test_emit_interface_export_star() {
    let emitted = emit_interface_for("iface_export_star");
    assert(contains_s(emitted, "module interface iface_export_star;\nfingerprint \"\";\n"), "expected header");
    assert(contains_s(emitted, "struct Point"), "expected exported struct");
    assert(contains_s(emitted, "func area(p: Point) -> int == \"\";"), "expected exported func");
    assert(contains_s(emitted, "_helper"), "_-prefixed func must be exported with export *");
}

/**
 * Tests opaque nominal interface emission and round-trip parsing.
 */
func test_emit_interface_opaque_nominals() {
    let emitted = emit_interface_for("iface_opaque");
    assert(contains_s(emitted, "opaque struct Handle == \"\";"), "expected opaque struct declaration");
    assert(contains_s(emitted, "opaque enum State == \"\";"), "expected opaque enum declaration");
    assert(!contains_s(emitted, "struct Handle {"), "opaque struct must not emit fields");
    assert(!contains_s(emitted, "enum State {"), "opaque enum must not emit variants");
    assert(contains_s(emitted, "func make_handle(value: int) -> Handle* == \"\";"), "expected pointer-return signature");
    assert(contains_s(emitted, "func step(handle: Handle*, state: State*) -> Handle* == \"\";"), "expected opaque pointer parameters");

    let parsed = pi_parse_interface(emitted, "<iface-opaque>");
    assert(!ipr_has_errors(parsed), "opaque interface parse should succeed");
    let mi = parsed.interface as ModuleInterface*;
    assert(vec_size(mi.struct_infos) == 1, "expected one opaque struct");
    assert(vec_size(mi.enum_infos) == 1, "expected one opaque enum");
    let struct_info = ptr_vec_get(mi.struct_infos, 0) as StructInfo*;
    let enum_info = ptr_vec_get(mi.enum_infos, 0) as EnumInfo*;
    assert(struct_info.is_opaque, "parsed struct must be opaque");
    assert(enum_info.is_opaque, "parsed enum must be opaque");
    assert(vec_size(struct_info.fields) == 0, "opaque struct must parse with no fields");
    assert(vec_size(enum_info.variants) == 0, "opaque enum must parse with no variants");

    let re_emitted = ie_emit(mi);
    assert(re_emitted == emitted, "opaque interface must round-trip byte-for-byte");
    ipr_free(parsed);
}

