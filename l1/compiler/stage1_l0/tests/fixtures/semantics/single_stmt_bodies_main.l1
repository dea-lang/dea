module single_stmt_bodies_main;

enum MaybeInt {
    None;
    Some(value: int);
}

func make_some(value: int) -> MaybeInt {
    return Some(value);
}

func scope_demo(flag: bool, n: int) -> int {
    let total: int = n;

    while (flag) let while_local: int = total;

    for (let i: int = 0; i < 1; i = i + 1) let for_local: int = i;

    case (total) {
        0 => let case_local: int = 1;
        else let case_else_local: int = 2;
    }

    match (make_some(total)) {
        Some(v) => let arm_local: int = v;
        None => total = 0;
    }

    return total;
}

func main() -> int {
    return scope_demo(false, 1);
}
