module iface_opaque;

export opaque { Handle, State }, make_handle, step;

struct Handle {
    value: int;
}

enum State {
    Ready;
    Done(code: int);
}

func make_handle(value: int) -> Handle* {
    return new Handle(value);
}

func step(handle: Handle*, state: State*) -> Handle* {
    return handle;
}
