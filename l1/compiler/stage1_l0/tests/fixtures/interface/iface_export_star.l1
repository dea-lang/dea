module iface_export_star;

export *;

/**
 * A 2D point.
 */
struct Point {
    x: int;
    y: int;
}

/**
 * Compute area.
 */
func area(p: Point) -> int {
    return p.x * p.y;
}

/**
 * _-prefixed helper exported because of export *;.
 */
func _helper() -> int {
    return 0;
}
