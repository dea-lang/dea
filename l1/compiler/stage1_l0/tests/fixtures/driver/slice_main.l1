module slice_main;

func sum_first_two(s: int[]) -> int {
    return s[0] + s[1];
}

func main() -> int {
    let a: int[4] = [10, 20, 30, 40];
    let whole: int[] = a;
    let mid = slice(a, 1, 2);
    let tail = slice(a, 2);
    let empty = slice(a, 4, 0);
    whole[0] = 11;
    if (len(whole) != 4) { return 1; }
    if (len(mid) != 2) { return 2; }
    if (len(tail) != 2) { return 3; }
    if (len(empty) != 0) { return 4; }
    if (mid[0] != 20) { return 5; }
    if (tail[1] != 40) { return 6; }
    if (whole[0] != 11) { return 7; }
    if (sum_first_two(mid) != 50) { return 8; }
    return 0;
}
