/**
 * Tests that invalid arms after a default recover inside the current `case`.
 */
func test_case_default_recovery_stays_inside_case() {
    let src = "module main;\n" +
        "func main() -> int {\n" +
        "    case (1) {\n" +
        "        else { return 0; }\n" +
        "        \"a\" => { return 1; }\n" +
        "        _ => 2;\n" +
        "        else 3;\n" +
        "    }\n" +
        "    printl_s(\"ok\");\n" +
        "    return 0;\n" +
        "}\n";
    expect_diag_code_present(src, "PAR-0242");
    expect_diag_code_present(src, "PAR-0234");
    expect_diag_code_count(src, "PAR-0236", 2);
    expect_diag_code_absent(src, "PAR-0225");
    expect_diag_code_absent(src, "PAR-0123");
    expect_diag_code_absent(src, "PAR-0020");
    expect_diag_code_line(src, "PAR-0242", 0, 4);
    expect_diag_code_line(src, "PAR-0234", 0, 5);
    expect_diag_code_line(src, "PAR-0236", 0, 6);
    expect_diag_code_line(src, "PAR-0236", 1, 7);
    expect_diag_code_span(src, "PAR-0242", 0, 4, 9, 4, 13);
    expect_diag_code_span(src, "PAR-0234", 0, 5, 9, 5, 12);
    expect_diag_code_span(src, "PAR-0236", 0, 6, 9, 6, 10);
    expect_diag_code_span(src, "PAR-0236", 1, 7, 9, 7, 13);
}

/**
 * Tests that byte literal case-arm diagnostics include quote delimiters in spans.
 */
func test_case_default_recovery_byte_literal_span() {
    let src = "module main;\n" +
