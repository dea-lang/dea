/**
 * Tests that `is(value, Variant)` parses as an ordinary call with a bare variant argument.
 */
func test_is_intrinsic_payload_variant_arg_shape() {
    let src = "module main; enum Color { Red; RGB(r: int, g: int, b: int); } func main(c: Color) -> bool { return is(c, RGB); }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected parse to succeed");
    assert(result.root_module != null, "Expected parsed module");

    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 1) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;
    let body = stmt_arena_get(result.stmt_arena, func_decl.body);
    let stmts = body.ids as VectorBase*;
    let return_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 0));
    let call = expr_arena_get(result.expr_arena, return_stmt.expr_a);
    assert(ord(call.kind) == ord(EX_CALL), "Expected `is` call expression");

    let callee = expr_arena_get(result.expr_arena, call.expr_a);
    assert(ord(callee.kind) == ord(EX_VAR_REF), "Expected `is` callee to be a plain identifier");
    assert(callee.text_value == "is", "Expected `is` callee name");
    assert(call.ids != null && vec_size(call.ids as VectorBase*) == 2, "Expected two `is` arguments");

    let variant_arg = expr_arena_get(result.expr_arena, id_vec_get(call.ids as VectorBase*, 1));
    assert(ord(variant_arg.kind) == ord(EX_VAR_REF), "Expected payload variant argument to stay a bare var-ref");
    assert(variant_arg.text_value == "RGB", "Expected payload variant argument name");

    parse_result_free(result);
}

/**
 * Tests that `is(call_expr, module::Variant)` preserves both call and qualified-variant shape.
 */
func test_is_intrinsic_call_and_qualified_variant_shape() {
    let src = "module main; import config.types; func main() -> bool { return is(config.types::get_key(), config.types::String); }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected parse to succeed");
    assert(result.root_module != null, "Expected parsed module");

    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 0) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;
    let body = stmt_arena_get(result.stmt_arena, func_decl.body);
    let stmts = body.ids as VectorBase*;
    let return_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 0));
    let call = expr_arena_get(result.expr_arena, return_stmt.expr_a);
    assert(ord(call.kind) == ord(EX_CALL), "Expected outer `is` call expression");
    assert(call.ids != null && vec_size(call.ids as VectorBase*) == 2, "Expected two `is` arguments");

    let first_arg = expr_arena_get(result.expr_arena, id_vec_get(call.ids as VectorBase*, 0));
    assert(ord(first_arg.kind) == ord(EX_CALL), "Expected first `is` argument to remain a call expression");

    let second_arg = expr_arena_get(result.expr_arena, id_vec_get(call.ids as VectorBase*, 1));
    assert(ord(second_arg.kind) == ord(EX_VAR_REF), "Expected second `is` argument to remain a var-ref");
    assert(second_arg.module_path != null, "Expected qualified variant module path");
    assert(sv_size(second_arg.module_path as StringVector*) == 2, "Expected two module-path segments");
    assert(sv_get(second_arg.module_path as StringVector*, 0) == "config", "Expected first module-path segment");
    assert(sv_get(second_arg.module_path as StringVector*, 1) == "types", "Expected second module-path segment");
    assert(second_arg.text_value == "String", "Expected qualified variant name");

    parse_result_free(result);
}

/**
 * Tests single-statement loop bodies, match arms, and the existing `case` arm precedent.
 */
func test_single_statement_loop_and_match_bodies_ok() {
    let src = "module main; enum Color { Red; Green; } func main(x: int, c: Color) -> int { while (x < 3) x = x + 1; for (; x < 4; x = x + 1) x = x + 2; match (c) { Red => return 1; _ => return 2; } case (x) { 0 => return 3; else return 4; } }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected parse to succeed");
    assert(result.root_module != null, "Expected parsed module");

    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 1) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;
    let body = stmt_arena_get(result.stmt_arena, func_decl.body);
    let stmts = body.ids as VectorBase*;
    assert(vec_size(stmts) == 4, "Expected four top-level statements in function body");

    let while_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 0));
    assert(ord(while_stmt.kind) == ord(ST_WHILE), "Expected while statement");
    let while_body = stmt_arena_get(result.stmt_arena, while_stmt.stmt_a);
    assert(ord(while_body.kind) == ord(ST_ASSIGN), "Expected single assignment while body");

    let for_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 1));
    assert(ord(for_stmt.kind) == ord(ST_FOR), "Expected for statement");
    let for_body = stmt_arena_get(result.stmt_arena, for_stmt.stmt_c);
    assert(ord(for_body.kind) == ord(ST_ASSIGN), "Expected single assignment for body");

    let match_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 2));
    assert(ord(match_stmt.kind) == ord(ST_MATCH), "Expected match statement");
    let match_arms = match_stmt.match_arms as VectorBase*;
    assert(vec_size(match_arms) == 2, "Expected two match arms");
    assert(ord(stmt_arena_get(result.stmt_arena, (ptr_vec_get(match_arms, 0) as MatchArm*).body).kind) == ord(ST_RETURN),
        "Expected single return in first match arm");
    assert(ord(stmt_arena_get(result.stmt_arena, (ptr_vec_get(match_arms, 1) as MatchArm*).body).kind) == ord(ST_RETURN),
        "Expected single return in wildcard match arm");

    let case_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 3));
    assert(ord(case_stmt.kind) == ord(ST_CASE), "Expected case statement");
    assert(ord(stmt_arena_get(result.stmt_arena, (ptr_vec_get(case_stmt.case_arms as VectorBase*, 0) as CaseArm*).body).kind) ==
        ord(ST_RETURN), "Expected single return in case arm");
    assert(ord(stmt_arena_get(result.stmt_arena, (case_stmt.case_else as CaseElse*).body).kind) == ord(ST_RETURN),
        "Expected single return in case else arm");

    parse_result_free(result);
}

/**
 * Tests test_top_level_multi_error_collection.
 */
func test_top_level_multi_error_collection() {
    let src = "module main; struct Broken { x: 123; } type T = int func good() -> int { return 0; }";
    expect_min_error_count(src, 2);
}

