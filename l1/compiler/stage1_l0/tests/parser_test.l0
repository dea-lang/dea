    test_case_wildcard_missing_arrow_error();
    test_case_ambiguous_if_else_error();
    test_case_default_arm_if_else_body_ok();
    test_case_default_recovery_stays_inside_case();
    test_case_default_recovery_byte_literal_span();
    test_expr_precedence_postfix_and_qualified_type_ok();
    test_prefixed_int_literals_ok();
    test_prefixed_int_literals_err();
    test_postfix_chain_ok();
    test_type_expr_call_arg_ok();
