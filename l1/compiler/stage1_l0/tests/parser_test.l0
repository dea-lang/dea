/**
 * Parses source and asserts that the first diagnostic matches `expected`.
 *
 * @param source The module source to parse.
 * @param expected The expected diagnostic code.
 */
func expect_error_code(source: string, expected: string) {
    let result = parse_module_source(source, "<test>");
    if (!parse_has_errors(result)) {
        assert(false, "Expected parse error " + expected + " but parse succeeded");
    }
    if (parse_diag_count(result) < 1) {
        assert(false, "Expected at least one diagnostic");
    }

    let diag = parse_diag_get(result, 0);
    if (diag.code != expected) {
        printl_ss("actual error code:", diag.code);
        assert(false, "Expected parse error code " + expected);
    }

    parse_result_free(result);
}

/**
 * Parses source and asserts that the first diagnostic matches code and message.
 *
 * @param source The module source to parse.
 * @param expected_code The expected diagnostic code.
 * @param expected_message The expected diagnostic message text.
 */
func expect_error_code_and_message(source: string, expected_code: string, expected_message: string) {
    let result = parse_module_source(source, "<test>");
    if (!parse_has_errors(result)) {
        assert(false, "Expected parse error " + expected_code + " but parse succeeded");
    }
    if (parse_diag_count(result) < 1) {
        assert(false, "Expected at least one diagnostic");
    }

    let diag = parse_diag_get(result, 0);
    if (diag.code != expected_code) {
        printl_ss("actual error code:", diag.code);
        assert(false, "Expected parse error code " + expected_code);
    }
    if (diag.message != expected_message) {
        printl_ss("actual error message:", diag.message);
        assert(false, "Expected parse error message " + expected_message);
    }

    parse_result_free(result);
}

/**
 * Parses source and asserts that it succeeds without diagnostics.
 *
 * @param source The module source to parse.
 */
func expect_ok(source: string) {
    let result = parse_module_source(source, "<test>");
    if (parse_has_errors(result)) {
        if (parse_diag_count(result) > 0) {
            let diag = parse_diag_get(result, 0);
            printl_ss("unexpected parse error code:", diag.code);
            printl_ss("unexpected parse error message:", diag.message);
        }
        assert(false, "Expected parse to succeed");
    }
    assert(result.root_module != null, "Expected module for successful parse");

    parse_result_free(result);
}

/**
 * Parses source and asserts that at least `expected_min` diagnostics are reported.
 *
 * @param source The module source to parse.
 * @param expected_min The minimum number of diagnostics expected.
 */
func expect_min_error_count(source: string, expected_min: int) {
    let result = parse_module_source(source, "<test>");
    if (!parse_has_errors(result)) {
        assert(false, "Expected parse errors");
    }
    let count = parse_diag_count(result);
    if (count < expected_min) {
        printl_si("actual error count:", count);
        assert(false, "Expected more parse diagnostics");
    }
    parse_result_free(result);
}

/**
 * Tests that parser diagnostic messages do not duplicate their structured code.
 */
func test_parser_message_omits_embedded_code() {
    let result = parse_module_source("module main; import std.io as ;", "./hello.l1");
    assert(parse_has_errors(result), "Expected parse error");
    let diag = parse_diag_get(result, 0);
    assert(diag.code == "PAR-0547", "Expected alias diagnostic code");
    assert(!starts_with_s(diag.message, "[PAR-0547]"), "Parser message should not embed its diagnostic code");
    parse_result_free(result);
}

/**
 * Tests array-type syntax length diagnostics.
 */
func test_array_type_syntax_message() {
    let src = "module main; func main() -> int { let x: int[] = 0; return x; }";
    expect_error_code_and_message(src, "PAR-0620", "expected integer length in array type");
}

/**
 * Tests array literal and array constructor delimiter diagnostics.
 */
func test_array_expr_syntax_messages() {
    expect_error_code(
        "module main; func main() -> int { let x: int[2] = [1, 2; return 0; }",
        "PAR-0622");
    expect_error_code(
        "module main; func main() -> int { let x = int[2](1, 2; return 0; }",
        "PAR-0623");
}

/**
 * Tests fixed-size array type suffixes, literals, and constructors parse.
 */
func test_fixed_array_syntax_ok() {
    let src = "module main; func main(p: int*[2], q: int[2]*) -> int { let a: int[2][3] = [[1, 2, 3], [4, 5, 6]]; let b = int[3]([1]); let c = int[3](7); return a[1][2] + b[0] + c[1]; }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected fixed-size array syntax to parse");
    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 0) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;
    let param0 = ptr_vec_get(func_decl.params, 0) as Param*;
    assert(param0.type_ref.suffixes != null, "Expected ordered suffixes on int*[2]");
    assert(vec_size(param0.type_ref.suffixes as VectorBase*) == 2, "Expected two suffixes on int*[2]");
    let suffix0 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 0) as TypeSuffix*;
    let suffix1 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 1) as TypeSuffix*;
    assert(ord(suffix0.kind) == ord(TS_POINTER), "Expected pointer suffix first");
    assert(ord(suffix1.kind) == ord(TS_ARRAY), "Expected array suffix second");
    assert(suffix1.array_len == 2, "Expected array length 2");
    parse_result_free(result);
}

/**
 * Tests mixed array and pointer suffixes keep source order.
 */
func test_fixed_array_complex_suffix_order_ok() {
    let src = "module main; func main(p: string[10]*[20]*[30]) -> int { return 0; }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected complex fixed-size array suffix syntax to parse");
    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 0) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;
    let param0 = ptr_vec_get(func_decl.params, 0) as Param*;
    assert(param0.type_ref.suffixes != null, "Expected ordered suffixes on string[10]*[20]*[30]");
    assert(vec_size(param0.type_ref.suffixes as VectorBase*) == 5,
        "Expected five suffixes on string[10]*[20]*[30]");
    let suffix0 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 0) as TypeSuffix*;
    let suffix1 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 1) as TypeSuffix*;
    let suffix2 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 2) as TypeSuffix*;
    let suffix3 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 3) as TypeSuffix*;
    let suffix4 = ptr_vec_get(param0.type_ref.suffixes as VectorBase*, 4) as TypeSuffix*;
    assert(ord(suffix0.kind) == ord(TS_ARRAY) && suffix0.array_len == 10, "Expected [10] first");
    assert(ord(suffix1.kind) == ord(TS_POINTER), "Expected pointer second");
    assert(ord(suffix2.kind) == ord(TS_ARRAY) && suffix2.array_len == 20, "Expected [20] third");
    assert(ord(suffix3.kind) == ord(TS_POINTER), "Expected pointer fourth");
    assert(ord(suffix4.kind) == ord(TS_ARRAY) && suffix4.array_len == 30, "Expected [30] fifth");
    parse_result_free(result);
}

/**
 * Tests pointer and nullable type suffixes keep source order.
 */
func test_ordered_pointer_nullable_suffix_syntax_ok() {
    let src = "module main; func main(a: int??, b: int?*, c: int*?*?, d: int?*?*?) -> int { return 0; }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected ordered pointer/nullable suffix syntax to parse");
    let root = result.root_module as Module*;
    let top = ptr_vec_get(root.decls, 0) as TopLevelDecl*;
    let func_decl = top.data as FuncDecl*;

    let a = ptr_vec_get(func_decl.params, 0) as Param*;
    assert(a.type_ref.suffixes != null, "Expected suffixes on int??");
    assert(vec_size(a.type_ref.suffixes as VectorBase*) == 2, "Expected two suffixes on int??");
    assert(ord((ptr_vec_get(a.type_ref.suffixes as VectorBase*, 0) as TypeSuffix*).kind) == ord(TS_NULLABLE),
        "Expected first suffix on int?? to be nullable");
    assert(ord((ptr_vec_get(a.type_ref.suffixes as VectorBase*, 1) as TypeSuffix*).kind) == ord(TS_NULLABLE),
        "Expected second suffix on int?? to be nullable");

    let b = ptr_vec_get(func_decl.params, 1) as Param*;
    assert(ord((ptr_vec_get(b.type_ref.suffixes as VectorBase*, 0) as TypeSuffix*).kind) == ord(TS_NULLABLE),
        "Expected first suffix on int?* to be nullable");
    assert(ord((ptr_vec_get(b.type_ref.suffixes as VectorBase*, 1) as TypeSuffix*).kind) == ord(TS_POINTER),
        "Expected second suffix on int?* to be pointer");

    let c = ptr_vec_get(func_decl.params, 2) as Param*;
    assert(vec_size(c.type_ref.suffixes as VectorBase*) == 4, "Expected four suffixes on int*?*?");
    assert(ord((ptr_vec_get(c.type_ref.suffixes as VectorBase*, 0) as TypeSuffix*).kind) == ord(TS_POINTER),
        "Expected int*?*? suffix 0");
    assert(ord((ptr_vec_get(c.type_ref.suffixes as VectorBase*, 1) as TypeSuffix*).kind) == ord(TS_NULLABLE),
        "Expected int*?*? suffix 1");
    assert(ord((ptr_vec_get(c.type_ref.suffixes as VectorBase*, 2) as TypeSuffix*).kind) == ord(TS_POINTER),
        "Expected int*?*? suffix 2");
    assert(ord((ptr_vec_get(c.type_ref.suffixes as VectorBase*, 3) as TypeSuffix*).kind) == ord(TS_NULLABLE),
        "Expected int*?*? suffix 3");

    parse_result_free(result);
}

/**
 * Tests indexed values in call arguments are not parsed as type expressions.
 */
func test_call_argument_indexing_is_value_expr() {
    let src = "module main; func add(a: int, b: int) -> int { return a + b; } func main() -> int { let a: int[2] = [1, 2]; return add(a[0], a[1]); }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected indexed call arguments to parse as expressions");
    let root = result.root_module as Module*;
    let main_top = ptr_vec_get(root.decls, 1) as TopLevelDecl*;
    let main_decl = main_top.data as FuncDecl*;
    let body = stmt_arena_get(result.stmt_arena, main_decl.body);
    let stmts = body.ids as VectorBase*;
    let ret_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 1));
    let call = expr_arena_get(result.expr_arena, ret_stmt.expr_a);
    assert(ord(call.kind) == ord(EX_CALL), "Expected return expression to be a call");
    let args = call.ids as VectorBase*;
    assert(ord(expr_arena_get(result.expr_arena, id_vec_get(args, 0)).kind) == ord(EX_INDEX),
        "Expected first call argument to be an index expression");
    assert(ord(expr_arena_get(result.expr_arena, id_vec_get(args, 1)).kind) == ord(EX_INDEX),
        "Expected second call argument to be an index expression");
    parse_result_free(result);
}

/**
 * Tests dotted field expressions with try suffix are not parsed as type expressions.
 */
func test_call_argument_field_try_is_value_expr() {
    let src = "module main; func use(x: int?) -> int? { return x; } func main() -> int? { return use(a.b?); }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected dotted try call argument to parse as an expression");
    let root = result.root_module as Module*;
    let main_top = ptr_vec_get(root.decls, 1) as TopLevelDecl*;
    let main_decl = main_top.data as FuncDecl*;
    let body = stmt_arena_get(result.stmt_arena, main_decl.body);
    let stmts = body.ids as VectorBase*;
    let ret_stmt = stmt_arena_get(result.stmt_arena, id_vec_get(stmts, 0));
    let call = expr_arena_get(result.expr_arena, ret_stmt.expr_a);
    assert(ord(call.kind) == ord(EX_CALL), "Expected return expression to be a call");
    let args = call.ids as VectorBase*;
    let arg0 = expr_arena_get(result.expr_arena, id_vec_get(args, 0));
    assert(ord(arg0.kind) == ord(EX_TRY), "Expected call argument to be a try expression");
    assert(ord(expr_arena_get(result.expr_arena, arg0.expr_a).kind) == ord(EX_FIELD),
        "Expected try payload to be a field expression");
    parse_result_free(result);
}

/**
 * Tests test_valid_module.
