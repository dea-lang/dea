func test_valid_module() {
    let src = "module main; import std.io; func add(a: int, b: int) -> int { return 0; }";
    expect_ok(src);
}

/**
 * Tests export manifests and new import forms.
 */
func test_export_and_new_import_forms_ok() {
    let src = "module main; export foo, Bar; import math as m; import abs, pi from math; func foo() -> int { return 0; } struct Bar { x: int; }";
    let result = parse_module_source(src, "<test>");
    if (parse_has_errors(result)) {
        let diag = parse_diag_get(result, 0);
        printl_ss("unexpected parse error code:", diag.code);
        printl_ss("unexpected parse error message:", diag.message);
        assert(false, "Expected parse to succeed");
    }
    assert(result.root_module != null, "Expected parsed module");
    let root = result.root_module as Module*;
    assert(root.export_manifest != null, "Expected explicit export manifest");
    let manifest = root.export_manifest as ExportManifest*;
    assert(!manifest.export_all, "Expected export allowlist");
    assert(sv_size(manifest.names) == 2, "Expected two exported names");
    assert(sv_get(manifest.names, 0) == "foo", "Expected first exported name");
    assert(sv_get(manifest.names, 1) == "Bar", "Expected second exported name");
    assert(vec_size(root.imports) == 2, "Expected two imports");
    let alias_imp = ptr_vec_get(root.imports, 0) as Import*;
    assert(ord(alias_imp.kind) == ord(IMPORT_ALIAS), "Expected alias import");
    assert(alias_imp.name == "math", "Expected alias import module name");
    assert(alias_imp.alias == "m", "Expected import alias");
    let selective_imp = ptr_vec_get(root.imports, 1) as Import*;
    assert(ord(selective_imp.kind) == ord(IMPORT_SELECTIVE), "Expected selective import");
    assert(selective_imp.names != null, "Expected selective import names");
    assert(sv_size(selective_imp.names as StringVector*) == 2, "Expected two selective imports");
    assert(sv_get(selective_imp.names as StringVector*, 0) == "abs", "Expected first selective import");
    assert(sv_get(selective_imp.names as StringVector*, 1) == "pi", "Expected second selective import");
    parse_result_free(result);
}

/**
 * Tests star export syntax.
 */
func test_export_star_ok() {
    let src = "module main; export *; func foo() -> int { return 0; }";
    let result = parse_module_source(src, "<test>");
    assert(!parse_has_errors(result), "Expected export star parse success");
    assert(result.root_module != null, "Expected parsed module");
    let root = result.root_module as Module*;
    assert(root.export_manifest != null, "Expected explicit export manifest");
    assert((root.export_manifest as ExportManifest*).export_all, "Expected star export manifest");
    parse_result_free(result);
}

