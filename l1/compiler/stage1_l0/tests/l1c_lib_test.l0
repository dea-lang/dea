/**
 * Tests `--emit-interface --output` writes deterministic `.l1m` text.
 */
func test_emit_interface_output_file() {
    let out_path = interface_output_path();
    rt_delete_file(out_path);

    with (let argv = sv_create(10) => sv_free(argv)) {
        sv_push(argv, "--emit-interface");
        sv_push(argv, "-P");
        sv_push(argv, interface_fixture_root());
        sv_push(argv, "--output");
        sv_push(argv, out_path);
        sv_push(argv, "iface_demo");

        let rc = run_with_argv(argv);
        assert(rc == 0, "--emit-interface --output should succeed for iface_demo");
    }

    let text = read_file(out_path);
    assert(text != null, "interface output file should exist");
    assert(contains_s(text as string, "module interface iface_demo;\nfingerprint \"\";\n"), "interface header missing");
    assert(contains_s(text as string, "struct Point {\n  x: int;\n  y: int;\n} == \"\";"), "exported struct missing");
    assert(contains_s(text as string, "func area(s: Size) -> int == \"\";"), "exported function missing");
    assert(!contains_s(text as string, "helper"), "private helper must not be emitted");

    rt_delete_file(out_path);
}

/**
 * Tests test_gen_trace_defines.
 */
func test_gen_trace_defines() {
    let out_path = gen_output_path();
    rt_delete_file(out_path);

    with (let argv = sv_create(12) => sv_free(argv)) {
        sv_push(argv, "--gen");
        sv_push(argv, "--no-line-directives");
        sv_push(argv, "--trace-arc");
        sv_push(argv, "--trace-memory");
        sv_push(argv, "-P");
        sv_push(argv, fixture_root());
        sv_push(argv, "--output");
        sv_push(argv, out_path);
        sv_push(argv, "ok_main");

        let rc = run_with_argv(argv);
        assert(rc == 0, "--gen with trace flags should succeed");
    }

    let c_text = read_file(out_path);
    assert(c_text != null, "generated C output file should exist for trace test");
    assert(!contains_s(c_text as string, "#define DEA_TRACE_ARC 1"), "trace ARC define should not be emitted");
    assert(!contains_s(c_text as string, "#define DEA_TRACE_MEMORY 1"), "trace memory define should not be emitted");
    assert(contains_s(c_text as string, "#include \"dea_rt.h\""), "public runtime include missing");

    rt_delete_file(out_path);
}

