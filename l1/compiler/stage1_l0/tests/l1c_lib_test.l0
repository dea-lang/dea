/**
 * Tests test_check_ok.
 */
func test_check_ok() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "-P");
        sv_push(argv, fixture_root());
        sv_push(argv, "ok_main");

        let rc = run_with_argv(argv);
        assert(rc == 0, "--check should succeed for ok_main");
    }
}

