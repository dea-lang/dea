/** Return whether one diagnostic collector contains a requested code. */
func ldt_has_code(diags: DiagCollector*, code: string) -> bool {
    for (let i = 0; i < diag_count(diags); i = i + 1) {
        if (diag_get(diags, i).code == code) {
            return true;
        }
    }
    return false;
}

/** Return whether one command-word vector contains an exact word. */
func ldt_has_word(words: StringVector*, expected: string) -> bool {
    for (let i = 0; i < sv_size(words); i = i + 1) {
        if (sv_get(words, i) == expected) {
            return true;
        }
    }
    return false;
}

/** Construct one empty format-neutral container for synthetic inspections. */
func ldt_container() -> ObjectContainer* {
    return new ObjectContainer(
        OBJECT_FORMAT_ELF,
        "",
        vec_create(sizeof(void*), 1),
        OBJECT_LINKER_CONTROL_NONE
    );
}

/** Construct one valid synthetic Dea-object inspection. */
func ldt_dea_inspection(
    module_name: string,
    fingerprint: string,
    imports: StringVector*,
    import_fingerprints: StringVector*,
    has_entry: bool
) -> ObjectInspection* {
    let valid = new ValidDeaMetadata(
        module_name,
        fingerprint,
        imports,
        import_fingerprints,
        has_entry
    );
    return new ObjectInspection(
        OBJECT_FORMAT_ELF,
        false,
        new ObjectMetadataClassification(
            VALID_DEA_METADATA, valid, ""),
        ldt_container()
    );
}

/** Construct one metadata-free synthetic foreign-object inspection. */
func ldt_foreign_inspection(defines_main: bool) -> ObjectInspection* {
    return new ObjectInspection(
        OBJECT_FORMAT_ELF,
        defines_main,
        new ObjectMetadataClassification(
            NO_DEA_METADATA, null, ""),
        ldt_container()
    );
}

/** Construct one malformed-metadata synthetic inspection. */
func ldt_malformed_inspection(reason: string) -> ObjectInspection* {
    return new ObjectInspection(
        OBJECT_FORMAT_ELF,
        false,
        new ObjectMetadataClassification(
            MALFORMED_DEA_METADATA, null, reason),
        ldt_container()
    );
}

/** Construct one dependency-free synthetic Dea link input. */
func ldt_dea_input(
    module_name: string,
    fingerprint: string,
    has_entry: bool
) -> LinkInput* {
    return ld_input_create(
        LOK_DEA_OBJECT,
        module_name + ".o",
        ldt_dea_inspection(
            module_name,
            fingerprint,
            sv_create(1),
            sv_create(1),
            has_entry
        )
    );
}

/** Construct one synthetic Dea link input with one direct provider. */
func ldt_dea_input_with_import(
    module_name: string,
    fingerprint: string,
    has_entry: bool,
    provider_name: string,
    provider_fingerprint: string
) -> LinkInput* {
    let imports = sv_create(1);
    let fingerprints = sv_create(1);
    sv_push(imports, provider_name);
    sv_push(fingerprints, provider_fingerprint);
    return ld_input_create(
        LOK_DEA_OBJECT,
        module_name + ".o",
        ldt_dea_inspection(
            module_name,
            fingerprint,
            imports,
            fingerprints,
            has_entry
        )
    );
}

/** Build a mixed valid plan with an entry component and a disconnected CU. */
func ldt_valid_mixed_plan(diags: DiagCollector*) -> LinkPlan*? {
    let inputs = ld_ptr_vec_create(5);
    ld_ptr_vec_push(inputs, ldt_dea_input_with_import(
        "app.main", "sip13:aaaaaaaaaaaaaaaa", true,
        "app.dep", "sip13:bbbbbbbbbbbbbbbb") as void*);
    ld_ptr_vec_push(inputs, ld_input_create(
        LOK_FOREIGN_OBJECT, "foreign.o",
        ldt_foreign_inspection(false)) as void*);
    ld_ptr_vec_push(inputs, ldt_dea_input_with_import(
        "side.effect", "sip13:dddddddddddddddd", false,
        "app.leaf", "sip13:cccccccccccccccc") as void*);
    ld_ptr_vec_push(inputs, ldt_dea_input_with_import(
        "app.dep", "sip13:bbbbbbbbbbbbbbbb", false,
        "app.leaf", "sip13:cccccccccccccccc") as void*);
    ld_ptr_vec_push(inputs, ldt_dea_input(
        "app.leaf", "sip13:cccccccccccccccc", false) as void*);
    return ld_prepare_inputs(inputs, null, diags);
}

/** Verify graph validation and deterministic lifecycle ordering. */
func test_valid_mixed_plan_ordering() {
    with (let diags = diag_create() => diag_free(diags)) {
        let plan_opt = ldt_valid_mixed_plan(diags);
        assert(plan_opt != null, "complete mixed link set should validate");
        let plan = plan_opt as LinkPlan*;

        assert(plan.entry_module == "app.main", "entry inference mismatch");
        assert(sv_size(plan.lifecycle_order) == 4,
            "foreign object must not enter lifecycle order");
        assert(sv_get(plan.lifecycle_order, 0) == "app.leaf",
            "leaf dependency must initialize first");
        assert(sv_get(plan.lifecycle_order, 1) == "app.dep",
            "direct dependency must precede entry");
        assert(sv_get(plan.lifecycle_order, 2) == "app.main",
            "entry must follow its dependency closure");
        assert(sv_get(plan.lifecycle_order, 3) == "side.effect",
            "disconnected explicit CU must follow the entry component");
        assert(vec_size(plan.inputs) == 5, "every typed input must remain present");
        assert(ld_plan_input_get(plan, 1).path == "foreign.o",
            "foreign input encounter order must be retained");
        ld_plan_free(plan);
    }
}

/** Verify duplicate, missing-provider, fingerprint, and cycle rejection. */
func test_graph_failures() {
    with (let duplicate_diags = diag_create() => diag_free(duplicate_diags)) {
        let duplicate = ld_ptr_vec_create(2);
        ld_ptr_vec_push(duplicate, ldt_dea_input(
            "dup", "sip13:1111111111111111", true) as void*);
        ld_ptr_vec_push(duplicate, ldt_dea_input(
            "dup", "sip13:2222222222222222", false) as void*);
        assert(ld_prepare_inputs(duplicate, null, duplicate_diags) == null,
            "duplicate module identities must fail");
        assert(ldt_has_code(duplicate_diags, "L1C-2100"),
            "duplicate module diagnostic mismatch");
    }

    with (let missing_diags = diag_create() => diag_free(missing_diags)) {
        let missing = ld_ptr_vec_create(1);
        ld_ptr_vec_push(missing, ldt_dea_input_with_import(
            "app", "sip13:1111111111111111", true,
            "missing", "sip13:2222222222222222") as void*);
        assert(ld_prepare_inputs(missing, null, missing_diags) == null,
            "missing provider must fail");
        assert(ldt_has_code(missing_diags, "L1C-2101"),
            "missing provider diagnostic mismatch");
    }

    with (let stale_diags = diag_create() => diag_free(stale_diags)) {
        let stale = ld_ptr_vec_create(2);
        ld_ptr_vec_push(stale, ldt_dea_input_with_import(
            "app", "sip13:1111111111111111", true,
            "dep", "sip13:2222222222222222") as void*);
        ld_ptr_vec_push(stale, ldt_dea_input(
            "dep", "sip13:3333333333333333", false) as void*);
        assert(ld_prepare_inputs(stale, null, stale_diags) == null,
            "provider fingerprint mismatch must fail");
        assert(ldt_has_code(stale_diags, "L1C-2102"),
            "fingerprint diagnostic mismatch");
    }

    with (let cycle_diags = diag_create() => diag_free(cycle_diags)) {
        let cycle = ld_ptr_vec_create(2);
        ld_ptr_vec_push(cycle, ldt_dea_input_with_import(
            "cycle.a", "sip13:1111111111111111", true,
            "cycle.b", "sip13:2222222222222222") as void*);
        ld_ptr_vec_push(cycle, ldt_dea_input_with_import(
            "cycle.b", "sip13:2222222222222222", false,
            "cycle.a", "sip13:1111111111111111") as void*);
        assert(ld_prepare_inputs(cycle, null, cycle_diags) == null,
            "dependency cycle must fail");
        assert(ldt_has_code(cycle_diags, "L1C-2103"),
            "cycle diagnostic mismatch");
        assert(contains_s(
            diag_get(cycle_diags, 0).message,
            "cycle.a -> cycle.b -> cycle.a"),
            "cycle diagnostic must use canonical module chain");
    }
}

/** Verify a deep valid graph does not consume the native call stack. */
func test_deep_graph_uses_iterative_traversal() {
    let module_count = 10000;
    let fingerprint = "sip13:1111111111111111";
    with (let diags = diag_create() => diag_free(diags)) {
        let inputs = ld_ptr_vec_create(module_count);
        for (let i = 0; i < module_count; i = i + 1) {
            let module_name = "deep." + int_to_string(i);
            if (i + 1 < module_count) {
                ld_ptr_vec_push(inputs, ldt_dea_input_with_import(
                    module_name,
                    fingerprint,
                    i == 0,
                    "deep." + int_to_string(i + 1),
                    fingerprint
                ) as void*);
            } else {
                ld_ptr_vec_push(inputs, ldt_dea_input(
                    module_name,
                    fingerprint,
                    false
                ) as void*);
            }
        }

        let plan_opt = ld_prepare_inputs(inputs, null, diags);
        assert(plan_opt != null,
            "10,000-module dependency chain should validate");
        let plan = plan_opt as LinkPlan*;
        assert(sv_size(plan.lifecycle_order) == module_count,
            "deep dependency chain lifecycle size mismatch");
        assert(sv_get(plan.lifecycle_order, 0) == "deep.9999",
            "deepest dependency must initialize first");
        assert(sv_get(plan.lifecycle_order, module_count - 1) == "deep.0",
            "entry must initialize after its deep dependency closure");
        ld_plan_free(plan);
    }
}

/** Verify inferred and explicit entry selection. */
func test_entry_selection() {
    with (let zero_diags = diag_create() => diag_free(zero_diags)) {
        let zero = ld_ptr_vec_create(1);
        ld_ptr_vec_push(zero, ldt_dea_input(
            "library", "sip13:1111111111111111", false) as void*);
        assert(ld_prepare_inputs(zero, null, zero_diags) == null,
            "zero entry candidates must fail");
        assert(ldt_has_code(zero_diags, "L1C-2104"),
            "zero entry diagnostic mismatch");
    }

    with (let multiple_diags = diag_create() => diag_free(multiple_diags)) {
        let multiple = ld_ptr_vec_create(2);
        ld_ptr_vec_push(multiple, ldt_dea_input(
            "z.entry", "sip13:1111111111111111", true) as void*);
        ld_ptr_vec_push(multiple, ldt_dea_input(
            "a.entry", "sip13:2222222222222222", true) as void*);
        assert(ld_prepare_inputs(multiple, null, multiple_diags) == null,
            "multiple inferred entries must fail");
        assert(contains_s(
            diag_get(multiple_diags, 0).message,
            "a.entry, z.entry"),
            "multiple entry candidates must be listed deterministically");
    }

    with (let explicit_diags = diag_create() => diag_free(explicit_diags)) {
        let explicit = ld_ptr_vec_create(2);
        ld_ptr_vec_push(explicit, ldt_dea_input(
            "z.entry", "sip13:1111111111111111", true) as void*);
        ld_ptr_vec_push(explicit, ldt_dea_input(
            "a.entry", "sip13:2222222222222222", true) as void*);
        let plan = ld_prepare_inputs(explicit, "z.entry", explicit_diags);
        assert(plan != null, "explicit entry should select one valid candidate");
        assert((plan as LinkPlan*).entry_module == "z.entry",
            "explicit entry mismatch");
        ld_plan_free(plan as LinkPlan*);
    }
}

/** Verify strict Dea/foreign classification boundaries. */
func test_classification_failures() {
    with (let positional_diags = diag_create() => diag_free(positional_diags)) {
        let positional = ld_ptr_vec_create(1);
        ld_ptr_vec_push(positional, ld_input_create(
            LOK_DEA_OBJECT, "plain.o",
            ldt_foreign_inspection(false)) as void*);
        assert(ld_prepare_inputs(positional, null, positional_diags) == null,
            "metadata-free positional input must fail");
        assert(ldt_has_code(positional_diags, "L1C-2098"),
            "positional classification diagnostic mismatch");
        assert(contains_s(
            diag_get(positional_diags, 0).message, "--foreign-object"),
            "positional metadata-free guidance mismatch");
    }

    with (let foreign_dea_diags = diag_create() => diag_free(foreign_dea_diags)) {
        let foreign_dea = ld_ptr_vec_create(1);
        let dea = ldt_dea_input(
            "app", "sip13:1111111111111111", true);
        dea.kind = LOK_FOREIGN_OBJECT;
        ld_ptr_vec_push(foreign_dea, dea as void*);
        assert(ld_prepare_inputs(foreign_dea, null, foreign_dea_diags) == null,
            "verified Dea object must not pass as foreign");
        assert(ldt_has_code(foreign_dea_diags, "L1C-2098"),
            "foreign Dea classification diagnostic mismatch");
    }

    with (let malformed_diags = diag_create() => diag_free(malformed_diags)) {
        let malformed = ld_ptr_vec_create(1);
        ld_ptr_vec_push(malformed, ld_input_create(
            LOK_FOREIGN_OBJECT, "malformed.o",
            ldt_malformed_inspection("bad record")) as void*);
        assert(ld_prepare_inputs(malformed, null, malformed_diags) == null,
            "malformed Dea evidence must not pass as foreign");
        assert(contains_s(
            diag_get(malformed_diags, 0).message, "bad record"),
            "malformed metadata reason must be retained");
    }

    with (let main_diags = diag_create() => diag_free(main_diags)) {
        let foreign_main = ld_ptr_vec_create(2);
        ld_ptr_vec_push(foreign_main, ldt_dea_input(
            "app", "sip13:1111111111111111", true) as void*);
        ld_ptr_vec_push(foreign_main, ld_input_create(
            LOK_FOREIGN_OBJECT, "main.o",
            ldt_foreign_inspection(true)) as void*);
        assert(ld_prepare_inputs(foreign_main, null, main_diags) == null,
            "foreign process main must fail");
        assert(ldt_has_code(main_diags, "L1C-2099"),
            "foreign main diagnostic mismatch");
    }
}

/** Verify embedded linker controls fail before any module registration. */
func test_embedded_linker_control_failures() {
    with (let diags = diag_create() => diag_free(diags)) {
        let inputs = ld_ptr_vec_create(2);
        let dea = ldt_dea_input(
            "app", "sip13:1111111111111111", true);
        let foreign_inspection = ldt_foreign_inspection(false);
        foreign_inspection.container.linker_control =
            OBJECT_LINKER_CONTROL_PECOFF_DRECTVE;
        ld_ptr_vec_push(inputs, dea as void*);
        ld_ptr_vec_push(inputs, ld_input_create(
            LOK_FOREIGN_OBJECT, "directives.obj",
            foreign_inspection) as void*);

        let plan = new LinkPlan(
            inputs, spm_create(), sv_create(2), "");
        assert(!ld_classify_inputs(plan, diags),
            "object-embedded linker controls must fail classification");
        assert(ldt_has_code(diags, "L1C-2110"),
            "embedded linker-control diagnostic mismatch");
        assert(contains_s(
                diag_get(diags, 0).message, "PE/COFF .drectve"),
            "embedded linker-control carrier must be identified");
        assert(!spm_has(plan.modules_by_name, "app"),
            "linker-control preflight must precede module registration");
        ld_plan_free(plan);
    }

    with (let dea_diags = diag_create() => diag_free(dea_diags)) {
        let dea_inputs = ld_ptr_vec_create(1);
        let controlled_dea = ldt_dea_input(
            "controlled", "sip13:2222222222222222", true);
        controlled_dea.inspection.container.linker_control =
            OBJECT_LINKER_CONTROL_MACHO_LINKER_OPTION;
        ld_ptr_vec_push(dea_inputs, controlled_dea as void*);
        assert(ld_prepare_inputs(dea_inputs, null, dea_diags) == null,
            "directive-bearing Dea objects must fail verification");
        assert(ldt_has_code(dea_diags, "L1C-2110"),
            "directive-bearing Dea diagnostic mismatch");
    }
}

/** Verify GCC-family and MSVC wrapper/final-link word construction. */
func test_host_command_words() {
    with (
        let diags = diag_create() => diag_free(diags),
        let extra = sv_create(1) => sv_free(extra),
        let compile_words = sv_create(16) => sv_free(compile_words),
        let msvc_compile = sv_create(16) => sv_free(msvc_compile),
        let link_words = sv_create(16) => sv_free(link_words),
        let msvc_link = sv_create(16) => sv_free(msvc_link)
    ) {
        let plan_opt = ldt_valid_mixed_plan(diags);
        assert(plan_opt != null, "command fixture plan should validate");
        let plan = plan_opt as LinkPlan*;
        sv_push(extra, "-DVALUE=1");

        ld_push_wrapper_compile_words(
            compile_words, "gcc", "gcc", extra, "-O1",
            "runtime include", "scratch/wrapper.c", "scratch/wrapper.o");
        assert(sv_get(compile_words, sv_size(compile_words) - 4) == "-c",
            "GCC wrapper command must compile only");
        assert(sv_get(compile_words, sv_size(compile_words) - 2) == "-o",
            "GCC wrapper command output flag mismatch");

        ld_push_wrapper_compile_words(
            msvc_compile, "cl.exe", "msvc", extra, null,
            "runtime include", "scratch/wrapper.c", "scratch/wrapper.o");
        assert(sv_get(msvc_compile, sv_size(msvc_compile) - 3) == "/c",
            "MSVC wrapper command must use /c");
        assert(sv_get(msvc_compile, sv_size(msvc_compile) - 1) ==
            "/Fo:scratch/wrapper.o", "MSVC wrapper /Fo mismatch");

        ld_push_final_link_words(
            link_words, "gcc", "gcc", "scratch/wrapper.o",
            plan, "/exact/libdea_rt.a", "out/app");
        assert(sv_get(link_words, 1) == "scratch/wrapper.o",
            "wrapper object must precede user inputs");
        assert(sv_get(link_words, 2) == "app.main.o",
            "first typed input order mismatch");
        assert(sv_get(link_words, 3) == "foreign.o",
            "foreign typed input order mismatch");
        assert(sv_get(link_words, 7) == "/exact/libdea_rt.a",
            "runtime archive must be passed by exact path");
        assert(!ldt_has_word(link_words, "-DVALUE=1"),
            "raw C options must not bypass the typed final-link boundary");
        assert(sv_get(link_words, sv_size(link_words) - 2) == "-o",
            "GCC final output flag mismatch");

        ld_push_final_link_words(
            msvc_link, "cl.exe", "msvc", "scratch/wrapper.o",
            plan, "C:\\runtime\\dea_rt.lib", "out\\app.exe");
        assert(sv_get(msvc_link, sv_size(msvc_link) - 1) ==
            "/Fe:out\\app.exe", "MSVC final /Fe mismatch");

        assert(ld_host_input_path("-Wl,other.o", "gcc") ==
            "./-Wl,other.o",
            "option-shaped relative input must become an explicit path");
        assert(ld_host_input_path("@response", "gcc") ==
            "./@response",
            "response-shaped relative input must become an explicit path");
        assert(ld_host_input_path("/tmp/object.o", "gcc") ==
            "/tmp/object.o",
            "GCC-family absolute input path must be retained");
        assert(ld_host_input_path("/root/object.obj", "msvc") ==
            "\\root\\object.obj",
            "MSVC rooted input path must not retain an option-shaped slash");
        assert(ld_windows_shell_word_safe("C:\\safe path\\object.obj"),
            "ordinary Windows paths should remain shell-stable");
        assert(!ld_windows_shell_word_safe("%TEMP%\\object.obj"),
            "percent expansion must be rejected");
        assert(!ld_windows_shell_word_safe("bang!object.obj"),
            "delayed-expansion markers must be rejected");
        assert(!ld_windows_shell_word_safe("quote\"object.obj"),
            "literal double quotes must be rejected");
        assert(!ld_windows_shell_word_safe("line\rbreak.obj"),
            "carriage returns must be rejected");
        assert(!ld_windows_shell_word_safe("line\nbreak.obj"),
            "line feeds must be rejected");

        ld_plan_free(plan);
    }
}

/** Verify pre-scratch validation consumes parsed option words exactly. */
func test_windows_shell_option_word_validation() {
    with (
        let diags = diag_create() => diag_free(diags),
        let runtime_inputs = sv_create(1) => sv_free(runtime_inputs),
        let parsed = bd_merge_c_option_words(
            "-DENV_SAFE=1 -Ienv-path",
            "-DCLI_SAFE=1 -DCLI=\"bad&echo injected\""
        ) => sv_free(parsed)
    ) {
        sv_push(runtime_inputs, "C:\\runtime path\\dea_rt.lib");
        assert(!ld_validate_windows_shell_values(
                "C:\\compiler path\\clang.exe",
                parsed,
                "C:\\runtime include",
                runtime_inputs,
                "C:\\output path\\app.exe",
                diags),
            "quote-bearing parsed option word must fail before scratch work");
        assert(ldt_has_code(diags, "L1C-2106"),
            "unsafe parsed option diagnostic mismatch");
        assert(diag_get(diags, 0).filename ==
            "-DCLI=\"bad&echo",
            "diagnostic path must identify the exact parsed option word");
    }

    with (
        let safe_diags = diag_create() => diag_free(safe_diags),
        let safe_runtime = sv_create(1) => sv_free(safe_runtime),
        let safe_options = bd_merge_c_option_words(
            "-DENV_SAFE=1", "-DCLI_SAFE=1") => sv_free(safe_options)
    ) {
        sv_push(safe_runtime, "C:\\runtime path\\dea_rt.lib");
        assert(ld_validate_windows_shell_values(
                "C:\\compiler path\\clang.exe",
                safe_options,
                "C:\\runtime include",
                safe_runtime,
                "C:\\output path\\app.exe",
                safe_diags),
            "spaces and ordinary Windows paths must remain accepted");
    }

    with (
        let redirect_diags = diag_create() => diag_free(redirect_diags),
        let command_values = sv_create(3) => sv_free(command_values)
    ) {
        sv_push(command_values, "clang.exe");
        sv_push(command_values, "scratch\\stdout%TEMP%");
        sv_push(command_values, "scratch\\stderr");
        assert(!ld_validate_windows_shell_words(
                command_values,
                "L1C-2108",
                "unsafe captured-output path",
                redirect_diags),
            "unsafe redirection paths must use the exact-word guard");
        assert(diag_get(redirect_diags, 0).filename ==
            "scratch\\stdout%TEMP%",
            "redirection diagnostic must identify the unsafe path");
    }

    with (
        let newline_diags = diag_create() => diag_free(newline_diags),
        let newline_values = sv_create(1) => sv_free(newline_values)
    ) {
        sv_push(newline_values, "-DVALUE=line\nspoof");
        assert(!ld_validate_windows_shell_words(
                newline_values,
                "L1C-2106",
                "unsafe command value",
                newline_diags),
            "line-breaking command values must fail validation");
        assert(contains_s(
                diag_get(newline_diags, 0).message, "\\x0aspoof"),
            "unsafe command-value diagnostics must escape line feeds");
        assert(!contains_s(diag_get(newline_diags, 0).message, "\n") &&
               !contains_s(diag_get(newline_diags, 0).filename, "\n"),
            "unsafe command-value diagnostics must remain single-line");
    }
}

/** Verify Windows system transport preserves inner command quotes. */
func test_windows_system_command_transport() {
    let command =
        "\"C:\\workspace with spaces\\host compiler\\gcc.exe\" " +
        "\"wrapper with spaces.c\" > \"stdout path\" 2> \"stderr path\"";
    assert(ld_wrap_system_command(command, true) ==
        "\"\"C:\\workspace with spaces\\host compiler\\gcc.exe\" " +
        "\"wrapper with spaces.c\" > \"stdout path\" 2> \"stderr path\"\"",
        "Windows system transport must preserve inner executable quotes");
    assert(ld_wrap_system_command(command, false) == command,
        "POSIX system transport must remain unchanged");
}

/** Remove one transaction directory that contains only known children. */
func ldt_remove_transaction(root: string) {
    if (cd_path_kind(root) != CD_PATH_DIRECTORY) {
        return;
    }
    let txn = ld_transaction_create(root);
    ld_cleanup_transaction(txn);
    ld_transaction_free(txn);
}

/** Verify collision retry and bounded non-recursive cleanup. */
func test_link_transaction_lifecycle() {
    let parent_dir = "compiler/stage1_l0/tests";
    let root0 = join(parent_dir, ".l1c-link-4242-7-9-0");
    let root1 = join(parent_dir, ".l1c-link-4242-7-9-1");
    ldt_remove_transaction(root0);
    ldt_remove_transaction(root1);
    assert(cd_mkdir(root0, 448) == 1, "expected occupied link candidate");

    with (let diags = diag_create() => diag_free(diags)) {
        let txn_opt = ld_create_transaction_for_identity(
            parent_dir, 4242, 7, 9, diags);
        assert(txn_opt != null, "link transaction should retry one collision");
        let txn = txn_opt as LinkTransaction*;
        assert(txn.root == root1, "link transaction retry path mismatch");
        assert(write_file(txn.wrapper_c, "wrapper") != null,
            "expected known transaction child");
        assert(ld_cleanup_transaction(txn),
            "known transaction children should clean");
        assert(cd_path_kind(root1) == CD_PATH_ABSENT,
            "clean transaction root should be removed");
        ld_transaction_free(txn);
    }

    let stale = ld_transaction_create(root0);
    let unexpected = join(root0, "unexpected");
    assert(write_file(unexpected, "retain") != null,
        "expected unexpected transaction child");
    assert(!ld_cleanup_transaction(stale),
        "unexpected child must make bounded cleanup fail");
    assert(cd_path_kind(root0) == CD_PATH_DIRECTORY,
        "failed cleanup must retain transaction root");
    delete_file(unexpected);
    assert(ld_cleanup_transaction(stale),
        "cleanup should succeed after unexpected child removal");
    ld_transaction_free(stale);
}

/** Verify output validation requires an existing parent and safe final kind. */
func test_output_validation() {
    let regular = "compiler/stage1_l0/tests/.tmp-link-output";
    delete_file(regular);
    with (let diags = diag_create() => diag_free(diags)) {
        assert(ld_validate_output(regular, diags),
            "absent output in an existing parent should validate");
        assert(write_file(regular, "old") != null,
            "expected regular output fixture");
        assert(ld_validate_output(regular, diags),
            "existing regular output should validate");
        delete_file(regular);
    }

    with (let missing_diags = diag_create() => diag_free(missing_diags)) {
        assert(!ld_validate_output(
            "compiler/stage1_l0/tests/.missing-link-parent/out",
            missing_diags),
            "missing output parent must fail");
        assert(ldt_has_code(missing_diags, "L1C-2105"),
            "invalid output diagnostic mismatch");
    }
}

/** Verify wrapper validation rejects a regular non-object artifact. */
func test_wrapper_object_validation() {
    let path = "compiler/stage1_l0/tests/.tmp-link-wrapper-object";
    delete_file(path);
    assert(write_file(path, "not an object") != null,
        "expected fake wrapper artifact");
    with (let diags = diag_create() => diag_free(diags)) {
        assert(!ld_validate_wrapper_object(path, diags),
            "regular non-object wrapper output must fail");
        assert(ldt_has_code(diags, "L1C-2108"),
            "invalid wrapper object diagnostic mismatch");
    }
    delete_file(path);

    with (let control_diags = diag_create() => diag_free(control_diags)) {
        let inspection = ldt_foreign_inspection(true);
        inspection.container.linker_control =
            OBJECT_LINKER_CONTROL_ELF_DEPENDENT_LIBRARIES;
        assert(!ld_validate_linker_control(
                "wrapper.o", inspection, control_diags),
            "directive-bearing wrapper objects must fail validation");
        assert(ldt_has_code(control_diags, "L1C-2110"),
            "directive-bearing wrapper diagnostic mismatch");
        object_inspection_free(inspection);
    }
}

/** Main entry point. */
func main() {
    test_valid_mixed_plan_ordering();
    test_graph_failures();
    test_deep_graph_uses_iterative_traversal();
    test_entry_selection();
    test_classification_failures();
    test_embedded_linker_control_failures();
    test_host_command_words();
    test_windows_shell_option_word_validation();
    test_windows_system_command_transport();
    test_link_transaction_lifecycle();
    test_output_validation();
    test_wrapper_object_validation();
    printl_s("link_driver_test: all tests passed");
}
