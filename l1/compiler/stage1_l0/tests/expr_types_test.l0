/**
 * Tests index diagnostic parity cases.
 */
func test_typing_index_diag_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_index_diag_err", cfg);
        assert(analysis_has_errors(result), "expected typing errors for typing_index_diag_err");
        assert(has_diag_code(result, "TYP-0210"), "expected non-int index expression error");
        assert(has_diag_code(result, "TYP-0211"), "expected nullable index base error");
        assert(has_diag_code(result, "TYP-0212"), "expected invalid index base error");
        assert(has_diag_message(result, "TYP-0211",
            "cannot index into a nullable expression; indexing is not yet supported"),
            "expected nullable index message wording");
        assert(has_diag_message(result, "TYP-0212",
            "cannot index into an expression; indexing is not yet supported"),
            "expected invalid index-base message wording");
        assert(!has_diag_code(result, "TYP-0350"), "did not expect legacy index-base diagnostic code");
        analysis_result_free(result);
    }
    sp_free(sp);
}

