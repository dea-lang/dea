/**
 * Tests nullable integer contexts reject nonliteral checked-conversion candidates.
 */
func test_typing_optional_int_context_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_optional_int_context_err", cfg);
        assert(analysis_has_errors(result), "expected typing errors for typing_optional_int_context_err");
        assert(count_diag_code(result, "TYP-0315") == 1, "expected one nullable return mismatch");
        assert(count_diag_code(result, "TYP-0311") == 1, "expected one nullable assignment mismatch");
        assert(count_diag_code(result, "TYP-0312") == 1, "expected one nullable call argument mismatch");
        assert(count_diag_code(result, "TYP-0313") == 1, "expected one nullable struct field mismatch");
        assert(count_diag_code(result, "TYP-0700") == 1, "expected one nullable integer literal range diagnostic");
        analysis_result_free(result);
    }
    sp_free(sp);
}

