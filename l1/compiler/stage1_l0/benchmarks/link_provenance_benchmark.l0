module link_provenance_benchmark;

import std.assert;
import std.hashmap;
import std.io;
import std.system;
import std.text;
import std.time;
import std.vector;

import cli_args;
import link_driver;
import module_interface;
import util.diag;

/** Construct one empty synthetic interface for provenance measurement. */
func lpb_interface(module_name: string) -> ModuleInterface* {
    return new ModuleInterface(
        module_name,
        "",
        false,
        ld_ptr_vec_create(2),
        ld_ptr_vec_create(2),
        ld_ptr_vec_create(2),
        ld_ptr_vec_create(1),
        ld_ptr_vec_create(1),
        ld_ptr_vec_create(1),
        ld_ptr_vec_create(1),
        ld_ptr_vec_create(1)
    );
}

/** Return the canonical synthetic module name for one node index. */
func lpb_module_name(index: int) -> string {
    return "bench.m" + int_to_string(index);
}

/** Append one lifecycle import to a synthetic interface. */
func lpb_add_import(interface: ModuleInterface*, provider_index: int) {
    ld_ptr_vec_push(
        interface.module_imports,
        new InterfaceModuleImport(lpb_module_name(provider_index), "") as void*
    );
}

/** Append one public semantic-provider expectation. */
func lpb_add_require(interface: ModuleInterface*, provider_index: int) {
    ld_ptr_vec_push(
        interface.require_entries,
        new InterfaceDepEntry(lpb_module_name(provider_index), "Visible", "") as void*
    );
}

/** Append one implementation semantic-provider expectation. */
func lpb_add_link(interface: ModuleInterface*, provider_index: int) {
    ld_ptr_vec_push(
        interface.link_entries,
        new InterfaceDepEntry(lpb_module_name(provider_index), "helper", "") as void*
    );
}

/** Construct and register the module set shared by every benchmark shape. */
func lpb_plan_create(module_count: int) -> LinkPlan* {
    let inputs = ld_ptr_vec_create(module_count);
    let plan = new LinkPlan(
        inputs,
        spm_create(),
        sv_create(0),
        ""
    );
    for (let i = 0; i < module_count; i = i + 1) {
        let module_name = lpb_module_name(i);
        let object_path = module_name + ".o";
        let interface_path = module_name + ".l1m";
        let input = ld_input_create(
            LOK_DEA_OBJECT,
            object_path,
            interface_path,
            lpb_interface(module_name)
        );
        ld_ptr_vec_push(inputs, input as void*);
        spm_put(plan.modules_by_name, module_name, input as void*);
    }
    return plan;
}

/** Populate one benchmark graph without timing construction work. */
func lpb_populate_shape(plan: LinkPlan*, shape: string, module_count: int) {
    if (shape == "control-chain" || shape == "direct-chain" ||
        shape == "terminal-chain") {
        for (let i = 0; i + 1 < module_count; i = i + 1) {
            let interface = ld_input_interface(ld_plan_input_get(plan, i));
            lpb_add_import(interface, i + 1);
            if (shape == "direct-chain") {
                lpb_add_require(interface, i + 1);
            } else if (shape == "terminal-chain") {
                lpb_add_require(interface, module_count - 1);
            }
        }
        return;
    }

    assert(shape == "layered-dag", "unknown provenance benchmark shape: " + shape);
    let width = 8;
    if (module_count <= width) {
        width = module_count / 2;
    }
    for (let i2 = 0; i2 < module_count; i2 = i2 + 1) {
        let first = i2 + width;
        let second = first + 1;
        let interface2 = ld_input_interface(ld_plan_input_get(plan, i2));
        if (first < module_count) {
            lpb_add_import(interface2, first);
            lpb_add_require(interface2, first);
        }
        if (second < module_count) {
            lpb_add_import(interface2, second);
            lpb_add_link(interface2, second);
        }
    }
}

/** Execute one unmeasured provenance-validation warmup. */
func lpb_warmup(plan: LinkPlan*, diags: DiagCollector*) {
    assert(ld_validate_transitive_provenance(plan, diags),
        "provenance benchmark warmup must validate");
    assert(diag_count(diags) == 0,
        "provenance benchmark warmup must not emit diagnostics");
}

/** Measure and report one provenance-validation sample. */
func lpb_measure(
    plan: LinkPlan*,
    diags: DiagCollector*,
    shape: string,
    module_count: int,
    iteration: int
) {
    let start_opt = monotonic_now();
    assert(start_opt != null, "monotonic clock unavailable before benchmark sample");
    let ok = ld_validate_transitive_provenance(plan, diags);
    let end_opt = monotonic_now();
    assert(end_opt != null, "monotonic clock unavailable after benchmark sample");
    assert(ok, "provenance benchmark sample must validate");
    assert(diag_count(diags) == 0,
        "provenance benchmark sample must not emit diagnostics");

    let duration_opt = monotonic_diff(
        start_opt as MonotonicTime,
        end_opt as MonotonicTime
    );
    assert(duration_opt != null, "invalid provenance benchmark duration");
    let duration = duration_opt as Duration;
    printl_s(
        "sample=" + shape + "," + int_to_string(module_count) + "," +
        int_to_string(iteration) + "," + int_to_string(duration.sec) + "," +
        int_to_string(duration.nsec)
    );
}

/** Run one requested benchmark cell. */
func lpb_run(shape: string, module_count: int, warmups: int, runs: int) {
    assert(module_count >= 2, "module count must be at least two");
    assert(warmups >= 0, "warmup count must be non-negative");
    assert(runs >= 1, "measured run count must be positive");
    assert(monotonic_supported(), "provenance benchmark requires a monotonic clock");

    let plan = lpb_plan_create(module_count);
    lpb_populate_shape(plan, shape, module_count);
    with (let diags = diag_create() => diag_free(diags)) {
        for (let warmup = 0; warmup < warmups; warmup = warmup + 1) {
            lpb_warmup(plan, diags);
        }
        for (let iteration = 0; iteration < runs; iteration = iteration + 1) {
            lpb_measure(plan, diags, shape, module_count, iteration);
        }
    }
    ld_plan_free(plan);
}

/** Benchmark entry point. */
func main() {
    assert(argc() == 5,
        "usage: link_provenance_benchmark SHAPE MODULES WARMUPS RUNS");
    let module_count_opt = string_to_int(argv(2));
    let warmups_opt = string_to_int(argv(3));
    let runs_opt = string_to_int(argv(4));
    assert(module_count_opt != null, "invalid module count: " + argv(2));
    assert(warmups_opt != null, "invalid warmup count: " + argv(3));
    assert(runs_opt != null, "invalid measured run count: " + argv(4));
    lpb_run(
        argv(1),
        module_count_opt as int,
        warmups_opt as int,
        runs_opt as int
    );
}
