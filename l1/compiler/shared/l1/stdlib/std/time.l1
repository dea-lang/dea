module std.time;

export WallTime, MonotonicTime, Duration, DateTime, CivilDate,
    TimeError, DeadlineResult, RemainingResult, SleepResult,
    is_valid_nsec, is_leap_year, days_in_month, day_of_year,
    civil_from_unix_days, datetime_from_unix_sec, wall_now, monotonic_supported,
    monotonic_now, monotonic_diff, wall_to_utc_datetime, wall_to_local_datetime,
    utc_now_datetime, local_now_datetime, deadline_after, remaining, sleep, sleep_until;

import sys.rt;
import sys.time;
import std.integer;
import std.os as os;

/**
 * Represents wall clock time in seconds and nanoseconds since the Unix epoch.
 */
struct WallTime {
    sec: long;
    nsec: int;
}

/**
 * Represents monotonic time in seconds and nanoseconds.
 */
struct MonotonicTime {
    sec: long;
    nsec: int;
}

/**
 * Represents a duration of time in seconds and nanoseconds.
 */
struct Duration {
    sec: long;
    nsec: int;
}

/**
 * Represents a broken-down date and time.
 */
struct DateTime {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    nanosecond: int;
    weekday: int;
    yearday: int;
    utc_offset_sec: int;
    is_dst: bool;
}

/**
 * Represents a civil date without time components.
 */
struct CivilDate {
    year: int;
    month: int;
    day: int;
    weekday: int;
    yearday: int;
}

/**
 * Checks if the nanosecond component is within valid range [0, 1e9).
 *
 * @param nsec The nanosecond value.
 * @return True if valid, false otherwise.
 */
func is_valid_nsec(nsec: int) -> bool {
    return nsec >= 0 && nsec < 1000000000;
}

/**
 * Determines if a given year is a leap year.
 *
 * @param year The year to check.
 * @return True if leap year, false otherwise.
 */
func is_leap_year(year: int) -> bool {
    if (year % 4 != 0) {
        return false;
    }
    if (year % 100 != 0) {
        return true;
    }
    return year % 400 == 0;
}

/**
 * Returns the number of days in a given month of a given year.
 *
 * @param year The year.
 * @param month The month (1-12).
 * @return The number of days in the month.
 */
func days_in_month(year: int, month: int) -> int {
    if (month == 1 || month == 3 || month == 5 || month == 7 || month == 8 || month == 10 || month == 12) {
        return 31;
    }
    if (month == 4 || month == 6 || month == 9 || month == 11) {
        return 30;
    }
    if (is_leap_year(year)) {
        return 29;
    }
    return 28;
}

/**
 * Calculates the day of the year for a given date.
 *
 * @param year The year.
 * @param month The month.
 * @param day The day of the month.
 * @return The day of the year (1-366).
 */
func day_of_year(year: int, month: int, day: int) -> int {
    let total = day;
    let m = 1;
    while (m < month) {
        total = total + days_in_month(year, m);
        m = m + 1;
    }
    return total;
}

/**
 * Calculates civil date components from Unix days without narrowing seconds.
 *
 * @param days The number of days since the Unix epoch.
 * @return The broken-down date, or null when arithmetic or the int year overflows.
 */
func civil_from_unix_days(days: long) -> CivilDate? {
    let z = checked_add_long(days, 719468)?;
    let era = div_floor_l(z, 146097);
    let doe = emod_l(z, 146097);
    let yoe = (doe - (doe / 1460) + (doe / 36524) - (doe / 146096)) / 365;
    let y = checked_add_long(yoe, checked_mul_long(era, 400)?)?;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let day = (doy - (153 * mp + 2) / 5 + 1) as int;
    let month: int = 0;
    if (mp < 10) {
        month = (mp + 3) as int;
    } else {
        month = (mp - 9) as int;
    }
    let year = y;
    if (month <= 2) {
        year = checked_add_long(y, 1)?;
    }
    if (year < (int_min() as long) || year > (int_max() as long)) {
        return null;
    }
    let narrow_year = year as int;
    let weekday = ((emod_l(days, 7) + 4) % 7) as int;
    let yearday = day_of_year(narrow_year, month, day);
    return CivilDate(narrow_year, month, day, weekday, yearday);
}

/**
 * Creates a DateTime object from Unix seconds and other components.
 *
 * @param unix_sec Seconds since Unix epoch.
 * @param nsec Nanoseconds component.
 * @param utc_offset_sec Offset from UTC in seconds.
 * @param is_dst True if daylight saving time is in effect.
 * @return The broken-down DateTime, or null if invalid or the year overflows.
 */
func datetime_from_unix_sec(unix_sec: long, nsec: int, utc_offset_sec: int, is_dst: bool) -> DateTime? {
    if (!is_valid_nsec(nsec)) {
        return null;
    }
    let days = div_floor_l(unix_sec, 86400);
    let sod = emod_l(unix_sec, 86400);
    let hour = (sod / 3600) as int;
    let rem = sod % 3600;
    let minute = (rem / 60) as int;
    let second = (rem % 60) as int;
    let civil = civil_from_unix_days(days)?;
    return DateTime(
        civil.year,
        civil.month,
        civil.day,
        hour,
        minute,
        second,
        nsec,
        civil.weekday,
        civil.yearday,
        utc_offset_sec,
        is_dst
    );
}

/**
 * Returns the current wall clock time.
 *
 * @return The current WallTime, or null on error.
 */
func wall_now() -> WallTime? {
    with (let parts = new RtTimeParts(0, 0) => drop parts) {
        let ok = rt_time_unix(parts);
        if (!ok) {
            return null;
        }
        if (!is_valid_nsec(parts.nsec)) {
            return null;
        }
        return WallTime(parts.sec, parts.nsec);
    }
}

/**
 * Checks if the monotonic clock is supported by the runtime.
 *
 * @return True if supported, false otherwise.
 */
func monotonic_supported() -> bool {
    return rt_time_monotonic_supported();
}

/**
 * Returns the current monotonic time.
 *
 * @return The current MonotonicTime, or null if not supported or error.
 */
func monotonic_now() -> MonotonicTime? {
    if (!rt_time_monotonic_supported()) {
        return null;
    }

    with (let parts = new RtTimeParts(0, 0) => drop parts) {
        let ok = rt_time_monotonic(parts);
        if (!ok) {
            return null;
        }
        if (!is_valid_nsec(parts.nsec)) {
            return null;
        }
        return MonotonicTime(parts.sec, parts.nsec);
    }
}

/**
 * Calculates the duration between two monotonic time points.
 *
 * @param start The starting time.
 * @param end The ending time.
 * @return The Duration difference, or null for invalid values, end < start, or overflow.
 */
func monotonic_diff(start: MonotonicTime, end: MonotonicTime) -> Duration? {
    if (start.sec < 0 || end.sec < 0 || !is_valid_nsec(start.nsec) || !is_valid_nsec(end.nsec)) {
        return null;
    }

    if (end.sec < start.sec) {
        return null;
    }
    if (end.sec == start.sec && end.nsec < start.nsec) {
        return null;
    }

    let sec_diff = checked_sub_long(end.sec, start.sec)?;

    if (end.nsec >= start.nsec) {
        let nsec_diff = end.nsec - start.nsec;
        return Duration(sec_diff, nsec_diff);
    }

    if (sec_diff == 0) {
        return null;
    }

    let nsec_diff = end.nsec + 1000000000 - start.nsec;
    return Duration(sec_diff - 1, nsec_diff);
}

/**
 * Converts wall clock time to UTC DateTime.
 *
 * @param t The wall clock time.
 * @return The UTC DateTime, or null on error.
 */
func wall_to_utc_datetime(t: WallTime) -> DateTime? {
    return datetime_from_unix_sec(t.sec, t.nsec, 0, false);
}

/**
 * Converts wall clock time to local DateTime.
 *
 * @param t The wall clock time.
 * @return The local DateTime, or null on error.
 */
func wall_to_local_datetime(t: WallTime) -> DateTime? {
    if (!is_valid_nsec(t.nsec)) {
        return null;
    }

    let offset = rt_time_local_offset_sec(t.sec)?;
    let is_dst = rt_time_local_is_dst(t.sec)?;
    let local_sec = checked_add_long(t.sec, offset as long)?;
    return datetime_from_unix_sec(local_sec, t.nsec, offset, is_dst);
}

/**
 * Returns the current date and time in UTC.
 *
 * @return The UTC DateTime, or null on error.
 */
func utc_now_datetime() -> DateTime? {
    let now = wall_now()?;
    return wall_to_utc_datetime(now);
}

/**
 * Returns the current date and time in the local time zone.
 *
 * @return The local DateTime, or null on error.
 */
func local_now_datetime() -> DateTime? {
    let now = wall_now()?;
    return wall_to_local_datetime(now);
}

/**
 * Scheduling validation, arithmetic, support, or captured host failure.
 */
enum TimeError {
    InvalidValue;
    Overflow;
    UnsupportedClock;
    Host(error: os::OsError);
}

/**
 * A sampled absolute monotonic deadline or explicit failure.
 */
enum DeadlineResult {
    Ready(deadline: MonotonicTime);
    DeadlineFailed(error: TimeError);
}

/**
 * Positive time left until a deadline, expiry, or explicit failure.
 */
enum RemainingResult {
    Remaining(duration: Duration);
    Expired;
    RemainingFailed(error: TimeError);
}

/**
 * Sleep completion, caller-controlled interruption, or explicit failure.
 */
enum SleepResult {
    Completed;
    Interrupted(deadline: MonotonicTime, error: os::OsError);
    SleepFailed(error: TimeError);
}

/**
 * Convert the runtime's scheduling failure without querying ambient host state.
 *
 * @param result Captured runtime scheduling outcome.
 * @return Structured scheduling error retaining any native host cause.
 */
func _time_error_from_rt(result: RtTimeResult) -> TimeError {
    if (result.state == 1) { return InvalidValue; }
    if (result.state == 2) { return Overflow; }
    if (result.state == 3) { return UnsupportedClock; }
    return Host(os::_os_error_from_rt(result.error));
}

/**
 * Add a normalized nonnegative delay to one monotonic clock sample.
 *
 * @param now Nonnegative normalized monotonic sample.
 * @param delay Nonnegative normalized duration.
 * @return Checked absolute deadline, invalid value, or overflow.
 */
func _time_add_delay(now: MonotonicTime, delay: Duration) -> DeadlineResult {
    if (now.sec < 0 || delay.sec < 0 || !is_valid_nsec(now.nsec) || !is_valid_nsec(delay.nsec)) {
        return DeadlineFailed(InvalidValue);
    }
    let seconds = checked_add_long(now.sec, delay.sec);
    if (seconds == null) {
        return DeadlineFailed(Overflow);
    }
    let sec = seconds as long;
    let nsec = now.nsec + delay.nsec;
    if (nsec >= 1000000000) {
        let carried = checked_add_long(sec, 1);
        if (carried == null) {
            return DeadlineFailed(Overflow);
        }
        sec = carried as long;
        nsec = nsec - 1000000000;
    }
    return Ready(MonotonicTime(sec, nsec));
}

/**
 * Sample a monotonic deadline after a nonnegative normalized delay.
 *
 * Zero delay still samples the clock. Deadlines belong to this host clock epoch
 * and must not be persisted or transferred to unrelated hosts or boots.
 *
 * @param delay Nonnegative seconds and normalized nanoseconds.
 * @return Absolute deadline, validation or arithmetic error, or clock failure.
 */
func deadline_after(delay: Duration) -> DeadlineResult {
    if (delay.sec < 0 || !is_valid_nsec(delay.nsec)) {
        return DeadlineFailed(InvalidValue);
    }
    let sample = rt_time_monotonic_result();
    if (sample.state != 0) {
        return DeadlineFailed(_time_error_from_rt(sample));
    }
    return _time_add_delay(MonotonicTime(sample.sec, sample.nsec), delay);
}

/**
 * Sample the positive normalized time left until a monotonic deadline.
 *
 * @param deadline Nonnegative normalized deadline from this host clock epoch.
 * @return Strictly positive remaining duration, expiry, or explicit failure.
 */
func remaining(deadline: MonotonicTime) -> RemainingResult {
    if (deadline.sec < 0 || !is_valid_nsec(deadline.nsec)) {
        return RemainingFailed(InvalidValue);
    }
    let sample = rt_time_monotonic_result();
    if (sample.state != 0) {
        return RemainingFailed(_time_error_from_rt(sample));
    }
    if (sample.sec < 0 || !is_valid_nsec(sample.nsec)) {
        return RemainingFailed(InvalidValue);
    }
    if (deadline.sec < sample.sec || (deadline.sec == sample.sec && deadline.nsec <= sample.nsec)) {
        return Expired;
    }
    let duration = monotonic_diff(MonotonicTime(sample.sec, sample.nsec), deadline);
    if (duration == null) {
        return RemainingFailed(Overflow);
    }
    return Remaining(duration as Duration);
}

/**
 * Sleep until an absolute monotonic deadline without restarting interruptions.
 *
 * Completion means the clock reached the deadline, including a past deadline.
 * Early wakeups recheck the same deadline. A host interruption returns its saved
 * error and the original deadline; callers may explicitly retry that deadline.
 * Suspend accounting follows the selected host clock. Scheduler latency and
 * timer resolution may delay return without a hard real-time upper bound.
 *
 * @param deadline Nonnegative normalized deadline from this host clock epoch.
 * @return Completion, interruption with the original deadline, or failure.
 */
func sleep_until(deadline: MonotonicTime) -> SleepResult {
    if (deadline.sec < 0 || !is_valid_nsec(deadline.nsec)) {
        return SleepFailed(InvalidValue);
    }
    let result = rt_time_sleep_until(deadline.sec, deadline.nsec);
    if (result.state == 0) {
        return Completed;
    }
    if (result.state == 5) {
        return Interrupted(deadline, os::_os_error_from_rt(result.error));
    }
    return SleepFailed(_time_error_from_rt(result));
}

/**
 * Sleep for a nonnegative normalized duration using one absolute deadline.
 *
 * Zero duration completes without allocation, clock sampling, or a host wait.
 * An interruption returns immediately; resuming uses sleep_until with its saved
 * deadline rather than restarting the relative duration.
 *
 * @param delay Nonnegative seconds and normalized nanoseconds.
 * @return Completion, interruption with the original deadline, or failure.
 */
func sleep(delay: Duration) -> SleepResult {
    if (delay.sec < 0 || !is_valid_nsec(delay.nsec)) {
        return SleepFailed(InvalidValue);
    }
    if (delay.sec == 0 && delay.nsec == 0) {
        return Completed;
    }
    match (deadline_after(delay)) {
        Ready(deadline) => { return sleep_until(deadline); }
        DeadlineFailed(error) => { return SleepFailed(error); }
    }
}
