/**
 * Result-owned file handles with direct native I/O and checked buffer ranges.
 *
 * Open results own one cleanup obligation; File pointers borrow it. Close
 * retires a handle while retaining its wrapper and first close outcome.
 * Final result cleanup destroys the wrapper and invalidates all aliases.
 */
module std.file;

export opaque { File }, FileOffset, AccessMode, CreateMode, SeekOrigin, OpenOptions,
    OpenFileResult, CloseResult, OffsetResult, ReadExactResult, WriteAllResult,
    open, close, free_open_file_result, read_some, read_exact, write_some, write_all,
    seek, position, read_at, write_at, size, truncate, metadata, flush, sync_data, sync_all;

import sys.fs;
import sys.os;
import std.assert;
import std.bytes as bytes;
import std.fs as fs;
import std.os as os;

/**
 * Signed 64-bit file positions, sizes, and relative seek offsets.
 */
type FileOffset = long;

/**
 * Read-only, write-only, or combined access to the opened object.
 */
enum AccessMode { ReadOnly; WriteOnly; ReadWrite; }

/**
 * Existence policy; creation and truncation require writable access.
 */
enum CreateMode { OpenExisting; OpenOrCreate; CreateNew; CreateOrTruncate; }

/**
 * Origin for a relative seek; resulting absolute positions cannot be negative.
 */
enum SeekOrigin { FromStart; FromCurrent; FromEnd; }

/**
 * Explicit open policy; append requires writable access and native append I/O.
 * Native permissions and sharing rules apply. Child inheritance is disabled.
 */
struct OpenOptions { access: AccessMode; create: CreateMode; append: bool; }

/**
 * Opaque wrapper borrowed from its successful OpenFileResult owner.
 */
struct File { _handle: void*; }

/**
 * Owns one successful file wrapper; copies share its single cleanup obligation.
 */
enum OpenFileResult { OpenedFile(file: File*); OpenFileFailed(error: os::OsError); }

/**
 * Saved first close outcome; native failure still retires the public handle.
 */
enum CloseResult { Closed; CloseFailed(error: os::OsError); }

/**
 * A position or byte size, or a captured failure without a usable value.
 */
enum OffsetResult { FileOffsetValue(value: FileOffset); FileOffsetFailed(error: os::OsError); }

/**
 * Exact read completion or terminal outcome with the accumulated byte count.
 */
enum ReadExactResult {
    ReadComplete(count: int);
    ReadExactEof(count: int);
    ReadExactTimedOut(count: int, error: os::OsError);
    ReadExactFailed(count: int, error: os::OsError);
}

/**
 * Complete write or terminal outcome with the accumulated byte count.
 */
enum WriteAllResult {
    WriteComplete(count: int);
    WriteAllTimedOut(count: int, error: os::OsError);
    WriteAllFailed(count: int, error: os::OsError);
}

/**
 * Borrowed native resource and scalar argument passed without allocation.
 */
type RangeContext = bytes::ByteBufferRangeActionContext;

/**
 * Finite range-action outcome returned by value.
 */
type RangeResult = bytes::ByteBufferRangeActionResult;

/**
 * File-owned diagnostic schema carried unchanged by std.bytes.
 */
type RangeDiagnostic = bytes::ByteBufferRangeActionDiagnostic;

/**
 * Encode a native single-attempt file result without losing its state or error.
 * Terminal file outcomes must have zero progress; unknown native codes remain
 * diagnostic data and are never inferred from ambient host error state.
 *
 * @param result Captured native transfer outcome.
 * @return The matching range outcome, with success scalar absent.
 */
func _encode_file_result(result: RtIoResult) -> RangeResult {
    assert(result.count >= 0, "std.file: invalid native transfer result");
    if (result.state == 0) { return bytes::RangeActionApplied(result.count, null); }
    assert(result.count == 0 && result.state >= 1 && result.state <= 3,
        "std.file: invalid native transfer result");
    let diagnostic = RangeDiagnostic(result.state, result.error.kind,
        result.error.domain, result.error.native_code);
    if (result.state == 1) { return bytes::RangeActionStopped(result.count, diagnostic); }
    return bytes::RangeActionFailed(result.count, diagnostic);
}

/**
 * Validate the private file schema and reconstruct its native transport fields.
 * The selected private callback establishes the schema; payload checks do not
 * prove provenance. Successful partial counts are allowed, but terminal public
 * variants cannot carry progress. Native namespaces must survive conversion;
 * unknown native codes and normalized Other failures remain valid.
 *
 * @param result By-value result of a private file callback.
 * @param allow_eof Whether the operation is a read and may stop at EOF.
 * @return Validated native fields for existing public result conversion.
 */
func _decode_file_result(result: RangeResult, allow_eof: bool) -> RtIoResult {
    match (result) {
        RangeActionApplied(processed, value) => {
            assert(processed >= 0 && value == null, "std.file: invalid range action result");
            return RtIoResult(0, processed, RtOsError(0, 0, 0 as long));
        }
        RangeActionStopped(processed, reason) => {
            assert(allow_eof && processed == 0 && reason.tag == 1
                && reason.code == 0 && reason.detail == 0 && reason.value == 0 as long,
                "std.file: invalid range action result");
            return RtIoResult(1, 0, RtOsError(0, 0, 0 as long));
        }
        RangeActionFailed(processed, error) => {
            assert(processed == 0 && (error.tag == 2 || error.tag == 3),
                "std.file: invalid range action result");
            let native = RtOsError(error.code, error.detail, error.value);
            let public = os::_os_error_from_rt(native);
            assert(os::_os_error_to_rt(public).domain == error.detail
                && (error.detail != 0 || error.value == 0 as long),
                "std.file: invalid range action error");
            return RtIoResult(error.tag, 0, native);
        }
    }
}

/**
 * Decode the private read schema into the existing public read result.
 *
 * @param result Captured result of a private read callback.
 * @return Successful partial count, EOF, timeout, or unchanged captured error.
 */
func _decode_file_read(result: RangeResult) -> os::ReadResult {
    return os::_os_read_from_rt(_decode_file_result(result, true));
}

/**
 * Decode the private write schema into the existing public write result.
 *
 * @param result Captured result of a private write callback.
 * @return Successful partial count, timeout, or unchanged captured error.
 */
func _decode_file_write(result: RangeResult) -> os::WriteResult {
    return os::_os_write_from_rt(_decode_file_result(result, false));
}

/**
 * Borrow a live file handle and buffer range for one synchronous native read.
 * The caller keeps both resources live and prevents conflicting alias access.
 * Storage is accessed only within count bytes and is never retained; no buffer
 * structural operation or ownership transfer occurs during the callback.
 *
 * @param data Borrowed writable byte range, inaccessible when count is zero.
 * @param count Validated logical range length.
 * @param context Existing native file handle; scalar argument is unused.
 * @return Captured native read result encoded by value.
 */
unsafe func _read_action(data: byte*, count: int, context: RangeContext) -> RangeResult {
    return _encode_file_result(rt_file_read(context.state as void*, data as void*, count));
}

/**
 * Borrow a live file handle and buffer range for one synchronous native write.
 * The caller keeps both resources live and prevents conflicting alias access.
 * Storage is accessed only within count bytes and is never retained; no buffer
 * structural operation or ownership transfer occurs during the callback.
 *
 * @param data Borrowed readable byte range, inaccessible when count is zero.
 * @param count Validated logical range length.
 * @param context Existing native file handle; scalar argument is unused.
 * @return Captured native write result encoded by value.
 */
unsafe func _write_action(data: byte*, count: int, context: RangeContext) -> RangeResult {
    return _encode_file_result(rt_file_write(context.state as void*, data as void*, count));
}

/**
 * Borrow a live file handle and buffer range for one synchronous positional read.
 * The caller keeps both resources live and prevents conflicting alias access.
 * Storage is accessed only within count bytes and is never retained; no buffer
 * structural operation or ownership transfer occurs during the callback.
 *
 * @param data Borrowed writable byte range, inaccessible when count is zero.
 * @param count Validated logical range length.
 * @param context Existing native file handle and full signed file offset.
 * @return Captured native positional read result encoded by value.
 */
unsafe func _read_at_action(data: byte*, count: int, context: RangeContext) -> RangeResult {
    return _encode_file_result(rt_file_read_at(context.state as void*, data as void*, count, context.argument));
}

/**
 * Borrow a live file handle and buffer range for one synchronous positional write.
 * The caller keeps both resources live and prevents conflicting alias access.
 * Storage is accessed only within count bytes and is never retained; no buffer
 * structural operation or ownership transfer occurs during the callback.
 *
 * @param data Borrowed readable byte range, inaccessible when count is zero.
 * @param count Validated logical range length.
 * @param context Existing native file handle and full signed file offset.
 * @return Captured native positional write result encoded by value.
 */
unsafe func _write_at_action(data: byte*, count: int, context: RangeContext) -> RangeResult {
    return _encode_file_result(rt_file_write_at(context.state as void*, data as void*, count, context.argument));
}

/**
 * Convert an access policy to its native transport tag.
 *
 * @param access Public access policy.
 * @return The stable native access tag.
 */
func _access_tag(access: AccessMode) -> int {
    match (access) {
        ReadOnly => { return 0; }
        WriteOnly => { return 1; }
        ReadWrite => { return 2; }
    }
}

/**
 * Convert a creation policy to its native transport tag.
 *
 * @param create Public creation policy.
 * @return The stable native creation tag.
 */
func _create_tag(create: CreateMode) -> int {
    match (create) {
        OpenExisting => { return 0; }
        OpenOrCreate => { return 1; }
        CreateNew => { return 2; }
        CreateOrTruncate => { return 3; }
    }
}

/**
 * Convert a seek origin to its native transport tag.
 *
 * @param origin Public seek origin.
 * @return Beginning (0), current (1), or end (2).
 */
func _origin_tag(origin: SeekOrigin) -> int {
    match (origin) {
        FromStart => { return 0; }
        FromCurrent => { return 1; }
        FromEnd => { return 2; }
    }
}

/**
 * Convert a captured native close outcome.
 *
 * @param result Native close outcome.
 * @return Closed, or the unchanged captured failure.
 */
func _close_result(result: RtFsStatus) -> CloseResult {
    if (result.ok) { return Closed; }
    return CloseFailed(os::_os_error_from_rt(result.error));
}

/**
 * Convert a captured position or extent outcome without narrowing.
 *
 * @param result Native offset outcome.
 * @return The 64-bit value, or its captured failure.
 */
func _offset_result(result: RtFileOffset) -> OffsetResult {
    if (result.ok) { return FileOffsetValue(result.value); }
    return FileOffsetFailed(os::_os_error_from_rt(result.error));
}

/**
 * Open a file with direct native I/O and child inheritance disabled.
 *
 * Register free_open_file_result with with cleanup before matching the result.
 * Successful copies share one cleanup obligation; extracted File pointers borrow
 * it. Invalid access/creation combinations return InvalidInput. Allocation
 * failure for the Dea wrapper terminates execution, as for ordinary new values.
 *
 * @param path File path; embedded NUL and invalid native encodings are rejected.
 * @param options Explicit access, creation, and native append policy.
 * @return One owning file result, or a captured open failure.
 */
func open(path: string, options: OpenOptions) -> OpenFileResult {
    let result = rt_file_open(path, _access_tag(options.access), _create_tag(options.create), options.append);
    if (!result.ok) { return OpenFileFailed(os::_os_error_from_rt(result.error)); }
    return OpenedFile(new File(result.handle as void*));
}

/**
 * Retire the public handle and preserve its wrapper and first close outcome.
 *
 * Repeated calls return that outcome without another native close. A failed
 * native close does not prove native release and is never blindly retried.
 * Other operations on the closed live wrapper return InvalidHandle.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return Closed or the first captured CloseFailed outcome.
 */
func close(file: File*) -> CloseResult {
    return _close_result(rt_file_close(file._handle));
}

/**
 * Consume successful file ownership exactly once, including on close failure.
 *
 * Close an open file, destroy its wrapper, and invalidate every alias. If
 * already closed, preserve its first close outcome. Failed-open variants need
 * no cleanup. Destruction is not idempotent and does not propagate errors
 * automatically or replace a caller's primary operation failure.
 *
 * @param result Owning result to consume exactly once when successful.
 * @return The saved or newly captured close outcome, or Closed after failed open.
 */
func free_open_file_result(result: OpenFileResult) -> CloseResult {
    match (result) {
        OpenedFile(file) => {
            let outcome = _close_result(rt_file_free(file._handle));
            drop file;
            return outcome;
        }
        OpenFileFailed(error) => { return Closed; }
    }
}

/**
 * Read once into a pre-sized logical buffer range.
 *
 * Invalid ranges terminate execution, including invalid empty ranges. A valid
 * zero count does not probe EOF. Successful partial transfers return Read;
 * interruptions return captured failures without implicit retry. Buffer size
 * never changes, and bytes outside the reported transferred prefix are untouched.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Pre-sized destination buffer.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative maximum count within the logical buffer range.
 * @return Read count, EOF, native timeout, or captured failure.
 */
func read_some(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int) -> os::ReadResult {
    let context = RangeContext(file._handle, 0 as long);
    return _decode_file_read(bytes::with_raw_range(buffer, start, count, context, _read_action));
}

/**
 * Read the requested logical buffer range or preserve progress at a terminal outcome.
 *
 * Loop only over successful partial transfers. EOF, timeout, or failure returns
 * all bytes read so far; interruptions are not retried. Buffer size is unchanged.
 * Invalid ranges terminate execution before native transfer, even for zero count.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Pre-sized destination buffer.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative requested count within the logical buffer range.
 * @return Complete count, early EOF count, or a failure with accumulated progress.
 */
func read_exact(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int) -> ReadExactResult {
    let done = 0;
    let pending = true;
    while (pending) {
        match (read_some(file, buffer, start + done, count - done)) {
            Read(amount) => {
                done = done + amount;
                if (done == count) { pending = false; }
                else if (amount == 0) { return ReadExactFailed(done, os::OsError(os::IoError, os::Runtime, 0 as long)); }
            }
            Eof => { return ReadExactEof(done); }
            ReadTimedOut(error) => { return ReadExactTimedOut(done, error); }
            ReadFailed(error) => { return ReadExactFailed(done, error); }
        }
    }
    return ReadComplete(done);
}

/**
 * Write once from a checked logical buffer range.
 *
 * Invalid ranges terminate execution, including invalid empty ranges. Successful
 * partial writes report their count. Interruptions are not retried. Native append
 * guarantees apply per underlying write; no library buffering is introduced.
 * POSIX writes retain the process's SIGPIPE policy for non-regular endpoints;
 * a terminating signal can prevent delivery of a BrokenPipe result.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Source buffer whose bytes are copied synchronously.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative maximum count within the logical buffer range.
 * @return Accepted byte count, native timeout, or captured failure.
 */
func write_some(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int) -> os::WriteResult {
    let context = RangeContext(file._handle, 0 as long);
    return _decode_file_write(bytes::with_raw_range(buffer, start, count, context, _write_action));
}

/**
 * Write a complete logical buffer range or return accumulated progress on failure.
 *
 * Loop only over successful partial transfers. Interruptions are not retried,
 * and a positive-length zero-progress write returns IoError instead of looping.
 * Multiple native append writes do not form one atomic append operation.
 * POSIX writes retain the process's SIGPIPE policy for non-regular endpoints;
 * a terminating signal can prevent delivery of a BrokenPipe result.
 * Invalid ranges terminate execution before native transfer, even for zero count.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Source buffer whose bytes are copied synchronously.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative requested count within the logical buffer range.
 * @return Complete count, or a timeout/failure with accumulated progress.
 */
func write_all(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int) -> WriteAllResult {
    let done = 0;
    let pending = true;
    while (pending) {
        match (write_some(file, buffer, start + done, count - done)) {
            Written(amount) => {
                done = done + amount;
                if (done == count) { pending = false; }
                else if (amount == 0) { return WriteAllFailed(done, os::OsError(os::IoError, os::Runtime, 0 as long)); }
            }
            WriteTimedOut(error) => { return WriteAllTimedOut(done, error); }
            WriteFailed(error) => { return WriteAllFailed(done, error); }
        }
    }
    return WriteComplete(done);
}

/**
 * Move the shared cursor using a signed 64-bit offset.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param offset Offset relative to the chosen origin.
 * @param origin Beginning, current position, or file end.
 * @return The resulting absolute position, or a captured failure such as NotSeekable.
 */
func seek(file: File*, offset: FileOffset, origin: SeekOrigin) -> OffsetResult {
    return _offset_result(rt_file_seek(file._handle, offset, _origin_tag(origin)));
}

/**
 * Query the shared cursor without changing it.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return The absolute position, or a captured failure such as NotSeekable.
 */
func position(file: File*) -> OffsetResult { return _offset_result(rt_file_position(file._handle)); }

/**
 * Read once at an absolute file offset without changing the shared cursor.
 *
 * The destination must already contain the requested logical range. Invalid
 * ranges terminate execution; reads never change its logical size.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Pre-sized destination buffer.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative maximum count within the logical buffer range.
 * @param offset Nonnegative absolute file offset.
 * @return Read count, EOF, timeout, or captured failure including NotSeekable.
 */
func read_at(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int, offset: FileOffset) -> os::ReadResult {
    let context = RangeContext(file._handle, offset);
    return _decode_file_read(bytes::with_raw_range(buffer, start, count, context, _read_at_action));
}

/**
 * Write once at an absolute file offset without changing the shared cursor.
 *
 * Append handles return InvalidInput before transferring bytes. Invalid buffer
 * ranges terminate execution, including invalid empty ranges.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @param buffer Source buffer whose bytes are copied synchronously.
 * @param start Nonnegative logical buffer offset.
 * @param count Nonnegative maximum count within the logical buffer range.
 * @param offset Nonnegative absolute file offset.
 * @return Written count, timeout, or captured failure including NotSeekable.
 */
func write_at(file: File*, buffer: bytes::ByteBuffer*, start: int, count: int, offset: FileOffset) -> os::WriteResult {
    let context = RangeContext(file._handle, offset);
    return _decode_file_write(bytes::with_raw_range(buffer, start, count, context, _write_at_action));
}

/**
 * Query the opened object's byte extent independently of path replacement.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return Its 64-bit size when available, or a captured failure.
 */
func size(file: File*) -> OffsetResult { return _offset_result(rt_file_size(file._handle)); }

/**
 * Set the opened file's byte extent without changing the shared cursor.
 *
 * @param file Live writable wrapper borrowed from an owning OpenFileResult.
 * @param new_size Nonnegative requested extent.
 * @return FsOk, or a captured failure.
 */
func truncate(file: File*, new_size: FileOffset) -> fs::FsResult {
    return fs::_fs_status(rt_file_truncate(file._handle, new_size));
}

/**
 * Query metadata directly from the opened object without resolving its original path.
 *
 * Renaming or replacing that path cannot redirect the query. Persistent sizes
 * and timestamp seconds remain 64-bit; unavailable fields remain null.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return The shared filesystem metadata record, or a captured failure.
 */
func metadata(file: File*) -> fs::MetadataResult {
    let result = rt_file_metadata(file._handle);
    if (result.ok) {
        return fs::FoundMetadata(fs::Metadata(fs::_fs_type(result.file_type), result.size,
            result.mtime_sec, result.mtime_nsec));
    }
    return fs::MetadataFailed(os::_os_error_from_rt(result.error));
}

/**
 * Validate a live direct-I/O handle without requesting durability.
 *
 * There is no library buffer to flush. Closed live wrappers return InvalidHandle.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return Flushed for a live native handle, otherwise FlushFailed.
 */
func flush(file: File*) -> os::FlushResult {
    let result = rt_file_flush(file._handle);
    if (result.ok) { return os::Flushed; }
    return os::FlushFailed(os::_os_error_from_rt(result.error));
}

/**
 * Request data synchronization as a minimum guarantee.
 *
 * The host may provide stronger full synchronization. Unsupported means the
 * requested minimum is unavailable; success retains the host's actual guarantees.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return FsOk, Unsupported, or another captured failure.
 */
func sync_data(file: File*) -> fs::FsResult { return fs::_fs_status(rt_file_sync_data(file._handle)); }

/**
 * Request data and associated metadata synchronization.
 *
 * @param file Live wrapper borrowed from an owning OpenFileResult.
 * @return FsOk, Unsupported, or another captured failure under the host's guarantees.
 */
func sync_all(file: File*) -> fs::FsResult { return fs::_fs_status(rt_file_sync_all(file._handle)); }
