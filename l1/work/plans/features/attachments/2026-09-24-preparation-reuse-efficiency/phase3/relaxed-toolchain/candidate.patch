+/** Compare all represented fields except the four experimental identity/change stamps. */
+static int pc_experimental_metadata_equal(const PcJson *previous, const PcJson *current) {
+    const PcJson *field;
+    if (!previous || !current || previous->type != PJ_OBJECT || current->type != PJ_OBJECT)
+        return 0;
+    for (field = previous->child; field; field = field->next) {
+        if (!strcmp(field->key, "device") || !strcmp(field->key, "inode") ||
+            !strcmp(field->key, "ctime") || !strcmp(field->key, "ctime_ns")) continue;
+        if (!pj_equal(field, pj_get(current, field->key))) return 0;
+    }
+    for (field = current->child; field; field = field->next) {
+        if (!strcmp(field->key, "device") || !strcmp(field->key, "inode") ||
+            !strcmp(field->key, "ctime") || !strcmp(field->key, "ctime_ns")) continue;
+        if (!pj_equal(pj_get(previous, field->key), field)) return 0;
+    }
+    return 1;
+}
+
+/** Limit the experiment to selected regular toolchain inputs and valid digest evidence. */
+static const char *pc_experimental_digest_rejection(const PcJson *old, const PcJson *now,
+                                                   int selected_toolchain_file) {
+    const char *reason = pc_digest_rejection(old, now);
+    if (selected_toolchain_file && reason && !strcmp(reason, "metadata-changed") &&
+        pc_experimental_metadata_equal(pj_get(old, "metadata"), now)) {
+        const PcJson *metadata = pj_get(old, "metadata"), *field;
+        const char *required[] = {"device", "inode", "ctime"};
+        size_t i;
+        for (i = 0; i < sizeof(required) / sizeof(*required); ++i) {
+            field = pj_get(metadata, required[i]);
+            if (!field || field->type != PJ_NUMBER) return reason;
+        }
+        field = pj_get(metadata, "ctime_ns");
+        if (field && field->type != PJ_NUMBER) return reason;
+        return NULL;
+    }
+    return reason;
+}
