module forward;

import aaa.bbb;
import aaa_bbb;

/**
 * Exercise both qualified types in this import order.
 *
 * @return Zero when both modules read the expected fields.
 */
func main() -> int {
    if (read_left() != 17 || read_right() != 25) return 1;
    return 0;
}
