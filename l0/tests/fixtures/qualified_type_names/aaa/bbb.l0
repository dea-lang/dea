module aaa.bbb;

struct V {
    left: int;
}

enum Read_Out {
    Left(value: V);
}

/**
 * Read the dotted module's field through its enum payload.
 *
 * @return The left field value.
 */
func read_left() -> int {
    let result = Left(V(17));
    match (result) {
        Left(v) => { return v.left; }
    }
}
