module main;

import std.string;

struct Box {
    sizeof: int;
    dea_field_sizeof: int;
    ord: int;
    errno: string;
}

enum Item {
    switch(sizeof: string, dea_field_sizeof: int);
    dea_field_switch;
}

struct Limits { EOF: int; _Bool: int; EPIPE: int; _count: int; }
let limits: Limits = Limits(17, 19, 13, 11);
let seed: Item = switch("static", 23);
let errno: int = 3;

func check_item(item: Item, expected: string, number: int) -> bool {
    match (item) {
        switch(text, n) => { return text == expected && n == number; }
        dea_field_switch => { return false; }
    }
}

func main() -> int {
    if (limits.EOF != 17 || limits._Bool != 19 || limits.EPIPE != 13 || limits._count != 11 || errno != 3) return 1;
    if (!check_item(seed, "static", 23)) return 2;
    let b = Box(2, 5, 7, concat_s("ow", "ned"));
    b.sizeof = b.sizeof + 1;
    let p = new Box(b.sizeof, b.dea_field_sizeof, b.ord, b.errno);
    p.dea_field_sizeof = p.dea_field_sizeof + 6;
    p.sizeof = p.sizeof + 1;
    let saved = *p;
    drop p;
    if (saved.sizeof != 4 || saved.dea_field_sizeof != 11 || saved.ord != 7) return 3;
    if (b.sizeof != 3 || b.dea_field_sizeof != 5 || saved.errno != "owned") return 4;

    let dynamic = switch(concat_s(saved.errno, "!"), 29);
    let q = new switch(concat_s("se", "cond"), 31);
    let copied = *q;
    drop q;
    if (!check_item(dynamic, "owned!", 29) || !check_item(copied, "second", 31)) return 5;
    if (check_item(dea_field_switch, "static", 23)) return 6;
    return 0;
}
