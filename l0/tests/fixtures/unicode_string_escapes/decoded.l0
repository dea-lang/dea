module decoded;

import std.string;

func choose(value: string) -> int {
    case (value) {
        "\u00E9" => return 7;
    }
    return 9;
}

func main() -> int {
    if (len_s("\u00E9") != 2 || "\u00E9" != "é") return 1;
    if (len_s("\U0001F600") != 4 || "\U0001F600" != "😀") return 2;
    if (choose("é") != 7 || choose("e") != 9) return 3;
    if (len_s("\\u00E9") != 6 || choose("\\u00E9") != 9) return 4;
    return 0;
}
