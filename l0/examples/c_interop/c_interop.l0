module c_interop;

import std.io;

extern func add_in_c(left: int, right: int) -> int;
extern func multiply_in_c(left: int, right: int) -> int;

/**
 * Calls functions implemented in two additional C translation units.
 *
 * @return 0 on success.
 */
func main() -> int {
    printl_si("C sum:", add_in_c(19, 23));
    printl_si("C product:", multiply_in_c(6, 7));
    return 0;
}
