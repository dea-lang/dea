module driver_test;

import std.io;
import std.string;
import std.vector;
import std.assert;

import source_paths;
import driver;
import util.log;

/**
 * Returns the root directory for test fixtures.
 *
 * @return The driver fixture directory used by these tests.
 */
func fixture_root() -> string {
    return "compiler/stage2_l0/tests/fixtures/driver";
}

/**
 * Creates and configures source search paths for testing.
 *
 * @return Source search paths rooted at the driver fixtures directory.
 */
func make_paths() -> SourceSearchPaths* {
    let sp = sp_create();
    sp_add_project_root(sp, fixture_root());
    return sp;
}

/**
 * Checks if a specific diagnostic code is present in the results.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to look for.
 * @return `true` if the diagnostic code is present, otherwise `false`.
 */
func has_driver_diag_code(result: DriverState*, code: string) -> bool {
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            return true;
        }
    }
    return false;
}

/**
 * Counts diagnostics with the requested code.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to count.
 * @return Number of diagnostics carrying `code`.
 */
func driver_diag_code_count(result: DriverState*, code: string) -> int {
    let found = 0;
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            found = found + 1;
        }
    }
    return found;
}

/**
 * Tests test_transitive_import_closure_ok.
 */
func test_transitive_import_closure_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "ok_main", cfg);

        assert(!driver_has_errors(result), "expected no driver errors for ok_main");
        assert(driver_unit_count(result) == 4, "expected 4 loaded modules in closure");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Retry a failed cycle and then load a repaired diamond with the same driver.
 */
func test_cycle_retry_and_repair() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "cycle_a", cfg);

        assert(driver_has_errors(result), "expected cycle errors");
        for (let i = 0; i < 2; i = i + 1) {
            let before = driver_diag_code_count(result, "DRV-0030");
            assert(!dr_load_module(result, sp, "|", "cycle_a", cfg), "cycle retry succeeded");
            assert(driver_diag_code_count(result, "DRV-0030") == before + 1, "cycle retry lost its diagnostic");
            assert(driver_unit_count(result) == 2, "cycle retry duplicated parsed units");
        }
        sp_add_system_root(sp, fixture_root() + "/repaired imports");
        assert(dr_load_module(result, sp, "|", "cycle_a", cfg), "repaired cycle failed");
        assert(driver_unit_count(result) == 4, "expected four units in the repaired diamond");
        assert(sv_size(result.source_texts) == 4, "expected one source per repaired unit");
        assert(driver_find_unit(result, "cycle_a") != null && driver_find_unit(result, "cycle_b") != null
               && driver_find_unit(result, "ok_dep1") != null && driver_find_unit(result, "ok_leaf") != null,
               "incomplete repaired closure");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Retry a missing dependency, then complete its closure after adding its root.
 */
func test_missing_import_retry_and_repair() {
    with (let sp = sp_create() => sp_free(sp), let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        sp.explicit_entry_name = "ok_dep1";
        sp.explicit_entry_path = fixture_root() + "/ok_dep1.l0";
        with (let state = driver_analyze_entry(sp, "ok_dep1", cfg) => driver_state_free(state)) {
            assert(has_driver_diag_code(state, "DRV-0010"), "expected missing dependency");
            for (let i = 0; i < 2; i = i + 1) {
                let before = driver_diag_code_count(state, "DRV-0010");
                assert(!dr_load_module(state, sp, "|", "ok_dep1", cfg), "missing import retry succeeded");
                assert(driver_diag_code_count(state, "DRV-0010") == before + 1, "expected fresh missing diagnostic");
            }
            sp_add_project_root(sp, fixture_root());
            assert(dr_load_module(state, sp, "|", "ok_dep1", cfg), "retry after repair failed");
            assert(driver_unit_count(state) == 2 && driver_find_unit(state, "ok_leaf") != null,
                   "expected one entry and one repaired dependency");
        }
    }
}

/**
 * Tests test_module_name_mismatch_reports_error.
 */
func test_module_name_mismatch_reports_error() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "mismatch", cfg);

        assert(driver_has_errors(result), "expected mismatch errors");
        assert(has_driver_diag_code(result, "DRV-0020"), "expected DRV-0020 for module mismatch");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Report a missing module when the only candidate is a directory.
 */
func test_directory_is_not_a_source() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "read_fail", cfg);

        assert(driver_has_errors(result), "expected missing source");
        assert(has_driver_diag_code(result, "DRV-0010"), "expected DRV-0010 for a directory");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests test_lexer_errors_recover_into_parser.
 */
func test_lexer_errors_recover_into_parser() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "invalid_chars", cfg);

        assert(driver_has_errors(result), "expected lexer errors");
        assert(driver_diag_code_count(result, "LEX-0040") == 3, "expected three LEX-0040 diagnostics");
        assert(driver_diag_code_count(result, "PAR-0310") == 1, "expected one missing-module-header diagnostic");
        assert(driver_unit_count(result) == 1, "expected one failed unit shell after lexer errors");
        let unit = driver_unit_get(result, 0);
        assert(unit.parse_result.root_module == null, "expected no parsed module without a module header");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Main entry point for the module.
 */
func main() {
    test_transitive_import_closure_ok();
    test_cycle_retry_and_repair();
    test_missing_import_retry_and_repair();
    test_module_name_mismatch_reports_error();
    test_directory_is_not_a_source();
    test_lexer_errors_recover_into_parser();
    printl_s("driver_test: all tests passed");
}
