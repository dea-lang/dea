module driver_test;

import std.io;
import std.string;
import std.assert;

import source_paths;
import driver;
import util.log;

/**
 * Returns the root directory for test fixtures.
 *
 * @return The driver fixture directory used by these tests.
 */
func fixture_root() -> string {
    return "compiler/stage2_l0/tests/fixtures/driver";
}

/**
 * Creates and configures source search paths for testing.
 *
 * @return Source search paths rooted at the driver fixtures directory.
 */
func make_paths() -> SourceSearchPaths* {
    let sp = sp_create();
    sp_add_project_root(sp, fixture_root());
    return sp;
}

/**
 * Checks if a specific diagnostic code is present in the results.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to look for.
 * @return `true` if the diagnostic code is present, otherwise `false`.
 */
func has_driver_diag_code(result: DriverState*, code: string) -> bool {
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            return true;
        }
    }
    return false;
}

/**
 * Counts diagnostics with the requested code.
 *
 * @param result The driver analysis result to inspect.
 * @param code The diagnostic code to count.
 * @return Number of diagnostics carrying `code`.
 */
func driver_diag_code_count(result: DriverState*, code: string) -> int {
    let found = 0;
    for (let i = 0; i < driver_diag_count(result); i = i + 1) {
        let d = driver_diag_get(result, i);
        if (d.code == code) {
            found = found + 1;
        }
    }
    return found;
}

/**
 * Tests test_transitive_import_closure_ok.
 */
func test_transitive_import_closure_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "ok_main", cfg);

        assert(!driver_has_errors(result), "expected no driver errors for ok_main");
        assert(driver_unit_count(result) == 4, "expected 4 loaded modules in closure");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests test_import_cycle_reports_error.
 */
func test_import_cycle_reports_error() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "cycle_a", cfg);

        assert(driver_has_errors(result), "expected cycle errors");
        assert(has_driver_diag_code(result, "DRV-0030"), "expected DRV-0030 for cycle");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests test_module_name_mismatch_reports_error.
 */
func test_module_name_mismatch_reports_error() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "mismatch", cfg);

        assert(driver_has_errors(result), "expected mismatch errors");
        assert(has_driver_diag_code(result, "DRV-0020"), "expected DRV-0020 for module mismatch");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests test_read_failure_reports_error.
 */
func test_read_failure_reports_error() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "read_fail", cfg);

        assert(driver_has_errors(result), "expected read failure errors");
        assert(has_driver_diag_code(result, "DRV-0011"), "expected DRV-0011 for read failure");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Tests test_lexer_errors_skip_parser_phase.
 */
func test_lexer_errors_skip_parser_phase() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = driver_analyze_entry(sp, "invalid_chars", cfg);

        assert(driver_has_errors(result), "expected lexer errors");
        assert(driver_diag_code_count(result, "LEX-0040") == 3, "expected three LEX-0040 diagnostics");
        assert(!has_driver_diag_code(result, "PAR-0310"), "did not expect parser diagnostics after lexer errors");
        assert(driver_unit_count(result) == 1, "expected one failed unit shell after lexer errors");
        let unit = driver_unit_get(result, 0);
        assert(unit.parse_result.root_module == null, "expected no parsed module after lexer errors");

        driver_state_free(result);
    }
    sp_free(sp);
}

/**
 * Main entry point for the module.
 */
func main() {
    test_transitive_import_closure_ok();
    test_import_cycle_reports_error();
    test_module_name_mismatch_reports_error();
    test_read_failure_reports_error();
    test_lexer_errors_skip_parser_phase();
    printl_s("driver_test: all tests passed");
}
