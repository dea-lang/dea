module lexer_test;

import std.io;
import std.string;
import std.assert;

import tokens;
import lexer;
import util.diag;

/**
 * Helper function to print a labeled boolean value.
 *
 * @param label The label to print.
 * @param val The value to process.
 */
func print_bool(label: string, val: bool) {
    if (val) {
        printl_ss(label, "true");
    } else {
        printl_ss(label, "false");
    }
}

/**
 * Lexes source and asserts the first lexer diagnostic code.
 *
 * @param source Source text to lex.
 * @param expected Expected first diagnostic code.
 */
func expect_lex_error(source: string, expected: string) {
    let ls = ls_create(source, "<test>");
    let toks = tokenize(ls);
    if (toks != null) {
        let tv = toks as TokenVector;
        assert(tv_len(tv) >= 1, "Expected at least one token");
        let tok = tv_get(tv, 0);
        match (tok.token_type) {
            TT_LEXER_ERROR(code, message, line_end, column_end, recovery) => {
                if (code != expected) {
                    printl_ss("actual error code:", code);
                    printl_ss("actual error message:", message);
                    assert(false, "Unexpected lexer diagnostic code");
                }
            }
            _ => {
                printl_ss("actual token:", token_to_string(tok));
                assert(false, "Expected lexer-error wrapper token");
            }
        }
        tv_free(tv);
    } else {
        assert(ls_has_errors(ls), "Expected lexer diagnostics");
        assert(diag_count(ls.diags) > 0, "Expected at least one diagnostic");

        let diag = diag_get(ls.diags, 0);
        if (diag.code != expected) {
            printl_ss("actual error code:", diag.code);
            printl_ss("actual error message:", diag.message);
            assert(false, "Unexpected lexer diagnostic code");
        }
    }

    ls_free(ls);
}

/**
 * Lexes source and asserts the first two tokens are lexer-error wrappers.
 *
 * @param source Source text to lex.
 * @param expected_first Expected diagnostic code for token 0.
 * @param expected_second Expected diagnostic code for token 1.
 */
func expect_two_lex_error_tokens(source: string, expected_first: string, expected_second: string) {
    let ls = ls_create(source, "<test>");
    let toks = tokenize(ls);
    assert(toks != null, "Expected recoverable lexing to succeed");

    let tv = toks as TokenVector;
    assert(tv_len(tv) == 3, "Expected two lexer-error tokens plus EOF");

    let tok0 = tv_get(tv, 0);
    let tok1 = tv_get(tv, 1);
    let tok2 = tv_get(tv, 2);

    match (tok0.token_type) {
        TT_LEXER_ERROR(code, message, line_end, column_end, recovery) => {
            assert(code == expected_first, "Unexpected first lexer diagnostic code");
        }
        _ => {
            printl_ss("actual token 0:", token_to_string(tok0));
            assert(false, "Expected first token to be a lexer-error wrapper");
        }
    }

    match (tok1.token_type) {
        TT_LEXER_ERROR(code, message, line_end, column_end, recovery) => {
            assert(code == expected_second, "Unexpected second lexer diagnostic code");
        }
        _ => {
            printl_ss("actual token 1:", token_to_string(tok1));
            assert(false, "Expected second token to be a lexer-error wrapper");
        }
    }

    match (tok2.token_type) {
        TT_EOF => {}
        _ => {
            printl_ss("actual token 2:", token_to_string(tok2));
            assert(false, "Expected EOF after queued lexer-error wrappers");
        }
    }

    tv_free(tv);
    ls_free(ls);
}

/**
 * Assert that one or more recovery wrappers leave the following minus binary.
 *
 * @param source Source ending in ` -5` after the recovered literal.
 * @param wrapper_count Number of leading physical lexer-error wrappers.
 */
func expect_recovery_then_binary_minus(source: string, wrapper_count: int) {
    let ls = ls_create(source, "<test>");
    let toks = tokenize(ls);
    assert(toks != null, "Expected recoverable lexing to succeed");

    let tv = toks as TokenVector;
    if (tv_len(tv) != wrapper_count + 3) {
        printl_ss("unexpected recovery source:", source);
        for (let i = 0; i < tv_len(tv); i = i + 1) {
            printl_ss("unexpected recovery token:", token_to_string(tv_get(tv, i)));
        }
        assert(false, "Expected wrappers, binary minus, integer, and EOF");
    }
    for (let i = 0; i < wrapper_count; i = i + 1) {
        let tok = tv_get(tv, i);
        match (tok.token_type) {
            TT_LEXER_ERROR(code, message, line_end, column_end, recovery) => {
                if (i + 1 == wrapper_count) {
                    assert(token_recovery_is_some(recovery), "Expected final wrapper recovery token");
                    assert(token_logical_predecessor_ends_expression(tok, false),
                           "Expected recovery token to end an expression");
                } else {
                    assert(!token_recovery_is_some(recovery), "Expected queued wrapper without recovery");
                }
            }
            _ => { assert(false, "Expected lexer-error wrapper"); }
        }
    }

    let minus_token = tv_get(tv, wrapper_count);
    match (minus_token.token_type) {
        TT_MINUS => {}
        _ => { assert(false, "Expected binary minus after recovered expression"); }
    }
    let int_token = tv_get(tv, wrapper_count + 1);
    match (int_token.token_type) {
        TT_INT(text, value) => { assert(text == "5", "Expected positive integer after binary minus"); }
        _ => { assert(false, "Expected positive integer token"); }
    }
    let eof_token = tv_get(tv, wrapper_count + 2);
    match (eof_token.token_type) {
        TT_EOF => {}
        _ => { assert(false, "Expected EOF"); }
    }

    tv_free(tv);
    ls_free(ls);
}

/**
 * Test parser-visible recovery tokens drive signed-literal context.
 */
func test_recovery_token_minus_context() {
    expect_recovery_then_binary_minus("2147483648 -5", 1);
    expect_recovery_then_binary_minus("\"\\q\" -5", 1);
    expect_recovery_then_binary_minus("'a -5", 1);
    expect_recovery_then_binary_minus("\"\\q\n -5", 2);

    let suffix_ls = ls_create("123abc", "<test>");
    let suffix_toks = tokenize(suffix_ls);
    assert(suffix_toks != null, "Expected malformed numeric suffix recovery");
    let suffix_tv = suffix_toks as TokenVector;
    let suffix_token = tv_get(suffix_tv, 0);
    assert(token_logical_predecessor_ends_expression(suffix_token, false),
           "Expected malformed numeric suffix recovery to end an expression");
    tv_free(suffix_tv);
    ls_free(suffix_ls);
}

/**
 * Test no-recovery wrappers retain rather than replace logical context.
 */
func test_no_recovery_wrapper_minus_context() {
    let operand_ls = ls_create("1 @ -5", "<test>");
    let operand_toks = tokenize(operand_ls);
    assert(operand_toks != null, "Expected invalid-character recovery");
    let operand_tv = operand_toks as TokenVector;
    assert(tv_len(operand_tv) == 5, "Unexpected operand recovery token count");
    let operand_minus = tv_get(operand_tv, 2);
    match (operand_minus.token_type) {
        TT_MINUS => {}
        _ => { assert(false, "Expected binary minus after skipped wrapper"); }
    }
    let operand_int = tv_get(operand_tv, 3);
    match (operand_int.token_type) {
        TT_INT(text, value) => { assert(text == "5", "Expected positive right operand"); }
        _ => { assert(false, "Expected integer right operand"); }
    }
    tv_free(operand_tv);
    ls_free(operand_ls);

    let operator_ls = ls_create("+ @ -5", "<test>");
    let operator_toks = tokenize(operator_ls);
    assert(operator_toks != null, "Expected invalid-character recovery");
    let operator_tv = operator_toks as TokenVector;
    assert(tv_len(operator_tv) == 4, "Unexpected operator recovery token count");
    let operator_int = tv_get(operator_tv, 2);
    match (operator_int.token_type) {
        TT_INT(text, value) => { assert(text == "-5", "Expected unary signed literal after skipped wrapper"); }
        _ => { assert(false, "Expected signed integer token"); }
    }
    tv_free(operator_tv);
    ls_free(operator_ls);
}

/**
 * Tests recoverable lexer diagnostics return wrapper tokens.
 */
func test_recoverable_lexer_errors_are_tokens() {
    expect_lex_error("\"unterminated", "LEX-0010");
    expect_lex_error("\"\\xGG\"", "LEX-0050");
    expect_lex_error("\"\\q\"", "LEX-0059");
    expect_lex_error("'a", "LEX-0021");
    expect_lex_error("'\\u0100'", "LEX-0030");
    expect_lex_error("2147483648", "LEX-0060");
    expect_lex_error("123abc", "LEX-0061");
}

/**
 * Tests one malformed literal can emit multiple lexer-error wrapper tokens.
 */
func test_recoverable_lexer_errors_can_queue_multiple_wrappers() {
    expect_two_lex_error_tokens("\"\\q\n", "LEX-0059", "LEX-0010");
}

/**
 * Tests test_token_vector.
 */
func test_token_vector() {
    printl_s("=== TokenVector Test ===");

    // Create TokenVector
    printl_s("Creating TokenVector...");
    let tv = tv_create();
    printl_si("Initial length:", tv_len(tv));

    // Create some test tokens
    printl_s("\nPushing tokens...");
    let tok1 = Token(TT_MODULE, 0, 1, 1);
    let tok2 = Token(TT_IDENT("foo"), 7, 1, 8);
    let tok3 = Token(TT_SEMI, 10, 1, 11);
    let tok4 = Token(TT_EOF, 11, 1, 12);

    tv_push(tv, tok1);
    tv_push(tv, tok2);
    tv_push(tv, tok3);
    tv_push(tv, tok4);
    printl_si("Length after pushing 4 tokens:", tv_len(tv));

    // Test get
    printl_s("\nTesting get...");
    for (let i = 0; i < tv_len(tv); i = i + 1) {
        let tok = tv_get(tv, i);
        printl_si("  Token at index:", i);
        printl_ss("    type:", token_to_string(tok));
        printl_si("    line:", tok.line);
        printl_si("    column:", tok.column);
    }

    tv_free(tv);
    printl_s("\nDone!");
}

/**
 * Main entry point for the module.
 */
func main() {
    test_token_vector();
    test_recoverable_lexer_errors_are_tokens();
    test_recoverable_lexer_errors_can_queue_multiple_wrappers();
    test_recovery_token_minus_context();
    test_no_recovery_wrapper_minus_context();
}
