module string_vector_test;

import std.assert;
import std.io;
import std.string;
import std.vector;

/**
 * Tests test_basic.
 */
func test_basic() {
    printl_s("=== Basic StringVector Test ===");
    let vs = sv_create(1);
    printl_si("Current size:", sv_size(vs));
    printl_si("Current capacity:", sv_capacity(vs));
    printl_s("Pushing strings into vector...");
    let s1 = "Hello, World!";
    let s2 = "L0 Programming Language";
    let s3 = "StringVector Test";
    let s4 = "Goodbye!";
    let s5 = "Still more strings...";
    sv_push(vs, s1);
    sv_push(vs, s2);
    sv_push(vs, s3);
    sv_push(vs, s4);
    printl_si("Current size:", sv_size(vs));
    printl_si("Current capacity:", sv_capacity(vs));
    printl_s("Pushing another string to trigger resize...");
    sv_push(vs, s5);
    printl_si("Current size:", sv_size(vs));
    printl_si("Current capacity:", sv_capacity(vs));
    printl_s("Vector contents:");
    for (let i = 0; i < sv_size(vs); i = i + 1) {
        let si = sv_get(vs, i);
        printl_is(i, si);
    }
    printl_si("Current size:", sv_size(vs));
    printl_si("Current capacity:", sv_capacity(vs));
    printl_s("Freeing vector...");
    sv_free(vs);
    printl_s("Basic test passed!\n");
}

/**
 * Tests test_empty_vector.
 */
func test_empty_vector() {
    printl_s("=== Empty StringVector Test ===");

    // Test with capacity 1
    printl_s("Creating empty vector with capacity 1...");
    let vs1 = sv_create(1);
    printl_si("  size (should be 0):", sv_size(vs1));
    printl_si("  capacity (should be 1):", sv_capacity(vs1));
    sv_free(vs1);

    // Test with larger initial capacity
    printl_s("Creating empty vector with capacity 16...");
    let vs2 = sv_create(16);
    printl_si("  size (should be 0):", sv_size(vs2));
    printl_si("  capacity (should be 16):", sv_capacity(vs2));
    sv_free(vs2);

    printl_s("Empty vector test passed!\n");
}

/**
 * Tests test_multiple_resizes.
 */
func test_multiple_resizes() {
    printl_s("=== Multiple Resizes Test ===");

    // Start with minimal capacity to force many resizes
    printl_s("Creating vector with capacity 1, pushing 20 strings...");
    let vs = sv_create(1);

    // Use pre-defined strings to avoid int_to_s
    sv_push(vs, "String 0");
    printl_s("  After push 1:");
    printl_si("    size:", sv_size(vs));
    printl_si("    capacity:", sv_capacity(vs));

    sv_push(vs, "String 1");
    printl_s("  After push 2:");
    printl_si("    size:", sv_size(vs));
    printl_si("    capacity:", sv_capacity(vs));

    sv_push(vs, "String 2");
    sv_push(vs, "String 3");
    printl_s("  After push 4:");
    printl_si("    size:", sv_size(vs));
    printl_si("    capacity:", sv_capacity(vs));

    // Push more to trigger resizes
    sv_push(vs, "String 4");
    sv_push(vs, "String 5");
    sv_push(vs, "String 6");
    sv_push(vs, "String 7");
    printl_s("  After push 8:");
    printl_si("    size:", sv_size(vs));
    printl_si("    capacity:", sv_capacity(vs));

    // Push 12 more strings
    sv_push(vs, "String 8");
    sv_push(vs, "String 9");
    sv_push(vs, "String 10");
    sv_push(vs, "String 11");
    sv_push(vs, "String 12");
    sv_push(vs, "String 13");
    sv_push(vs, "String 14");
    sv_push(vs, "String 15");
    printl_s("  After push 16:");
    printl_si("    size:", sv_size(vs));
    printl_si("    capacity:", sv_capacity(vs));

    sv_push(vs, "String 16");
    sv_push(vs, "String 17");
    sv_push(vs, "String 18");
    sv_push(vs, "String 19");

    printl_s("Final vector state:");
    printl_si("  size:", sv_size(vs));
    printl_si("  capacity:", sv_capacity(vs));

    // Verify first and last elements
    printl_ss("  First element:", sv_get(vs, 0));
    printl_ss("  Last element:", sv_get(vs, 19));

    sv_free(vs);
    printl_s("Multiple resizes test passed!\n");
}

/**
 * Tests test_single_element.
 */
func test_single_element() {
    printl_s("=== Single Element Test ===");

    let vs = sv_create(1);
    printl_s("Pushing single element...");
    sv_push(vs, "Only one");

    printl_si("  size:", sv_size(vs));
    printl_si("  capacity:", sv_capacity(vs));
    printl_ss("  element:", sv_get(vs, 0));

    sv_free(vs);
    printl_s("Single element test passed!\n");
}

/**
 * Tests test_sv_sort.
 */
func test_sv_sort() {
    printl_s("=== Test sv_sort ===");

    let empty = sv_create(1);
    sv_sort(empty);
    assert(sv_size(empty) == 0, "sv_sort: empty vector size should remain 0");
    sv_free(empty);

    let single = sv_create(1);
    sv_push(single, "only");
    sv_sort(single);
    assert(sv_size(single) == 1, "sv_sort: single vector size should remain 1");
    assert(sv_get(single, 0) == "only", "sv_sort: single value should remain unchanged");
    sv_free(single);

    let vs = sv_create(8);
    sv_push(vs, "b");
    sv_push(vs, "ab");
    sv_push(vs, "a");
    sv_push(vs, "aa");
    sv_push(vs, "ab");
    sv_push(vs, "");
    sv_sort(vs);

    assert(sv_size(vs) == 6, "sv_sort: size should remain unchanged");
    assert(sv_get(vs, 0) == "", "sv_sort: index 0 mismatch");
    assert(sv_get(vs, 1) == "a", "sv_sort: index 1 mismatch");
    assert(sv_get(vs, 2) == "aa", "sv_sort: index 2 mismatch");
    assert(sv_get(vs, 3) == "ab", "sv_sort: index 3 mismatch");
    assert(sv_get(vs, 4) == "ab", "sv_sort: index 4 mismatch");
    assert(sv_get(vs, 5) == "b", "sv_sort: index 5 mismatch");
    sv_free(vs);

    let sorted = sv_create(4);
    sv_push(sorted, "alpha");
    sv_push(sorted, "beta");
    sv_push(sorted, "gamma");
    sv_sort(sorted);
    assert(sv_get(sorted, 0) == "alpha", "sv_sort: sorted index 0 mismatch");
    assert(sv_get(sorted, 1) == "beta", "sv_sort: sorted index 1 mismatch");
    assert(sv_get(sorted, 2) == "gamma", "sv_sort: sorted index 2 mismatch");
    sv_free(sorted);

    printl_s("sv_sort tests passed!\n");
}

/**
 * Main entry point for the module.
 */
func main() {
    printl_s("==========================================");
    printl_s("       StringVector Test Suite");
    printl_s("==========================================\n");

    test_basic();
    test_empty_vector();
    test_multiple_resizes();
    test_single_element();
    test_sv_sort();

    printl_s("==========================================");
    printl_s("   All StringVector tests passed!");
    printl_s("==========================================");
}
