            "parenthesized cast from an ARC rvalue should materialize a cleanup temp");
        assert(contains_s(generated, "rt_string_release(l0_arc_"),
            "parenthesized cast from an ARC rvalue should schedule temp cleanup");

        analysis_result_free(result);
    }
}

/**
 * Tests parenthesized nullable wrapping balances borrowed temps and transfers owned retains.
 */
func test_backend_generate_parenthesized_wrap_from_place_owner_boundaries() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(16) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func is_present(value: string?) -> bool {");
        sv_push(lines, "    return value != null;");
        sv_push(lines, "}");
        sv_push(lines, "func borrowed_wrap(value: string) -> bool {");
        sv_push(lines, "    return is_present(((value as string?)));");
        sv_push(lines, "}");
        sv_push(lines, "func owner_wrap(value: string) -> string? {");
        sv_push(lines, "    return ((value as string?));");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for parenthesized nullable-wrap fixture");

        let generated = backend_generate(result, opts, cfg);
        let borrowed_start = find_last_s(generated, "l0_bool l0_demo_main_borrowed_wrap(");
        let owner_start = find_last_s(generated, "l0_opt_string l0_demo_main_owner_wrap(");
        let main_start = find_last_s(generated, "l0_int l0_demo_main_main(");
        assert(borrowed_start >= 0 && borrowed_start < owner_start && owner_start < main_start,
            "nullable-wrap function definition ordering mismatch");

        let borrowed_body = slice_s(generated, borrowed_start, owner_start);
        let owner_body = slice_s(generated, owner_start, main_start);
        let borrowed_retain = find_s(borrowed_body, "rt_string_retain(");
        let borrowed_retain2 = find_from_s(borrowed_body, "rt_string_retain(", borrowed_retain + 1);
        let borrowed_release = find_s(borrowed_body, "rt_string_release(");
        let borrowed_release2 = find_from_s(borrowed_body, "rt_string_release(", borrowed_release + 1);
        assert(borrowed_retain >= 0 && borrowed_retain2 < 0,
            "borrowed wrapped place should retain exactly once");
        assert(borrowed_release >= 0 && borrowed_release2 < 0,
            "borrowed wrapped-place temp should release exactly once after the call");
        assert(contains_s(borrowed_body, "l0_opt_string l0_arc_"),
            "borrowed wrapped place should materialize one owned optional temp");
        let owner_retain = find_s(owner_body, "rt_string_retain(");
        let owner_retain2 = find_from_s(owner_body, "rt_string_retain(", owner_retain + 1);
        assert(owner_retain >= 0 && owner_retain2 < 0,
            "returning a wrapped place should transfer exactly one eager retain");
        assert(!contains_s(owner_body, "l0_opt_string l0_arc_"),
            "returning a wrapped place should not create a second owner temp");

        analysis_result_free(result);
    }
}

/**
 * Tests string equality and inequality lowering through the runtime helper.
 */
func test_backend_generate_string_equality_ops() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(12) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let lhs = \"dea\";");
        sv_push(lines, "    let same = \"dea\";");
        sv_push(lines, "    let different = \"dea!\";");
        sv_push(lines, "    if (lhs == same && lhs != different) {");
        sv_push(lines, "        return 23;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string equality fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "rt_string_equals(lhs, same)"), "string equality should lower through runtime helper");
        assert(contains_s(generated, "(!rt_string_equals(lhs, different))"),
            "string inequality should lower through negated runtime helper");

        analysis_result_free(result);
    }
}

/**
 * Tests string relational lowering through the runtime helper.
 */
func test_backend_generate_string_relational_ops() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(14) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let lhs = \"dea\";");
        sv_push(lines, "    let same = \"dea\";");
        sv_push(lines, "    let longer = \"dea!\";");
        sv_push(lines, "    let higher = \"deb\";");
        sv_push(lines, "    if (lhs < longer && lhs <= same && higher > lhs && higher >= same) {");
        sv_push(lines, "        return 23;");
        sv_push(lines, "    }");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string relational fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "(rt_string_compare(lhs, longer) < 0)"),
            "string less-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(lhs, same) <= 0)"),
            "string less-equal should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, lhs) > 0)"),
            "string greater-than should lower through runtime helper");
        assert(contains_s(generated, "(rt_string_compare(higher, same) >= 0)"),
            "string greater-equal should lower through runtime helper");

        analysis_result_free(result);
    }
}

/**
 * Tests string concatenation lowering through the runtime helper.
 */
func test_backend_generate_string_concat_ops() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(12) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> string {");
        sv_push(lines, "    let a = \"hel\";");
        sv_push(lines, "    let b = \"lo\";");
        sv_push(lines, "    return a + b;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for string concat fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "rt_string_concat(a, b)"), "string concat should lower through runtime helper");

        analysis_result_free(result);
    }
}

/** Tests generated literals and line-directive filenames are trigraph-safe. */
func test_backend_generate_trigraph_safe_c_strings() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(6) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        sv_push(filenames, "demo/??=/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func main() -> string {");
        sv_push(lines, "    return \"??=??/??'??(??)??!??<??>??-\";");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "trigraph string fixture should analyze");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "\"demo/?\\?=/main.l0\""),
            "generated line directive should escape trigraph spelling");
        assert(contains_s(generated,
            "L0_STRING_CONST(\"?\\?=?\\?/?\\?'?\\?(?\\?)?\\?!?\\?<?\\?>?\\?-\", 27)"),
            "generated string literal should escape all trigraph spellings");

        analysis_result_free(result);
    }
}

/**
 * Main entry point for the module.
 */
func main() {
    test_codegen_options_defaults();
    test_scope_context_tracks_declared_and_owned_variables();
    test_scope_context_inline_cleanup_tracking();
    test_backend_scope_helpers_manage_cleanup_state();
    test_analysis_expr_lookup_helpers();
    test_analysis_has_arc_data_for_struct_and_nullable_pointer();
    test_backend_generate_types_and_top_level_lets();
    test_backend_generate_basic_control_flow();
    test_backend_generate_loop_exit_case_lowering();
    test_backend_generate_match_and_with_cleanup_block();
    test_backend_generate_with_cleanup_block_header_try_predeclares_nullable_lets();
    test_backend_generate_drop_statement();
    test_backend_generate_drop_begin_before_struct_cleanup();
    test_backend_generate_new_and_try_lowering();
    test_backend_generate_deref_field_write_uses_write_mode();
    test_backend_generate_intrinsics_use_analyzed_target_types();
    test_backend_generate_string_copy_retains();
    test_backend_generate_identity_cast_string_copy_retains();
    test_backend_generate_parenthesized_unwrap_from_place_stays_borrowed();
    test_backend_generate_parenthesized_rvalue_cast_materializes_arc_temp();
    test_backend_generate_parenthesized_wrap_from_place_owner_boundaries();
    test_backend_generate_string_equality_ops();
    test_backend_generate_string_relational_ops();
    test_backend_generate_string_concat_ops();
    test_backend_generate_trigraph_safe_c_strings();
    printl_s("backend_test: all tests passed");
}
