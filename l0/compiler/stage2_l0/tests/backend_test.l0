/**
 * Tests casted-place string copies still retain before entering a new owner.
 */
func test_backend_generate_identity_cast_string_copy_retains() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(8) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "func sink(x: string) {}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    let first = \"hi\";");
        sv_push(lines, "    sink(first as string);");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for identity-cast ARC copy fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(contains_s(generated, "l0_demo_main_sink(first);"),
            "identity cast should pass the borrowed place directly to the callee");
        assert(!contains_s(generated, "l0_string l0_arc_"),
            "identity cast should not materialize a scope-owned ARC temp");
        assert(!contains_s(generated, "rt_string_release(l0_arc_"),
            "identity cast should not release a temporary ARC alias after the call");

        analysis_result_free(result);
    }
}

/**
 * Tests parenthesized cast-from-place expressions preserve ARC ownership classification.
 */
func test_backend_generate_parenthesized_unwrap_from_place_stays_borrowed() {
    with (let filenames = sv_create(1) => sv_free(filenames),
          let sources = sv_create(1) => sv_free(sources),
          let lines = sv_create(32) => sv_free(lines),
          let cfg = log_config_create(LL_ERROR, false) => drop cfg,
          let opts = cg_options_create() => cg_options_free(opts)) {
        opts.emit_line_directives = false;
        sv_push(filenames, "demo/main.l0");
        sv_push(lines, "module demo.main;");
        sv_push(lines, "struct Box {");
        sv_push(lines, "    value: string?;");
        sv_push(lines, "}");
        sv_push(lines, "func accepts(value: string) -> bool {");
        sv_push(lines, "    return value != \"\";");
        sv_push(lines, "}");
        sv_push(lines, "func local_matches(value: string?, expected: string) -> bool {");
        sv_push(lines, "    return value != null && (value as string) == expected;");
        sv_push(lines, "}");
        sv_push(lines, "func repeated_call(value: string?) -> bool {");
        sv_push(lines, "    return value != null && accepts((((value as string))));");
        sv_push(lines, "}");
        sv_push(lines, "func field_matches(box: Box*, expected: string) -> bool {");
        sv_push(lines, "    return box.value != null && (((box.value as string))) == expected;");
        sv_push(lines, "}");
        sv_push(lines, "func owner_copy(value: string?) -> string {");
        sv_push(lines, "    return ((value as string));");
        sv_push(lines, "}");
        sv_push(lines, "func main() -> int {");
        sv_push(lines, "    return 0;");
        sv_push(lines, "}");
        sv_push(sources, bt_source(lines));

        let result = bt_analyze_sources("demo.main", filenames, sources);
        assert(!analysis_has_errors(result), "analysis should succeed for parenthesized unwrap fixture");

        let generated = backend_generate(result, opts, cfg);
        assert(!contains_s(generated, "l0_string l0_arc_"),
            "parenthesized cast from a place should not materialize an ARC alias temp");
        assert(!contains_s(generated, "rt_string_release(l0_arc_"),
            "parenthesized cast from a place should not schedule ARC alias cleanup");
        assert(contains_s(generated, "rt_string_retain(l0_copy_"),
            "returning a parenthesized unwrap should retain the new owner");

        analysis_result_free(result);
    }
}

