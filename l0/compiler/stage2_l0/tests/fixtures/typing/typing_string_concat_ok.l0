module typing_string_concat_ok;

func literal_and_alias_concat(seed: string) -> bool {
    let alias = seed;
    let combined = alias + "!";
    return combined == "dea!" && ("" + alias) == seed;
}

func main() -> int {
    let left = "de";
    let right = "a";
    let combined = left + right;
    if (literal_and_alias_concat("dea") && combined == "dea") {
        return 1;
    }
    return 0;
}
