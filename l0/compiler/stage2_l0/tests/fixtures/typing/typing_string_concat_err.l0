module typing_string_concat_err;

func err_string_int(a: string, b: int) -> string {
    return a + b; // TYP-0170
}

func err_int_string(a: int, b: string) -> string {
    return a + b; // TYP-0170
}

func err_string_null(a: string, b: int?) -> string {
    return a + b; // TYP-0170
}
