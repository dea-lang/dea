module typing_binding_identity_ok;

enum Payload {
    Number(value: int);
    Text(value: string);
}

enum NumberBox {
    BoxedNumber(value: int);
}

enum TextBox {
    BoxedText(value: string);
}

func maybe_value() -> int? {
    return 1 as int?;
}

func declaration_order(outer: int) -> int {
    {
        let before: int = outer + 1;
        let outer: string = "later";
        before;
        outer;
    }
    return outer;
}

func bare_case_scopes(value: int) {
    case (value) {
        0 => let value: string = "zero";
        _ => let value: bool = true;
    }
}

func nested_single_case_scope(value: int) {
    case (value) {
        0 => for (let i: int = 0; i < 1; i = i + 1) {
            let captured: int = value + i;
            captured;
        }
        _ => value;
    }
}

func cross_arm_identity(payload: Payload) -> int {
    match (payload) {
        Number(value) => { return value + 1; }
        Text(value) => {
            let copy: string = value;
            copy;
            return 0;
        }
    }
}

func number_identity(payload: NumberBox) -> int {
    match (payload) {
        BoxedNumber(value) => { return value + 1; }
    }
}

func text_identity(payload: TextBox) -> string {
    match (payload) {
        BoxedText(value) => { return value; }
    }
}

func nested_identity(outer: NumberBox, inner: TextBox) -> int {
    match (outer) {
        BoxedNumber(value) => {
            match (inner) {
                BoxedText(value) => {
                    let copy: string = value;
                    copy;
                }
            }
            return value + 1;
        }
    }
}

func cleanup_shadow_identity() -> int? {
    with (let guarded: int = maybe_value()?) {
    } cleanup {
        {
            let guarded: int = 1;
            guarded;
        }
    }
    return 0 as int?;
}
