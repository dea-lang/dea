/**
 * Tests same-type struct casts lower without a pedantic-invalid C cast.
 */
func test_run_same_type_struct_cast_builds() {
    let out_path = run_keep_c_output_path();
    let c_path = run_keep_c_c_path();
    rt_delete_file(out_path);
    rt_delete_file(c_path);

    with (let argv = vs_create(12) => vs_free(argv)) {
        vs_push(argv, "--run");
        vs_push(argv, "--keep-c");
        vs_push(argv, "-P");
        vs_push(argv, fixture_root());
        vs_push(argv, "--output");
        vs_push(argv, out_path);
        vs_push(argv, "same_type_struct_cast_main");

        let rc = run_with_argv(argv);
        assert(rc == 0, "same-type struct cast should compile and execute under pedantic C99");
    }

    assert(exists(c_path), "run kept-C file should exist for same_type_struct_cast_main");

    let c_text = read_file(c_path);
    assert(c_text != null, "same_type_struct_cast_main kept C file should exist");
    assert(!contains_s(c_text as string, "l0_same_type_struct_cast_main_pl(((struct l0_same_type_struct_cast_main_Token)("),
        "same-type struct cast should not lower to a C struct cast");

    rt_delete_file(out_path);
    rt_delete_file(c_path);
}

/**
 * Tests string equality and inequality execution in `--run --keep-c` mode.
 */
func test_run_string_equality_build_and_keep_c() {
    let out_path = run_keep_c_output_path();
    let c_path = run_keep_c_c_path();
    rt_delete_file(out_path);
    rt_delete_file(c_path);

    with (let argv = vs_create(12) => vs_free(argv)) {
        vs_push(argv, "--run");
        vs_push(argv, "--keep-c");
        vs_push(argv, "-P");
        vs_push(argv, fixture_root());
        vs_push(argv, "--output");
        vs_push(argv, out_path);
        vs_push(argv, "string_equality_main");

        let rc = run_with_argv(argv);
        assert(rc == 23, "--run --keep-c should compile and execute string_equality_main");
    }

    let c_text = read_file(c_path);
    assert(c_text != null, "string_equality_main kept C file should exist");
    assert(contains_s(c_text as string, "rt_string_equals(lit, same_lit)"),
        "string_equality_main equality lowering mismatch");
    assert(contains_s(c_text as string, "(!rt_string_equals(lit, different_lit))"),
        "string_equality_main inequality lowering mismatch");
    assert(contains_s(c_text as string, "rt_string_equals(built_a, built_b)"),
        "string_equality_main heap-string equality lowering mismatch");

    rt_delete_file(out_path);
    rt_delete_file(c_path);
}

/**
 * Tests string relational execution in `--run --keep-c` mode.
 */
func test_run_string_relational_build_and_keep_c() {
    let out_path = run_keep_c_output_path();
    let c_path = run_keep_c_c_path();
    rt_delete_file(out_path);
    rt_delete_file(c_path);

    with (let argv = vs_create(12) => vs_free(argv)) {
        vs_push(argv, "--run");
        vs_push(argv, "--keep-c");
        vs_push(argv, "-P");
        vs_push(argv, fixture_root());
        vs_push(argv, "--output");
        vs_push(argv, out_path);
        vs_push(argv, "string_relational_main");

        let rc = run_with_argv(argv);
        assert(rc == 23, "--run --keep-c should compile and execute string_relational_main");
    }

    let c_text = read_file(c_path);
    assert(c_text != null, "string_relational_main kept C file should exist");
    assert(contains_s(c_text as string, "(rt_string_compare(short_value, longer_value) < 0)"),
        "string_relational_main less-than lowering mismatch");
    assert(contains_s(c_text as string, "(rt_string_compare(short_value, same_value) <= 0)"),
        "string_relational_main less-equal lowering mismatch");
    assert(contains_s(c_text as string, "(rt_string_compare(longer_value, short_value) > 0)"),
        "string_relational_main greater-than lowering mismatch");
    assert(contains_s(c_text as string, "(rt_string_compare(longer_value, same_value) >= 0)"),
        "string_relational_main greater-equal lowering mismatch");
    assert(contains_s(c_text as string, "(rt_string_compare(built_same, short_value) >= 0)"),
        "string_relational_main heap-string ordering lowering mismatch");

    rt_delete_file(out_path);
    rt_delete_file(c_path);
}

/**
 * Tests string concatenation build and keep-c: runtime correctness and lowered C contents.
 */
func test_run_string_concat_build_and_keep_c() {
    let out_path = run_keep_c_output_path();
    let c_path = run_keep_c_c_path();
    rt_delete_file(out_path);
    rt_delete_file(c_path);

    with (let argv = vs_create(12) => vs_free(argv)) {
        vs_push(argv, "--run");
        vs_push(argv, "--keep-c");
        vs_push(argv, "-P");
        vs_push(argv, fixture_root());
        vs_push(argv, "--output");
        vs_push(argv, out_path);
        vs_push(argv, "string_concat_main");

        let rc = run_with_argv(argv);
        assert(rc == 23, "--run --keep-c should compile and execute string_concat_main");
    }

    let c_text = read_file(c_path);
    assert(c_text != null, "string_concat_main kept C file should exist");
    assert(contains_s(c_text as string, "rt_string_concat"),
        "string_concat_main concat lowering mismatch");

    rt_delete_file(out_path);
    rt_delete_file(c_path);
}

/**
 * Tests test_merge_c_option_words_cli_last.
 */
func test_merge_c_option_words_cli_last() {
    with (let words = l0c_merge_c_option_words("-DENV_ONE   -DENV_TWO", "-DCLI_ONE -DCLI_TWO") => vs_free(words)) {
        assert(vs_size(words) == 4, "expected 4 merged C option words");
        assert(vs_get(words, 0) == "-DENV_ONE", "env option #1 should come first");
        assert(vs_get(words, 1) == "-DENV_TWO", "env option #2 should come before CLI options");
        assert(vs_get(words, 2) == "-DCLI_ONE", "cli option #1 should come after env options");
        assert(vs_get(words, 3) == "-DCLI_TWO", "cli option #2 should come last");
    }
}

/**
 * Tests test_merge_c_option_words_ignores_empty_inputs.
 */
func test_merge_c_option_words_ignores_empty_inputs() {
    with (let empty_words = l0c_merge_c_option_words("   \t  ", null) => vs_free(empty_words)) {
        assert(vs_size(empty_words) == 0, "blank env options should produce no words");
    }

    with (let cli_words = l0c_merge_c_option_words(null, "  -DCLI_ONLY\t") => vs_free(cli_words)) {
        assert(vs_size(cli_words) == 1, "single CLI option should be preserved");
        assert(vs_get(cli_words, 0) == "-DCLI_ONLY", "CLI option text mismatch");
    }
}

