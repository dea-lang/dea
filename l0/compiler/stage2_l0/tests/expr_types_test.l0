func test_typing_loop_control_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_loop_control_err", cfg);
        assert(analysis_has_errors(result), "expected typing errors for typing_loop_control_err");
        assert(count_diag_code(result, "TYP-0110") == 2, "expected top-level and inline-cleanup break-outside-loop errors");
        assert(count_diag_code(result, "TYP-0120") == 2, "expected top-level and inline-cleanup continue-outside-loop errors");
        assert(!has_diag_code(result, "TYP-0030"), "did not expect unreachable-code warning after invalid loop control");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Tests warning-only unreachable-code parity diagnostics.
 */
func test_typing_unreachable_warn_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_unreachable_warn_ok", cfg);
        assert(!analysis_has_errors(result), "did not expect typing errors for typing_unreachable_warn_ok");
        assert(count_diag_code(result, "TYP-0030") == 2, "expected generic unreachable-code warnings after break and continue");
        assert(count_diag_code(result, "TYP-0031") == 1, "expected one unreachable-after-return warning");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Tests successful typing for `new` parity cases.
 */
func test_typing_new_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_new_ok", cfg);
        assert(!analysis_has_errors(result), "expected no typing errors for typing_new_ok");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Tests `new` diagnostics for invalid construction cases.
 */
func test_typing_new_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_new_err", cfg);
        assert(analysis_has_errors(result), "expected typing errors for typing_new_err");
        assert(has_diag_code(result, "TYP-0281"), "expected enum-allocation-without-variant error");
        assert(has_diag_code(result, "TYP-0283"), "expected struct new arity error");
        assert(has_diag_code(result, "TYP-0314"), "expected enum variant payload type mismatch error");
        assert(!has_diag_code(result, "TYP-0333"), "did not expect legacy enum variant payload code");
        assert(!has_diag_code(result, "SIG-0010"), "new variant should not be treated as a type name");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Tests `drop` diagnostics for invalid local uses.
 */
func test_typing_drop_err() {
