        assert(count_diag_code(result, "TYP-0150") == 5, "expected five branch use-after-drop diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests returning alternatives are excluded and complete revival remains usable. */
func test_typing_branch_liveness_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_branch_liveness_ok", cfg);
        assert(!analysis_has_errors(result), "expected branch liveness fixture to pass");
        assert(!has_diag_code(result, "TYP-0150"), "did not expect branch use-after-drop diagnostics");
        assert(!has_diag_code(result, "TYP-0062"), "did not expect branch second-drop diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests definite-return flow through with statements and for initialization. */
func test_typing_with_return_flow_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_with_return_flow_ok", cfg);
        assert(!analysis_has_errors(result), "expected with/header returns to satisfy function flow");
        assert(!has_diag_code(result, "TYP-0010"), "did not expect missing-return diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests inline cleanup loop control overriding a header return. */
func test_typing_with_return_flow_override() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_with_return_flow_override", cfg);
        assert(!analysis_has_errors(result), "did not expect errors for cleanup loop-control override");
        assert(count_diag_code(result, "TYP-0030") == 2, "expected unreachable warnings after cleanup loop control");
        assert(!has_diag_code(result, "TYP-0031"), "did not expect return-unreachable warnings");
        assert(!has_diag_code(result, "TYP-0010"), "did not expect missing-return diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Main entry point for the module.
 */
func main() {
    test_typing_ok();
    test_typing_for_loop_scope();
    test_typing_err();
    test_typing_toplet_initializer_err();
    test_typing_alias_struct_constructor_ok();
    test_typing_alias_value_err();
    test_typing_let_diag_err();
    test_typing_let_diag_tail_err();
    test_typing_loop_cond_err();
    test_typing_match_diag_err();
    test_typing_match_qualified_pattern_err();
    test_typing_case_diag_err();
    test_typing_with_cleanup_guard();
    test_typing_field_diag_err();
    test_typing_index_diag_err();
    test_return_void_in_non_void();
    test_return_invalid_expr();
    test_typing_try_ok();
    test_typing_try_err();
    test_typing_equality_unsupported();
    test_typing_string_equality_ok();
    test_typing_string_relational_ok();
    test_typing_string_relational_err();
    test_typing_string_concat_ok();
    test_typing_string_concat_err();
    test_typing_cast_ok();
    test_typing_cast_err();
    test_typing_cast_int_to_byte_overflow();
    test_typing_cast_null_unwrap_err();
    test_typing_nullable_assignment();
    test_typing_call_err();
    test_typing_local_call_ok();
    test_typing_match_flow_err();
    test_typing_match_warn_ok();
    test_typing_loop_control_err();
    test_typing_unreachable_warn_ok();
    test_typing_new_ok();
    test_typing_new_err();
    test_typing_drop_err();
    test_typing_drop_flow_err();
    test_typing_loop_liveness_err();
    test_typing_loop_liveness_ok();
    test_typing_branch_liveness_err();
    test_typing_branch_liveness_ok();
    test_typing_with_return_flow_ok();
    test_typing_with_return_flow_override();
    printl_s("expr_types_test: all tests passed");
}
