        assert(has_diag_code(result, "TYP-0060"), "expected unknown-variable drop error");
        assert(has_diag_code(result, "TYP-0061"), "expected non-pointer drop error");
        assert(has_diag_code(result, "TYP-0063"), "expected module-let drop error");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/**
 * Tests `drop` flow diagnostics for second drop and later use.
 */
func test_typing_drop_flow_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_drop_flow_err", cfg);
        assert(analysis_has_errors(result), "expected typing errors for typing_drop_flow_err");
        assert(has_diag_code(result, "TYP-0062"), "expected second-drop diagnostic");
        assert(has_diag_code(result, "TYP-0150"), "expected use-after-drop diagnostic");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests loop liveness merging and delayed assignment revival. */
func test_typing_loop_liveness_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_loop_liveness_err", cfg);
        assert(analysis_has_errors(result), "expected loop liveness errors");
        assert(count_diag_code(result, "TYP-0150") == 6, "expected six use-after-drop diagnostics");
        assert(count_diag_code(result, "TYP-0010") == 3, "expected conservative loop return diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests loop liveness paths that should remain usable after the loop. */
func test_typing_loop_liveness_ok() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_loop_liveness_ok", cfg);
        assert(!analysis_has_errors(result), "expected loop liveness ok fixture to pass");
        assert(!has_diag_code(result, "TYP-0150"), "did not expect use-after-drop diagnostics");
        assert(!has_diag_code(result, "TYP-0062"), "did not expect dropped-variable diagnostics");
        analysis_result_free(result);
    }
    sp_free(sp);
}

/** Tests sibling alternatives are isolated and their fallthrough liveness is met. */
func test_typing_branch_liveness_err() {
    let sp = make_paths();
    with (let cfg = log_config_create(LL_SILENT, false) => drop cfg) {
        let result = analysis_analyze_entry(sp, "typing_branch_liveness_err", cfg);
