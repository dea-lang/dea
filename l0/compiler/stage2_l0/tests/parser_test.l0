/**
 * Tests that three unclosed braces report PAR-0091 exactly once. End-of-file is
 * terminal, so the unterminated-block condition is not re-reported at each
 * enclosing nesting level.
 */
func test_unterminated_nested_blocks_report_par0091_once() {
    expect_diag_code_count("module hello; func main() {{{", "PAR-0091", 1);
    expect_diag_code_absent("module hello; func main() {{{", "PAR-0020");
}

/**
 * Tests that a single unclosed brace still reports PAR-0091 exactly once, so the
 * end-of-file fix does not over-suppress at nesting depth one.
 */
func test_single_unterminated_block_reports_par0091_once() {
    expect_diag_code_count("module hello; func main() {", "PAR-0091", 1);
    expect_diag_code_absent("module hello; func main() {", "PAR-0020");
}

/**
 * Main entry point for the module.
 */
func main() {
    test_parser_message_omits_embedded_code();
    test_valid_module();
    test_for_update_let_rejected();
    test_module_decl_error();
    test_reserved_variable_name_error();
    test_reserved_operator_error();
    test_with_mixed_forms_error();
    test_stray_else_reports_par0123();
    test_stray_cleanup_reports_par0506();
    test_stray_else_does_not_cascade_to_top_level();
    test_case_empty_error();
    test_case_wildcard_default_ok();
    test_case_else_deprecation_warning();
    test_case_value_arm_after_wildcard_error();
    test_case_wildcard_missing_arrow_error();
    test_case_ambiguous_if_else_error();
    test_case_default_arm_if_else_body_ok();
    test_case_default_recovery_stays_inside_case();
    test_case_default_recovery_byte_literal_span();
    test_expr_precedence_postfix_and_qualified_type_ok();
    test_postfix_chain_ok();
    test_type_expr_call_arg_ok();
    test_reserved_binary_and_error();
    test_reserved_binary_shift_error();
    test_qualified_expr_module_path_ok();
    test_qualified_type_name_ok();
    test_top_level_let_expr_error();
    test_type_alias_missing_semi_error();
    test_struct_field_error();
    test_enum_variant_field_error();
    test_new_expr_bad_arg_error();
    test_top_level_multi_error_collection();
    test_lexer_errors_recover_into_parser();
    test_lexer_error_tokens_keep_module_parse();
    test_lexer_error_run_has_codepoint_span();
    test_lexer_error_not_duplicated_across_backtracking();
    test_queued_lexer_errors_preserve_escape_then_unterminated_string();
    test_queued_lexer_errors_preserve_hex_then_unterminated_string();
    test_lexer_unicode_string_keeps_following_columns();
    test_unterminated_nested_blocks_report_par0091_once();
    test_single_unterminated_block_reports_par0091_once();
    printl_s("parser_test: all tests passed");
}
