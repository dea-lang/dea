/**
 * Parses source and asserts that some diagnostic carries `expected`.
 *
 * @param source The module source to parse.
 * @param expected The diagnostic code that must appear at least once.
 */
func expect_diag_code_present(source: string, expected: string) {
    let result = parse_module_source(source, "<test>");
    let count = parse_diag_count(result);
    let found = false;
    let i = 0;
    while (i < count) {
        let diag = parse_diag_get(result, i);
        if (diag.code == expected) {
            found = true;
        }
        i = i + 1;
    }
    if (!found) {
        printl_ss("missing diagnostic code:", expected);
    }
    assert(found, "Expected diagnostic code " + expected);
    parse_result_free(result);
}

/**
 * Parses source and asserts that no diagnostic carries `forbidden`.
 *
 * @param source The module source to parse.
 * @param forbidden The diagnostic code that must not appear.
 */
func expect_diag_code_absent(source: string, forbidden: string) {
    let result = parse_module_source(source, "<test>");
    let count = parse_diag_count(result);
    let i = 0;
    while (i < count) {
        let diag = parse_diag_get(result, i);
        if (diag.code == forbidden) {
            printl_ss("unexpected diagnostic code:", forbidden);
            assert(false, "Did not expect diagnostic code " + forbidden);
        }
        i = i + 1;
    }
    parse_result_free(result);
}

/**
 * Parses source and asserts that exactly `expected_count` diagnostics carry `expected`.
 *
 * @param source The module source to parse.
 * @param expected The diagnostic code to count.
 * @param expected_count The exact expected count.
 */
func expect_diag_code_count(source: string, expected: string, expected_count: int) {
    let result = parse_module_source(source, "<test>");
    let count = parse_diag_count(result);
    let found = 0;
    let i = 0;
    while (i < count) {
        let diag = parse_diag_get(result, i);
        if (diag.code == expected) {
            found = found + 1;
        }
        i = i + 1;
    }
    if (found != expected_count) {
        printl_ss("diagnostic code:", expected);
        printl_si("actual count:", found);
        assert(false, "Unexpected diagnostic count");
    }
    parse_result_free(result);
}

/**
 * Counts diagnostics with the given code in a parse result.
 *
 * @param result Parse result to inspect.
 * @param code Diagnostic code to count.
 * @return Number of diagnostics carrying `code`.
 */
func count_diag_code(result: ParseResult*, code: string) -> int {
    let found = 0;
    for (let i = 0; i < parse_diag_count(result); i = i + 1) {
        let diag = parse_diag_get(result, i);
        if (diag.code == code) {
            found = found + 1;
        }
    }
    return found;
}

/**
 * Tests that deferred lexer errors are emitted by the parser, which then
 * continues and reports the missing module header exactly once.
 */
func test_lexer_errors_recover_into_parser() {
    let result = parse_module_source("@ $ @", "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module == null, "Expected no parsed module without a module header");
    assert(count_diag_code(result, "LEX-0040") == 3, "Expected exactly three LEX-0040 diagnostics");
    assert(count_diag_code(result, "PAR-0310") == 1, "Expected one missing-module-header diagnostic");
    assert(parse_diag_count(result) == 4, "Expected no cascading diagnostics");
    parse_result_free(result);
}

/**
 * Tests that a module with invalid characters inside declarations still
 * parses: the lexer errors are reported and the parse completes cleanly.
 */
func test_lexer_error_tokens_keep_module_parse() {
    let result = parse_module_source(
        "module main;\n\nfunc main() -> int {\n    let café: int = 1;\n    return café;\n}\n",
        "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module != null, "Expected a parsed module despite lexer errors");
    assert(count_diag_code(result, "LEX-0040") == 2, "Expected two LEX-0040 diagnostics");
    assert(parse_diag_count(result) == 2, "Expected no parser diagnostics");
    parse_result_free(result);
}

/**
 * Tests that one contiguous run of invalid characters yields one diagnostic
 * whose span is measured in code points.
 */
func test_lexer_error_run_has_codepoint_span() {
    let result = parse_module_source(
        "module main;\n⚽⚽⚽\nfunc main() -> int {\n    return 0;\n}\n",
        "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module != null, "Expected a parsed module despite lexer errors");
    assert(count_diag_code(result, "LEX-0040") == 1, "Expected one LEX-0040 for the whole run");
    assert(parse_diag_count(result) == 1, "Expected no parser diagnostics");
    let diag = parse_diag_get(result, 0);
    assert(diag.line == 2, "Expected the run on line 2");
    assert(diag.column == 1, "Expected the run to start at column 1");
    assert(diag.line_end == 2, "Expected the span to stay on line 2");
    assert(diag.column_end == 4, "Expected a three-code-point span");
    parse_result_free(result);
}

/**
 * Tests that parser backtracking over a lexer-error token does not duplicate
 * its diagnostic.
 */
func test_lexer_error_not_duplicated_across_backtracking() {
    let result = parse_module_source(
        "module main;\n\nfunc main() -> int {\n    let x: int = 1;\n    return x ⚽⚽;\n}\n",
        "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module != null, "Expected a parsed module despite lexer errors");
    assert(count_diag_code(result, "LEX-0040") == 1, "Expected exactly one LEX-0040 diagnostic");
    assert(parse_diag_count(result) == 1, "Expected no parser diagnostics");
    parse_result_free(result);
}

/**
 * Tests that an unknown escape before newline preserves both lexer diagnostics.
 */
func test_queued_lexer_errors_preserve_escape_then_unterminated_string() {
    let result = parse_module_source(
        "module main;\nfunc main() -> int {\n    let s: string = \"\\q\n    return 0;\n}\n",
        "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module != null, "Expected a parsed module despite lexer errors");
    assert(count_diag_code(result, "LEX-0059") == 1, "Expected one unknown-escape diagnostic");
    assert(count_diag_code(result, "LEX-0010") == 1, "Expected one unterminated-string diagnostic");
    assert(count_diag_code(result, "PAR-0100") == 1, "Expected one missing-semicolon parser diagnostic");
    assert(parse_diag_count(result) == 3, "Expected exactly two lexer diagnostics plus one parser diagnostic");
    parse_result_free(result);
}

/**
 * Tests that an invalid hex escape before newline preserves both lexer diagnostics.
 */
func test_queued_lexer_errors_preserve_hex_then_unterminated_string() {
    let result = parse_module_source(
        "module main;\nfunc main() -> int {\n    let s: string = \"\\x\n    return 0;\n}\n",
        "<test>");
    assert(parse_has_errors(result), "Expected lexer errors");
    assert(result.root_module != null, "Expected a parsed module despite lexer errors");
    assert(count_diag_code(result, "LEX-0050") == 1, "Expected one invalid-hex-escape diagnostic");
    assert(count_diag_code(result, "LEX-0010") == 1, "Expected one unterminated-string diagnostic");
    assert(count_diag_code(result, "PAR-0100") == 1, "Expected one missing-semicolon parser diagnostic");
    assert(parse_diag_count(result) == 3, "Expected exactly two lexer diagnostics plus one parser diagnostic");
    parse_result_free(result);
}

/**
 * Tests that multibyte string content does not shift the reported column of
 * a following invalid character: columns count code points, not bytes.
 */
func test_lexer_unicode_string_keeps_following_columns() {
    let result = parse_module_source(
        "module main;\nfunc main() -> int {\n    let s: string = \"☕☕\"; ⚽\n    return 0;\n}\n",
        "<test>");
    assert(count_diag_code(result, "LEX-0040") == 1, "Expected one LEX-0040 diagnostic");
    let diag = parse_diag_get(result, 0);
    assert(diag.line == 3, "Expected the invalid character on line 3");
    assert(diag.column == 27, "Expected a code-point column for the invalid character");
    parse_result_free(result);
}

/**
 * Parses source and asserts that the `occurrence`th diagnostic with `expected`
 * appears on `expected_line`.
 *
 * @param source The module source to parse.
 * @param expected The diagnostic code to find.
 * @param occurrence Zero-based occurrence index for repeated codes.
 * @param expected_line The expected 1-based line number.
 */
func expect_diag_code_line(source: string, expected: string, occurrence: int, expected_line: int) {
    let result = parse_module_source(source, "<test>");
    let count = parse_diag_count(result);
    let seen = 0;
    let i = 0;
    while (i < count) {
        let diag = parse_diag_get(result, i);
        if (diag.code == expected) {
            if (seen == occurrence) {
                if (diag.line != expected_line) {
                    printl_ss("diagnostic code:", expected);
                    printl_si("actual line:", diag.line);
                    assert(false, "Unexpected diagnostic line");
                }
                parse_result_free(result);
                return;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    printl_ss("missing diagnostic code:", expected);
    assert(false, "Expected diagnostic line");
    parse_result_free(result);
}

/**
 * Parses source and asserts that the `occurrence`th diagnostic has the expected span.
 *
 * @param source The module source to parse.
 * @param expected The diagnostic code to find.
 * @param occurrence Zero-based occurrence index for repeated codes.
 * @param line The expected 1-based start line.
 * @param column The expected 1-based start column.
 * @param line_end The expected 1-based end line.
 * @param column_end The expected exclusive end column.
 */
func expect_diag_code_span(source: string, expected: string, occurrence: int,
                           line: int, column: int, line_end: int, column_end: int) {
    let result = parse_module_source(source, "<test>");
    let count = parse_diag_count(result);
    let seen = 0;
    let i = 0;
    while (i < count) {
        let diag = parse_diag_get(result, i);
        if (diag.code == expected) {
            if (seen == occurrence) {
                if (diag.line != line || diag.column != column ||
                    diag.line_end != line_end || diag.column_end != column_end) {
                    printl_ss("diagnostic code:", expected);
                    printl_si("actual line:", diag.line);
                    printl_si("actual column:", diag.column);
                    printl_si("actual line_end:", diag.line_end);
                    printl_si("actual column_end:", diag.column_end);
                    assert(false, "Unexpected diagnostic span");
                }
                parse_result_free(result);
                return;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    printl_ss("missing diagnostic code:", expected);
    assert(false, "Expected diagnostic span");
    parse_result_free(result);
}

/**
 * Tests that an orphaned `else` is diagnosed as PAR-0123, not the generic error.
 */
func test_stray_else_reports_par0123() {
    expect_error_code("module main; func main() -> int { else return 0; }", "PAR-0123");
}

/**
 * Tests that an orphaned `cleanup` is diagnosed as PAR-0506.
 */
func test_stray_cleanup_reports_par0506() {
    expect_error_code("module main; func main() -> int { cleanup return 0; }", "PAR-0506");
}

/**
 * Tests that a failed in-body statement recovers without a spurious top-level
 * PAR-0020 cascade.
 */
func test_stray_else_does_not_cascade_to_top_level() {
    let src = "module main; func main() -> int { else let x: int = 1; return x; }";
    expect_diag_code_present(src, "PAR-0123");
    expect_diag_code_absent(src, "PAR-0020");
    expect_diag_code_absent(src, "PAR-0225");
}

/**
 * Tests test_case_empty_error.
 */
func test_case_empty_error() {
    let src = "module main; func main() -> int { case (1) { } return 0; }";
    expect_error_code(src, "PAR-0240");
}

/**
 * Tests that `_ =>` parses as the canonical `case` default arm.
 */
func test_case_wildcard_default_ok() {
    let src = "module main; func main() -> int { case (1) { 1 => { return 1; } _ => { return 0; } } }";
    expect_ok(src);
}

/**
 * Tests that a deprecated `else` default arm emits a PAR-0242 warning.
 */
func test_case_else_deprecation_warning() {
    let src = "module main; func main() -> int { case (1) { 1 => { return 1; } else { return 0; } } }";
    expect_diag_code_present(src, "PAR-0242");
}

/**
 * Tests that a value arm after the wildcard default is PAR-0234.
 */
func test_case_value_arm_after_wildcard_error() {
    let src = "module main; func main() -> int { case (1) { _ => { return 0; } 2 => { return 2; } } }";
    expect_error_code(src, "PAR-0234");
}

/**
 * Tests that a `_` default missing its `=>` is PAR-0235.
 */
func test_case_wildcard_missing_arrow_error() {
    let src = "module main; func main() -> int { case (1) { _ { return 0; } } }";
    expect_error_code(src, "PAR-0235");
}

/**
 * Tests that an unbraced `if` value-arm body followed by `else` is PAR-0243.
 */
func test_case_ambiguous_if_else_error() {
    let src = "module main; func main() -> int { case (1) { 1 => if (true) return 1; else return 0; } }";
    expect_error_code(src, "PAR-0243");
}

/**
 * Tests that a default-arm body may be an unbraced if-else (only value arms are guarded).
 */
func test_case_default_arm_if_else_body_ok() {
    let wildcard = "module main; func main() -> int { case (1) { 1 => { return 1; } _ => if (true) return 2; else return 3; } }";
    expect_ok(wildcard);
    let else_chain = "module main; func main() -> int { case (1) { 1 => { return 1; } else if (true) return 2; else return 3; } }";
    expect_ok(else_chain);
}

/**
 * Tests that invalid arms after a default recover inside the current `case`.
 */
func test_case_default_recovery_stays_inside_case() {
    let src = "module main;\n" +
        "func main() -> int {\n" +
        "    case (1) {\n" +
        "        else { return 0; }\n" +
        "        \"a\" => { return 1; }\n" +
        "        _ => 2;\n" +
        "        else 3;\n" +
        "    }\n" +
        "    printl_s(\"ok\");\n" +
        "    return 0;\n" +
        "}\n";
    expect_diag_code_present(src, "PAR-0242");
    expect_diag_code_present(src, "PAR-0234");
    expect_diag_code_count(src, "PAR-0236", 2);
    expect_diag_code_absent(src, "PAR-0225");
    expect_diag_code_absent(src, "PAR-0123");
    expect_diag_code_absent(src, "PAR-0020");
    expect_diag_code_line(src, "PAR-0242", 0, 4);
    expect_diag_code_line(src, "PAR-0234", 0, 5);
    expect_diag_code_line(src, "PAR-0236", 0, 6);
    expect_diag_code_line(src, "PAR-0236", 1, 7);
    expect_diag_code_span(src, "PAR-0242", 0, 4, 9, 4, 13);
    expect_diag_code_span(src, "PAR-0234", 0, 5, 9, 5, 12);
    expect_diag_code_span(src, "PAR-0236", 0, 6, 9, 6, 10);
    expect_diag_code_span(src, "PAR-0236", 1, 7, 9, 7, 13);
}

/**
 * Tests that byte literal case-arm diagnostics include quote delimiters in spans.
 */
func test_case_default_recovery_byte_literal_span() {
    let src = "module main;\n" +
        "func main() -> int {\n" +
        "    case (1) {\n" +
        "        _ => 0;\n" +
        "        'a' => 1;\n" +
        "    }\n" +
        "    return 0;\n" +
        "}\n";
    expect_diag_code_present(src, "PAR-0234");
    expect_diag_code_span(src, "PAR-0234", 0, 5, 9, 5, 12);
}

