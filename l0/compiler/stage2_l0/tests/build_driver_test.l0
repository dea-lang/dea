module build_driver_test;

import sys.rt;

import std.assert;
import std.fs;
import std.io;
import std.path;
import std.string;
import std.system;
import std.text;
import std.vector;
import util.diag;

import build_driver;
import compiler_filesystem;

/**
 * Tests test_with_c_suffix_rewrites_existing_extension.
 */
func test_with_c_suffix_rewrites_existing_extension() {
    assert(bd_with_c_suffix("build/out.exe") == "build/out.c", "existing extension should be replaced");
    assert(bd_with_c_suffix("plain-output") == "plain-output.c", "missing extension should add .c");
}

/**
 * Tests test_shell_quote_posix_handles_spaces_and_quotes.
 */
func test_shell_quote_posix_handles_spaces_and_quotes() {
    assert(bd_shell_quote_posix("two words") == "'two words'", "space quoting mismatch");
    assert(bd_shell_quote_posix("rock'n'roll") == "'rock'\\''n'\\''roll'", "single-quote escaping mismatch");
    assert(bd_shell_quote_posix("") == "''", "empty string should still be quoted");
}

/**
 * Tests test_shell_quote_windows_handles_spaces_and_quotes.
 */
func test_shell_quote_windows_handles_spaces_and_quotes() {
    assert(bd_shell_quote_windows("two words") == "\"two words\"", "space quoting mismatch");
    assert(bd_shell_quote_windows("say \"hi\"") == "\"say \\\"hi\\\"\"", "double-quote escaping mismatch");
    assert(bd_shell_quote_windows("") == "\"\"", "empty string should still be quoted");
}

/**
 * Tests test_join_shell_words_quotes_every_token.
 */
func test_join_shell_words_quotes_every_token() {
    with (let words = sv_create(3) => sv_free(words)) {
        sv_push(words, "alpha");
        sv_push(words, "two words");
        sv_push(words, "rock'n'roll");

        let joined = bd_join_shell_words(words);
        if (bd_is_windows()) {
            assert(joined == "alpha \"two words\" \"rock'n'roll\"", "joined shell command mismatch");
        } else {
            assert(joined == "'alpha' 'two words' 'rock'\\''n'\\''roll'", "joined shell command mismatch");
        }
    }
}

/**
 * Tests test_windows_exec_token_rewrites_relative_slashes.
 */
func test_windows_exec_token_rewrites_relative_slashes() {
    assert(bd_windows_exec_token("./temp.exe") == ".\\temp.exe", "dot-relative executable path mismatch");
    assert(bd_windows_exec_token("../bin/temp.exe") == "..\\bin\\temp.exe", "parent-relative executable path mismatch");
    assert(bd_windows_exec_token("clang") == "clang", "plain command should remain unchanged");
}

/**
 * Tests test_join_display_words_matches_stage1_logging.
 */
func test_join_display_words_matches_stage1_logging() {
    with (let words = sv_create(3) => sv_free(words)) {
        sv_push(words, "clang");
        sv_push(words, "file.c");
        sv_push(words, "-O1");

        let joined = bd_join_display_words(words);
        assert(joined == "clang file.c -O1", "display command mismatch");
    }
}

/**
 * Tests test_format_word_list_matches_stage1_logging.
 */
func test_format_word_list_matches_stage1_logging() {
    with (let words = sv_create(2) => sv_free(words)) {
        assert(bd_format_word_list(words) == "[]", "empty option list mismatch");
        sv_push(words, "-g");
        sv_push(words, "-O0");
        assert(bd_format_word_list(words) == "['-g', '-O0']", "formatted option list mismatch");
    }
}

/**
 * Tests test_compiler_flag_family_detection.
 */
func test_compiler_flag_family_detection() {
    assert(bd_compiler_flag_family("gcc") == "gcc", "gcc family mismatch");
    assert(bd_compiler_flag_family("/usr/bin/clang-18") == "gcc", "clang family mismatch");
    assert(bd_compiler_flag_family("cc") == "cc", "cc family mismatch");
    assert(bd_compiler_flag_family("cl.exe") == "msvc", "msvc family mismatch");
    assert(bd_compiler_flag_family("custom-cc") == "unknown", "unknown family mismatch");
}

/**
 * Tests test_get_optimize_flag_defaults_and_overrides.
 */
func test_get_optimize_flag_defaults_and_overrides() {
    with (let empty = sv_create(1) => sv_free(empty)) {
        let gcc_opt = bd_get_optimize_flag("gcc", empty);
        let expected = "-O1";
        if (bd_is_windows()) {
            expected = "-O0";
        }
        assert(gcc_opt != null && gcc_opt as string == expected, "gcc default optimize flag mismatch");
    }

    with (let debug_words = sv_create(1) => sv_free(debug_words)) {
        sv_push(debug_words, "-g");
        let gcc_debug = bd_get_optimize_flag("gcc", debug_words);
        assert(gcc_debug != null && gcc_debug as string == "-Og", "gcc debug optimize flag mismatch");
    }

    with (let msvc_debug_words = sv_create(1) => sv_free(msvc_debug_words)) {
        sv_push(msvc_debug_words, "/Zi");
        let msvc_debug = bd_get_optimize_flag("msvc", msvc_debug_words);
        assert(msvc_debug != null && msvc_debug as string == "/Od", "msvc debug optimize flag mismatch");
    }

    with (let explicit_opt = sv_create(1) => sv_free(explicit_opt)) {
        sv_push(explicit_opt, "-O2");
        assert(bd_get_optimize_flag("gcc", explicit_opt) == null, "explicit optimize flag should suppress defaults");
    }
}

/**
 * Tests test_output_flag_selection_matches_compiler_family.
 */
func test_output_flag_selection_matches_compiler_family() {
    with (let gcc_words = sv_create(4) => sv_free(gcc_words)) {
        bd_push_output_flags(gcc_words, "gcc", "out.exe");
        assert(sv_size(gcc_words) == 2, "gcc output flags should use two argv words");
        assert(sv_get(gcc_words, 0) == "-o", "gcc output flag mismatch");
        assert(sv_get(gcc_words, 1) == "out.exe", "gcc output path mismatch");
    }

    with (let msvc_words = sv_create(2) => sv_free(msvc_words)) {
        bd_push_output_flags(msvc_words, "msvc", "out.exe");
        assert(sv_size(msvc_words) == 1, "msvc output flags should use one argv word");
        assert(sv_get(msvc_words, 0) == "/Fe:out.exe", "msvc output flag mismatch");
    }
}

/**
 * Tests test_compile_command_order_places_source_after_compiler_flags.
 */
func test_compile_command_order_places_source_after_compiler_flags() {
    with (
        let extra_opts = sv_create(1) => sv_free(extra_opts),
        let c_sources = sv_create(2) => sv_free(c_sources),
        let words = sv_create(13) => sv_free(words)
    ) {
        sv_push(extra_opts, "-DVALUE=1");
        sv_push(c_sources, "extra source.c");

        let optimize = bd_get_optimize_flag("tcc", extra_opts);
        assert(optimize != null && optimize as string == "-O1", "tcc default optimize flag mismatch");
        bd_push_c_compile_command_words(
            words,
            "tcc",
            "tcc",
            extra_opts,
            optimize,
            "runtime/include",
            "input.c",
            c_sources,
            "out.exe",
            "runtime/lib"
        );

        assert(sv_get(words, 0) == "tcc", "compiler should be first");
        assert(sv_get(words, 1) == "-DVALUE=1", "extra C option should precede source");
        assert(sv_get(words, 2) == "-std=c99", "standard flag should precede source");
        assert(sv_get(words, 5) == "-O1", "optimization flag should precede source");
        assert(sv_get(words, 6) == "-I", "runtime include flag should precede source");
        assert(sv_get(words, 8) == "input.c", "source path should follow compiler flags");
        assert(sv_get(words, 9) == "extra source.c", "additional source should remain one ordered word");
        assert(sv_get(words, 10) == "-o", "output flag should follow sources");
        assert(sv_get(words, 12) == "-L", "runtime library flag should follow source");
    }
}

/**
 * Tests test_exe_name_helpers_are_consistent.
 */
func test_exe_name_helpers_are_consistent() {
    if (bd_is_windows()) {
        assert(bd_default_exe_name() == "a.exe", "windows build name mismatch");
        assert(bd_exe_suffix() == ".exe", "windows suffix mismatch");
        assert(bd_null_device() == "NUL", "windows null device mismatch");
    } else {
        assert(bd_default_exe_name() == "a.out", "posix build name mismatch");
        assert(bd_exe_suffix() == ".out", "posix suffix mismatch");
        assert(bd_null_device() == "/dev/null", "posix null device mismatch");
    }
}

/**
 * Tests deterministic workspace collision retry and idempotent cleanup.
 */
func test_workspace_collision_and_idempotent_cleanup() {
    with (let diags = diag_create() => diag_free(diags)) {
        let parent_opt = cfs_resolve_trusted_temp_parent(".");
        assert(parent_opt != null, "test parent should resolve as trusted");
        let parent_path = parent_opt as string;
        let pid = get_pid();
        let collision = join(
            parent_path,
            ".l0c-unit-workspace-" + int_to_string(pid) +
                "-101-202-0"
        );
        /* Recover only this empty fixture after an interrupted prior run. */
        cfs_remove_empty_dir(collision);
        assert(
            cfs_mkdir(collision, 448) == 1,
            "collision fixture directory should be created"
        );

        let workspace_opt = cfs_workspace_create_for_identity(
            parent_path, "unit", pid, 101, 202, diags);
        assert(
            workspace_opt != null,
            "workspace reservation should retry after collision"
        );
        let workspace = workspace_opt as CompilerWorkspace*;
        assert(
            workspace.root != collision,
            "workspace must not reuse a colliding candidate"
        );

        let child = cfs_workspace_child(workspace, "known-child");
        assert(
            write_file(child, "owned") != null,
            "known workspace child should be writable"
        );
        assert(
            cfs_workspace_cleanup(workspace, diags),
            "known children and workspace should clean successfully"
        );
        assert(
            cfs_workspace_cleanup(workspace, diags),
            "workspace cleanup should be idempotent"
        );
        cfs_workspace_free(workspace);
        assert(
            cfs_remove_empty_dir(collision) == 1,
            "collision fixture should remain independently removable"
        );
        assert(
            diag_count(diags) == 0,
            "successful collision retry should not emit diagnostics"
        );
    }
}

/**
 * Tests actual-host joining beneath a POSIX parent ending in `\`.
 */
func test_workspace_literal_backslash_parent_containment() {
    let joined = cfs_join_child("parent\\", "child");
    if (bd_is_windows()) {
        assert(
            joined == "parent\\child",
            "Windows join should preserve a trailing backslash separator"
        );
        return;
    }
    assert(
        joined == "parent\\/child",
        "POSIX join should insert '/' after a literal trailing backslash"
    );

    with (let diags = diag_create() => diag_free(diags)) {
        let parent_opt = cfs_resolve_trusted_temp_parent(".");
        assert(parent_opt != null, "test parent should resolve as trusted");
        let parent_path = parent_opt as string;
        let pid = get_pid();
        let literal_parent = parent_path +
            "/.l0c-backslash-parent-" + int_to_string(pid) + "\\";
        cfs_remove_empty_dir(literal_parent);
        assert(
            cfs_mkdir(literal_parent, 448) == 1,
            "literal-backslash fixture directory should be created"
        );

        let workspace_opt = cfs_workspace_create_for_identity(
            literal_parent,
            "backslash",
            pid,
            707,
            808,
            diags
        );
        assert(
            workspace_opt != null,
            "workspace should be reserved beneath backslash parent"
        );
        let workspace = workspace_opt as CompilerWorkspace*;
        assert(
            starts_with_s(workspace.root, literal_parent + "/"),
            "workspace root must remain inside literal-backslash parent"
        );
        assert(
            cfs_workspace_cleanup(workspace, diags),
            "literal-backslash workspace should clean successfully"
        );
        cfs_workspace_free(workspace);
        assert(
            cfs_remove_empty_dir(literal_parent) == 1,
            "literal-backslash fixture parent should be removed"
        );
        assert(
            diag_count(diags) == 0,
            "literal-backslash containment should emit no diagnostics"
        );
    }
}

/**
 * Tests complete temporary-parent precedence and classifier outcomes.
 */
func test_workspace_parent_selection_precedence() {
    with (let diags = diag_create() => diag_free(diags)) {
        let parent_opt = cfs_resolve_trusted_temp_parent(".");
        assert(parent_opt != null, "test parent should resolve as trusted");
        let workspace_opt = cfs_workspace_create_for_identity(
            parent_opt as string,
            "selection",
            get_pid(),
            505,
            606,
            diags
        );
        assert(
            workspace_opt != null,
            "selection fixture workspace should be reserved"
        );
        let workspace = workspace_opt as CompilerWorkspace*;
        let directory = workspace.root;
        let regular = cfs_workspace_child(workspace, "regular");
        assert(
            write_file(regular, "not a directory") != null,
            "selection fixture file should be writable"
        );
        let missing = join(directory, "missing");
        let non_directory_descendant = join(regular, "child");
        let fallback = join(directory, "fallback");

        let selected_tmpdir = cfs_select_temp_parent_from_values(
            directory, null, null, missing, fallback, diags);
        assert(
            selected_tmpdir != null &&
                selected_tmpdir as string == directory,
            "TMPDIR directory should have first precedence"
        );

        let selected_temp = cfs_select_temp_parent_from_values(
            missing, directory, null, missing, fallback, diags);
        assert(
            selected_temp != null &&
                selected_temp as string == directory,
            "TEMP directory should follow an absent TMPDIR"
        );

        let selected_after_non_directory_parent =
            cfs_select_temp_parent_from_values(
                non_directory_descendant,
                directory,
                null,
                missing,
                fallback,
                diags
            );
        assert(
            selected_after_non_directory_parent != null &&
                selected_after_non_directory_parent as string == directory,
            "path beneath a regular file should fall through"
        );

        let selected_tmp = cfs_select_temp_parent_from_values(
            "", regular, directory, missing, fallback, diags);
        assert(
            selected_tmp != null &&
                selected_tmp as string == directory,
            "TMP directory should follow empty and non-directory candidates"
        );

        let selected_system = cfs_select_temp_parent_from_values(
            null, null, null, directory, fallback, diags);
        assert(
            selected_system != null &&
                selected_system as string == directory,
            "system temporary directory should have fourth precedence"
        );

        let selected_fallback = cfs_select_temp_parent_from_values(
            missing, regular, missing, missing, fallback, diags);
        assert(
            selected_fallback != null &&
                selected_fallback as string == fallback,
            "fallback should be returned after four non-directory outcomes"
        );

        let before_error = diag_count(diags);
        let invalid = "invalid" + byte_to_s(0 as byte) + "candidate";
        let selected_error = cfs_select_temp_parent_from_values(
            invalid, directory, directory, directory, fallback, diags);
        assert(
            selected_error == null,
            "inspection error must not fall through to a later directory"
        );
        assert(
            diag_count(diags) == before_error + 1,
            "inspection error should emit exactly one setup diagnostic"
        );

        assert(
            cfs_workspace_cleanup(workspace, diags),
            "selection fixture should clean successfully"
        );
        cfs_workspace_free(workspace);
    }
}

/**
 * Tests bounded cleanup retention and status precedence.
 */
func test_workspace_cleanup_retains_unexpected_contents() {
    with (let diags = diag_create() => diag_free(diags)) {
        let parent_opt = cfs_resolve_trusted_temp_parent(".");
        assert(parent_opt != null, "test parent should resolve as trusted");
        let workspace_opt = cfs_workspace_create_for_identity(
            parent_opt as string,
            "retention",
            get_pid(),
            303,
            404,
            diags
        );
        assert(
            workspace_opt != null,
            "retention workspace should be reserved"
        );
        let workspace = workspace_opt as CompilerWorkspace*;
        let unexpected = join(workspace.root, "unexpected");
        assert(
            write_file(unexpected, "retain") != null,
            "unexpected fixture should be writable"
        );
        assert(
            !cfs_workspace_cleanup(workspace, diags),
            "unexpected contents should retain the workspace"
        );
        assert(
            cfs_path_kind(workspace.root) == CFS_PATH_DIRECTORY,
            "retained workspace should remain a real directory"
        );
        assert(
            diag_count(diags) == 1,
            "retention should emit one cleanup diagnostic"
        );
        assert(
            cfs_apply_cleanup_status(0, false) == 1,
            "cleanup failure should turn success into failure"
        );
        assert(
            cfs_apply_cleanup_status(7, false) == 7,
            "cleanup failure should preserve a child status"
        );

        assert(
            cfs_remove_regular_file(unexpected) == 1,
            "test should remove its unexpected fixture"
        );
        assert(
            cfs_workspace_cleanup(workspace, diags),
            "workspace should clean once unexpected contents are removed"
        );
        cfs_workspace_free(workspace);
    }
}

/**
 * Main entry point for the module.
 */
func main() {
    test_with_c_suffix_rewrites_existing_extension();
    test_shell_quote_posix_handles_spaces_and_quotes();
    test_shell_quote_windows_handles_spaces_and_quotes();
    test_join_shell_words_quotes_every_token();
    test_windows_exec_token_rewrites_relative_slashes();
    test_join_display_words_matches_stage1_logging();
    test_format_word_list_matches_stage1_logging();
    test_compiler_flag_family_detection();
    test_get_optimize_flag_defaults_and_overrides();
    test_output_flag_selection_matches_compiler_family();
    test_compile_command_order_places_source_after_compiler_flags();
    test_exe_name_helpers_are_consistent();
    test_workspace_collision_and_idempotent_cleanup();
    test_workspace_literal_backslash_parent_containment();
    test_workspace_parent_selection_precedence();
    test_workspace_cleanup_retains_unexpected_contents();
    printl_s("build_driver_test: all tests passed");
}
