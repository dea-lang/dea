/**
 * Tests test_check_basic_rejected_outside_build_run_gen.
 */
func test_check_basic_rejected_outside_build_run_gen() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "--check-basic");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for --check --check-basic");
        assert(parsed.options == null, "options must be null on parse errors");
