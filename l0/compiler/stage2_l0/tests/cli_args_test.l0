module cli_args_test;

import std.io;
import std.string;
import std.vector;
import std.assert;
import util.diag;

import cli_args;

/**
 * Tests test_default_mode_build.
 */
func test_default_mode_build() {
    with (let argv = sv_create(2) => sv_free(argv)) {
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected CLI parse success");
        assert(parsed.options != null, "expected parsed options");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_BUILD), "default mode must be build");
        assert(opts.entry_target != null, "expected entry target");
        assert(opts.entry_target as string == "app.main", "expected app.main target");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_run_accepts_program_args_after_separator.
 */
func test_run_accepts_program_args_after_separator() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--run");
        sv_push(argv, "app.main");
        sv_push(argv, "--");
        sv_push(argv, "alpha");
        sv_push(argv, "--beta");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected run parse success");
        let opts = parsed.options as CliOptions*;

        assert(ord(opts.mode) == ord(CM_RUN), "expected run mode");
        assert(opts.entry_target as string == "app.main", "expected run target");
        assert(sv_size(opts.program_args) == 2, "expected 2 program args");
        assert(sv_get(opts.program_args, 0) == "alpha", "expected alpha arg");
        assert(sv_get(opts.program_args, 1) == "--beta", "expected --beta arg");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_non_run_rejects_program_args_separator.
 */
func test_non_run_rejects_program_args_separator() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "app.main");
        sv_push(argv, "--");
        sv_push(argv, "x");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for -- outside run");
        assert(parsed.options == null, "options must be null on parse errors");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_mode_scoped_flag_validation.
 */
func test_mode_scoped_flag_validation() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "--keep-c");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for invalid scoped flag");
        assert(parsed.options == null, "options must be null on parse errors");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_multiple_targets_rejected.
 */
func test_multiple_targets_rejected() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "a");
        sv_push(argv, "b");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for multi-target");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_help_flag_short_circuits_validation.
 */
func test_help_flag_short_circuits_validation() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "-h");
        sv_push(argv, "--bogus");

        let parsed = cli_parse(argv);
        assert(parsed.help_requested, "expected help request");
        assert(!diag_has_errors(parsed.diags), "help should not emit diagnostics");
        assert(parsed.options == null, "help should not return parsed options");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_version_flag_short_circuits_validation.
 */
func test_version_flag_short_circuits_validation() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "--version");
        sv_push(argv, "--bogus");

        let parsed = cli_parse(argv);
        assert(parsed.version_requested, "expected version request");
        assert(!parsed.help_requested, "version should not set help");
        assert(!diag_has_errors(parsed.diags), "version should not emit diagnostics");
        assert(parsed.options == null, "version should not return parsed options");
        assert(parsed.verbosity == 0, "version request should preserve parsed verbosity");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests that `--ast` is accepted as a valid mode.
 */
func test_ast_mode_accepted() {
    with (let argv = sv_create(2) => sv_free(argv)) {
        sv_push(argv, "--ast");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected --ast parse success");
        assert(parsed.options != null, "expected parsed options for --ast");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_AST), "expected CM_AST mode");
        assert(opts.entry_target != null, "expected entry target");
        assert(opts.entry_target as string == "app.main", "expected app.main target");
        assert(!opts.all_modules, "all_modules should default to false");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests that `--ast --all-modules` is accepted.
 */
func test_ast_all_modules_accepted() {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "--ast");
        sv_push(argv, "--all-modules");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected --ast --all-modules parse success");
        assert(parsed.options != null, "expected parsed options");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_AST), "expected CM_AST mode");
        assert(opts.all_modules, "all_modules must be true");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_no_legacy_command_rewrite.
 */
func test_no_legacy_command_rewrite() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "run");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "legacy command words should not be rewritten");
        cli_parse_result_free(parsed);
    }
}

