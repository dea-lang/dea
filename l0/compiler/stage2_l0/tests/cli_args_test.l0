        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_check_basic_rejected_with_trace_or_unchecked_flags.
 */
func test_check_basic_rejected_with_trace_or_unchecked_flags() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--build");
        sv_push(argv, "--check-basic");
        sv_push(argv, "--trace-memory");
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for --check-basic with trace flags");
        assert(parsed.options == null, "options must be null on parse errors");
        assert(diag_get(parsed.diags, 0).code == "L0C-2028", "expected check-basic conflict diagnostic");

        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(8) => sv_free(argv2)) {
        sv_push(argv2, "--build");
        sv_push(argv2, "--check-basic");
        sv_push(argv2, "--unchecked");
        sv_push(argv2, "app.main");

        let parsed2 = cli_parse(argv2);
        assert(diag_has_errors(parsed2.diags), "expected parse errors for --check-basic with unchecked");
        assert(parsed2.options == null, "options must be null on parse errors");
        assert(diag_get(parsed2.diags, 0).code == "L0C-2028", "expected check-basic conflict diagnostic");

        cli_parse_result_free(parsed2);
    }
}

/**
 * Main entry point for the module.
 */
func main() {
    test_default_mode_build();
    test_run_accepts_program_args_after_separator();
    test_non_run_rejects_separator();
    test_mode_scoped_flag_validation();
    test_multiple_targets_rejected();
    test_compile_mode_and_interface_paths_parsed();
    test_compile_mode_validation();
    test_interface_path_scope_and_value_validation();
    test_namespaced_aliases_and_long_forms();
    test_namespaced_values_and_clusters_are_exact();
    test_value_options_reject_separator_as_value();
    test_canonical_equals_value_spellings_rejected();
    test_canonical_reservations_and_retired_aliases();
    test_help_flag_short_circuits_validation();
    test_version_flag_short_circuits_validation();
    test_no_legacy_command_rewrite();
    test_ast_mode_accepted();
    test_ast_all_modules_accepted();
    test_unchecked_flag_parsed_in_build_mode();
    test_unchecked_rejected_outside_build_run_gen();
    test_unchecked_rejected_with_trace_flags();
    test_check_basic_flag_parsed_in_build_mode();
    test_check_basic_rejected_outside_build_run_gen();
    test_check_basic_rejected_with_trace_or_unchecked_flags();
    printl_s("cli_args_test: all tests passed");
}
