module cli_args_test;

import std.io;
import std.string;
import std.vector;
import std.assert;
import util.diag;

import cli_args;

/**
 * Return whether a CLI parse result contains one diagnostic code.
 *
 * @param parsed Parse result to inspect.
 * @param code Diagnostic code to find.
 * @return `true` when the code is present.
 */
func cli_result_has_code(parsed: CliParseResult*, code: string) -> bool {
    for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
        if (diag_get(parsed.diags, i).code == code) {
            return true;
        }
    }
    return false;
}

/**
 * Count diagnostics with one code in a CLI parse result.
 *
 * @param parsed Parse result to inspect.
 * @param code Diagnostic code to count.
 * @return Number of matching diagnostics.
 */
func cli_result_count_code(parsed: CliParseResult*, code: string) -> int {
    let count = 0;
    for (let i = 0; i < diag_count(parsed.diags); i = i + 1) {
        if (diag_get(parsed.diags, i).code == code) {
            count = count + 1;
        }
    }
    return count;
}

/**
 * Assert that a separated value option immediately before `--` reports one
 * missing-value diagnostic and does not consume the separator.
 *
 * @param option Value-taking option spelling to test.
 */
func assert_separator_boundary_missing_value(option: string) {
    with (let argv = sv_create(4) => sv_free(argv)) {
        sv_push(argv, "app.main");
        sv_push(argv, option);
        sv_push(argv, "--");
        sv_push(argv, "program-arg");

        let parsed = cli_parse(argv);
        assert(diag_count(parsed.diags) == 1, "separator-boundary value error must be the only diagnostic");
        assert(diag_get(parsed.diags, 0).code == "L0C-2003", "expected separator-boundary missing-value diagnostic");
        assert(
            diag_get(parsed.diags, 0).message == "missing value for option '" + option + "'",
            "missing-value diagnostic must preserve the exact option token"
        );
        cli_parse_result_free(parsed);
    }
}

/**
 * Assert that a canonical attached `=VALUE` spelling is unknown.
 *
 * @param option Complete option token to reject.
 */
func assert_canonical_equals_value_unknown(option: string) {
    with (let argv = sv_create(3) => sv_free(argv)) {
        sv_push(argv, option);
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(diag_count(parsed.diags) == 1, "canonical =VALUE rejection must be the only diagnostic");
        assert(diag_get(parsed.diags, 0).code == "L0C-2001", "expected canonical =VALUE spelling to be unknown");
        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_default_mode_build.
 */
func test_default_mode_build() {
    with (let argv = sv_create(2) => sv_free(argv)) {
        sv_push(argv, "app.main");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected CLI parse success");
        assert(parsed.options != null, "expected parsed options");

        let opts = parsed.options as CliOptions*;
        assert(ord(opts.mode) == ord(CM_BUILD), "default mode must be build");
        assert(opts.entry_target != null, "expected entry target");
        assert(opts.entry_target as string == "app.main", "expected app.main target");

        cli_parse_result_free(parsed);
    }
}

/**
 * Tests test_run_accepts_program_args_after_separator.
 */
func test_run_accepts_program_args_after_separator() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--run");
        sv_push(argv, "app.main");
        sv_push(argv, "--");
        sv_push(argv, "alpha");
        sv_push(argv, "--beta");

        let parsed = cli_parse(argv);
        assert(!diag_has_errors(parsed.diags), "expected run parse success");
        let opts = parsed.options as CliOptions*;

        assert(ord(opts.mode) == ord(CM_RUN), "expected run mode");
        assert(opts.entry_target as string == "app.main", "expected run target");
        assert(sv_size(opts.program_args) == 2, "expected 2 program args");
        assert(sv_get(opts.program_args, 0) == "alpha", "expected alpha arg");
        assert(sv_get(opts.program_args, 1) == "--beta", "expected --beta arg");

        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(4) => sv_free(argv2)) {
        sv_push(argv2, "--run");
        sv_push(argv2, "app.main");
        sv_push(argv2, "--");

        let parsed2 = cli_parse(argv2);
        assert(!diag_has_errors(parsed2.diags), "expected bare run separator to parse");
        let opts2 = parsed2.options as CliOptions*;
        assert(ord(opts2.mode) == ord(CM_RUN), "expected run mode for bare separator");
        assert(sv_size(opts2.program_args) == 0, "bare run separator must produce no program args");

        cli_parse_result_free(parsed2);
    }
}

/**
 * Tests test_non_run_rejects_separator.
 */
func test_non_run_rejects_separator() {
    with (let argv = sv_create(8) => sv_free(argv)) {
        sv_push(argv, "--check");
        sv_push(argv, "app.main");
        sv_push(argv, "--");
        sv_push(argv, "x");

        let parsed = cli_parse(argv);
        assert(diag_has_errors(parsed.diags), "expected parse errors for -- outside run");
        assert(parsed.options == null, "options must be null on parse errors");
        assert(cli_result_has_code(parsed, "L0C-2023"), "expected non-run separator diagnostic");

        cli_parse_result_free(parsed);
    }

    with (let argv2 = sv_create(4) => sv_free(argv2)) {
        sv_push(argv2, "--compile");
        sv_push(argv2, "app.main");
        sv_push(argv2, "--");

        let parsed2 = cli_parse(argv2);
        assert(diag_count(parsed2.diags) == 1, "bare non-run separator should emit one diagnostic");
        assert(cli_result_has_code(parsed2, "L0C-2023"), "expected bare non-run separator diagnostic");
        assert(parsed2.options == null, "bare non-run separator must invalidate parsed options");

        cli_parse_result_free(parsed2);
    }
}

