/** Build and run commands with one workspace lifetime and cleanup epilogue. */
module build_driver;

import std.system;
import std.vector;
import util.diag;
import util.log;
import sem_context;
import cli_args.model;
import compiler_filesystem;
import diag_print;
import build_driver.input;
import build_driver.platform;
import build_driver.workspace;

/**
 * Execute Stage 2 `--build`.
 *
 * @param opts Parsed CLI options.
 * @param cfg Logging configuration.
 * @return Process-style status code.
 */
func bd_cmd_build(opts: CliOptions*, cfg: LogConfig*) -> int {
    let result_opt = bd_prepare_build_result(opts, cfg);
    if (result_opt == null) {
        return 1;
    }
    let result = result_opt as AnalysisResult*;

    with (let workspace_diags = diag_create() => diag_free(workspace_diags)) {
        let workspace_opt = cfs_workspace_create(
            "build", workspace_diags);
        if (workspace_opt == null) {
            dp_print_collector(workspace_diags);
            analysis_result_free(result);
            return 1;
        }
        let workspace = workspace_opt as CompilerWorkspace*;
        log_info(
            cfg,
            "Compiler temporary workspace: " + workspace.root);

        let exe_path = bd_default_exe_name();
        if (opts.output != null) {
            exe_path = opts.output as string;
        }
        let keep_c_path: string? = null;
        if (opts.keep_c) {
            keep_c_path = bd_with_c_suffix(exe_path);
        }
        let primary_status = bd_build_to_exe(
            opts, cfg, result, workspace, exe_path, keep_c_path);
        analysis_result_free(result);

        let cleanup_ok = cfs_workspace_cleanup(
            workspace, workspace_diags);
        if (diag_count(workspace_diags) > 0) {
            dp_print_collector(workspace_diags);
        }
        let status = cfs_apply_cleanup_status(
            primary_status, cleanup_ok);
        cfs_workspace_free(workspace);
        return status;
    }
}

/**
 * Execute Stage 2 `--run`.
 *
 * @param opts Parsed CLI options.
 * @param cfg Logging configuration.
 * @return Process-style status code.
 */
func bd_cmd_run(opts: CliOptions*, cfg: LogConfig*) -> int {
    with (
        let run_diags = diag_create() => diag_free(run_diags),
        let workspace_diags = diag_create() => diag_free(workspace_diags)
    ) {
        if (opts.output != null && !opts.keep_c) {
            diag_warn(
                run_diags,
                "l0c",
                "L0C-0017",
                "'--output' is ignored in '--run' mode unless '--keep-c' is set; the executable path remains temporary",
                "",
                0,
                0,
                0,
                0
            );
            dp_print_collector(run_diags);
        }

        let result_opt = bd_prepare_build_result(opts, cfg);
        if (result_opt == null) {
            return 1;
        }
        let result = result_opt as AnalysisResult*;

        let workspace_opt = cfs_workspace_create(
            "run", workspace_diags);
        if (workspace_opt == null) {
            dp_print_collector(workspace_diags);
            analysis_result_free(result);
            return 1;
        }
        let workspace = workspace_opt as CompilerWorkspace*;
        log_info(
            cfg,
            "Compiler temporary workspace: " + workspace.root);
        let temp_exe = cfs_workspace_child(
            workspace, "program" + bd_exe_suffix());

        let keep_c_path: string? = null;
        if (opts.keep_c) {
            if (opts.output != null) {
                keep_c_path = bd_with_c_suffix(opts.output as string);
            } else {
                keep_c_path = "a.c";
            }
        }

        let primary_status = bd_build_to_exe(
            opts, cfg, result, workspace, temp_exe, keep_c_path);
        analysis_result_free(result);

        if (primary_status == 0) {
            with (
                let words = sv_create(
                    sv_size(opts.program_args) + 1) =>
                    sv_free(words)
            ) {
                sv_push(words, temp_exe);
                for (
                    let i = 0;
                    i < sv_size(opts.program_args);
                    i = i + 1
                ) {
                    sv_push(words, sv_get(opts.program_args, i));
                }

                log_info(
                    cfg,
                    "Running: " + bd_join_display_words(words));
                let run_cmd = bd_join_shell_words(words);
                let run_rc = system(run_cmd);
                if (run_rc < 0) {
                    primary_status = 1;
                } else {
                    primary_status = run_rc;
                }
            }
        }

        let cleanup_ok = cfs_workspace_cleanup(
            workspace, workspace_diags);
        if (diag_count(workspace_diags) > 0) {
            dp_print_collector(workspace_diags);
        }
        let status = cfs_apply_cleanup_status(
            primary_status, cleanup_ok);
        cfs_workspace_free(workspace);
        return status;
    }
}
