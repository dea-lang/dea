module parser.decl;

import std.text;
import std.vector;
import util.diag;

import tokens;
import lexer;
import ast;
import parser.shared;
import parser.expr;
import parser.stmt;

/* ---------------------------------
   Top-level declarations
   --------------------------------- */

/**
 * Create an empty block statement node in the statement arena.
 *
 * @param self Parser state providing the statement arena.
 * @param span Source span for the synthetic block.
 * @return Statement id for the created block.
 */
func ps_make_empty_block_stmt(self: ParserState*, span: Span) -> StmtId {
    let node = stmt_node_create(ST_BLOCK, span);
    node.ids = id_vec_create(0);
    return stmt_arena_add(self.stmt_arena, node);
}

/**
 * Finish parsing a function declaration after its signature.
 *
 * @param self Parser state to advance.
 * @param start Starting span for the declaration.
 * @param name_tok Function name token.
 * @param params Parsed parameter vector.
 * @param is_extern Whether this is an extern declaration.
 * @param ret_type Parsed return type.
 * @return Completed function declaration, or `null` on error.
 */
func ps_finish_function(self: ParserState*, start: Span, name_tok: Token, params: VectorBase*, is_extern: bool, ret_type: TypeRef*) -> FuncDecl*? {
    let body = invalid_stmt_id();
    if (is_extern) {
        ps_expect(self, ord(TT_SEMI), "PAR-0046", "expected ';' after extern function decl")?;
        body = ps_make_empty_block_stmt(self, ps_extend_span(self, start));
    } else {
        body = ps_parse_block(self)?;
    }

    return new FuncDecl(
        token_ident_text(name_tok) as string,
        params,
        ret_type,
        body,
        is_extern,
        ps_extend_span(self, start)
    );
}

/**
 * Parse a function declaration.
 *
 * @param self Parser state to advance.
 * @param is_extern Whether the declaration started with `extern`.
 * @return Parsed function declaration, or `null` on error.
 */
func ps_parse_function(self: ParserState*, is_extern: bool) -> FuncDecl*? {
    let start = ps_span_start(self);
    ps_expect(self, ord(TT_FUNC), "PAR-0040", "expected 'func'")?;
    let name_tok = ps_expect_ident(self, "PAR-0041", "expected function name")?;
    ps_expect(self, ord(TT_LPAREN), "PAR-0042", "expected '('")?;

    with (let params: VectorBase*? = ptr_vec_create(4) => param_vec_free(params),
          let ret_type: TypeRef*? = null => type_ref_free(ret_type)) {
        if (!ps_check(self, ord(TT_RPAREN))) {
            while (true) {
                let param_name = ps_expect_ident(self, "PAR-0043", "expected parameter name")?;
                ps_expect(self, ord(TT_COLON), "PAR-0044", "expected ':' after parameter name")?;
                let param_type = ps_parse_type(self)?;
                let p = new Param(token_ident_text(param_name) as string, param_type);
                ptr_vec_push(params as VectorBase*, p as void*);
                if (!ps_match(self, ord(TT_COMMA))) {
                    break;
                }
            }
        }
        ps_expect(self, ord(TT_RPAREN), "PAR-0045", "expected ')' after parameters")?;

        if (ps_match(self, ord(TT_ARROW_FUNC))) {
            ret_type = ps_parse_type(self)?;
        } else {
            ret_type = new TypeRef("void", 0, false, null, null, ps_extend_span(self, start));
        }

        let result = ps_finish_function(self, start, name_tok, params as VectorBase*, is_extern, ret_type as TypeRef*);
        if (result != null) {
            params = null;
            ret_type = null;
        }
        return result;
    }
}

/**
 * Parse an extern function declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed extern function declaration, or `null` on error.
 */
func ps_parse_extern_func(self: ParserState*) -> FuncDecl*? {
    ps_expect(self, ord(TT_EXTERN), "PAR-0030", "expected 'extern'")?;
    return ps_parse_function(self, true);
}

/**
 * Parse a struct declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed struct declaration, or `null` on error.
 */
func ps_parse_struct(self: ParserState*) -> StructDecl*? {
    let start = ps_span_start(self);
    ps_expect(self, ord(TT_STRUCT), "PAR-0050", "expected 'struct'")?;
    let name_tok = ps_expect_ident(self, "PAR-0051", "expected struct name")?;
    ps_expect(self, ord(TT_LBRACE), "PAR-0052", "expected '{' after struct name")?;

    with (let fields: VectorBase*? = ptr_vec_create(4) => field_decl_vec_free(fields)) {
        while (!ps_check(self, ord(TT_RBRACE))) {
            let field_name = ps_expect_ident(self, "PAR-0053", "expected field name")?;
            ps_expect(self, ord(TT_COLON), "PAR-0054", "expected ':' after field name")?;
            let field_type = ps_parse_type(self)?;
            ps_expect(self, ord(TT_SEMI), "PAR-0055", "expected ';' after field declaration")?;
            let fd = new FieldDecl(token_ident_text(field_name) as string, field_type);
            ptr_vec_push(fields as VectorBase*, fd as void*);
        }

        ps_expect(self, ord(TT_RBRACE), "PAR-0056", "expected '}' after struct body")?;
        let result = new StructDecl(token_ident_text(name_tok) as string, fields as VectorBase*, ps_extend_span(self, start));
        fields = null;
        return result;
    }
}

/**
 * Parse an enum declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed enum declaration, or `null` on error.
 */
func ps_parse_enum(self: ParserState*) -> EnumDecl*? {
    let start = ps_span_start(self);
    ps_expect(self, ord(TT_ENUM), "PAR-0060", "expected 'enum'")?;
    let name_tok = ps_expect_ident(self, "PAR-0061", "expected enum name")?;
    ps_expect(self, ord(TT_LBRACE), "PAR-0062", "expected '{' after enum name")?;

    with (let variants: VectorBase*? = ptr_vec_create(4) => enum_variant_vec_free(variants)) {
        while (!ps_check(self, ord(TT_RBRACE))) {
            let var_name_tok = ps_expect_ident(self, "PAR-0063", "expected variant name")?;

            with (let fields: VectorBase*? = ptr_vec_create(2) => field_decl_vec_free(fields)) {
                if (ps_match(self, ord(TT_LPAREN))) {
                    if (!ps_check(self, ord(TT_RPAREN))) {
                        while (true) {
                            let fname = ps_expect_ident(self, "PAR-0064", "expected variant field name")?;
                            ps_expect(self, ord(TT_COLON), "PAR-0065", "expected ':'")?;
                            let ftype = ps_parse_type(self)?;
                            let fd = new FieldDecl(token_ident_text(fname) as string, ftype);
                            ptr_vec_push(fields as VectorBase*, fd as void*);
                            if (!ps_match(self, ord(TT_COMMA))) {
                                break;
                            }
                        }
                    }
                    ps_expect(self, ord(TT_RPAREN), "PAR-0066", "expected ')' after variant payload")?;
                }

                ps_expect(self, ord(TT_SEMI), "PAR-0067", "expected ';' after variant")?;
                let variant = new EnumVariant(token_ident_text(var_name_tok) as string, fields as VectorBase*);
                ptr_vec_push(variants as VectorBase*, variant as void*);
                fields = null;
            }
        }

        ps_expect(self, ord(TT_RBRACE), "PAR-0068", "expected '}' after enum body")?;
        let result = new EnumDecl(token_ident_text(name_tok) as string, variants as VectorBase*, ps_extend_span(self, start));
        variants = null;
        return result;
    }
}

/**
 * Parse a type-alias declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed type-alias declaration, or `null` on error.
 */
func ps_parse_type_alias(self: ParserState*) -> TypeAliasDecl*? {
    let start = ps_span_start(self);
    ps_expect(self, ord(TT_TYPE), "PAR-0070", "expected type name")?;
    let name_tok = ps_expect_ident(self, "PAR-0071", "expected type alias name")?;
    ps_expect(self, ord(TT_EQ), "PAR-0072", "expected '=' in type alias")?;
    let parsed = ps_parse_type(self)?;
    with (let target: TypeRef*? = parsed => type_ref_free(target)) {
        ps_expect(self, ord(TT_SEMI), "PAR-0073", "expected ';' after type alias")?;
        let result = new TypeAliasDecl(token_ident_text(name_tok) as string, target as TypeRef*, ps_extend_span(self, start));
        target = null;
        return result;
    }
}

/**
 * Parse a top-level `let` declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed top-level `let`, or `null` on error.
 */
func ps_parse_top_level_let(self: ParserState*) -> LetDecl*? {
    let start = ps_span_start(self);
    ps_expect(self, ord(TT_LET), "PAR-0080", "expected 'let'")?;
    let name_tok = ps_expect_variable_name(self, "PAR-0081", "expected variable name")?;

    with (let type_ref: TypeRef*? = null => type_ref_free(type_ref)) {
        if (ps_match(self, ord(TT_COLON))) {
            type_ref = ps_parse_type(self)?;
        }

        ps_expect(self, ord(TT_EQ), "PAR-0082", "expected '=' in let binding")?;
        let value = ps_parse_expr(self)?;
        ps_expect(self, ord(TT_SEMI), "PAR-0083", "expected ';' after let declaration")?;

        let result = new LetDecl(token_ident_text(name_tok) as string, type_ref, value, ps_extend_span(self, start));
        type_ref = null;
        return result;
    }
}

/**
 * Parse one top-level declaration.
 *
 * @param self Parser state to advance.
 * @return Parsed top-level declaration, or `null` on error.
 */
func ps_parse_top_level_decl(self: ParserState*) -> TopLevelDecl*? {
    if (ps_check(self, ord(TT_EXTERN))) {
        let decl = ps_parse_extern_func(self)?;
        return new TopLevelDecl(TD_FUNC, decl as void*);
    }
    if (ps_check(self, ord(TT_FUNC))) {
        let decl = ps_parse_function(self, false)?;
        return new TopLevelDecl(TD_FUNC, decl as void*);
    }
    if (ps_check(self, ord(TT_STRUCT))) {
        let decl = ps_parse_struct(self)?;
        return new TopLevelDecl(TD_STRUCT, decl as void*);
    }
    if (ps_check(self, ord(TT_ENUM))) {
        let decl = ps_parse_enum(self)?;
        return new TopLevelDecl(TD_ENUM, decl as void*);
    }
    if (ps_check(self, ord(TT_TYPE))) {
        let decl = ps_parse_type_alias(self)?;
        return new TopLevelDecl(TD_TYPE_ALIAS, decl as void*);
    }
    if (ps_check(self, ord(TT_LET))) {
        let decl = ps_parse_top_level_let(self)?;
        return new TopLevelDecl(TD_LET, decl as void*);
    }

    ps_emit_error(self, "PAR-0020", "unexpected token in top level: " + token_to_string(ps_peek(self)), ps_peek(self));
    return null;
}

/**
 * Parse a module declaration and its contents.
 *
 * @param self Parser state to advance.
 * @return Parsed module, or `null` on error.
 */
func ps_parse_module(self: ParserState*) -> Module*? {
    let start = ps_span_start(self);

    ps_expect(self, ord(TT_MODULE), "PAR-0310", "expected 'module'")?;

    let first_mod = ps_expect_ident(self, "PAR-0311", "expected module name")?;
    let first_text = token_ident_text(first_mod) as string;
    let module_name = parse_dotted_name_rest(self, first_text)?;

    ps_expect(self, ord(TT_SEMI), "PAR-0312", "expected ';' after module name")?;

    with (let imports: VectorBase*? = ptr_vec_create(4) => import_vec_free(imports),
          let decls: VectorBase*? = ptr_vec_create(8) => top_level_decl_vec_free(decls)) {
        while (ps_check(self, ord(TT_IMPORT))) {
            let imp_start = ps_span_start(self);
            ps_advance(self);
            let first = ps_expect_ident(self, "PAR-0320", "expected imported module name")?;
            let first_imp = token_ident_text(first) as string;
            let imp_name = parse_dotted_name_rest(self, first_imp)?;
            ps_expect(self, ord(TT_SEMI), "PAR-0321", "expected ';' after import")?;
            let imp = new Import(imp_name, ps_extend_span(self, imp_start));
            ptr_vec_push(imports as VectorBase*, imp as void*);
        }

        while (!ps_at_end(self) && !self.eof_aborted) {
            let before = self.index;
            let decl = ps_parse_top_level_decl(self);
            if (decl != null) {
                ptr_vec_push(decls as VectorBase*, decl as void*);
                continue;
            }

            ps_sync_top_level(self);
            if (self.index == before && !ps_at_end(self)) {
                ps_advance(self);
            }
        }

        let result = new Module(module_name, imports as VectorBase*, decls as VectorBase*, ps_extend_span(self, start), self.filename);
        imports = null;
        decls = null;
        return result;
    }
}

/* ---------------------------------
   Public API
   --------------------------------- */

/**
 * Parse a module from a token stream and keep the internal arenas.
 *
 * @param tokens Token stream to parse.
 * @param filename Source filename used in diagnostics.
 * @return Internal parse result.
 */
func impl_parse_module_tokens(tokens: TokenVector, filename: string) -> ImplParseResult* {
    let ps = ps_create(tokens, filename);
    let mod = ps_parse_module(ps);

    let result = new ImplParseResult(
        mod,
        ps.expr_arena,
        ps.stmt_arena,
        ps.pattern_arena,
        ps.diags
    );

    ps_destroy(ps);
    return result;
}

/**
 * Build a parser result from lexer diagnostics when tokenization fails.
 *
 * @param ls Lexer state holding diagnostics.
 * @param filename Source filename used for fallback diagnostics.
 * @return Internal parse result containing copied lexer diagnostics.
 */
func ps_lex_error_result(ls: LexerState*, filename: string) -> ImplParseResult* {
    let expr_ar = expr_arena_create(1);
    let stmt_ar = stmt_arena_create(1);
    let pat_ar = pattern_arena_create(1);
    let diags = diag_create();

    let source_count = diag_count(ls.diags);
    for (let i = 0; i < source_count; i = i + 1) {
        let src = diag_get(ls.diags, i);
        match (src.severity) {
            Error => {
                diag_error(diags, src.phase, src.code, src.message, src.filename, src.line, src.column, src.line_end, src.column_end);
            }
            Warning => {
                diag_warn(diags, src.phase, src.code, src.message, src.filename, src.line, src.column, src.line_end, src.column_end);
            }
            Note => {
                diag_note(diags, src.phase, src.code, src.message, src.filename, src.line, src.column, src.line_end, src.column_end);
            }
        }
    }

    if (!diag_has_errors(diags)) {
        diag_error(diags, "Parser", "PAR-0000", "unknown parse/lex error", filename, ls.line, ls.column, ls.line, ls.column);
    }

    let result = new ImplParseResult(null, expr_ar, stmt_ar, pat_ar, diags);
    ls_free(ls);
    return result;
}

/**
 * Parse tokenized source and clean up lexer/token resources.
 *
 * @param ls Lexer state to free after parsing.
 * @param toks Token stream to parse and then free.
 * @param filename Source filename used in diagnostics.
 * @return Internal parse result.
 */
func ps_tokens_result(ls: LexerState*, toks: TokenVector, filename: string) -> ImplParseResult* {
    let result = impl_parse_module_tokens(toks, filename);
    tv_free(toks);
    ls_free(ls);
    return result;
}

/**
 * Lex and parse a module from source text, preserving internal arenas.
 *
 * @param source Source text to parse.
 * @param filename Source filename used in diagnostics.
 * @return Internal parse result.
 */
func impl_parse_module_source(source: string, filename: string) -> ImplParseResult* {
    let ls = ls_create(source, filename);
    let toks = tokenize(ls);
    if (toks == null) {
        return ps_lex_error_result(ls, filename);
    }
    return ps_tokens_result(ls, toks as TokenVector, filename);
}
