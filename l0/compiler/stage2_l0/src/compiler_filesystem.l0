module compiler_filesystem;

import sys.rt;

import std.array;
import std.string;
import std.system;
import std.text;
import std.time;
import std.vector;
import util.diag;

/*
 * This ABI is compiler-internal. Its implementation lives in the L0 Stage 2
 * compiler-support translation unit, not in the Dea runtime or stdlib.
 */

/**
 * Create one directory from a native path byte span.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @param mode POSIX permission and special bits through `07777`; validated but
 *     otherwise ignored on Windows.
 * @return `1` after creation, `0` when an object already exists at the path,
 *     or `-1` on invalid input or an operating-system error.
 */
extern func l0c_fs_mkdir(path: byte*, path_len: int, mode: int) -> int;

/**
 * Join a trusted parent path and one internal child name.
 *
 * A query with a null `output` and zero capacity returns the required byte
 * length. A sufficiently large output span receives the path without a
 * trailing NUL.
 *
 * @param parent Non-empty native parent path bytes without an embedded NUL.
 * @param parent_len Number of bytes in `parent`.
 * @param child Non-empty native child-name bytes without an embedded NUL.
 * @param child_len Number of bytes in `child`.
 * @param output Optional destination for the joined path bytes.
 * @param output_capacity Available bytes in `output`, or zero for a query.
 * @return Required byte length, or `-1` on invalid input or overflow.
 */
extern func l0c_fs_join_child(
    parent: byte*,
    parent_len: int,
    child: byte*,
    child_len: int,
    output: byte*?,
    output_capacity: int
) -> int;

/**
 * Classify one native path without following a final symlink or reparse point.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @return A `CFS_PATH_*` kind, or `-1` on invalid input or an
 *     operating-system error.
 */
extern func l0c_fs_path_kind_nofollow(path: byte*, path_len: int) -> int;

/**
 * Classify one native path after following symlinks or reparse points.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @return A `CFS_PATH_*` kind, with dangling links reported as absent, or
 *     `-1` on invalid input or an operating-system error.
 */
extern func l0c_fs_path_kind_follow(path: byte*, path_len: int) -> int;

/**
 * Remove one regular file without following a substituted path object.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @return `1` after removal, `0` when absent, or `-1` for invalid input, an
 *     unsupported object kind, or an operating-system error.
 */
extern func l0c_fs_remove_regular_file(path: byte*, path_len: int) -> int;

/**
 * Remove one empty real directory without accepting a symlink or reparse point.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @return `1` after removal, `0` when absent, or `-1` on invalid input, a
 *     non-directory object, a non-empty directory, or an operating-system
 *     error.
 */
extern func l0c_fs_remove_empty_dir(path: byte*, path_len: int) -> int;

/** Inspect once; the caller must release the returned native snapshot. */
extern func l0c_fs_inspect_temp_parent(path: byte*, path_len: int) -> byte*?;
/** Status: trusted, resolution, inspection, type, owner, sticky bit, internal, close, retries. */
extern func l0c_fs_temp_parent_status(report: byte*) -> int;
/** Read path (0), owner/effective UID (1/2), or Windows operation/error (3/4). */
extern func l0c_fs_temp_parent_field(
    report: byte*, field: int, output: byte*?, capacity: int
) -> int;
/** Release a native inspection snapshot. */
extern func l0c_fs_temp_parent_free(report: byte*);

/**
 * Resolve and validate one selected compiler temporary parent.
 *
 * A query with a null `output` and zero capacity returns the canonical byte
 * length. A sufficiently large output span receives the canonical path
 * without a trailing NUL. POSIX validates the complete resolved directory
 * trust chain; Windows relies on the documented trusted-parent ACL assumption.
 *
 * @param path Non-empty native path bytes without an embedded NUL.
 * @param path_len Number of bytes in `path`.
 * @param output Optional destination for the canonical path bytes.
 * @param output_capacity Available bytes in `output`, or zero for a query.
 * @return Canonical byte length, or `-1` on invalid input, trust failure, or
 *     an operating-system error.
 */
extern func l0c_fs_resolve_trusted_temp_parent(
    path: byte*,
    path_len: int,
    output: byte*?,
    output_capacity: int
) -> int;

/** No filesystem object exists at the path. */
let CFS_PATH_ABSENT: int = 0;
/** A regular file exists at the path. */
let CFS_PATH_REGULAR: int = 1;
/** A directory exists at the path. */
let CFS_PATH_DIRECTORY: int = 2;
/** A symlink, reparse point, or other unsupported object exists at the path. */
let CFS_PATH_OTHER: int = 3;

/** Invocation-owned native build/run workspace. */
struct CompilerWorkspace {
    root: string;
    children: StringVector*;
}

/** Emit one compiler-filesystem diagnostic without source coordinates. */
func cfs_error(
    diags: DiagCollector*,
    code: string,
    message: string,
    path: string
) {
    diag_error(diags, "l0c", code, message, path, 0, 0, 0, 0);
}

/** Call the compiler-internal no-follow path classifier. */
func cfs_path_kind(path: string) -> int {
    return l0c_fs_path_kind_nofollow(
        rt_string_bytes_ptr(path), len_s(path));
}

/** Call the compiler-internal follow path classifier. */
func cfs_path_kind_follow(path: string) -> int {
    return l0c_fs_path_kind_follow(
        rt_string_bytes_ptr(path), len_s(path));
}

/**
 * Join a trusted parent and internal child using actual-host separators.
 */
func cfs_join_child(parent: string, child: string) -> string {
    let required = l0c_fs_join_child(
        rt_string_bytes_ptr(parent),
        len_s(parent),
        rt_string_bytes_ptr(child),
        len_s(child),
        null,
        0
    );
    if (required <= 0) {
        return parent + "/" + child;
    }

    let buffer = ba_create(required);
    let actual = l0c_fs_join_child(
        rt_string_bytes_ptr(parent),
        len_s(parent),
        rt_string_bytes_ptr(child),
        len_s(child),
        buffer.storage.data as byte*,
        required
    );
    if (actual != required) {
        ba_free(buffer);
        return parent + "/" + child;
    }
    let joined = bytes_to_s(buffer.storage.data as byte*, actual);
    ba_free(buffer);
    return joined;
}

/** Create one directory using the compiler-internal raw-byte ABI. */
func cfs_mkdir(path: string, mode: int) -> int {
    return l0c_fs_mkdir(
        rt_string_bytes_ptr(path), len_s(path), mode);
}

/** Remove one regular file without following a substituted path. */
func cfs_remove_regular_file(path: string) -> int {
    return l0c_fs_remove_regular_file(
        rt_string_bytes_ptr(path), len_s(path));
}

/** Remove one empty real directory through the compiler-internal ABI. */
func cfs_remove_empty_dir(path: string) -> int {
    return l0c_fs_remove_empty_dir(
        rt_string_bytes_ptr(path), len_s(path));
}

/**
 * Resolve and validate one selected temporary parent.
 *
 * The support ABI determines the actual host. POSIX validates the complete
 * resolved owner/sticky-bit chain; Windows retains the trusted-parent ACL
 * assumption. Platform-alias environment variables are deliberately ignored.
 *
 * @param path Selected existing directory.
 * @return Canonical trusted path, or `null` on failure.
 */
func cfs_resolve_trusted_temp_parent(path: string) -> string? {
    return cfs_inspect_temp_parent(path, null);
}

/** Copy a stable native snapshot field without repeating filesystem inspection. */
func cfs_temp_parent_field(report: byte*, field: int) -> string {
    let required = l0c_fs_temp_parent_field(report, field, null, 0);
    if (required <= 0) {
        return "";
    }
    let buffer = ba_create(required);
    let actual = l0c_fs_temp_parent_field(
        report, field, buffer.storage.data as byte*, required);
    let result = "";
    if (actual == required) {
        result = bytes_to_s(buffer.storage.data as byte*, actual);
    }
    ba_free(buffer);
    return result;
}

/** Format captured validation evidence without touching the filesystem. */
func cfs_temp_parent_failure_message(
    status: int, component: string, owner: string, effective: string
) -> string {
    let message = "cannot resolve compiler temporary parent: " + component;
    if (status == 2) {
        message = "cannot inspect temporary hierarchy directory: " + component;
    } else if (status == 3) {
        message = "temporary hierarchy component is not a directory: " + component;
    } else if (status == 4) {
        message = "temporary hierarchy directory '" + component + "' has owner UID " +
            owner + "; expected UID 0 or effective UID " +
            effective;
    } else if (status == 5) {
        message = "temporary hierarchy directory '" + component +
            "' is group- or other-writable; the sticky bit is required";
    } else if (status == 6) {
        message = "cannot initialize compiler temporary-parent inspection: " + component;
    } else if (status == 7) {
        message = "cannot close compiler temporary-parent handle: " + component;
    } else if (status == 8) {
        message = "compiler temporary-parent canonical path exceeded size retries: " + component;
    }
    return message;
}

/** Append captured Win32 evidence without querying mutable host error state. */
func cfs_temp_parent_windows_detail(message: string, operation: string, error: string) -> string {
    if (len_s(operation) == 0) {
        return message;
    }
    return message + "; " + operation + " failed (Windows error " + error + ")";
}

/** Resolve a trusted path, optionally reporting the captured failure requirement. */
func cfs_inspect_temp_parent(path: string, diags: DiagCollector*?) -> string? {
    let snapshot = l0c_fs_inspect_temp_parent(rt_string_bytes_ptr(path), len_s(path));
    if (snapshot == null) {
        if (diags != null) {
            cfs_error(diags as DiagCollector*, "L0C-9513",
                "cannot initialize compiler temporary-parent inspection: " + path, path);
        }
        return null;
    }
    let report = snapshot as byte*;
    let status = l0c_fs_temp_parent_status(report);
    let component = cfs_temp_parent_field(report, 0);
    if (status == 0) {
        l0c_fs_temp_parent_free(report);
        return component;
    }
    let message = cfs_temp_parent_failure_message(status, component,
        cfs_temp_parent_field(report, 1), cfs_temp_parent_field(report, 2));
    message = cfs_temp_parent_windows_detail(message,
        cfs_temp_parent_field(report, 3), cfs_temp_parent_field(report, 4));
    l0c_fs_temp_parent_free(report);
    if (diags != null) {
        cfs_error(diags as DiagCollector*, "L0C-9513", message, component);
    }
    return null;
}

/**
 * Select a temporary parent from explicit candidate values.
 *
 * Empty values, absent paths, and non-directories fall through. Inspection
 * errors are fatal; once a directory is selected, canonical resolution and
 * trust validation are also authoritative.
 *
 * The explicit `system_tmp` and `fallback` parameters are an internal test
 * seam. Production supplies `/tmp` and `.` respectively.
 */
func cfs_select_temp_parent_from_values(
    tmpdir: string?,
    temp: string?,
    tmp: string?,
    system_tmp: string,
    fallback: string,
    diags: DiagCollector*
) -> string? {
    if (tmpdir != null && len_s(tmpdir as string) > 0) {
        let candidate = tmpdir as string;
        let kind = cfs_path_kind_follow(candidate);
        if (kind == CFS_PATH_DIRECTORY) {
            return candidate;
        }
        if (kind < 0) {
            cfs_error(
                diags,
                "L0C-9513",
                "cannot inspect compiler temporary parent: " + candidate,
                candidate
            );
            return null;
        }
    }

    if (temp != null && len_s(temp as string) > 0) {
        let candidate = temp as string;
        let kind = cfs_path_kind_follow(candidate);
        if (kind == CFS_PATH_DIRECTORY) {
            return candidate;
        }
        if (kind < 0) {
            cfs_error(
                diags,
                "L0C-9513",
                "cannot inspect compiler temporary parent: " + candidate,
                candidate
            );
            return null;
        }
    }

    if (tmp != null && len_s(tmp as string) > 0) {
        let candidate = tmp as string;
        let kind = cfs_path_kind_follow(candidate);
        if (kind == CFS_PATH_DIRECTORY) {
            return candidate;
        }
        if (kind < 0) {
            cfs_error(
                diags,
                "L0C-9513",
                "cannot inspect compiler temporary parent: " + candidate,
                candidate
            );
            return null;
        }
    }

    let system_tmp_kind = cfs_path_kind_follow(system_tmp);
    if (system_tmp_kind == CFS_PATH_DIRECTORY) {
        return system_tmp;
    }
    if (system_tmp_kind < 0) {
        cfs_error(
            diags,
            "L0C-9513",
            "cannot inspect compiler temporary parent: " + system_tmp,
            system_tmp
        );
        return null;
    }
    return fallback;
}

/**
 * Return the first existing temporary-parent directory by stable precedence.
 */
func cfs_select_temp_parent(diags: DiagCollector*) -> string? {
    return cfs_select_temp_parent_from_values(
        env_get("TMPDIR"),
        env_get("TEMP"),
        env_get("TMP"),
        "/tmp",
        ".",
        diags
    );
}

/** Release a workspace path bundle after explicit cleanup. */
func cfs_workspace_free(self: CompilerWorkspace*) {
    sv_free(self.children);
    drop self;
}

/**
 * Register and return one fixed driver-selected workspace child.
 *
 * @param workspace Workspace that owns the child.
 * @param leaf Fixed child filename.
 * @return Joined child path.
 */
func cfs_workspace_child(
    workspace: CompilerWorkspace*,
    leaf: string
) -> string {
    let child = cfs_join_child(workspace.root, leaf);
    sv_push(workspace.children, child);
    return child;
}

/**
 * Exclusively reserve one workspace from a deterministic identity tuple.
 *
 * Pre-existing candidates are skipped and no unchecked fallback is returned.
 */
func cfs_workspace_create_for_identity(
    parent_path: string,
    tag: string,
    pid: int,
    sec: int,
    nsec: int,
    diags: DiagCollector*
) -> CompilerWorkspace*? {
    for (let attempt = 0; attempt < 100; attempt = attempt + 1) {
        let name = ".l0c-" + tag + "-workspace-" +
            int_to_string(pid) + "-" + int_to_string(sec) + "-" +
            int_to_string(nsec) + "-" + int_to_string(attempt);
        let root = cfs_join_child(parent_path, name);
        /* POSIX 0700; MinGW inherits access control from the trusted parent. */
        let created = cfs_mkdir(root, 448);
        if (created == 1) {
            return new CompilerWorkspace(root, sv_create(4));
        }
        if (created < 0) {
            cfs_error(
                diags,
                "L0C-9513",
                "cannot create compiler temporary workspace: " + root,
                root
            );
            return null;
        }
    }

    cfs_error(
        diags,
        "L0C-9513",
        "cannot reserve a unique compiler temporary workspace under: " +
            parent_path,
        parent_path
    );
    return null;
}

/**
 * Select, resolve, validate, and exclusively reserve one compiler workspace.
 */
func cfs_workspace_create(
    tag: string,
    diags: DiagCollector*
) -> CompilerWorkspace*? {
    let selected_opt = cfs_select_temp_parent(diags);
    if (selected_opt == null) {
        return null;
    }
    let selected = selected_opt as string;
    let resolved = cfs_inspect_temp_parent(selected, diags);
    if (resolved == null) {
        return null;
    }

    let pid = get_pid();
    let sec = 0;
    let nsec = 0;
    let now_opt = wall_now();
    if (now_opt != null) {
        let now = now_opt as WallTime;
        sec = now.sec;
        nsec = now.nsec;
    }
    return cfs_workspace_create_for_identity(
        resolved as string, tag, pid, sec, nsec, diags);
}

/**
 * Remove only known regular children, then the empty owned directory.
 *
 * Cleanup first verifies the workspace root without following aliases. An
 * unexpected child or substituted path retains the workspace for inspection.
 */
func cfs_workspace_cleanup(
    workspace: CompilerWorkspace*,
    diags: DiagCollector*
) -> bool {
    let root_kind = cfs_path_kind(workspace.root);
    if (root_kind == CFS_PATH_ABSENT) {
        return true;
    }
    if (root_kind != CFS_PATH_DIRECTORY) {
        cfs_error(
            diags,
            "L0C-9514",
            "cannot clean compiler temporary workspace; retained at '" +
                workspace.root + "'",
            workspace.root
        );
        return false;
    }

    let ok = true;
    for (let i = 0; i < sv_size(workspace.children); i = i + 1) {
        if (cfs_remove_regular_file(
                sv_get(workspace.children, i)) < 0) {
            ok = false;
        }
    }
    if (cfs_remove_empty_dir(workspace.root) < 0) {
        ok = false;
    }
    if (!ok) {
        cfs_error(
            diags,
            "L0C-9514",
            "cannot clean compiler temporary workspace; retained at '" +
                workspace.root + "'",
            workspace.root
        );
    }
    return ok;
}

/**
 * Apply cleanup failure to a command's already-determined status.
 *
 * Cleanup turns success into status 1, while an existing failure or program
 * status remains authoritative.
 */
func cfs_apply_cleanup_status(
    primary_status: int,
    cleanup_ok: bool
) -> int {
    if (primary_status == 0 && !cleanup_ok) {
        return 1;
    }
    return primary_status;
}
