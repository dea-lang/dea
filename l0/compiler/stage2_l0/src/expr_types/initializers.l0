/** Module-scope initializer traversal before function-body checking. */
module expr_types.initializers;

import std.vector;
import ast;
import driver;
import name_resolver;
import signatures;
import symbols;
import types;
import expr_types.state;
import expr_types.expr;
import expr_types.lookup;

/**
 * Find the first operand outside the static subset in a successfully typed initializer.
 *
 * @param self Checker positioned in the binding's module.
 * @param expr_id Initializer expression to inspect.
 * @return The offending node borrowed from the current arena, or null for a static expression.
 */
func etc_non_static_initializer(self: ExpressionTypeChecker*, expr_id: ExprId) -> ExprNode*? {
    let arena = (self.current_unit as DriverUnit*).parse_result.expr_arena;
    let expr = expr_arena_get(arena, expr_id);
    match (expr.kind) {
        EX_INT => { return null; }
        EX_BYTE => { return null; }
        EX_BOOL => { return null; }
        EX_STRING => { return null; }
        EX_NULL => { return null; }
        EX_PAREN => { return etc_non_static_initializer(self, expr.expr_a); }
        EX_VAR_REF => {
            let sym = etc_lookup_symbol(self, expr.text_value, expr.module_path, expr.name_qualifier);
            if (sym != null && sig_symbol_is_zero_field_enum_variant(sym as Symbol*)) return null;
        }
        EX_CALL => {
            let callee = expr_arena_get(arena, expr.expr_a);
            if (expr_is_bare_name(callee, "sizeof")) return null;
            if (ord(callee.kind) != ord(EX_VAR_REF)) return expr;
            let args = expr.ids as VectorBase*;
            if (expr_is_bare_name(callee, "ord")) {
                return etc_non_static_initializer(self, id_vec_get(args, 0));
            }
            let sym = etc_lookup_symbol(self, callee.text_value, callee.module_path, callee.name_qualifier);
            if (sym == null) return expr;
            let target = sym as Symbol*;
            let is_constructor = ord(target.kind) == ord(SYM_STRUCT) || ord(target.kind) == ord(SYM_ENUM_VARIANT) ||
                (ord(target.kind) == ord(SYM_TYPE_ALIAS) && target.resolved_type != null &&
                 ord((target.resolved_type as Type*).kind) == ord(TY_STRUCT));
            if (!is_constructor) return expr;
            if (args != null) {
                for (let i = 0; i < vec_size(args); i = i + 1) {
                    let invalid = etc_non_static_initializer(self, id_vec_get(args, i));
                    if (invalid != null) return invalid;
                }
            }
            return null;
        }
        _ => {}
    }
    return expr;
}

/**
 * Type-check module-scope `let` initializer expressions.
 *
 * Signature resolution owns top-level binding type resolution. This pass
 * checks every successfully resolved binding and records expression metadata
 * required by backend lowering.
 *
 * @param self Expression checker state.
 * @param root Module whose top-level declarations should be checked.
 */
func etc_check_top_level_initializers(self: ExpressionTypeChecker*, root: Module*) {
    let sigs = self.result.signatures as SignatureTables*;
    for (let i = 0; i < vec_size(root.decls); i = i + 1) {
        let top = ptr_vec_get(root.decls, i) as TopLevelDecl*;
        if (ord(top.kind) != ord(TD_LET)) {
            continue;
        }
        let decl = top.data as LetDecl*;
        let canonical_sym = nr_module_env_local(self.current_env as ModuleEnv*, decl.name);
        if (canonical_sym != null) {
            let canonical_span = (canonical_sym as Symbol*).span;
            if (canonical_span.start_line != decl.span.start_line ||
                canonical_span.start_column != decl.span.start_column ||
                canonical_span.end_line != decl.span.end_line ||
                canonical_span.end_column != decl.span.end_column) {
                continue;
            }
        }
        let expected = sig_lookup_let_type(sigs, root.name, decl.name);
        if (expected == null) {
            continue;
        }
        if (type_is_builtin(expected as Type*, "void")) {
            etc_diag_error(self, "TYP-0050", "variable cannot have type 'void'", root.filename, decl.span);
            continue;
        }
        let errors_before = self.result.diags.error_count;
        if (etc_check_initializer_expr(self, expected as Type*, decl.value, decl.name, root.filename, decl.span) &&
            self.result.diags.error_count == errors_before) {
            let invalid = etc_non_static_initializer(self, decl.value);
            if (invalid != null) {
                etc_diag_error(self, "TYP-0054", "A top-level let initializer must be static.",
                    root.filename, (invalid as ExprNode*).span);
            }
        }
    }
}
