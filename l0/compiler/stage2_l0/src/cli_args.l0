/** Parse a command line into validated compiler options. */
module cli_args;

import std.string;
import std.vector;
import util.diag;
import cli_args.model;
import cli_args.validate;
import cli_args.tokens;

/**
 * Parse command-line arguments into structured options.
 *
 * @param argv Argument vector excluding the executable name.
 * @return Parsed options together with any diagnostics produced during parsing.
 */
func cli_parse(argv: StringVector*) -> CliParseResult* {
    with (
        let opts: CliOptions*? = cli_options_create() => cli_options_free_opt(opts),
        let diags: DiagCollector*? = diag_create() => cli_diag_free_opt(diags)
    ) {
        let split_idx = cli_split_index(argv);
        let cli_end = sv_size(argv);
        if (split_idx >= 0) {
            cli_end = split_idx;
            for (let i = split_idx + 1; i < sv_size(argv); i = i + 1) {
                sv_push((opts as CliOptions*).program_args, sv_get(argv, i));
            }
        }

        if (cli_has_help_flag(argv, cli_end)) {
            let parsed_verbosity = (opts as CliOptions*).verbosity;
            let parsed_log = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let help_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                true,
                false,
                parsed_verbosity,
                parsed_log
            );
            diags = null;
            return help_result;
        }

        if (cli_has_version_flag(argv, cli_end)) {
            let parsed_verbosity2 = (opts as CliOptions*).verbosity;
            let parsed_log2 = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let version_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                false,
                true,
                parsed_verbosity2,
                parsed_log2
            );
            diags = null;
            return version_result;
        }

        let i = 0;
        while (i < cli_end) {
            let token = sv_get(argv, i);

            if (token == "--run" || token == "-r") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_RUN);
                i = i + 1;
                continue;
            }
            if (token == "--build") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_BUILD);
                i = i + 1;
                continue;
            }
            if (token == "--compile" || token == "-c") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_COMPILE);
                i = i + 1;
                continue;
            }
            if (token == "--gen" || token == "--codegen" || token == "-Gc") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_GEN);
                i = i + 1;
                continue;
            }
            if (token == "--check" || token == "--analyze") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_CHECK);
                i = i + 1;
                continue;
            }
            if (token == "--tok" || token == "--tokens") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_TOK);
                i = i + 1;
                continue;
            }
            if (token == "--ast") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_AST);
                i = i + 1;
                continue;
            }
            if (token == "--sym" || token == "--symbols") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_SYM);
                i = i + 1;
                continue;
            }
            if (token == "--type" || token == "--types") {
                cli_try_set_mode(opts as CliOptions*, diags as DiagCollector*, CM_TYPE);
                i = i + 1;
                continue;
            }

            if (token == "--verbose") {
                (opts as CliOptions*).verbosity = (opts as CliOptions*).verbosity + 1;
                i = i + 1;
                continue;
            }

            let vcount = cli_verbose_cluster_count(token);
            if (vcount > 0) {
                (opts as CliOptions*).verbosity = (opts as CliOptions*).verbosity + vcount;
                i = i + 1;
                continue;
            }

            if (token == "-Vl" || token == "--log") {
                (opts as CliOptions*).log = true;
                i = i + 1;
                continue;
            }

            if (token == "-g") {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-g", "debug information");
                i = i + 1;
                continue;
            }

            if (token == "-S") {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-S", "assembly output");
                i = i + 1;
                continue;
            }

            if (token == "-NLD" || token == "--no-line-directives") {
                (opts as CliOptions*).no_line_directives = true;
                i = i + 1;
                continue;
            }

            if (token == "-Va" || token == "--trace-arc") {
                (opts as CliOptions*).trace_arc = true;
                i = i + 1;
                continue;
            }

            if (token == "-Vm" || token == "--trace-memory") {
                (opts as CliOptions*).trace_memory = true;
                i = i + 1;
                continue;
            }

            if (token == "-Su" || token == "--unchecked") {
                (opts as CliOptions*).unchecked = true;
                i = i + 1;
                continue;
            }

            if (token == "-Sb" || token == "--check-basic") {
                (opts as CliOptions*).check_basic = true;
                i = i + 1;
                continue;
            }

            if (token == "-Gk" || token == "--keep-c") {
                (opts as CliOptions*).keep_c = true;
                i = i + 1;
                continue;
            }

            if (token == "-a" || token == "--all-modules") {
                (opts as CliOptions*).all_modules = true;
                i = i + 1;
                continue;
            }

            if (token == "--include-eof") {
                (opts as CliOptions*).include_eof = true;
                i = i + 1;
                continue;
            }

            if (token == "-Rp" || token == "--project-root") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).project_roots, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Rp=")) {
                let value = slice_s(token, len_s("-Rp="), len_s(token));
                sv_push((opts as CliOptions*).project_roots, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--project-root=")) {
                let value = slice_s(token, len_s("--project-root="), len_s(token));
                sv_push((opts as CliOptions*).project_roots, value);
                i = i + 1;
                continue;
            }

            if (token == "-Rs" || token == "--sys-root") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).sys_roots, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Rs=")) {
                let value = slice_s(token, len_s("-Rs="), len_s(token));
                sv_push((opts as CliOptions*).sys_roots, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--sys-root=")) {
                let value = slice_s(token, len_s("--sys-root="), len_s(token));
                sv_push((opts as CliOptions*).sys_roots, value);
                i = i + 1;
                continue;
            }

            if (token == "-o" || token == "--output") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).output = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--output=")) {
                (opts as CliOptions*).output = slice_s(token, len_s("--output="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Cc" || token == "--c-compiler") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).c_compiler = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Cc=")) {
                (opts as CliOptions*).c_compiler = slice_s(token, len_s("-Cc="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--c-compiler=")) {
                (opts as CliOptions*).c_compiler = slice_s(token, len_s("--c-compiler="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Co" || token == "--c-options") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).c_options = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Co=")) {
                (opts as CliOptions*).c_options = slice_s(token, len_s("-Co="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--c-options=")) {
                (opts as CliOptions*).c_options = slice_s(token, len_s("--c-options="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Cs" || token == "--c-source") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).c_sources, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Cs=")) {
                sv_push((opts as CliOptions*).c_sources, slice_s(token, len_s("-Cs="), len_s(token)));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--c-source=")) {
                sv_push((opts as CliOptions*).c_sources, slice_s(token, len_s("--c-source="), len_s(token)));
                i = i + 1;
                continue;
            }

            if (token == "-I" || token == "--interface-path") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    sv_push((opts as CliOptions*).interface_paths, value as string);
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "--interface-path=")) {
                let value = slice_s(token, len_s("--interface-path="), len_s(token));
                sv_push((opts as CliOptions*).interface_paths, value);
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-I=")) {
                cli_emit_error(diags as DiagCollector*, "L0C-2001", "unknown option '" + token + "'");
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-I") && len_s(token) > len_s("-I")) {
                let value = slice_s(token, len_s("-I"), len_s(token));
                sv_push((opts as CliOptions*).interface_paths, value);
                i = i + 1;
                continue;
            }

            if (token == "-Ri" || token == "--runtime-include") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).runtime_include = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Ri=")) {
                (opts as CliOptions*).runtime_include = slice_s(token, len_s("-Ri="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--runtime-include=")) {
                (opts as CliOptions*).runtime_include = slice_s(token, len_s("--runtime-include="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-Rl" || token == "--runtime-lib") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    (opts as CliOptions*).runtime_lib = value;
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-Rl=")) {
                (opts as CliOptions*).runtime_lib = slice_s(token, len_s("-Rl="), len_s(token));
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "--runtime-lib=")) {
                (opts as CliOptions*).runtime_lib = slice_s(token, len_s("--runtime-lib="), len_s(token));
                i = i + 1;
                continue;
            }

            if (token == "-L") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    cli_emit_reserved_option_error(diags as DiagCollector*, "-L", "external library search");
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-L=")) {
                cli_emit_error(diags as DiagCollector*, "L0C-2001", "unknown option '" + token + "'");
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-L") && len_s(token) > len_s("-L")) {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-L", "external library search");
                i = i + 1;
                continue;
            }

            if (token == "-l") {
                let value = cli_require_next_value(argv, i, token, diags as DiagCollector*);
                if (value == null) {
                    i = i + 1;
                } else {
                    cli_emit_reserved_option_error(diags as DiagCollector*, "-l", "external library selection");
                    i = i + 2;
                }
                continue;
            }

            if (starts_with_s(token, "-l=")) {
                cli_emit_error(diags as DiagCollector*, "L0C-2001", "unknown option '" + token + "'");
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-l") && len_s(token) > len_s("-l")) {
                cli_emit_reserved_option_error(diags as DiagCollector*, "-l", "external library selection");
                i = i + 1;
                continue;
            }

            if (starts_with_s(token, "-")) {
                cli_emit_error(diags as DiagCollector*, "L0C-2001", "unknown option '" + token + "'");
                i = i + 1;
                continue;
            }

            cli_assign_target(opts as CliOptions*, token);
            i = i + 1;
        }

        if (cli_has_diagnostic_code(diags as DiagCollector*, "L0C-2003")) {
            let missing_value_verbosity = (opts as CliOptions*).verbosity;
            let missing_value_log = (opts as CliOptions*).log;
            cli_options_free(opts as CliOptions*);
            opts = null;

            let missing_value_result = new CliParseResult(
                null,
                diags as DiagCollector*,
                false,
                false,
                missing_value_verbosity,
                missing_value_log
            );
            diags = null;
            return missing_value_result;
        }

        if ((opts as CliOptions*).entry_target == null) {
            cli_emit_error(diags as DiagCollector*, "L0C-2021", "missing required target module/file name");
        }

        if (ord((opts as CliOptions*).mode) == ord(CM_RUN)) {
            if ((opts as CliOptions*).extra_target_count > 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L0C-2022",
                    "mode '--run' accepts exactly one target; use '--' before runtime program arguments"
                );
            }
        } else {
            if (split_idx >= 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L0C-2023",
                    "arguments after '--' are valid only with '--run'"
                );
            }
            if ((opts as CliOptions*).extra_target_count > 0) {
                cli_emit_error(
                    diags as DiagCollector*,
                    "L0C-2024",
                    "multiple targets are not supported yet; pass exactly one target"
                );
            }
        }

        cli_validate_mode_scoped_flags(opts as CliOptions*, diags as DiagCollector*);

        let parsed_verbosity3 = (opts as CliOptions*).verbosity;
        let parsed_log3 = (opts as CliOptions*).log;
        if (diag_has_errors(diags as DiagCollector*)) {
            cli_options_free(opts as CliOptions*);
            opts = null;
        }

        let result = new CliParseResult(
            opts,
            diags as DiagCollector*,
            false,
            false,
            parsed_verbosity3,
            parsed_log3
        );
        diags = null;
        opts = null;
        return result;
    }
}
