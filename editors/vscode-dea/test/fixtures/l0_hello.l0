module l0_hello;

import std.io;

// Minimized from l0/examples/hello.l0.
func greeting(index: int) -> string {
    case (index) {
        0 => return "Hello, world! This is Dea/L0.";
        1 => return "你好，世界！这是 Dea/L0。";
        _ => return "Ciao, mondo! Questo è Dea/L0.";
    }
}

func main() -> int {
    printl_s(greeting(1));
    return 0;
}
