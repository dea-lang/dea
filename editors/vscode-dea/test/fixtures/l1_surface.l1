module l1_surface;

export opaque { Handle }, Callback, Result, choose, sum, ratio, mask;

import std.io as io;
import assert from std.assert;

struct Handle {
    value: int;
}

enum Result {
    Ok(value: int);
    Error(message: string);
}

type Callback = unsafe func(int*) -> int;
type Matrix = int[2][3];

const ratio: double = 1.25e+2;
const mask: uint = 0xFF;
const binary_flag: byte = 0b01;
let current: int = 0;

extern func external_value() -> int;
unsafe extern func external_read(pointer: int*) -> int;

unsafe func first(pointer: int*) -> int {
    return pointer[0];
}

func choose(left: int, right: int) -> int {
    return left | right;
}

func sum(base: int, values: int...) -> int {
    let total = base;
    let index = 0;
    while (index < len(values)) {
        total = total + values[index];
        index = index + 1;
    }
    return total;
}

func demonstrate() -> int {
    let matrix: Matrix = [[1, 2, 3], [4, 5, 6]];
    let row: int[] = slice(matrix[0]);
    let selected = choose(right: 0x20, left: 0b10);
    io::printl_s("L1 syntax: λ stays inside strings and comments.");
    assert(selected == 0x22, "named arguments");
    return sum(selected, row...);
}
