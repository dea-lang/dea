{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "dea",
      "camelcase": "Dea",
      "title": "Dea",
      "scope": "source.dea",
      "file-types": [
        "l0",
        "l1"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "tags": [
        "queries/tags.scm"
      ],
      "injection-regex": "^dea$",
      "class-name": "TreeSitterDea"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT OR Apache-2.0",
    "description": "Tree-sitter grammar for the Dea L0 and L1 languages",
    "authors": [
      {
        "name": "Guglielmo Nigri",
        "email": "googlielmo@gmail.com",
        "url": "https://github.com/googlielmo"
      }
    ],
    "links": {
      "repository": "https://github.com/dea-lang/dea"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
