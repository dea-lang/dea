module wildcards;

enum Result {
    Value(value: int);
    Empty;
}

func inspect(result: Result, key: int) -> int {
    match (result) {
        Value(value) => return value;
        _ => return 0;
    }

    case (key) {
        1 => return 1;
        _ => return 0;
    }
}
